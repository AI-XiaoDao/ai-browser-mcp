    方法 绑定MCP服务器实例 <公开 静态 @输出名 = "BindMCPServerInstance" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    {
        MCP服务器实例 = 服务器
    }

    方法 关闭MCP服务器 <公开 静态 @输出名 = "CloseMCPServer" @强制输出 = 真>
    {
        // 修复: 原守卫用 MCP正在关闭 早退, 但关闭序列(main.wsv)先置位该标志再调本方法,
        // 导致下方全部清理体(含关闭服务器实例/关闭缓存数据库)被跳过;
        // 改为静态标志防重复清理, 首次调用必定执行完整清理
        变量 清理已执行 <静态 类型 = 逻辑型 值 = 假>
        如果 (清理已执行)
        {
            返回
        }
        清理已执行 = 真
        MCP正在关闭 = 真
        是否启用 = 假
        浏览器容器.MCP服务已就绪 = 假
        MCPStdio桥.停止Stdio服务 ()
        MCP_编排分派.重置工作流状态 ()
        等待MCP命令排空 ()
        注销CDP观察者 ()
        清空持久V8扩展 ()
        清理VIP拦截资源 ()
        关闭全部事件监控 ()
        清理过期CDP映射 ()
        清空CDP请求映射 ()
        浏览器数组锁.加锁 ()
        判断循环 (浏览器容器.浏览器数组.取成员数 () > 0)
        {
            浏览器容器.浏览器数组.删除成员 (0)
        }
        浏览器数组锁.解锁 ()
        导航拦截规则 = ""
        资源替换规则 = ""
        是否Hook导航 = 假
        是否Hook资源 = 假
        是否Hook音频 = 假
        是否Hook弹窗 = 假
        音频指纹配置 = ""
        弹窗配置 = ""
        工具列表缓存 = ""  // 重建工具列表缓存, 防止旧进程工具集残留
        // 断点注册表清空, 防止重开服务器后 list_breakpoints 显示幽灵断点
        判断循环 (断点注册表.取成员数 () > 0)
        {
            断点注册表.删除成员 (0)
        }
        判断循环 (断点ID注册表.取成员数 () > 0)
        {
            断点ID注册表.删除成员 (0)
        }
        IP速率限制字典.创建 ()
        应用事件节流字典.创建 ()
        异步缓存锁.加锁 ()
        活动URL请求数 = 0
        最后URL请求槽释放时间 = 0
        URL请求槽满起始毫秒 = 0
        异步缓存锁.解锁 ()
        如果 (MCP服务器实例.是否为空 () == 假)
        {
            MCP服务器实例.关闭 ()
            MCP服务器实例.置空 ()
        }
        关闭缓存数据库 ()
        控制台输出 ("[MCP] AI浏览器 MCP 服务器已关闭")
    }

    # ======== 空文本数组辅助 ==========

    方法 取空文本数组 <公开 静态 类型 = 文本数组类 @输出名 = "GetEmptyTextArray" @强制输出 = 真>
    {
        变量 arr <类型 = 文本数组类>
        返回 (arr)
    }

    # ======== CORS 跨域辅助 ==========

    变量 CORS响应头 <公开 静态 类型 = FBrowser_双文本数组 @输出名 = "CORSResponseHeader">

    方法 初始化CORS响应头 <公开 静态 @输出名 = "InitializeCORSResponseHeader" @强制输出 = 真>
    {
        如果 (CORS响应头.是否为空 () == 假)
        {
            返回
        }
        CORS响应头.创建 ()
        变量 h_Origin <类型 = FBrowser_双文本>
        变量 h_Methods <类型 = FBrowser_双文本>
        变量 h_Headers <类型 = FBrowser_双文本>
        h_Origin.name = "Access-Control-Allow-Origin"
        h_Origin.value = "*"
        h_Methods.name = "Access-Control-Allow-Methods"
        h_Methods.value = "GET, POST, DELETE, OPTIONS"
        h_Headers.name = "Access-Control-Allow-Headers"
        h_Headers.value = "Content-Type, Authorization, Mcp-Session-Id"
        CORS响应头.加入成员 (h_Origin)
        CORS响应头.加入成员 (h_Methods)
        CORS响应头.加入成员 (h_Headers)
        // 企业级: 回带 Mcp-Session-Id (Streamable HTTP 规范)。该头表只构造一次并被所有响应复用,
        // 而会话ID 在整个进程生命周期内恒定, 故在此一次加入即可覆盖全部响应。
        如果 (会话ID == "")
        {
            会话ID = "sess_" + 到文本 (取启动时间 ()) + "_" + 到文本 (取随机数 (100000, 999999))
        }
        变量 h_Session <类型 = FBrowser_双文本>
        h_Session.name = "Mcp-Session-Id"
        h_Session.value = 会话ID
        CORS响应头.加入成员 (h_Session)
        // 企业级: 回带 CORS 暴露头, 使浏览器侧 JS 能读到会话ID与请求耗时
        变量 h_Expose <类型 = FBrowser_双文本>
        h_Expose.name = "Access-Control-Expose-Headers"
        h_Expose.value = "Mcp-Session-Id, X-MCP-Request-Id"
        CORS响应头.加入成员 (h_Expose)
    }

    方法 发送CORS响应 <公开 静态 @输出名 = "SendCORSResponse" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    参数 状态码 <类型 = 整数 @输出名 = "StatusCode">
    参数 内容类型 <类型 = 文本型 @输出名 = "ContentType">
    参数 数据指针 <类型 = 变整数 @输出名 = "DataPtr">
    参数 数据大小 <类型 = 整数 @输出名 = "DataSize">
    {
        如果 (CORS响应头.是否为空 ())
        {
            初始化CORS响应头 ()
        }
        服务器.发送HttpResponse (连接ID, 状态码, 内容类型, 数据大小, CORS响应头)
        如果 (数据指针 != 0 && 数据大小 > 0)
        {
            服务器.发送原始数据 (连接ID, 数据指针, 数据大小)
        }
    }

    # 405 Method Not Allowed — RFC 9110 要求 405 必须回带 Allow 头。
    # 单独构造头表而不复用全局 CORS响应头, 以免污染其它响应的头集合。
    # 用法: MCP 2025-06-18 Streamable HTTP 明确允许服务端对 GET /mcp 返回 405
    # (客户端必须能处理 405), 本项目未提供 HTTP 侧 SSE 推送通道, 故如实宣告。

    方法 发送CORS405响应 <公开 静态 @输出名 = "SendCORS405Response" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    参数 允许方法 <类型 = 文本型 @默认值 = "POST, DELETE, OPTIONS" @输出名 = "AllowMethods">
    参数 说明 <类型 = 文本型 @默认值 = "" @输出名 = "Detail">
    {
        如果 (CORS响应头.是否为空 ())
        {
            初始化CORS响应头 ()
        }
        变量 头数组 <类型 = FBrowser_双文本数组>
        头数组.创建 ()
        变量 h_Origin <类型 = FBrowser_双文本>
        变量 h_Headers <类型 = FBrowser_双文本>
        变量 h_Session <类型 = FBrowser_双文本>
        变量 h_Expose <类型 = FBrowser_双文本>
        变量 h_Allow <类型 = FBrowser_双文本>
        h_Origin.name = "Access-Control-Allow-Origin"
        h_Origin.value = "*"
        h_Headers.name = "Access-Control-Allow-Headers"
        h_Headers.value = "Content-Type, Authorization, Mcp-Session-Id"
        h_Session.name = "Mcp-Session-Id"
        h_Session.value = 会话ID
        h_Expose.name = "Access-Control-Expose-Headers"
        h_Expose.value = "Mcp-Session-Id, X-MCP-Request-Id"
        h_Allow.name = "Allow"
        h_Allow.value = 允许方法
        头数组.加入成员 (h_Origin)
        头数组.加入成员 (h_Headers)
        头数组.加入成员 (h_Session)
        头数组.加入成员 (h_Expose)
        头数组.加入成员 (h_Allow)
        变量 bodyObj <类型 = YYJSON对象类>
        bodyObj.创建自文本 ("{}")
        bodyObj.加入文本成员 ("error", "method_not_allowed")
        bodyObj.加入文本成员 ("allow", 允许方法)
        bodyObj.加入文本成员 ("session_id", 会话ID)
        如果 (说明 != "")
        {
            bodyObj.加入文本成员 ("detail", 说明)
        }
        变量 body <类型 = 字节集类>
        body = 文本到UTF8 (bodyObj.到可读文本 (YYJSON格式化选项.压缩), 假)
        服务器.发送HttpResponse (连接ID, 405, MCP_常量.HTTP_JSON内容类型, 取字节集长度 (body), 头数组)
        服务器.发送原始数据 (连接ID, 取字节集指针 (body), 取字节集长度 (body))
    }

    # 便捷封装 — 保持现有调用无需改参数

    方法 发送CORS200响应 <公开 静态 @输出名 = "SendCORS200Response" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    参数 内容类型 <类型 = 文本型 @输出名 = "ContentType">
    参数 数据指针 <类型 = 变整数 @输出名 = "DataPtr">
    参数 数据大小 <类型 = 整数 @输出名 = "DataSize">
    {
        发送CORS响应 (服务器, 连接ID, 200, 内容类型, 数据指针, 数据大小)
    }

    方法 发送CORS404响应 <公开 静态 @输出名 = "SendCORS404Response" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    {
        发送CORS响应 (服务器, 连接ID, 404, MCP_常量.HTTP_JSON内容类型, 0, 0)
    }

    方法 发送CORS404HTML响应 <公开 静态 @输出名 = "SendCORS404HTMLResponse" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    参数 提示 <类型 = 文本型 @默认值 = "404 Not Found" @输出名 = "Hint">
    {
        变量 安全提示 <类型 = 文本型>
        安全提示 = 提示
        子文本替换 (安全提示, "&", "&amp;", , , 假)
        子文本替换 (安全提示, "<", "&lt;", , , 假)
        子文本替换 (安全提示, ">", "&gt;", , , 假)
        子文本替换 (安全提示, "\"", "&quot;", , , 假)
        子文本替换 (安全提示, "'", "&#39;", , , 假)
        变量 body <类型 = 字节集类>
        body = 文本到UTF8 ("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>404</title></head><body><h1>404</h1><p>" + 安全提示 + "</p></body></html>", 假)
        发送CORS响应 (服务器, 连接ID, 404, "text/html; charset=utf-8", 取字节集指针 (body), 取字节集长度 (body))
    }

    # ======== JSON-RPC 协议信封构建（yyjson值序列化 + 文本拼接外层） ==========
    # 注: yyjson 的 加入成员() 嵌套对象在此版本存在访问违例 (0xC0000005)
    # 故改用: yyjson构建扁平内层对象→序列化→火山文本拼接外包装

    方法 构建JSONRPC响应 <公开 静态 类型 = 文本型 @输出名 = "BuildJSONRPCResponse" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    参数 结果JSON文本 <类型 = 文本型 @默认值 = "" @输出名 = "ResultJSONText">
    参数 错误码 <类型 = 整数 @默认值 = 0 @输出名 = "ErrorCode">
    参数 错误消息 <类型 = 文本型 @默认值 = "" @输出名 = "ErrorMessage">
    {
        变量 前缀 <类型 = 文本型>
        前缀 = 构建JSONRPC头部前缀 (请求ID)
        如果 (错误码 == 0)
        {
            // === 成功: 用yyjson构建result (标准JSON-RPC响应, 无扩展字段), 然后文本级嵌入 ===
            变量 结果JSON <类型 = 文本型>
            如果 (结果JSON文本 != "")
            {
                // 无追踪ID时直接使用原始JSON, 跳过yyjson解析/序列化往返
                如果 (当前请求追踪ID == "" && 是否以 (结果JSON文本, "{"))
                {
                    // 修复(数据): 快速通道也先校验合法性, 防上游非法JSON直通为非法响应
                    变量 快速校验 <类型 = YYJSON只读对象类>
                    如果 (快速校验.创建自文本 (结果JSON文本))
                    {
                        结果JSON = 结果JSON文本
                    }
                    否则
                    {
                        变量 快速原始包装 <类型 = YYJSON对象类>
                        快速原始包装.创建自文本 ("{}")
                        快速原始包装.加入文本成员 ("_raw", 结果JSON文本)
                        结果JSON = 快速原始包装.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
                否则
                {
                    变量 结果对象 <类型 = YYJSON对象类>
                    如果 (结果对象.创建自文本 (结果JSON文本))
                    {
                        // 标准合规: 不注入 _req_id 扩展字段 (官方SDK 1.30+ 严格schema会拒绝未知键)
                        结果JSON = 结果对象.到可读文本 (YYJSON格式化选项.压缩)
                    }
                    否则
                    {
                        变量 原始包装 <类型 = YYJSON对象类>
                        原始包装.创建自文本 ("{}")
                        原始包装.加入文本成员 ("_raw", 结果JSON文本)
                        结果JSON = 原始包装.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
            }
            否则
            {
                结果JSON = "{}"
            }
            返回 (前缀 + ",\"result\":" + 结果JSON + "}")
        }
        // === 错误: yyjson构建错误对象→序列化→文本拼接 ===
        变量 错误对象 <类型 = YYJSON对象类>
        错误对象.创建自文本 ("{}")
        错误对象.加入整数成员 ("code", 错误码)
        错误对象.加入文本成员 ("message", 错误消息)
        // 标准合规: 错误响应不注入 _req_id 扩展字段
        返回 (前缀 + ",\"error\":" + 错误对象.到可读文本 (YYJSON格式化选项.压缩) + "}")
    }

    # ======== MCP JSON-RPC 入口处理 ==========

    方法 处理MCP请求 <公开 静态 类型 = 文本型 @输出名 = "HandleMCPRequest" @强制输出 = 真>
    参数 请求体JSON <类型 = 文本型 @输出名 = "RequestBodyJSON">
    参数 客户端地址 <类型 = 文本型 @默认值 = "" @输出名 = "ClientAddr">
    {
        // workflow_stop 快速通道: 不抢协议锁(运行中的workflow_run持锁最长30分钟),
        // 直接置停止标志——标志为布尔赋值, 与等待循环的轮询检查兼容
        变量 快速方法名 <类型 = 文本型>
        变量 快速解析 <类型 = YYJSON只读对象类>
        如果 (快速解析.创建自文本 (请求体JSON))
        {
            快速方法名 = yyjson取文本 (快速解析, "method")
            如果 (快速方法名 == "workflow_stop" || 快速方法名 == "workflow.stop")
            {
                // 仅置标志, 直接手拼最小响应: 不走构建JSONRPC响应(避免读取并发请求残留的追踪ID静态上下文)
                变量 快速ID <类型 = 文本型>
                快速ID = MCP_响应构建.JSON转义文本 (yyjson取文本 (快速解析, "id"))
                如果 (MCP_编排分派.请求工作流停止 ())
                {
                    返回 ("{\"jsonrpc\":\"2.0\",\"id\":\"" + 快速ID + "\",\"result\":{\"success\":true,\"message\":\"工作流停止信号已发送(快速通道)\"}}")
                }
                                返回 ("{\"jsonrpc\":\"2.0\",\"id\":\"" + 快速ID + "\",\"result\":{\"success\":true,\"message\":\"没有正在运行的工作流, 无需停止\"}}")
            }
        }
        // 协议锁: JSON-RPC 请求端到端串行化。
        // 当前请求追踪ID/紧凑响应模式 是请求级静态上下文, 并发请求会互相覆盖;
        // 本地桌面场景 MCP 客户端均为请求-响应同步模式, 串行化无吞吐损失,
        // 同步等待期间内部命令会释放MCP执行锁(仅一层), 不影响协议锁持有。
        // 锁顺序: 协议锁 → MCP执行锁 → 异步缓存锁 (全项目无反向获取)
        协议锁.加锁 ()
        // 企业级可观测性埋点 (单点, 覆盖 HTTP/WS/stdio 三条传输):
        // 计数用 Interlocked 原子递增(多线程安全); 延迟累加/最大值为指标用途, 容忍轻微竞争。
        变量 指标_开始 <类型 = 长整数>
        指标_开始 = 取启动时间 ()
        @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_请求总数>);
        @ InterlockedIncrement((LONG volatile*)&@<指标_活跃请求数>);
        变量 结果 <类型 = 文本型>
        结果 = 处理MCP请求_内部 (请求体JSON, 客户端地址)
        变量 指标_耗时 <类型 = 长整数>
        指标_耗时 = 取启动时间 () - 指标_开始
        @ InterlockedExchangeAdd64((LONGLONG volatile*)&@<指标_延迟累加毫秒>, (LONGLONG)@<指标_耗时>);
        @ if (@<指标_耗时> > @<指标_延迟最大毫秒>) @<指标_延迟最大毫秒> = @<指标_耗时>;
        @ InterlockedDecrement((LONG volatile*)&@<指标_活跃请求数>);
        // 错误计数: 单点派生, 无需在 4 个返回点分别埋点(减少侵入、口径统一)
        如果 (寻找文本 (结果, "\"error\":", 0, 假) != -1)
        {
            @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_错误响应数>);
            // 按 JSON-RPC 错误码细分 (与 MCP_Server_内部 的错误码一致)
            如果 (寻找文本 (结果, "-32029", 0, 假) != -1)
            {
                @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_限流拒绝数>);
            }
            否则 (寻找文本 (结果, "-32001", 0, 假) != -1)
            {
                @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_认证失败数>);
            }
            否则 (寻找文本 (结果, "-32700", 0, 假) != -1 || 寻找文本 (结果, "-32600", 0, 假) != -1)
            {
                @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_协议错误数>);
            }
        }
        // tools/call 计数: 避免解析整个请求体, 用子串判定
        如果 (寻找文本 (请求体JSON, "\"tools/call\"", 0, 假) != -1)
        {
            @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_工具调用数>);
        }
        协议锁.解锁 ()
        返回 (结果)
    }

    # ======== Prometheus 指标端点文本 (企业级可观测性) ========
    # 输出 Prometheus 文本暴露格式(版本 0.0.4), 可被 Prometheus/Grafana/VictoriaMetrics 直接抓取。
    # 指标口径: counter 单调递增; gauge 为瞬时值。

    方法 取指标文本 <公开 静态 类型 = 文本型 @输出名 = "GetMetricsText" @强制输出 = 真>
    {
        变量 运行毫秒 <类型 = 长整数>
        运行毫秒 = 取现行时间毫秒 () - 服务器启动墙钟毫秒
        如果 (运行毫秒 < 0)
        {
            运行毫秒 = 0
        }
        变量 平均延迟 <类型 = 长整数>
        如果 (指标_请求总数 > 0)
        {
            平均延迟 = 指标_延迟累加毫秒 / 指标_请求总数
        }
        否则
        {
            平均延迟 = 0
        }
        变量 缓存条数 <类型 = 整数>
        缓存条数 = 0
        如果 (缓存数据库可用 ())
        {
            异步缓存锁.加锁 ()
            变量 统计记录 <类型 = SQLite记录集类>
            统计记录 = 缓存数据库.取记录集 ("SELECT COUNT(*) FROM async_results", )
            如果 (统计记录.执行语句 () == 100)
            {
                缓存条数 = 统计记录.读整数数据 (0)
            }
            统计记录.释放 ()
            异步缓存锁.解锁 ()
        }
        变量 文本 <类型 = 文本型>
        文本 = ""
        文本 = 文本 + "# HELP mcp_up MCP 服务是否存活 (1=存活)\n"
        文本 = 文本 + "# TYPE mcp_up gauge\n"
        文本 = 文本 + "mcp_up 1\n"
        文本 = 文本 + "# HELP mcp_uptime_seconds 服务运行秒数\n"
        文本 = 文本 + "# TYPE mcp_uptime_seconds gauge\n"
        文本 = 文本 + "mcp_uptime_seconds " + 到文本 (运行毫秒 / 1000) + "\n"
        文本 = 文本 + "# HELP mcp_requests_total 累计 JSON-RPC 请求数(含通知)\n"
        文本 = 文本 + "# TYPE mcp_requests_total counter\n"
        文本 = 文本 + "mcp_requests_total " + 到文本 (指标_请求总数) + "\n"
        文本 = 文本 + "# HELP mcp_tool_calls_total 累计 tools/call 次数\n"
        文本 = 文本 + "# TYPE mcp_tool_calls_total counter\n"
        文本 = 文本 + "mcp_tool_calls_total " + 到文本 (指标_工具调用数) + "\n"
        文本 = 文本 + "# HELP mcp_error_responses_total 累计错误响应数\n"
        文本 = 文本 + "# TYPE mcp_error_responses_total counter\n"
        文本 = 文本 + "mcp_error_responses_total " + 到文本 (指标_错误响应数) + "\n"
        文本 = 文本 + "# HELP mcp_protocol_errors_total JSON解析/协议校验失败数\n"
        文本 = 文本 + "# TYPE mcp_protocol_errors_total counter\n"
        文本 = 文本 + "mcp_protocol_errors_total " + 到文本 (指标_协议错误数) + "\n"
        文本 = 文本 + "# HELP mcp_rate_limited_total 被限流拒绝的请求数\n"
        文本 = 文本 + "# TYPE mcp_rate_limited_total counter\n"
        文本 = 文本 + "mcp_rate_limited_total " + 到文本 (指标_限流拒绝数) + "\n"
        文本 = 文本 + "# HELP mcp_auth_failed_total 认证失败请求数\n"
        文本 = 文本 + "# TYPE mcp_auth_failed_total counter\n"
        文本 = 文本 + "mcp_auth_failed_total " + 到文本 (指标_认证失败数) + "\n"
        // 修复(真机验证发现): 指标_进度通知数 此前只声明与自增, 却未导出到 Prometheus 文本,
        // 导致 notifications/progress 推送完全不可观测, 排障时无法区分"未推送"与"推送了但计数器没暴露"。
        文本 = 文本 + "# HELP mcp_progress_notifications_total 累计推送的 notifications/progress 通知数\n"
        文本 = 文本 + "# TYPE mcp_progress_notifications_total counter\n"
        文本 = 文本 + "mcp_progress_notifications_total " + 到文本 (指标_进度通知数) + "\n"
        文本 = 文本 + "# HELP mcp_active_requests 当前处理中的请求数(并发度)\n"
        文本 = 文本 + "# TYPE mcp_active_requests gauge\n"
        文本 = 文本 + "mcp_active_requests " + 到文本 (指标_活跃请求数) + "\n"
        文本 = 文本 + "# HELP mcp_request_duration_ms_avg 请求处理平均耗时(毫秒)\n"
        文本 = 文本 + "# TYPE mcp_request_duration_ms_avg gauge\n"
        文本 = 文本 + "mcp_request_duration_ms_avg " + 到文本 (平均延迟) + "\n"
        文本 = 文本 + "# HELP mcp_request_duration_ms_max 单次请求最大耗时(毫秒)\n"
        文本 = 文本 + "# TYPE mcp_request_duration_ms_max gauge\n"
        文本 = 文本 + "mcp_request_duration_ms_max " + 到文本 (指标_延迟最大毫秒) + "\n"
        文本 = 文本 + "# HELP mcp_browsers 当前浏览器实例数\n"
        文本 = 文本 + "# TYPE mcp_browsers gauge\n"
        文本 = 文本 + "mcp_browsers " + 到文本 (FBrowser_浏览器_取数量 ()) + "\n"
        文本 = 文本 + "# HELP mcp_tools 已注册 MCP 工具数\n"
        文本 = 文本 + "# TYPE mcp_tools gauge\n"
        文本 = 文本 + "mcp_tools " + 到文本 (工具总数) + "\n"
        文本 = 文本 + "# HELP mcp_async_tasks 异步结果表中滞留任务数\n"
        文本 = 文本 + "# TYPE mcp_async_tasks gauge\n"
        文本 = 文本 + "mcp_async_tasks " + 到文本 (缓存条数) + "\n"
        文本 = 文本 + "# HELP mcp_cdp_ready CDP 观察者是否已注册(1/0)\n"
        文本 = 文本 + "# TYPE mcp_cdp_ready gauge\n"
        如果 (CDP观察者已注册)
        {
            文本 = 文本 + "mcp_cdp_ready 1\n"
        }
        否则
        {
            文本 = 文本 + "mcp_cdp_ready 0\n"
        }
        返回 (文本)
    }

    方法 处理MCP请求_内部 <公开 静态 类型 = 文本型 @输出名 = "HandleMCPRequestInternal" @强制输出 = 真>
    参数 请求体JSON <类型 = 文本型 @输出名 = "RequestBodyJSON">
    参数 客户端地址 <类型 = 文本型 @默认值 = "" @输出名 = "ClientAddr">
    {
        如果 (MCP正在关闭 || 是否启用 == 假)
        {
            返回 (构建JSONRPC响应 ("", "", -32000, MCP_常量.错误_服务正在关闭))
        }
        紧凑响应模式 = 假  // 每个请求默认重置
        // 惰性定期维护: 与主循环节拍共享时间戳, 距上次维护 >=60s 时触发 (防双路径并发)
        如果 (上次维护毫秒 == 0 || 取启动时间 () - 上次维护毫秒 >= MCP_常量.定期维护间隔毫秒)
        {
            上次维护毫秒 = 取启动时间 ()
            执行定期维护 ()
        }
        // === 速率限制检查 (按IP优先, 回退全局) ===
        如果 (检查IP速率限制 (客户端地址) == 假)
        {
            控制台输出 (到文本 ("[MCP] 速率限制触发, IP:") + 到文本 (客户端地址))
            变量 剩余秒 <类型 = 整数>
            如果 (客户端地址 != "")
            {
                // IP级限制: 按当前分钟桶的剩余秒数计算 (与检查IP速率限制的桶逻辑一致)
                剩余秒 = 60 - (整数)(取启动时间 () / 1000 % 60)
            }
            否则
            {
                异步缓存锁.加锁 ()
                剩余秒 = 60 - (整数)((取启动时间 () - 速率限制_窗口开始) / 1000)
                异步缓存锁.解锁 ()
            }
            如果 (剩余秒 < 0)
            {
                剩余秒 = 1
            }
            // 惰性提取请求id回显: 限流拒绝发生在正式JSON解析之前, 此处尽力解析id
            // 使客户端能按id关联该错误 (文本id优先, 数字id回退; id:0为JSON-RPC边缘case, 无法与缺省区分, 按通知处理)
            变量 限流ID <类型 = 文本型>
            变量 限流解析 <类型 = YYJSON只读对象类>
            当前请求ID是数值 = 假
            如果 (限流解析.创建自文本 (请求体JSON))
            {
                限流ID = yyjson取文本 (限流解析, "id")
                如果 (限流ID == "")
                {
                    变量 限流id值对象 <类型 = YYJSON只读对象类>
                    限流id值对象 = 限流解析.取路径对象 ("/id")
                    如果 (限流id值对象.是否为空 () == 假 && 限流id值对象.是否为数值 ())
                    {
                        限流ID = 限流id值对象.到可读文本 (YYJSON格式化选项.压缩)
                        当前请求ID是数值 = 真
                    }
                }
            }
            返回 (构建JSONRPC响应 (限流ID, "", -32029, "请求过于频繁(" + 到文本 (速率限制_每分钟) + "/min), 请在" + 到文本 (剩余秒) + "秒后重试 | Retry-After: " + 到文本 (剩余秒)))
        }
        请求计数器 = 请求计数器 + 1
        当前请求追踪ID = 到文本 (服务器启动时间戳) + "_" + 到文本 (请求计数器)
        变量 解析结果 <类型 = YYJSON只读对象类>
        如果 (解析结果.创建自文本 (请求体JSON) == 假)
        {
            变量 错误摘要 <类型 = 文本型>
            变量 体长度 <类型 = 整数>
            体长度 = 取文本长度 (请求体JSON)
            如果 (体长度 > 600)
            {
                // 显示前后各300字上下文,帮助定位JSON中的转义/语法错误
                错误摘要 = "JSON解析失败, 体长度=" + 到文本 (体长度) + ", 前300字: " + 取文本左边 (请求体JSON, 300) + " ... 末300字: " + 取文本右边 (请求体JSON, 300)
            }
            否则 (体长度 > 0)
            {
                错误摘要 = "JSON解析失败, 体长度=" + 到文本 (体长度) + ", 完整体: " + 请求体JSON
            }
            否则
            {
                错误摘要 = "JSON解析失败, 请求体为空"
            }
            // 自动修复常见转义错误: shell层吞转义导致 \/ \. \; 等无效JSON escape
            变量 修复JSON <类型 = 文本型>
            修复JSON = 请求体JSON
            子文本替换 (修复JSON, "\\/", "/", , , 假)  // shell转义的斜杠
            子文本替换 (修复JSON, "\\.", ".", , , 假)  // shell转义的点号(regex)
            子文本替换 (修复JSON, "\\;", ";", , , 假)
            如果 (解析结果.创建自文本 (修复JSON))
            {
                当前请求追踪ID = 当前请求追踪ID + "_fixed"
                控制台输出 ("[MCP] JSON转义自动修复成功 | _req_id=" + 当前请求追踪ID)
            }
            否则
            {
                控制台输出 ("[MCP] " + 错误摘要 + " | 提示: curl用-d @file代替-d '...' 可避免转义问题 | _req_id=" + 当前请求追踪ID)
                返回 (构建JSONRPC响应 ("", "", -32700, 错误摘要 + " | 提示: curl -d @file 或使用 file 参数代替 inline code"))
            }
        }
        // 修复(标准): 提前提取请求ID(文本/数字), 后续错误响应统一回显真实id
        // JSON-RPC 2.0: id可省略、可为字符串或数字(含0); id:0 必须响应且回显数值0 — 原实现将id:0误判为通知, 导致标准客户端(Trae等)initialize握手失败
        变量 请求ID <类型 = 文本型>
        请求ID = yyjson取文本 (解析结果, "id")
        当前请求ID是数值 = 假
        如果 (请求ID == "")
        {
            // 键存在性判定: yyjson取文本对数字id返回空, 需用取路径对象区分 "id缺省" 与 "id:0/数字"
            变量 id值对象 <类型 = YYJSON只读对象类>
            id值对象 = 解析结果.取路径对象 ("/id")
            如果 (id值对象.是否为空 () == 假)
            {
                如果 (id值对象.是否为数值 ())
                {
                    // 值对象直接序列化: 数字0/整数/小数均保持原值文本 (取长整数需键名参数, 仅适用于文档对象)
                    请求ID = id值对象.到可读文本 (YYJSON格式化选项.压缩)
                    当前请求ID是数值 = 真
                }
            }
        }
        // 验证jsonrpc字段, 兼容字符串"2.0"和数值2.0 (部分客户端以数字形式发送)
        变量 jsonrpc版本 <类型 = 文本型>
        jsonrpc版本 = yyjson取文本 (解析结果, "jsonrpc")
        如果 (jsonrpc版本 == "")
        {
            // 降级: 检查是否为数值2.0
            变量 jsonrpc数 <类型 = 小数>
            jsonrpc数 = yyjson取小数 (解析结果, "jsonrpc")
            如果 (jsonrpc数 == 2.0)
            {
                jsonrpc版本 = "2.0"
            }
        }
        如果 (jsonrpc版本 != "2.0")
        {
            返回 (构建JSONRPC响应 (请求ID, "", -32600, "仅支持JSON-RPC 2.0"))
        }
        变量 方法名 <类型 = 文本型>
        方法名 = yyjson取文本 (解析结果, "method")
        // === API密钥认证 ===
        变量 参数对象_认证 <类型 = YYJSON只读对象类>
        参数对象_认证 = 解析结果.取对象 ("params")
        如果 (是否启用认证 && 验证API密钥 (参数对象_认证) == 假)
        {
            控制台输出 ("[MCP] API密钥认证失败")
            返回 (构建JSONRPC响应 (请求ID, "", -32001, "认证失败: API密钥无效, 请在params中提供_api_key"))
        }
        // 紧凑响应模式 — 减少token消耗, 跳过jsonrpc/_req_id/双层包裹
        变量 参数对象 <类型 = YYJSON只读对象类>
        参数对象 = 解析结果.取对象 ("params")
        如果 (参数对象.是否为空 () == 假)
        {
            紧凑响应模式 = 参数对象.取逻辑值 ("_compact")
        }
        否则
        {
            紧凑响应模式 = 假
        }
        // ======== 企业级: 长任务进度上报上下文 ========
        // 1) 取 params._meta.progressToken (MCP 规范: 客户端给出令牌表示希望收到进度)
        // 2) 依据传输通道决定推送方式: stdio 直接写流; WebSocket 按连接ID 推送; HTTP POST 无推送通道
        当前进度令牌 = ""
        当前推送通道 = ""
        当前推送连接ID = 0
        如果 (参数对象.是否为空 () == 假)
        {
            变量 元数据对象 <类型 = YYJSON只读对象类>
            元数据对象 = 参数对象.取对象 ("_meta")
            如果 (元数据对象.是否为空 () == 假)
            {
                当前进度令牌 = yyjson取文本 (元数据对象, "progressToken")
                如果 (当前进度令牌 == "")
                {
                    // 数值型令牌(规范允许 string|number): 走路径对象取原值文本
                    变量 令牌值对象 <类型 = YYJSON只读对象类>
                    令牌值对象 = 元数据对象.取路径对象 ("/progressToken")
                    如果 (令牌值对象.是否为空 () == 假 && 令牌值对象.是否为数值 ())
                    {
                        当前进度令牌 = 令牌值对象.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
            }
        }
        如果 (当前进度令牌 != "")
        {
            如果 (MCPStdio桥.是否为Stdio模式 ())
            {
                当前推送通道 = "stdio"
            }
            否则 (是否以 (客户端地址, "ws_"))
            {
                当前推送通道 = "ws"
                当前推送连接ID = 文本到整数 (取文本右边 (客户端地址, 取文本长度 (客户端地址) - 3))
            }
            // 否则: HTTP POST 无推送通道, 保持空 -> 上报进度 直接返回
            上次进度推送毫秒 = 0
        }
        // 用客户端ID信息优化追踪ID的可读性
        如果 (请求ID != "")
        {
            当前请求追踪ID = 到文本 (服务器启动时间戳) + "_" + 到文本 (请求计数器) + "_" + 请求ID
        }
        // JSON-RPC 2.0: 通知(无id字段)不返回响应; id:0 是合法请求id, 已在提取阶段正确识别并回显
        变量 是通知 <类型 = 逻辑型>
        是通知 = 请求ID == ""
        如果 (方法名 == "")
        {
            如果 (是通知)
            {
                返回 ("")  // 通知不响应
            }
            返回 (构建JSONRPC响应 (请求ID, "", -32600, "缺少method"))
        }
        控制台输出 (到文本 ("[MCP] RPC方法:") + 到文本 (方法名))
        // --- MCP 协议方法 ---
        如果 (方法名 == "initialize")
        {
            如果 (是通知)
            {
                返回 ("")  // initialize 无id视为通知, 不响应
            }
            返回 (处理_初始化 (请求ID, 解析结果))
        }
        否则 (方法名 == "notifications/initialized")
        {
            返回 ("")
        }
        否则 (方法名 == "notifications/cancelled")
        {
            // MCP 取消通知: 标记对应 task_id 的任务结果为已取消
            变量 取消参数 <类型 = YYJSON只读对象类>
            取消参数 = 解析结果.取对象 ("params")
            如果 (取消参数.是否为空 () == 假)
            {
                变量 取消请求ID <类型 = 文本型>
                取消请求ID = yyjson取文本 (取消参数, "requestId")
                如果 (取消请求ID == "")
                {
                    变量 取消请求整数ID <类型 = 整数>
                    取消请求整数ID = yyjson取整数 (取消参数, "requestId")
                    如果 (取消请求整数ID != 0)
                    {
                        取消请求ID = 到文本 (取消请求整数ID)
                    }
                }
                如果 (取消请求ID != "")
                {
                    变量 取消原因 <类型 = 文本型>
                    取消原因 = yyjson取文本 (取消参数, "reason")
                    如果 (取消原因 == "")
                    {
                        取消原因 = "客户端取消"
                    }
                    MCP命令服务器.存储异步结果 (取消请求ID, MCP_响应构建.构建标准失败JSON ("已取消: " + 取消原因))
                    控制台输出 (到文本 ("[MCP] 通知取消:") + 到文本 (取消请求ID) + " 原因:" + 到文本 (取消原因))
                }
            }
            返回 ("")  // 通知无需响应
        }
        否则 (方法名 == "resources/list")
        {
            // 通知(无id)不返回响应
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (处理_资源列表 (请求ID))
        }
        否则 (方法名 == "resources/templates/list")
        {
            // 企业级合规: 本服务不提供 resource template, 按规范返回空数组(而非 -32601)
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (构建JSONRPC响应 (请求ID, "{\"resourceTemplates\":[]}"))
        }
        否则 (方法名 == "logging/setLevel")
        {
            // 企业级合规: MCP logging 能力。日志级别作用于控制台输出与 notifications/message 推送。
            如果 (是通知)
            {
                返回 ("")
            }
            变量 级别参数 <类型 = YYJSON只读对象类>
            级别参数 = 解析结果.取对象 ("params")
            变量 请求级别 <类型 = 文本型>
            请求级别 = ""
            如果 (级别参数.是否为空 () == 假)
            {
                请求级别 = yyjson取文本 (级别参数, "level")
            }
            如果 (请求级别 == "debug" || 请求级别 == "info" || 请求级别 == "notice" || 请求级别 == "warning" || 请求级别 == "error" || 请求级别 == "critical" || 请求级别 == "alert" || 请求级别 == "emergency")
            {
                MCP日志级别 = 请求级别
                控制台输出 ("[MCP] 日志级别已设为: " + 请求级别)
                返回 (构建JSONRPC响应 (请求ID, "{}"))
            }
            返回 (构建JSONRPC响应 (请求ID, "", -32602, "无效的日志级别: " + 请求级别 + " | 允许: debug/info/notice/warning/error/critical/alert/emergency"))
        }
        否则 (方法名 == "completion/complete")
        {
            // 企业级合规: 对已注册工具名做前缀补全(客户端按 Tab 补全场景)。
            如果 (是通知)
            {
                返回 ("")
            }
            变量 补全参数 <类型 = YYJSON只读对象类>
            补全参数 = 解析结果.取对象 ("params")
            变量 补全前缀 <类型 = 文本型>
            补全前缀 = ""
            变量 补全值对象 <类型 = YYJSON只读对象类>
            如果 (补全参数.是否为空 () == 假)
            {
                补全值对象 = 补全参数.取对象 ("argument")
                如果 (补全值对象.是否为空 () == 假)
                {
                    补全前缀 = yyjson取文本 (补全值对象, "value")
                }
            }
            变量 补全项 <类型 = 文本型>
            补全项 = 搜索工具名补全 (补全前缀)
            返回 (构建JSONRPC响应 (请求ID, "{\"completion\":{\"values\":" + 补全项 + ",\"hasMore\":false}}"))
        }
        否则 (方法名 == "prompts/list")
        {
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (处理_提示列表 (请求ID))
        }
        否则 (方法名 == "tools/list")
        {
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (处理_工具列表 (请求ID))
        }
        否则 (方法名 == "tools/call")
        {
            // 副作用命令: 通知也执行, 但不返回响应
            变量 工具响应文本 <类型 = 文本型>
            工具响应文本 = 处理_工具调用 (请求ID, 解析结果)
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (工具响应文本)
        }
        否则 (方法名 == "ping")
        {
            // MCP 标准 ping: 返回空对象 {} (ping通知允许无响应)
            如果 (是通知)
            {
                返回 ("")
            }
            变量 pingResult <类型 = YYJSON对象类>
            pingResult.创建自文本 ("{}")
            返回 (构建JSONRPC响应 (请求ID, pingResult.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // 直接的浏览器命令(方法名包含 browser || mcp || 注册表/短名映射可解析)
        // v2.8.1: 补全路由, batch/aliases/workflow_*/短名(如 get_url) 作为顶层方法调用不再落入 -32601
        如果 (寻找文本 (方法名, "browser", 0, 假) != -1 || 寻找文本 (方法名, "mcp", 0, 假) != -1 || 查找命令ID (方法名) != 0 || 取短名映射 (方法名) != "")
        {
            变量 直接参数 <类型 = YYJSON只读对象类>
            直接参数 = 解析结果.取对象 ("params")
            控制台输出 (到文本 ("[MCP] 直接命令:") + 到文本 (方法名))
            // 副作用命令: 通知也执行, 但不返回响应
            变量 命令响应文本 <类型 = 文本型>
            命令响应文本 = 执行浏览器命令 (请求ID, 方法名, 直接参数)
            如果 (是通知)
            {
                返回 ("")
            }
            返回 (命令响应文本)
        }
        如果 (是通知)
        {
            返回 ("")  // 未知方法的通知不响应
        }
        返回 (构建JSONRPC响应 (请求ID, "", -32601, "未知方法: " + 方法名))
    }

    # ======== MCP initialize (符合 MCP 2024-11-05 规范) ==========

    方法 处理_初始化 <公开 静态 类型 = 文本型 @输出名 = "HandleInitialize" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    参数 请求JSON <类型 = YYJSON只读对象类 @输出名 = "RequestJSON">
    {
        变量 客户端名 <类型 = 文本型>
        变量 客户端版本 <类型 = 文本型>
        // clientInfo 在 params 内部 (符合 MCP 规范)
        变量 参数JSON <类型 = YYJSON只读对象类>
        参数JSON = 请求JSON.取对象 ("params")
        变量 客户端信息 <类型 = YYJSON只读对象类>
        如果 (参数JSON.是否为空 () == 假)
        {
            客户端信息 = 参数JSON.取对象 ("clientInfo")
            如果 (客户端信息.是否为空 () == 假)
            {
                客户端名 = 客户端信息.取文本 ("name")
                客户端版本 = 客户端信息.取文本 ("version")
            }
        }
        控制台输出 (到文本 ("[MCP] 初始化 — 客户端:") + 到文本 (客户端名))
        // 构建 capabilities (含 tools/resources/prompts + listChanged 通知支持)
        变量 能力对象 <类型 = YYJSON对象类>
        能力对象.创建自文本 ("{}")
        变量 工具能力 <类型 = YYJSON对象类>
        工具能力.创建自文本 ("{}")
        工具能力.加入逻辑值成员 ("listChanged", 假)
        能力对象.加入成员 ("tools", 工具能力)
        // v2.8: 声明 resources + prompts 能力
        变量 资源能力 <类型 = YYJSON对象类>
        资源能力.创建自文本 ("{}")
        资源能力.加入逻辑值成员 ("listChanged", 假)
        资源能力.加入逻辑值成员 ("subscribe", 假)
        能力对象.加入成员 ("resources", 资源能力)
        变量 提示能力 <类型 = YYJSON对象类>
        提示能力.创建自文本 ("{}")
        提示能力.加入逻辑值成员 ("listChanged", 假)
        能力对象.加入成员 ("prompts", 提示能力)
        // 企业级合规: 声明 logging 能力(已实现 logging/setLevel) 与 completions 能力(已实现 completion/complete)
        变量 日志能力 <类型 = YYJSON对象类>
        日志能力.创建自文本 ("{}")
        能力对象.加入成员 ("logging", 日志能力)
        变量 补全能力 <类型 = YYJSON对象类>
        补全能力.创建自文本 ("{}")
        能力对象.加入成员 ("completions", 补全能力)
        // 构建 serverInfo
        变量 服务器信息 <类型 = YYJSON对象类>
        服务器信息.创建自文本 ("{}")
        服务器信息.加入文本成员 ("name", MCP_常量.MCP_服务器名)
        服务器信息.加入文本成员 ("version", MCP_常量.MCP_版本号)
        // instructions: 引导 LLM 有效使用工具 (MCP 推荐字段)
        变量 指引 <类型 = 文本型>
        指引 = "AI浏览器 MCP Server — 浏览器自动化工具集。" + "核心流程: browser_navigate(导航到URL) → browser_wait(等待加载) → browser_get_text/browser_extract(提取数据)。" + "一步爬虫: browser_scrape {url, extract_selector, wait_selector?, max_ms?}。" + "异步工具返回task_id, 轮询: mcp_result {request_id, consume:true}。" + "同步等待: 任意工具加 max_ms 参数→服务端阻塞返回结果。" + "网络抓包: browser_network detail_enable→操作→browser_network list。" + "逆向分析: browser_cdp_call / browser_debugger_flow(一键断点)。" + "批量: batch {commands:[{name,arguments}]}。" + "用 mcp_help 查看完整工具列表。"
        // 构建 result
        变量 结果对象 <类型 = YYJSON对象类>
        结果对象.创建自文本 ("{}")
        // 协议版本协商: 客户端版本与服务端支持版本一致才回显, 否则返回服务端版本 (MCP规范)
        变量 协商版本 <类型 = 文本型>
        如果 (参数JSON.是否为空 () == 假)
        {
            协商版本 = 参数JSON.取文本 ("protocolVersion")
            如果 (协商版本 != MCP_常量.MCP_协议版本)
            {
                控制台输出 (到文本 ("[MCP] 客户端协议版本不受支持:") + 到文本 (协商版本) + "| 服务端版本:" + 到文本 (MCP_常量.MCP_协议版本))
                协商版本 = MCP_常量.MCP_协议版本
            }
        }
        如果 (协商版本 == "")
        {
            协商版本 = MCP_常量.MCP_协议版本
        }
        结果对象.加入文本成员 ("protocolVersion", 协商版本)
        结果对象.加入成员 ("capabilities", 能力对象)
        结果对象.加入成员 ("serverInfo", 服务器信息)
        结果对象.加入文本成员 ("instructions", 指引)
        返回 (构建JSONRPC响应 (请求ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ======== MCP resources/list (v2.8) ==========

    方法 处理_资源列表 <公开 静态 类型 = 文本型 @输出名 = "HandleResourceList" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    {
        // 返回浏览器自动化相关资源: 当前页面的源码/截图/Network日志/Console日志 均可作为 resource URI
        变量 资源数组 <类型 = YYJSON数组类>
        资源数组.创建自文本数据 (MCP命令服务器.取空文本数组 ())
        // 资源1: 当前页面源码
        变量 资源源码 <类型 = YYJSON对象类>
        资源源码.创建自文本 ("{}")
        资源源码.加入文本成员 ("uri", "browser://current/source")
        资源源码.加入文本成员 ("name", "当前页面源码")
        资源源码.加入文本成员 ("description", "当前浏览器页面的 HTML 源码 (browser_get_source)")
        资源源码.加入文本成员 ("mimeType", "text/html")
        资源数组.加入成员 (资源源码)
        // 资源2: 当前页面文本
        变量 资源文本 <类型 = YYJSON对象类>
        资源文本.创建自文本 ("{}")
        资源文本.加入文本成员 ("uri", "browser://current/text")
        资源文本.加入文本成员 ("name", "当前页面文本内容")
        资源文本.加入文本成员 ("description", "当前浏览器页面的纯文本内容 (browser_get_text)")
        资源文本.加入文本成员 ("mimeType", "text/plain")
        资源数组.加入成员 (资源文本)
        // 资源3: 页面截图
        变量 资源截图 <类型 = YYJSON对象类>
        资源截图.创建自文本 ("{}")
        资源截图.加入文本成员 ("uri", "browser://current/screenshot")
        资源截图.加入文本成员 ("name", "当前页面截图")
        资源截图.加入文本成员 ("description", "当前浏览器页面的截图 (browser_screenshot)")
        资源截图.加入文本成员 ("mimeType", "image/png")
        资源数组.加入成员 (资源截图)
        // 资源4: 网络日志
        变量 资源网络 <类型 = YYJSON对象类>
        资源网络.创建自文本 ("{}")
        资源网络.加入文本成员 ("uri", "browser://current/network_logs")
        资源网络.加入文本成员 ("name", "网络请求日志")
        资源网络.加入文本成员 ("description", "当前浏览器会话的网络请求日志 (browser_network list)")
        资源网络.加入文本成员 ("mimeType", "application/json")
        资源数组.加入成员 (资源网络)
        // 资源5: 控制台日志
        变量 资源控制台 <类型 = YYJSON对象类>
        资源控制台.创建自文本 ("{}")
        资源控制台.加入文本成员 ("uri", "browser://current/console_logs")
        资源控制台.加入文本成员 ("name", "控制台日志")
        资源控制台.加入文本成员 ("description", "当前浏览器会话的控制台日志 (browser_collect console_enable)")
        资源控制台.加入文本成员 ("mimeType", "application/json")
        资源数组.加入成员 (资源控制台)
        // 资源6: Cookie数据
        变量 资源Cookie <类型 = YYJSON对象类>
        资源Cookie.创建自文本 ("{}")
        资源Cookie.加入文本成员 ("uri", "browser://current/cookies")
        资源Cookie.加入文本成员 ("name", "Cookie 数据")
        资源Cookie.加入文本成员 ("description", "当前浏览器会话的 Cookie 数据 (browser_get_cookies)")
        资源Cookie.加入文本成员 ("mimeType", "application/json")
        资源数组.加入成员 (资源Cookie)
        变量 结果对象 <类型 = YYJSON对象类>
        结果对象.创建自文本 ("{}")
        结果对象.加入数组成员 ("resources", 资源数组)
        返回 (构建JSONRPC响应 (请求ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ======== MCP prompts/list (v2.8) ==========

    方法 处理_提示列表 <公开 静态 类型 = 文本型 @输出名 = "HandleHintList" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    {
        // 返回常用浏览器自动化/逆向分析 prompt 模板
        变量 提示数组 <类型 = YYJSON数组类>
        提示数组.创建自文本数据 (MCP命令服务器.取空文本数组 ())
        // Prompt 1: 浏览器自动化爬取
        变量 提示自动化 <类型 = YYJSON对象类>
        提示自动化.创建自文本 ("{}")
        提示自动化.加入文本成员 ("name", "browser_automation")
        提示自动化.加入文本成员 ("description", "浏览器自动化: 导航→提取→填表 标准流程指导")
        变量 自动化参数列表 <类型 = YYJSON数组类>
        自动化参数列表.创建自文本数据 (MCP命令服务器.取空文本数组 ())
        变量 自动化参数URL <类型 = YYJSON对象类>
        自动化参数URL.创建自文本 ("{}")
        自动化参数URL.加入文本成员 ("name", "url")
        自动化参数URL.加入文本成员 ("description", "目标网站 URL")
        自动化参数URL.加入逻辑值成员 ("required", 真)
        自动化参数列表.加入成员 (自动化参数URL)
        提示自动化.加入数组成员 ("arguments", 自动化参数列表)
        提示数组.加入成员 (提示自动化)
        // Prompt 2: JS逆向分析
        变量 提示逆向 <类型 = YYJSON对象类>
        提示逆向.创建自文本 ("{}")
        提示逆向.加入文本成员 ("name", "js_reverse_analysis")
        提示逆向.加入文本成员 ("description", "JS逆向分析: 加密参数定位→Hook→还原 标准流程指导")
        变量 逆向参数列表 <类型 = YYJSON数组类>
        逆向参数列表.创建自文本数据 (MCP命令服务器.取空文本数组 ())
        变量 逆向参数URL <类型 = YYJSON对象类>
        逆向参数URL.创建自文本 ("{}")
        逆向参数URL.加入文本成员 ("name", "url")
        逆向参数URL.加入文本成员 ("description", "目标网站 URL (如 https://example.com/)")
        逆向参数URL.加入逻辑值成员 ("required", 真)
        逆向参数列表.加入成员 (逆向参数URL)
        提示逆向.加入数组成员 ("arguments", 逆向参数列表)
        提示数组.加入成员 (提示逆向)
        // Prompt 3: 反检测配置
        变量 提示反检测 <类型 = YYJSON对象类>
        提示反检测.创建自文本 ("{}")
        提示反检测.加入文本成员 ("name", "antidetect_setup")
        提示反检测.加入文本成员 ("description", "反检测配置: 浏览器指纹伪装完整流程指导")
        提示数组.加入成员 (提示反检测)
        // Prompt 4: 网络抓包分析
        变量 提示网络 <类型 = YYJSON对象类>
        提示网络.创建自文本 ("{}")
        提示网络.加入文本成员 ("name", "network_capture")
        提示网络.加入文本成员 ("description", "网络抓包: 开启Network日志→触发请求→分析参数 标准流程指导")
        提示数组.加入成员 (提示网络)
        变量 结果对象 <类型 = YYJSON对象类>
        结果对象.创建自文本 ("{}")
        结果对象.加入数组成员 ("prompts", 提示数组)
        返回 (构建JSONRPC响应 (请求ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ======== MCP tools/list ==========

    方法 处理_工具列表 <公开 静态 类型 = 文本型 @输出名 = "HandleToolList" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    {
        // 使用缓存避免每次重建(工具列表不变)
        如果 (工具列表缓存 != "")
        {
            返回 (构建JSONRPC响应 (请求ID, 工具列表缓存))
        }
        开始构建工具列表 ()
        填充工具列表 ()
        变量 结果JSON <类型 = 文本型>
        结果JSON = "{\"tools\":" + 完成构建工具列表 () + "}"
        // 缓存结果JSON
        工具列表缓存 = 结果JSON
        控制台输出 (到文本 ("[MCP] tools/list 已缓存, 长度=") + 到文本 (取文本长度 (结果JSON)))
        返回 (构建JSONRPC响应 (请求ID, 结果JSON))
    }

    # ======== 填充工具列表到数组 ==========

    方法 填充工具列表 <公开 静态 @输出名 = "FillToolList" @强制输出 = 真>
    {
        // === 核心 API (精简版 — 每个能力唯一) ===
        添加工具JSON ("browser_navigate", "导航到指定URL。默认等待载入完成(推荐, AI随后操作DOM/填表成功率高); wait_for_load传false/0或async_only:true跳过等待 | 仅支持 http/https/about/ftp 协议; data: 仅图片类型(image/png|jpeg|gif|webp|bmp|x-icon), 为防脚本注入 data:text/html 被拒", 多属性Schema文本 (属性项JSON ("url", "text", "URL地址") + "," + 属性项JSON ("wait_for_load", "boolean", "等待浏览器 OnLoadEnd 事件(默认true, 传false跳过)") + "," + 属性项JSON ("max_ms", "integer", "wait_for_load超时ms"), "\"url\""))
        添加工具JSON ("browser_get_url", "取当前页面URL| 即时同步返回(读 CEF 缓存值, 不执行JS)")
        添加工具JSON ("browser_get_title", "获取页面标题(默认同步返回CEF缓存标题, async_only:true改异步JS获取)", 单参数Schema文本 ("async_only", "boolean", "强制走异步JS获取(默认false=同步)", 假))
        添加工具JSON ("browser_back", "后退一页| 无导航历史时返回失败")
        添加工具JSON ("browser_forward", "前进一页| 无导航历史时返回失败")
        添加工具JSON ("browser_reload", "刷新页面。默认等待载入完成(wait_for_load传false/0跳过)", 多属性Schema文本 (属性项JSON ("ignore_cache", "boolean", "忽略缓存") + "," + 属性项JSON ("wait_for_load", "boolean", "等待 OnLoadEnd 事件(默认true; 传 false/0 跳过等待)") + "," + 属性项JSON ("max_ms", "integer", "超时ms"), ""))
        添加工具JSON ("browser_stop", "停止加载")
        添加工具JSON ("browser_execute_js", "执行JS(事件驱动, 异步回调返回执行状态)", 多属性Schema文本 (属性项JSON ("code", "text", "JS代码字符串") + "," + 属性项JSON ("file", "text", "JS文件路径(与code二选一)"), ""))
        添加工具JSON ("browser_evaluate", "执行JS并返回结果(默认同步)。支持code参数(inline)或file参数(从文件读取JS,避免转义问题)", 多属性Schema文本 (属性项JSON ("code", "text", "JS代码字符串") + "," + 属性项JSON ("file", "text", "JS文件路径(推荐:避免转义)") + "," + 属性项JSON ("max_ms", "integer", "同步等待ms"), ""))
        添加工具JSON ("browser_get_source", "获取HTML源码(默认异步, sync_wait:true可同步)", 单参数Schema文本 ("max_chars", "integer", "最大字符数(默认256KB=262144)", 假))
        添加工具JSON ("browser_get_text", "获取页面文本(selector非空时默认同步, 空selector=全文)", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器(空=全文, 默认同步)") + "," + 属性项JSON ("max_chars", "integer", "最大字符数(默认256KB)"), ""))
        添加工具JSON ("browser_open_devtools", "打开开发者工具")
        添加工具JSON ("browser_close_devtools", "关闭开发者工具")
        添加工具JSON ("browser_create", "新建浏览器窗口(默认 about:blank) | background:true 时创建**完全无窗口的后台浏览器**(类库注明: 无窗口无窗口句柄、只能后台不能显示, 与先创建再隐藏窗口不同、也非无头模式, 适合纯后台刷新取数, 占用比前台更低)| 需要浏览器级隔离或纯后台取数时使用, 常规自动化无需手动创建 | 允许 http/https/about/ftp; data: 仅图片类型(image/png|jpeg|gif|webp|bmp|x-icon), 为防脚本注入 data:text/html 被拒 | 新建后用 browser_list 取它的 id, 后续任何工具传 browser_id=<该id> 即可操作它(不传则仍作用于主浏览器)", 多属性Schema文本 (属性项JSON ("url", "text", "初始URL(默认about:blank)") + "," + 属性项JSON ("background", "boolean", "true=创建完全无窗口的后台浏览器(不显示、占用更低, 适合纯后台刷新取数); 默认false=可见窗口。实测: browser_id 目标隔离正确、不影响主浏览器的 CDP 工具, 且读取(execute_js/get_text)均正常") + "," + 属性项JSON ("tag", "text", "可选: 用户标识(类库只支持**创建时**设置, 无运行期设置接口)。设置后可用 browser_find_by_tag {tag} 找到该浏览器, browser_user_tags 可列出全部标识; 标识需唯一(重复时会取到既有那个)。不传则新浏览器没有标识"), ""))
        添加工具JSON ("browser_close", "关闭指定浏览器(默认关闭主浏览器)", 单参数Schema文本 ("browser_id", "integer", "浏览器ID(省略则关闭主浏览器)", 假))
        添加工具JSON ("browser_close_try", "[已废弃] 关闭浏览器, 已替换为 browser_close | ⛔ 该工具恒失败, 请改用 browser_close")
        添加工具JSON ("browser_list", "列出所有浏览器实例(返回各自的 id/url)。**多浏览器用法**: 返回的 id 可直接作为任何工具的公共参数 browser_id 传入, 该次调用即作用于指定浏览器(如 browser_navigate {url:..., browser_id:2}); 不传 browser_id 则作用于主浏览器。browser_id 是请求级公共参数, 无需在单个工具 schema 里声明")
        添加工具JSON ("browser_set_zoom", "设置缩放", 单参数Schema文本 ("level", "text", "如1.0,1.5,0.8 (文本或数值均可)"))
        添加工具JSON ("browser_get_zoom", "取当前缩放级别(如 1.0)")
        添加工具JSON ("browser_find", "页面内查找文本并高亮| 返回匹配总数/当前序号; 用 stop_find 停止", 单参数Schema文本 ("text", "text", "查找内容"))
        添加工具JSON ("browser_stop_find", "停止查找")
        添加工具JSON ("browser_mouse_click", "在页面坐标 (x,y) 处点击鼠标| button=left/right/middle(默认left); 坐标是页面视口坐标, 可用 dom_rect 取元素坐标| 默认经 CDP 派发(不破坏会话); kernel:true 改内核注入(更难被反爬检测但**会使 CDP 通道失效**, 需重启进程恢复)", 多属性Schema文本 (属性项JSON ("x", "integer", "X") + "," + 属性项JSON ("y", "integer", "Y") + "," + 属性项JSON ("button", "text", "left/right/middle") + "," + 属性项JSON ("kernel", "boolean", "true=内核注入(会破坏CDP会话); 默认false=CDP派发"), "\"x\",\"y\""))
        添加工具JSON ("browser_mouse_move", "把鼠标移动到页面坐标 (x,y)| 默认经 CDP Input.dispatchMouseEvent 派发(不会破坏 CDP 会话); 传 kernel:true 改用内核级注入(更难被反爬检测, 但实测**会使 CDP 通道失效**: 之后 CDP 优先工具退化为原生路径、每次白等约10秒且部分返回 null, 需重启进程才能恢复)", 多属性Schema文本 (属性项JSON ("x", "integer", "X") + "," + 属性项JSON ("y", "integer", "Y") + "," + 属性项JSON ("kernel", "boolean", "true=内核级注入(会破坏CDP会话); 默认false=CDP派发"), "\"x\",\"y\""))
        添加工具JSON ("browser_mouse_wheel", "在 (x,y) 处滚动鼠标滚轮| delta_y 为正向下滚; 单纯滚动页面也可用 scroll_by| 默认经 CDP 派发(不破坏会话); kernel:true 改内核注入(更难被反爬检测但**会使 CDP 通道失效**, 需重启进程恢复)", 多属性Schema文本 (属性项JSON ("x", "integer", "X") + "," + 属性项JSON ("y", "integer", "Y") + "," + 属性项JSON ("delta_x", "integer", "横向") + "," + 属性项JSON ("delta_y", "integer", "纵向") + "," + 属性项JSON ("kernel", "boolean", "true=内核注入(会破坏CDP会话); 默认false=CDP派发"), "\"x\",\"y\""))
        添加工具JSON ("browser_key_event", "发送键盘事件| key_code=虚拟键码(如 13=Enter, 65=A), type=keydown/keyup/char, modifiers=修饰键位掩码; 输入文本请用 vip_key_type", 多属性Schema文本 (属性项JSON ("key_code", "integer", "虚拟键码") + "," + 属性项JSON ("type", "text", "keydown/keyup/char") + "," + 属性项JSON ("modifiers", "integer", "修饰键"), "\"key_code\""))
        添加工具JSON ("browser_print", "打印")
        添加工具JSON ("browser_print_to_pdf", "把当前页面打印为 PDF 文件| 异步执行, 用 mcp_result 取结果; 需给 path; 目标文件已存在时需 overwrite:true", 多属性Schema文本 (属性项JSON ("path", "text", "路径") + "," + 属性项JSON ("overwrite", "boolean", "覆盖"), ""))
        添加工具JSON ("browser_get_cookies", "获取Cookie(含HttpOnly)", 单参数Schema文本 ("limit", "integer", "上限(默认200)", 假))
        添加工具JSON ("browser_set_cookie", "设置Cookie", 多属性Schema文本 (属性项JSON ("name", "text", "名称") + "," + 属性项JSON ("value", "text", "值") + "," + 属性项JSON ("domain", "text", "域名"), "\"name\",\"value\""))
        添加工具JSON ("browser_delete_cookies", "删除所有域名下全部Cookie| 破坏性操作, 必须传 confirm:true", 单参数Schema文本 ("confirm", "boolean", "确认"))
        添加工具JSON ("browser_clear_cache", "清理CEF全局缓存| 异步; 影响所有浏览器实例, 不只当前页")
        添加工具JSON ("browser_clear_cache_browser", "清理当前浏览器缓存 | 可选**按对象粒度**清理(类库的位或语义): targets 传逗号分隔的对象名, 例 localstorage,indexeddb 即只清本地存储与索引库而**保留 Cookies**; origin 留空=当前域 | 缺省与旧行为一致: 当前域 + 全部对象 + 全部存储类型", 多属性Schema文本 (属性项JSON ("origin", "text", "只清该源(须含 http(s) 且不含路径), 例 https://www.example.com; 留空=当前origin") + "," + 属性项JSON ("targets", "text", "逗号分隔的清理对象(缺省=all): appcache,cookies,filesystem,indexeddb,localstorage,shadercache,websql,serviceworkers,cachestorage,pluginprivatedata,backgroundfetch,conversions,all") + "," + 属性项JSON ("storage_types", "text", "逗号分隔的存储类型(缺省=all): temporary,persistent,syncable,all"), ""))
        添加工具JSON ("browser_cache_dir", "获取缓存目录")
        添加工具JSON ("browser_set_mute", "设置静音", 单参数Schema文本 ("mute", "boolean", "静音"))
        添加工具JSON ("browser_is_muted", "查询静音状态")
        添加工具JSON ("browser_is_loading", "查询页面是否正在加载| 取自 CEF OnLoadStart/End 状态, 比读 JS readyState 更可靠")
        添加工具JSON ("browser_can_navigate", "查询当前页面可否后退/前进")
        添加工具JSON ("browser_get_id", "取当前操作目标浏览器的ID| 未显式指定 browser_id 时即为已有网页的主浏览器")
        添加工具JSON ("browser_compress_memory", "V8内存压缩")
        添加工具JSON ("browser_fbro_version", "CEF内核版本")
        添加工具JSON ("browser_meta", "元数据(机器码/授权/版本)")
        添加工具JSON ("browser_set_proxy", "设置浏览器代理并持久生效(新浏览器自动应用)| address 形如 ip:port; 设置后需刷新页面才作用于当前页", 多属性Schema文本 (属性项JSON ("address", "text", "代理地址") + "," + 属性项JSON ("username", "text", "账号") + "," + 属性项JSON ("password", "text", "密码"), "\"address\""))
        添加工具JSON ("browser_clear_proxy", "清除代理")
        添加工具JSON ("browser_start_download", "触发下载 | 仅支持 http/https 协议", 单参数Schema文本 ("url", "text", "URL"))
        添加工具JSON ("browser_download_image", "下载图片到 Downloads 目录| 异步, 用 mcp_result 取保存路径", 单参数Schema文本 ("url", "text", "图片URL"))
        添加工具JSON ("browser_edit_undo", "撤销上一次编辑(原生编辑命令)| 作用于当前焦点元素")
        添加工具JSON ("browser_edit_redo", "重做(撤销的逆操作, redo)| 注意不是 resume")
        添加工具JSON ("browser_edit_cut", "剪切选中内容到剪贴板| 作用于当前焦点元素")
        添加工具JSON ("browser_edit_copy", "复制选中内容到剪贴板| 作用于当前焦点元素")
        添加工具JSON ("browser_edit_paste", "把剪贴板内容粘贴到当前焦点元素")
        添加工具JSON ("browser_edit_delete", "删除选中内容| 作用于当前焦点元素")
        添加工具JSON ("browser_edit_select_all", "全选当前页面/焦点元素内容")
        添加工具JSON ("browser_get_frames", "框架列表(默认同步返回)")
        添加工具JSON ("browser_frame_names", "框架名称列表(默认同步返回)")
        添加工具JSON ("browser_frame_by_name", "按名查框架", 单参数Schema文本 ("name", "text", "框架名"))
        添加工具JSON ("browser_frame_by_id", "按框架ID取框架信息(与 browser_frame_by_name 对称)。browser_get_frames 给出的 frame_id 可直接用; 找不到框架不算失败, 会回 found:false + hint(导航/刷新后旧 ID 失效, 请重新取)", 多属性Schema文本 (属性项JSON ("frame_id", "text", "框架ID(browser_get_frames 回包里的 id 字段)") + "," + 属性项JSON ("id", "text", "同上, 兼容 browser_get_frames 的字段名"), "\"frame_id\""))
        添加工具JSON ("browser_get_focused_frame", "获取焦点框架")
        添加工具JSON ("browser_get_window_handle", "获取窗口句柄")
        添加工具JSON ("browser_set_focus", "设置焦点", 单参数Schema文本 ("focus", "boolean", "焦点"))
        添加工具JSON ("browser_set_auto_resize", "启用/关闭窗口自动调整大小(CEF SetAutoResizeEnabled)。**已实现**: 经类库 置自动调整大小 调用宿主 SetAutoResizeEnabled(不需 HWND)。类库无返回值、且该类设置没有可回读的查询接口, 故只报 verified=false 而不谎报生效。⚠ 类库声明顺序是 最小**高度**、最小**宽度**(与 CEF 的 {width,height} 相反), 官方样例都用对称值无法消歧 —— 传非对称值时请自行确认顺序", 多属性Schema文本 (属性项JSON ("enable", "boolean", "true=启用(窗口可随内容增长) / false=关闭 | 必填") + "," + 属性项JSON ("min_height", "integer", "最小高度(0=该维不限)") + "," + 属性项JSON ("min_width", "integer", "最小宽度(0=该维不限)") + "," + 属性项JSON ("max_height", "integer", "最大高度(0=该维不限)") + "," + 属性项JSON ("max_width", "integer", "最大宽度(0=该维不限)"), "\"enable\""))
        添加工具JSON ("browser_restore_gui", "恢复嵌入式GUI布局与欢迎页")
        添加工具JSON ("browser_shutdown", "安全关闭AI浏览器(需confirm:true)", 多属性Schema文本 (属性项JSON ("confirm", "boolean", "确认关闭") + "," + 属性项JSON ("delay_seconds", "integer", "延迟秒"), "\"confirm\""))
        添加工具JSON ("browser_show_window", "显示/隐藏浏览器窗口。**已实现**: 经类库 显示隐藏窗口 调用宿主 ShowWindows(不需 HWND), 并用 GWL_STYLE 的 WS_VISIBLE 位**回读验证**; 位没变成请求的状态就如实报 verified=false, 不谎报成功。说明: 用户看到的窗口就是浏览器窗口本身(本项目为控制台程序, 浏览器以桌面为父窗口), 所以隐藏后**你需要再调一次 visible:true 把它显示回来**", 多属性Schema文本 (属性项JSON ("visible", "boolean", "true=显示窗口 / false=隐藏窗口 | 必填(缺省语义不明, 不接受缺省)"), "\"visible\""))
        添加工具JSON ("browser_move_window", "移动/缩放浏览器窗口。**已实现**: 经类库 移动窗口 -> 宿主 MoveWindow(不需 HWND), 并用 CDP Browser.getWindowForTarget 回读 bounds 验证, 回读不符则如实报 verified=false。width/height 省略时保持当前尺寸。注意: 用户看到的就是浏览器窗口本身(本项目为控制台程序, 浏览器以桌面为父窗口), 所以本工具会真的移动你眼前的窗口", 多属性Schema文本 (属性项JSON ("x", "integer", "X") + "," + 属性项JSON ("y", "integer", "Y") + "," + 属性项JSON ("width", "integer", "宽(省略/<=0=保持当前)") + "," + 属性项JSON ("height", "integer", "高(省略/<=0=保持当前)") + "," + 属性项JSON ("repaint", "boolean", "是否重画(默认false)"), "\"x\",\"y\""))
        添加工具JSON ("browser_dom_query", "DOM查询(默认同步返回)", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("attribute", "text", "属性名") + "," + 属性项JSON ("index", "integer", "索引"), "\"selector\""))
        添加工具JSON ("browser_dom_click", "DOM点击(默认同步, 返回clicked/element not found)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_dom_set_value", "DOM设置值(默认同步, 返回ok状态)", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("value", "text", "值"), "\"selector\",\"value\""))
        添加工具JSON ("browser_dom_get_html", "DOM获取HTML(selector非空时默认同步, 空selector=全文)", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器(空=全文源码)") + "," + 属性项JSON ("max_chars", "integer", "最大字符数(默认256KB)"), ""))
        添加工具JSON ("browser_dom_rect", "DOM获取元素坐标(原生API)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_dom_inner_html", "DOM获取innerHTML(原生API)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_dom_set_html", "DOM设置innerHTML(原生,同步)", 多属性Schema文本 (属性项JSON ("selector", "text", "选择器") + "," + 属性项JSON ("html", "text", "HTML代码"), "\"selector\",\"html\""))
        添加工具JSON ("browser_dom_checked", "DOM获取checkbox状态(原生API)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_dom_selected", "DOM获取select选中项(原生API)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_dom_select", "DOM设置select选中项(原生,同步)", 多属性Schema文本 (属性项JSON ("selector", "text", "选择器") + "," + 属性项JSON ("index", "integer", "选中索引"), "\"selector\""))
        添加工具JSON ("browser_extract", "提取页面结构化数据(链接/图片/表格)", 多属性Schema文本 (属性项JSON ("type", "text", "links/images/tables") + "," + 属性项JSON ("limit", "integer", "上限"), "\"type\""))
        添加工具JSON ("browser_scrape", "一站式爬虫:导航→等待→提取 | 仅支持 http/https/about/ftp 协议; data: 仅图片类型(image/png|jpeg|gif|webp|bmp|x-icon), 为防脚本注入 data:text/html 被拒", 多属性Schema文本 (属性项JSON ("url", "text", "目标URL") + "," + 属性项JSON ("extract_selector", "text", "提取选择器(body=全文)") + "," + 属性项JSON ("wait_selector", "text", "等待选择器") + "," + 属性项JSON ("max_ms", "integer", "最大ms"), "\"url\""))
        添加工具JSON ("browser_console_eval", "控制台执行JS(默认同步返回)", 单参数Schema文本 ("expression", "text", "JS表达式"))
添加工具JSON ("browser_fingerprint", "浏览器指纹总入口(按 action 分派)| canvas_random/webgl_random/audio_random 为随机噪点, audio_param 设音频参数, webrtc/geolocation/timezone/ssl 为对应维度虚拟化, set_batch 批量下发, ua 走 browser_fingerprint_ua, count 查当前生效项数, clear 清空 | 多数改动需刷新页面生效", 多属性Schema文本 (属性项JSON ("action", "text", "canvas_random/webgl_random/audio_random/audio_param/webrtc/geolocation/timezone/ssl/ua/set_batch/count/clear") + "," + 属性项JSON ("config", "text", "JSON配置"), "\"action\""))
添加工具JSON ("browser_context_menu", "右键菜单自定义(方案甲: 预置规格, 每次右键时由 CEF 回调施加)。浏览器每次右键都是**全新的默认菜单模型**, 且 CEF 明确禁止在回调之外持有菜单对象, 故本工具**不能即时修改当前已打开的菜单**, 只能先 set 预置规格, 之后每次右键自动施加。规格为逐行文本, 每行: 类型|标签|命令ID|参数|父命令ID|快捷键 —— 创建类: item/check/radio/sep/sub; **修改已存在条目**: del(删除)/relabel(改标签)/vis(显示隐藏)/dis(禁用启用)/mark(勾选, 仅对 check/radio 类条目有效)/accel(设快捷键)/noaccel(移除快捷键) —— 创建类命令ID 须在 26500..28500(留0自动分配); **修改类**的 命令ID 指向**本服务自建的**条目(26500..28500)。实测: 指向浏览器默认菜单项(标准ID 100..130 或其别名 back/reload/copy 等)的修改类**不会生效** —— 右键后用 action=get 看 apply_failed 会逐条说明; 创建类不受影响; 参数: item与sub为1可用0禁用, check为1选中, radio为群ID; 父命令ID=0 表示顶层, 非0 表示挂到其上方最近的 sub 行(故子项须紧跟其 sub 行); 快捷键仅用于显示(如 70C = 键码70+Ctrl, 可组合 S/A), 触发需自行发键盘事件。命令ID 须在 26500..28500, 留 0 则由服务端自动分配。施加结果可读回核对: action=get 的 verified_items/verify_mismatch(注意类库只读 getter 是否禁止 语义与名字相反, 实测它返回的是「是否可用」, 服务端已按此校正)与 apply_failed(哪条没生效及原因)。注意: 本工具与 browser_kernel_menu(屏蔽快捷菜单)语义相反", 多属性Schema文本 (属性项JSON ("action", "text", "set/get/clear") + "," + 属性项JSON ("items", "text", "set: 菜单规格(逐行文本, 格式见工具描述)") + "," + 属性项JSON ("enable", "boolean", "set: 是否启用(默认true)"), "\"action\""))
添加工具JSON ("browser_intercept", "资源拦截/篡改(手写ResponseFilter过滤器, 不依赖VIP; url一律按子串匹配, 无正则模式)。action=modify(流式内容搜索替换,需search_text/replace_text,仅文本类MIME)/replace_data(整体替换为replace_text数据)/replace_file(整体替换为file_path文件内容,需文本类文件)/block(返回屏蔽提示页)/line_replace(行号区间替换,需line_start/line_end/replace_text)/unmodify(按url撤销资源替换规则,返回实际删除条数;撤销不存在按幂等成功)/unreplace(同上,但只撤销replace_file类)/navigate_block/navigate_redirect/popup_config/cache/clear。url为子串匹配, 刷新页面后生效。注: clear 与 un* 只作用于手写过滤器通道, 不含 VIP 过滤器", 多属性Schema文本 (属性项JSON ("action", "text", "modify/replace_data/replace_file/block/line_replace/unmodify/unreplace/navigate_block/navigate_redirect/popup_config/popup_disable/cache/uncache/clear/ws_hook") + "," + 属性项JSON ("url", "text", "目标URL子串(匹配请求URL包含该串的资源); unmodify/unreplace 用它指定要撤销哪条规则(同口径)") + "," + 属性项JSON ("search_text", "text", "modify: 被替换内容") + "," + 属性项JSON ("replace_text", "text", "modify: 替换为内容 / replace_data: 替换数据 / line_replace: 替换为代码块") + "," + 属性项JSON ("file_path", "text", "replace_file: 本地文本文件路径") + "," + 属性项JSON ("line_start", "integer", "line_replace: 起始行号(含, 从1开始)") + "," + 属性项JSON ("line_end", "integer", "line_replace: 结束行号(含)") + "," + 属性项JSON ("target", "text", "navigate_redirect: 重定向目标URL"), "\"action\""))
        添加工具JSON ("browser_screenshot", "页面截图| 返回 base64 图片(data:image/...); format=png/jpeg/webp, 可指定 width/height/x/y/scale 裁剪缩放", 多属性Schema文本 (属性项JSON ("format", "text", "png/jpeg/webp") + "," + 属性项JSON ("width", "integer", "宽度(默认1920)") + "," + 属性项JSON ("height", "integer", "高度(默认1080)") + "," + 属性项JSON ("x", "integer", "X偏移(默认0)") + "," + 属性项JSON ("y", "integer", "Y偏移(默认0)") + "," + 属性项JSON ("scale", "integer", "缩放(默认1)"), ""))
        添加工具JSON ("browser_collect", "网络/控制台/场景预备/事件族开关。console_get 支持 keyword 参数按日志内容搜索(定位Hook输出/报错/特征串), limit 限制条数。事件族开关(每族独立, 也可用 browser_kernel_events_all action=enable 一次全开): event_load/title/progress/resource/dialog/fullscreen/favicon/find/frame/download/focus/lifecycle/app_enable(原有13族), event_menu/quickmenu/navintent/ui/extension/startup/render/renderws/permission_enable(v3.2新增9族, 其中 permission 可感知页面索要摄像头/麦克风/定位), event_offscreen_enable(v3.3, 离屏渲染族, 仅OSR模式触发), event_all_enable / event_all_disable。开启后用 browser_event 查询", 单参数Schema文本 ("action", "text", "network_*/console_*/reverse_prepare/debug_prepare/debug_flow/debug_wait_paused/debug_inspect/debug_script_source/debug_resume/automation_prepare/cache_enable/cache_clear/detail_enable/clear/list/network_clear/network_detail_enable/network_disable/network_enable/network_get/console_enable/console_disable/console_clear/event_load_enable/event_title_enable/event_progress_enable/event_resource_enable/event_dialog_enable/event_fullscreen_enable/event_favicon_enable/event_find_enable/event_frame_enable/event_download_enable/event_focus_enable/event_lifecycle_enable/event_app_enable/event_menu_enable/event_quickmenu_enable/event_navintent_enable/event_ui_enable/event_extension_enable/event_startup_enable/event_render_enable/event_renderws_enable/event_permission_enable/event_offscreen_enable/event_devtoolspopup_enable/event_urlreq_enable/event_all_enable/event_all_disable"))
        添加工具JSON ("browser_network", "网络日志 list/enable/clear (list 默认 auto_enable; 亦接受 network_ 前缀别名)", 单参数Schema文本 ("action", "text", "list/get/enable/disable/clear/detail_enable/network_get/network_enable/network_disable/network_clear/network_detail_enable"))
        添加工具JSON ("browser_status", "浏览器完整状态(弹窗/文档/加载/缩放/静音/URL/标题/句柄)")
        添加工具JSON ("browser_window_info", "窗口信息(title/hwnd/parent/opener/devtools/tag)")
        添加工具JSON ("browser_view_source", "在新标签打开当前页面源码视图(view-source:)| 取源码字符串请用 get_source")
        添加工具JSON ("browser_inject", "注入JS/CSS/Handler", 多属性Schema文本 (属性项JSON ("type", "text", "js/css/handler(persist时handler由渲染_即将初始化WebKit注册)") + "," + 属性项JSON ("code", "text", "代码") + "," + 属性项JSON ("persist", "boolean", "持久(V8预注入,type=handler时须persist)"), "\"type\",\"code\""))
        添加工具JSON ("browser_wait", "异步等待条件 (轮询, 通过mcp_result查询)。what=selector/text/load_end/load_start/navigate/timeout/network_idle/url_contains。navigate无value等同load_end; navigate有value则等到URL匹配; network_idle等网络空闲(活动请求数=0); url_contains等URL包含指定字符串", 多属性Schema文本 (属性项JSON ("what", "text", "selector/text/timeout/load_end/load_start/navigate/network_idle/url_contains") + "," + 属性项JSON ("value", "text", "等待值(navigate/url_contains=目标URL, load_*/network_idle可省略)") + "," + 属性项JSON ("max_ms", "integer", "最大ms(默认10000)"), "\"what\""))
        添加工具JSON ("browser_cdp", "Chrome DevTools协议(VIP)", 多属性Schema文本 (属性项JSON ("method", "text", "CDP方法") + "," + 属性项JSON ("params", "text", "参数JSON"), "\"method\""))
        添加工具JSON ("browser_debugger_enable", "启用CDP调试器(Debugger.enable)| 断点类工具的前置步骤; 调用会自动清除与之冲突的反检测项(禁用Debugger检测)")  // 注: pause 恒失败已从工具清单剔除(会冻结无JS执行页面并堵塞CDP队列), 用 debugger_flow
        添加工具JSON ("browser_debugger_resume", "从断点继续执行(Debugger.resume)| 需页面处于暂停态, 否则返回 页面未处于暂停状态")
        添加工具JSON ("browser_debugger_step_over", "单步跳过(执行当前行但不进入被调函数)| 需页面处于暂停态")
        添加工具JSON ("browser_debugger_step_into", "单步进入(进入被调函数内部)| 需页面处于暂停态")
        添加工具JSON ("browser_debugger_step_out", "单步跳出(执行完当前函数并返回调用处)| 需页面处于暂停态")
        添加工具JSON ("browser_debugger_stack", "取当前暂停点的JS调用栈(函数名/URL/行号/作用域) | **无需任何前置调用**: 页面未暂停时会自动启用调试器、安排执行点并制造暂停点(经 auto_prepared 上报), 用完请 browser_debugger_resume 恢复 | 若显式传 stack_trace_id 则改走 CDP 的 Debugger.getStackTrace(该 id 来自错误对象的 stackTrace, 由 browser_event/异常事件给出)", 多属性Schema文本 (属性项JSON ("stack_trace_id", "text", "可选: 错误对象上的 stackTraceId(来自 Runtime.exceptionThrown); 省略=取当前暂停点调用栈"), ""))
        添加工具JSON ("browser_debugger_set_breakpoint", "在URL匹配正则的脚本上设行断点(Debugger.setBreakpointByUrl)| 设完需导航或触发脚本才会命中, 再用 wait_paused 等待", 多属性Schema文本 (属性项JSON ("url", "text", "脚本URL正则(如 my\\\\.js 或 example\\\\.com)") + "," + 属性项JSON ("line", "integer", "行号(0起算,默认0,FBrowser必填)") + "," + 属性项JSON ("column", "integer", "列号(0起算,可选)"), "\"url\""))
        添加工具JSON ("browser_debugger_evaluate", "在指定调用帧内求值(Debugger.evaluateOnCallFrame)| 断点处查看变量的主力工具; parse:true 走同步解析", 多属性Schema文本 (属性项JSON ("call_frame_id", "text", "帧ID(空=自动取最近暂停的活帧, 会自动制造暂停点)") + "," + 属性项JSON ("expression", "text", "表达式") + "," + 属性项JSON ("parse", "boolean", "同步解析结果(默认false)") + "," + 属性项JSON ("expand", "boolean", "展开object/function属性(默认true)") + "," + 属性项JSON ("return_by_value", "boolean", "returnByValue(默认true)"), "\"expression\""))
        添加工具JSON ("browser_debugger_wait_paused", "等待 Debugger.paused(VIP)", 多属性Schema文本 (属性项JSON ("max_ms", "integer", "超时毫秒(默认30000)") + "," + 属性项JSON ("fresh", "boolean", "先清除旧事件(默认false; flow内自动处理)"), ""))
        添加工具JSON ("browser_debugger_last_paused", "最近断点暂停信息(VIP)", 单参数Schema文本 ("parse", "boolean", "解析call_frame_id/frames(默认true)", 假))
        添加工具JSON ("browser_debugger_inspect", "断点处批量求值(VIP)", 多属性Schema文本 (属性项JSON ("call_frame_id", "text", "帧ID(空=最近paused)") + "," + 属性项JSON ("expressions", "text", "JSON数组或单表达式") + "," + 属性项JSON ("expression", "text", "单表达式") + "," + 属性项JSON ("expand", "boolean", "展开object/function(默认true)") + "," + 属性项JSON ("return_by_value", "boolean", "returnByValue(默认true)"), "\"expressions\""))
        添加工具JSON ("browser_debugger_flow", "断点一键流程: enable→设断点→导航→等暂停→帧内求值→resume| 逆向调试首选, 免手工编排6步", 多属性Schema文本 (属性项JSON ("url", "text", "导航URL(可选)") + "," + 属性项JSON ("breakpoint", "text", "URL正则") + "," + 属性项JSON ("line", "integer", "断点行号(0起)") + "," + 属性项JSON ("column", "integer", "断点列号(可选)") + "," + 属性项JSON ("expressions", "text", "帧内求值JSON数组") + "," + 属性项JSON ("expand", "boolean", "展开object/function(默认true)") + "," + 属性项JSON ("return_by_value", "boolean", "returnByValue(默认true)") + "," + 属性项JSON ("max_ms", "integer", "等待暂停毫秒(默认12000; 客户端自身超时更短时请调低)") + "," + 属性项JSON ("resume", "boolean", "求值后自动resume(默认true)"), "\"breakpoint\""))
        添加工具JSON ("browser_debugger_script_source", "取断点处脚本源码与上下文行| 无暂停上下文时需显式给 script_id", 多属性Schema文本 (属性项JSON ("call_frame_id", "text", "帧ID(空=最近paused)") + "," + 属性项JSON ("script_id", "text", "scriptId(空=paused自动)") + "," + 属性项JSON ("line", "integer", "行号(0起,空=paused)") + "," + 属性项JSON ("column", "integer", "列号(可选)") + "," + 属性项JSON ("context_lines", "integer", "上下文行数(默认3)") + "," + 属性项JSON ("include_source", "boolean", "返回完整scriptSource(默认true)"), ""))
        添加工具JSON ("browser_debugger_auto", "自动断点求值(VIP): 断点命中→自动执行JS→resume→循环, max_hits次后自动停止", 多属性Schema文本 (属性项JSON ("breakpoint", "text", "URL正则(必填)") + "," + 属性项JSON ("line", "integer", "行号") + "," + 属性项JSON ("url", "text", "导航URL(可选)") + "," + 属性项JSON ("expressions", "text", "求值表达式JSON数组(默认[location.href])") + "," + 属性项JSON ("max_hits", "integer", "最大命中次数(默认5,最大100)") + "," + 属性项JSON ("max_ms", "integer", "每次等待超时ms(默认60000)"), "\"breakpoint\""))
        添加工具JSON ("browser_network_body", "获取响应体(VIP)", 单参数Schema文本 ("request_id", "text", "请求ID"))
        添加工具JSON ("browser_touch_press", "触摸按下(移动端仿真)| 缺省经 CDP Input.dispatchTouchEvent 派发, 会自动开启触摸仿真(零前置, 无需先调 fingerprint touch_enable), 且实测不破坏 CDP 会话 | 与 touch_move/touch_release 配对做拖拽/滑动 | 仅当传 kernel:true 才走内核级注入(过反爬场景, 但会使 CDP 通道在本会话内永久失效, 需重启进程恢复)", 双XY_Schema文本 ("x", "y", "X", "Y"))
        添加工具JSON ("browser_touch_release", "触摸放开| 与 touch_press 配对, 结束触摸/拖拽 | 缺省经 CDP 派发(不破坏 CDP 会话, 无需前置) | 仅当传 kernel:true 才走内核级注入(会使 CDP 通道在本会话内失效)", 双XY_Schema文本 ("x", "y", "X", "Y"))
        添加工具JSON ("browser_touch_move", "触摸拖动| 用于滑动/长按拖动 | 缺省经 CDP 派发(不破坏 CDP 会话); 若当前并无按下点, 会自动补一次 touchStart 并经 auto_prepared 如实上报(想控制拖动起点请先 touch_press) | 仅当传 kernel:true 才走内核级注入(会使 CDP 通道在本会话内失效)", 双XY_Schema文本 ("x", "y", "X", "Y"))
        添加工具JSON ("browser_base64_encode", "Base64编码", 单参数Schema文本 ("data", "text", "数据"))
        添加工具JSON ("browser_base64_decode", "Base64解码", 单参数Schema文本 ("data", "text", "数据"))
        添加工具JSON ("browser_uri_encode", "URI编码(百分号编码, 与 JS encodeURIComponent 基本一致)。字母数字与 -_.!~* 等少数字符之外都会变成 %XX; 空格默认 %20, use_plus:true 时变成 + (表单语义)", 多属性Schema文本 (属性项JSON ("data", "text", "要编码的文本") + "," + 属性项JSON ("use_plus", "boolean", "true=空格编码为 + / false(默认)=空格编码为 %20"), "\"data\""))
        添加工具JSON ("browser_uri_decode", "URI解码(百分号还原)。实测: 类库解码器在本机**无法还原 ASCII 特殊字符**的转义(%20/%26/%3D 会原样返回, 只还原非 ASCII), 所以当结果仍残留 %HH 时, 本工具会**自动**改用页面内 decodeURIComponent 补齐 —— 一次调用即可拿到完整结果; 回包 data.via 如实说明实际走的路径(lib:… 或 js:decodeURIComponent)。to_utf8 与 keep_escaped 直接透传给类库(keep_escaped:true 即类库原始行为); 注意 + 不会被当作空格", 多属性Schema文本 (属性项JSON ("data", "text", "要解码的文本") + "," + 属性项JSON ("to_utf8", "boolean", "true(默认)=把解码结果按 UTF-8 解释") + "," + 属性项JSON ("keep_escaped", "boolean", "true(默认)=类库原始行为 / false=类库完全不还原(实测更差, 仅供对照)"), "\"data\""))
        添加工具JSON ("browser_codec", "零前置编解码(hex / UTF-8 / GBK多字节)。全部走【视窗基本类】已有函数, 无新模块、无新二进制。action: hex_encode(文本或base64字节 到 hex) / hex_decode(hex 到 文本或hex/base64) / utf8_encode(文本 到 UTF-8字节) / utf8_decode(UTF-8字节 到 文本) / gbk_encode(文本 到 GBK字节) / gbk_decode(GBK字节 到 文本, 中国站GBK响应体专治)。input=text|hex|base64 决定 data 怎么读(encode 方向一律按文本读, 字符集由 action 决定); output=hex|text|base64 决定结果怎么给(encode 默认 hex, decode 默认 text); uppercase(默认false)控制 hex 大小写; allow_spaces(默认true)允许 hex 里带空格/换行。工具层已做确定性处理: 内部固定传【假】给 文本到UTF8/文本到多字节 的第二参(其默认为真会在尾部多一个零字节)、hex 输入先校验偶数长度与合法字符并归一化成大写、解码后回验字节数。文本出口按类库的C字符串语义构造, 遇内嵌0x00会截断 —— 含NUL的二进制请用 output=hex|base64。", 多属性Schema文本 (属性项JSON ("action", "text", "hex_encode/hex_decode/utf8_encode/utf8_decode/gbk_encode/gbk_decode") + "," + 属性项JSON ("data", "text", "要处理的数据(文本, 或 input 指定的 hex/base64)") + "," + 属性项JSON ("input", "text", "data怎么读: text(默认) / hex / base64") + "," + 属性项JSON ("output", "text", "结果怎么给: encode默认hex, decode默认text; 可选 text/hex/base64") + "," + 属性项JSON ("uppercase", "boolean", "hex 输出是否大写(默认false=小写)") + "," + 属性项JSON ("allow_spaces", "boolean", "hex 输入是否允许空格与换行(默认true)"), "\"action\",\"data\""))
        添加工具JSON ("browser_time_convert", "时间戳换算与格式化(零前置, 走【视窗基本类】时间操作类)。action: now(当前时间) / ts_to_text(时间戳到时间) / text_to_ts(时间文本到时间戳) / verify_tz(时区自检锚点: 指定时间(1970,1,1,8,0,0) 的秒级时间戳在本机UTC+8下必须为 0)。action 可省略, 按已给参数自动选(timestamp则ts_to_text, time_text则text_to_ts, 都没给则now), 以免空参调用必然失败。unit=s|ms 指定秒或毫秒; format 为类库格式串(默认 %Y-%m-%d %H:%M:%S, 请避免 %a %A %b %B %c %p %x %X 这些随系统区域设置变化的替换符); chinese(默认true)指定时间文本是年月日顺序还是月日年顺序。返回 data.timestamp_s / data.timestamp_ms / data.local / data.friendly / data.tz_offset_minutes / data.ole / data.year。语义说明: 秒级/毫秒级时间戳都是【真 UTC】值(类库按当前时区 Bias 补偿, UTC+8 时 Bias=-480); local 按机器本地时区渲染; friendly 来自 时间到文本, 会省略为0的时分秒(午夜退化成日期), 故只作人读字段。上限: 秒级 2147483647(=2038-01-19 03:14:07Z), 越界会明确报错并指向 unit=ms(类库 取时间戳 返回 32 位整数)。", 多属性Schema文本 (属性项JSON ("action", "text", "now/ts_to_text/text_to_ts/verify_tz (可省略, 按已给参数自动选)") + "," + 属性项JSON ("timestamp", "integer", "UNIX 时间戳(秒或毫秒, 由 unit 决定)") + "," + 属性项JSON ("unit", "text", "s(秒, 默认) / ms(毫秒)") + "," + 属性项JSON ("time_text", "text", "时间文本, 例: 1973年11月15日12时30分25秒 或 1970-01-01 08:00:00") + "," + 属性项JSON ("format", "text", "格式化串(默认 %Y-%m-%d %H:%M:%S)") + "," + 属性项JSON ("chinese", "boolean", "time_text 是否年月日顺序(默认true)"), "\"action\""))
        添加工具JSON ("browser_hash", "哈希/摘要: MD5(文本) / MD5(文件, 支持大文件) / XXH128 / CRC32(同时给有符号 crc32 与标准无符号 crc32_unsigned)。实现走仰望模块 加密解密库(本机实测头文件在册: md5_.h/.cpp、xxhash.hpp); 文件摘要会**先校验文件存在** —— 否则类库会把读不到文件退化成空字节集, 从而静默返回空文件的 MD5。说明: data 按 UTF-8 取字节; 输出默认小写, uppercase:true 切大写", 多属性Schema文本 (属性项JSON ("action", "text", "md5(文本摘要) / md5_file(文件摘要, 支持大文件) / xxhash(XXH128) / crc32") + "," + 属性项JSON ("data", "text", "要摘要的文本(md5/xxhash/crc32 用)") + "," + 属性项JSON ("path", "text", "文件完整路径(md5_file 用)") + "," + 属性项JSON ("uppercase", "boolean", "true=摘要用大写输出(默认 false 小写)"), "\"action\""))
