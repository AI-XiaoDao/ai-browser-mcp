        result = ""
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT result_json FROM async_results WHERE task_id=?", )
        记录集.置文本参数数据 (1, 命令ID)
        如果 (记录集.执行语句 () == 100)
        {
            result = 记录集.读文本数据 (0)
