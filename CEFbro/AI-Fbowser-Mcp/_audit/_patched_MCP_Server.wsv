    # ======== Console日志收集 ==========

    方法 记录控制台消息 <公开 静态 @输出名 = "RecordConsoleMessage" @强制输出 = 真>
    参数 日志级别 <类型 = 整数 @输出名 = "LogLevel">
    参数 消息 <类型 = 文本型 @输出名 = "Message">
    参数 来源URL <类型 = 文本型 @输出名 = "SourceURL">
    参数 行号 <类型 = 整数 @输出名 = "LineNo">
    {
        变量 级别文本 <类型 = 文本型>
        如果 (日志级别 == 日志级别.调试)
        {
            级别文本 = "debug"
        }
        否则 (日志级别 == 日志级别.信息)
        {
            级别文本 = "info"
        }
        否则 (日志级别 == 日志级别.警告)
        {
            级别文本 = "warn"
        }
        否则 (日志级别 == 日志级别.错误)
        {
            级别文本 = "error"
        }
        否则
        {
            级别文本 = "log"
        }
        // 用yyjson构建, 存入SQLite事件日志
        变量 日志项 <类型 = YYJSON对象类>
        日志项.创建自文本 ("{}")
        日志项.加入文本成员 ("type", "console")
        日志项.加入文本成员 ("level", 级别文本)
        日志项.加入文本成员 ("msg", 消息)
        日志项.加入文本成员 ("src", 来源URL)
        日志项.加入整数成员 ("line", 行号)
        记录事件日志 ("console", "", 0, 日志项.到可读文本 (YYJSON格式化选项.压缩))
    }

    # ======== JS代码解码 ==========

    方法 解码JS代码 <公开 静态 类型 = 文本型 @输出名 = "DecodeJSCode" @强制输出 = 真>
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 code <类型 = 文本型>
        code = yyjson取文本 (参数JSON, "code")
        如果 (code != "")
        {
            返回 (code)
        }
        // code_base64: Base64编码传参, 零转义风险 (官方FBrowser_Parser_Base64解码)
        code = yyjson取文本 (参数JSON, "code_base64")
        如果 (code != "")
        {
            变量 base64字节 <类型 = 类_FBrowser_字节集>
            base64字节 = FBrowser_Parser_Base64解码 (code)
            如果 (base64字节.是否为空 () == 假)
            {
                返回 (base64字节.取文本 ())
            }
        }
        code = yyjson取文本 (参数JSON, "file")
        如果 (code != "" && 验证安全路径 (code, 真))
        {
            // 仅允许加载运行目录内的JS文件, 防止通过 file 参数读取任意系统文件
            变量 文件字节 <类型 = 字节集类>
            文件字节 = 读入文件 (code)
            如果 (取字节集长度 (文件字节) > 0)
            {
                返回 (UTF8到文本 (文件字节))
            }
        }
        返回 ("")
    }

    # ======== URL规范化 ==========

    方法 是否以 <公开 静态 类型 = 逻辑型 @输出名 = "IsBy" @强制输出 = 真>
    参数 源文本 <类型 = 文本型 @输出名 = "SourceText">
    参数 前缀 <类型 = 文本型 @输出名 = "Prefix">
    {
        变量 前缀长度 <类型 = 整数>
        前缀长度 = 取文本长度 (前缀)
        如果 (取文本长度 (源文本) < 前缀长度)
        {
            返回 (假)
        }
        返回 (取文本左边 (源文本, 前缀长度) == 前缀)
    }

    方法 取浏览器ByID <公开 静态 类型 = 类_FBrowser_浏览器 @输出名 = "GetBrowserByID" @强制输出 = 真>
    参数 browserID <类型 = 整数 @输出名 = "BrowserID">
    {
        变量 result <类型 = 类_FBrowser_浏览器>
        如果 (browserID <= 0)
        {
            返回 (result)
        }
        浏览器数组锁.加锁 ()
        变量 count <类型 = 整数>
        count = 浏览器容器.浏览器数组.取成员数 ()
        计次循环 (count)
        {
            变量 b <类型 = 类_FBrowser_浏览器>
            b = 对象数组类.取指定类型成员 (浏览器容器.浏览器数组, 取循环索引 (), 类_FBrowser_浏览器)
            如果 (b.是否为空 () == 假 && b.是否已关闭 () == 假 && b.取ID () == browserID)
            {
                result = b
                跳出循环
            }
        }
        浏览器数组锁.解锁 ()
        如果 (result.是否为空 () == 假)
        {
            返回 (result)
        }
        // 兜底: 数组里没找到时改用**类库自身**的按ID取(权威来源, 不依赖事件是否已回填数组)。
        // 为什么必须有这一步(实测): `浏览器容器.浏览器数组` 是由"浏览器创建完成"事件**异步**填充的,
        // 而新建浏览器(尤其 background:true 的后台浏览器)在创建成功后极短时间内会出现
        // "browser_list 已经列得出来, 但按 id 取不到" 的窗口期 —— 紧随 browser_create 调用的工具
        // 会误报"没有可用的浏览器", 隔约 1 秒再调又正常。这正是用户抱怨的"要试好几次才成功"。
        // `browser_close` 一直直接用类库的 通过ID取浏览器, 所以从来没受这个窗口期影响 —— 本兜底与之一致。
        返回 (FBrowser_浏览器_通过ID取浏览器 (browserID))
    }

    方法 取主浏览器 <公开 静态 类型 = 类_FBrowser_浏览器 @输出名 = "GetMainBrowser" @强制输出 = 真>
    {
        变量 result <类型 = 类_FBrowser_浏览器>
        如果 (目标浏览器ID > 0)
        {
            result = 取浏览器ByID (目标浏览器ID)
            如果 (result.是否为空 ())
            {
                控制台输出 (到文本 ("[MCP] 错误: 指定的浏览器ID=") + 到文本 (目标浏览器ID) + " 未找到或已关闭")
            }
            返回 (result)
        }
        变量 非弹窗浏览器 <类型 = 类_FBrowser_浏览器>
        变量 弹窗浏览器 <类型 = 类_FBrowser_浏览器>
        变量 最小非弹窗ID <类型 = 整数 值 = 2147483647>
        变量 最小弹窗ID <类型 = 整数 值 = 2147483647>
        浏览器数组锁.加锁 ()
        变量 count <类型 = 整数>
        count = 浏览器容器.浏览器数组.取成员数 ()
        计次循环 (count)
        {
            变量 b <类型 = 类_FBrowser_浏览器>
            b = 对象数组类.取指定类型成员 (浏览器容器.浏览器数组, 取循环索引 (), 类_FBrowser_浏览器)
            如果 (b.是否为空 () == 假 && b.是否已关闭 () == 假)
            {
                变量 bid <类型 = 整数>
                bid = b.取ID ()
                如果 (b.是否为弹窗 () == 假)
                {
                    如果 (bid < 最小非弹窗ID)
                    {
                        非弹窗浏览器 = b
                        最小非弹窗ID = bid
                    }
                }
                否则
                {
                    如果 (bid < 最小弹窗ID)
                    {
                        弹窗浏览器 = b
                        最小弹窗ID = bid
                    }
                }
            }
        }
        浏览器数组锁.解锁 ()
        如果 (非弹窗浏览器.是否为空 () == 假)
        {
            返回 (非弹窗浏览器)
        }
        如果 (弹窗浏览器.是否为空 () == 假)
        {
            返回 (弹窗浏览器)
        }
        // 回退: 数组为空但FBrowser内部可能有残留浏览器 (如旧session未清理)
        // 用 FBrowser API 直接查找, 并同步到数组
        变量 ID清单 <类型 = 类_FBrowser_列表值>
        ID清单 = FBrowser_浏览器_取ID清单 ()
        如果 (ID清单.是否为空 () == 假 && ID清单.取大小 () > 0)
        {
            变量 firstID <类型 = 整数>
            firstID = ID清单.取整数值 (0)
            变量 fb <类型 = 类_FBrowser_浏览器>
            fb = FBrowser_浏览器_通过ID取浏览器 (firstID)
            如果 (fb.是否为空 () == 假 && fb.是否已关闭 () == 假)
            {
                控制台输出 (到文本 ("[MCP] 浏览器数组为空, 从FBrowser同步: id=") + 到文本 (firstID))
                返回 (fb)
            }
        }
        返回 (弹窗浏览器)
    }

    # ======== 安全框架访问 ==========

    方法 取安全主框架 <公开 静态 类型 = 类_FBrowser_框架 @输出名 = "GetSafeMainFrame" @强制输出 = 真>
    参数 browser <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    {
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            变量 frame <类型 = 类_FBrowser_框架>
            frame = browser.取主框架 ()
            如果 (frame.是否为空 () == 假 && frame.是否有效 ())
            {
                返回 (frame)
            }
            // v2.8.1 体验优化: 框架未就绪时最多等待8秒(可中断轮询), 覆盖慢页面加载,
            // 大幅降低AI在页面加载中操作导致的"主框架无效"失败率
            变量 等待次数 <类型 = 整数 值 = 0>
            判断循环 (等待次数 < 40)
            {
                等待次数 = 等待次数 + 1
                // 修复: 本方法可能在**未持有 MCP执行锁**的路径上被调用
                // (main.wsv 主循环 500ms 节拍 → 恢复欢迎页 → 导航欢迎页内部 → 取安全主框架),
                // 原先省略第3参数走默认 真, 会对未持有的递归互斥锁执行 解锁(),
                // 破坏递归计数与所有权(作者在 MCP可中断延时 的注释中注明这是未定义行为)。
                MCP可中断延时 (200, 50, 假)
                如果 (browser.是否已关闭 () || MCP正在关闭)
                {
                    跳出循环
                }
                frame = browser.取主框架 ()
                如果 (frame.是否为空 () == 假 && frame.是否有效 ())
                {
                    返回 (frame)
                }
            }
        }
        变量 空框架 <类型 = 类_FBrowser_框架>
        返回 (空框架)
    }

    方法 取VIP控制器 <公开 静态 类型 = 类_FBrowserVIP_控制器 @输出名 = "GetVIPController" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () == 假)
        {
            如果 (browser.是否已关闭 () == 假)
            {
                返回 (browser.取VIP控制器 ())
            }
        }
        变量 空vip <类型 = 类_FBrowserVIP_控制器>
        返回 (空vip)
    }

    # ======== 架构优化: CDP逆向通用辅助 (消除重复模板) ==========

    方法 取安全主浏览器 <公开 静态 类型 = 类_FBrowser_浏览器 注释 = "取主浏览器并验证未关闭, 用于逆向工具统一入口" @输出名 = "GetSafeMainBrowser" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            返回 (browser)
        }
        变量 空browser <类型 = 类_FBrowser_浏览器>
        返回 (空browser)
    }

    方法 执行逆向CDP命令 <公开 静态 类型 = 文本型 注释 = "CDP逆向工具统一入口: 取安全浏览器→注册观察者→执行CDP→返回异步结果" @输出名 = "ExecuteReverseCDPCommand" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 cdpMethod <类型 = 文本型 @输出名 = "CDPMethod">
    参数 paramsJSON <类型 = 文本型 @输出名 = "ParamsJSON">
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取安全主浏览器 ()
        如果 (browser.是否为空 ())
        {
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        确保CDP观察者已注册 ()
        返回 (执行CDP命令_带参数 (命令ID, cdpMethod, paramsJSON))
    }

    方法 取请求环境_安全 <公开 静态 类型 = 类_FBrowser_请求环境 @输出名 = "GetRequestEnvironmentSafe" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            返回 (browser.取请求环境 ())
        }
        变量 空env <类型 = 类_FBrowser_请求环境>
        返回 (空env)
    }

    方法 取开发者DOM_安全 <公开 静态 类型 = 类_FBrowserVIP_开发者DOM @输出名 = "GetDevToolsDOMSafe" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            返回 (browser.取开发者DOM ())
        }
        变量 空dom <类型 = 类_FBrowserVIP_开发者DOM>
        返回 (空dom)
    }

    # 文本里是否还残留未还原的百分号转义(%HH) —— 用于判断类库解码器是否真的解开了。
    # 不引入正则(项目里没统一的正则封装), 用逐字符 + 十六进制字符集判断。
    方法 含百分号转义 <公开 静态 类型 = 逻辑型 @输出名 = "HasPercentEscape" @强制输出 = 真>
    参数 待查文本 <类型 = 文本型 @输出名 = "Text">
    {
        变量 位置 <类型 = 整数>
        位置 = 0
        判断循环 (位置 + 2 < 取文本长度 (待查文本))
        {
            如果 (取文本中间 (待查文本, 位置, 1) == "%")
            {
                变量 高半字节 <类型 = 文本型>
                变量 低半字节 <类型 = 文本型>
                高半字节 = 取文本中间 (待查文本, 位置 + 1, 1)
                低半字节 = 取文本中间 (待查文本, 位置 + 2, 1)
                如果 (寻找文本 ("0123456789abcdefABCDEF", 高半字节, 0, 假) != -1 && 寻找文本 ("0123456789abcdefABCDEF", 低半字节, 0, 假) != -1)
                {
                    返回 (真)
                }
            }
            位置 = 位置 + 1
        }
        返回 (假)
    }

    # 菜单规格"修改类"类型的**唯一判定源**: 参数校验侧(Core)与施加侧(本类)共用, 避免两份列表漂移。
    方法 是菜单修改类 <公开 静态 类型 = 逻辑型 @输出名 = "IsMenuModifyType" @强制输出 = 真>
    参数 类型名 <类型 = 文本型 @输出名 = "TypeName">
    {
        返回 (类型名 == "del" || 类型名 == "relabel" || 类型名 == "vis" || 类型名 == "dis" || 类型名 == "mark" || 类型名 == "accel" || 类型名 == "noaccel")
    }

    # 统一生成"施加失败"的可读原因(只此一处文案)
    方法 菜单失败说明 <公开 静态 类型 = 文本型 @输出名 = "MenuFailReason" @强制输出 = 真>
    参数 类型名 <类型 = 文本型 @输出名 = "TypeName">
    参数 命令ID <类型 = 整数 @输出名 = "CommandId">
    {
        如果 (命令ID < 26500)
        {
            返回 ("[" + 类型名 + " " + 到文本 (命令ID) + " 未生效: 该ID是浏览器默认菜单项, 实测本应用不支持修改默认项] ")
        }
        返回 ("[" + 类型名 + " " + 到文本 (命令ID) + " 未生效: 条目不存在或类型不匹配] ")
    }

    # 把命令ID 列解析成整数: 支持 CEF **标准菜单项别名**(默认菜单项无法按索引反查, 只能靠标准ID定位)。
    # 数值取自本机 CEF 头 cef_types.h 的 cef_menu_id_t, 不是凭记忆写的。

    方法 解析菜单命令ID <公开 静态 类型 = 整数 @输出名 = "ParseMenuCommandID" @强制输出 = 真>
    参数 原始值 <类型 = 文本型 @输出名 = "RawValue">
    {
        变量 键 <类型 = 文本型>
        键 = 删首尾空 (原始值)
        如果 (键 == "")
        {
            返回 (0)
        }
        // 纯数字直接返回(自建项 26500..28500 / 默认项标准ID)
        变量 首位 <类型 = 文本型>
        首位 = 取文本左边 (键, 1)
        如果 (寻找文本 ("0123456789", 首位, 0, 假) != -1)
        {
            返回 (文本到整数 (键))
        }
        如果 (键 == "back")
        {
            返回 (100)
        }
        如果 (键 == "forward")
        {
            返回 (101)
        }
        如果 (键 == "reload")
        {
            返回 (102)
        }
        如果 (键 == "reload_nocache")
        {
            返回 (103)
        }
        如果 (键 == "stop")
        {
            返回 (104)
        }
        如果 (键 == "undo")
        {
            返回 (110)
        }
        如果 (键 == "redo")
        {
            返回 (111)
        }
        如果 (键 == "cut")
        {
            返回 (112)
        }
        如果 (键 == "copy")
        {
            返回 (113)
        }
        如果 (键 == "paste")
        {
            返回 (114)
        }
        如果 (键 == "delete")
        {
            返回 (115)
        }
        如果 (键 == "selectall")
        {
            返回 (116)
        }
        如果 (键 == "find")
        {
            返回 (130)
        }
        如果 (键 == "print")
        {
            返回 (131)
        }
        如果 (键 == "viewsource")
        {
            返回 (132)
        }
        如果 (键 == "nosuggestions")
        {
            返回 (205)
        }
        如果 (键 == "addtodict")
        {
            返回 (206)
        }
        返回 (0)
    }

    # 把"右键上下文"(类_FBrowser_菜单环境)取成紧凑 JSON —— **只在 CEF 回调内调用**。
    # 该对象与 菜单模式 同受 CEF 生命周期约束(禁止在回调之外持有), 故这里只**取值成文本**, 不保存对象。

    方法 构建菜单环境摘要 <公开 静态 类型 = 文本型 @输出名 = "BuildMenuEnvSummary" @强制输出 = 真>
    参数 菜单环境 <类型 = 类_FBrowser_菜单环境 @输出名 = "MenuParams">
    {
        变量 菜单摘要 <类型 = YYJSON对象类>
        菜单摘要.创建自文本 ("{}")
        如果 (菜单环境.是否为空 ())
        {
            菜单摘要.加入逻辑值成员 ("available", 假)
            返回 (菜单摘要.到可读文本 (YYJSON格式化选项.压缩))
        }
        菜单摘要.加入逻辑值成员 ("available", 真)
        菜单摘要.加入整数成员 ("x", 菜单环境.取横向位置 ())
        菜单摘要.加入整数成员 ("y", 菜单环境.取纵向位置 ())
        菜单摘要.加入整数成员 ("type_flags", 菜单环境.取类型 ())
        菜单摘要.加入文本成员 ("link", 菜单环境.取地址 ())
        菜单摘要.加入文本成员 ("link_unfiltered", 菜单环境.取完整地址 ())
        菜单摘要.加入文本成员 ("source_url", 菜单环境.取源地址 ())
        菜单摘要.加入文本成员 ("page_url", 菜单环境.取页地址 ())
        菜单摘要.加入文本成员 ("frame_url", 菜单环境.取框架页地址 ())
        菜单摘要.加入文本成员 ("frame_charset", 菜单环境.取框架网页编码 ())
        // 注: 类库 是否存在图片() 在本机**编译不过**(FBroLib.v:1895 引用了不存在的原生函数
        // FBroHSContextMenuParams_HasImageContents), 故不调用; 图片/媒体信息由下面两个 getter 覆盖。
        菜单摘要.加入整数成员 ("media_type", 菜单环境.取媒体类型 ())
        菜单摘要.加入整数成员 ("media_type_flags", 菜单环境.取媒体类型标识 ())
        菜单摘要.加入文本成员 ("selection_text", 菜单环境.取选择文本 ())
        菜单摘要.加入文本成员 ("misspelled_word", 菜单环境.取错误单词 ())
        菜单摘要.加入逻辑值成员 ("editable", 菜单环境.是否为编辑框 ())
        菜单摘要.加入逻辑值成员 ("spellcheck_enabled", 菜单环境.是否为选择框 ())
        菜单摘要.加入整数成员 ("edit_state_flags", 菜单环境.取编辑框类型标识 ())
        菜单摘要.加入逻辑值成员 ("is_custom_menu", 菜单环境.是否为Custom菜单 ())
        返回 (菜单摘要.到可读文本 (YYJSON格式化选项.压缩))
    }

    # 把暂存的菜单规格施加到**当前这次右键**的菜单模型上(只在 CEF 回调内调用)。
    # 返回成功施加的条目数; 规格为空或未启用时**什么都不做并返回 0**
    #   —— 绝不能在规格为空时清空菜单: CEF 默认菜单会被清掉, 右键菜单直接消失。
    # 子项挂载: 父命令ID 非 0 的行挂到"其上方最近创建的 sub 行", 故规格须把子项紧跟其 sub 行。

    方法 应用菜单规格 <公开 静态 类型 = 整数 @输出名 = "ApplyMenuSpec" @强制输出 = 真>
    参数 顶层菜单 <类型 = 类_FBrowser_菜单模式 @输出名 = "TopMenuModel">
    {
        如果 (菜单已启用 == 假 || 菜单规格文本 == "" || 顶层菜单.是否为空 ())
        {
            返回 (0)
        }
        变量 施加条数 <类型 = 整数>
        施加条数 = 0
        变量 回读条数 <类型 = 整数>
        回读条数 = 0
        菜单回读不一致 = ""
        菜单施加失败 = ""
        变量 失败条数 <类型 = 整数>
        失败条数 = 0
        变量 失败明细 <类型 = 文本型>
        失败明细 = ""
        变量 最近子菜单 <类型 = 类_FBrowser_菜单模式>
        变量 行数组 <类型 = 文本数组类>
        分割文本 (菜单规格文本, "\n", 行数组, 真, 假)
        计次循环 (行数组.取成员数 ())
        {
            变量 行文本 <类型 = 文本型>
            行文本 = 行数组.取成员 (取循环索引 ())
            如果 (行文本 == "")
            {
                到循环尾
            }
            变量 段数组 <类型 = 文本数组类>
            分割文本 (行文本, "|", 段数组, 假, 假)
            如果 (段数组.取成员数 () < 3)
            {
                到循环尾
            }
            变量 条目类型 <类型 = 文本型>
            条目类型 = 段数组.取成员 (0)
            变量 条目标签 <类型 = 文本型>
            条目标签 = 规则字段反转义 (段数组.取成员 (1))
            变量 条目命令ID <类型 = 整数>
            条目命令ID = 文本到整数 (段数组.取成员 (2))
            变量 条目参数 <类型 = 整数>
            条目参数 = 1
            如果 (段数组.取成员数 () >= 4 && 段数组.取成员 (3) != "")
            {
                条目参数 = 文本到整数 (段数组.取成员 (3))
            }
            变量 条目父ID <类型 = 整数>
            条目父ID = 0
            如果 (段数组.取成员数 () >= 5 && 段数组.取成员 (4) != "")
            {
                条目父ID = 文本到整数 (段数组.取成员 (4))
            }
            // 创建类 vs 修改类: 前者是"新条目"故 ID 必须落在 CEF 自定义区间;
            // 后者作用于**已存在**的条目(含浏览器默认菜单项, 其 ID 是 CEF 标准ID), 故允许标准区间。
            变量 条目是修改类 <类型 = 逻辑型>
            条目是修改类 = MCP命令服务器.是菜单修改类 (条目类型)
            如果 (条目是修改类)
            {
                如果 (条目命令ID < 1)
                {
                    菜单上次错误 = "修改类条目需要已存在的命令ID: " + 行文本
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + "[跳过 " + 条目类型 + ": 命令ID 解析为 " + 到文本 (条目命令ID) + " | 列位: 类型|标签|命令ID|参数|父命令ID|快捷键] "
                    到循环尾
                }
            }
            否则
            {
                如果 (条目类型 != "sep" && (条目命令ID < 26500 || 条目命令ID > 28500))
                {
                    菜单上次错误 = "跳过命令ID越界的条目(须在26500..28500): " + 行文本
                    到循环尾
                }
            }
            变量 目标模型 <类型 = 类_FBrowser_菜单模式>
            目标模型 = 顶层菜单
            如果 (条目父ID != 0)
            {
                目标模型 = 最近子菜单
            }
            如果 (目标模型.是否为空 ())
            {
                菜单上次错误 = "父菜单不存在, 跳过: " + 行文本 + " | 第5列是父命令ID(想要顶层项该列为 0 或留空); 列位: 类型|标签|命令ID|参数|父命令ID|快捷键"
                失败条数 = 失败条数 + 1
                失败明细 = 失败明细 + "[跳过 " + 条目类型 + " " + 到文本 (条目命令ID) + ": 第5列父命令ID=" + 到文本 (条目父ID) + " 指向上方不存在的 sub 行"
                如果 (条目父ID < 26500)
                {
                    失败明细 = 失败明细 + "(该列像是不小心填了别的值: 列位 类型|标签|命令ID|参数|父命令ID|快捷键)"
                }
                失败明细 = 失败明细 + "] "
                到循环尾
            }
            // ── 修改已存在条目(可作用于浏览器默认菜单项) ──
            否则 (条目类型 == "del")
            {
                如果 (目标模型.删除菜单 (条目命令ID))
                {
                    施加条数 = 施加条数 + 1
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                }
            }
            否则 (条目类型 == "relabel")
            {
                如果 (目标模型.置菜单标签 (条目命令ID, 条目标签))
                {
                    施加条数 = 施加条数 + 1
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                }
            }
            否则 (条目类型 == "vis")
            {
                如果 (目标模型.置可见状态 (条目命令ID, 条目参数 == 1))
                {
                    施加条数 = 施加条数 + 1
                    // 回读验证: 期望状态已知, 立刻用只读 getter 核对(不只听类库返回值)
                    如果 (目标模型.是否可见 (条目命令ID) == (条目参数 == 1))
                    {
                        回读条数 = 回读条数 + 1
                    }
                    否则
                    {
                        菜单回读不一致 = 菜单回读不一致 + "[vis " + 到文本 (条目命令ID) + " 期望" + 选择 (条目参数 == 1, "可见", "隐藏") + " 实际相反] "
                    }
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                }
            }
            否则 (条目类型 == "dis")
            {
                如果 (目标模型.置禁止状态 (条目命令ID, 条目参数 == 1))
                {
                    施加条数 = 施加条数 + 1
                    // 方向校正: 类库只读 getter "是否禁止" 的名字与语义**相反** —— 实测置禁止(真) 后菜单项
                    // 确实变灰, 而它读回假, 说明它返回的是 CEF 的 IsEnabled(是否可用)。故"期望禁用"比对 假。
                    如果 (目标模型.是否禁止 (条目命令ID) == (条目参数 == 0))
                    {
                        回读条数 = 回读条数 + 1
                    }
                    否则
                    {
                        菜单回读不一致 = 菜单回读不一致 + "[dis " + 到文本 (条目命令ID) + " 期望" + 选择 (条目参数 == 1, "禁用", "启用") + " 实际相反] "
                    }
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                }
            }
            否则 (条目类型 == "mark")
            {
                如果 (目标模型.选中状态 (条目命令ID, 条目参数 == 1))
                {
                    施加条数 = 施加条数 + 1
                    如果 (目标模型.是否选中 (条目命令ID) == (条目参数 == 1))
                    {
                        回读条数 = 回读条数 + 1
                    }
                    否则
                    {
                        菜单回读不一致 = 菜单回读不一致 + "[mark " + 到文本 (条目命令ID) + " 期望" + 选择 (条目参数 == 1, "选中", "取消") + " 实际相反: mark 只对 check/radio 类条目有效, 普通 item 类不支持选中] "
                    }
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                }
            }
            否则 (条目类型 == "accel")
            {
                // 实际设置在下面公共块完成(与创建类共用同一段快捷键解析), 这里只校验必须有第 6 列
                如果 (段数组.取成员数 () < 6 || 段数组.取成员 (5) == "")
                {
                    菜单上次错误 = "accel 需要第 6 列快捷键(如 70C): " + 行文本
                    到循环尾
                }
                // 计数改到下面公共块: 只有"设置后 存在快捷键() 读回为真"才算成功
            }
            否则 (条目类型 == "noaccel")
            {
                如果 (目标模型.存在快捷键 (条目命令ID))
                {
                    // 类库返回值不足以证明生效: 移除后还要用 存在快捷键() 读回确认
                    如果 (目标模型.移除快捷键 (条目命令ID) && 目标模型.存在快捷键 (条目命令ID) == 假)
                    {
                        施加条数 = 施加条数 + 1
                    }
                    否则
                    {
                        失败条数 = 失败条数 + 1
                        失败明细 = 失败明细 + 菜单失败说明 (条目类型, 条目命令ID)
                    }
                }
                否则
                {
                    // 本来就没有快捷键 -> 目标状态已满足, 计为已施加(幂等, 不算失败)
                    施加条数 = 施加条数 + 1
                }
            }
            // ── 创建新条目 ──
            否则 (条目类型 == "sep")
            {
                如果 (目标模型.添加分隔栏 ())
                {
                    施加条数 = 施加条数 + 1
                }
            }
            否则 (条目类型 == "sub")
            {
                变量 子模型 <类型 = 类_FBrowser_菜单模式>
                子模型 = 目标模型.添加子菜单 (条目命令ID, 条目标签)
                如果 (子模型.是否为空 () == 假)
                {
                    施加条数 = 施加条数 + 1
                    最近子菜单 = 子模型
                    如果 (条目参数 == 0)
                    {
                        目标模型.置禁止状态 (条目命令ID, 真)
                    }
                }
            }
            否则 (条目类型 == "check")
            {
                如果 (目标模型.添加Check菜单 (条目命令ID, 条目标签))
                {
                    施加条数 = 施加条数 + 1
                    如果 (条目参数 == 1)
                    {
                        目标模型.选中状态 (条目命令ID, 真)
                    }
                }
            }
            否则 (条目类型 == "radio")
            {
                变量 单选项群ID <类型 = 整数>
                单选项群ID = 条目参数
                如果 (单选项群ID <= 0)
                {
                    单选项群ID = 1
                }
                如果 (目标模型.添加Radio菜单 (条目命令ID, 条目标签, 单选项群ID))
                {
                    施加条数 = 施加条数 + 1
                }
            }
            否则
            {
                如果 (目标模型.添加菜单 (条目命令ID, 条目标签))
                {
                    施加条数 = 施加条数 + 1
                    如果 (条目参数 == 0)
                    {
                        目标模型.置禁止状态 (条目命令ID, 真)
                    }
                }
                否则
                {
                    失败条数 = 失败条数 + 1
                    失败明细 = 失败明细 + "[item " + 到文本 (条目命令ID) + " 创建失败: 命令ID 可能已被占用] "
                }
            }
            // 快捷键(可选, 仅用于显示): 键码 + 修饰词 C/S/A, 例 "70C"
            如果 (段数组.取成员数 () >= 6 && 段数组.取成员 (5) != "" && 条目类型 != "sep" && 条目类型 != "noaccel")
            {
                变量 快捷键原文 <类型 = 文本型>
                快捷键原文 = 段数组.取成员 (5)
                变量 键码文本 <类型 = 文本型>
                键码文本 = ""
                变量 修饰位 <类型 = 整数>
                修饰位 = 1
                判断循环 (修饰位 <= 取文本长度 (快捷键原文))
                {
                    变量 当前字符 <类型 = 文本型>
                    当前字符 = 取文本中间 (快捷键原文, 修饰位 - 1, 1)
                    如果 (寻找文本 ("0123456789", 当前字符, 0, 假) != -1)
                    {
                        键码文本 = 键码文本 + 当前字符
                    }
                    修饰位 = 修饰位 + 1
                }
                如果 (键码文本 != "")
                {
                    变量 是否Ctrl <类型 = 逻辑型>
                    是否Ctrl = 寻找文本 (快捷键原文, "C", 0, 假) != -1
                    变量 是否Shift <类型 = 逻辑型>
                    是否Shift = 寻找文本 (快捷键原文, "S", 0, 假) != -1
                    变量 是否Alt <类型 = 逻辑型>
                    是否Alt = 寻找文本 (快捷键原文, "A", 0, 假) != -1
                    如果 (目标模型.设置快捷键 (条目命令ID, 文本到整数 (键码文本), 是否Shift, 是否Ctrl, 是否Alt) && 目标模型.存在快捷键 (条目命令ID))
                    {
                        // 读回确认通过才计数(默认项上 设置快捷键 会返回真却实际不留痕)
                        如果 (条目类型 == "accel")
                        {
                            施加条数 = 施加条数 + 1
                        }
                    }
                    否则
                    {
                        失败条数 = 失败条数 + 1
                        失败明细 = 失败明细 + 菜单失败说明 ("accel", 条目命令ID)
                    }
                }
            }
        }
        // 真实菜单项数(含浏览器默认项): 这是第一次能"看见"菜单全貌
        菜单最近项数 = 顶层菜单.取数量 ()
        菜单回读确认条数 = 回读条数
        菜单施加失败 = 失败明细
        菜单最近施加条数 = 施加条数
        菜单施加次数 = 菜单施加次数 + 1
        菜单上次施加时刻 = 到文本 (取启动时间 ())
        返回 (施加条数)
    }

    # ======== 命令预查找 (字典O(1), 找不到直接返回) ==========

    方法 查找命令ID <公开 静态 类型 = 整数 @输出名 = "FindCommandID" @强制输出 = 真>
    参数 命令名 <类型 = 文本型 @输出名 = "CommandName">
    {
        如果 (命令注册表.是否为空对象 () == 假 && 命令注册表.是否为空 () == 假)
        {
            返回 (命令注册表.取整数值 (命令名))
        }
        返回 (0)
    }

    # ======== URL 安全验证 (防协议注入) ==========

    方法 验证URL安全 <公开 静态 类型 = 逻辑型 @输出名 = "ValidateURLSafe" @强制输出 = 真>
    参数 输入URL <类型 = 文本型 @输出名 = "InputURL">
    {
        如果 (输入URL == "")
        {
            返回 (假)
        }
        // 1. 删首尾空白 + 删除URL中的全部<0x20控制字符, 防止 scheme 内部空白绕过
        //    (如 "java\tscript:alert(1)" → tab在scheme中, 绕过 javascript: 检测; \v\f同理)
        变量 纯净URL <类型 = 文本型>
        纯净URL = 删首尾空 (输入URL)
        子文本替换 (纯净URL, "\t", "", , , 真)
        子文本替换 (纯净URL, "\r", "", , , 真)
        子文本替换 (纯净URL, "\n", "", , , 真)
        子文本替换 (纯净URL, "\v", "", , , 真)
        子文本替换 (纯净URL, "\f", "", , , 真)
        // 2. 去除null字节, 防止C字符串截断绕过 (如 "java\0script:")
        子文本替换 (纯净URL, "\0", "", , , 假)
        // 3. 提取 scheme 部分并 URL 解码, 防止编码绕过 (如 java%0ascript: → javascript:)
        变量 schemeEnd <类型 = 整数>
        schemeEnd = 寻找文本 (纯净URL, ":", 0, 假)
        如果 (schemeEnd > 0)
        {
            变量 rawScheme <类型 = 文本型>
            // 寻找文本/SearchText 为0-based索引: ":"在0-based schemeEnd, scheme字符数=schemeEnd
            rawScheme = 取文本左边 (纯净URL, schemeEnd)
            变量 decodedScheme <类型 = 文本型>
            decodedScheme = FBrowser_Parser_URI解码 (rawScheme, 真, 真)
            变量 decodedSchemeLower <类型 = 文本型>
            decodedSchemeLower = 到小写 (decodedScheme)
            如果 (decodedSchemeLower == "javascript" || decodedSchemeLower == "vbscript")
            {
                返回 (假)
            }
        }
        // 4. 转小写用于协议比较 (协议名大小写不敏感, RFC 3986)
        变量 小写检查 <类型 = 文本型>
        小写检查 = 到小写 (纯净URL)
        // 5. 拒绝危险的URL协议: javascript:, file:, data:(仅放行 image/png|jpeg|gif|webp|bmp|x-icon)
        // 注: 寻找文本(,,假)=区分大小写, 故搜索串必须小写以匹配已小写的URL
        如果 (寻找文本 (小写检查, "javascript:", 0, 假) == 0)
        {
            返回 (假)
        }
        // file: 协议一律拒绝 (无论是否带://, 如 file:C:/... 与 file:///C:/... 均拦截)
        如果 (寻找文本 (小写检查, "file:", 0, 假) == 0)
        {
            返回 (假)
        }
        // data: 仅允许安全的 image MIME (png/jpeg/gif/webp/bmp/ico),
        // 拒绝 svg+xml, text/html, application/javascript 等可执行/可注入类型
        如果 (寻找文本 (小写检查, "data:", 0, 假) == 0)
        {
            // 白名单: 仅允许 image/png, image/jpeg, image/gif, image/webp, image/bmp, image/x-icon
            如果 (寻找文本 (小写检查, "image/png", 0, 假) > 0)
            {
                // 允许
            }
            否则 (寻找文本 (小写检查, "image/jpeg", 0, 假) > 0)
            {
                // 允许
            }
            否则 (寻找文本 (小写检查, "image/gif", 0, 假) > 0)
            {
                // 允许
            }
            否则 (寻找文本 (小写检查, "image/webp", 0, 假) > 0)
            {
                // 允许
            }
            否则 (寻找文本 (小写检查, "image/bmp", 0, 假) > 0)
            {
                // 允许
            }
            否则 (寻找文本 (小写检查, "image/x-icon", 0, 假) > 0)
            {
                // 允许
            }
            否则
            {
                // data: URI 但 MIME 不在白名单内, 拒绝 (防止 text/html XSS / script 注入)
                返回 (假)
            }
        }
        返回 (真)
    }

    # 按字节安全截断: 防截断点落在多字节UTF-8字符中间产生U+FFFD替换字符

    方法 字节安全截断 <公开 静态 类型 = 文本型 @输出名 = "ByteSafeTruncate" @强制输出 = 真>
    参数 原文 <类型 = 文本型 @输出名 = "RawText">
    参数 最大字节 <类型 = 整数 @输出名 = "MaxByte">
    {
        变量 源字节 <类型 = 字节集类>
        源字节 = 文本到UTF8 (原文, 假)
        如果 (取字节集长度 (源字节) <= 最大字节)
        {
            返回 (原文)
        }
        变量 截断文本 <类型 = 文本型>
        截断文本 = UTF8到文本 (指针到字节集 (取字节集指针 (源字节), 最大字节))
        // 若截断切在多字节字符中间, UTF8解码会产生尾部U+FFFD(一个不完整序列至多产生一个), 移除之
        如果 (取文本右边 (截断文本, 1) == "�")
        {
            截断文本 = 取文本左边 (截断文本, 取文本长度 (截断文本) - 1)
        }
        返回 (截断文本)
    }

    # 崩溃计数原子操作: 渲染意外终止(UI线程)与 执行定期维护(MCP/主线程)跨线程读写, 统一走原子接口

    方法 原子递增崩溃计数 <公开 静态 类型 = 整数 @输出名 = "AtomicIncrementCrashCount" @强制输出 = 真>
    {
        变量 新值 <类型 = 整数>
        @ @<新值> = (INT)InterlockedIncrement((LONG volatile*)&@<近期崩溃次数>);
        返回 (新值)
    }

    方法 原子清零崩溃计数 <公开 静态 @输出名 = "AtomicZeroCrashCount" @强制输出 = 真>
    {
        @ InterlockedExchange((LONG volatile*)&@<近期崩溃次数>, 0);
    }

    方法 原子置首次崩溃时间 <公开 静态 类型 = 长整数 @输出名 = "AtomicSetFirstCrashTime" @强制输出 = 真>
    参数 时间值 <类型 = 长整数 @输出名 = "TimeValue">
    {
        变量 旧值 <类型 = 长整数>
        @ @<旧值> = (LONGLONG)InterlockedExchange64((LONGLONG volatile*)&@<首次崩溃时间>, @<时间值>);
        返回 (旧值)
    }

    方法 验证安全路径 <公开 静态 类型 = 逻辑型 @输出名 = "ValidateSafePath" @强制输出 = 真>
    参数 路径 <类型 = 文本型 @输出名 = "Path">
    参数 仅允许运行目录内 <类型 = 逻辑型 注释 = "写操作应设真, 限制在取运行目录()子树内" @默认值 = 假 @输出名 = "OnlyAllowRunDirInner">
    {
        // 防止路径遍历攻击: 拒绝 ../ || ..\\ 模式 (允许 .. 嵌入合法文件名如 foo..bar.txt)
        如果 (寻找文本 (路径, "../", 0, 假) != -1 || 寻找文本 (路径, "..\\", 0, 假) != -1)
        {
            控制台输出 (到文本 ("[MCP] 安全拒绝(路径遍历):") + 到文本 (路径))
            返回 (假)
        }
        // 写操作: 仅允许 取运行目录() 子树内的路径, 防止污染系统目录
        如果 (仅允许运行目录内)
        {
            // 修复: 前缀补尾分隔符, 防 "C:\app2" 之类兄弟目录前缀误配逃出运行目录子树
            变量 运行根 <类型 = 文本型>
            运行根 = 取运行目录 ()
            如果 (取文本右边 (运行根, 1) != "\\")
            {
                运行根 = 运行根 + "\\"
            }
            如果 (是否以 (路径, 运行根) == 假)
            {
                控制台输出 (到文本 ("[MCP] 安全拒绝(路径越界):") + 到文本 (路径) + " 根目录:" + 到文本 (运行根))
                返回 (假)
            }
        }
        // 读操作: 允许任意绝对/相对路径 (本地工具特性)
        返回 (真)
    }

    方法 启动MCP服务器 <公开 静态 @输出名 = "StartMCPServer" @强制输出 = 真>
    {
        如果 (MCP正在关闭)
        {
            返回
        }
        加载MCP配置 ()
        如果真 (是否启用 == 假)
        {
            返回
        }
        // === 清理残留浏览器 (旧session/崩溃后留下的CEF实例) ===
        变量 清理尝试 <类型 = 整数 值 = 0>
        判断循环 (FBrowser_浏览器_取数量 () > 0 && 清理尝试 < 50)
        {
            清理尝试 = 清理尝试 + 1
            变量 残留ID清单 <类型 = 类_FBrowser_列表值>
            残留ID清单 = FBrowser_浏览器_取ID清单 ()
            如果 (残留ID清单.是否为空 () == 假 && 残留ID清单.取大小 () > 0)
            {
                变量 cid <类型 = 整数>
                cid = 残留ID清单.取整数值 (0)
                变量 cb <类型 = 类_FBrowser_浏览器>
                cb = FBrowser_浏览器_通过ID取浏览器 (cid)
                如果 (cb.是否为空 () == 假 && cb.是否已关闭 () == 假)
                {
                    控制台输出 (到文本 ("[MCP] 清理残留浏览器: id=") + 到文本 (cid))
                    cb.关闭浏览器 ()
                }
                // 不因空/已关闭而跳出 — 继续清理, 最多50次防死循环
            }
            否则
            {
                跳出循环
            }
        }
        // === 初始化 SQLite 缓存数据库 ===
        打开缓存数据库 ()
        变量 服务器事件 <类型 = 类_FBrowser_事件智能指针>
        服务器事件.创建 (类_MCP_服务器事件)
        // 修复(回绕): 墙钟基准(与 /health uptime_ms 差值一致), 防 取启动时间 32位回绕后 uptime 为负
        服务器启动时间戳 = 取现行时间毫秒 ()
        服务器启动墙钟毫秒 = 取现行时间毫秒 ()
        请求计数器 = 0
        // 修复(HTTP不启动): 原实现在 --mcp-stdio/--stdio/--headless 下完全跳过
        // FBrowser_服务器_创建, 却照样输出"服务器已启动"+HTTP地址、照样写 mcp_connect.json、
        // 照样导出 AI_BROWSER_MCP_* 环境变量 → Claude/Cursor 拿到一串连不上的 HTTP 地址。
        // 且 FBrowser_服务器_创建 返回 void(内部丢弃 FBroHsServer_CreateServer 结果),
        // 调用处根本无法判断成败, 所以原实现只能"一刀切跳过"。
        // 现方案: 默认总是尝试创建(端口空闲即成功), 成败由 服务器即将创建 事件里的
        // 服务器.是否为空() 可靠回填(CEF 仅在绑定成功时才传入有效服务器对象)。
        如果 (是否禁用HTTP服务 ())
        {
            浏览器容器.HTTP服务已尝试 = 假
            浏览器容器.HTTP服务可用 = 假
            控制台输出 ("[MCP] AI_BROWSER_MCP_NO_HTTP 已设置 — 按配置跳过 HTTP/WebSocket 端口监听")
        }
        否则
        {
            浏览器容器.HTTP服务已尝试 = 真
            FBrowser_服务器_创建 (服务器绑定地址, 服务器端口, 100, 服务器事件)
        }
        浏览器容器.MCP服务已就绪 = 真
        如果 (浏览器容器.HTTP服务已尝试)
        {
            控制台输出 ("[MCP] AI浏览器 MCP 服务器已启动, 目标地址 " + 取MCP_WS地址 () + " (绑定结果见下一行)")
        }
        否则
        {
            控制台输出 ("[MCP] AI浏览器 MCP 服务器已启动 (仅 stdio 通道, 未监听端口)")
        }
        变量 连接信息对象 <类型 = YYJSON对象类>
        连接信息对象.创建自文本 ("{}")
        连接信息对象.加入文本成员 ("mcp_url", 取MCP_WS地址 ())
        连接信息对象.加入文本成员 ("http_service_attempted", 选择 (浏览器容器.HTTP服务已尝试, "true", "false"))
        连接信息对象.加入文本成员 ("http_service_note", "HTTP 绑定结果异步回填, 以控制台 '[MCP] HTTP 服务...' 行与 /health 为准; 设置 AI_BROWSER_MCP_NO_HTTP=1 可完全关闭端口监听")
        连接信息对象.加入文本成员 ("stdio_mode", 选择 (MCPStdio桥.是否为Stdio模式 (), "true", "false"))
        连接信息对象.加入文本成员 ("mcp_http_post", 取MCP_HTTP地址 () + "/mcp")
        连接信息对象.加入文本成员 ("mcp_http_post_alt", 取MCP_HTTP地址 () + "/")
        连接信息对象.加入文本成员 ("api_info_url", 取MCP_HTTP地址 () + "/api")
        连接信息对象.加入文本成员 ("bind_address", 服务器绑定地址)
        连接信息对象.加入整数成员 ("port", 服务器端口)
        连接信息对象.加入文本成员 ("health_url", 取MCP_HTTP地址 () + "/health")
        连接信息对象.加入文本成员 ("tools_url", 取MCP_HTTP地址 () + "/tools/list")
        连接信息对象.加入文本成员 ("json_list_url", 取MCP_HTTP地址 () + "/json/list")
        连接信息对象.加入文本成员 ("cdp_note", "CDP 请使用 MCP 工具 browser_cdp_call, 非 /devtools WebSocket 代理")
        连接信息对象.加入文本成员 ("bridge_script", "mcp_bridge.js")
        连接信息对象.加入文本成员 ("check_command", "node mcp_bridge.js --check")
        连接信息对象.加入文本成员 ("usage_step1", "启动 AI-Fbowser-Mcp.exe (保持运行请最小化控制台窗口, 关闭浏览器窗口将退出程序)")
        连接信息对象.加入文本成员 ("usage_step2", "Cursor: mcp.json 配置 node + mcp_bridge.js 路径")
        连接信息对象.加入文本成员 ("usage_step3", "调用 tools/call 或 browser_* 命令操作浏览器")
        连接信息对象.加入文本成员 ("quick_test", "curl -s " + 取MCP_HTTP地址 () + "/health")
        连接信息对象.加入文本成员 ("env_vars_set", "AI_BROWSER_MCP_URL, AI_BROWSER_MCP_WS, AI_BROWSER_MCP_HOST, AI_BROWSER_MCP_PORT, AI_BROWSER_MCP_HEALTH, AI_BROWSER_MCP_HTTP_POST, AI_BROWSER_MCP_VERSION")
        连接信息对象.加入文本成员 ("cursor_mcp_config", "{\"mcpServers\":{\"ai-browser\":{\"command\":\"node\",\"args\":[\"mcp_bridge.js\"]}}}")
        连接信息对象.加入文本成员 ("docs_url", 取MCP_HTTP地址 () + "/docs/")
        变量 连接信息JSON <类型 = 文本型>
        连接信息JSON = 连接信息对象.到可读文本 (YYJSON格式化选项.压缩)
        变量 连接信息路径 <类型 = 文本型>
        连接信息路径 = 取运行目录 () + "\\mcp_connect.json"
        写到文件 (连接信息路径, 文本到UTF8 (连接信息JSON, 假))
        控制台输出 ("[MCP] 连接信息已写入: mcp_connect.json")
        // 预热工具列表缓存: 避免首次 tools/list 请求延迟
        开始构建工具列表 ()
        填充工具列表 ()
        工具列表缓存 = "{\"tools\":" + 完成构建工具列表 () + "}"
        控制台输出 ("[MCP] 工具列表缓存已预热")
        // === 构建命令注册表 (字典预查找优化) ===
        如果 (命令注册表.是否为空对象 () || 命令注册表.是否为空 ())
        {
            命令注册表.创建 ()
            构建命令注册表 ()
            控制台输出 ("[MCP] 命令注册表已构建")
        }
        // === 初始化IP速率限制字典 (防止首次调用未初始化) ===
        如果 (IP速率限制字典.是否为空对象 () || IP速率限制字典.是否为空 ())
        {
            IP速率限制字典.创建 ()
        }
    }

    方法 清理等待检查子任务 <公开 静态 @输出名 = "CleanWaitCheckSubTask" @强制输出 = 真>
    参数 等待上下文JSON <类型 = 文本型 @输出名 = "WaitContextJSON">
    {
        如果 (等待上下文JSON == "")
        {
            返回
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (等待上下文JSON) == 假)
        {
            返回
        }
        变量 checkTaskID <类型 = 文本型>
        checkTaskID = yyjson取文本 (解析, "_check_task_id")
        如果 (checkTaskID != "")
        {
            删除异步结果 (checkTaskID)
        }
    }

    方法 修剪浏览器数组 <公开 静态 @输出名 = "TrimBrowserArray" @强制输出 = 真>
    {
        浏览器数组锁.加锁 ()
        变量 count <类型 = 整数>
        count = 浏览器容器.浏览器数组.取成员数 ()
        变量 idx <类型 = 整数>
        idx = count - 1
        判断循环 (idx >= 0)
        {
            变量 temp <类型 = 类_FBrowser_浏览器>
            temp = 对象数组类.取指定类型成员 (浏览器容器.浏览器数组, idx, 类_FBrowser_浏览器)
            如果 (temp.是否为空 () || temp.是否已关闭 ())
            {
                浏览器容器.浏览器数组.删除成员 (idx)
            }
            idx = idx - 1
        }
        浏览器数组锁.解锁 ()
    }

    # 防呆: Debugger.pause 自动恢复 (主循环500ms节拍调用, 10秒无暂停事件即resume, 防CDP队列堵塞)

    方法 检查暂停自动恢复 <公开 静态 @输出名 = "CheckPauseAutoResume" @强制输出 = 真>
    {
        如果 (待恢复暂停时间 > 0 && 取启动时间 () - 待恢复暂停时间 > 10000)
        {
            变量 当前暂停指纹 <类型 = 文本型>
            当前暂停指纹 = 取文本左边 (取CDP事件数据JSON ("Debugger.paused"), 200)
            如果 (当前暂停指纹 == 暂停前事件指纹)
            {
                控制台输出 ("[MCP] Debugger.pause 10秒无暂停事件, 自动resume防渲染器冻结/CDP队列堵塞")
                变量 恢复浏览器 <类型 = 类_FBrowser_浏览器>
                恢复浏览器 = 取主浏览器 ()
                如果 (恢复浏览器.是否为空 () == 假 && 恢复浏览器.是否已关闭 () == 假)
                {
                    执行CDP命令_带参数 ("_autoresume_" + 到文本 (取启动时间 ()), "Debugger.resume", "{}")
                }
            }
            待恢复暂停时间 = 0
            暂停前事件指纹 = ""
        }
    }

    方法 执行定期维护 <公开 静态 注释 = "由请求入口惰性触发 (≥60s间隔), 清理缓存/CDP映射/浏览器数组/WAL checkpoint/过期下载" @输出名 = "ExecutePeriodicMaintain" @强制输出 = 真>
    {
        // 修复(竞态): 主循环节拍与请求入口双路径 check-then-set 非原子, 可能同时进入; 原子占位防重入
        变量 维护占用 <静态 类型 = 整数 值 = 0>
        @ if (InterlockedCompareExchange((volatile LONG*)&@<维护占用>, 1, 0) != 0) return;
        如果 (MCP正在关闭 || 缓存数据库已打开 == 假)
        {
            @ InterlockedExchange((volatile LONG*)&@<维护占用>, 0);
            返回
        }
        // 崩溃计数复位: 浏览器存活且计数未达阈值时, 窗口随维护周期滚动 (修复: 原子写, 与UI线程崩溃计数竞争)
        如果 (近期崩溃次数 > 0)
        {
            变量 存活浏览器 <类型 = 类_FBrowser_浏览器>
            存活浏览器 = 取主浏览器 ()
            如果 (存活浏览器.是否为空 () == 假 && 存活浏览器.是否已关闭 () == 假)
            {
                原子清零崩溃计数 ()
                原子置首次崩溃时间 (0)
            }
        }
        // 防呆: Debugger.pause 自动恢复 (由主循环500ms节拍检查, 此处不再重复)
        检查暂停自动恢复 ()
        清理过期缓存 ()
        清理过期CDP映射 ()
        修剪浏览器数组 ()
        事件节流锁.加锁 ()
        如果 (应用事件节流字典.是否为空 () == 假)
        {
            变量 当前维护时间 <类型 = 长整数>
            当前维护时间 = 取启动时间 ()
            变量 focusKeys <类型 = FBrowser_文本数组>
            focusKeys = 应用事件节流字典.取关键字 ()
            计次循环 (focusKeys.取个数 ())
            {
                变量 fk <类型 = 文本型>
                fk = focusKeys.取数据 (取循环索引 ())
                如果 (是否以 (fk, "focus_ts_"))
                {
                    变量 ft <类型 = 整数>
                    ft = 应用事件节流字典.取整数值 (fk)
                    // 32位差值比较: 回绕安全 (字典仅存低32位毫秒)
                    如果 ((整数)((整数)当前维护时间 - ft) > 60000)
                    {
                        应用事件节流字典.移除 (fk)
                    }
                }
            }
        }
        事件节流锁.解锁 ()
        MCP_编排分派.强制终止超时工作流 ()
        // 定期触发 WAL checkpoint, 防止 WAL 文件无限增长 (每60s执行)
        // RESTART模式: 短暂阻塞写入者但确保WAL被截断, 比PASSIVE更可靠
        异步缓存锁.加锁 ()
        缓存数据库.执行SQL语句 ("PRAGMA wal_checkpoint(RESTART)", )
        异步缓存锁.解锁 ()
        // 检测粘滞的URL请求槽: 槽满后 5 分钟仍无释放 → 强制重置
        异步缓存锁.加锁 ()
        如果 (活动URL请求数 >= MCP_常量.URL请求最大并发)
        {
            变量 粘滞起点 <类型 = 长整数>
            粘滞起点 = URL请求槽满起始毫秒
            如果 (粘滞起点 == 0 && 最后URL请求槽释放时间 > 0)
            {
                粘滞起点 = 最后URL请求槽释放时间
            }
            如果 (粘滞起点 > 0 && 取启动时间 () - 粘滞起点 > 300000)
            {
                控制台输出 ("[MCP] 警告: URL请求槽全部粘滞 " + 到文本 (活动URL请求数) + "/" + 到文本 (MCP_常量.URL请求最大并发) + ", 强制重置")
                活动URL请求数 = 0
                最后URL请求槽释放时间 = 0
                URL请求槽满起始毫秒 = 0
            }
        }
        异步缓存锁.解锁 ()
        // 清理过期下载文件 (每60秒检查一次, 实际删除为每天首次触发)
        清理过期下载 ()
        @ InterlockedExchange((volatile LONG*)&@<维护占用>, 0);
    }

    方法 清理过期下载 <公开 静态 注释 = "删除Downloads目录中超过下载保留天数的文件" @输出名 = "CleanExpiredDownload" @强制输出 = 真>
    {
        // 修复(性能): 实际删除每天首次触发即可, 避免每60秒维护全目录扫描
        变量 上次清理OLE日期 <静态 类型 = 小数 值 = 0>
        变量 当前OLE日期 <类型 = 小数>
        当前OLE日期 = 取现行时间 ()
        如果 (上次清理OLE日期 != 0 && 当前OLE日期 - 上次清理OLE日期 < 1)
        {
            返回
        }
        上次清理OLE日期 = 当前OLE日期
        变量 下载目录 <类型 = 文本型>
        下载目录 = 取运行目录 () + "\\Downloads"
        如果 (MCP_服务器工具.检查目录是否存在 (下载目录) == 假)
        {
            返回
        }
        // 取现行时间 / 取文件时间 返回 OLE 日期 (小数, 天为单位), 30天 = 30.0
        变量 截止OLE日期 <类型 = 小数>
        截止OLE日期 = 当前OLE日期 - MCP_常量.下载保留天数
        变量 查找器 <类型 = 文件查找类>
        变量 找到名 <类型 = 文本型>
        找到名 = 查找器.寻找文件 (下载目录 + "\\*.*", -1, 0)
        变量 清理计数 <类型 = 整数 值 = 0>
        判断循环 (找到名 != "")
        {
            变量 文件路径 <类型 = 文本型>
            文件路径 = 下载目录 + "\\" + 找到名
            变量 文件OLE时间 <类型 = 小数>
            文件OLE时间 = 取文件时间 (文件路径)
            如果 (文件OLE时间 > 0 && 文件OLE时间 < 截止OLE日期)
            {
                删除文件 (文件路径)
                清理计数 = 清理计数 + 1
            }
            找到名 = 查找器.寻找文件 ("", -1, 0)
        }
        如果 (清理计数 > 0)
        {
            控制台输出 (到文本 ("[MCP] 清理过期下载:") + 到文本 (清理计数) + "个文件")
        }
    }

    方法 清理VIP拦截资源 <公开 静态 注释 = "关闭或维护时释放 VIP 过滤器" @输出名 = "CleanVIPInterceptResource" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () || browser.是否已关闭 ())
        {
            返回
        }
        变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
        vip_ctrl = browser.取VIP控制器 ()
        如果 (vip_ctrl.是否为空 ())
        {
            返回
        }
        vip_ctrl.过滤器_取消全部修改内容 ()
        vip_ctrl.过滤器_取消全部替换资源 ()
    }

    方法 关闭全部事件监控 <公开 静态 @输出名 = "CloseAllEventMonitor" @强制输出 = 真>
    {
        // 与 browser_kernel_events_all 的 disable 分支保持同一 28 项集合(此前只有 14 项, 少 12 项),
        // 否则关停路径会留下仍为真的监控开关。
        MCP命令服务器.是否监控载入事件 = 假
        MCP命令服务器.是否监控标题改变 = 假
        MCP命令服务器.是否监控加载进度 = 假
        MCP命令服务器.是否监控资源事件 = 假
        MCP命令服务器.是否监控对话框 = 假
        MCP命令服务器.是否监控全屏 = 假
        MCP命令服务器.是否监控图标 = 假
        MCP命令服务器.是否监控查找 = 假
        MCP命令服务器.是否监控框架 = 假
        MCP命令服务器.是否监控下载事件 = 假
        MCP命令服务器.是否监控键盘焦点 = 假
        MCP命令服务器.是否监控生命周期 = 假
        MCP命令服务器.是否监控应用事件 = 假
        MCP命令服务器.是否记录控制台 = 假
        MCP命令服务器.是否记录网络 = 假
        MCP命令服务器.是否详细记录网络 = 假
        MCP命令服务器.是否监控菜单事件 = 假
        MCP命令服务器.是否监控快捷菜单 = 假
        MCP命令服务器.是否监控导航意图 = 假
        MCP命令服务器.是否监控界面细节 = 假
        MCP命令服务器.是否监控插件生命周期 = 假
        MCP命令服务器.是否监控启动流程 = 假
        MCP命令服务器.是否监控渲染细节 = 假
        MCP命令服务器.是否监控WebSocket渲染 = 假
        MCP命令服务器.是否监控许可提示 = 假
        MCP命令服务器.是否监控离屏渲染 = 假
        是否监控开发者窗口 = 假
        是否监控自建URL请求 = 假
