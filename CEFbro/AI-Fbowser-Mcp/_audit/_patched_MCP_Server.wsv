    # ======== 事件日志 (SQLite) — v2.4 参数化 ==========

    方法 记录事件日志 <公开 静态 @输出名 = "RecordEventLog" @强制输出 = 真>
    参数 日志类型 <类型 = 文本型 @输出名 = "LogType">
    参数 事件名 <类型 = 文本型 @默认值 = "" @输出名 = "EventName">
    参数 浏览器ID <类型 = 整数 @默认值 = 0 @输出名 = "BrowserID">
    参数 数据JSON <类型 = 文本型 @输出名 = "DataJSON">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        变量 存储JSON <类型 = 文本型>
        存储JSON = 数据JSON
        如果 (取文本长度 (存储JSON) > 网络日志最大字节)
        {
            // 修复(数据): 原任意截断会切坏 JSON 字符串, 导致网络/事件/控制台日志整段不可解析;
            // 改为截断后 yyjson 重建为合法 JSON 对象(查询侧可直接解析)
            变量 截断包装 <类型 = YYJSON对象类>
            截断包装.创建自文本 ("{}")
            截断包装.加入逻辑值成员 ("_truncated", 真)
            截断包装.加入整数成员 ("_original_len", 取文本长度 (存储JSON))
            截断包装.加入文本成员 ("_preview", 取文本左边 (存储JSON, 200))
            存储JSON = 截断包装.到可读文本 (YYJSON格式化选项.压缩)
        }
        异步缓存锁.加锁 ()
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 ("INSERT INTO event_log (log_type, event_name, browser_id, data_json, created_at) VALUES (?, ?, ?, ?, ?)", )
        stmt.置文本参数数据 (1, 日志类型)
        stmt.置文本参数数据 (2, 事件名)
        stmt.置整数参数数据 (3, 浏览器ID)
        stmt.置文本参数数据 (4, 存储JSON)
        stmt.置长整数参数数据 (5, 取现行时间毫秒 ())
        stmt.执行语句 ()
        stmt.释放 ()
        // 修剪降频: 每次INSERT都修剪浪费COUNT查询, 改为每100次修剪一次
        变量 事件修剪计数 <静态 类型 = 整数 值 = 0>
        事件修剪计数 = 事件修剪计数 + 1
        如果 (事件修剪计数 >= 100)
        {
            事件修剪计数 = 0
            修剪事件日志表_已持锁 ()
        }
        // 每1000条清理一次; 计数在锁内保护, 防多线程竞争
        变量 清理计数 <静态 类型 = 整数 值 = 0>
        清理计数 = 清理计数 + 1
        如果 (清理计数 >= MCP_常量.日志清理间隔)
        {
            清理计数 = 0
            异步缓存锁.解锁 ()
            清理过期缓存 ()
            返回
        }
        异步缓存锁.解锁 ()
    }

    # v2.4 参数化查询 — 动态WHERE条件通过条件构建+编号绑定, 彻底消除SQL注入风险

    方法 查询事件日志 <公开 静态 类型 = 文本型 @输出名 = "QueryEventLog" @强制输出 = 真>
    参数 日志类型 <类型 = 文本型 @默认值 = "" @输出名 = "LogType">
    参数 事件名 <类型 = 文本型 @默认值 = "" @输出名 = "EventName">
    参数 浏览器ID <类型 = 整数 @默认值 = 0 @输出名 = "BrowserID">
    参数 限制条数 <类型 = 整数 @默认值 = 100 @输出名 = "LimitCount">
    {
        // 与同族 记录事件日志 / 存储任务结果 对齐: 数据库不可用时直接返回空数组。
        // 此前**独缺**此守卫 —— DB 未打开或正在关闭时会对空句柄建语句并绑参数, 请求线程随之
        // 异常终止, 客户端看到的却是 200 + Content-Length:0 的"MCP 服务器返回空响应",
        // 排查代价极高(曾据此误判为"某工具把响应写坏了")。故补上守卫。
        如果 (缓存数据库可用 () == 假)
        {
            返回 ("[]")
        }
        // 修复: 上限钳制, 防超大limit全表拼接OOM (与 查询控制台日志 对齐)
        如果 (限制条数 <= 0 || 限制条数 > 1000)
        {
            限制条数 = 100
        }
        变量 result <类型 = 文本型>
        result = "["
        异步缓存锁.加锁 ()
        // 动态构建 WHERE 条件, 用 ? 占位, 计数绑定
        变量 条件SQL <类型 = 文本型>
        条件SQL = ""
        变量 paramIdx <类型 = 整数 值 = 0>
        变量 hasType <类型 = 逻辑型 值 = 假>
        变量 hasEvent <类型 = 逻辑型 值 = 假>
        变量 hasBID <类型 = 逻辑型 值 = 假>
        如果 (日志类型 != "")
        {
            paramIdx = paramIdx + 1
            条件SQL = 条件SQL + " AND log_type=?  "
            hasType = 真
        }
        变量 事件名绑定值 <类型 = 文本型>
        事件名绑定值 = 事件名
        如果 (事件名 != "")
        {
            paramIdx = paramIdx + 1
            // 族名通配: 工具描述与错误提示都承诺可用 resource_* / frame_* / download_* / focus_* / app_*,
            // 但这里原本是精确相等 —— 照文档操作必然查不到。含 * 或 % 时改用 LIKE(把 * 当 % 用)。
            如果 (寻找文本 (事件名, "*", 0, 假) != -1 || 寻找文本 (事件名, "%", 0, 假) != -1)
            {
                子文本替换 (事件名绑定值, "*", "%", , , 假)
                条件SQL = 条件SQL + " AND event_name LIKE ?  "
            }
            否则
            {
                条件SQL = 条件SQL + " AND event_name=?  "
            }
            hasEvent = 真
        }
        如果 (浏览器ID > 0)
        {
            paramIdx = paramIdx + 1
            // 同时纳入 browser_id=0 的"与浏览器无关"事件(自建 URL 请求 urlreq_*、crash 等)。
            // 这些事件没有浏览器上下文, 记录侧用 0 表示全局; 若这里只按具体ID过滤, 它们**永远查不出来**
            // (实测: urlreq_start 记录成功但 browser_event 查不到)。此前只有 crash 在调用侧特判,
            // 现推广为通则。
            条件SQL = 条件SQL + " AND (browser_id=? OR browser_id=0)  "
            hasBID = 真
        }
        // 注意 "WHERE 1=1 " 结尾这个空格: 三个过滤条件全空时条件串为空, 少这个空格会拼出
        // "WHERE 1=1ORDER BY ..." —— SQL 语法错误。此前所有调用方都至少传了 browser_id>0
        // 才没暴露; 一旦有人查全表(三参全空)必然失败。
        变量 sql <类型 = 文本型>
        sql = "SELECT data_json FROM event_log WHERE 1=1 " + 条件SQL + "ORDER BY created_at DESC LIMIT ?  "
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 (sql, )
        paramIdx = 0
        如果 (hasType)
        {
            paramIdx = paramIdx + 1
            记录集.置文本参数数据 (paramIdx, 日志类型)
        }
        如果 (hasEvent)
        {
            paramIdx = paramIdx + 1
            记录集.置文本参数数据 (paramIdx, 事件名绑定值)
        }
        如果 (hasBID)
        {
            paramIdx = paramIdx + 1
            记录集.置整数参数数据 (paramIdx, 浏览器ID)
        }
        记录集.置整数参数数据 (paramIdx + 1, 限制条数)
        变量 first <类型 = 逻辑型 值 = 真>
        循环判断首 ()
        {
            变量 rc <类型 = 整数>
            rc = 记录集.执行语句 ()
            如果 (rc != 100)  // 非 SQLITE_ROW
            {
                跳出循环
            }
            如果 (first)
            {
                first = 假
            }
            否则
            {
                result = result + ","
            }
            result = result + 记录集.读文本数据 (0)
        }
        循环判断尾 (真)
        记录集.释放 ()
        异步缓存锁.解锁 ()
        result = result + "]"
        返回 (result)
    }

    # 控制台日志关键词搜索 (LIKE data_json, 支持定位Hook输出/报错/特征字符串)

    方法 查询控制台日志_带关键词 <公开 静态 类型 = 文本型 @输出名 = "QueryConsoleLogWithKeyword" @强制输出 = 真>
    参数 关键词 <类型 = 文本型 @输出名 = "Keyword">
    参数 限制条数 <类型 = 整数 @默认值 = 200 @输出名 = "LimitCount">
    {
        如果 (限制条数 <= 0 || 限制条数 > 1000)
        {
            限制条数 = 200
        }
        变量 result <类型 = 文本型>
        result = "["
        // 转义 LIKE 通配符, 防止用户输入 %/_ 意外匹配任意字符 (子文本替换就地修改首参数)
        变量 安全词 <类型 = 文本型>
        安全词 = 关键词
        子文本替换 (安全词, "\\", "\\\\", , , 假)
        子文本替换 (安全词, "%", "\\%", , , 假)
        子文本替换 (安全词, "_", "\\_", , , 假)
        安全词 = "%" + 安全词 + "%"
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT data_json FROM event_log WHERE log_type='console' AND data_json LIKE ? ESCAPE '\\' ORDER BY created_at DESC LIMIT ?  ", )
        记录集.置文本参数数据 (1, 安全词)
        记录集.置整数参数数据 (2, 限制条数)
        变量 first <类型 = 逻辑型 值 = 真>
        循环判断首 ()
        {
            变量 rc <类型 = 整数>
            rc = 记录集.执行语句 ()
            如果 (rc != 100)
            {
                跳出循环
            }
            如果 (first)
            {
                first = 假
            }
            否则
            {
                result = result + ","
            }
            result = result + 记录集.读文本数据 (0)
        }
        循环判断尾 (真)
        记录集.释放 ()
        异步缓存锁.解锁 ()
        result = result + "]"
        返回 (result)
    }

    方法 查询网络日志 <公开 静态 类型 = 文本型 @输出名 = "QueryNetworkLog" @强制输出 = 真>
    参数 限制条数 <类型 = 整数 @默认值 = 500 @输出名 = "LimitCount">
    {
        // 修复: 上限钳制, 防超大limit全表拼接OOM
        如果 (限制条数 <= 0 || 限制条数 > 1000)
        {
            限制条数 = 500
        }
        变量 result <类型 = 文本型>
        result = "["
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT data_json FROM event_log WHERE log_type IN ('network','network_detail') ORDER BY created_at DESC LIMIT ?  ", )
        记录集.置整数参数数据 (1, 限制条数)
        变量 first <类型 = 逻辑型 值 = 真>
        循环判断首 ()
        {
            变量 rc <类型 = 整数>
            rc = 记录集.执行语句 ()
            如果 (rc != 100)
            {
                跳出循环
            }
            如果 (first)
            {
                first = 假
            }
            否则
            {
                result = result + ","
            }
            result = result + 记录集.读文本数据 (0)
        }
        循环判断尾 (真)
        记录集.释放 ()
        异步缓存锁.解锁 ()
        result = result + "]"
        返回 (result)
    }

    # ======== 缓存清理 — v2.4 参数化 ==========

    方法 清理滞留等待任务_已持锁 <公开 静态 注释 = "调用方须已持有 异步缓存锁" @输出名 = "CleanStalledWaitTaskLockHeld" @强制输出 = 真>
    {
        变量 等待截止 <类型 = 长整数>
        等待截止 = 取现行时间毫秒 () - MCP_常量.等待任务最大滞留毫秒
        缓存数据库.执行SQL语句 ("DELETE FROM async_results WHERE is_waiting=1 AND created_at<" + 到文本 (等待截止), )
    }

    方法 修剪异步结果表_已持锁 <公开 静态 注释 = "调用方须已持有 异步缓存锁" @输出名 = "TrimAsyncResultTableLockHeld" @强制输出 = 真>
    {
        清理滞留等待任务_已持锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT COUNT(*) FROM async_results", )
        如果 (记录集.执行语句 () == 100)
        {
            变量 总数 <类型 = 整数>
            总数 = 记录集.读整数数据 (0)
            如果 (总数 > MCP_常量.缓存最大条目)
            {
                变量 删除数 <类型 = 整数>
                删除数 = 总数 - MCP_常量.缓存最大条目 + MCP_常量.缓存清理_保留缓冲
                缓存数据库.执行SQL语句 ("DELETE FROM async_results WHERE task_id IN (SELECT task_id FROM async_results WHERE is_waiting=0 ORDER BY created_at ASC LIMIT " + 到文本 (删除数) + ")", )
                变量 仍超限 <类型 = 整数>
                仍超限 = 总数 - 删除数
                如果 (仍超限 > MCP_常量.缓存最大条目)
                {
                                        // 等待任务由 清理滞留等待任务_已持锁 按1小时滞留期兜底回收
                    变量 强制删除数 <类型 = 整数>
                    强制删除数 = 仍超限 - MCP_常量.缓存最大条目 + MCP_常量.缓存清理_保留缓冲
                    缓存数据库.执行SQL语句 ("DELETE FROM async_results WHERE task_id IN (SELECT task_id FROM async_results WHERE is_waiting=0 ORDER BY created_at ASC LIMIT " + 到文本 (强制删除数) + ")", )
                }
            }
        }
        记录集.释放 ()
    }

    方法 修剪事件日志表_已持锁 <公开 静态 注释 = "调用方须已持有 异步缓存锁" @输出名 = "TrimEventLogTableLockHeld" @强制输出 = 真>
    {
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT COUNT(*) FROM event_log", )
        如果 (记录集.执行语句 () == 100)
        {
            变量 总数 <类型 = 整数>
            总数 = 记录集.读整数数据 (0)
            如果 (总数 > MCP_常量.事件日志最大条目)
            {
                变量 删除数 <类型 = 整数>
                删除数 = 总数 - MCP_常量.事件日志最大条目 + MCP_常量.缓存清理_保留缓冲
                缓存数据库.执行SQL语句 ("DELETE FROM event_log WHERE id IN (SELECT id FROM event_log ORDER BY created_at ASC LIMIT " + 到文本 (删除数) + ")", )
            }
        }
        记录集.释放 ()
    }

    方法 修剪响应缓存表_已持锁 <公开 静态 注释 = "调用方须已持有 异步缓存锁" @输出名 = "TrimResponseCacheTableLockHeld" @强制输出 = 真>
    {
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT COUNT(*) FROM response_cache", )
        如果 (记录集.执行语句 () == 100)
        {
            变量 总数 <类型 = 整数>
            总数 = 记录集.读整数数据 (0)
            如果 (总数 > MCP_常量.响应缓存最大条目)
            {
                变量 删除数 <类型 = 整数>
                删除数 = 总数 - MCP_常量.响应缓存最大条目 + MCP_常量.缓存清理_保留缓冲
                缓存数据库.执行SQL语句 ("DELETE FROM response_cache WHERE url IN (SELECT url FROM response_cache ORDER BY created_at ASC LIMIT " + 到文本 (删除数) + ")", )
            }
        }
        记录集.释放 ()
    }

    方法 清理过期缓存 <公开 静态 @输出名 = "CleanExpiredCache" @强制输出 = 真>
    {
        // created_at 统一使用墙钟毫秒(取现行时间毫秒), 与取启动时间(系统运行时长)严格区分:
        // 后者在开机初期 < 保留天数时会导致过期时间为负, 误入全表清空分支, 每60秒清空一次日志与任务
        变量 过期时间 <类型 = 长整数>
        过期时间 = 取现行时间毫秒 () - MCP_常量.缓存保留天数 * MCP_常量.毫秒_每天
        异步缓存锁.加锁 ()
        // async_results 按非等待保留(24h)清理; event_log/response_cache 按缓存保留天数(14d)清理
        变量 短TTL截止 <类型 = 长整数>
        短TTL截止 = 取现行时间毫秒 () - MCP_常量.异步结果非等待保留毫秒
        缓存数据库.执行SQL语句 ("DELETE FROM async_results WHERE is_waiting=0 AND created_at<" + 到文本 (短TTL截止), )
        清理滞留等待任务_已持锁 ()
        修剪异步结果表_已持锁 ()
        执行参数化DELETE ("DELETE FROM event_log WHERE created_at<?", 到文本 (过期时间))
        修剪事件日志表_已持锁 ()
        执行参数化DELETE ("DELETE FROM response_cache WHERE created_at<?", 到文本 (过期时间))
        修剪响应缓存表_已持锁 ()
        异步缓存锁.解锁 ()
    }

    # ======== SQL 辅助 (v2.4: 全部用户数据写入已改为参数化查询) ==========
    # 保留: 仅用于无参数的DDL/CREATE/PRAGMA
    # 所有含用户数据的SQL请使用 执行参数化INSERT / 取记录集+置参数 模式

    方法 执行SQL <公开 静态 @输出名 = "ExecuteSQL" @强制输出 = 真>
    参数 sql <类型 = 文本型 @输出名 = "SQL">
    {
        异步缓存锁.加锁 ()
        缓存数据库.执行SQL语句 (sql, )
        异步缓存锁.解锁 ()
    }

    # ======== 响应缓存 (SQLite) — v2.4 修复 ?, 参数化+hex编码body ==========

    方法 存储响应缓存 <公开 静态 @输出名 = "StoreResponseCache" @强制输出 = 真>
    参数 url <类型 = 文本型 @输出名 = "URL">
    参数 mime <类型 = 文本型 @输出名 = "MIME">
    参数 body <类型 = 字节集类 @输出名 = "Body">
    参数 size <类型 = 整数 @输出名 = "Size">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        如果 (size <= 0 || size > MCP_常量.响应缓存单条最大字节)
        {
            返回
        }
        异步缓存锁.加锁 ()
        变量 当前时间 <类型 = 长整数>
        当前时间 = 取现行时间毫秒 ()  // created_at 保留期统一墙钟
        // body转hex存储; 字节集到十六进制文本保证输出合法hex, 仅做长度合理性检查
        变量 hexBody <类型 = 文本型>
        hexBody = 字节集到十六进制文本 (body)
        变量 hexLen <类型 = 整数>
        hexLen = 取文本长度 (hexBody)
        如果 (hexLen == 0 || hexLen % 2 != 0)
        {
                        变量 hex警告 <类型 = 文本型>
            hex警告 = 到文本 ("[MCP] 警告: response_cache body hex长度异常, url=") + 到文本 (url) + " hexLen=" + 到文本 (hexLen)
            异步缓存锁.解锁 ()
            控制台输出 (hex警告)
            返回
        }
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 ("INSERT OR REPLACE INTO response_cache (url, mime_type, body, size, created_at) VALUES (?, ?, x'" + hexBody + "', ?, ?)", )
        stmt.置文本参数数据 (1, url)
        stmt.置文本参数数据 (2, mime)
        stmt.置整数参数数据 (3, size)
        stmt.置长整数参数数据 (4, 当前时间)
        stmt.执行语句 ()
        stmt.释放 ()
        修剪响应缓存表_已持锁 ()
        异步缓存锁.解锁 ()
    }

    # ======== 异步JS执行 (非阻塞) ==========

    方法 异步执行JS <公开 静态 类型 = 文本型 @输出名 = "AsyncExecuteJS" @强制输出 = 真>
    参数 browser <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    参数 code <类型 = 文本型 @输出名 = "Code">
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    {
        如果 (browser.是否为空 () || browser.是否已关闭 ())
        {
            存储异步结果 (任务ID, MCP_响应构建.构建标准失败JSON (MCP_常量.错误_无浏览器))
            返回 (任务ID)
        }
        变量 安全框架 <类型 = 类_FBrowser_框架>
        安全框架 = 取安全主框架 (browser)
        如果 (安全框架.是否为空 () || 安全框架.是否有效 () == 假)
        {
            存储异步结果 (任务ID, MCP_响应构建.构建标准失败JSON (MCP_常量.错误_主框架无效))
            返回 (任务ID)
        }
        // v2.7: 预存pending占位 — 即使CEF回调因页面导航丢失, 任务也不会"消失"
        // mcp_result轮询此占位时按max_ms超时返回错误, 而非"未找到任务"
        变量 预占位 <类型 = YYJSON对象类>
        预占位.创建自文本 ("{}")
        预占位.加入逻辑值成员 ("_waiting", 真)
        预占位.加入文本成员 ("what", "js_exec")
        预占位.加入文本成员 ("message", "JS执行中...")
        预占位.加入长整数成员 ("start_time", 取启动时间 ())
        预占位.加入整数成员 ("max_ms", MCP_常量.同步等待_JS执行超时)
        预占位.加入整数成员 ("_browser_id", browser.取ID ())
        存储异步结果 (任务ID, 预占位.到可读文本 (YYJSON格式化选项.压缩), browser.取ID ())
        变量 JS回调 <类型 = 类_FBrowser_事件智能指针>
        JS回调.创建 (类_MCP_JS异步回调)
        JS回调.取执行类 (类_MCP_JS异步回调).任务ID = 任务ID
        安全框架.执行JS代码_带返回值 (code, , , JS回调)
        返回 (任务ID)
    }

