        添加工具JSON ("browser_vip_fingerprint_media_devices", "VIP: 虚拟媒体设备指纹。target选择设备类别(audio_input/audio_output/video_input), type控制动作(0清空/1添加/2覆盖); 设置后需刷新页面生效", 多属性Schema文本 (属性项JSON ("type", "integer", "0清空/1添加/2覆盖") + "," + 属性项JSON ("target", "text", "audio_input/audio_output/video_input"), "\"target\""))
        // v1.7 VIP扩展插件
        添加工具JSON ("browser_vip_load_extension", "VIP: 加载插件。两种形态: path=**已解压插件目录**(类库原文: 比 CRX 安装效率高, 推荐) 或 crx_path=.crx 插件包(类库原文: 概率性出现页面已打开但插件未装完, 装完刷新页面即生效)。两者给其一即可。回包 advanced_enabled 表示插件高级功能开关是否已开 —— 类库原文: 默认 CEF **不支持**插件 content_scripts.js 执行, 必须在该开关启用后才支持, 且**必须在加载插件前启用**(本服务已在进程启动时自动开启, 加载前再幂等补开)", 多属性Schema文本 (属性项JSON ("path", "text", "已解压插件目录(与 crx_path 二选一)") + "," + 属性项JSON ("crx_path", "text", "CRX 插件包完整路径(与 path 二选一)"), ""))
        添加工具JSON ("browser_vip_unload_extension", "VIP: 卸载插件", 单参数Schema文本 ("extension_id", "text", "插件ID"))
        添加工具JSON ("browser_vip_extension_info", "VIP: 查询插件信息", 单参数Schema文本 ("extension_id", "text", "插件ID"))
        添加工具JSON ("browser_vip_execute_js_context", "VIP: 在指定环境/框架执行JS。target 缺省=按 context_id/frame_id 走原行为; target=main(主框架/顶级框架) / all_frames(**当前所有框架各执行一遍**, 一次打穿全部 iframe, 回调逐帧返回且结果为累计) / frame_index(按浏览器加载框架的序号执行, 需 frame_index, 0 一般为主框架)。⚠ 这三个 target 属 VIP 高级功能, **需先 browser_vip_enable_js_env {enable:true, confirm:true}**(未启用会明确失败而不是静默等待); 该开关会破坏本会话 CDP 通道且需重启恢复 | 不需要 VIP 环境时请用 browser_execute_js(走 CDP)", 多属性Schema文本 (属性项JSON ("code", "text", "JS代码") + "," + 属性项JSON ("target", "text", "缺省/main/all_frames/frame_index") + "," + 属性项JSON ("frame_index", "integer", "target=frame_index: 框架序号(从0开始, 0 一般为主框架)") + "," + 属性项JSON ("context_id", "integer", "环境ID(缺省路径用)") + "," + 属性项JSON ("frame_id", "text", "框架ID(缺省路径用, 与 target 互斥时以 target 优先)"), ""))
        添加工具JSON ("browser_vip_enable_devtools_observer", "VIP: 启用DevTools消息监听。⚠ 关闭会使全部 CDP 类工具(debugger_*/cdp_*/reverse CDP类)失效且需重启进程才能恢复, 故关闭必须显式传 enable 的字符串值 false; 启用可传字符串 true 或布尔 true; 完全不传 enable 会被拒绝(缺省与布尔 false 在协议层无法区分, 为避免误关故不接受缺省)", 单参数Schema文本 ("enable", "string", "字符串 true 启用 / 字符串 false 关闭(CDP工具会全部失效); 也接受布尔 true"))
        添加工具JSON ("browser_vip_dom_get_document", "VIP: CDP获取DOM文档(JSON)", 单参数Schema文本 ("depth", "integer", "深度", 假))
        添加工具JSON ("browser_vip_dom_search", "VIP: CDP DOM文本搜索", 多属性Schema文本 (属性项JSON ("query", "text", "搜索文本") + "," + 属性项JSON ("search_id", "text", "已有searchId可选"), ""))
        添加工具JSON ("browser_vip_touch_emulation", "VIP: 触摸事件模拟", 多属性Schema文本 (属性项JSON ("enable", "boolean", "启用") + "," + 属性项JSON ("max_points", "integer", "最大触摸点"), ""))
        添加工具JSON ("browser_get_extra_data", "获取浏览器创建时传入的额外数据")
        添加工具JSON ("browser_fingerprint_ua", "VIP: 虚拟UA完整数据", 多属性Schema文本 (属性项JSON ("ua", "text", "UserAgent") + "," + 属性项JSON ("platform", "text", "navigator.platform") + "," + 属性项JSON ("accept_lang", "text", "Accept-Language") + "," + 属性项JSON ("mobile", "boolean", "mobile") + "," + 属性项JSON ("architecture", "text", "architecture") + "," + 属性项JSON ("bitness", "text", "bitness") + "," + 属性项JSON ("model", "text", "model") + "," + 属性项JSON ("wow64", "boolean", "wow64") + "," + 属性项JSON ("platform_version", "text", "UA-CH: navigator.userAgentData.platformVersion (如 15.0.0)") + "," + 属性项JSON ("full_version", "text", "UA-CH: navigator.userAgentData.fullVersion (如 120.0.6099.109)") + "," + 属性项JSON ("brands", "text", "UA-CH: navigator.userAgentData.brands。紧凑写法 \"brand:version,brand2:version2\" (例: Chromium:120,Google Chrome:120)。建议与 ua 保持同版本, 两者不一致比不伪装更容易被识别") + "," + 属性项JSON ("full_version_list", "text", "UA-CH: navigator.userAgentData.fullVersionList, 写法同 brands"), ""))
        添加工具JSON ("browser_vip_orientation", "VIP: 虚拟屏幕方向", 多属性Schema文本 (属性项JSON ("type", "integer", "方向类型") + "," + 属性项JSON ("angle", "integer", "角度"), ""))
        // v2.8.0 JS逆向工具
        添加工具JSON ("browser_reverse_hook", "JS逆向: 无侵入函数Hook(CDP/V8级)。type=function_call(支持obj.fn点路径)/xhr_fetch/websocket/eval_dynamic/cookie_set。自动记录参数/返回值/调用栈到__MCP_HOOK_LOG__(hook_logs可查)与console,不修改fn.toString()", 多属性Schema文本 (属性项JSON ("target", "text", "目标函数名(支持obj.fn点路径)/URL模式") + "," + 属性项JSON ("type", "text", "function_call/xhr_fetch/websocket/eval_dynamic/cookie_set") + "," + 属性项JSON ("capture_args", "boolean", "捕获参数(默认true)") + "," + 属性项JSON ("capture_return", "boolean", "捕获返回值(默认true)") + "," + 属性项JSON ("capture_stack", "boolean", "捕获调用栈"), ""))
        添加工具JSON ("browser_reverse_strings", "JS逆向: 提取页面中的可疑字符串/加密数组。mode=suspicious(长字符串+Base64+HEX)/decrypt_array(解密数组)", 多属性Schema文本 (属性项JSON ("mode", "text", "suspicious/decrypt_array") + "," + 属性项JSON ("min_length", "integer", "最小长度(默认20)") + "," + 属性项JSON ("max_results", "integer", "最大结果数(默认200)"), ""))
        添加工具JSON ("browser_reverse_verify", "JS逆向: 验证重实现算法。给定原始函数和重写版本+测试用例,自动比对输出是否一致", 多属性Schema文本 (属性项JSON ("original", "text", "原始函数路径(如window.sign)") + "," + 属性项JSON ("reimplementation", "text", "重写的JS函数") + "," + 属性项JSON ("test_inputs", "text", "测试用例JSON数组") + "," + 属性项JSON ("compare_mode", "text", "strict/lenient"), "\"original\",\"reimplementation\""))
        // v2.6.2 JS逆向增强工具
        添加工具JSON ("browser_reverse_cookie_sources", "JS逆向: Cookie归因分析。Hook document.cookie setter,记录每次JS写入的调用栈+值+时间戳。区分HTTP Set-Cookie vs JS写入", 空Schema文本 ())
        添加工具JSON ("browser_reverse_env", "JS逆向: 浏览器环境全量收集(40+变量)。含navigator/screen/window/location/document/canvas/webgl/audio指纹,用于补环境对照", 空Schema文本 ())
        添加工具JSON ("browser_reverse_instrument", "JS逆向: JSVMP解释器透明插桩。mode=transparent仅替换prototype getter保留toString; mode=interpreter Hook VM分发器。不破坏签名计算", 多属性Schema文本 (属性项JSON ("target", "text", "目标函数名(transparent模式可选,interpreter模式必填)") + "," + 属性项JSON ("mode", "text", "transparent(默认)/interpreter"), ""))
        添加工具JSON ("browser_reverse_search", "JS逆向: 全局脚本搜索。在所有已加载script中搜索关键词(sign/encrypt/token/md5/aes),返回匹配行+脚本URL+行号", 多属性Schema文本 (属性项JSON ("query", "text", "搜索关键词(如sign/encrypt/md5)") + "," + 属性项JSON ("script_url", "text", "限定脚本URL片段(可选)"), "\"query\""))
        添加工具JSON ("browser_reverse_initiator", "JS逆向: 网络溯源。Hook XHR+fetch,捕获匹配URL模式的请求的完整JS调用栈,定位发起请求的函数", 多属性Schema文本 (属性项JSON ("url_pattern", "text", "匹配URL片段(如/api/sign)") + "," + 属性项JSON ("request_id", "text", "网络请求ID(可选)"), ""))
        添加工具JSON ("browser_reverse_preset", "JS逆向: 一键预设Hook。preset=xhr/fetch/cookie/websocket/crypto/debugger/all,批量安装常用Hook,数据存入window.__mcp_*_log", 单参数Schema文本 ("preset", "text", "xhr/fetch/cookie/websocket/crypto/debugger/all(默认)", 假))
        // v2.6.2 CDP逆向增强 (原生CDP协议,非JS注入)
        添加工具JSON ("browser_reverse_cdp_hook", "CDP逆向: 函数调用级别断点。Debugger.setBreakpointOnFunctionCall—Ghostwire风格,不修改JS源码,fn.toString()不变,防检测", 多属性Schema文本 (属性项JSON ("function_name", "text", "目标函数名(如window.sign)") + "," + 属性项JSON ("object_id", "text", "CDP Runtime objectId(可选,优先级高于function_name)") + "," + 属性项JSON ("condition", "text", "条件断点表达式(可选)"), ""))
        添加工具JSON ("browser_reverse_profile", "CDP逆向: JS CPU性能分析。action=start开始采样/stop停止并获取报告/query查询。定位热点函数,识别加密算法性能瓶颈", 单参数Schema文本 ("action", "text", "start/start_precise(精确采样)/stop/query(默认start)"))
        添加工具JSON ("browser_reverse_dom_breakpoint", "CDP逆向: DOM/XHR事件断点。type=xhr拦截所有XHR/fetch=拦截fetch/dom_event=DOM事件/timer=定时器。在事件触发时自动断点", 多属性Schema文本 (属性项JSON ("type", "text", "xhr/fetch/dom_event/timer") + "," + 属性项JSON ("target", "text", "URL模式(xhr)或事件名(dom_event)"), "\"type\""))
        添加工具JSON ("browser_reverse_preload", "CDP逆向: 预注入脚本。Page.addScriptToEvaluateOnNewDocument—在所有页面JS执行之前注入,先于任何反检测/混淆代码加载", 多属性Schema文本 (属性项JSON ("code", "text", "JS代码") + "," + 属性项JSON ("file", "text", "JS文件路径(与code二选一)"), "\"code\""))
        添加工具JSON ("browser_reverse_call_fn", "CDP逆向: 远程函数调用(纯算法直调)。Runtime.callFunctionOn—传object_id或function_name(自动解析objectId)调用任意函数,arguments传JSON数组时类型原样保留(数字/逻辑值不降级),可访问闭包/私有作用域函数", 多属性Schema文本 (属性项JSON ("object_id", "text", "CDP Runtime objectId(与function_name二选一)") + "," + 属性项JSON ("function_name", "text", "全局函数名(自动Runtime.evaluate解析objectId,与object_id二选一)") + "," + 属性项JSON ("arguments", "text", "参数JSON数组(类型原样保留,如[admin123,42,true])") + "," + 属性项JSON ("args", "text", "单文本参数(自动包装为单元素数组)"), ""))
        添加工具JSON ("browser_reverse_websocket", "CDP逆向: WebSocket消息拦截。Network.enable+webSocketFrameReceived—监听所有WS帧(send/receive),用于分析实时通信协议", 单参数Schema文本 ("action", "text", "enable(默认)/query"))
        添加工具JSON ("browser_reverse_heap", "CDP逆向: 堆内存分析。HeapProfiler—snapshot堆快照/start_sampling采样/stop_sampling停止/get_object按ID查对象。定位内存中的加密密钥/签名对象", 多属性Schema文本 (属性项JSON ("action", "text", "snapshot/start_sampling/stop_sampling/get_object") + "," + 属性项JSON ("object_id", "text", "heap对象ID(get_object时必填)"), ""))
        添加工具JSON ("browser_reverse_runtime", "CDP逆向: Runtime运行时分析。action=properties获取对象属性/evaluate在全局作用域执行表达式(return_by_value:false可返回objectId供call_fn直调)/global获取全局变量名列表。**action 可省略**: 省略时按你已给的参数自动选(object_id->properties / expression->evaluate / 两者都没给->global), 以免空参调用必然失败; 每次自动选择都会在 auto_prepared 里如实上报", 多属性Schema文本 (属性项JSON ("action", "text", "properties/evaluate/global(可省略, 省略则按已给参数自动选)") + "," + 属性项JSON ("object_id", "text", "对象ID(properties时必填)") + "," + 属性项JSON ("expression", "text", "JS表达式(evaluate时必填)") + "," + 属性项JSON ("return_by_value", "boolean", "evaluate时生效(默认true; false返回objectId)"), ""))
        添加工具JSON ("browser_reverse_network_intercept", "CDP逆向: 网络请求拦截。action=enable启用URL模式拦截/disable禁用。enable 后匹配该模式的请求会被挂起(不再自动放行), 放行请用 browser_cdp_call method=Network.continueInterceptedRequest; action=disable 整体解除并恢复被挂请求。用于观察/改写请求参数(如绕过签名校验)", 多属性Schema文本 (属性项JSON ("action", "text", "enable(默认)/disable") + "," + 属性项JSON ("url_pattern", "text", "URL匹配模式, enable 时必填(如 */api/* 或 *sign*)。不支持“留空=拦截全部”: 本项目没有放行通道, 拦下不放行会把页面整体卡死, 故留空会被明确拒绝"), ""))
        添加工具JSON ("browser_reverse_setup", "反检测预配置: 浏览器事件级架构—设置后所有新浏览器自动应用! disable_debugger禁用Debugger检测/user_agent伪装UA/disable_automation_flag移除webdriver标志。立即应用当前浏览器+持久化到新浏览器", 多属性Schema文本 (属性项JSON ("disable_debugger", "boolean", "禁用网页debugger检测(VIP)") + "," + 属性项JSON ("user_agent", "text", "伪装UserAgent") + "," + 属性项JSON ("disable_automation_flag", "boolean", "移除navigator.webdriver等自动化标志"), ""))
        // v2.6.3 静态加密模块提取
        添加工具JSON ("browser_reverse_extract", "JS逆向: 静态加密模块提取(CDP Runtime.evaluate同步)。mode=scan枚举页面<script>标签返回脚本列表+加密特征检测; mode=download按DOM索引取脚本textContent完整源码; mode=analyze按url_pattern一次扫描+源码分析提取算法(AES/RSA/MD5/SHA/HMAC)和可疑密钥常量", 多属性Schema文本 (属性项JSON ("mode", "text", "scan(默认)/download/analyze") + "," + 属性项JSON ("url_pattern", "text", "URL片段(analyze模式必填, 匹配脚本src)") + "," + 属性项JSON ("script_index", "text", "DOM脚本索引(download模式必填, 取自scan返回的index)") + "," + 属性项JSON ("keyword", "text", "关键词(scan模式可选, 过滤含关键词的脚本)"), ""))
        // v2.8 反检测预设 + 逆向增强
        添加工具JSON ("browser_antidetect_presets", "反检测: 一键部署反检测预设。preset=stealth(去webdriver+去debugger检测+去自动化标志)/basic(stealth+Canvas/WebGL/Audio随机化)/full(basic+UA伪装+屏幕1920x1080+硬件8核8GB+时区Asia/Shanghai+WebRTC禁用+定位北京)。批量应用,持久生效,新浏览器自动应用", 单参数Schema文本 ("preset", "text", "stealth(默认)/basic/full"))
        // v2.8 网络导出 + 权限伪装
        添加工具JSON ("browser_network_export", "网络: 导出网络日志为HAR(HTTP Archive 1.2)或JSON格式。HAR格式兼容Chrome DevTools Network面板导入。以JSON数组返回所有记录的请求/响应(URL/method/status/mime/size/timestamp)", 多属性Schema文本 (属性项JSON ("format", "text", "har/json(默认json)") + "," + 属性项JSON ("limit", "integer", "最大条目数(默认2000,上限50000)"), ""))
        添加工具JSON ("browser_permission_spoof", "反检测: 伪装浏览器权限API。action=apply注入navigator.permissions.query()覆盖(返回指定state)+MediaDevices.enumerateDevices覆盖; action=reset移除伪装。permissions支持:geolocation/notifications/camera/microphone/midi/clipboard-read/clipboard-write", 多属性Schema文本 (属性项JSON ("action", "text", "apply(默认)/spoof/reset/remove") + "," + 属性项JSON ("state", "text", "granted(默认)/denied/prompt") + "," + 属性项JSON ("permissions", "text", "权限列表,逗号分隔(默认全部7项)"), ""))
        // v2.8 自动化重试 + Canvas噪声 (v2.8)
        添加工具JSON ("browser_retry", "自动化: 带线性退避的MCP工具重试机制。对不稳定的工具调用(如填表/点击/导航)自动重试max_retries次,每次失败后等待backoff_ms×attempt毫秒。直到成功或超过max_total_ms", 多属性Schema文本 (属性项JSON ("tool", "text", "要重试的MCP工具名") + "," + 属性项JSON ("args", "text", "工具参数JSON(默认{})") + "," + 属性项JSON ("max_retries", "integer", "最大重试次数(默认3,上限10)") + "," + 属性项JSON ("backoff_ms", "integer", "退避基数毫秒(默认1000,上限30000)") + "," + 属性项JSON ("max_total_ms", "integer", "总超时毫秒(默认60000)"), "\"tool\""))
        添加工具JSON ("browser_canvas_noise", "反检测: Canvas指纹噪点注入(JS层实现,不需VIP)。action=inject为Canvas toDataURL/toBlob/getImageData添加±level随机噪声,防Canvas指纹追踪; action=remove移除噪声。不依赖内核VIP API,纯JS Hook", 多属性Schema文本 (属性项JSON ("action", "text", "inject(默认)/enable/remove/disable") + "," + 属性项JSON ("level", "integer", "噪声级别1-5(默认1, 越大噪声越明显)"), ""))
        // v2.8 逆向热补丁 + 字体随机化
        // v2.8 CDP逆向增强: 6个官方API封装
        // v2.8 CDP逆向增强 R6: Runtime/Profiler/Page/Debugger 深度API
        // v2.8 CDP逆向增强 R7: Storage/Network/DOM/Emulation + VIP WebGL vendor
        // v2.8 CDP逆向增强 R8: Input/Tracing/Runtime 收尾
        // v2.8 CDP逆向增强 R9: fingerprint_languages + CSS/LayerTree 收尾
        // v1.8 浏览器事件查询
        添加工具JSON ("browser_event", "查询浏览器事件。event_type为空时返回最近全部事件的时间线(默认50条, limit可调); 指定event_type查询特定类型; app_*查询应用事件。**event_type 必须用下面列出的名字**: load_start/load_end/load_error/crash/navigate/popup/popup_failed/loading_state_change/url_changed/browser_created/browser_closing/do_close/title_changed/load_progress/js_dialog/before_unload/file_dialog/fullscreen/favicon/find_result/key_press, 以及通配族 resource_*/frame_*/download_*/focus_*(注意: 要按带星号的族名查, 如 resource_*, 传具体名 resource_response 会报未找到)", 多属性Schema文本 (属性项JSON ("event_type", "text", "上述类型之一, 或通配族 resource_*/frame_*/download_*/focus_*/app_* (空=时间线模式)") + "," + 属性项JSON ("limit", "integer", "返回条数(默认50,上限500)"), ""))
        // v2.8.1 UX: AI 交互增强 (内核执行JS代码通道同步返回, 无需轮询)
        添加工具JSON ("browser_snapshot", "AI页面快照: 提取页面全部交互元素(a/button/input/select/textarea/[role]/[onclick])为紧凑清单, 含索引/标签/可见文本/id/name/CSS选择器。AI据此精准定位元素, 配合browser_click_text/browser_dom_click操作", 多属性Schema文本 (属性项JSON ("max_items", "integer", "最大元素数(默认200,上限500)") + "," + 属性项JSON ("include_links", "text", "false/0=排除链接(默认true)") + "," + 属性项JSON ("text_length", "integer", "单元素文本截断长度(默认80)"), ""))
        添加工具JSON ("browser_click_text", "AI点击: 按可见文本点击元素。自动匹配textContent精确/包含该文本的button/a/span/div/li等元素, 优先精确匹配, 模拟真实点击事件链(mousedown/mouseup/click)。适合快照后按文字操作, 无需手写选择器", 多属性Schema文本 (属性项JSON ("text", "text", "要点击的可见文本(精确或部分匹配)") + "," + 属性项JSON ("selector", "text", "限定范围CSS选择器(可选, 仅在范围内查找)") + "," + 属性项JSON ("index", "integer", "多匹配时选第几个(默认0=第一个)") + "," + 属性项JSON ("exact", "boolean", "仅精确匹配(默认false)"), "\"text\""))
        添加工具JSON ("browser_get_forms", "AI表单枚举: 列出页面全部表单及其字段(name/type/value/placeholder/required/选择器)。填表前先调用本工具了解字段结构, 配合browser_fill_form一键填写", 单参数Schema文本 ("form_index", "integer", "只枚举第N个表单(默认全部)", 假))
        // v2.8.1 UX2: 滚动控制 (AI翻页采集核心)
        添加工具JSON ("browser_get_scroll", "AI滚动: 获取页面当前滚动位置(x/y)与最大可滚动范围(max_x/max_y)——判断是否到底、翻页采集进度", 单参数Schema文本 ("selector", "text", "指定滚动容器(默认window)", 假))
        // v2.8.1 DBG: 断点管理 + 批量Hook + 调用栈
        // v2.8.1 UX3: 快照索引闭环
        添加工具JSON ("browser_element_action", "AI操作: 按browser_snapshot返回的索引直接操作元素(点击/设值/聚焦/滚动/取值)。snapshot会为每个元素注入唯一data-mcp-id标记, 无需手写CSS选择器——AI操作页面元素的最高成功率方式。注意: 页面刷新后索引失效, 需重新snapshot", 多属性Schema文本 (属性项JSON ("index", "integer", "快照元素索引(snapshot返回的i字段)") + "," + 属性项JSON ("action", "text", "click(默认)/set_value/focus/scroll/get_value") + "," + 属性项JSON ("value", "text", "set_value时的值"), "\"index\""))
        添加工具JSON ("browser_debugger_list_breakpoints", "断点管理: 列出当前会话通过browser_debugger_set_breakpoint设置的全部断点(位置与CDP断点ID)——管理断点状态, 避免重复设置", 空Schema文本 ())
        添加工具JSON ("browser_debugger_clear_breakpoints", "断点管理: 逐个移除全部已记录断点(Debugger.removeBreakpoint)并清空注册表。返回移除成功/失败数; 页面仍暂停时需先debugger_resume", 空Schema文本 ())
        添加工具JSON ("browser_reverse_hook_multi", "Hook逆向: 批量函数Hook。一次包装多个函数(支持obj.fn点路径), 统一记录参数/返回值/异常到__MCP_HOOK_LOG__(经browser_reverse_hook_logs查询)——同时观察加密函数簇的调用关系", 多属性Schema文本 (属性项JSON ("functions", "text", "JSON数组字符串, 例:[sign,utils.md5,enc.aesEncrypt]") + "," + 属性项JSON ("capture_args", "boolean", "捕获参数(默认true)"), "\"functions\""))
        添加工具JSON ("browser_reverse_stack_trace", "逆向定位: 当前JS调用栈快照(Error().stack, 截断4000字符)——无需断点即可观察调用链路, 配合reverse_hook定位调用源", 空Schema文本 ())
        添加工具JSON ("browser_scroll_by", "AI滚动: 按像素增量滚动页面(x水平/y垂直, 正数向右/下)。配合browser_get_scroll实现翻页采集: 滚动→等待→采集→重复", 多属性Schema文本 (属性项JSON ("x", "integer", "水平增量像素(默认0)") + "," + 属性项JSON ("y", "integer", "垂直增量像素(默认800)") + "," + 属性项JSON ("smooth", "boolean", "平滑滚动(默认false)"), ""))
        添加工具JSON ("browser_highlight", "AI高亮: 页面上高亮显示指定选择器匹配的元素(红色虚线边框+半透明背景), 便于肉眼确认目标元素。action=show显示(默认), action=clear清除全部高亮", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器(show时必填)") + "," + 属性项JSON ("action", "text", "show(默认)/clear") + "," + 属性项JSON ("duration_ms", "integer", "自动清除延迟毫秒(默认3000, 0=不自动清除)"), ""))
        // v2.8.1 R: 逆向定位/解密 (内核JS通道同步返回)
        添加工具JSON ("browser_reverse_scan_crypto", "逆向定位: 加密算法特征扫描。扫描全部已加载脚本, 识别MD5(常量0x67452301)/AES(S-box)/SHA(初始向量)/CryptoJS/自定义base64编码表/RSA特征, 返回每个命中脚本的特征清单——快速判断sign/token用的什么算法", 多属性Schema文本 (属性项JSON ("script_index", "integer", "只扫描第N个脚本(默认全部)"), ""))
        添加工具JSON ("browser_reverse_string_refs", "逆向定位: 字符串引用定位。在全部脚本中搜索指定字符串(密钥/常量/特征串), 返回每个出现位置的脚本/行号/前后各100字符上下文——快速定位密钥在哪被使用", 多属性Schema文本 (属性项JSON ("value", "text", "要定位的字符串") + "," + 属性项JSON ("max_results", "integer", "最大结果数(默认20,上限50)"), "\"value\""))
        添加工具JSON ("browser_reverse_detect_obfuscator", "逆向解密: 混淆器类型识别。检测obfuscator.io(_0x十六进制数组)/JsJiami/sojson/JSVMP大switch状态机/自定义编码表/十六进制字符串数组特征, 给出置信度——选择正确的反混淆策略", 单参数Schema文本 ("script_index", "integer", "只检测第N个脚本(默认全部)", 假))
        添加工具JSON ("browser_reverse_hook_logs", "逆向解密: Hook日志查询。读取全部Hook日志(函数Hook/eval_dynamic/websocket/cookie_set)。**不传log_key时自动探测全部日志键并合并**, 返回by_key给出各键条数; 传log_key则只读该键。action=query查询(默认, 每键最近200条)/clear清空(原地截断, 不会让已安装的Hook失效)", 多属性Schema文本 (属性项JSON ("log_key", "text", "可选, 指定单个日志键: __MCP_HOOK_LOG__(函数Hook默认写这里)/__MCP_EVAL_LOG__/__MCP_WS_LOG__/__MCP_COOKIE_LOG__; 省略则自动全部合并") + "," + 属性项JSON ("action", "text", "query(默认)/clear"), ""))
        添加工具JSON ("browser_reverse_instrument_script", "V8插装(拆打包器核心): Debugger.setInstrumentationBreakpoint在**每个脚本执行之前**暂停——脚本还没跑、反调试还没生效时就能拿到原始源码与首次解包结果, 是JSVMP/打包器/反调试页面首选的介入点。action=install/remove/suppress(插装保留但不再拦截, 本机止血用), event=beforeScriptExecution(默认)/beforeScriptWithSourceMapExecution。需先browser_debugger_enable(未启用会自动启用并上报)。⚠ 实测更正(本机CEF构建): 装上后本会话的 **JS 通道即被阻塞** —— browser_execute_js / browser_debugger_last_paused 等会 30s 超时(browser_status 仍正常, 它走原生不经 CDP)。**根因已测清**: 本项目的 JS 通道就是 Runtime.evaluate(它本身就是一次脚本执行), 而被装上的插装正是拦「执行脚本」的 -> 请求被自己的插装拦住并暂停, 那条 CDP 请求永不返回, 单条队列随之被占。**注意: 这不是自检探针造成的** —— 实测把自检关掉(verify:false)装入后**同样卡死**, 卡死来自「装上插装」本身。**恢复办法(三条逐一实测)**: `action=suppress` **可以**恢复(约 45s, 走项目既有的卡死自救: 超时->自动 resume->重试一次; 客户端请留足 60s 超时), 而 browser_debugger_resume 与 browser_debugger_disable **都不能**恢复; 重启也可以但没必要。原来的「分析完务必 resume」在本机不成立, 已按实测更正。故使用本工具时请**准备好随后 action=suppress 止血**; 只是读取源码请改用 browser_reverse_search_script / browser_reverse_detect_traps", 多属性Schema文本 (属性项JSON ("action", "text", "install(默认)/remove/suppress(不卸载但停止拦截)") + "," + 属性项JSON ("event", "text", "beforeScriptExecution(默认)/beforeScriptWithSourceMapExecution"), ""))
        添加工具JSON ("browser_reverse_pause_on_exceptions", "异常暂停: Debugger.setPauseOnExceptions。混淆代码常把异常当流程控制或吞异常做反调试——抓\"被抛出的那一刻现场\"是定位内部逻辑的捷径, 配合browser_reverse_async_stack可得完整异步链路。state=none(关闭)/uncaught/caught(默认)/all", 多属性Schema文本 (属性项JSON ("state", "text", "none=关闭/uncaught=仅未捕获/caught=捕获+未捕获(默认)/all=全部暂停"), ""))
        添加工具JSON ("browser_reverse_blackbox", "V8黑盒(降噪): Debugger.setBlackboxPatterns。命中断点时不再进入匹配的脚本——把jquery/analytics/反调试库黑盒掉, 断点只停在目标业务代码。patterns为正则数组, 例:[\".*jquery.*\",\".*analytics.*\"]; 省略或空数组=清除黑盒", 多属性Schema文本 (属性项JSON ("patterns", "text", "JSON数组字符串, 元素为正则, 例: [\".*jquery.*\",\".*analytics.*\"]; 空=清除"), ""))
        添加工具JSON ("browser_reverse_async_stack", "V8异步栈: Debugger.setAsyncCallStackDepth。让断点/异常携带完整async链路——混淆代码把Promise/setTimeout链路打散后, 只有它能还原到底是谁调用了加密函数。depth缺省32, 显式0=关闭", 多属性Schema文本 (属性项JSON ("depth", "integer", "最大深度(缺省32, 显式0=关闭, 上限512)"), ""))
        添加工具JSON ("browser_reverse_breakpoints_active", "断点总开关: Debugger.setBreakpointsActive。保留断点定义但不命中——跑完整流程时临时静音, 需要时一键恢复, 免去逐个删/加断点", 多属性Schema文本 (属性项JSON ("active", "boolean", "true(默认)=启用命中, false=静音"), ""))
        添加工具JSON ("browser_reverse_skip_pauses", "应急开关: Debugger.setSkipAllPauses。跳过全部暂停, 用于防止页面被断点/大批量插装卡死; 批量插装脚本时先跳过再逐个放行", 多属性Schema文本 (属性项JSON ("skip", "boolean", "true(默认)=跳过全部暂停, false=恢复"), ""))
        添加工具JSON ("browser_reverse_precise_coverage", "混淆定位利器: Profiler精确覆盖率插装(含调用次数)。故意看不懂的混淆代码, 让它跑一遍, V8直接告诉你哪些函数被执行了几次——从几十万行混淆里定位真实执行路径最快的手段。流程: start→触发目标逻辑(登录/验签)→take, cdp_result里count>0的函数即真实执行过", 多属性Schema文本 (属性项JSON ("action", "text", "start(开启,记调用次数)/take(取数)/stop(停止); 默认take"), ""))
        添加工具JSON ("browser_reverse_patch", "脚本热补丁: Debugger.setScriptSource。运行中替换已加载脚本源码(V8层生效, 无需刷新页面)——验签/风控逻辑的活体改写。建议先dry_run:true验证新源码能编译再实改。**script_id可省略**(自动选字节最大的脚本并报告选中项)", 多属性Schema文本 (属性项JSON ("source", "text", "替换后的完整脚本源码") + "," + 属性项JSON ("script_id", "text", "CDP scriptId(可省略=自动选最大脚本)") + "," + 属性项JSON ("dry_run", "boolean", "只验证能否编译不实际替换(默认false)"), "\"source\""))
        添加工具JSON ("browser_reverse_return_value", "断点处篡改返回值: Debugger.setReturnValue。页面暂停时直接把当前函数返回值改成指定值——改验签结果/绕过校验的最短路径。value必须是合法JSON字面量(true/0/\"ok\"/{\"code\":0})。需页面处于Debugger.paused; 之后用browser_debugger_resume继续", 多属性Schema文本 (属性项JSON ("value", "text", "新返回值, 合法JSON字面量, 例: true / 0 / \"ok\" / {\"code\":0}"), "\"value\""))
        添加工具JSON ("browser_reverse_set_variable", "断点处改变量: Debugger.setVariableValue。暂停时改参数或中间变量(如把校验标志位调成true), 配合reverse_return_value完成活体篡改。call_frame_id省略时自动取最近一次暂停的顶层帧。需页面处于Debugger.paused", 多属性Schema文本 (属性项JSON ("variable_name", "text", "要改的变量名") + "," + 属性项JSON ("value", "text", "新值, 合法JSON字面量, 例: true / 0 / \"ok\"") + "," + 属性项JSON ("call_frame_id", "text", "调用帧ID(省略=自动取最近暂停帧)") + "," + 属性项JSON ("scope_number", "integer", "作用域序号(默认0=最内层)"), "\"variable_name\",\"value\""))
        添加工具JSON ("browser_reverse_search_script", "V8全脚本检索(混淆定位主力): Debugger.searchInContent在V8自己的脚本对象里搜, 覆盖eval/blob:/Worker/动态创建脚本, 比只扫<script>标签的browser_reverse_search彻底。action=search(默认, 需query)/list(列已注册脚本及scriptId)/clear(清空注册表)。**无需任何前置调用**——注册表为空时会自动启用调试器并等待脚本上报", 多属性Schema文本 (属性项JSON ("action", "text", "search(默认)/list/clear") + "," + 属性项JSON ("query", "text", "搜索串(action=search时必填, 如 sign/encrypt/密钥)") + "," + 属性项JSON ("url_filter", "text", "只搜URL含该片段的脚本(可选)") + "," + 属性项JSON ("max_scripts", "integer", "最多扫描脚本数(默认40, 上限200)"), ""))
        添加工具JSON ("browser_reverse_get_possible_breakpoints", "混淆定点下断: Debugger.getPossibleBreakpoints。obfuscator.io/JSFuck常把整包压成一行, 按行下断会因\"该行无有效位置\"失败——本工具列出该脚本真正可下断的精确行/列, 拿到后再用browser_debugger_set_breakpoint下断。**script_id可省略**(自动选字节最大的脚本并在回复里报告选中项)", 多属性Schema文本 (属性项JSON ("script_id", "text", "CDP scriptId(可省略=自动选最大脚本; 要指定则用browser_reverse_search_script action=list查)") + "," + 属性项JSON ("line", "integer", "起始行(0起算, 默认0)") + "," + 属性项JSON ("end_line", "integer", "结束行(缺省=起始+200)") + "," + 属性项JSON ("restrict_to_function", "boolean", "只返回函数边界内的可断点(默认false)"), ""))
        添加工具JSON ("browser_reverse_add_binding", "原生桥接(防检测): Runtime.addBinding。装一个由内核提供的函数供页面JS直接调用——不改任何JS对象、fn.toString也查不出, 比包装JS函数更隐蔽, 适合防检测环境下回传日志", 多属性Schema文本 (属性项JSON ("name", "text", "绑定的函数名, 如 __mcp_send") + "," + 属性项JSON ("execution_context_name", "text", "限定生效的执行上下文名(可选)"), "\"name\""))
        添加工具JSON ("browser_reverse_listeners", "监听器取证: DOMDebugger.getEventListeners。反调试/风控常靠事件监听器(keydown/mousemove检测自动化, beforeunload阻断跳转)——本工具列出目标对象真实挂载的监听器(含handler源码与位置), 是拆这些陷阱的入口。传selector或object_id", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器, 如 #app; 也支持 document/window/body") + "," + 属性项JSON ("object_id", "text", "CDP objectId(优先于selector; 可用browser_reverse_dom_resolve取)") + "," + 属性项JSON ("depth", "integer", "递归深度(默认1, 上限5)") + "," + 属性项JSON ("pierce", "boolean", "穿透shadow DOM(默认true)"), ""))
        添加工具JSON ("browser_reverse_dom_resolve", "取objectId(公共入口): 把selector/expression求值成CDP objectId, 并顺带列出该对象的自有属性。所有需要object_id的能力(listeners/query_objects/await_promise/call_fn)都可用它取句柄", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器, 如 #app") + "," + 属性项JSON ("expression", "text", "JS表达式(优先于selector), 如 window.someObj"), ""))
        添加工具JSON ("browser_reverse_query_objects", "找全部实例: Runtime.queryObjects。混淆代码里\"哪个类负责加密\"很难静态判断——已知一个原型(如 CryptoJS.AES.prototype)就能一次列出运行时所有存活实例", 多属性Schema文本 (属性项JSON ("prototype_expression", "text", "原型表达式, 如 window.CryptoJS.AES.prototype") + "," + 属性项JSON ("prototype_object_id", "text", "原型的CDP objectId(优先于expression)"), ""))
        添加工具JSON ("browser_reverse_compile_script", "编译不执行: Runtime.compileScript。热补丁前校验候选源码能否编译(语法错误直接暴露), 也可预热脚本便于后续下断", 多属性Schema文本 (属性项JSON ("source", "text", "要编译的脚本源码") + "," + 属性项JSON ("url", "text", "sourceURL(默认 mcp://compiled)") + "," + 属性项JSON ("persist", "boolean", "保留脚本引用(默认false)"), "\"source\""))
        添加工具JSON ("browser_reverse_bypass_csp", "绕过CSP: Page.setBypassCSP。混淆/加固页面常用CSP挡住注入脚本与eval, 导致插装/preload全部失效——打开旁路是让后续注入生效的前置开关(需重新导航才对本次加载生效)", 多属性Schema文本 (属性项JSON ("enable", "boolean", "true(默认)=绕过, false=恢复"), ""))
        添加工具JSON ("browser_reverse_cache_disable", "缓存总开关: Network.setCacheDisabled。改过脚本/资源后必须让页面重新拉取才看得到效果; 排查缓存投毒/旧版本脚本也靠它", 多属性Schema文本 (属性项JSON ("disable", "boolean", "true(默认)=禁用缓存, false=恢复"), ""))
        添加工具JSON ("browser_reverse_network_conditions", "网络条件仿真: Network.emulateNetworkConditions。复现弱网/断网/高延迟(只改渲染进程的网络体感, 不动系统网卡与代理), 排查本地很快但用户端超时的问题。CDP硬约束: latency/downloadThroughput/uploadThroughput 三项必须同时给出, -1 表示该方向不限速(本工具已自动补齐三项)", 多属性Schema文本 (属性项JSON ("offline", "boolean", "断网(默认false)") + "," + 属性项JSON ("latency", "integer", "额外延迟ms(默认0)") + "," + 属性项JSON ("download_throughput", "integer", "下行字节/秒; -1=不限速(默认-1)") + "," + 属性项JSON ("upload_throughput", "integer", "上行字节/秒; -1=不限速(默认-1)"), ""))
        添加工具JSON ("browser_reverse_emulate_focus", "焦点仿真: Emulation.setFocusEmulationEnabled。让页面始终认为窗口处于聚焦状态——后台/最小化时页面会因 blur 暂停 rAF 与定时器、甚至降级混淆逻辑, 打开后这类环境相关行为才与前台一致", 多属性Schema文本 (属性项JSON ("enabled", "boolean", "true(默认)=开启焦点仿真, false=恢复真实焦点"), ""))
        添加工具JSON ("browser_reverse_cookie_cdp", "Cookie 直读: Storage.getCookies / Network.getCookies。不传 urls 取浏览器上下文全部 Cookie(含 httpOnly); 传 urls(逗号分隔)只取这些 URL 会带上的 Cookie。走 CDP 读的是内核真实 cookie 库, 不依赖页面上下文", 多属性Schema文本 (属性项JSON ("urls", "text", "逗号分隔URL(可选, 例: https://a.com,https://b.com); 省略=全部Cookie"), ""))
        添加工具JSON ("browser_reverse_css_coverage", "CSS 规则覆盖率: start/take/stop 三段式。反查哪些样式规则从未命中——用于裁剪混淆样式表, 也能反推某元素到底由哪条规则在起作用", 多属性Schema文本 (属性项JSON ("action", "text", "start(开始)/take(取增量)/stop(结束并汇总); 默认start"), ""))
        添加工具JSON ("browser_reverse_trace", "Chrome trace: Tracing.start/end。拿内核级时间线(渲染/合成/脚本/V8), 回答这段时间到底卡在哪。**注意**: trace 数据以 Tracing.dataCollected 事件内联返回, 故建议先 action=start 之前用 browser_kernel_cdp_monitor 加规则 Tracing.* , 否则采集完拿不回数据", 多属性Schema文本 (属性项JSON ("action", "text", "start(默认)/end") + "," + 属性项JSON ("categories", "text", "trace类别(默认 -* 采集全部默认类别)"), ""))
        添加工具JSON ("browser_reverse_layer_tree", "合成层诊断: LayerTree.enable/disable。元素为什么不合成、为什么掉帧的最终判据——开启后内核推送 LayerTree.layerTreeDidChange, 可看到层数量与合成原因(如 transform/opacity 未提升为合成层)", 多属性Schema文本 (属性项JSON ("enabled", "boolean", "true(默认)=开启上报, false=关闭(持续上报有开销)"), ""))
        添加工具JSON ("browser_reverse_input_cdp", "底层 Input 域派发: 直发 CDP 原始输入事件, 比坐标点击更可控、不受 UI 命中与遮挡影响。kind=mouse/touch/key; 鼠标与触摸复用项目内已验证的 CDP 派发(自动处理触摸仿真与按下态, 不破坏 CDP 会话), 键盘直发 Input.dispatchKeyEvent", 多属性Schema文本 (属性项JSON ("kind", "text", "mouse(默认)/touch/key") + "," + 属性项JSON ("type", "text", "mouse: mouseMoved(默认)/mousePressed/mouseReleased/mouseWheel; touch: touchStart(默认)/touchMove/touchEnd/touchCancel; key: keyDown(默认)/keyUp/char/rawKeyDown") + "," + 属性项JSON ("x", "integer", "X坐标") + "," + 属性项JSON ("y", "integer", "Y坐标") + "," + 属性项JSON ("button", "text", "鼠标按键 left/right/middle(默认left)") + "," + 属性项JSON ("delta_x", "integer", "mouseWheel横向增量") + "," + 属性项JSON ("delta_y", "integer", "mouseWheel纵向增量") + "," + 属性项JSON ("key", "text", "key事件: 键名(如 Enter / a)") + "," + 属性项JSON ("windows_virtual_key_code", "integer", "key事件: 虚拟键码") + "," + 属性项JSON ("text", "text", "key事件: type=char 时要输入的字符"), ""))
        添加工具JSON ("browser_reverse_detect_traps", "反调试/风控陷阱检测(只检测布置了哪些陷阱, 不绕过): 在 V8 已加载的脚本里逐类检索 7 类常见反调试特征——debugger语句 / Function.prototype.toString 重写 / console 探测 / performance.now 时序检测 / setInterval 定时自陷 / navigator.webdriver 自动化探测 / devtools 探测, 每类给出命中数与命中行号及结论。**script_id 可省略**(自动选字节最大的脚本, 注册表为空时自动启用调试器等待上报)", 多属性Schema文本 (属性项JSON ("script_id", "text", "CDP scriptId(可省略=自动选最大脚本)") + "," + 属性项JSON ("classes", "text", "只检测指定类别, 逗号分隔, 可选: debugger_stmt/tostring_hook/console_hook/timing_check/timer_debugger/automation_detect/devtools_probe(省略=全部)") + "," + 属性项JSON ("max_hits", "integer", "每类最多列出的命中行号数(默认5, 上限50)"), ""))
        添加工具JSON ("browser_reverse_evaluate_silent", "静默求值: Runtime.evaluate(silent)。silent让求值不触发断点/异常暂停、不污染控制台——在已插装/已下断点的页面上继续取数据而不惊动调试状态, 也避免被console副作用检测发现", 多属性Schema文本 (属性项JSON ("expression", "text", "JS表达式") + "," + 属性项JSON ("silent", "boolean", "不触发断点/不写控制台(默认true)") + "," + 属性项JSON ("user_gesture", "boolean", "带用户手势(默认true, 绕过需手势的限制)") + "," + 属性项JSON ("await_promise", "boolean", "等待Promise结果(默认false)") + "," + 属性项JSON ("return_by_value", "boolean", "按值返回(默认true)"), "\"expression\""))
        添加工具JSON ("browser_reverse_await_promise", "等Promise结果: Runtime.awaitPromise。异步加密/验签拿不到返回值时, 先求值出Promise句柄再让它resolve出结果(被拒绝会返回exceptionDetails, 不是工具失败)", 多属性Schema文本 (属性项JSON ("expression", "text", "返回Promise的表达式, 如 fetch('/api').then(r=>r.json())") + "," + 属性项JSON ("promise_object_id", "text", "Promise的CDP objectId(优先于expression)") + "," + 属性项JSON ("return_by_value", "boolean", "按值返回(默认true)"), ""))
        添加工具JSON ("browser_fill_form", "AI一键填表: 按字段清单批量填写表单。fields为JSON数组[{selector,value},...], 逐个用原生填表框架置入内容并模拟输入事件, 返回每字段成败。配合browser_get_forms使用", 多属性Schema文本 (属性项JSON ("fields", "text", "JSON数组字符串, 例: [{selector:#name,value:张三},{selector:#pwd,value:123}]") + "," + 属性项JSON ("submit", "boolean", "填完后自动提交表单(默认false)"), "\"fields\""))
        // CDP调试 (VIP)
        // 网络抓包
        // v1.7 新增
    }

    # ======== Schema 构建辅助 (纯文本拼接 — 规避 yyjson 嵌套崩溃, 见 L6) ==========
    # L6: YYJSON对象类.加入成员/加入数组成员 嵌套多层会触发 0xC0000005,
    #      工具列表/MCP响应一律用 文本拼接 + 构建任务查询结果JSON 等 helper.
    # 所有函数返回 JSON 文本片段, 由 填充工具列表() 组装为最终数组

    变量 工具列表构建缓冲区 <公开 静态 类型 = 文本型 值 = "" @输出名 = "ToolListBuildBuffer">
    # 精简工具清单缓冲 (与 工具列表构建缓冲区 同一次遍历产出, 仅 name + 一行摘要)
    # 目的: /tools/list 实测 72735 字节(≈21672 token)且每次对话都要注入;
    #       精简版供 AI 代理在上下文紧张时"先拿清单 → mcp_help <tool> 按需取详情"。
    变量 工具简表构建缓冲区 <公开 静态 类型 = 文本型 值 = "" @输出名 = "ToolBriefBuildBuffer">

    方法 开始构建工具列表 <公开 静态 @输出名 = "StartBuildToolList" @强制输出 = 真>
    {
        工具列表构建缓冲区 = "["
        工具简表构建缓冲区 = "["
        工具构建计数 = 0
    }

    # 从工具描述里取"一行摘要": 在首个句读/分隔符处截断, 并限长 60 字
    方法 取简述文本 <公开 静态 类型 = 文本型 @输出名 = "BriefSummaryText" @强制输出 = 真>
    参数 描述 <类型 = 文本型 @输出名 = "Description">
    {
        变量 结果 <类型 = 文本型>
        结果 = 描述
        变量 切点 <类型 = 整数>
        切点 = -1
        变量 p <类型 = 整数>
        p = 寻找文本 (结果, "。", 0, 假)
        如果 (p != -1)
        {
            切点 = p
        }
        p = 寻找文本 (结果, "|", 0, 假)
        如果 (p != -1 && (切点 == -1 || p < 切点))
        {
            切点 = p
        }
        p = 寻找文本 (结果, "（", 0, 假)
        如果 (p != -1 && (切点 == -1 || p < 切点))
        {
            切点 = p
        }
        p = 寻找文本 (结果, "\r\n", 0, 假)
        如果 (p != -1 && (切点 == -1 || p < 切点))
        {
            切点 = p
        }
        如果 (切点 > 0)
        {
            结果 = 取文本左边 (结果, 切点)
        }
        如果 (取文本长度 (结果) > 60)
        {
            结果 = 取文本左边 (结果, 60) + "…"
        }
        返回 (结果)
    }

    方法 添加工具JSON <公开 静态 @输出名 = "AddToolJSON" @强制输出 = 真>
    参数 名称 <类型 = 文本型 @输出名 = "Name">
    参数 描述 <类型 = 文本型 @输出名 = "Description">
    参数 schemaJSON <类型 = 文本型 @默认值 = "\"inputSchema\":{\"type\":\"object\"}" @输出名 = "SchemaJSON">
    {
        如果 (工具列表构建缓冲区 != "[")
        {
            工具列表构建缓冲区 = 工具列表构建缓冲区 + ","
        }
        // 修复(运行时): 描述/名称 JSON 转义, 防描述含引号(如 [\"a\",\"b\"]) 生成非法 tools/list JSON
        工具列表构建缓冲区 = 工具列表构建缓冲区 + "{\"name\":\"" + MCP_响应构建.JSON转义文本 (名称) + "\",\"description\":\"" + MCP_响应构建.JSON转义文本 (描述) + "\"," + schemaJSON + "}"
        // 同一次遍历产出精简清单条目 (name + 一行摘要), 供 /tools/brief 使用
        如果 (工具简表构建缓冲区 != "[")
        {
            工具简表构建缓冲区 = 工具简表构建缓冲区 + ","
        }
        工具简表构建缓冲区 = 工具简表构建缓冲区 + "{\"name\":\"" + MCP_响应构建.JSON转义文本 (名称) + "\",\"s\":\"" + MCP_响应构建.JSON转义文本 (取简述文本 (描述)) + "\"}"
        工具构建计数 = 工具构建计数 + 1
    }

    方法 完成构建工具列表 <公开 静态 类型 = 文本型 @输出名 = "DoneBuildToolList" @强制输出 = 真>
    {
        工具列表构建缓冲区 = 工具列表构建缓冲区 + "]"
        工具简表构建缓冲区 = 工具简表构建缓冲区 + "]"
        工具总数 = 工具构建计数
        返回 (工具列表构建缓冲区)
    }

    # 取单个工具的完整 JSON 条目 (name + description + inputSchema), 供 mcp_help <tool> 深链使用
    # 实现: 在 工具列表缓存 里按 `{"name":"<tool>",` 定位, 到下一个 `},{"name":"` 或数组末尾为止。
    # 安全性: 描述与 schema 均经 JSON转义文本 处理, 转义后的 `},{"name":"` 形如 },{\"name\":\"
    #         (带反斜杠), 故该裸序列**不可能**出现在被转义的字符串内部, 切分不会越界/截错。
    方法 取工具详情JSON <公开 静态 类型 = 文本型 @输出名 = "GetToolDetailJSON" @强制输出 = 真>
    参数 工具名 <类型 = 文本型 @输出名 = "ToolName">
    {
        如果 (工具名 == "")
        {
            返回 ("")
        }
        协议锁.加锁 ()
        如果 (工具列表缓存 == "")
        {
            开始构建工具列表 ()
            填充工具列表 ()
            工具列表缓存 = "{\"tools\":" + 完成构建工具列表 () + "}"
        }
        变量 详情 <类型 = 文本型>
        详情 = ""
        变量 锚点 <类型 = 文本型>
        锚点 = "{\"name\":\"" + MCP_响应构建.JSON转义文本 (工具名) + "\","
        变量 起点 <类型 = 整数>
        起点 = 寻找文本 (工具列表缓存, 锚点, 0, 假)
        如果 (起点 != -1)
        {
            变量 内容起 <类型 = 整数>
            内容起 = 起点 + 取文本长度 (锚点)
            // 从 "name" 值之后找本条目结束: 下一个条目起点或数组结尾
            变量 下一段 <类型 = 整数>
            下一段 = 寻找文本 (工具列表缓存, "},{\"name\":\"", 内容起, 假)
            如果 (下一段 == -1)
            {
                下一段 = 倒找文本 (工具列表缓存, "]}", , 假)
            }
            如果 (下一段 == -1 || 下一段 <= 内容起)
            {
                下一段 = 取文本长度 (工具列表缓存)
            }
            // 起点回退到条目开头, 终点含条目自身的闭合 '}'
            详情 = 取文本中间 (工具列表缓存, 起点, 下一段 - 起点 + 1)
            如果 (是否以 (详情, "{") == 假)
            {
                详情 = ""
            }
        }
        协议锁.解锁 ()
        返回 (详情)
    }

    # 工具名前缀补全 (MCP completion/complete 能力)
    # 从 工具列表缓存 里扫描 `{"name":"<前缀>...` 提取候选名, 去重后最多返回 20 条。
    # 复用 取工具详情JSON 的切分前提: 描述与 schema 均经 JSON转义, 裸 `{"name":"` 只出现在条目开头。
    方法 搜索工具名补全 <公开 静态 类型 = 文本型 @输出名 = "SearchToolNameCompletion" @强制输出 = 真>
    参数 前缀 <类型 = 文本型 @输出名 = "Prefix">
    {
        如果 (工具列表缓存 == "")
        {
            开始构建工具列表 ()
            填充工具列表 ()
            工具列表缓存 = "{\"tools\":" + 完成构建工具列表 () + "}"
        }
        变量 结果 <类型 = 文本型>
        结果 = "["
        变量 已加 <类型 = 整数>
        已加 = 0
        变量 游标 <类型 = 整数>
        游标 = 0
        变量 锚点长 <类型 = 整数>
        锚点长 = 取文本长度 ("{\"name\":\"")
        判断循环 (已加 < 20)
        {
            变量 位置 <类型 = 整数>
            位置 = 寻找文本 (工具列表缓存, "{\"name\":\"", 游标, 假)
            如果 (位置 == -1)
            {
                跳出循环
            }
            变量 名起 <类型 = 整数>
            名起 = 位置 + 锚点长
            变量 名止 <类型 = 整数>
            名止 = 寻找文本 (工具列表缓存, "\"", 名起, 假)
            如果 (名止 == -1)
            {
                跳出循环
            }
            变量 名 <类型 = 文本型>
            名 = 取文本中间 (工具列表缓存, 名起, 名止 - 名起)
            游标 = 名止 + 1
            如果 (名 == "")
            {
                到循环尾
            }
            如果 (前缀 != "" && 寻找文本 (名, 前缀, 0, 假) != 0)
            {
                到循环尾
            }
            如果 (已加 > 0)
            {
                结果 = 结果 + ","
            }
            结果 = 结果 + "\"" + MCP_响应构建.JSON转义文本 (名) + "\""
            已加 = 已加 + 1
        }
        结果 = 结果 + "]"
        返回 (结果)
    }

    # 精简工具清单 (与 /tools/list 同源同一次遍历产出, 仅 name + 一行摘要)
    # 实测 /tools/list = 72735 字节(≈21672 token), 每次对话都要注入 AI 上下文;
    # 精简版约 1/5, 支持"先拿清单 → mcp_help <tool> 按需取详情"两段式调用。
    方法 取精简工具列表 <公开 静态 类型 = 文本型 @输出名 = "GetBriefToolList" @强制输出 = 真>
    {
        // 重建路径纳入协议锁: 构建缓冲区是共享静态, HTTP/WS/stdio 多线程并发交错会写坏 JSON
        // (互斥锁类可重入, 调用方已持锁时再取一次无副作用)
        协议锁.加锁 ()
        如果 (工具列表缓存 == "" || 工具简表构建缓冲区 == "")
        {
            开始构建工具列表 ()
            填充工具列表 ()
            工具列表缓存 = "{\"tools\":" + 完成构建工具列表 () + "}"
        }
        变量 结果 <类型 = 文本型>
        结果 = "{\"tools\":" + 工具简表构建缓冲区 + ",\"usage\":\"s=一行摘要; 需要完整描述与参数 schema 时调 mcp_help {\\\"tool\\\":\\\"<name>\\\"} 或取 /tools/list\"}"
        协议锁.解锁 ()
        返回 (结果)
    }

    方法 空Schema文本 <公开 静态 类型 = 文本型 @输出名 = "EmptySchemaText" @强制输出 = 真>
    {
        返回 ("\"inputSchema\":{\"type\":\"object\"}")
    }

    方法 单参数Schema文本 <公开 静态 类型 = 文本型 @输出名 = "SingleParamSchemaText" @强制输出 = 真>
    参数 名 <类型 = 文本型 @输出名 = "Name">
    参数 类型 <类型 = 文本型 @输出名 = "Type">
    参数 描述 <类型 = 文本型 @输出名 = "Description">
    参数 必须 <类型 = 逻辑型 @默认值 = 真 @输出名 = "Must">
    {
        // 标准合规: 历史遗留类型名 "text" 不是 JSON Schema 合法类型, 统一映射为 "string" (Anthropic API 等严格校验会拒绝 type:"text")
        如果 (类型 == "text")
        {
            类型 = "string"
        }
        变量 s <类型 = 文本型>
        s = "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"" + MCP_响应构建.JSON转义文本 (名) + "\":{\"type\":\"" + MCP_响应构建.JSON转义文本 (类型) + "\",\"description\":\"" + MCP_响应构建.JSON转义文本 (描述) + "\"}}"
        如果 (必须)
        {
            s = s + ",\"required\":[\"" + 名 + "\"]"
        }
        s = s + "}"
        返回 (s)
    }

    方法 双XY_Schema文本 <公开 静态 类型 = 文本型 @输出名 = "DualXYSchemaText" @强制输出 = 真>
    参数 名1 <类型 = 文本型 @输出名 = "Name1">
    参数 名2 <类型 = 文本型 @输出名 = "Name2">
    参数 描述1 <类型 = 文本型 @输出名 = "Description1">
    参数 描述2 <类型 = 文本型 @输出名 = "Description2">
    {
        返回 ("\"inputSchema\":{\"type\":\"object\",\"properties\":{\"" + MCP_响应构建.JSON转义文本 (名1) + "\":{\"type\":\"integer\",\"description\":\"" + MCP_响应构建.JSON转义文本 (描述1) + "\"},\"" + MCP_响应构建.JSON转义文本 (名2) + "\":{\"type\":\"integer\",\"description\":\"" + MCP_响应构建.JSON转义文本 (描述2) + "\"}},\"required\":[\"" + MCP_响应构建.JSON转义文本 (名1) + "\",\"" + MCP_响应构建.JSON转义文本 (名2) + "\"]}")
    }

    方法 多属性Schema文本 <公开 静态 类型 = 文本型 @输出名 = "MultiAttributeSchemaText" @强制输出 = 真>
    参数 属性列表文本 <类型 = 文本型 @输出名 = "AttributeListText">
    参数 必需列表文本 <类型 = 文本型 @默认值 = "" @输出名 = "RequiredListText">
    {
        变量 s <类型 = 文本型>
        s = "\"inputSchema\":{\"type\":\"object\",\"properties\":{" + 属性列表文本 + "}"
        如果 (必需列表文本 != "")
        {
            s = s + ",\"required\":[" + 必需列表文本 + "]"
        }
        s = s + "}"
        返回 (s)
    }

    方法 属性项JSON <公开 静态 类型 = 文本型 @输出名 = "AttributeItemJSON" @强制输出 = 真>
    参数 名 <类型 = 文本型 @输出名 = "Name">
    参数 类型 <类型 = 文本型 @输出名 = "Type">
    参数 描述 <类型 = 文本型 @输出名 = "Description">
    {
        // 标准合规: 历史遗留类型名 "text" 不是 JSON Schema 合法类型, 统一映射为 "string" (Anthropic API 等严格校验会拒绝 type:"text")
        如果 (类型 == "text")
        {
            类型 = "string"
        }
        // 修复(运行时): 描述 JSON 转义(描述可能含引号如 [\"a\",\"b\"]), 防 tools/list 生成非法 JSON
        返回 ("\"" + MCP_响应构建.JSON转义文本 (名) + "\":{\"type\":\"" + MCP_响应构建.JSON转义文本 (类型) + "\",\"description\":\"" + MCP_响应构建.JSON转义文本 (描述) + "\"}")
    }

    # ======== MCP tools/call ==========

    方法 处理_工具调用 <公开 静态 类型 = 文本型 @输出名 = "HandleToolCall" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    参数 请求JSON <类型 = YYJSON只读对象类 @输出名 = "RequestJSON">
    {
        变量 参数对象 <类型 = YYJSON只读对象类>
        参数对象 = 请求JSON.取对象 ("params")
        变量 工具名 <类型 = 文本型>
        工具名 = ""
        如果 (参数对象.是否为空 () == 假)
        {
            工具名 = 参数对象.取文本 ("name")
        }
        如果 (工具名 == "")
        {
            返回 (构建JSONRPC响应 (请求ID, "", -32602, "缺少工具名: params.name 不能为空"))
        }
        控制台输出 (到文本 ("[MCP] 调用工具:") + 到文本 (工具名))
        // 提取 arguments
        变量 工具参数字典 <类型 = YYJSON只读对象类>
        如果 (参数对象.是否为空 () == 假)
        {
            变量 参数字符串 <类型 = 文本型>
            参数字符串 = yyjson取JSON文本 (参数对象, "arguments")
            如果 (参数字符串 == "")
            {
                参数字符串 = yyjson取文本 (参数对象, "arguments")
            }
            如果 (参数字符串 != "" && (是否以 (参数字符串, "{") || 是否以 (参数字符串, "[")))
            {
                如果 (工具参数字典.创建自文本 (参数字符串) == 假)
                {
                    控制台输出 (到文本 ("[MCP] tools/call arguments JSON解析失败, 原始文本长度:") + 到文本 (取文本长度 (参数字符串)))
                    返回 (构建JSONRPC响应 (请求ID, "", -32602, "arguments JSON解析失败 | 请确认JSON格式正确, key必须用双引号包裹 | 收到: " + 取文本左边 (参数字符串, 200)))
                }
            }
            否则
            {
                工具参数字典 = 参数对象.取对象 ("arguments")
            }
        }
        否则
        {
            工具参数字典.创建自文本 ("{}")
        }
        // 执行命令
        变量 命令结果JSON <类型 = 文本型>
        命令结果JSON = 执行浏览器命令 (请求ID, 工具名, 工具参数字典)
        命令结果JSON = 尝试同步跟随异步响应 (请求ID, 命令结果JSON, 工具名, 工具参数字典, 假)
        // 存储结果供异步查询
        如果 (请求ID != "")
        {
            存储任务结果 (请求ID, 命令结果JSON)
        }
        // 解析命令结果,提取 content
        变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (命令结果JSON) == 假)
        {
            返回 (构建JSONRPC响应 (请求ID, "", -32603, "结果解析失败: " + 工具名))
        }
        // MCP-4: 未知工具返回标准 -32601 错误码
        如果 (结果解析.取逻辑值 ("success") == 假)
        {
            变量 原始错误 <类型 = 文本型>
            原始错误 = yyjson取文本 (结果解析, "error")
            如果 (寻找文本 (原始错误, "未知命令", 0, 假) != -1)
            {
                返回 (构建JSONRPC响应 (请求ID, "", -32601, "工具不存在: " + 工具名))
            }
        }
        变量 是否成功 <类型 = 逻辑型>
        是否成功 = 结果解析.取逻辑值 ("success")
        // 异步结果: 将 _req_id 映射为 task_id, 确保客户端可用 _req_id 轮询 mcp_result
        变量 是否异步 <类型 = 逻辑型>
        是否异步 = 结果解析.取逻辑值 ("_async")
        变量 异步任务ID <类型 = 文本型>
        异步任务ID = ""
        如果 (是否异步)
        {
            异步任务ID = yyjson取文本 (结果解析, "task_id")
            如果 (异步任务ID != "")
            {
                当前请求追踪ID = 异步任务ID
            }
        }
        变量 内容文本 <类型 = 文本型>
        如果 (是否成功 == 假)
        {
            内容文本 = yyjson取文本 (结果解析, "error")
            如果 (内容文本 == "")
            {
                变量 failDataObj <类型 = YYJSON只读对象类>
                failDataObj = 结果解析.取对象 ("data")
                如果 (failDataObj.是否为空 () == 假)
                {
                    内容文本 = failDataObj.到可读文本 (YYJSON格式化选项.压缩)
                }
            }
            如果 (内容文本 == "")
            {
                内容文本 = "未知错误"
            }
        }
        否则
        {
            // 优先取工具映射的结果键名 (如 get_url→url, get_title→title), 确保结构化数据优先于message
            变量 优先键名 <类型 = 文本型>
            优先键名 = 取工具结果键名 (工具名)
            如果 (优先键名 != "" && 优先键名 != "result")
            {
                内容文本 = yyjson取文本 (结果解析, 优先键名)
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "result")
                如果 (内容文本 == "")
                {
                    // result字段可能是原始JSON对象(如console_eval),转为可读文本
                    变量 resultObj <类型 = YYJSON只读对象类>
                    resultObj = 结果解析.取对象 ("result")
                    如果 (resultObj.是否为空 () == 假)
                    {
                        内容文本 = resultObj.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
                如果 (内容文本 == "")
                {
                    变量 resultArr <类型 = YYJSON只读数组类>
                    resultArr = 结果解析.取数组 ("result")
                    如果 (resultArr.是否为空对象 () == 假)
                    {
                        内容文本 = resultArr.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "message")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "url")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "data")
                // data是对象/数组时无法取文本, 转为完整JSON字符串
                如果 (内容文本 == "")
                {
                    变量 dataObj <类型 = YYJSON只读对象类>
                    dataObj = 结果解析.取对象 ("data")
                    如果 (dataObj.是否为空 () == 假)
                    {
                        内容文本 = dataObj.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "title")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "source")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "text")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "cookies")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "browsers")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "html")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "frames")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "names")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "exists")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "value")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "help")
            }
            如果 (内容文本 == "")
            {
                变量 netLogsText <类型 = 文本型>
                netLogsText = yyjson取文本 (结果解析, "network_logs")
                如果 (netLogsText != "" && 是否以 (netLogsText, "["))
                {
                    内容文本 = 命令结果JSON
                }
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "network_logs")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "console_logs")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "fbro_version")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "zoom_level")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "hwnd")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "loading")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "muted")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "id")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "count")
            }
            如果 (内容文本 == "")
            {
                内容文本 = yyjson取文本 (结果解析, "can_go_back")
            }
            如果 (内容文本 == "")
            {
                // 所有文本字段均未命中: 直接将完整命令结果序列化为 content, 避免数据丢失
                内容文本 = 命令结果JSON
            }
        }
        // 异步工具: 在内容文本中附带task_id, 方便MCP客户端用mcp_result查询
        如果 (是否异步 && 异步任务ID != "")
        {
            内容文本 = 内容文本 + "\n\n[task_id: " + 异步任务ID + "]"
        }
        // 构建 MCP content response
        变量 内容数组 <类型 = YYJSON数组类>
        内容数组.创建自文本数据 (取空文本数组 ())
        变量 内容项 <类型 = YYJSON对象类>
        内容项.创建自文本 ("{}")
        内容项.加入文本成员 ("type", "text")
        内容项.加入文本成员 ("text", 内容文本)
        内容数组.加入成员 (内容项)
        变量 结果对象 <类型 = YYJSON对象类>
        结果对象.创建自文本 ("{}")
        结果对象.加入数组成员 ("content", 内容数组)
        如果 (是否成功 == 假)
        {
            结果对象.加入逻辑值成员 ("isError", 真)
        }
        // 异步响应元数据: LLM可据此立即用 task_id 轮询 mcp_result
        如果 (是否异步 && 异步任务ID != "")
        {
            结果对象.加入逻辑值成员 ("_async", 真)
            结果对象.加入文本成员 ("task_id", 异步任务ID)
        }
        返回 (构建JSONRPC响应 (请求ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ======== 命令执行核心 ==========

    方法 执行浏览器命令 <公开 静态 类型 = 文本型 @输出名 = "ExecuteBrowserCommand" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        MCP执行锁.加锁 ()
        // ② 方法名规范化前置: browser. → browser_ 统一在入口做一次, 省去各分派器重复替换
        子文本替换 (方法名, "browser.", "browser_", , , 假)
        // 保存外层命令上下文 (batch嵌套子命令时, 退出后还原, 防静态残留污染外层同步等待判定)
        变量 保存命令方法名 <类型 = 文本型>
        变量 保存命令参数JSON <类型 = YYJSON只读对象类>
        保存命令方法名 = 当前命令方法名
        保存命令参数JSON = 当前命令参数JSON
        当前命令方法名 = 方法名
        当前命令参数JSON = 参数JSON
        // 高频轮询工具(mcp_result)不打执行日志, 避免同步等待期间控制台刷屏
        如果 (方法名 != "mcp_result")
        {
            控制台输出 (到文本 ("[MCP] 执行:") + 到文本 (方法名))
        }
        变量 请求浏览器ID <类型 = 整数>
        变量 保存浏览器ID <类型 = 整数>
        请求浏览器ID = yyjson取整数 (参数JSON, "browser_id")
        保存浏览器ID = 目标浏览器ID
        目标浏览器ID = 请求浏览器ID
        // ① 前缀直投分派: 根据方法名前缀直接路由到对应分派器
        // fill_* → 填表 | vip_*/fingerprint_* → VIP | workflow* → 编排 | 特定系统命令 → 系统 | 默认 → 核心
        变量 result <类型 = 文本型>
        如果 (是否以 (方法名, "browser_fill_"))
        {
            result = MCP_填表分派.分类分派_填表操作 (命令ID, 方法名, 参数JSON)
        }
        否则 (是否以 (方法名, "browser_vip_") || 是否以 (方法名, "browser_fingerprint_") || 是否以 (方法名, "browser_font_"))
        {
            result = MCP_VIP分派.分类分派_VIP操作 (命令ID, 方法名, 参数JSON)
        }
        否则 (是否以 (方法名, "workflow"))
        {
            result = MCP_编排分派.分类分派_编排操作 (命令ID, 方法名, 参数JSON)
        }
        否则 (是否以 (方法名, "browser_reverse_"))  //.reverse_ 已在L7150统一规范化为 browser_reverse_
        {
            result = MCP_逆向分派.分类分派_逆向操作 (命令ID, 方法名, 参数JSON)
        }
        否则 (是否以 (方法名, "browser_kernel_"))
        {
            result = MCP_内核分派.分类分派_内核操作 (命令ID, 方法名, 参数JSON)
        }
        否则 (方法名 == "ping" || 方法名 == "browser_send_message" || 方法名 == "browser_get_global_cache_dir" || 方法名 == "browser_get_process_type" || 方法名 == "browser_get_window_style" || 方法名 == "browser_set_window_style" || 方法名 == "browser_get_run_style" || 方法名 == "browser_create_tab" || 方法名 == "browser_task_runner_post" || 方法名 == "browser_shutdown")
        {
            result = MCP_系统分派.分类分派_系统操作 (命令ID, 方法名, 参数JSON)
        }
        否则
        {
            // 核心分派覆盖 ~80% 命令: 导航/JS/DOM/窗口/CDP/截图/拦截/网络/收集等
            result = MCP_核心分派.分类分派_核心操作 (命令ID, 方法名, 参数JSON)
        }
        // 直投未命中时回退顺序链 (处理跨分派器边界情况, 如 fingerprint_* 可能被核心分派的fingerprint拦截action处理)
        如果 (result == "")
        {
            result = MCP_核心分派.分类分派_核心操作 (命令ID, 方法名, 参数JSON)
            如果 (result == "")
            {
                result = MCP_填表分派.分类分派_填表操作 (命令ID, 方法名, 参数JSON)
            }
            如果 (result == "")
            {
                result = MCP_VIP分派.分类分派_VIP操作 (命令ID, 方法名, 参数JSON)
            }
            如果 (result == "")
            {
                result = MCP_系统分派.分类分派_系统操作 (命令ID, 方法名, 参数JSON)
            }
            如果 (result == "")
            {
                result = MCP_编排分派.分类分派_编排操作 (命令ID, 方法名, 参数JSON)
            }
            如果 (result == "")
            {
                result = MCP_内核分派.分类分派_内核操作 (命令ID, 方法名, 参数JSON)
            }
        }
        如果 (result != "")
        {
            目标浏览器ID = 保存浏览器ID
            当前命令方法名 = 保存命令方法名
            当前命令参数JSON = 保存命令参数JSON
            MCP执行锁.解锁 ()
            返回 (result)
        }
        // 快捷别名回退 (不递归, 避免 MCP执行锁 重入)
        如果 (是否以 (方法名, "browser_") == 假)
        {
            变量 短名映射 <类型 = 文本型>
            短名映射 = 取短名映射 (方法名)
            如果 (短名映射 != "" && 短名映射 != 方法名)
            {
                控制台输出 ("[MCP] 别名映射: " + 方法名 + " → " + 短名映射)
                result = MCP_核心分派.分类分派_核心操作 (命令ID, 短名映射, 参数JSON)
                如果 (result == "")
                {
                    result = MCP_填表分派.分类分派_填表操作 (命令ID, 短名映射, 参数JSON)
                }
                如果 (result == "")
                {
                    result = MCP_VIP分派.分类分派_VIP操作 (命令ID, 短名映射, 参数JSON)
                }
                如果 (result == "")
                {
                    result = MCP_系统分派.分类分派_系统操作 (命令ID, 短名映射, 参数JSON)
                }
                如果 (result == "")
                {
                    result = MCP_编排分派.分类分派_编排操作 (命令ID, 短名映射, 参数JSON)
                }
                如果 (result == "")
                {
                    result = MCP_内核分派.分类分派_内核操作 (命令ID, 短名映射, 参数JSON)
                }
                目标浏览器ID = 保存浏览器ID
                当前命令方法名 = 保存命令方法名
                当前命令参数JSON = 保存命令参数JSON
                MCP执行锁.解锁 ()
                返回 (result)
            }
        }
        目标浏览器ID = 保存浏览器ID
        // 修复: 未知命令路径同样恢复静态命令上下文(与 result/别名路径对齐), 防嵌套调用残留上一次命令的方法名
        当前命令方法名 = 保存命令方法名
        当前命令参数JSON = 保存命令参数JSON
        MCP执行锁.解锁 ()
        返回 (MCP_响应构建.命令失败 (命令ID, "未知命令: " + 方法名 + " | 用 mcp_help 查看可用命令"))
    }

    # ======== 异步任务结果提取 ==========
    # 提交异步JS任务/取源码/取文本 返回 {"_async":true,"task_id":"xxx"}
    # 本方法检测此格式并返回 命令成功_异步()

    方法 包装异步提交结果 <公开 静态 类型 = 文本型 @输出名 = "WrapperAsyncSubmitResult" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 异步返回值 <类型 = 文本型 @输出名 = "AsyncReturnValue">
    参数 键名 <类型 = 文本型 @默认值 = "result" @输出名 = "KeyName">
    参数 成功消息 <类型 = 文本型 @默认值 = "已提交, 通过mcp_result查询结果" @输出名 = "SuccessMessage">
    {
        // 检测提交错误 (如 frame_invalid), 直接返回失败不包装
        如果 (是否以 (异步返回值, "{\"error\":"))
        {
            变量 错误解析 <类型 = YYJSON只读对象类>
            如果 (错误解析.创建自文本 (异步返回值))
            {
                变量 错误文本 <类型 = 文本型>
                错误文本 = 错误解析.取文本 ("error")
                返回 (MCP_响应构建.命令失败 (命令ID, 错误文本))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, 异步返回值))
        }
        // 检测自动异步切换标记
        如果 (是否以 (异步返回值, "{\"_async\":"))
        {
            变量 异步解析 <类型 = YYJSON只读对象类>
            如果 (异步解析.创建自文本 (异步返回值))
            {
                变量 taskID <类型 = 文本型>
                taskID = 异步解析.取文本 ("task_id")
                如果 (taskID != "")
                {
                    返回 (命令成功_异步 (命令ID, taskID, 成功消息))
                }
            }
        }
        // 正常结果 (非异步标记)
        返回 (MCP_响应构建.构建简单JSON (键名, 异步返回值))
    }

    # ======== 短名别名映射表 ==========

    方法 取短名映射 <公开 静态 类型 = 文本型 @输出名 = "GetShortNameMap" @强制输出 = 真>
    参数 短名 <类型 = 文本型 @输出名 = "ShortName">
    {
        // 已带 browser_ 前缀的完整名不需要映射
        如果 (是否以 (短名, "browser_"))
        {
            返回 ("")
        }
        // 无前缀命令 (ping/batch/aliases/mcp_*) 直接返回原短名
        如果 (短名 == "ping" || 短名 == "batch" || 短名 == "aliases" || 是否以 (短名, "mcp_"))
        {
            返回 (短名)
        }
        // 优先用命令注册表查找 (O(1) 字典)
        变量 注册ID <类型 = 整数>
        注册ID = 查找命令ID (短名)
        如果 (注册ID != 0)
        {
            返回 ("browser_" + 短名)
        }
        返回 ("")
    }

    # ======== HTTP 路径与 API 元信息 ==========

    方法 提取HTTP路径 <公开 静态 类型 = 文本型 @输出名 = "ExtractHTTPPath" @强制输出 = 真>
    参数 请求地址 <类型 = 文本型 @输出名 = "RequestUrl">
    {
        变量 URL路径 <类型 = 文本型>
        变量 协议位置 <类型 = 整数>
        协议位置 = 寻找文本 (请求地址, "://", 0, 假)
        如果 (协议位置 > 0)
        {
            变量 协议后起始 <类型 = 整数>
            协议后起始 = 协议位置 + 3
            变量 主机后文本 <类型 = 文本型>
            主机后文本 = 取文本中间 (请求地址, 协议后起始, 取文本长度 (请求地址) - 协议后起始 + 1)
            变量 路径起始 <类型 = 整数>
            路径起始 = 寻找文本 (主机后文本, "/", 0, 假)
            如果 (路径起始 > 0)
            {
                URL路径 = 取文本中间 (主机后文本, 路径起始 + 1, 取文本长度 (主机后文本) - 路径起始)
                URL路径 = "/" + URL路径
            }
            否则
            {
                URL路径 = "/"
            }
        }
        否则
        {
            URL路径 = 请求地址
            如果 (URL路径 == "")
            {
                URL路径 = "/"
            }
            如果 (取文本左边 (URL路径, 1) != "/")
            {
                URL路径 = "/" + URL路径
            }
        }
        变量 queryPos <类型 = 整数>
        queryPos = 寻找文本 (URL路径, "?", 0, 假)
        如果 (queryPos > 0)
        {
            // 0-based语义: "?"在0-based queryPos, 前缀字符数=queryPos
            URL路径 = 取文本左边 (URL路径, queryPos)
        }
        变量 hashPos <类型 = 整数>
        hashPos = 寻找文本 (URL路径, "#", 0, 假)
        如果 (hashPos > 0)
        {
            URL路径 = 取文本左边 (URL路径, hashPos)
        }
        返回 (URL路径)
    }

    方法 读取HTTP_POST体 <公开 静态 类型 = 文本型 @输出名 = "ReadHTTPPOSTBody" @强制输出 = 真>
    参数 请求 <类型 = 类_FBrowser_请求 @输出名 = "Request">
    {
        变量 POST数据体 <类型 = 类_FBrowser_POST数据>
        POST数据体 = 请求.取POST数据 ()
        如果 (POST数据体.是否为空 () || POST数据体.取元素个数 () <= 0)
        {
            返回 ("")
        }
        变量 元素数组 <类型 = 类_FBrowser_POST元素数组>
        元素数组 = POST数据体.取元素 ()
        如果 (元素数组.是否为空 ())
        {
            返回 ("")
        }
        变量 元素个数 <类型 = 整数>
        元素个数 = 元素数组.取个数 ()
        变量 全部字节数据 <类型 = 字节集类>
        变量 总字节数 <类型 = 长整数>
        总字节数 = 0
        // 修复: HTTP POST 体大小上限(与 WS 一致 50MB), 边累加边检查, 防超大请求体 OOM
        元素数组.到数组首 ()
        计次循环 (元素个数)
        {
            变量 当前元素 <类型 = 类_FBrowser_POST元素>
            当前元素 = 元素数组.取当前位置数据 ()
            如果 (当前元素.是否为空 () == 假)
            {
                变量 数据大小 <类型 = 整数>
                数据大小 = 当前元素.取数据大小 ()
                如果 (数据大小 > 0)
                {
                    如果 (总字节数 + (长整数)数据大小 > MCP_常量.WS最大消息字节)
                    {
                        控制台输出 ("[MCP] HTTP POST 体超过 " + 到文本 (MCP_常量.WS最大消息字节 / 1048576) + "MB 上限, 已拒绝")
                        返回 ("")
                    }
                    变量 字节数据 <类型 = 字节集类>
                    字节数据 = 当前元素.取字节集数据 (数据大小)
                    如果 (字节数据.字节集是否为空 () == 假)
                    {
                        全部字节数据.添加字节集 (字节数据)
                        总字节数 = 总字节数 + (长整数)数据大小
                    }
                }
            }
            元素数组.到下一个 ()
        }
        如果 (总字节数 > 0)
        {
            返回 (UTF8到文本 (全部字节数据))
        }
        返回 ("")
    }

    # ======== 静态文档 /docs ========

    方法 取文档根目录 <公开 静态 类型 = 文本型 @输出名 = "GetDocRootDir" @强制输出 = 真>
    {
        如果 (文档根目录缓存 != "")
        {
            返回 (文档根目录缓存)
        }
        变量 运行目录 <类型 = 文本型>
        运行目录 = 取运行目录 ()
        // 规范化: 去除尾部反斜杠, 防止拼接后出现 C:\\docs 双斜杠
        如果 (取文本右边 (运行目录, 1) == "\\")
        {
            运行目录 = 取文本左边 (运行目录, 取文本长度 (运行目录) - 1)
        }
        文档根目录缓存 = 运行目录 + "\\docs"
        如果 (MCP_服务器工具.检查目录是否存在 (文档根目录缓存) == 假)
        {
            控制台输出 (到文本 ("[MCP] 警告: docs 目录不存在:") + 到文本 (文档根目录缓存))
        }
        返回 (文档根目录缓存)
    }

    方法 取文档扩展名 <公开 静态 类型 = 文本型 @输出名 = "GetDocExtension" @强制输出 = 真>
    参数 文件路径 <类型 = 文本型 @输出名 = "FilePath">
    {
        变量 文件名 <类型 = 文本型>
        变量 末斜杠 <类型 = 整数>
        末斜杠 = 倒找文本 (文件路径, "\\", , 假)
        如果 (末斜杠 == -1)
        {
            末斜杠 = 倒找文本 (文件路径, "/", , 假)
        }
        如果 (末斜杠 != -1)
        {
            文件名 = 取文本中间 (文件路径, 末斜杠 + 1, 取文本长度 (文件路径) - 末斜杠 - 1)
        }
        否则
        {
            文件名 = 文件路径
        }
        变量 点位置 <类型 = 整数>
        点位置 = 倒找文本 (文件名, ".", , 假)
        如果 (点位置 < 0)
        {
            返回 ("")
        }
        返回 (到小写 (取文本中间 (文件名, 点位置 + 1, 取文本长度 (文件名) - 点位置 - 1)))
    }

    方法 文档相对路径是否安全 <公开 静态 类型 = 逻辑型 @输出名 = "DocRelativePathIsSafe" @强制输出 = 真>
    参数 相对路径 <类型 = 文本型 @输出名 = "RelativePath">
    {
        如果 (相对路径 == "")
        {
            返回 (假)
        }
        // URL 解码: 防止 %2e%2e%2f 等编码绕过路径穿越检查
        变量 解码路径 <类型 = 文本型>
        解码路径 = FBrowser_Parser_URI解码 (相对路径, 真, 真)
        如果 (寻找文本 (解码路径, "..", 0, 假) != -1)
        {
            返回 (假)
        }
        如果 (寻找文本 (解码路径, ":", 0, 假) != -1)
        {
            返回 (假)
        }
        // 反斜杠检查: 调用方已将 / 统一转为 \, 路径中不应出现原始 /
        // 允许在规范化的路径中保留分隔符, 但拒绝原始正斜杠(未转义的越界尝试)
        如果 (寻找文本 (相对路径, "\\", 0, 假) != -1)
        {
            // 检查是否为单纯的目录分隔符 (已被规范化), 非路径穿越载荷
            // 如果同时含有 .. 和 \, 则是穿越攻击
            如果 (寻找文本 (解码路径, "..\\", 0, 假) != -1 || 寻找文本 (解码路径, "\\..", 0, 假) != -1)
            {
                返回 (假)
            }
        }
        返回 (真)
    }

    方法 取文档MIME类型 <公开 静态 类型 = 文本型 @输出名 = "GetDocMIMEType" @强制输出 = 真>
    参数 文件路径 <类型 = 文本型 @输出名 = "FilePath">
    {
        变量 扩展名 <类型 = 文本型>
        扩展名 = 取文档扩展名 (文件路径)
        如果 (扩展名 == "html" || 扩展名 == "htm")
        {
            返回 ("text/html; charset=utf-8")
        }
        如果 (扩展名 == "css")
        {
            返回 ("text/css; charset=utf-8")
        }
        如果 (扩展名 == "js" || 扩展名 == "mjs")
        {
            返回 ("application/javascript; charset=utf-8")
        }
        如果 (扩展名 == "json")
        {
            返回 ("application/json; charset=utf-8")
        }
        如果 (扩展名 == "svg")
        {
            返回 ("image/svg+xml")
        }
        如果 (扩展名 == "png")
        {
            返回 ("image/png")
        }
        如果 (扩展名 == "jpg" || 扩展名 == "jpeg")
        {
            返回 ("image/jpeg")
        }
        如果 (扩展名 == "gif")
        {
            返回 ("image/gif")
        }
        如果 (扩展名 == "webp")
        {
            返回 ("image/webp")
        }
        如果 (扩展名 == "ico")
        {
            返回 ("image/x-icon")
        }
        如果 (扩展名 == "woff")
        {
            返回 ("font/woff")
        }
        如果 (扩展名 == "woff2")
        {
            返回 ("font/woff2")
        }
        如果 (扩展名 == "md" || 扩展名 == "txt")
        {
            返回 ("text/plain; charset=utf-8")
        }
        返回 ("application/octet-stream")
    }

    方法 尝试发送静态文档 <公开 静态 类型 = 逻辑型 @输出名 = "TrySendStaticDoc" @强制输出 = 真>
    参数 服务器 <类型 = 类_FBrowser_服务器 @输出名 = "Server">
    参数 连接ID <类型 = 整数 @输出名 = "ConnectionID">
    参数 URL路径 <类型 = 文本型 @输出名 = "URLPath">
    {
        变量 相对路径 <类型 = 文本型>
        相对路径 = URL路径
        如果 (相对路径 == "/docs" || 相对路径 == "/docs/")
        {
            相对路径 = "index.html"
        }
        否则 (是否以 (相对路径, "/docs/"))
        {
            变量 前缀长度 <类型 = 整数>
            前缀长度 = 取文本长度 ("/docs/")
            相对路径 = 取文本中间 (相对路径, 前缀长度, 取文本长度 (相对路径) - 前缀长度)
        }
        否则
        {
            返回 (假)
        }
        子文本替换 (相对路径, "/", "\\", , , 假)
        // URL解码: 将 %XX 百分号编码还原为原始UTF8字符 (如中文文件名)
        相对路径 = FBrowser_Parser_URI解码 (相对路径, 真, 真)
        如果 (文档相对路径是否安全 (相对路径) == 假)
        {
            返回 (假)
        }
        变量 文件路径 <类型 = 文本型>
        文件路径 = 取文档根目录 () + "\\" + 相对路径
        如果 (文件是否存在 (文件路径) == 假)
        {
            返回 (假)
        }
        变量 文件字节 <类型 = 字节集类>
        文件字节 = 读入文件 (文件路径)
        如果 (取字节集长度 (文件字节) == 0)
        {
            返回 (假)
        }
        变量 MIME <类型 = 文本型>
        MIME = 取文档MIME类型 (相对路径)
        // 文件扩展名白名单: 仅允许安全类型, 拒绝 application/octet-stream 等潜在危险类型
        如果 (MIME == "application/octet-stream")
        {
            返回 (假)
        }
        发送CORS200响应 (服务器, 连接ID, MIME, 取字节集指针 (文件字节), 取字节集长度 (文件字节))
        返回 (真)
    }
}
