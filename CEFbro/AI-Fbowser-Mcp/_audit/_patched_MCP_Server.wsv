<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

类 浏览器容器 <公开 折叠 @全局类 = 真 @输出名 = "BrowserContainer">
{
    变量 最新地址 <公开 静态 类型 = 文本型 @输出名 = "LatestUrl">
    变量 当前页面标题 <公开 静态 类型 = 文本型 注释 = "CEF OnTitleChange 事件缓存, 非JS获取" @输出名 = "CurrentPageTitle">
    变量 页面加载中 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "CEF OnLoadStart/OnLoadEnd 事件缓存, 非JS" @输出名 = "PageLoading">
    变量 最后载入结束毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "主框架最近一次load_end时刻(取启动时间毫秒), 供注册加载等待任务防竞态补查判序" @输出名 = "LastLoadEndMs">
    变量 状态锁 <公开 静态 类型 = 互斥锁类 注释 = "保护最新地址/当前页面标题/页面加载中 的浏览器事件线程与MCP线程跨线程读写" @输出名 = "StateLock">

    # ======== 跨线程安全访问器 (事件线程写 / MCP线程读) ========

    方法 置加载状态 <公开 静态 @输出名 = "SetLoadState" @强制输出 = 真>
    参数 值 <类型 = 逻辑型 @输出名 = "Value">
    {
        状态锁.加锁 ()
        页面加载中 = 值
        状态锁.解锁 ()
    }

    方法 取加载状态 <公开 静态 类型 = 逻辑型 @输出名 = "GetLoadState" @强制输出 = 真>
    {
        变量 v <类型 = 逻辑型>
        状态锁.加锁 ()
        v = 页面加载中
        状态锁.解锁 ()
        返回 (v)
    }

    方法 置最后载入结束毫秒 <公开 静态 @输出名 = "SetLastLoadEndMs" @强制输出 = 真>
    参数 值 <类型 = 长整数 @输出名 = "Value">
    {
        状态锁.加锁 ()
        最后载入结束毫秒 = 值
        状态锁.解锁 ()
    }

    方法 取最后载入结束毫秒 <公开 静态 类型 = 长整数 @输出名 = "GetLastLoadEndMs" @强制输出 = 真>
    {
        变量 v <类型 = 长整数>
        状态锁.加锁 ()
        v = 最后载入结束毫秒
        状态锁.解锁 ()
        返回 (v)
    }

    方法 置最新地址 <公开 静态 @输出名 = "SetLatestUrl" @强制输出 = 真>
    参数 值 <类型 = 文本型 @输出名 = "Value">
    {
        状态锁.加锁 ()
        最新地址 = 值
        状态锁.解锁 ()
    }

    方法 取最新地址 <公开 静态 类型 = 文本型 @输出名 = "GetLatestUrl" @强制输出 = 真>
    {
        变量 v <类型 = 文本型>
        状态锁.加锁 ()
        v = 最新地址
        状态锁.解锁 ()
        返回 (v)
    }

    方法 置页面标题 <公开 静态 @输出名 = "SetPageTitle" @强制输出 = 真>
    参数 值 <类型 = 文本型 @输出名 = "Value">
    {
        状态锁.加锁 ()
        当前页面标题 = 值
        状态锁.解锁 ()
    }

    方法 取页面标题 <公开 静态 类型 = 文本型 @输出名 = "GetPageTitle" @强制输出 = 真>
    {
        变量 v <类型 = 文本型>
        状态锁.加锁 ()
        v = 当前页面标题
        状态锁.解锁 ()
        返回 (v)
    }

    变量 浏览器数组 <公开 静态 类型 = 对象数组类 @输出名 = "BrowserArray">
    变量 网页数据 <公开 静态 类型 = 文本型 注释 = "内置欢迎页完整HTML(编译时IDE自动嵌入资源)" @输出名 = "WebData">
    变量 MCP服务已就绪 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "MCPServiceHasReady">
    变量 欢迎页已导航 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "WelcomePageHasNavigate">
    变量 欢迎页导航已发起 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "已调用载入地址, 等待load_end确认" @输出名 = "WelcomePageNavigateStarted">
    变量 欢迎页导航发起毫秒 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "WelcomePageNavigateStartMs">
    变量 HTTP服务可用 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "由 服务器即将创建 事件写入: 服务器对象非空即绑定成功" @输出名 = "HTTPServiceAvailable">
    变量 HTTP服务已尝试 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "已调用过 FBrowser_服务器_创建 (成败由事件回填)" @输出名 = "HTTPServiceAttempted">

    方法 重置欢迎页导航状态 <公开 静态 @输出名 = "ResetWelcomePageNavigateState" @强制输出 = 真>
    {
        欢迎页已导航 = 假
        欢迎页导航已发起 = 假
        欢迎页导航发起毫秒 = 0
    }

    方法 标记欢迎页导航已发起 <公开 静态 @输出名 = "MarkWelcomePageNavigateStarted" @强制输出 = 真>
    {
        欢迎页导航已发起 = 真
        欢迎页导航发起毫秒 = 取启动时间 ()
    }

    变量 需要重建浏览器 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "主浏览器被关闭后由UI线程重建" @输出名 = "NeedRebuildBrowser">
    变量 需要恢复布局 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "MCP测试改乱布局/自动尺寸后由UI线程恢复" @输出名 = "NeedRestoreLayout">

    方法 标记需要重建浏览器 <公开 静态 @输出名 = "MarkNeedRebuildBrowser" @强制输出 = 真>
    {
        需要重建浏览器 = 真
    }

    方法 标记需要恢复布局 <公开 静态 @输出名 = "MarkNeedRestoreLayout" @强制输出 = 真>
    {
        需要恢复布局 = 真
    }

    方法 恢复欢迎页 <公开 静态 @输出名 = "RestoreWelcomePage" @强制输出 = 真>
    {
        重置欢迎页导航状态 ()
        导航欢迎页内部 ()
    }

    方法 取欢迎页地址 <公开 静态 类型 = 文本型 @输出名 = "GetWelcomePageUrl" @强制输出 = 真>
    {
        如果 (MCPStdio桥.是否为Stdio模式 ())
        {
            // stdio 子进程模式无HTTP服务器(与常驻实例并存时端口被占): 空白页即可, 自动化工具不依赖欢迎页
            返回 ("about:blank")
        }
        返回 ("http://" + MCP命令服务器.服务器绑定地址 + ":" + 到文本 (MCP命令服务器.服务器端口) + "/")
    }

    # 重构: 恢复/尝试恢复/尝试导航 三方法的公共主体(取浏览器→判空→取框架→URL非空白不覆盖→载入→标记)

    方法 导航欢迎页内部 <公开 静态 @输出名 = "NavigateWelcomePageInternal" @强制输出 = 真>
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = MCP命令服务器.取主浏览器 ()
        如果 (browser.是否为空 () || browser.是否已关闭 ())
        {
            返回
        }
        变量 欢迎地址 <类型 = 文本型>
        欢迎地址 = 取欢迎页地址 ()
        变量 frame <类型 = 类_FBrowser_框架>
        frame = MCP命令服务器.取安全主框架 (browser)
        如果 (frame.是否有效 () == 假)
        {
            返回
        }
        // 已有非空白页面时不覆盖 (如 browser_create 已带URL)
        变量 当前URL <类型 = 文本型>
        当前URL = frame.取地址 ()
        如果 (当前URL != "" && 当前URL != "about:blank" && 当前URL != 欢迎地址)
        {
            返回
        }
        frame.载入地址 (欢迎地址)
        置最新地址 (欢迎地址)
        标记欢迎页导航已发起 ()
        // 无GUI: 不再同步地址栏
    }

    # ── 返回欢迎页 HTML (替换版本占位符) ──

    方法 取欢迎页HTML <公开 静态 类型 = 文本型 @输出名 = "GetWelcomePageHTML" @强制输出 = 真>
    {
        变量 结果HTML <类型 = 文本型>
        结果HTML = 网页数据
        如果 (结果HTML == "")
        {
            变量 HTML路径 <类型 = 文本型>
            HTML路径 = 取运行目录 () + "\\index.html"
            如果 (文件是否存在 (HTML路径))
            {
                变量 HTML字节 <类型 = 字节集类>
                HTML字节 = 读入文件 (HTML路径)
                如果 (取字节集长度 (HTML字节) > 0)
                {
                    结果HTML = UTF8到文本 (HTML字节)
                }
            }
        }
        子文本替换 (结果HTML, "{{MCP_VERSION}}", MCP_常量.MCP_版本号, , , 假)
        子文本替换 (结果HTML, "{{MCP_HTTP}}", MCP命令服务器.取MCP_HTTP地址 (), , , 假)
        子文本替换 (结果HTML, "{{MCP_WS}}", MCP命令服务器.取MCP_WS地址 (), , , 假)
        子文本替换 (结果HTML, "{{MCP_HOST}}", MCP命令服务器.服务器绑定地址, , , 假)
        子文本替换 (结果HTML, "{{MCP_PORT}}", 到文本 (MCP命令服务器.服务器端口), , , 假)
        子文本替换 (结果HTML, "{{MCP_EXE}}", 取执行文件名 (), , , 假)
        返回 (结果HTML)
    }
}

# ================================================================
# CP 浏览器命令服务器 — HTTP + WebSocket 双协议
# 用 yyjson 构建/解析JSON，避免手写JSON字符串的转义错误
# ================================================================

类 MCP命令服务器 <公开 @全局类 = 真 @视窗.附属文件 = "..\\docs > docs" @视窗.附属文件 = "mcp_config.json" @视窗.附属文件 = "..\\mcp_config.README.md"
        @视窗.附属文件 = "index.html" @视窗.附属文件 = "..\\mcp_bridge.js"
        @视窗.附属文件 = "..\\workflows > workflows" @输出名 = "MCPCommandServer">
{
    变量 服务器端口 <公开 静态 类型 = 整数 值 = 9222 @输出名 = "ServerPort">
    变量 待创建URL <公开 静态 类型 = 文本型 值 = "" @输出名 = "PendingCreateURL">
    // 用户标识: 类库里"标识"只能在创建浏览器时传入(FBroLib 创建函数的最后一个参数), 且没有运行期设置接口。
    // 该字段与 待创建URL 同一套"待创建"握手, 由 browser_create 写入、main.wsv 在创建时取用。
    变量 待创建标识 <公开 静态 类型 = 文本型 值 = "" @输出名 = "PendingCreateTag">
    变量 待创建完成 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "PendingCreateDone">
    变量 待关闭截至毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "browser_shutdown 延迟关闭的截止时刻(GetTickCount64毫秒), 主循环节拍消费; 不在主线程Sleep阻塞消息泵" @输出名 = "PendingCloseUntilMs">
    变量 重定向链计数 <公开 静态 类型 = 整数 值 = 0 注释 = "导航重定向链保护: 2秒窗口内重定向次数, 防互指规则(A→B,B→A)无限循环" @输出名 = "RedirectChainCount">
    变量 重定向链起始毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "重定向链保护窗口起点(GetTickCount64毫秒)" @输出名 = "RedirectChainStartMs">
    变量 上次拖拽进入毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "拖拽节流窗口起点(取启动时间毫秒): 浏览器_拖拽进入 在拖动未结束时会被反复回调" @输出名 = "LastDragEnterMs">
    变量 上次拖拽类型 <公开 静态 类型 = 整数 值 = -1 注释 = "上一次记录的拖动操作掩码, 变化时必记一条" @输出名 = "LastDragEnterMask">
    变量 待创建锁 <公开 静态 类型 = 互斥锁类 注释 = "保护待创建URL/待创建完成 的UI时钟线程与MCP线程握手, 防并发create/shutdown互相覆盖" @输出名 = "PendingCreateLock">
    变量 是否启用 <公开 静态 类型 = 逻辑型 值 = 真 @输出名 = "IsEnable">
    变量 浏览器数组锁 <公开 静态 类型 = 互斥锁类 注释 = "保护浏览器数组的跨线程访问(UI线程 vs MCP server线程)" @输出名 = "BrowserArrayLock">
    变量 MCP执行锁 <公开 静态 类型 = 互斥锁类 注释 = "序列化执行浏览器命令, 防止目标浏览器ID等静态上下文竞态" @输出名 = "MCPExecuteLock">
    变量 协议锁 <公开 静态 类型 = 互斥锁类 注释 = "JSON-RPC请求端到端串行化, 保护当前请求追踪ID/紧凑响应模式等请求级静态上下文" @输出名 = "ProtocolLock">
    变量 异步缓存锁 <公开 静态 类型 = 互斥锁类 注释 = "保护SQLite数据库的跨线程访问(UI回调 vs MCP server)" @输出名 = "AsyncCacheLock">
    变量 是否记录网络 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "IsRecordNetwork">
    变量 是否记录控制台 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "IsRecordConsole">
    变量 是否缓存响应 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "IsCacheResponse">
    变量 是否详细记录网络 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "IsDetailedRecordNetwork">
    变量 工具列表缓存 <公开 静态 类型 = 文本型 值 = "" @输出名 = "ToolListCache">
    变量 当前请求追踪ID <公开 静态 类型 = 文本型 值 = "" @输出名 = "CurrentRequestTraceID">
    变量 当前请求ID是数值 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "JSON-RPC规范: id可省略/可为数字(含0); 回显时保持请求id类型(数字id回数字, 文本id回文本)" @输出名 = "CurrentRequestIDIsNumValue">
    变量 目标浏览器ID <公开 静态 类型 = 整数 值 = 0 @输出名 = "TargetBrowserID">
    变量 紧凑响应模式 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "CompactResponseMode">
    变量 当前命令方法名 <公开 静态 类型 = 文本型 值 = "" 注释 = "执行浏览器命令时设置, 供 sync-wait 判定" @输出名 = "CurrentCommandMethodName">
    变量 当前命令参数JSON <公开 静态 类型 = YYJSON只读对象类 注释 = "当前 tools/call arguments" @输出名 = "CurrentCommandParamJSON">

    # ======== 安全与配置 (v1.4) ==========

    变量 API密钥 <公开 静态 类型 = 文本型 值 = "" @输出名 = "APIKey">
    变量 是否启用认证 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "IsEnableAuth">
    变量 速率限制_每分钟 <公开 静态 类型 = 整数 值 = 0 注释 = "0=禁用(本地桌面无需限速), 可通过 mcp_config.json 配置" @输出名 = "RateLimitPerMinute">
    变量 速率限制_计数器 <公开 静态 类型 = 整数 值 = 0 @输出名 = "RateLimitCounter">
    变量 速率限制_窗口开始 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "RateLimitWindowStart">
    变量 配置已加载 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "ConfigHasLoad">
    变量 工具总数 <公开 静态 类型 = 整数 值 = 0 注释 = "动态工具计数, 由填充工具列表()完成后更新" @输出名 = "ToolTotal">
    变量 工具构建计数 <静态 类型 = 整数 值 = 0 @输出名 = "ToolBuildCount">
    变量 VIP授权码 <公开 静态 类型 = 文本型 值 = "" 注释 = "VIP功能授权码, 启动时从mcp_config.json读取, 供启动类使用" @输出名 = "VIPLicenseCode">
    变量 服务器绑定地址 <公开 静态 类型 = 文本型 值 = "127.0.0.1" @输出名 = "ServerBindAddress">
    变量 窗口置顶 <公开 静态 类型 = 逻辑型 值 = 真 注释 = "窗口是否置顶, 由 mcp_config.json window_topmost 控制" @输出名 = "WindowSetTop">
    变量 窗口默认宽度 <公开 静态 类型 = 整数 值 = 1000 注释 = "浏览器窗口默认宽度, 由 mcp_config.json window_width 控制" @输出名 = "WindowDefaultWidth">
    变量 窗口默认高度 <公开 静态 类型 = 整数 值 = 800 注释 = "浏览器窗口默认高度, 由 mcp_config.json window_height 控制" @输出名 = "WindowDefaultHeight">
    变量 MCP服务器实例 <公开 静态 类型 = 类_FBrowser_服务器 注释 = "HTTP/WS 内嵌服务器, 退出时须关闭()" @输出名 = "MCPServerInstance">
    变量 MCP正在关闭 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "MCPIsClose">
    变量 文档根目录缓存 <公开 静态 类型 = 文本型 值 = "" 注释 = "解析后的 docs 物理目录, 启动后缓存" @输出名 = "DocRootDirCache">

    # ======== 命令注册表(字典预查找) ==========

    变量 命令注册表 <公开 静态 类型 = 类_FBrowser_字典值 @输出名 = "CommandRegisterTable">

    # ======== SQLite 持久缓存 (v2.3 替换 CEF Dict + 文件系统) ==========

    变量 缓存数据库 <公开 静态 类型 = SQLite数据库类 @输出名 = "CacheDataLib">
    变量 异步任务计数器 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "AsyncTaskCounter">
    变量 网络日志最大字节 <公开 静态 类型 = 整数 值 = 262144 注释 = "event_log单条JSON最大字符数, 可由mcp_config.json覆盖" @输出名 = "NetworkLogMaxByte">
    变量 请求计数器 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "RequestCounter">
    变量 服务器启动时间戳 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "ServerStartTimestamp">
    变量 服务器启动墙钟毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "启动时刻墙钟毫秒, 用于uptime显示(避免取启动时间32位回绕)" @输出名 = "ServerStartWallClockMs">

    # ======== 企业级可观测性指标 (供 /metrics Prometheus 端点与 /health 使用) ========
    # 写入点: 处理MCP请求 —— 单点埋点, 同时覆盖 HTTP / WebSocket / stdio 三条传输

    变量 指标_请求总数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计 JSON-RPC 请求数(含通知)" @输出名 = "MetricRequestsTotal">
    变量 指标_错误响应数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计返回 error 字段的响应数" @输出名 = "MetricErrorResponses">
    变量 指标_工具调用数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计 tools/call 次数" @输出名 = "MetricToolCalls">
    变量 指标_延迟累加毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "请求处理耗时累加(用于算均值)" @输出名 = "MetricLatencySumMs">
    变量 指标_延迟最大毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "单次请求最大处理耗时" @输出名 = "MetricLatencyMaxMs">
    变量 指标_活跃请求数 <公开 静态 类型 = 整数 值 = 0 注释 = "当前在处理中的请求数(并发度观测)" @输出名 = "MetricActiveRequests">
    变量 指标_限流拒绝数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计被速率限制拒绝的请求数" @输出名 = "MetricRateLimited">
    变量 指标_认证失败数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计认证失败数" @输出名 = "MetricAuthFailed">
    变量 指标_协议错误数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计 JSON 解析失败/非 JSON-RPC 2.0 的请求数" @输出名 = "MetricProtocolErrors">

    # MCP logging 能力: 客户端经 logging/setLevel 设置, 供 notifications/message 与诊断输出使用
    变量 MCP日志级别 <公开 静态 类型 = 文本型 值 = "info" @输出名 = "MCPLogLevel">

    # ======== 企业级: 会话标识 (Streamable HTTP 合规) ========
    # 规范: 服务端可在 initialize 响应回 Mcp-Session-Id, 客户端后续请求须回带。
    # 本项目为本地单用户服务, 采取宽容策略: 恒回带该头, 但不强制客户端回传(向后兼容)。
    # 注: 初始化CORS响应头的 Allow-Headers 里早已声明 Mcp-Session-Id, 此前仅有声明无实现。
    变量 会话ID <公开 静态 类型 = 文本型 值 = "" @输出名 = "SessionID">

    # ======== 企业级: 长任务进度上报 (notifications/progress) ========
    # 客户端在 tools/call 的 params._meta.progressToken 里给出令牌, 服务端在长等待期间推送进度。
    # 推送通道: stdio(双向流) / WebSocket —— 二者可直接推送;
    #           HTTP POST 是纯请求-响应, 无推送通道(需 Streamable HTTP 的 GET /mcp SSE, 尚未实现),
    #           此时静默不推(规范中进度为可选, 客户端可忽略)。
    变量 当前进度令牌 <公开 静态 类型 = 文本型 值 = "" @输出名 = "CurrentProgressToken">
    变量 当前推送通道 <公开 静态 类型 = 文本型 值 = "" @输出名 = "CurrentPushChannel">
    变量 当前推送连接ID <公开 静态 类型 = 整数 值 = 0 @输出名 = "CurrentPushConnectionID">
    变量 指标_进度通知数 <公开 静态 类型 = 长整数 值 = 0 注释 = "累计推送的 progress 通知数" @输出名 = "MetricProgressNotifications">
    变量 上次进度推送毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "进度推送节流时间戳(间隔>=500ms)" @输出名 = "LastProgressPushMs">
    变量 上次维护毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "执行定期维护的共享时间戳(主循环节拍与请求入口惰性路径共用, 防双路径并发维护)" @输出名 = "LastMaintainMs">
    变量 活动URL请求数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "ActiveURLRequestNum">
    变量 最后URL请求槽释放时间 <公开 静态 类型 = 长整数 值 = 0 注释 = "用于检测粘滞的URL请求槽(回调未触发)" @输出名 = "LastURLRequestSlotReleaseTime">
    变量 URL请求槽满起始毫秒 <公开 静态 类型 = 长整数 值 = 0 注释 = "并发槽首次打满的时刻, 用于无释放回调时的粘滞检测" @输出名 = "URLRequestSlotFullStartMs">

    # ======== 全局持久配置 (新浏览器创建时自动应用) ==========

    变量 持久代理地址 <公开 静态 类型 = 文本型 值 = "" @输出名 = "PersistentProxyUrl">
    变量 持久代理账号 <公开 静态 类型 = 文本型 值 = "" @输出名 = "PersistentProxyAccount">
    变量 持久代理密码 <公开 静态 类型 = 文本型 值 = "" @输出名 = "PersistentProxyPassword">
    变量 持久配置锁 <公开 静态 类型 = 互斥锁类 注释 = "保护持久代理/缩放/静音字段跨线程读写(MCP线程写 vs UI线程新浏览器应用时读), 锁序: 协议锁→MCP执行锁→持久配置锁" @输出名 = "PersistentConfigLock">
    变量 持久缩放级别 <公开 静态 类型 = 小数 值 = 0 @输出名 = "PersistentZoomLevel">
    变量 持久静音状态 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "PersistentMuteState">
    变量 持久V8扩展列表 <公开 静态 类型 = 文本数组类 @输出名 = "PersistentV8ExtensionList">
    变量 持久反检测_禁用Debugger检测 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "内核开关: 禁用网页debugger检测(VIP), 浏览器创建时自动应用" @输出名 = "PersistentAntiDetectDisableDebuggerDetect">
    变量 持久反检测_伪装UA <公开 静态 类型 = 文本型 值 = "" 注释 = "持久UA伪装(空=不启用), 浏览器创建时自动应用" @输出名 = "PersistentAntiDetectSpoofUA">
    变量 持久反检测_禁用自动化标志 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "移除navigator.webdriver等自动化检测标志, 浏览器创建时应用" @输出名 = "PersistentAntiDetectDisableAutomationFlag">
    变量 缓存数据库已打开 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "CacheDataLibOpened">
    变量 缓存数据库已首清 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "打开数据库时的一次性残留清理标志, 维护路径绝不触发" @输出名 = "CacheDataLibHasFirstClear">

    # ======== Hook开关 (事件预注册 + 动态启用, 参照网络日志模式) ==========

    变量 是否Hook导航 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将导航中检查拦截规则" @输出名 = "IsHookNavigate">
    变量 是否Hook资源 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_获取资源处理器中检查替换规则" @输出名 = "IsHookResource">
    变量 是否Hook音频 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_获取音频参数中修改音频指纹" @输出名 = "IsHookAudio">
    变量 是否Hook弹窗 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将打开新窗口中自定义弹窗属性" @输出名 = "IsHookPopup">
    变量 导航拦截规则 <公开 静态 类型 = 文本型 值 = "" 注释 = "行文本: block|url 或 redirect|url|target (每行一条)" @输出名 = "NavigateInterceptRule">
    变量 资源替换规则 <公开 静态 类型 = 文本型 值 = "" 注释 = "行文本: action|url|search|replace|file:path (字段经转义, |和换行不破坏格式)" @输出名 = "ResourceReplaceRule">
    变量 规则锁 <公开 静态 类型 = 互斥锁类 注释 = "保护资源替换规则/导航拦截规则的跨线程读写(MCP线程写/UI线程读)" @输出名 = "RuleLock">
    变量 待恢复暂停时间 <公开 静态 类型 = 长整数 值 = 0 注释 = "browser_debugger_pause 发出后未捕获到暂停事件时的自动resume时间戳(防渲染器冻结崩溃)" @输出名 = "PendingRestorePauseTime">
    变量 暂停前事件指纹 <公开 静态 类型 = 文本型 值 = "" @输出名 = "PauseBeforeEventFingerprint">
    变量 近期崩溃次数 <公开 静态 类型 = 整数 值 = 0 注释 = "崩溃循环防护: 120秒窗口内的渲染进程崩溃计数" @输出名 = "RecentCrashCount">
    变量 首次崩溃时间 <公开 静态 类型 = 长整数 值 = 0 @输出名 = "FirstCrashTime">
    变量 禁止重建 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "崩溃循环防护: 触发阈值后禁止进程内自动重建, 重启后复位" @输出名 = "ForbidRebuild">
    变量 自动安装代理 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json auto_install_agents: 启动时自动写入各Agent的MCP配置(零手动接入)" @输出名 = "AutoInstallProxy">
    变量 篡改文件缓存路径 <公开 静态 类型 = 文本数组类 注释 = "replace_file 文件内容缓存: 路径平行数组 (规则设置时MCP线程预读, 挂载时UI线程免磁盘IO)" @输出名 = "TamperFileCachePath">
    变量 篡改文件缓存内容 <公开 静态 类型 = 文本数组类 @输出名 = "TamperFileCacheContent">
    变量 音频指纹配置 <公开 静态 类型 = 文本型 值 = "" 注释 = "JSON: {sample_rate:int,channels:int,...}" @输出名 = "AudioFingerprintConfig">
    变量 弹窗配置 <公开 静态 类型 = 文本型 值 = "" 注释 = "JSON: {width:int,height:int,x:int,y:int,...}" @输出名 = "PopupConfig">

    # ======== 浏览器事件监控开关 (事件存入异步缓存, 可通过 browser_event 查询) ==========

    变量 是否监控载入事件 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_载入开始/载入结束/载入错误 → browser_event:load_start|load_end|load_error" @输出名 = "IsMonitorLoadEvent">
    变量 是否监控标题改变 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_标题被改变 → browser_event:title_changed" @输出名 = "IsMonitorTitleChange">
    变量 是否监控加载进度 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_加载进度被改变 → browser_event:load_progress" @输出名 = "IsMonitorLoadProgress">
    变量 是否监控资源事件 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将加载资源/响应资源/重定向 → browser_event:resource_*" @输出名 = "IsMonitorResourceEvent">
    变量 是否监控对话框 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "JS alert/confirm/prompt/onbeforeunload → browser_event:js_dialog" @输出名 = "IsMonitorDialog">
    变量 是否监控全屏 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_全屏模式被改变 → browser_event:fullscreen" @输出名 = "IsMonitorFullscreen">
    变量 是否监控图标 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_网页图标被改变 → browser_event:favicon" @输出名 = "IsMonitorFavicon">
    变量 是否监控查找 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_查找返馈 → browser_event:find_result" @输出名 = "IsMonitorFind">
    变量 是否监控框架 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "创建/拆离/主框架变更 → browser_event:frame_*" @输出名 = "IsMonitorFrame">
    变量 是否监控下载事件 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_可下载/下载进度 → browser_event:download_*" @输出名 = "IsMonitorDownloadEvent">
    变量 是否监控键盘焦点 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "键盘/焦点事件 → browser_event:key_focus_*" @输出名 = "IsMonitorKeyboardFocus">
    变量 是否监控生命周期 <公开 静态 类型 = 逻辑型 值 = 假
            注释 = "创建/关闭/地址变更/执行关闭 → browser_event:browser_created|browser_closing|url_changed|do_close" @输出名 = "IsMonitorLifecycle">

    # ======== 应用级事件监控 (全局生命周期, 无特定浏览器ID) ==========

    变量 是否监控应用事件 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "渲染进程创建/销毁/V8释放/异常/焦点/载入状态 → app_event:*" @输出名 = "IsMonitorApplyEvent">
    变量 是否监控菜单事件 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将打开菜单/菜单被调用/菜单被点击/菜单被关闭 → browser_event:context_menu*" @输出名 = "IsMonitorContextMenu">
    # 右键菜单自定义规格(方案甲)。浏览器每次右键都是**全新的默认菜单模型**, 且 CEF 禁止在
    # 回调之外持有菜单对象, 故这里只**暂存规格**, 由 浏览器_即将打开菜单 回调在模型有效期内施加。
    变量 菜单规格文本 <公开 静态 类型 = 文本型 @输出名 = "MenuSpecText">
    变量 菜单已启用 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "MenuEnabled">
    # VIP JS 执行环境是否已启用(由 browser_vip_enable_js_env 维护):
    # 供 browser_vip_execute_js_context 的 main/all_frames/frame_index 做前置判断, 避免静默等到超时。
    变量 VIP_JS环境已启用 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "VipJSEnvEnabled">
    # 插件高级功能开关是否已启用(类库要求必须在加载插件前启用; 未启用时插件 content_scripts.js 不执行且无报错)
    变量 VIP_插件高级功能已启用 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "VipExtensionPlusEnabled">
    变量 菜单施加次数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "MenuApplyCount">
    变量 菜单最近施加条数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "MenuLastAppliedCount">
    变量 菜单上次施加时刻 <公开 静态 类型 = 文本型 @输出名 = "MenuLastApplyTime">
    变量 菜单上次错误 <公开 静态 类型 = 文本型 @输出名 = "MenuLastError">
    # 回读验证结果(写入后立刻用只读 getter 核对, 不只听类库返回值)
    变量 菜单最近项数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "MenuLastItemCount">
    变量 菜单回读确认条数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "MenuVerifiedCount">
    变量 菜单回读不一致 <公开 静态 类型 = 文本型 @输出名 = "MenuVerifyMismatch">
    # 施加失败明细: setter 返回假时逐条记录原因(不再只有 applied=0 而毫无线索)
    变量 菜单施加失败 <公开 静态 类型 = 文本型 @输出名 = "MenuApplyFailed">
    变量 是否监控快捷菜单 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将运行快捷菜单命令/即将取消快捷菜单 → browser_event:quick_menu*" @输出名 = "IsMonitorQuickMenu">
    变量 是否监控导航意图 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_从标签打开地址/处理协议请求/即将创建主框架Document → browser_event:nav_intent*" @输出名 = "IsMonitorNavIntent">
    变量 是否监控界面细节 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "工具栏(提示)/光标/自动调整尺寸/渲染视图/拖拽区域/客户端证书 → browser_event:ui_*" @输出名 = "IsMonitorUiDetail">
    变量 是否监控插件生命周期 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "扩展插件_创建成功/创建失败/载入成功/卸载成功 → app_event:extension_*" @输出名 = "IsMonitorExtension">
    变量 是否监控启动流程 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "请求环境初始化完毕/即将处理命令行/即将启动子进程/消息调度/即将初始化WebKit → app_event:startup_*" @输出名 = "IsMonitorStartup">
    变量 是否监控渲染细节 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "渲染_即将创建V8环境/收到消息/载入状态被改变/载入开始/载入结束 → app_event:render_*" @输出名 = "IsMonitorRenderDetail">
    变量 是否监控WebSocket渲染 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "渲染_VIP_WebSocket客户端_创建/关闭/连接服务器/接收数据/发送数据 → app_event:render_ws_*" @输出名 = "IsMonitorRenderWS">
    变量 是否监控许可提示 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将请求媒体访问许可/即将显示许可提示/即将关闭许可提示 → browser_event:permission_* (摄像头/麦克风/定位等授权请求)" @输出名 = "IsMonitorPermissionPrompt">
    变量 是否监控离屏渲染 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "离屏渲染(OSR)事件族 → browser_event:offscreen_* (注: 窗口内嵌渲染模式下不触发, 仅切换到离屏渲染模式才有意义)" @输出名 = "IsMonitorOffscreen">
    变量 是否监控开发者窗口 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "浏览器_即将打开开发者窗口 → browser_event:devtools_popup (非用户命令打开的 DevTools: 右键检查/内置F12)" @输出名 = "IsMonitorDevToolsPopup">
    变量 是否监控自建URL请求 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "开始创建/下载进度/获得需授权证书 → browser_event:urlreq_start|urlreq_download|urlreq_auth (仅自建 FBrowser_创建URL请求)" @输出名 = "IsMonitorURLRequest">
    变量 是否自动保存下载 <公开 静态 类型 = 逻辑型 值 = 真 注释 = "浏览器_即将下载时自动保存到Downloads目录" @输出名 = "IsAutoSaveDownload">
    变量 是否自动关闭JS对话框 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "自动化模式下自动确认alert/confirm/prompt" @输出名 = "IsAutoCloseJSDialog">    # ==== 启动期开关通道v1: 启动期 Chromium 开关的配置字段 (由 _audit/_apply_startup_switches.py 插入) ====
    # 白名单布尔键来源: mcp_config.json (加载MCP配置 在 FBrowser_初始化 之前调用, 时机天然合适);
    # 消费点: 启动类.即将处理命令行; 全部默认假 => 不写配置时行为与改动前完全一致。
    变量 启动开关_启用摄像头 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json enable_media_stream: 为真时启动期对命令行调用 启用摄像头(enable-media-stream)" @输出名 = "StartupSwitchEnableMediaStream">
    变量 启动开关_启用录音 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json enable_speech_input: 为真时启动期对命令行调用 启用录音(enable-speech-input)" @输出名 = "StartupSwitchEnableSpeechInput">
    变量 启动开关_启用自动播放 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json enable_autoplay: 为真时启动期对命令行调用 启用自动播放" @输出名 = "StartupSwitchEnableAutoplay">
    变量 启动开关_禁用GPU <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json disable_gpu: 为真时启动期对命令行调用 禁用GPU" @输出名 = "StartupSwitchDisableGpu">
    变量 启动开关_禁用GPU缓存 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json disable_gpu_cache: 为真时启动期对命令行调用 禁用GPU缓存" @输出名 = "StartupSwitchDisableGpuCache">
    变量 启动开关_忽略GPU禁用清单 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "mcp_config.json ignore_gpu_blocklist: 为真时启动期对命令行调用 忽略GPU禁用清单" @输出名 = "StartupSwitchIgnoreGpuBlocklist">
    变量 命令行开关已应用 <公开 静态 类型 = 文本型 值 = "" 注释 = "启动期如实回执: 实际调用过的开关(半角分号分隔, 末尾带分号; 空=一个都没应用), 由 启动类.即将处理命令行 写入" @输出名 = "CmdLineSwitchesApplied">
    变量 命令行开关原文 <公开 静态 类型 = 文本型 值 = "" 注释 = "启动期如实回执: 施加完毕后的浏览器进程命令行原文(命令行.取字符串), 空=未在浏览器进程施加" @输出名 = "CmdLineSwitchRawText">


    # ======== 启动服务器 ==========
    # ======== 加载配置文件 ==========

    方法 取MCP_WS地址 <公开 静态 类型 = 文本型 @输出名 = "GetMCPWSUrl" @强制输出 = 真>
    {
        返回 ("ws://" + 服务器绑定地址 + ":" + 到文本 (服务器端口))
    }

    方法 取MCP_HTTP地址 <公开 静态 类型 = 文本型 @输出名 = "GetMCPHTTPUrl" @强制输出 = 真>
    {
        返回 ("http://" + 服务器绑定地址 + ":" + 到文本 (服务器端口))
    }

    # 是否按配置跳过 HTTP/WS 端口监听
    # 背景: --mcp-stdio/--stdio/--headless 场景下部分用户不希望额外监听端口(隔离/审计要求),
    # 但原实现把"不监听"写死进代码且不告知, 导致 AI 客户端拿到一串连不上的 HTTP 地址。
    # 现改为默认总是监听, 仅由环境变量显式关闭, 且启动日志/连接信息如实反映。

    方法 是否禁用HTTP服务 <公开 静态 类型 = 逻辑型 @输出名 = "IsHTTPServiceDisabled" @强制输出 = 真>
    {
        变量 配置值 <类型 = 文本型>
        配置值 = 到小写 (删首尾空 (读环境变量 ("AI_BROWSER_MCP_NO_HTTP")))
        如果 (配置值 == "1" || 配置值 == "true" || 配置值 == "yes" || 配置值 == "on")
        {
            返回 (真)
        }
        返回 (假)
    }

    # 判断URL是否指向本MCP服务器自托管页面 (http/https + 本机地址 + 服务器端口)
    # 背景: FBrowser服务器事件循环单线程, MCP线程同步等待期间服务器无法服务自托管页面,
    # navigate/reload此类页面 + wait_for_load 必然超时 → 应同步等待返回假自动降级异步(task_id轮询)

    方法 是否本机自托管URL <公开 静态 类型 = 逻辑型 @输出名 = "IsLocalSelfHostedURL" @强制输出 = 真>
    参数 输入URL <类型 = 文本型 @输出名 = "InputURL">
    {
        如果 (输入URL == "")
        {
            返回 (假)
        }
        变量 小写URL <类型 = 文本型>
        小写URL = 到小写 (删首尾空 (输入URL))
        如果 (是否以 (小写URL, "http://") == 假 && 是否以 (小写URL, "https://") == 假)
        {
            返回 (假)
        }
        变量 端口文本 <类型 = 文本型>
        端口文本 = 到文本 (服务器端口)
        变量 绑定小写 <类型 = 文本型>
        绑定小写 = 到小写 (删首尾空 (服务器绑定地址))
        // 回环别名: 绑定127.0.0.1/0.0.0.0时, localhost/127.0.0.1 均指向本服务器
        如果 (绑定小写 == "127.0.0.1" || 绑定小写 == "0.0.0.0")
        {
            如果 (URL主机端口匹配 (小写URL, "127.0.0.1", 端口文本))
            {
                返回 (真)
            }
            如果 (URL主机端口匹配 (小写URL, "localhost", 端口文本))
            {
                返回 (真)
            }
        }
        如果 (绑定小写 == "::1" || 绑定小写 == "::")
        {
            如果 (URL主机端口匹配 (小写URL, "[::1]", 端口文本))
            {
                返回 (真)
            }
        }
        返回 (URL主机端口匹配 (小写URL, 绑定小写, 端口文本))
    }

    方法 URL主机端口匹配 <公开 静态 类型 = 逻辑型 @输出名 = "URLHostPortMatch" @强制输出 = 真>
    参数 小写URL <类型 = 文本型 @输出名 = "LowerCaseURL">
    参数 主机小写 <类型 = 文本型 @输出名 = "HostLowerCase">
    参数 端口文本 <类型 = 文本型 @输出名 = "PortText">
    {
        变量 剩余 <类型 = 文本型>
        剩余 = 小写URL
        如果 (是否以 (剩余, "https://"))
        {
            剩余 = 取文本右边 (剩余, 取文本长度 (剩余) - 8)
        }
        否则 (是否以 (剩余, "http://"))
        {
            剩余 = 取文本右边 (剩余, 取文本长度 (剩余) - 7)
        }
        变量 前缀 <类型 = 文本型>
        前缀 = 主机小写 + ":" + 端口文本
        如果 (是否以 (剩余, 前缀) == 假)
        {
            返回 (假)
        }
        // 端口边界校验: 端口后必须紧跟 / ? # 或结束, 防止 9222 误匹配 92220
        如果 (取文本长度 (剩余) == 取文本长度 (前缀))
        {
            返回 (真)
        }
        变量 后字符 <类型 = 文本型>
        后字符 = 取文本中间 (剩余, 取文本长度 (前缀), 1)
        返回 (后字符 == "/" || 后字符 == "?" || 后字符 == "#")
    }

    # 轻量浏览器事件监控默认开启 (载入/生命周期/标题/下载: 开销极低, 事件可经 browser_event 时间线查询)
    # 重型监控(网络详情/控制台)仍由 enable_network_log/enable_console_log 控制

    方法 应用默认事件监控 <公开 静态 @输出名 = "ApplyDefaultEventMonitor" @强制输出 = 真>
    {
        是否监控载入事件 = 真
        是否监控生命周期 = 真
        是否监控标题改变 = 真
        是否监控下载事件 = 真
        // 框架事件(每iframe导航各一条)默认关闭, 高噪声; 需要时经 browser_collect event_frame_enable 开启
    }

    方法 加载MCP配置 <公开 静态 @输出名 = "LoadMCPConfig" @强制输出 = 真>
    {
        如果真 (配置已加载)
        {
            返回
        }
        变量 配置路径 <类型 = 文本型>
        配置路径 = 取运行目录 () + "\\mcp_config.json"
        如果 (文件是否存在 (配置路径) == 假)
        {
            控制台输出 (到文本 ("[MCP] 配置文件不存在, 使用默认配置:") + 到文本 (配置路径))
            配置已加载 = 真
            是否启用认证 = 假
            应用默认事件监控 ()
            返回
        }
        变量 配置字节 <类型 = 字节集类>
        配置字节 = 读入文件 (配置路径)
        如果 (取字节集长度 (配置字节) == 0)
        {
            控制台输出 ("[MCP] 配置文件为空, 使用默认配置")
            应用默认事件监控 ()
            配置已加载 = 真
            返回
        }
        变量 配置JSON <类型 = 文本型>
        配置JSON = UTF8到文本 (配置字节)
        变量 配置解析 <类型 = YYJSON只读对象类>
        如果 (配置解析.创建自文本 (配置JSON) == 假)
        {
            控制台输出 ("[MCP] 配置文件JSON解析失败, 使用默认配置")
            配置已加载 = 真
            应用默认事件监控 ()
            返回
        }
        // 读取并解析JSON配置
        // 端口
        变量 配置端口 <类型 = 整数>
        配置端口 = 配置解析.取整数 ("port")
        如果 (配置端口 > 0 && 配置端口 < 65536)
        {
            服务器端口 = 配置端口
        }
        // 绑定地址
        变量 配置地址 <类型 = 文本型>
        配置地址 = 配置解析.取文本 ("bind_address")
        如果 (配置地址 != "")
        {
            服务器绑定地址 = 配置地址
        }
        // API密钥
        变量 配置密钥 <类型 = 文本型>
        配置密钥 = 配置解析.取文本 ("api_key")
        变量 禁用认证 <类型 = 逻辑型>
        禁用认证 = 配置解析.取逻辑值 ("disable_auth")
        如果 (禁用认证)
        {
            是否启用认证 = 假
            控制台输出 ("[MCP] API认证已通过配置禁用")
        }
        否则 (配置密钥 != "" && 配置密钥 != "YOUR_API_KEY_HERE")
        {
            API密钥 = 配置密钥
            是否启用认证 = 真
            控制台输出 ("[MCP] API密钥认证已启用 (来自配置)")
        }
        否则
        {
            是否启用认证 = 假
            控制台输出 ("[MCP] 未配置API密钥, 认证已禁用 (仅本地127.0.0.1)")
        }
        // 速率限制
        变量 配置速率 <类型 = 整数>
        配置速率 = 配置解析.取整数 ("rate_limit_per_minute")
        如果 (配置速率 >= 0)
        {
            速率限制_每分钟 = 配置速率
        }
        // 零手动接入: 启动时自动写入各Agent的MCP配置
        如果 (配置解析.取逻辑值 ("auto_install_agents"))
        {
            自动安装代理 = 真
            控制台输出 ("[MCP] 零手动接入已启用 (auto_install_agents: 启动时自动注册到Cursor/Claude/Codex/Cline)")
        }
        // 网络日志
        如果 (配置解析.取逻辑值 ("enable_network_log"))
        {
            是否记录网络 = 真
        }
        如果 (配置解析.取逻辑值 ("enable_console_log"))
        {
            是否记录控制台 = 真
        }
        如果 (配置解析.取逻辑值 ("enable_response_cache"))
        {
            是否缓存响应 = 真
            控制台输出 ("[MCP] 响应缓存已启用 (SQLite)")
        }
        变量 配置网络字节 <类型 = 整数>
        配置网络字节 = 配置解析.取整数 ("network_log_max_bytes")
        如果 (配置网络字节 > 0)
        {
            网络日志最大字节 = 配置网络字节
        }
        // === VIP授权码 (供启动类使用, 需在FBrowser初始化前设置) ===
        变量 配置VIP码 <类型 = 文本型>
        配置VIP码 = 配置解析.取文本 ("vip_code")
        如果 (配置VIP码 != "")
        {
            VIP授权码 = 配置VIP码
        }
        如果 (配置解析.取逻辑值 ("auto_download_save") == 假)
        {
            是否自动保存下载 = 假
        }
        如果 (配置解析.取逻辑值 ("auto_dismiss_js_dialog"))
        {
            是否自动关闭JS对话框 = 真
        }
        // ==== 启动期开关通道v1: 6 个独立布尔键(默认假, 缺键即假) ====
        // 只读配置写静态字段; 真正施加在 启动类.即将处理命令行 里完成(FBrowser_初始化 之前)
        如果 (配置解析.取逻辑值 ("enable_media_stream"))
        {
            启动开关_启用摄像头 = 真
        }
        如果 (配置解析.取逻辑值 ("enable_speech_input"))
        {
            启动开关_启用录音 = 真
        }
        如果 (配置解析.取逻辑值 ("enable_autoplay"))
        {
            启动开关_启用自动播放 = 真
        }
        如果 (配置解析.取逻辑值 ("disable_gpu"))
        {
            启动开关_禁用GPU = 真
        }
        如果 (配置解析.取逻辑值 ("disable_gpu_cache"))
        {
            启动开关_禁用GPU缓存 = 真
        }
        如果 (配置解析.取逻辑值 ("ignore_gpu_blocklist"))
        {
            启动开关_忽略GPU禁用清单 = 真
        }

        如果 (配置解析.取逻辑值 ("window_topmost"))
        {
            窗口置顶 = 配置解析.取逻辑值 ("window_topmost")
        }
        // 窗口默认大小
        变量 配置窗口宽 <类型 = 整数>
        配置窗口宽 = 配置解析.取整数 ("window_width")
        如果 (配置窗口宽 >= 400 && 配置窗口宽 <= 3840)
        {
            窗口默认宽度 = 配置窗口宽
        }
        变量 配置窗口高 <类型 = 整数>
        配置窗口高 = 配置解析.取整数 ("window_height")
        如果 (配置窗口高 >= 300 && 配置窗口高 <= 2160)
        {
            窗口默认高度 = 配置窗口高
        }
        // 轻量事件监控默认开启(可随时经 browser_collect event_*_disable 关闭; 仅在配置加载时应用一次)
        应用默认事件监控 ()
        // 否则保持默认值, 避免缺失键或越界值
        配置已加载 = 真
        如果 (是否启用认证 == 假 && 服务器绑定地址 != "127.0.0.1" && 服务器绑定地址 != "::1" && 服务器绑定地址 != "localhost")
        {
            控制台输出 ("[MCP] 警告: bind_address=" + 服务器绑定地址 + " 但未启用API认证, 建议配置 api_key 或保持本地绑定")
            MCPStdio桥.写日志 ("[MCP] ⚠️ 安全警告: bind_address=" + 服务器绑定地址 + " 但未启用API认证! 请配置 api_key 或改回 127.0.0.1")
        }
        控制台输出 (到文本 ("[MCP] 配置已加载, 端口:") + 到文本 (服务器端口) + " 绑定:" + 到文本 (服务器绑定地址) + " 认证:" + 到文本 (是否启用认证) + " 速率限制:" + 到文本 (速率限制_每分钟) + "/min")
    }

    # ======== API密钥验证 ==========

    方法 验证API密钥 <公开 静态 类型 = 逻辑型 @输出名 = "ValidateAPIKey" @强制输出 = 真>
    参数 请求参数 <类型 = YYJSON只读对象类 @输出名 = "RequestParam">
    {
        如果 (是否启用认证 == 假)
        {
            返回 (真)  // 未启用认证, 全部放行
        }
        如果 (请求参数.是否为空 ())
        {
            返回 (假)  // 启用认证但无参数
        }
        变量 客户端密钥 <类型 = 文本型>
        客户端密钥 = 请求参数.取文本 ("_api_key")
        如果 (客户端密钥 == "")
        {
            客户端密钥 = 请求参数.取文本 ("api_key")
        }
        返回 (客户端密钥 == API密钥)
    }

    # ======== 速率限制检查 ==========
    # 全局速率限制(第二道防线)

    方法 检查速率限制 <公开 静态 类型 = 逻辑型 @输出名 = "CheckRateLimit" @强制输出 = 真>
    {
        如果 (速率限制_每分钟 <= 0)
        {
            返回 (真)  // 未启用速率限制
        }
        异步缓存锁.加锁 ()
        变量 当前时间 <类型 = 长整数>
        当前时间 = 取启动时间 ()
        // 滑动窗口: 每分钟重置
        如果 (当前时间 - 速率限制_窗口开始 >= 60000)
        {
            速率限制_窗口开始 = 当前时间
            速率限制_计数器 = 1
            异步缓存锁.解锁 ()
            返回 (真)
        }
        速率限制_计数器 = 速率限制_计数器 + 1
        变量 未超限 <类型 = 逻辑型>
        未超限 = 速率限制_计数器 <= 速率限制_每分钟
        异步缓存锁.解锁 ()
        返回 (未超限)
    }

    # 按IP速率限制(第一道防线, 每IP独立计数)

    变量 IP速率限制字典 <公开 静态 类型 = 类_FBrowser_字典值 @输出名 = "IPRateLimitDict">
    变量 IP速率_当前分钟桶 <公开 静态 类型 = 整数 值 = 0 @输出名 = "IPRateCurrentMinuteBucket">
    变量 应用事件节流字典 <公开 静态 类型 = 类_FBrowser_字典值 注释 = "应用级节流(如 focus_ts), 与 IP 速率限制分离" @输出名 = "ApplyEventThrottleDict">
    变量 事件节流锁 <公开 静态 类型 = 互斥锁类 注释 = "保护应用事件节流字典跨线程访问(CEF焦点回调线程 vs MCP/主循环线程); 叶子锁, 从不与其它锁嵌套持有" @输出名 = "EventThrottleLock">
    变量 CDP附着浏览器ID <公开 静态 类型 = 整数 值 = 0 注释 = "DevTools 观察者注册所在的 browser_id" @输出名 = "CDPAttachBrowserID">
    变量 断点注册表 <公开 静态 类型 = 文本数组类 注释 = "debugger_set_breakpoint 成功设置的断点清单(文本: 文件名|行号), 供 list/clear 查询" @输出名 = "BreakpointRegisterTable">
    变量 断点ID注册表 <公开 静态 类型 = 文本数组类 注释 = "与断点注册表平行: CDP断点ID(用于逐个移除)" @输出名 = "BreakpointIDRegisterTable">
    变量 脚本注册表 <公开 静态 类型 = 文本数组类 注释 = "v2.8.2 V8脚本注册表(详情JSON): 累积Debugger.scriptParsed。通用事件缓存按方法名单槽只留最后一条, 拿不到全部scriptId, 故单独累积以支撑 searchInContent/getPossibleBreakpoints/setScriptSource 等V8级插装" @输出名 = "ScriptRegisterTable">
    变量 脚本ID表 <公开 静态 类型 = 文本数组类 注释 = "与脚本注册表平行: CDP scriptId (检索/热补丁直接按下标取, 不解析JSON对象数组 — yyjson取文本对非文本节点返回空)" @输出名 = "ScriptIDTable">
    变量 脚本URL表 <公开 静态 类型 = 文本数组类 注释 = "与脚本注册表平行: 脚本URL" @输出名 = "ScriptURLTable">
    变量 脚本长度表 <公开 静态 类型 = 文本数组类 注释 = "与脚本注册表平行: 脚本字节长度(数字文本)。供 script_id 缺省时自动挑最大脚本(混淆包通常最大)" @输出名 = "ScriptLengthTable">
    变量 触摸点已按下 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "CDP 触摸派发状态: 当前是否有一个触摸点处于按下态。touchEnd 需要 touchPoints 为空(由浏览器释放已存点), 而 touchMove 在无按下点时会被浏览器静默忽略 —— 两者都依赖这个状态才能既正确又不静默失败" @输出名 = "TouchPointPressed">
    变量 触摸点X <公开 静态 类型 = 整数 值 = -1 注释 = "-1 = 尚无触摸历史坐标(不能用 0, 否则 (0,0) 会被当成有效历史锚点)" @输出名 = "TouchPointX">
    变量 触摸点Y <公开 静态 类型 = 整数 值 = -1 @输出名 = "TouchPointY">

    方法 检查IP速率限制 <公开 静态 类型 = 逻辑型 @输出名 = "CheckIPRateLimit" @强制输出 = 真>
    参数 客户端地址 <类型 = 文本型 @默认值 = "" @输出名 = "ClientAddr">
    {
        如果 (速率限制_每分钟 <= 0)
        {
            返回 (真)
        }
        如果 (客户端地址 == "")
        {
            // 无法识别IP时回退到全局检查
            返回 (检查速率限制 ())
        }
        异步缓存锁.加锁 ()
        如果 (IP速率限制字典.是否为空对象 () || IP速率限制字典.是否为空 ())
        {
            IP速率限制字典.创建 ()
        }
        变量 当前时间 <类型 = 长整数>
        // 修复(回绕): 分钟桶改墙钟基准, 防 取启动时间 32位回绕(24.85天)后桶值为负导致限流错乱
        当前时间 = 取现行时间毫秒 ()
        // v2.4: 分钟桶切换 → 平滑衰减所有IP计数器(/衰减因子), 防脉冲攻击
        变量 当前分钟桶 <类型 = 整数>
        当前分钟桶 = 文本到整数 (到文本 (当前时间 / 60000))
        如果 (当前分钟桶 != IP速率_当前分钟桶)
        {
            // 遍历所有IP条目, 将计数/衰减因子 (最小衰减至0, 直接移除)
            变量 ipKeys <类型 = FBrowser_文本数组>
            ipKeys = IP速率限制字典.取关键字 ()
            变量 keyCount <类型 = 整数>
            keyCount = ipKeys.取个数 ()
            如果 (keyCount > 0)
            {
                计次循环 (keyCount)
                {
                    变量 k <类型 = 文本型>
                    k = ipKeys.取数据 (取循环索引 ())
                    变量 oldCount <类型 = 整数>
                    oldCount = IP速率限制字典.取整数值 (k)
                    如果 (oldCount > MCP_常量.速率限制_衰减因子)
                    {
                        IP速率限制字典.置整数值 (k, oldCount / MCP_常量.速率限制_衰减因子)
                    }
                    否则
                    {
                        IP速率限制字典.移除 (k)
                    }
                }
            }
            IP速率_当前分钟桶 = 当前分钟桶
        }
        // 获取当前IP计数
        变量 IP计数器 <类型 = 整数>
        IP计数器 = IP速率限制字典.取整数值 (客户端地址)
        IP计数器 = IP计数器 + 1
        IP速率限制字典.置整数值 (客户端地址, IP计数器)
        如果 (IP计数器 > 速率限制_每分钟)
        {
            变量 触发IP <类型 = 文本型>
            触发IP = 客户端地址
            变量 触发计数 <类型 = 整数>
            触发计数 = IP计数器
            异步缓存锁.解锁 ()
            // 日志移出锁外: 控制台I/O可能阻塞
            控制台输出 (到文本 ("[MCP] IP速率限制触发:") + 到文本 (触发IP) + "计数器:" + 到文本 (触发计数))
            返回 (假)
        }
        异步缓存锁.解锁 ()
        返回 (真)
    }

    # ======== 构建命令注册表 (字典预查找, 避免线性if-else) ==========
    # v2.8: 辅助方法 — 自动注册 browser.xxx + browser_xxx 双变体, 减少重复代码

    方法 注册命令双变体 <公开 静态 @输出名 = "RegisterCommandDualVariant" @强制输出 = 真>
    参数 命令名基 <类型 = 文本型 注释 = "不含browser前缀的基名, 如 navigate" @输出名 = "CommandNameBase">
    参数 命令ID <类型 = 整数 @输出名 = "CommandID">
    参数 注册短名 <类型 = 逻辑型 注释 = "是否同时注册不含browser_前缀的短别名" @默认值 = 真 @输出名 = "RegisterShortName">
    {
        命令注册表.置整数值 ("browser." + 命令名基, 命令ID)
        命令注册表.置整数值 ("browser_" + 命令名基, 命令ID)
        如果 (注册短名)
        {
            命令注册表.置整数值 (命令名基, 命令ID)
        }
    }

