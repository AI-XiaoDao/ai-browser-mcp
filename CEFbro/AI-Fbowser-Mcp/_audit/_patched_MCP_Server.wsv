        添加工具JSON ("browser_vip_websocket_intercept", "WebSocket拦截(VIP)", 单参数Schema文本 ("enable", "boolean", "开关"))
        添加工具JSON ("browser_fill_set_value", "填表(原生CEF, 非JS注入): 设置输入元素的值| selector 未命中时直接报错(不再假成功), 无需先调 fill_exists", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("value", "text", "值"), "\"selector\",\"value\""))
        添加工具JSON ("browser_fill_click", "填表(原生CEF, 非JS注入): 点击元素| selector 未命中时直接报错(不再假成功)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_fill_focus", "填表(原生CEF): 让元素获得焦点", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_fill_scroll", "填表(原生CEF): 滚动到元素所在位置", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_fill_exists", "填表(原生CEF): 判断元素是否存在| 异步返回, 用 mcp_result 取 exists 布尔值", 单参数Schema文本 ("selector", "text", "CSS选择器"))
        添加工具JSON ("browser_fill_attr_get", "填表(原生CEF): 取元素属性值| 省略 attribute 则返回元素文本(textContent); 默认同步返回, 取不到会报错", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("attribute", "text", "属性名"), "\"selector\",\"attribute\""))
添加工具JSON ("browser_fill_get_text", "填表(原生CEF/CDP): 取元素 **innerText**(渲染后可见文本, 受 CSS 影响) | 与既有工具的区别: browser_fill_attr_get(不传 attribute) 取的是 **textContent**(原始文本, 含隐藏元素), browser_dom_inner_html 取的是 **innerHTML**(含标签) —— 三者语义不同不可互替 | 元素不存在会明确报错(不返回空串冒充)", 单参数Schema文本 ("selector", "text", "CSS选择器"))
添加工具JSON ("browser_fill_set_text", "填表(原生CEF/CDP): 设置元素 **innerText**(渲染后文本; 会按纯文本处理, 不解析 HTML) | 与既有工具的区别: browser_dom_set_html 写 innerHTML(解析HTML), browser_dom_set_value 写 .value(表单控件) —— 设置普通元素的可见文本请用本工具 | 写后**回读验证**, 未确认会如实报失败", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("text", "text", "要设置的文本(显式传空串表示清空)"), "\"selector\",\"text\""))
        添加工具JSON ("browser_fill_attr_set", "填表(原生CEF): 设置元素属性| 已禁用 href/src/action/formaction 与 on* 事件属性", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("attribute", "text", "属性名") + "," + 属性项JSON ("value", "text", "属性值"), "\"selector\""))
        添加工具JSON ("browser_fill_trigger", "填表(原生CEF): 触发元素事件(默认 click)| 可绕过部分前端的手势/可信事件校验", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("event", "text", "事件类型"), "\"selector\""))
        添加工具JSON ("browser_fill_select", "填表: 设置 <select> 选中项| 优先按 value 走原生 setter 并冒泡 input/change(兼容 React 受控组件)", 多属性Schema文本 (属性项JSON ("selector", "text", "CSS选择器") + "," + 属性项JSON ("value", "text", "选项值"), "\"selector\""))
        添加工具JSON ("mcp_status", "MCP服务器状态")
        添加工具JSON ("mcp_help", "帮助信息| 不带参数返回按功能域分类的工具清单; 传 tool 参数则返回该工具的完整描述与参数 schema, 例: mcp_help tool=browser_navigate")
        添加工具JSON ("mcp_result", "查询异步任务结果", 多属性Schema文本 (属性项JSON ("request_id", "text", "任务ID或JSON-RPC id") + "," + 属性项JSON ("consume", "boolean", "读取后删除(默认false)"), "\"request_id\""))
