    # ======== 异步响应辅助 / UX sync-wait (helper 在前, 命令成功_异步 见本段末尾) ==========
    # ======== UX: 服务端 sync-wait (一次调用返回结果) ==========
    # 默认对轻量读/写工具内聚轮询; async_only:true 可恢复旧异步行为

    方法 规范化工具名 <公开 静态 类型 = 文本型 @输出名 = "NormalizeToolName" @强制输出 = 真>
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    {
        变量 名 <类型 = 文本型>
        名 = 方法名
        如果 (名 == "")
        {
            返回 ("")
        }
        子文本替换 (名, "browser.", "browser_", , , 真)
        如果 (是否以 (名, "browser_") == 假)
        {
            名 = "browser_" + 名
        }
        返回 (名)
    }

    方法 应同步等待 <公开 静态 类型 = 逻辑型 @输出名 = "ShouldSyncWait" @强制输出 = 真>
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        如果 (参数JSON.是否为空 () == 假)
        {
            如果 (yyjson取逻辑 (参数JSON, "async_only"))
            {
                返回 (假)
            }
            如果 (yyjson取逻辑 (参数JSON, "sync_wait"))
            {
                // 自托管死锁防护优先于显式sync_wait: 目标为本服务器页面时仍降级异步(否则必超时)
                变量 强同步目标 <类型 = 文本型>
                强同步目标 = yyjson取文本 (参数JSON, "url")
                如果 (强同步目标 != "" && 是否本机自托管URL (强同步目标))
                {
                    返回 (假)
                }
                返回 (真)
            }
        }
        变量 规范名 <类型 = 文本型>
        规范名 = 规范化工具名 (方法名)
        如果 (规范名 == "browser_navigate" || 规范名 == "browser_reload")
        {
            // 与分派实现一致: wait_for_load 默认真 (布尔false/文本false/0关闭); async_only跳过同步等待
            // 修复: 原用 取文本 比较文本"false"/"0", 布尔节点取文本为空导致 wait_for_load:false 仍同步等待
            变量 等待载入 <类型 = 逻辑型>
            等待载入 = 真
            如果 (参数JSON.是否为空 () == 假)
            {
                等待载入 = yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                如果 (yyjson取逻辑 (参数JSON, "async_only"))
                {
                    返回 (假)
                }
            }
            如果 (等待载入 == 假)
            {
                返回 (假)
            }
            // 自托管死锁防护: 同步等待期间服务器(单线程事件循环)无法服务自托管页面, 等待必然超时;
            // 目标/当前页面为本服务器页面时降级为异步(task_id轮询, load_end后任务仍会正常完成)
            如果 (规范名 == "browser_navigate")
            {
                变量 目标URL <类型 = 文本型>
                目标URL = yyjson取文本 (参数JSON, "url")
                如果 (目标URL != "" && 是否本机自托管URL (目标URL))
                {
                    返回 (假)
                }
            }
            否则
            {
                变量 自托管浏览器 <类型 = 类_FBrowser_浏览器>
                自托管浏览器 = 取主浏览器 ()
                如果 (自托管浏览器.是否为空 () == 假)
                {
                    变量 自托管框架 <类型 = 类_FBrowser_框架>
                    自托管框架 = 自托管浏览器.取主框架 ()
                    如果 (自托管框架.是否为空 () == 假 && 自托管框架.是否有效 () && 是否本机自托管URL (自托管框架.取地址 ()))
                    {
                        返回 (假)
                    }
                }
            }
            返回 (真)
        }
        如果 (规范名 == "browser_get_title" || 规范名 == "browser_evaluate" || 规范名 == "browser_execute_js" || 规范名 == "browser_console_eval")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_get_url" || 规范名 == "browser_get_id" || 规范名 == "browser_status")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_is_loading" || 规范名 == "browser_is_muted" || 规范名 == "browser_can_navigate" || 规范名 == "browser_get_zoom")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_loading_info" || 规范名 == "browser_popup_info" || 规范名 == "browser_window_info")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_dom_query" || 规范名 == "browser_dom_set_value" || 规范名 == "browser_dom_click")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_dom_inner_html" || 规范名 == "browser_dom_checked" || 规范名 == "browser_dom_selected" || 规范名 == "browser_dom_rect")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_get_frames" || 规范名 == "browser_frame_names")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_fill_exists" || 规范名 == "browser_fill_attr_get" || 规范名 == "browser_fill_set_value" || 规范名 == "browser_fill_click")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_get_cookies" || 规范名 == "browser_get_all_cookies")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_screenshot")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_get_source")
        {
            如果 (参数JSON.是否为空 () == 假)
            {
                变量 srcMC <类型 = 整数>
                srcMC = yyjson取整数 (参数JSON, "max_chars")
                如果 (srcMC <= 0 || srcMC > MCP_常量.截断_源码默认字节)
                {
                    srcMC = MCP_常量.截断_源码默认字节
                }
                如果 (srcMC < 65536)
                {
                    返回 (真)
                }
            }
            返回 (假)
        }
        如果 (规范名 == "browser_debugger_wait_paused" || 规范名 == "browser_debugger_last_paused" || 规范名 == "browser_debugger_inspect" || 规范名 == "browser_debugger_flow" || 规范名 == "browser_debugger_script_source" || 规范名 == "browser_debugger_auto")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_debugger_enable" || 规范名 == "browser_debugger_set_breakpoint" || 规范名 == "browser_debugger_evaluate" || 规范名 == "browser_debugger_stack" || 规范名 == "browser_debugger_resume" || 规范名 == "browser_debugger_step_over" || 规范名 == "browser_debugger_step_into" || 规范名 == "browser_debugger_step_out")
        {
            返回 (真)
        }
        // browser_cdp 与 browser_cdp_call 是**同一件事的两个入口**(均为通用 CDP 直通, 分支体近乎逐字相同),
        // 但原先只有 cdp_call 在名单里 -> 同一个 Runtime.evaluate, 走 cdp_call 拿得到结果,
        // 走 browser_cdp 只回一句"CDP已提交:Runtime.evaluate"(第98轮台账把它记成 pass, 实为假通过)。
        // 两者行为必须一致, 故一并纳入。
        如果 (规范名 == "browser_cdp_call" || 规范名 == "browser_cdp" || 规范名 == "browser_cdp_event" || 规范名 == "browser_event")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_get_text" || 规范名 == "browser_dom_get_html")
        {
            如果 (参数JSON.是否为空 () == 假)
            {
                变量 sel <类型 = 文本型>
                sel = yyjson取文本 (参数JSON, "selector")
                如果 (sel != "")
                {
                    返回 (真)
                }
            }
            返回 (假)
        }
        // 第100轮: 这些工具**本来就要把数据交回调用方**(取HTML/选中项/链接/源码/页面结构/Cookie),
        // 却因为不在此名单内, 只回一句"已提交" + poll_hint, 逼调用方再调一次 mcp_result ——
        // 与"一次调用就成功"直接冲突。它们都不是长耗时操作, 故一并纳入同步等待
        // (同步等待由中央统一实现: 回执->轮询任务->转成正常响应; 超时会给出可行动提示)。
        // 注: browser_dom_get_html 在上面那组(browser_get_text 一行)里已有, 此处不重复列。
        // browser_scrape 在第100轮曾因"同步后回空串"被撤回; 其根因(转换器不读工具专属键)已修,
        // 且 取工具结果键名 已为它补上 text 映射, 故本轮重新纳入。
        如果 (规范名 == "browser_dom_select" || 规范名 == "browser_extract" || 规范名 == "browser_view_source" || 规范名 == "browser_scrape")
        {
            返回 (真)
        }
        如果 (规范名 == "browser_vip_dom_get_document" || 规范名 == "browser_vip_dom_search" || 规范名 == "browser_reverse_cookie_sources")
        {
            返回 (真)
        }
        // 注入类: 调用方紧接着就要用"已注入"这一前提去读页面, 故同样等它落地再返回
        如果 (规范名 == "browser_inject" || 规范名 == "browser_dom_set_html" || 规范名 == "browser_canvas_noise" || 规范名 == "browser_permission_spoof")
        {
            返回 (真)
        }
        // 历史导航: 与 navigate/reload 同款 —— 等 load_end 落地再返回
        // (实测 load_end 确实会为 back/forward 触发, 见报告 §123; 不纳入的话调用方还得自己轮询)
        如果 (规范名 == "browser_back" || 规范名 == "browser_forward")
        {
            返回 (真)
        }
        返回 (假)
    }

    方法 取同步等待毫秒 <公开 静态 类型 = 整数 @输出名 = "GetSyncWaitMs" @强制输出 = 真>
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        如果 (参数JSON.是否为空 () == 假)
        {
            变量 自定义 <类型 = 整数>
            自定义 = yyjson取整数 (参数JSON, "max_ms")
            如果 (自定义 > 0)
            {
                如果 (自定义 > 300000)
                {
                    自定义 = 300000  // 修复: 上限5分钟, 防客户端传极大值(约24天)长期阻塞执行线程
                }
                返回 (自定义)
            }
        }
        变量 规范名 <类型 = 文本型>
        规范名 = 规范化工具名 (方法名)
        如果 (规范名 == "browser_navigate" || 规范名 == "browser_reload")
        {
            返回 (30000)
        }
        如果 (规范名 == "browser_get_url" || 规范名 == "browser_get_id" || 规范名 == "browser_status")
        {
            返回 (MCP_常量.同步等待_即时毫秒)
        }
        如果 (规范名 == "browser_is_loading" || 规范名 == "browser_is_muted" || 规范名 == "browser_can_navigate" || 规范名 == "browser_get_zoom")
        {
            返回 (MCP_常量.同步等待_即时毫秒)
        }
        如果 (规范名 == "browser_loading_info" || 规范名 == "browser_popup_info" || 规范名 == "browser_window_info")
        {
            返回 (MCP_常量.同步等待_即时毫秒)
        }
        如果 (规范名 == "browser_get_title" || 规范名 == "browser_evaluate" || 规范名 == "browser_execute_js" || 规范名 == "browser_console_eval")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_dom_query" || 规范名 == "browser_dom_set_value" || 规范名 == "browser_dom_click")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_dom_inner_html" || 规范名 == "browser_dom_checked" || 规范名 == "browser_dom_selected" || 规范名 == "browser_dom_rect")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_fill_exists" || 规范名 == "browser_fill_attr_get" || 规范名 == "browser_fill_set_value" || 规范名 == "browser_fill_click")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_get_cookies" || 规范名 == "browser_get_all_cookies")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_screenshot" || 规范名 == "browser_get_source")
        {
            返回 (MCP_常量.同步等待_截图毫秒)
        }
        如果 (规范名 == "browser_debugger_flow")
        {
            返回 (60000)
        }
        如果 (规范名 == "browser_debugger_auto")
        {
            返回 (300000)
        }
        如果 (规范名 == "browser_debugger_wait_paused")
        {
            返回 (45000)
        }
        如果 (规范名 == "browser_debugger_inspect" || 规范名 == "browser_debugger_script_source" || 规范名 == "browser_debugger_enable" || 规范名 == "browser_debugger_set_breakpoint" || 规范名 == "browser_debugger_evaluate" || 规范名 == "browser_debugger_stack" || 规范名 == "browser_debugger_resume" || 规范名 == "browser_debugger_step_over" || 规范名 == "browser_debugger_step_into" || 规范名 == "browser_debugger_step_out")
        {
            返回 (20000)
        }
        // 与 应同步等待 保持一致: browser_cdp 与 browser_cdp_call 共用同一预算
        如果 (规范名 == "browser_cdp_call" || 规范名 == "browser_cdp" || 规范名 == "browser_cdp_event" || 规范名 == "browser_event")
        {
            返回 (30000)
        }
        // 与 应同步等待 保持一致: 取数据类用快读预算, 注入类放宽些(要等它真正落地)
        如果 (规范名 == "browser_dom_get_html" || 规范名 == "browser_dom_select" || 规范名 == "browser_extract" || 规范名 == "browser_view_source" || 规范名 == "browser_vip_dom_get_document" || 规范名 == "browser_vip_dom_search" || 规范名 == "browser_reverse_cookie_sources")
        {
            返回 (MCP_常量.同步等待_快读毫秒)
        }
        如果 (规范名 == "browser_inject" || 规范名 == "browser_dom_set_html" || 规范名 == "browser_canvas_noise" || 规范名 == "browser_permission_spoof")
        {
            返回 (20000)
        }
        // 与 应同步等待 保持一致
        如果 (规范名 == "browser_back" || 规范名 == "browser_forward")
        {
            返回 (20000)
        }
        返回 (MCP_常量.同步等待_默认毫秒)
    }

    方法 取工具结果键名 <公开 静态 类型 = 文本型 @输出名 = "GetToolResultKeyName" @强制输出 = 真>
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    {
        变量 规范名 <类型 = 文本型>
        规范名 = 规范化工具名 (方法名)
        如果 (规范名 == "browser_get_title")
        {
            返回 ("title")
        }
        如果 (规范名 == "browser_get_source")
        {
            返回 ("source")
        }
        如果 (规范名 == "browser_get_text")
        {
            返回 ("text")
        }
        如果 (规范名 == "browser_dom_get_html")
        {
            返回 ("html")
        }
        如果 (规范名 == "browser_get_frames")
        {
            返回 ("frames")
        }
        如果 (规范名 == "browser_frame_names")
        {
            返回 ("names")
        }
        如果 (规范名 == "browser_get_url")
        {
            返回 ("url")
        }
        如果 (规范名 == "browser_is_loading")
        {
            返回 ("loading")
        }
        如果 (规范名 == "browser_is_muted")
        {
            返回 ("muted")
        }
        如果 (规范名 == "browser_get_zoom")
        {
            返回 ("zoom")
        }
        如果 (规范名 == "browser_get_id")
        {
            返回 ("id")
        }
        如果 (规范名 == "browser_screenshot")
        {
            返回 ("image")
        }
        如果 (规范名 == "browser_get_cookies" || 规范名 == "browser_get_all_cookies")
        {
            返回 ("cookies")
        }
        如果 (规范名 == "browser_dom_inner_html")
        {
            返回 ("html")
        }
        如果 (规范名 == "browser_dom_checked")
        {
            返回 ("checked")
        }
        如果 (规范名 == "browser_dom_selected")
        {
            返回 ("selected")
        }
        如果 (规范名 == "browser_dom_rect")
        {
            返回 ("rect")
        }
        如果 (规范名 == "browser_fill_exists")
        {
            返回 ("exists")
        }
        如果 (规范名 == "browser_fill_attr_get")
        {
            返回 ("value")
        }
        // 爬虫的最终载荷把数据放在 text 键(实测: {"success":true,"text":"Example Domain"}),
        // 既不是 message 也不是 result; 没有这条映射时 将异步结果转为命令响应 读不到数据。
        如果 (规范名 == "browser_scrape")
        {
            返回 ("text")
        }
        返回 ("result")
    }

     # ======== 协议锁让出 (同步等待专用) ========
     # 修复(P0): 原先整个同步等待都持有 协议锁(见 处理MCP请求 处注释"本地桌面客户端均为
     # 请求-响应同步模式, 串行化无吞吐损失"), 实测该假设不成立: 一个 20s 的 debugger_enable
     # 会把并发的 browser_get_url 从 0.01s 拖到 15s 超时(**放大 753 倍**),
     # 而 Claude/GPT 的 parallel tool use 是标配。
     # 调用前提: 调用方此时**不持有 MCP执行锁**(两个等待循环都已先释放), 故睡眠期间无任何其它锁。
     # 全项目锁序恒为 协议锁 → MCP执行锁 → 异步缓存锁, 放锁不引入反向获取。
     # 请求级静态上下文(追踪ID / id是否数值 / 紧凑响应模式)为并发请求共享, 放锁前保存、取回后恢复。

    方法 协议锁让出延时 <公开 静态 @输出名 = "YieldProtocolLockDelay" @强制输出 = 真>
    参数 毫秒 <类型 = 整数 @输出名 = "Ms">
    {
        变量 保存追踪ID <类型 = 文本型>
        变量 保存ID是数值 <类型 = 逻辑型>
        变量 保存紧凑 <类型 = 逻辑型>
        变量 保存进度令牌 <类型 = 文本型>
        变量 保存推送通道 <类型 = 文本型>
        变量 保存推送连接 <类型 = 整数>
        保存追踪ID = 当前请求追踪ID
        保存ID是数值 = 当前请求ID是数值
        保存紧凑 = 紧凑响应模式
        保存进度令牌 = 当前进度令牌
        保存推送通道 = 当前推送通道
        保存推送连接 = 当前推送连接ID
        协议锁.解锁 ()
        延时 (毫秒)
        协议锁.加锁 ()
        当前请求追踪ID = 保存追踪ID
        当前请求ID是数值 = 保存ID是数值
        紧凑响应模式 = 保存紧凑
        当前进度令牌 = 保存进度令牌
        当前推送通道 = 保存推送通道
        当前推送连接ID = 保存推送连接
    }

    # ======== 企业级: 长任务进度上报 (notifications/progress) ========
    # 客户端在 tools/call 的 params._meta.progressToken 给出令牌后, 服务端在长等待期间按节流推送。
    # 推送通道: stdio(双向流) 与 WebSocket —— 二者可直接向客户端推送。
    #           HTTP POST 为纯请求-响应, 无推送通道(需 Streamable HTTP 的 GET /mcp SSE),
    #           此时静默不推 —— 规范中 progress 为可选, 客户端不得依赖其存在。
    # 节流: 距上次推送不足 500ms 直接返回, 避免轮询循环把通道刷爆。
    # 参数: 已完成/总数 用于客户端画进度条; 消息 为可选的人类可读说明。
    方法 上报进度 <公开 静态 @输出名 = "ReportProgress" @强制输出 = 真>
    参数 已完成 <类型 = 长整数 @输出名 = "ProgressDone">
    参数 总数 <类型 = 长整数 @默认值 = 0 @输出名 = "ProgressTotal">
    参数 消息 <类型 = 文本型 @默认值 = "" @输出名 = "ProgressMessage">
    {
        如果 (当前进度令牌 == "" || 当前推送通道 == "")
        {
            返回
        }
        变量 现在 <类型 = 长整数>
        现在 = 取启动时间 ()
        如果 (现在 - 上次进度推送毫秒 < 500)
        {
            返回
        }
        上次进度推送毫秒 = 现在
        变量 进度参数 <类型 = YYJSON对象类>
        进度参数.创建自文本 ("{}")
        进度参数.加入文本成员 ("progressToken", 当前进度令牌)
        进度参数.加入长整数成员 ("progress", 已完成)
        如果 (总数 > 0)
        {
            进度参数.加入长整数成员 ("total", 总数)
        }
        如果 (消息 != "")
        {
            进度参数.加入文本成员 ("message", 消息)
        }
        变量 帧 <类型 = 文本型>
        帧 = "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":" + 进度参数.到可读文本 (YYJSON格式化选项.压缩) + "}"
        如果 (当前推送通道 == "stdio")
        {
            MCPStdio桥.写入一行 (帧)
        }
        否则 (当前推送通道 == "ws")
        {
            如果 (MCP服务器实例.是否为空 () == 假 && 当前推送连接ID > 0)
            {
                变量 帧字节 <类型 = 字节集类>
                帧字节 = 文本到UTF8 (帧, 假)
                如果 (取字节集长度 (帧字节) > 0)
                {
                    MCP服务器实例.发送WebSocket数据 (当前推送连接ID, 取字节集指针 (帧字节), 取字节集长度 (帧字节))
                }
            }
        }
        @ InterlockedIncrement64((LONGLONG volatile*)&@<指标_进度通知数>);
    }

    方法 同步等待异步任务 <公开 静态 类型 = 文本型 @输出名 = "SyncWaitAsyncTask" @强制输出 = 真>
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    参数 最大毫秒 <类型 = 整数 @输出名 = "MaxMs">
    参数 轮询间隔毫秒 <类型 = 整数 @默认值 = MCP_常量.同步等待_轮询间隔 @输出名 = "PollIntervalMs">
    {
        如果 (任务ID == "")
        {
            返回 ("")
        }
        变量 截止 <类型 = 长整数>
        截止 = 取启动时间 () + 最大毫秒
        变量 连续空轮询 <类型 = 整数 值 = 0>
                // (追踪ID / id是否数值 / 紧凑响应模式 是并发请求共享的静态上下文, 放锁前存、取回后恢复)
        判断循环 (取启动时间 () < 截止)
        {
            如果 (MCP正在关闭)
            {
                返回 ("")
            }
            如果 (MCP_编排分派.工作流应停止)
            {
                返回 (MCP_响应构建.构建标准失败JSON ("工作流已停止"))
            }
            变量 存储结果 <类型 = 文本型>
            MCP执行锁.解锁 ()
            存储结果 = 查询异步结果 (任务ID)
            MCP执行锁.加锁 ()
            如果 (存储结果 != "")
            {
                连续空轮询 = 0
                变量 结果解析 <类型 = YYJSON只读对象类>
                如果 (结果解析.创建自文本 (存储结果))
                {
                    如果 (结果解析.取逻辑值 ("_waiting") == 假)
                    {
                        // 锁已在本循环内重新获取, 直接返回让调用者统一解锁
                        返回 (存储结果)
                    }
                }
                否则
                {
                    // 锁已在本循环内重新获取, 直接返回让调用者统一解锁
                    返回 (存储结果)
                }
            }
            MCP执行锁.解锁 ()
            连续空轮询 = 连续空轮询 + 1
            // ③ 快速退避: 首轮即时检查(0ms) → 10ms → 30ms → 100ms → 300ms
            // 大多数异步结果在 1-10ms 内就绪, 首轮无延迟可大幅降低 sync-wait 响应时间
            变量 当前延迟 <类型 = 整数>
            如果 (连续空轮询 <= 1)
            {
                当前延迟 = 0  // 首轮即时, 仅做 yield
            }
            否则 (连续空轮询 <= 5)
            {
                当前延迟 = 10
            }
            否则 (连续空轮询 <= 15)
            {
                当前延迟 = 30
            }
            否则 (连续空轮询 <= 35)
            {
                当前延迟 = 100
            }
            否则
            {
                当前延迟 = 300
            }
            // 企业级: 长任务进度上报 (客户端给了 progressToken 且通道可推送时才实际发出)
            上报进度 (取启动时间 () - (截止 - 最大毫秒), (长整数)最大毫秒, "等待异步任务结果")
            // 让出协议锁再睡眠 —— 详见 协议锁让出延时 的注释
            协议锁让出延时 (当前延迟)
            MCP执行锁.加锁 ()
        }
        // 超时: 循环最后一次迭代已重新加锁后退出, 直接返回让调用者统一解锁
        返回 ("")
    }

    # P0-3: JS 回调 message 语义失败检测 (dom_click / dom_set_value 等)

    方法 JS消息是否表示失败 <公开 静态 类型 = 逻辑型 @输出名 = "JSMessageIsTableShowFailure" @强制输出 = 真>
    参数 消息文本 <类型 = 文本型 @输出名 = "MessageText">
    参数 工具名 <类型 = 文本型 @默认值 = "" @输出名 = "ToolName">
    {
        如果 (消息文本 == "")
        {
            返回 (假)
        }
        变量 规范名 <类型 = 文本型>
        规范名 = 规范化工具名 (工具名)
        如果 (规范名 == "browser_fill_exists")
        {
            返回 (假)
        }
        如果 (是否以 (消息文本, "Error:") || 是否以 (消息文本, "Error: ") || 是否以 (消息文本, "Uncaught ") || 是否以 (消息文本, "SyntaxError") || 是否以 (消息文本, "TypeError") || 是否以 (消息文本, "ReferenceError") || 是否以 (消息文本, "RangeError"))
        {
            返回 (真)
        }
        如果 (寻找文本 (消息文本, "element not found", 0, 假) != -1)
        {
            返回 (真)
        }
        // 修复(探测发现): 原将 dom_query/dom_get_html 的 "null" 值判定为失败——
        // 但 取元素内容 对 body 等非输入元素返回 null 属正常语义(元素无value内容),
        // 导致同步查询 body/title 恒 isError "null"; 元素不存在由上方 element not found 独立拦截
        // 移除后 null 值按 success 返回, 客户端自行判空(空值≠查询失败)
        如果 (是否以 (消息文本, "{"))
        {
            变量 inner <类型 = YYJSON只读对象类>
            如果 (inner.创建自文本 (消息文本))
            {
                // {ok:false} 仅对DOM/填表工具有效, 避免误判正常JSON返回值
                如果 (规范名 == "browser_dom_set_value" || 规范名 == "browser_dom_click" || 规范名 == "browser_dom_get_html" || 是否以 (规范名, "browser_fill_"))
                {
                    如果 (inner.取逻辑值 ("ok") == 假)
                    {
                        返回 (真)
                    }
                }
                如果 (inner.取逻辑值 ("found") == 假 && 规范名 == "browser_wait")
                {
                    返回 (假)
                }
            }
        }
        返回 (假)
    }

    # P0-1: 统一 async 等待 — 含 browser_wait(_waiting) 与 mcp_result 状态机推进

    方法 内容是否JSON结构 <公开 静态 类型 = 逻辑型 @输出名 = "ContentIsJSONStructure" @强制输出 = 真>
    参数 文本 <类型 = 文本型 @输出名 = "Text">
    {
        如果 (文本 == "")
        {
            返回 (假)
        }
        变量 验证对象 <类型 = YYJSON只读对象类>
        如果 (是否以 (文本, "{"))
        {
            返回 (验证对象.创建自文本 (文本))
        }
        如果 (是否以 (文本, "["))
        {
            变量 包装 <类型 = 文本型>
            包装 = "{\"_a\":" + 文本 + "}"
            如果 (验证对象.创建自文本 (包装) == 假)
            {
                返回 (假)
            }
            返回 (验证对象.取数组 ("_a").是否为空对象 () == 假)
        }
        返回 (假)
    }

    方法 等待异步任务完成 <公开 静态 类型 = 文本型 @输出名 = "WaitAsyncTaskDone" @强制输出 = 真>
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    参数 最大毫秒 <类型 = 整数 @输出名 = "MaxMs">
    参数 命令ID前缀 <类型 = 文本型 @输出名 = "CommandIDPrefix">
    参数 工具名 <类型 = 文本型 @默认值 = "" @输出名 = "ToolName">
    参数 轮询间隔毫秒 <类型 = 整数 @默认值 = MCP_常量.同步等待_轮询间隔 @输出名 = "PollIntervalMs">
    {
        如果 (任务ID == "")
        {
            返回 ("")
        }
        变量 开始 <类型 = 长整数>
        开始 = 取启动时间 ()
        变量 截止 <类型 = 长整数>
        截止 = 开始 + 最大毫秒
        变量 轮询序 <类型 = 整数 值 = 0>
                变量 pollParams <类型 = YYJSON对象类>
        pollParams.创建自文本 ("{}")
        pollParams.加入文本成员 ("request_id", 任务ID)
        pollParams.加入逻辑值成员 ("consume", 假)
        变量 pollParse <类型 = YYJSON只读对象类>
        pollParse.创建自文本 (pollParams.到可读文本 (YYJSON格式化选项.压缩))
        判断循环 (取启动时间 () < 截止)
        {
            如果 (MCP正在关闭)
            {
                返回 ("")
            }
            如果 (MCP_编排分派.工作流应停止)
            {
                返回 (MCP_响应构建.构建标准失败JSON ("工作流已停止"))
            }
            变量 存储结果 <类型 = 文本型>
            存储结果 = 查询异步结果 (任务ID)
            如果 (存储结果 != "")
            {
                变量 存储解析 <类型 = YYJSON只读对象类>
                如果 (存储解析.创建自文本 (存储结果))
                {
                    如果 (存储解析.取逻辑值 ("_waiting") == 假)
                    {
                        返回 (存储结果)
                    }
                }
                否则
                {
                    返回 (存储结果)
                }
            }
            轮询序 = 轮询序 + 1
            // ③ 快速退避: 0ms → 10ms → 30ms → 100ms → 300ms
            变量 当前轮询延迟 <类型 = 整数>
            如果 (轮询序 <= 1)
            {
                当前轮询延迟 = 0
            }
            否则 (轮询序 <= 5)
            {
                当前轮询延迟 = 10
            }
            否则 (轮询序 <= 15)
            {
                当前轮询延迟 = 30
            }
            否则 (轮询序 <= 35)
            {
                当前轮询延迟 = 100
            }
            否则
            {
                当前轮询延迟 = 300
            }
            变量 pollResult <类型 = 文本型>
            pollResult = 执行浏览器命令 (命令ID前缀 + "_mr" + 到文本 (轮询序), "mcp_result", pollParse)
            变量 pollObj <类型 = YYJSON只读对象类>
            如果 (pollObj.创建自文本 (pollResult))
            {
                变量 pollSuccess <类型 = 逻辑型>
                pollSuccess = pollObj.取逻辑值 ("success")
                变量 pollErr <类型 = 文本型>
                pollErr = yyjson取文本 (pollObj, "error")
                如果 (pollSuccess == 假)
                {
                    如果 (寻找文本 (pollErr, "未找到任务结果", 0, 假) != -1)
                    {
                        协议锁让出延时 (当前轮询延迟)
                        到循环尾
                    }
                    返回 (pollResult)
                }
                如果 (pollObj.取逻辑值 ("_waiting"))
                {
                    协议锁让出延时 (当前轮询延迟)
                    到循环尾
                }
                变量 pollMsg <类型 = 文本型>
                pollMsg = yyjson取文本 (pollObj, "message")
                如果 (寻找文本 (pollMsg, "等待中", 0, 假) != -1)
                {
                    协议锁让出延时 (当前轮询延迟)
                    到循环尾
                }
                存储结果 = 查询异步结果 (任务ID)
                如果 (存储结果 != "")
                {
                    变量 再解析 <类型 = YYJSON只读对象类>
                    如果 (再解析.创建自文本 (存储结果) && 再解析.取逻辑值 ("_waiting") == 假)
                    {
                        返回 (存储结果)
                    }
                }
                返回 (pollResult)
            }
            // 企业级: 长任务进度上报 (工具名可帮助客户端区分是哪个调用在等待)
            上报进度 (取启动时间 () - (截止 - 最大毫秒), (长整数)最大毫秒, "等待异步任务结果: " + 工具名)
            协议锁让出延时 (当前轮询延迟)
        }
        返回 ("")
    }

    方法 将异步结果转为命令响应 <公开 静态 类型 = 文本型 @输出名 = "ConvertAsyncResultToCommandResponse" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    参数 结果键名 <类型 = 文本型 @输出名 = "ResultKeyName">
    参数 已等待毫秒 <类型 = 整数 @默认值 = 0 @输出名 = "HasWaitMs">
    参数 工具名 <类型 = 文本型 @默认值 = "" @输出名 = "ToolName">
    {
        变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (存储JSON) == 假)
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "异步结果解析失败"))
        }
        如果 (结果解析.取逻辑值 ("success") == 假)
        {
            变量 err <类型 = 文本型>
            err = yyjson取文本 (结果解析, "error")
            如果 (err == "")
            {
                err = yyjson取文本 (结果解析, "result")
            }
            如果 (err == "")
            {
                err = yyjson取文本 (结果解析, "message")
            }
            如果 (err == "")
            {
                err = "异步任务失败"
            }
            变量 规范工具 <类型 = 文本型>
            规范工具 = 规范化工具名 (工具名)
            如果 (规范工具 == "")
            {
                规范工具 = 规范化工具名 (当前命令方法名)
            }
            如果 (规范工具 == "browser_debugger_set_breakpoint" && 寻找文本 (err, "already exists", 0, 假) != -1)
            {
                // 断点已存在视为成功
            }
            否则
            {
                返回 (MCP_响应构建.命令失败 (命令ID, err))
            }
        }
        变量 内容 <类型 = 文本型>
        内容 = yyjson取文本 (结果解析, "message")
        如果 (内容 == "")
        {
            内容 = yyjson取文本 (结果解析, "result")
        }
        如果 (内容 == "")
        {
            内容 = yyjson取文本 (结果解析, "error")
        }
        // 有些工具的载荷把数据放在**工具专属键**下(如 browser_scrape 的 text), 既不是 message 也不是
        // result; 而调用方已把该键名经 取工具结果键名 传了进来 —— 这里必须真的按它取值, 否则同步路径
        // 会把数据静默读成空串(实测 browser_scrape 纳入同步后回 "" —— 比原来的"回执+poll_hint"更差)。
        如果 (内容 == "" && 结果键名 != "" && 结果键名 != "result")
        {
            内容 = yyjson取文本 (结果解析, 结果键名)
        }
        变量 语义工具 <类型 = 文本型>
        语义工具 = 工具名
        如果 (语义工具 == "")
        {
            语义工具 = 当前命令方法名
        }
        如果 (JS消息是否表示失败 (内容, 语义工具))
        {
            返回 (MCP_响应构建.命令失败 (命令ID, 内容))
        }
        如果 (内容是否JSON结构 (内容))
        {
            变量 响应头 <类型 = YYJSON对象类>
            响应头.创建自文本 ("{}")
            响应头.加入文本成员 ("id", 命令ID)
            响应头.加入逻辑值成员 ("success", 真)
            响应头.加入逻辑值成员 ("_sync_waited", 真)
            如果 (已等待毫秒 > 0)
            {
                响应头.加入整数成员 ("_elapsed_ms", 已等待毫秒)
            }
            变量 头JSON <类型 = 文本型>
            头JSON = 响应头.到可读文本 (YYJSON格式化选项.压缩)
            变量 响应JSON <类型 = 文本型>
            响应JSON = 取文本左边 (头JSON, 取文本长度 (头JSON) - 1)
            如果 (结果键名 != "" && 结果键名 != "result")
            {
                响应JSON = 响应JSON + ",\"" + 结果键名 + "\":" + 内容
            }
            响应JSON = 响应JSON + ",\"message\":\"" + MCP_响应构建.JSON转义文本 (内容) + "\""
            如果 (结果键名 == "result" || 结果键名 == "")
            {
                响应JSON = 响应JSON + ",\"result\":" + 内容
            }
            响应JSON = 响应JSON + "}"
            返回 (响应JSON)
        }
        变量 响应 <类型 = YYJSON对象类>
        响应.创建自文本 ("{}")
        响应.加入文本成员 ("id", 命令ID)
        响应.加入逻辑值成员 ("success", 真)
        响应.加入逻辑值成员 ("_sync_waited", 真)
        如果 (已等待毫秒 > 0)
        {
            响应.加入整数成员 ("_elapsed_ms", 已等待毫秒)
        }
        如果 (结果键名 != "" && 结果键名 != "result")
        {
            响应.加入文本成员 (结果键名, 内容)
        }
        响应.加入文本成员 ("message", 内容)
        如果 (结果键名 == "result" || 结果键名 == "")
        {
            响应.加入文本成员 ("result", 内容)
        }
        返回 (响应.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 尝试同步跟随异步响应 <公开 静态 类型 = 文本型 @输出名 = "TrySyncFollowAlongAsyncResponse" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 响应JSON <类型 = 文本型 @输出名 = "ResponseJSON">
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    参数 强制同步 <类型 = 逻辑型 @默认值 = 假 @输出名 = "ForceSync">
    参数 需放锁等待 <类型 = 逻辑型 注释 = "调用方持有MCP执行锁时传真(如batch子命令), 等待期间放锁让并发命令执行; 未持锁(如tools/call)必须传假, 否则无主解锁破坏锁" @默认值 = 假 @输出名 = "NeedReleaseLockWait">
    {
        变量 响应解析 <类型 = YYJSON只读对象类>
        如果 (响应解析.创建自文本 (响应JSON) == 假)
        {
            返回 (响应JSON)
        }
        如果 (响应解析.取逻辑值 ("_async") == 假 || 响应解析.取逻辑值 ("_sync_waited"))
        {
            返回 (响应JSON)
        }
        如果 (强制同步 == 假)
        {
            如果 (参数JSON.是否为空 () == 假 && yyjson取逻辑 (参数JSON, "async_only"))
            {
                返回 (响应JSON)
            }
            如果 (应同步等待 (方法名, 参数JSON) == 假)
            {
                返回 (响应JSON)
            }
        }
        变量 任务ID <类型 = 文本型>
        任务ID = yyjson取文本 (响应解析, "task_id")
        如果 (任务ID == "")
        {
            返回 (响应JSON)
        }
        变量 开始 <类型 = 长整数>
        开始 = 取启动时间 ()
        变量 最大毫秒 <类型 = 整数>
        最大毫秒 = 取同步等待毫秒 (方法名, 参数JSON)
        变量 存储 <类型 = 文本型>
        如果 (需放锁等待)
        {
            MCP执行锁.解锁 ()
            存储 = 等待异步任务完成 (任务ID, 最大毫秒, 命令ID, 方法名)
            MCP执行锁.加锁 ()
        }
        否则
        {
            存储 = 等待异步任务完成 (任务ID, 最大毫秒, 命令ID, 方法名)
        }
        如果 (存储 == "")
        {
            如果 (MCP正在关闭)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_服务正在关闭))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "⏱ 操作超时(" + 到文本 (最大毫秒 / 1000) + "s) | task_id=" + 任务ID + " | 页面可能较慢, 请: ①增大max_ms重试 ②设async_only:true改异步 ③用mcp_result轮询"))
        }
        返回 (将异步结果转为命令响应 (命令ID, 存储, 取工具结果键名 (方法名), (整数)(取启动时间 () - 开始), 方法名))
    }

    # ======== 数据库统计 — /health 与 mcp_status 的运维指标 ========

    方法 取数据库统计JSON <公开 静态 类型 = 文本型 @输出名 = "GetDataLibCountJSON" @强制输出 = 真>
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回 ("")
        }
        变量 统计JSON <类型 = 文本型>
        统计JSON = ""
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT (SELECT COUNT(*) FROM async_results) AS a, (SELECT COUNT(*) FROM event_log) AS e, (SELECT COUNT(*) FROM response_cache) AS r", )
        如果 (记录集.执行语句 () == 100)
        {
            // 文本拼接返回 JSON 片段, 规避yyjson嵌套限制
            统计JSON = "{\"async_results\":" + 到文本 (记录集.读长整数数据 (0)) + ",\"event_log\":" + 到文本 (记录集.读长整数数据 (1)) + ",\"response_cache\":" + 到文本 (记录集.读长整数数据 (2)) + "}"
        }
        记录集.释放 ()
        异步缓存锁.解锁 ()
        返回 (统计JSON)
    }

    方法 命令成功_异步 <公开 静态 类型 = 文本型 @输出名 = "CommandSuccessAsync" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    参数 消息 <类型 = 文本型 @输出名 = "Message">
    参数 预估耗时毫秒 <类型 = 整数 @默认值 = 0 @输出名 = "EstimatedElapsedMs">
    {
        如果 (应同步等待 (当前命令方法名, 当前命令参数JSON))
        {
            // 放锁等待窗口内并发请求会覆写静态的当前命令方法名/参数, 先固化局部副本
            变量 本方法名 <类型 = 文本型>
            本方法名 = 当前命令方法名
            变量 本参数JSON <类型 = YYJSON只读对象类>
            本参数JSON = 当前命令参数JSON
            变量 开始 <类型 = 长整数>
            开始 = 取启动时间 ()
            变量 最大毫秒 <类型 = 整数>
            最大毫秒 = 取同步等待毫秒 (本方法名, 本参数JSON)
            变量 存储 <类型 = 文本型>
            MCP执行锁.解锁 ()
            存储 = 等待异步任务完成 (任务ID, 最大毫秒, 命令ID, 本方法名)
            MCP执行锁.加锁 ()
            如果 (存储 != "")
            {
                返回 (将异步结果转为命令响应 (命令ID, 存储, 取工具结果键名 (本方法名), (整数)(取启动时间 () - 开始), 本方法名))
            }
            如果 (MCP正在关闭)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_服务正在关闭))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "⏱ 操作超时(" + 到文本 (最大毫秒 / 1000) + "s) | task_id=" + 任务ID + " | 页面可能较慢, 请: ①增大max_ms重试 ②设async_only:true改异步 ③用mcp_result轮询"))
        }
        变量 对象 <类型 = YYJSON对象类>
        对象.创建自文本 ("{}")
        对象.加入文本成员 ("id", 命令ID)
        对象.加入逻辑值成员 ("success", 真)
        对象.加入逻辑值成员 ("_async", 真)
        对象.加入文本成员 ("task_id", 任务ID)
        对象.加入文本成员 ("message", 消息)
        如果 (预估耗时毫秒 > 0)
        {
            对象.加入整数成员 ("estimated_ms", 预估耗时毫秒)
        }
        对象.加入文本成员 ("poll_hint", "用 mcp_result 轮询: mcp_result {request_id: \"" + 任务ID + "\", consume: true}")
        返回 (对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    # ======== 全部异步执行 — 永不阻塞, 结果存入磁盘缓存 ==========
    # 任务提交 → CEF回调触发 → 存储异步结果(内存+磁盘) → 客户端通过mcp_result查询

    方法 提交异步JS任务 <公开 静态 类型 = 文本型 @输出名 = "SubmitAsyncJSTask" @强制输出 = 真>
    参数 browser <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    参数 code <类型 = 文本型 @输出名 = "Code">
    参数 任务ID <类型 = 文本型 @默认值 = "" @输出名 = "TaskID">
    {
        变量 安全框架 <类型 = 类_FBrowser_框架>
        安全框架 = 取安全主框架 (browser)
        如果 (安全框架.是否为空 () || 安全框架.是否有效 () == 假)
        {
            返回 (MCP_响应构建.构建简单错误JSON (MCP_常量.错误_主框架无效))
        }
        // 全部异步: 自动生成taskID
        如果 (任务ID == "")
        {
            任务ID = 生成异步任务ID ()
        }
        异步执行JS (browser, code, 任务ID)
        返回 (MCP_响应构建.构建异步提交JSON (任务ID))
    }

    方法 提交异步取源码任务 <公开 静态 类型 = 文本型 @输出名 = "SubmitAsyncGetSourceTask" @强制输出 = 真>
    参数 browser <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    参数 任务ID <类型 = 文本型 @默认值 = "" @输出名 = "TaskID">
    参数 最大字符数 <类型 = 整数 @默认值 = MCP_常量.截断_源码默认字节 @输出名 = "MaxChars">
    {
        变量 安全框架 <类型 = 类_FBrowser_框架>
        安全框架 = 取安全主框架 (browser)
        如果 (安全框架.是否为空 () || 安全框架.是否有效 () == 假)
        {
            返回 (MCP_响应构建.构建简单错误JSON (MCP_常量.错误_主框架无效))
        }
        如果 (任务ID == "")
        {
            任务ID = 生成异步任务ID ()
        }
        异步取源码_带限制 (browser, 任务ID, 最大字符数)
        返回 (MCP_响应构建.构建异步提交JSON (任务ID))
    }

