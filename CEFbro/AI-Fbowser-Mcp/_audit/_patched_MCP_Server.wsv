    # ======== 加载等待任务 (browser_navigate / browser_reload 共用的 wait_for_load) ==========

    方法 注册加载等待任务 <公开 静态 类型 = 文本型 注释 = "注册load_end等待任务, 供browser_navigate/browser_reload的wait_for_load参数共用" @输出名 = "RegisterLoadWaitTask" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    参数 browser <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    参数 上下文消息 <类型 = 文本型 @输出名 = "ContextMessage">
    参数 返回消息 <类型 = 文本型 @输出名 = "ReturnMessage">
    参数 导航发起毫秒 <类型 = 长整数 注释 = "本次载入地址()/重新载入()调用前的取启动时间, 用于判序load_end是否属于本次导航" @默认值 = 0 @输出名 = "NavigateStartMs">
    {
        变量 等待任务ID <类型 = 文本型>
        等待任务ID = 生成异步任务ID ()
        变量 等待存储 <类型 = YYJSON对象类>
        等待存储.创建自文本 ("{}")
        等待存储.加入逻辑值成员 ("_waiting", 真)
        等待存储.加入文本成员 ("what", "load_end")
        变量 maxMs <类型 = 整数>
        maxMs = yyjson取整数 (参数JSON, "max_ms")
        如果 (maxMs <= 0)
        {
            maxMs = 30000
        }
        等待存储.加入文本成员 ("message", 上下文消息)
        等待存储.加入整数成员 ("max_ms", maxMs)
        等待存储.加入长整数成员 ("start_time", 取启动时间 ())
        等待存储.加入整数成员 ("_poll_count", 0)
        等待存储.加入整数成员 ("_browser_id", browser.取ID ())
        等待存储.加入逻辑值成员 ("_event_driven", 真)
        存储异步结果 (等待任务ID, 等待存储.到可读文本 (YYJSON格式化选项.压缩))
        // 防竞态补查: 载入地址()后OnLoadEnd可能先于本注册完成(快速缓存页), 若页面已加载完立即写完成结果
        // 修复(同步等待提前返回根因): 原条件"未在加载"会在载入地址()已发出而OnLoadStart尚未到达时误判,
        // 导致wait_for_load立即返回未完成的提交消息; 现仅当本次导航发起后确实发生过load_end(时间戳>=导航发起毫秒)
        // 时才视为已加载完, 其余情况交OnLoadEnd事件驱动解析
        // 注: 不得用"主框架地址==目标URL"判完成 — CEF在导航提交瞬间就更新框架地址(load尚未结束), 会再次提前返回;
        // 同址导航的即时返回改由browser_navigate调用方在载入地址()前判等处理
        变量 补查通过 <类型 = 逻辑型 值 = 假>
        如果 (浏览器容器.取加载状态 () == 假 && 导航发起毫秒 > 0 && 浏览器容器.取最后载入结束毫秒 () >= 导航发起毫秒)
        {
            补查通过 = 真
        }
        如果 (补查通过)
        {
            变量 立完成 <类型 = YYJSON对象类>
            立完成.创建自文本 ("{}")
            立完成.加入逻辑值成员 ("success", 真)
            立完成.加入文本成员 ("message", 返回消息)
            存储异步结果 (等待任务ID, 立完成.到可读文本 (YYJSON格式化选项.压缩))
        }
        返回 (命令成功_异步 (命令ID, 等待任务ID, 返回消息))
    }

    # ======== yyjson 安全取值 ==========

    方法 yyjson取文本 <公开 静态 类型 = 文本型 @输出名 = "YyjsonGetText" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 () == 假)
        {
            返回 (JSON对象.取文本 (键名))
        }
        返回 ("")
    }

    方法 yyjson取整数 <公开 静态 类型 = 整数 @输出名 = "YyjsonGetInt" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 () == 假)
        {
            // 修复(参数类型容错): 底层 取整数 只认 JSON 数值节点 —— 文本节点("100")与布尔节点
            // 一律返回 0。而 AI 客户端常把整数写成字符串, 于是工具落进错误分支却照样返回 success。
            // 真机实测: browser_scroll_by {"y":"100"} -> y 读成 0 -> 命中 y==0 兜底 -> 真的滚了 800px;
            //           browser_dom_set_value {"allow_empty":true} -> 读成 0 -> 无法清空字段。
            // 这里按节点实际类型归一化; 键缺失/空值仍返回 0(保持原语义)。
            变量 成员对象 <类型 = YYJSON只读对象类>
            成员对象 = JSON对象.取对象 (键名)
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 成员对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.文本值)
            {
                // 非数值文本经 文本到整数 得 0, 与原行为一致(不会把垃圾变成有效值)
                返回 (文本到整数 (删首尾空 (成员对象.到文本 ())))
            }
            如果 (节点类型 == YYJSON值类型.逻辑值)
            {
                如果 (成员对象.到逻辑值 ())
                {
                    返回 (1)
                }
                返回 (0)
            }
            返回 (JSON对象.取整数 (键名))
        }
        返回 (0)
    }

    方法 yyjson取小数 <公开 静态 类型 = 小数 @输出名 = "YyjsonGetFloat" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 () == 假)
        {
            // 修复(同 yyjson取整数): 文本/布尔节点归一化, 否则 "1.5" 会读成 0。
            // 反向影响亦已确认: browser_vip_fingerprint_geolocation 的 lat/lng 在 schema 里声明为
            // text 却用 取小数 读取, 于是**按 schema 正确传参**的调用方也会被静默置成 (0,0)。
            变量 成员对象 <类型 = YYJSON只读对象类>
            成员对象 = JSON对象.取对象 (键名)
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 成员对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.文本值)
            {
                返回 (文本到小数 (删首尾空 (成员对象.到文本 ())))
            }
            如果 (节点类型 == YYJSON值类型.逻辑值)
            {
                如果 (成员对象.到逻辑值 ())
                {
                    返回 (1)
                }
                返回 (0)
            }
            返回 (JSON对象.取小数 (键名))
        }
        返回 (0)
    }

    方法 yyjson取长整数 <公开 静态 类型 = 长整数 @输出名 = "YyjsonGetInt64" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 () == 假)
        {
            // 修复(同 yyjson取整数): 文本/布尔节点归一化
            变量 成员对象 <类型 = YYJSON只读对象类>
            成员对象 = JSON对象.取对象 (键名)
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 成员对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.文本值)
            {
                返回 (文本到长整数 (删首尾空 (成员对象.到文本 ())))
            }
            如果 (节点类型 == YYJSON值类型.逻辑值)
            {
                如果 (成员对象.到逻辑值 ())
                {
                    返回 (1)
                }
                返回 (0)
            }
            返回 (JSON对象.取长整数 (键名))
        }
        返回 (0)
    }

    方法 yyjson取逻辑 <公开 静态 类型 = 逻辑型 @输出名 = "YyjsonGetLogic" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 () == 假)
        {
            // 修复(参数类型容错): 底层 取逻辑值 只认真正的 JSON 布尔节点 —— 字符串 "true"/"1"、
            // 乃至数值 1, 全部返回 假。于是 AI 客户端把布尔写成字符串时会执行**相反**的分支,
            // 且照样返回 success。真机实测: browser_fingerprint_online {"value":"true"}
            // -> 实际按 false 应用(navigator.onLine 仍为 false)却报"已设置"。
            // 同类高危: {"mute":"true"} 会变成取消静音、{"focus":"true"} 会变成失去焦点。
            // 这里按节点类型归一化; 键缺失/空值仍返回 假(破坏性默认由各工具自行加守卫)。
            变量 成员对象 <类型 = YYJSON只读对象类>
            成员对象 = JSON对象.取对象 (键名)
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 成员对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.逻辑值)
            {
                返回 (成员对象.到逻辑值 ())
            }
            如果 (节点类型 == YYJSON值类型.数值)
            {
                返回 (成员对象.到小数 () != 0)
            }
            如果 (节点类型 == YYJSON值类型.文本值)
            {
                变量 节点文本 <类型 = 文本型>
                节点文本 = 到小写 (删首尾空 (成员对象.到文本 ()))
                如果 (节点文本 == "true" || 节点文本 == "1" || 节点文本 == "真" || 节点文本 == "yes" || 节点文本 == "on")
                {
                    返回 (真)
                }
                // 未识别的文本按假处理(与修复前对所有非布尔节点的行为一致, 保守不放大)
                返回 (假)
            }
            返回 (JSON对象.取逻辑值 (键名))
        }
        返回 (假)
    }

    # ==== 覆盖写成员: 修复"同名键被重复追加"导致的**状态机永久卡死** ====
    # 根因(已由类库源码 + 本机 SQLite 双重确认):
    #   YYJSON对象类.加入整数成员/加入文本成员 映射到 yyjson_mut_obj_add_* ,
    #   语义是"在尾部加入**新的**成员", **不覆盖**同名键; 而读取用的 取整数/取文本
    #   映射到 yyjson_obj_get, 对重复键返回**第一个**(即旧值)。
    #   于是本项目大量使用的
    #       对象.创建自文本 (已存JSON);  对象.加入整数成员 ("_phase", 新值);  存储 (...)
    #   会把旧值留在前面, 读回永远是旧值 -> 阶段机永远推进不了。
    # 实机证据(mcp_cache.db 的 async_results 一行原样):
    #   {"_phase":0, ..., "_phase":3,"_extract_task_id":"...94",
    #     "_phase":3,"_extract_task_id":"...95", ... }   <- _phase 出现 9 次
    #   后果: browser_scrape 永远停在 phase 0/2, 每轮轮询都重新提交一次提取子任务,
    #   直到超时报错(db_async_results 每轮 +2)。
    # 修法: 写回状态键前先 删除成员(删掉该键的**所有**值) 再追加。
    # 注: 这也顺带清理已被污染的旧行 —— 第一次写回即把重复键全部删除。

    方法 覆盖整数成员 <公开 静态 类型 = 逻辑型 注释 = "覆盖写整数成员: 先删除该键的所有值再追加, 避免重复键导致读回旧值" @输出名 = "OverwriteIntMember" @强制输出 = 真>
    参数 对象 <类型 = YYJSON对象类 @输出名 = "TargetObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    参数 值 <类型 = 整数 @输出名 = "Value">
    {
        如果 (对象.是否为空 ())
        {
            返回 (假)
        }
        对象.删除成员 (键名)
        返回 (对象.加入整数成员 (键名, 值))
    }

    方法 覆盖文本成员 <公开 静态 类型 = 逻辑型 注释 = "覆盖写文本成员: 先删除该键的所有值再追加, 避免重复键导致读回旧值" @输出名 = "OverwriteTextMember" @强制输出 = 真>
    参数 对象 <类型 = YYJSON对象类 @输出名 = "TargetObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    参数 值 <类型 = 文本型 @输出名 = "Value">
    {
        如果 (对象.是否为空 ())
        {
            返回 (假)
        }
        对象.删除成员 (键名)
        返回 (对象.加入文本成员 (键名, 值))
    }

    # ==== 参数键存在性判断(区分"未传"与"传了假值") ====
    # 为什么需要它: MCP 客户端的 required 只是元数据, 服务端**不校验**,
    # 所以"缺参"就会退化成 yyjson 的默认值(0/假/""), 让状态改变类工具执行**另一个动作**。
    # 实机证据(本机真跑): browser_set_zoom {} -> "缩放(持久): 0", 且 browser_get_zoom 读回 0
    #   —— 缩放被清 0 并**持久作用于所有新窗口**;
    #   browser_mouse_click {} -> "VIP点击 (0,0)" —— 真的在 (0,0) 点了一下;
    #   browser_antidetect_presets {} -> 部署 stealth 预设(持久生效)。
    # 注意: 缺失键的节点类型**不只**是 未知 —— 本项目自己的 yyjson取逻辑_默认 就同时判
    #   (空值 || 未知) 两种。只判 未知 会让 Core:524 把"未传"误当"显式传 0"。
    # 故本方法把 未知/空值 一并视为"不存在"。

    方法 参数键存在 <公开 静态 类型 = 逻辑型 注释 = "判断参数对象里是否**真的**提供了该键(未传/显式空值 均视为未提供)" @输出名 = "ParamKeyExists" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 ())
        {
            返回 (假)
        }
        // 兜底1(不依赖任何键查找): 参数对象本身一个成员都没有 —— 那就不可能"提供了该键"。
        如果 (JSON对象.取成员数 () <= 0)
        {
            返回 (假)
        }
        // 兜底2(最终判据): 在**序列化文本**里按 `"键名":` 精确查找。
        // 为什么不用库里的存在性 API —— 实测两条路都不可靠:
        //   · 取对象(键名): 缺失键返回"假节点", 是否为空() 为假、取类型() 也不是 未知/空值;
        //    · 取路径对象("/键名") + 是否为空(): 本机实测**对缺失键仍判为"存在"**
        //      (browser_set_window_style {type:-12} 缺 style、browser_mouse_wheel {x,y} 缺 delta
        //       两个用例都因此没拦住), 只有"空对象"这种情况被兜底1 挡住了。
        // 序列化文本判据只依赖 寻找文本(项目内已多处使用), 对"键是否真的出现"是直接的。
        // 已知取舍: 若某个**值字符串**里恰好含 `"键名":` 会误判为存在 —— 方向上属于"放行",
        // 不会误拒合法调用(误拒才是更糟的失败方向)。
        变量 参数文本 <类型 = 文本型>
        参数文本 = JSON对象.到可读文本 (YYJSON格式化选项.压缩)
        如果 (寻找文本 (参数文本, "\"" + 键名 + "\":", 0, 真) == -1)
        {
            返回 (假)
        }
        返回 (真)
    }

    # 读取逻辑参数 (兼容真布尔/文本/数值), 成员不存在时返回默认值
    # 判别法: 取对象(键名)后 到文本() 归一化为文本比较 — 缺失键节点到文本为空串, 与假节点("false")可区分

    方法 yyjson取逻辑_默认 <公开 静态 类型 = 逻辑型 @输出名 = "YyjsonGetLogicDefault" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    参数 默认值 <类型 = 逻辑型 @输出名 = "Default2">
    {
        // ★ 修(系统性缺陷, 影响全部"默认值=假"的读取点): 缺失键必须先判"键是否真的存在"。
        //   原实现靠 `取对象(键名).取类型() == 未知` 来回落到默认值, 但**本机实测该分支永不成立** ——
        //   缺失键返回的是一个"假节点", 其 取类型() 既不是 未知 也不是 空值(同一结论早已写在
        //   参数键存在 的注释里: "缺失键返回假节点, 是否为空() 为假、取类型() 也不是 未知/空值";
        //   当时只修了存在性判定, 没修这里)。后果: 缺键时一律返回**真**, 于是所有"默认假"的开关被反转。
        //   实测两例: ① browser_debugger_wait_paused 的 fresh(默认假)→被当真→每次都把"正要等的
        //   暂停事件"清掉, 工具永远报"等超时"(A/B 对照: 不调它时暂停能稳定存活 11s 以上);
        //   ② browser_reverse_network_conditions 的 offline(默认假)→被当真, 响应里直接写 "offline=true"。
        //   修在这里(而不是逐个调用点)是因为 9 个调用点都会受益, 且不会再有新调用点踩坑。
        如果 (参数键存在 (JSON对象, 键名) == 假)
        {
            返回 (默认值)
        }
        // 修复: 到文本()对布尔/数值节点返回空串, 原字符串归一化判别对非文本节点失效;
        // 改用 取类型() 按节点类型取值 (布尔/数值/文本分别处理, 缺失键类型=未知回默认)
        如果 (JSON对象.是否为空 () == 假)
        {
            变量 成员对象 <类型 = YYJSON只读对象类>
            成员对象 = JSON对象.取对象 (键名)
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 成员对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.逻辑值)
            {
                返回 (成员对象.到逻辑值 ())
            }
            如果 (节点类型 == YYJSON值类型.数值)
            {
                返回 (成员对象.到小数 () != 0)
            }
            如果 (节点类型 == YYJSON值类型.文本值)
            {
                变量 节点文本 <类型 = 文本型>
                节点文本 = 成员对象.到文本 ()
                如果 (节点文本 == "true" || 节点文本 == "1" || 节点文本 == "真")
                {
                    返回 (真)
                }
                如果 (节点文本 == "false" || 节点文本 == "0" || 节点文本 == "假")
                {
                    返回 (假)
                }
                如果 (节点文本 == "")
                {
                    返回 (默认值)
                }
                // 其他非空文本: 按非空视为真
                返回 (真)
            }
            如果 (节点类型 == YYJSON值类型.空值 || 节点类型 == YYJSON值类型.未知)
            {
                返回 (默认值)
            }
            // 对象/数组: 非空视为真
            返回 (真)
        }
        返回 (默认值)
    }

    # 安全取对象成员: 缺失键返回空引用 (取对象对缺失键返回假节点, 是否为空判存在会误判)

    方法 yyjson取对象成员_安全 <公开 静态 类型 = YYJSON只读对象类 @输出名 = "YyjsonGetObjectMemberSafe" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        变量 子对象 <类型 = YYJSON只读对象类>
        子对象 = JSON对象.取对象 (键名)
        如果 (子对象.是否为空 () == 假)
        {
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 子对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.对象值 || 节点类型 == YYJSON值类型.数组值)
            {
                返回 (子对象)
            }
        }
        变量 空引用 <类型 = YYJSON只读对象类>
        返回 (空引用)
    }

    # 取 object 型成员 (batch arguments / tools/call params 等)

    方法 yyjson取对象成员 <公开 静态 类型 = YYJSON只读对象类 @输出名 = "YyjsonGetObjectMember" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        变量 默认JSON对象 <类型 = YYJSON只读对象类>
        如果 (JSON对象.是否为空 () == 假)
        {
            返回 (JSON对象.取对象 (键名))
        }
        返回 (默认JSON对象)
    }

    # 字符串优先; 否则序列化 object/array 为 JSON 文本 (兼容 MCP 客户端传 object 参数)

    方法 yyjson取JSON文本 <公开 静态 类型 = 文本型 @输出名 = "YyjsonGetJSONText" @强制输出 = 真>
    参数 JSON对象 <类型 = YYJSON只读对象类 @输出名 = "JSONObject">
    参数 键名 <类型 = 文本型 @输出名 = "KeyName">
    {
        如果 (JSON对象.是否为空 ())
        {
            返回 ("")
        }
        变量 文本值 <类型 = 文本型>
        文本值 = JSON对象.取文本 (键名)
        如果 (文本值 != "")
        {
            返回 (文本值)
        }
        // 注意: 取对象/取数组 对缺失键返回假节点(是否为空=假且成员数>0), 必须用取类型判别真容器
        变量 子对象 <类型 = YYJSON只读对象类>
        子对象 = JSON对象.取对象 (键名)
        如果 (子对象.是否为空 () == 假)
        {
            变量 节点类型 <类型 = YYJSON值类型>
            节点类型 = 子对象.取类型 ()
            如果 (节点类型 == YYJSON值类型.对象值 || 节点类型 == YYJSON值类型.数组值)
            {
                返回 (子对象.到可读文本 (YYJSON格式化选项.压缩))
            }
        }
        变量 子数组 <类型 = YYJSON只读数组类>
        子数组 = JSON对象.取数组 (键名)
        如果 (子数组.是否为空对象 () == 假 && 子数组.取成员数 () > 0)
        {
            返回 (子数组.到可读文本 (YYJSON格式化选项.压缩))
        }
        返回 ("")
    }

    # ======== 文本辅助 ==========

    方法 简单转义JS <公开 静态 类型 = 文本型 注释 = "转义文本以便安全嵌入单引号JS字符串(\'...\')。双引号上下文请用 JSON转义文本。" @输出名 = "SimpleEscapeJS" @强制输出 = 真>
    参数 原始文本 <类型 = 文本型 @输出名 = "RawText">
    {
        如果 (原始文本 == "")
        {
            返回 ("")
        }
        // == 转义映射表 (单引号JS字符串上下文) ==
        // 注意: 转义顺序至关重要! 反斜杠 必须先替换, 否则后续替换引入的反斜杠会被二次转义
        常量 JS_ESC_NULL <类型 = 文本型 值 = "\0">
        常量 JS_ESC_BSLASH <类型 = 文本型 值 = "\\">
        常量 JS_ESC_SQUOTE <类型 = 文本型 值 = "'">
        常量 JS_ESC_BTICK <类型 = 文本型 值 = "`">
        常量 JS_ESC_NEWLINE <类型 = 文本型 值 = "\n">
        常量 JS_ESC_CR <类型 = 文本型 值 = "\r">
        常量 JS_ESC_TAB <类型 = 文本型 值 = "\t">
        常量 JS_ESC_FF <类型 = 文本型 值 = "\f">
        常量 JS_ESC_VTAB <类型 = 文本型 值 = "\v">
        常量 JS_ESC_SCRIPT <类型 = 文本型 值 = "</script>">
        // 转义目标值
        常量 JS_REP_NULL <类型 = 文本型 值 = "">
        常量 JS_REP_BSLASH <类型 = 文本型 值 = "\\\\">
        常量 JS_REP_SQUOTE <类型 = 文本型 值 = "\\'">
        常量 JS_REP_BTICK <类型 = 文本型 值 = "\\`">
        常量 JS_REP_NEWLINE <类型 = 文本型 值 = "\\n">
        常量 JS_REP_CR <类型 = 文本型 值 = "\\r">
        常量 JS_REP_TAB <类型 = 文本型 值 = "\\t">
        常量 JS_REP_FF <类型 = 文本型 值 = "\\f">
        常量 JS_REP_VTAB <类型 = 文本型 值 = "\\v">
        常量 JS_REP_SCRIPT <类型 = 文本型 值 = "<\\/script>">
        变量 结果 <类型 = 文本型>
        结果 = 原始文本
        // 1. 安全: 去除null字节(可截断C字符串)
        子文本替换 (结果, JS_ESC_NULL, JS_REP_NULL, , , 假)
        // 2. 反斜杠 — 必须最先替换!
        子文本替换 (结果, JS_ESC_BSLASH, JS_REP_BSLASH)
        // 3. 单引号 — 在 '...' 字面量中破坏字符串
        子文本替换 (结果, JS_ESC_SQUOTE, JS_REP_SQUOTE)
        // 4. 反引号 — 防止模板字符串注入
        子文本替换 (结果, JS_ESC_BTICK, JS_REP_BTICK)
        // 5. 控制字符 — 保持JS字面量合法
        子文本替换 (结果, JS_ESC_NEWLINE, JS_REP_NEWLINE)
        子文本替换 (结果, JS_ESC_CR, JS_REP_CR)
        子文本替换 (结果, JS_ESC_TAB, JS_REP_TAB)
        子文本替换 (结果, JS_ESC_FF, JS_REP_FF)
        子文本替换 (结果, JS_ESC_VTAB, JS_REP_VTAB)
        // 6. HTML注入防护
        子文本替换 (结果, JS_ESC_SCRIPT, JS_REP_SCRIPT)
        // 注: " 不转义 (单引号JS字面量中无需), $ 不转义 (避免破坏jQuery等)
        返回 (结果)
    }

    # ======== 拦截辅助 ==========

    # 添加资源替换规则到全局文本存储 (配合 browser_intercept 事件Hook通道)

    方法 裁剪规则文本到最大行数 <公开 静态 类型 = 文本型 @输出名 = "TrimRuleTextToMaxLineCount" @强制输出 = 真>
    参数 规则文本 <类型 = 文本型 @输出名 = "RuleText">
    参数 最大行数 <类型 = 整数 @输出名 = "MaxLineCount">
    {
        如果 (规则文本 == "" || 最大行数 <= 0)
        {
            返回 (规则文本)
        }
        变量 行数组 <类型 = 文本数组类>
        分割文本 (规则文本, "\n", 行数组, 真, 假)
        变量 行数 <类型 = 整数>
        行数 = 行数组.取成员数 ()
        如果 (行数 <= 最大行数)
        {
            返回 (规则文本)
        }
        // 超限淘汰最旧规则: 显式日志, 避免静默消失
        控制台输出 ("[MCP] 拦截规则超限: 已淘汰最旧 " + 到文本 (行数 - 最大行数) + " 条规则 (当前上限 " + 到文本 (最大行数) + " 条)")
        变量 结果 <类型 = 文本型>
        结果 = ""
        变量 起始 <类型 = 整数>
        起始 = 行数 - 最大行数
        计次循环 (最大行数)
        {
            变量 idx <类型 = 整数>
            idx = 起始 + 取循环索引 ()
            如果 (结果 == "")
            {
                结果 = 行数组.取成员 (idx)
            }
            否则
            {
                结果 = 结果 + "\n" + 行数组.取成员 (idx)
            }
        }
        返回 (结果)
    }

    方法 追加导航拦截规则 <公开 静态 @输出名 = "AppendNavigateInterceptRule" @强制输出 = 真>
    参数 新行 <类型 = 文本型 @输出名 = "NewLine">
    {
        如果 (新行 == "")
        {
            返回
        }
        // 与UI线程的导航拦截匹配并发: 加规则锁防撕裂读写
        规则锁.加锁 ()
        如果 (导航拦截规则 == "")
        {
            导航拦截规则 = 新行
        }
        否则
        {
            导航拦截规则 = 导航拦截规则 + "\n" + 新行
        }
        导航拦截规则 = 裁剪规则文本到最大行数 (导航拦截规则, MCP_常量.拦截规则最大行数)
        规则锁.解锁 ()
    }

    # 修复(竞态): 导航拦截在CEF回调线程直读 导航拦截规则, 与MCP线程写(规则锁)并发会撕裂读;
    # 统一走持锁快照, 拦截逻辑基于局部副本

    方法 取导航规则快照 <公开 静态 类型 = 文本型 @输出名 = "GetNavigateRuleSnapshot" @强制输出 = 真>
    {
        变量 快照 <类型 = 文本型>
        规则锁.加锁 ()
        快照 = 导航拦截规则
        规则锁.解锁 ()
        返回 (快照)
    }

    # 规则字段转义: 百分号编码 (字段内永不出现分隔符|与换行, 与 规则字段反转义 对称)

    方法 规则字段转义 <公开 静态 类型 = 文本型 @输出名 = "RuleFieldEscape" @强制输出 = 真>
    参数 源文本 <类型 = 文本型 @输出名 = "SourceText">
    {
        变量 转义结果 <类型 = 文本型>
        转义结果 = 源文本
        子文本替换 (转义结果, "%", "%25", , , 假)
        子文本替换 (转义结果, "|", "%7C", , , 假)
        子文本替换 (转义结果, "\n", "%0A", , , 假)
        子文本替换 (转义结果, "\r", "%0D", , , 假)
        返回 (转义结果)
    }

    # 规则字段反转义 (与 规则字段转义 对称, 逆序还原)

    方法 规则字段反转义 <公开 静态 类型 = 文本型 @输出名 = "RuleFieldUnescape" @强制输出 = 真>
    参数 源文本 <类型 = 文本型 @输出名 = "SourceText">
    {
        变量 还原结果 <类型 = 文本型>
        还原结果 = 源文本
        子文本替换 (还原结果, "%0D", "\r", , , 假)
        子文本替换 (还原结果, "%0A", "\n", , , 假)
        子文本替换 (还原结果, "%7C", "|", , , 假)
        子文本替换 (还原结果, "%25", "%", , , 假)
        返回 (还原结果)
    }

    方法 添加资源替换规则 <公开 静态 @输出名 = "AddResourceReplaceRule" @强制输出 = 真>
    参数 动作 <类型 = 文本型 @输出名 = "Action">
    参数 规则URL <类型 = 文本型 @输出名 = "RuleURL">
    参数 搜索文本 <类型 = 文本型 @输出名 = "SearchText">
    参数 替换文本 <类型 = 文本型 @输出名 = "ReplaceText">
    参数 文件路径 <类型 = 文本型 @输出名 = "FilePath">
    参数 MIME类型 <类型 = 文本型 @输出名 = "MIMEType">
    {
        // 使用紧凑文本格式: action|url|search_text|replace_text|file_path (字段转义, 换行/竖线不破坏格式)
        变量 新行 <类型 = 文本型>
        新行 = 动作 + "|" + 规则字段转义 (规则URL)
        // 搜索/替换: 只要替换文本非空即写入 (replace_data 的数据存在替换文本段, 修复此前数据丢失)
        如果 (搜索文本 != "" || 替换文本 != "")
        {
            新行 = 新行 + "|" + 规则字段转义 (搜索文本) + "|" + 规则字段转义 (替换文本)
        }
        如果 (文件路径 != "")
        {
            新行 = 新行 + "|file:" + 规则字段转义 (文件路径)
        }
        规则锁.加锁 ()
        如果 (资源替换规则 == "")
        {
            资源替换规则 = 新行
        }
        否则
        {
            资源替换规则 = 资源替换规则 + "\n" + 新行
        }
        资源替换规则 = 裁剪规则文本到最大行数 (资源替换规则, MCP_常量.拦截规则最大行数)
        规则锁.解锁 ()
    }

    # 按 URL 撤销资源替换规则(与 匹配资源篡改规则 同口径: 请求URL包含规则URL 即命中), 返回删除条数。
    # 限定动作为空=删所有动作类; 传 "replace_file" 则只删文件替换类(供 unreplace 精确撤销)。

    方法 删除资源替换规则 <公开 静态 类型 = 整数 @输出名 = "DeleteResourceReplaceRule" @强制输出 = 真>
    参数 目标URL <类型 = 文本型 @输出名 = "TargetURL">
    参数 限定动作 <类型 = 文本型 @输出名 = "LimitAction">
    {
        // 空 URL 直接返回 0: 防止"空串子串匹配到全部"把规则误删光
        如果 (目标URL == "")
        {
            返回 (0)
        }
        变量 删除条数 <类型 = 整数>
        删除条数 = 0
        规则锁.加锁 ()
        如果 (资源替换规则 != "")
        {
            变量 保留行 <类型 = 文本型>
            保留行 = ""
            变量 行数组 <类型 = 文本数组类>
            分割文本 (资源替换规则, "\n", 行数组, 真, 假)
            计次循环 (行数组.取成员数 ())
            {
                变量 行文本 <类型 = 文本型>
                行文本 = 行数组.取成员 (取循环索引 ())
                变量 本行命中 <类型 = 逻辑型>
                本行命中 = 假
                如果 (行文本 != "")
                {
                    变量 段数组 <类型 = 文本数组类>
                    分割文本 (行文本, "|", 段数组, 假, 假)
                    如果 (段数组.取成员数 () >= 2)
                    {
                        变量 动作相符 <类型 = 逻辑型>
                        动作相符 = 真
                        如果 (限定动作 != "" && 段数组.取成员 (0) != 限定动作)
                        {
                            动作相符 = 假
                        }
                        如果 (动作相符)
                        {
                            // 存储时 URL 段是转义过的, 比较前必须反转义, 否则带 % | 的 URL 永远删不掉
                            变量 规则URL <类型 = 文本型>
                            规则URL = 规则字段反转义 (段数组.取成员 (1))
                            如果 (规则URL != "" && 寻找文本 (目标URL, 规则URL, 0, 假) != -1)
                            {
                                本行命中 = 真
                            }
                        }
                    }
                }
                如果 (本行命中)
                {
                    删除条数 = 删除条数 + 1
                }
                否则
                {
                    如果 (保留行 == "")
                    {
                        保留行 = 行文本
                    }
                    否则
                    {
                        保留行 = 保留行 + "\n" + 行文本
                    }
                }
            }
            资源替换规则 = 保留行
        }
        规则锁.解锁 ()
        返回 (删除条数)
    }

    # 手写篡改: 按URL匹配资源替换规则, 返回匹配JSON {action,search,replace,file} 或空文本

    方法 匹配资源篡改规则 <公开 静态 类型 = 文本型 @输出名 = "MatchResourceTamperRule" @强制输出 = 真>
    参数 目标URL <类型 = 文本型 @输出名 = "TargetURL">
    {
        如果 (目标URL == "")
        {
            返回 ("")
        }
        变量 匹配结果 <类型 = 文本型>
        匹配结果 = ""
        规则锁.加锁 ()
        如果 (资源替换规则 != "")
        {
            变量 行数组 <类型 = 文本数组类>
            分割文本 (资源替换规则, "\n", 行数组, 真, 假)
            计次循环 (行数组.取成员数 ())
            {
                变量 行文本 <类型 = 文本型>
                行文本 = 行数组.取成员 (取循环索引 ())
                如果 (行文本 == "")
                {
                    到循环尾
                }
                // 不修剪字段 (搜索/替换文本首尾空格有意义)
                变量 段数组 <类型 = 文本数组类>
                分割文本 (行文本, "|", 段数组, 假, 假)
                如果 (段数组.取成员数 () < 2)
                {
                    到循环尾
                }
                变量 规则动作 <类型 = 文本型>
                规则动作 = 段数组.取成员 (0)
                变量 规则URL <类型 = 文本型>
                规则URL = 规则字段反转义 (段数组.取成员 (1))
                // 子串匹配: 请求URL包含规则URL即命中
                如果 (规则URL != "" && 寻找文本 (目标URL, 规则URL, 0, 假) != -1)
                {
                    变量 匹配搜索 <类型 = 文本型>
                    变量 匹配替换 <类型 = 文本型>
                    变量 匹配文件 <类型 = 文本型>
                    匹配搜索 = ""
                    匹配替换 = ""
                    匹配文件 = ""
                    如果 (段数组.取成员数 () >= 3)
                    {
                        匹配搜索 = 规则字段反转义 (段数组.取成员 (2))
                    }
                    如果 (段数组.取成员数 () >= 4)
                    {
                        // 替换文本可能含分隔符"|"(已转义, 反转义前拼接还原)
                        变量 拼接段 <类型 = 文本型>
                        拼接段 = 段数组.取成员 (3)
                        如果 (段数组.取成员数 () > 4)
                        {
                            变量 拼接索引 <类型 = 整数>
                            拼接索引 = 4
                            判断循环 (拼接索引 < 段数组.取成员数 ())
                            {
                                拼接段 = 拼接段 + "|" + 段数组.取成员 (拼接索引)
                                拼接索引 = 拼接索引 + 1
                            }
                        }
                        匹配替换 = 规则字段反转义 (拼接段)
                    }
                    // file: 前缀仅对 replace_file 动作生效 (modify 搜索文本以 file: 开头不被吞)
                    如果 (规则动作 == "replace_file" && 匹配搜索 != "" && 是否以 (匹配搜索, "file:"))
                    {
                        // 0-based语义: "file:"前缀长5, 内容从索引5起
                        匹配文件 = 取文本中间 (匹配搜索, 5, 取文本长度 (匹配搜索) - 5)
                        匹配搜索 = ""
                    }
                    变量 匹配对象 <类型 = YYJSON对象类>
                    匹配对象.创建自文本 ("{}")
                    匹配对象.加入文本成员 ("action", 规则动作)
                    匹配对象.加入文本成员 ("search", 匹配搜索)
                    匹配对象.加入文本成员 ("replace", 匹配替换)
                    匹配对象.加入文本成员 ("file", 匹配文件)
                    匹配结果 = 匹配对象.到可读文本 (YYJSON格式化选项.压缩)
                    跳出循环
                }
            }
        }
        规则锁.解锁 ()
        返回 (匹配结果)
    }

    # 零手动接入: 构建Agent安装用的MCP配置JSON (与/cursor-config同源)

    方法 构建代理安装JSON <公开 静态 类型 = 文本型 @输出名 = "BuildProxyInstallJSON" @强制输出 = 真>
    {
        变量 桥接脚本路径 <类型 = 文本型>
        桥接脚本路径 = 取运行目录 ()
        如果 (取文本右边 (桥接脚本路径, 1) != "\\")
        {
            桥接脚本路径 = 桥接脚本路径 + "\\"
        }
        桥接脚本路径 = 桥接脚本路径 + "mcp_bridge.js"
        变量 配置文本 <类型 = 文本型>
        配置文本 = "{\"mcpServers\":{\"ai-browser\":{\"command\":\"node\",\"args\":[\"" + MCP_响应构建.JSON转义文本 (桥接脚本路径) + "\"],\"env\":{\"AI_BROWSER_MCP_HOST\":\"" + 服务器绑定地址 + "\",\"AI_BROWSER_MCP_PORT\":\"" + 到文本 (服务器端口) + "\",\"AI_BROWSER_MCP_HTTP_POST\":\"" + MCP_响应构建.JSON转义文本 (取MCP_HTTP地址 ()) + "/mcp\"}}}}"
        返回 (配置文本)
    }

    # 零手动接入: 安装到单个Agent配置文件 (JSON: 插入mcpServers内; TOML: 末尾追加段; 已含ai-browser则跳过)

    方法 安装代理配置 <公开 静态 类型 = 逻辑型 @输出名 = "InstallProxyConfig" @强制输出 = 真>
    参数 配置路径 <类型 = 文本型 @输出名 = "ConfigPath">
    参数 是TOML <类型 = 逻辑型 @输出名 = "IsTOML">
    {
        如果 (配置路径 == "")
        {
            返回 (假)
        }
        变量 完整JSON <类型 = 文本型>
        完整JSON = 构建代理安装JSON ()
        // 提取服务器条目 (ai-browser: {...}, 不含外层mcpServers壳)
        变量 条目起始 <类型 = 整数>
        条目起始 = 寻找文本 (完整JSON, "\"ai-browser\":", 0, 假)
        如果 (条目起始 == -1)
        {
            返回 (假)
        }
        变量 条目文本 <类型 = 文本型>
        条目文本 = 取文本右边 (完整JSON, 取文本长度 (完整JSON) - 条目起始)
        条目文本 = 取文本左边 (条目文本, 取文本长度 (条目文本) - 2)  // 去掉尾部 }}
        // TOML模式 (Codex): 末尾追加 [mcp_servers.ai-browser] 段
        如果 (是TOML)
        {
            变量 TOML段 <类型 = 文本型>
            TOML段 = "[mcp_servers.ai-browser]" + "\r\n" + "command = \"node\"" + "\r\n" + "args = [\"" + MCP_响应构建.JSON转义文本 (取运行目录 () + "mcp_bridge.js") + "\"]" + "\r\n" + "env = { AI_BROWSER_MCP_HOST = \"" + 服务器绑定地址 + "\", AI_BROWSER_MCP_PORT = \"" + 到文本 (服务器端口) + "\", AI_BROWSER_MCP_HTTP_POST = \"" + MCP_响应构建.JSON转义文本 (取MCP_HTTP地址 ()) + "/mcp\" }"
            变量 现有TOML <类型 = 文本型>
            现有TOML = ""
            如果 (文件是否存在 (配置路径))
            {
                现有TOML = UTF8到文本 (读入文件 (配置路径))
                如果 (寻找文本 (现有TOML, "ai-browser", 0, 假) != -1)
                {
                    控制台输出 ("[MCP] Agent配置已含ai-browser, 跳过: " + 配置路径)
                    返回 (真)
                }
            }
            写到文件 (配置路径, 文本到UTF8 (现有TOML + "\r\n" + TOML段 + "\r\n", 假))
            控制台输出 ("[MCP] 已自动注册Agent(TOML): " + 配置路径)
            返回 (真)
        }
        // JSON模式 (Cursor/Claude/Cline/Windsurf)
        如果 (文件是否存在 (配置路径) == 假)
        {
            写到文件 (配置路径, 文本到UTF8 (完整JSON, 假))
            控制台输出 ("[MCP] 已自动创建Agent配置: " + 配置路径)
            返回 (真)
        }
        变量 现有文本 <类型 = 文本型>
        现有文本 = UTF8到文本 (读入文件 (配置路径))
        如果 (寻找文本 (现有文本, "ai-browser", 0, 假) != -1)
        {
            控制台输出 ("[MCP] Agent配置已含ai-browser, 跳过: " + 配置路径)
            返回 (真)
        }
        // 插入到 mcpServers 的开括号之后
        变量 mcp位置 <类型 = 整数>
        mcp位置 = 寻找文本 (现有文本, "\"mcpServers\"", 0, 假)
        如果 (mcp位置 != -1)
        {
            变量 开括号 <类型 = 整数>
            开括号 = 寻找文本 (现有文本, "{", mcp位置, 假)
            如果 (开括号 != -1)
            {
                变量 插入位置 <类型 = 整数>
                插入位置 = 开括号 + 1
                // 空mcpServers({})时不加尾逗号, 防生成非法JSON {"mcpServers":{...},}
                // 0-based语义: prefix=Left(开括号+1)含"{", suffix=Right(len-开括号-1)从"{"之后开始
                变量 检测位置 <类型 = 整数>
                检测位置 = 插入位置
                变量 检测字符 <类型 = 文本型>
                检测字符 = " "
                判断循环 (检测位置 < 取文本长度 (现有文本) && (检测字符 == " " || 检测字符 == "\t" || 检测字符 == "\r" || 检测字符 == "\n"))
                {
                    检测字符 = 取文本中间 (现有文本, 检测位置, 1)
                    检测位置 = 检测位置 + 1
                }
                如果 (检测字符 == "}")
                {
                    现有文本 = 取文本左边 (现有文本, 开括号 + 1) + 条目文本 + 取文本右边 (现有文本, 取文本长度 (现有文本) - 开括号 - 1)
                }
                否则
                {
                    现有文本 = 取文本左边 (现有文本, 开括号 + 1) + 条目文本 + "," + 取文本右边 (现有文本, 取文本长度 (现有文本) - 开括号 - 1)
                }
                写到文件 (配置路径, 文本到UTF8 (现有文本, 假))
                控制台输出 ("[MCP] 已自动注册到现有Agent配置: " + 配置路径)
                返回 (真)
            }
        }
        // 结构不标准: 覆盖为标准配置 (原文件内容有备份风险提示)
        控制台输出 ("[MCP] Agent配置结构不标准, 跳过(保留原文件): " + 配置路径)
        返回 (假)
    }

    # 零手动接入: 检查并自动安装到所有主流Agent (Cursor/Claude Desktop/Codex/Cline/Windsurf)

    方法 检查并自动安装代理 <公开 静态 类型 = 整数 @输出名 = "CheckAndAutoInstallProxy" @强制输出 = 真>
    {
        变量 安装计数 <类型 = 整数 值 = 0>
        变量 用户目录 <类型 = 文本型>
        用户目录 = 读环境变量 ("USERPROFILE")
        如果 (用户目录 == "")
        {
            用户目录 = 读环境变量 ("HOMEDRIVE") + 读环境变量 ("HOMEPATH")
        }
        变量 应用数据目录 <类型 = 文本型>
        应用数据目录 = 读环境变量 ("APPDATA")
        // Cursor: ~/.cursor/mcp.json
        如果 (安装代理配置 (用户目录 + "\\.cursor\\mcp.json", 假))
        {
            安装计数 = 安装计数 + 1
        }
        // Claude Desktop: %APPDATA%\Claude\claude_desktop_config.json
        如果 (应用数据目录 != "" && 安装代理配置 (应用数据目录 + "\\Claude\\claude_desktop_config.json", 假))
        {
            安装计数 = 安装计数 + 1
        }
        // Codex: ~/.codex/config.toml (TOML格式)
        如果 (安装代理配置 (用户目录 + "\\.codex\\config.toml", 真))
        {
            安装计数 = 安装计数 + 1
        }
        // Cline: ~/.cline/mcp_settings.json
        如果 (安装代理配置 (用户目录 + "\\.cline\\mcp_settings.json", 假))
        {
            安装计数 = 安装计数 + 1
        }
        // Windsurf: ~/.windsurf/mcp_config.json
        如果 (安装代理配置 (用户目录 + "\\.windsurf\\mcp_config.json", 假))
        {
            安装计数 = 安装计数 + 1
        }
        // 写入标记文件供欢迎页显示安装状态
        变量 安装标记路径 <类型 = 文本型>
        安装标记路径 = 取运行目录 () + "\\CacheData\\.agent_installed"
        如果 (MCP_服务器工具.检查目录是否存在 (取运行目录 () + "\\CacheData"))
        {
            写到文件 (安装标记路径, 文本到UTF8 (到文本 (安装计数), 假))
        }
        返回 (安装计数)
    }

    # 文本类MIME判断 (modify篡改仅对文本资源生效, 二进制资源UTF8转换会损坏数据)

    方法 是否文本类MIME <公开 静态 类型 = 逻辑型 @输出名 = "IsTextClassMIME" @强制输出 = 真>
    参数 MIME类型 <类型 = 文本型 @输出名 = "MIMEType">
    {
        如果 (MIME类型 == "")
        {
            返回 (假)
        }
        变量 小写MIME <类型 = 文本型>
        小写MIME = 到小写 (MIME类型)
        如果 (是否以 (小写MIME, "text/"))
        {
            返回 (真)
        }
        如果 (寻找文本 (小写MIME, "javascript", 0, 假) != -1 || 寻找文本 (小写MIME, "json", 0, 假) != -1 || 寻找文本 (小写MIME, "xml", 0, 假) != -1 || 寻找文本 (小写MIME, "css", 0, 假) != -1 || 寻找文本 (小写MIME, "x-www-form-urlencoded", 0, 假) != -1)
        {
            返回 (真)
        }
        返回 (假)
    }

    # replace_file 文件内容缓存: 规则设置时MCP线程预读入库, 挂载时UI线程免磁盘IO

    方法 缓存篡改文件内容 <公开 静态 @输出名 = "CacheTamperFileContent" @强制输出 = 真>
    参数 文件路径 <类型 = 文本型 @输出名 = "FilePath">
    参数 文件内容 <类型 = 文本型 @输出名 = "FileContent">
    {
        规则锁.加锁 ()
        计次循环 (篡改文件缓存路径.取成员数 ())
        {
            如果 (篡改文件缓存路径.取成员 (取循环索引 ()) == 文件路径)
            {
                篡改文件缓存路径.删除成员 (取循环索引 ())
                篡改文件缓存内容.删除成员 (取循环索引 ())
                跳出循环
            }
        }
        篡改文件缓存路径.加入成员 (文件路径)
        篡改文件缓存内容.加入成员 (文件内容)
        规则锁.解锁 ()
    }

    # 取 replace_file 文件缓存内容 (未命中返回空文本)

    方法 取篡改文件缓存 <公开 静态 类型 = 文本型 @输出名 = "GetTamperFileCache" @强制输出 = 真>
    参数 文件路径 <类型 = 文本型 @输出名 = "FilePath">
    {
        变量 缓存内容 <类型 = 文本型>
        缓存内容 = ""
        规则锁.加锁 ()
        计次循环 (篡改文件缓存路径.取成员数 ())
        {
            如果 (篡改文件缓存路径.取成员 (取循环索引 ()) == 文件路径)
            {
                缓存内容 = 篡改文件缓存内容.取成员 (取循环索引 ())
                跳出循环
            }
        }
        规则锁.解锁 ()
        返回 (缓存内容)
    }

    # ======== 网络日志 ==========

    方法 记录网络请求 <公开 静态 @输出名 = "RecordNetworkRequest" @强制输出 = 真>
    参数 请求方法 <类型 = 文本型 @输出名 = "RequestMethod">
    参数 请求URL <类型 = 文本型 @输出名 = "RequestURL">
    {
        变量 日志项 <类型 = YYJSON对象类>
        日志项.创建自文本 ("{}")
        日志项.加入文本成员 ("type", "req")
        日志项.加入文本成员 ("method", 请求方法)
        日志项.加入文本成员 ("url", 请求URL)
        记录事件日志 ("network", "", 0, 日志项.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 记录网络响应 <公开 静态 @输出名 = "RecordNetworkResponse" @强制输出 = 真>
    参数 响应URL <类型 = 文本型 @输出名 = "ResponseURL">
    参数 状态码 <类型 = 整数 @输出名 = "StatusCode">
    参数 MIME类型 <类型 = 文本型 @输出名 = "MIMEType">
    参数 是否缓存 <类型 = 逻辑型 @输出名 = "IsCache">
    {
        变量 日志项 <类型 = YYJSON对象类>
        日志项.创建自文本 ("{}")
        日志项.加入文本成员 ("type", "res")
        日志项.加入文本成员 ("url", 响应URL)
        日志项.加入整数成员 ("status", 状态码)
        日志项.加入文本成员 ("mime", MIME类型)
        日志项.加入逻辑值成员 ("cached", 是否缓存)
        记录事件日志 ("network", "", 0, 日志项.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 记录网络请求_详细 <公开 静态 @输出名 = "RecordNetworkRequestDetailed" @强制输出 = 真>
    参数 请求 <类型 = 类_FBrowser_请求 @输出名 = "Request">
    {
        变量 请求URL <类型 = 文本型>
        请求URL = 请求.取地址 ()
        变量 请求方法 <类型 = 文本型>
        请求方法 = 请求.取类型 ()
        // 用yyjson构建主体, 避免URL中的双引号/反斜杠破坏JSON
        // 注: header子对象避免用加入成员嵌套(已知崩溃), 改为先序列化再嵌入文本
        变量 日志项 <类型 = YYJSON对象类>
        日志项.创建自文本 ("{}")
        日志项.加入文本成员 ("type", "req")
        日志项.加入文本成员 ("method", 请求方法)
        日志项.加入文本成员 ("url", 请求URL)
        变量 头数组 <类型 = FBrowser_双文本数组>
        头数组 = 请求.取协议头数据 ()
        如果 (头数组.取个数 () > 0)
        {
            变量 头对象 <类型 = YYJSON对象类>
            头对象.创建自文本 ("{}")
            头数组.到数组首 ()
            变量 继续 <类型 = 逻辑型 值 = 真>
            循环判断首 ()
            {
                变量 当前头 <类型 = FBrowser_双文本>
                当前头 = 头数组.取当前位置数据 ()
                如果 (当前头.name != "" && 当前头.name != "cookie")
                {
                    头对象.加入文本成员 (当前头.name, 当前头.value)
                }
                继续 = 头数组.到下一个 ()
            }
            循环判断尾 (继续)
            // 先序列化头对象, 再作为文本成员嵌入 (规避加入成员嵌套崩溃)
            日志项.加入文本成员 ("headers_json", 头对象.到可读文本 (YYJSON格式化选项.压缩))
        }
        // POST Body 捕获: 对 POST/PUT/PATCH 请求提取请求体 (最大64KB截断)
        常量 POST体最大字节 <类型 = 整数 值 = 65536 注释 = "64KB">
        如果 (请求方法 == "POST" || 请求方法 == "PUT" || 请求方法 == "PATCH")
        {
            变量 postData <类型 = 类_FBrowser_POST数据>
            postData = 请求.取POST数据 ()
            如果 (postData.是否为空 () == 假 && postData.取元素个数 () > 0)
            {
                变量 post成员数组 <类型 = 类_FBrowser_POST元素数组>
                post成员数组 = postData.取元素 ()
                变量 post成员数 <类型 = 整数>
                post成员数 = post成员数组.取个数 ()
                变量 post体文本 <类型 = 文本型>
                post体文本 = ""
                post成员数组.到数组首 ()
                变量 继续循环 <类型 = 逻辑型 值 = 真>
                循环判断首 ()
                {
                    变量 post元素 <类型 = 类_FBrowser_POST元素>
                    post元素 = post成员数组.取当前位置数据 ()
                    如果 (post元素.是否为空 () == 假)
                    {
                        变量 post类型 <类型 = 整数>
                        post类型 = post元素.取类型 ()
                        如果 (post类型 == 1)  // 1=字节集类型
                        {
                            变量 元素文本 <类型 = 文本型>
                            元素文本 = post元素.取文本数据 (真)  // UTF8解码
                            如果 (元素文本 != "")
                            {
                                post体文本 = post体文本 + 元素文本
                            }
                        }
                    }
                    如果 (取文本长度 (post体文本) >= POST体最大字节)
                    {
                        跳出循环
                    }
                    继续循环 = post成员数组.到下一个 ()
                }
                循环判断尾 (继续循环)
                如果 (post体文本 != "")
                {
                    // 修复: 按字节安全截断(常量语义为字节), 原按字符比较会放大至约3倍且切多字节字符产生U+FFFD
                    变量 post体字节 <类型 = 字节集类>
                    post体字节 = 文本到UTF8 (post体文本, 假)
                    如果 (取字节集长度 (post体字节) > POST体最大字节)
                    {
                        post体文本 = 字节安全截断 (post体文本, POST体最大字节) + "...[截断]"
                    }
                    日志项.加入文本成员 ("post_body", post体文本)
                    日志项.加入整数成员 ("post_body_size", 取字节集长度 (文本到UTF8 (post体文本, 假)))
                }
            }
        }
        记录事件日志 ("network_detail", "", 0, 日志项.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 记录网络响应_详细 <公开 静态 @输出名 = "RecordNetworkResponseDetailed" @强制输出 = 真>
    参数 请求 <类型 = 类_FBrowser_请求 @输出名 = "Request">
    参数 响应 <类型 = 类_FBrowser_响应 @输出名 = "Response">
    参数 内容长度 <类型 = 长整数 @输出名 = "ContentLength">
    {
        变量 响应URL <类型 = 文本型>
        响应URL = 请求.取地址 ()
        变量 MIME类型 <类型 = 文本型>
        MIME类型 = 响应.取协议头_名称 ("Content-Type")
        // 用yyjson构建, 避免URL/MIME/Header中的特殊字符破坏JSON
        // 注: header子对象避免用加入成员嵌套(已知崩溃), 改为先序列化再嵌入文本
        变量 日志项 <类型 = YYJSON对象类>
        日志项.创建自文本 ("{}")
        日志项.加入文本成员 ("type", "res")
        日志项.加入文本成员 ("url", 响应URL)
        日志项.加入长整数成员 ("content_length", 内容长度)
        日志项.加入文本成员 ("mime", MIME类型)
        变量 头数组 <类型 = FBrowser_双文本数组>
        头数组 = 响应.取协议头数据 ()
        如果 (头数组.取个数 () > 0)
        {
            变量 头对象 <类型 = YYJSON对象类>
            头对象.创建自文本 ("{}")
            头数组.到数组首 ()
            变量 继续 <类型 = 逻辑型 值 = 真>
            循环判断首 ()
            {
                变量 当前头 <类型 = FBrowser_双文本>
                当前头 = 头数组.取当前位置数据 ()
                如果 (当前头.name != "" && 当前头.name != "set-cookie")
                {
                    头对象.加入文本成员 (当前头.name, 当前头.value)
                }
                继续 = 头数组.到下一个 ()
            }
            循环判断尾 (继续)
            日志项.加入文本成员 ("response_headers_json", 头对象.到可读文本 (YYJSON格式化选项.压缩))
        }
        记录事件日志 ("network_detail", "", 0, 日志项.到可读文本 (YYJSON格式化选项.压缩))
    }

    # ======== 浏览器加载事件记录 ========

    方法 记录加载事件 <公开 静态 @输出名 = "RecordLoadEvent" @强制输出 = 真>
    参数 事件类型 <类型 = 文本型 @输出名 = "EventType">
    参数 浏览器ID <类型 = 整数 @输出名 = "BrowserID">
    参数 附加数据 <类型 = 整数 @默认值 = 0 @输出名 = "AttachAddData">
    {
        变量 事件键名 <类型 = 文本型>
        事件键名 = "browser_event:" + 事件类型 + ":" + 到文本 (浏览器ID)
        变量 事件包装 <类型 = YYJSON对象类>
        事件包装.创建自文本 ("{}")
        事件包装.加入文本成员 ("event", 事件类型)
        事件包装.加入整数成员 ("browser_id", 浏览器ID)
        事件包装.加入文本成员 ("timestamp", 到文本 (取启动时间 ()))
        如果 (事件类型 == "load_end")
        {
            事件包装.加入整数成员 ("status_code", 附加数据)
        }
        否则 (事件类型 == "crash")
        {
            事件包装.加入整数成员 ("error_code", 附加数据)
        }
        记录事件日志 ("browser_event", 事件类型, 浏览器ID, 事件包装.到可读文本 (YYJSON格式化选项.压缩))
        控制台输出 (到文本 ("[MCP] 浏览器事件:") + 到文本 (事件类型) + "ID:" + 到文本 (浏览器ID))
    }

    # 通用浏览器事件记录 (SQLite)

    方法 记录浏览器事件 <公开 静态 @输出名 = "RecordBrowserEvent" @强制输出 = 真>
    参数 事件类型 <类型 = 文本型 @输出名 = "EventType">
    参数 浏览器ID <类型 = 整数 @输出名 = "BrowserID">
    参数 事件数据JSON <类型 = 文本型 @默认值 = "" @输出名 = "EventDataJSON">
    {
        变量 事件包装 <类型 = YYJSON对象类>
        事件包装.创建自文本 ("{}")
        事件包装.加入文本成员 ("event", 事件类型)
        事件包装.加入整数成员 ("browser_id", 浏览器ID)
        事件包装.加入长整数成员 ("timestamp_ms", 取启动时间 ())
        如果 (事件数据JSON != "")
        {
            事件包装.加入文本成员 ("data", 事件数据JSON)
        }
        记录事件日志 ("browser_event", 事件类型, 浏览器ID, 事件包装.到可读文本 (YYJSON格式化选项.压缩))
    }

    # 应用级事件记录 (SQLite)

    方法 记录应用事件 <公开 静态 @输出名 = "RecordApplyEvent" @强制输出 = 真>
    参数 事件类型 <类型 = 文本型 @输出名 = "EventType">
    参数 事件数据JSON <类型 = 文本型 @默认值 = "" @输出名 = "EventDataJSON">
    {
        变量 事件包装 <类型 = YYJSON对象类>
        事件包装.创建自文本 ("{}")
        事件包装.加入文本成员 ("event", 事件类型)
        事件包装.加入长整数成员 ("timestamp_ms", 取启动时间 ())
