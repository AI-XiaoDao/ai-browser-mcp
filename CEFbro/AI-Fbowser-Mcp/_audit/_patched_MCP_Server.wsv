        添加工具JSON ("browser_ipc_send_all", "向所有渲染进程推送一条进程间消息| 页面侧由 window.__mcp_ipc_queue 接收(逆向时可作主进程→页面的指令通道)", 多属性Schema文本 (属性项JSON ("name", "text", "消息名") + "," + 属性项JSON ("data", "text", "数据"), "\"name\""))
        添加工具JSON ("browser_ipc_send_to", "向指定渲染进程推送一条进程间消息| 渲染进程ID 用 ipc_renderer_ids 获取", 多属性Schema文本 (属性项JSON ("process_id", "integer", "进程ID") + "," + 属性项JSON ("name", "text", "消息名") + "," + 属性项JSON ("data", "text", "数据"), "\"process_id\",\"name\""))
        添加工具JSON ("browser_ipc_renderer_count", "渲染进程数量")
