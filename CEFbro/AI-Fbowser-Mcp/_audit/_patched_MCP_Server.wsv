        命令注册表.置整数值 ("browser_fingerprint_java_enabled", 1071)
        命令注册表.置整数值 ("browser.fingerprint_online", 1072)
        命令注册表.置整数值 ("browser_fingerprint_online", 1072)
        命令注册表.置整数值 ("browser.fingerprint_appcodename", 1073)
        命令注册表.置整数值 ("browser_fingerprint_appcodename", 1073)
        命令注册表.置整数值 ("browser.fingerprint_appversion", 1074)
        命令注册表.置整数值 ("browser_fingerprint_appversion", 1074)
        命令注册表.置整数值 ("browser.fingerprint_product_sub", 1075)
        命令注册表.置整数值 ("browser_fingerprint_product_sub", 1075)
        命令注册表.置整数值 ("browser.fingerprint_vendor_sub", 1076)
        命令注册表.置整数值 ("browser_fingerprint_vendor_sub", 1076)
        命令注册表.置整数值 ("browser.vip_fingerprint_canvas_fixed", 1077)
        命令注册表.置整数值 ("browser_vip_fingerprint_canvas_fixed", 1077)
        命令注册表.置整数值 ("browser.vip_fingerprint_webgl_fixed", 1078)
        命令注册表.置整数值 ("browser_vip_fingerprint_webgl_fixed", 1078)
        命令注册表.置整数值 ("browser.vip_fingerprint_audio_fixed", 1079)
        命令注册表.置整数值 ("browser_vip_fingerprint_audio_fixed", 1079)
        命令注册表.置整数值 ("browser.vip_fingerprint_rect", 1080)
        命令注册表.置整数值 ("browser_vip_fingerprint_rect", 1080)
        命令注册表.置整数值 ("browser.vip_disable_console", 1082)
        命令注册表.置整数值 ("browser_vip_disable_console", 1082)
        命令注册表.置整数值 ("browser.vip_set_is_trusted", 1083)
        命令注册表.置整数值 ("browser_vip_set_is_trusted", 1083)
        // 工作流编排
        命令注册表.置整数值 ("workflow.list", 1200)
        命令注册表.置整数值 ("workflow_list", 1200)
        命令注册表.置整数值 ("workflow.get", 1201)
        命令注册表.置整数值 ("workflow_get", 1201)
        命令注册表.置整数值 ("workflow.run", 1202)
        命令注册表.置整数值 ("workflow_run", 1202)
        命令注册表.置整数值 ("workflow.stop", 1203)
        命令注册表.置整数值 ("workflow_stop", 1203)
        // VIP补充: 短名别名 (让 refresh_cookies/get_all_cookies/set_preference 可用)
        命令注册表.置整数值 ("refresh_cookies", 1145)
        命令注册表.置整数值 ("get_all_cookies", 1146)
        命令注册表.置整数值 ("set_preference", 1147)
    }

    # ======== 批量操作处理 ==========

    方法 处理_批量操作 <公开 静态 类型 = 文本型 @输出名 = "HandleBatchOp" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 命令数组 <类型 = YYJSON只读数组类>
        命令数组 = 参数JSON.取数组 ("commands")
        如果 (命令数组.是否为空对象 ())
        {
            命令数组 = 参数JSON.取数组 ("ops")
        }
        // 兼容: commands 为 JSON 字符串 || 整包数组文本
        如果 (命令数组.是否为空对象 ())
        {
            变量 批量JSON文本 <类型 = 文本型>
            批量JSON文本 = yyjson取JSON文本 (参数JSON, "commands")
            如果 (批量JSON文本 == "")
            {
                批量JSON文本 = yyjson取JSON文本 (参数JSON, "ops")
            }
            如果 (批量JSON文本 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "batch需要commands参数: [{name, arguments}, ...]"))
            }
            如果 (是否以 (批量JSON文本, "["))
            {
                批量JSON文本 = "{\"commands\":" + 批量JSON文本 + "}"
            }
            变量 批量解析 <类型 = YYJSON只读对象类>
            如果 (批量解析.创建自文本 (批量JSON文本) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "commands JSON解析失败"))
            }
            命令数组 = 批量解析.取数组 ("commands")
            如果 (命令数组.是否为空对象 ())
            {
                命令数组 = 批量解析.取数组 ("ops")
            }
        }
        如果 (命令数组.是否为空对象 ())
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "commands解析失败,支持格式:[{name,arguments},...]或{commands:[...]}"))
        }
        变量 数组成员数 <类型 = 整数>
        数组成员数 = (整数)命令数组.取成员数 ()
        如果 (数组成员数 > MCP_常量.批量命令最大条数)
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "batch 命令过多: " + 到文本 (数组成员数) + " > 上限 " + 到文本 (MCP_常量.批量命令最大条数)))
        }
        变量 总成功数 <类型 = 整数 值 = 0>
        变量 总失败数 <类型 = 整数 值 = 0>
        变量 结果列表 <类型 = 文本型>
        结果列表 = "["
        变量 结果已追加 <类型 = 整数 值 = 0>
        变量 批量跟随异步 <类型 = 逻辑型>
        批量跟随异步 = 真
        如果 (参数JSON.是否为空 () == 假 && yyjson取逻辑 (参数JSON, "async_only"))
        {
            批量跟随异步 = 假
        }
        计次循环 (数组成员数)
        {
            变量 当前命令 <类型 = YYJSON只读对象类>
            当前命令 = 命令数组.取成员 (取循环索引 ())
            如果 (当前命令.是否为空 () == 假)
            {
                变量 子命令名 <类型 = 文本型>
                子命令名 = yyjson取文本 (当前命令, "name")
                变量 子参数解析 <类型 = YYJSON只读对象类>
                子参数解析 = yyjson取对象成员 (当前命令, "arguments")
                如果 (子参数解析.是否为空 ())
                {
                    变量 子参数JSON文本 <类型 = 文本型>
                    子参数JSON文本 = yyjson取JSON文本 (当前命令, "arguments")
                    如果 (子参数JSON文本 == "")
                    {
                        子参数JSON文本 = "{}"
                    }
                    子参数解析.创建自文本 (子参数JSON文本)
                }
                变量 子结果 <类型 = 文本型>
                子结果 = 执行浏览器命令 (命令ID + "_" + 到文本 (取循环索引 ()), 子命令名, 子参数解析)
                如果 (批量跟随异步)
                {
                    变量 子预解析 <类型 = YYJSON只读对象类>
                    如果 (子预解析.创建自文本 (子结果) && 子预解析.取逻辑值 ("_sync_waited") == 假)
                    {
                        子结果 = 尝试同步跟随异步响应 (命令ID + "_" + 到文本 (取循环索引 ()), 子结果, 子命令名, 子参数解析, 真, 真)  // batch子命令在MCP执行锁内执行, 等待期间放锁
                    }
                }
                变量 子解析 <类型 = YYJSON只读对象类>
                如果 (子解析.创建自文本 (子结果))
                {
                    如果 (子解析.取逻辑值 ("success"))
                    {
                        总成功数 = 总成功数 + 1
                    }
                    否则
                    {
                        总失败数 = 总失败数 + 1
                    }
                    // 收集结果摘要到列表
                    变量 结果摘要 <类型 = YYJSON对象类>
                    结果摘要.创建自文本 ("{}")
                    结果摘要.加入文本成员 ("name", 子命令名)
                    结果摘要.加入逻辑值成员 ("success", 子解析.取逻辑值 ("success"))
                    变量 子消息 <类型 = 文本型>
                    子消息 = yyjson取文本 (子解析, "message")
                    如果 (子消息 != "")
                    {
                        结果摘要.加入文本成员 ("message", 子消息)
                    }
                    如果 (结果已追加 > 0)
                    {
                        结果列表 = 结果列表 + ","
                    }
                    结果已追加 = 结果已追加 + 1
                    结果列表 = 结果列表 + 结果摘要.到可读文本 (YYJSON格式化选项.压缩)
                }
                否则
                {
                    总失败数 = 总失败数 + 1
                }
            }
            否则
            {
                // 修复: null/空成员显式计失败并写入结果, 保证 total == success_count + failure_count
                总失败数 = 总失败数 + 1
                变量 空结果摘要 <类型 = YYJSON对象类>
                空结果摘要.创建自文本 ("{}")
                空结果摘要.加入文本成员 ("name", "")
                空结果摘要.加入逻辑值成员 ("success", 假)
                空结果摘要.加入文本成员 ("message", "命令为空")
                如果 (结果已追加 > 0)
                {
                    结果列表 = 结果列表 + ","
                }
                结果已追加 = 结果已追加 + 1
                结果列表 = 结果列表 + 空结果摘要.到可读文本 (YYJSON格式化选项.压缩)
            }
        }
        结果列表 = 结果列表 + "]"
        变量 汇总对象 <类型 = YYJSON对象类>
        汇总对象.创建自文本 ("{}")
        汇总对象.加入逻辑值成员 ("success", 总失败数 == 0)
        汇总对象.加入整数成员 ("total", 数组成员数)
        汇总对象.加入整数成员 ("success_count", 总成功数)
        汇总对象.加入整数成员 ("failure_count", 总失败数)
        变量 汇总JSON <类型 = 文本型>
        汇总JSON = 汇总对象.到可读文本 (YYJSON格式化选项.压缩)
        // 嵌入 results 数组 (字符串拼接避免YYJSON嵌套bug)
        汇总JSON = 取文本左边 (汇总JSON, 取文本长度 (汇总JSON) - 1) + ",\"results\":" + 结果列表 + "}"
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 汇总JSON, 总失败数 == 0))
    }

    方法 构建JSONRPC头部前缀 <公开 静态 类型 = 文本型 @输出名 = "BuildJSONRPCHeadPrefix" @强制输出 = 真>
    参数 请求ID <类型 = 文本型 @输出名 = "RequestID">
    {
        变量 头对象 <类型 = YYJSON对象类>
        头对象.创建自文本 ("{}")
        如果 (紧凑响应模式 == 假)
        {
            头对象.加入文本成员 ("jsonrpc", "2.0")
        }
        如果 (请求ID != "")
        {
            // 标准回显: 数字id(含0)保持数值类型, 文本id保持文本 — JSON-RPC 2.0 要求响应id与请求id同值
            如果 (当前请求ID是数值)
            {
                头对象.加入长整数成员 ("id", 文本到长整数 (请求ID))
            }
            否则
            {
                头对象.加入文本成员 ("id", 请求ID)
            }
        }
        变量 头JSON <类型 = 文本型>
        头JSON = 头对象.到可读文本 (YYJSON格式化选项.压缩)
        返回 (取文本左边 (头JSON, 取文本长度 (头JSON) - 1))
    }

    # ======== CDP命令执行 ==========

    方法 执行CDP命令_带参数 <公开 静态 类型 = 文本型 @输出名 = "ExecuteCDPCommandWithParams" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 cdpMethod <类型 = 文本型 @输出名 = "CDPMethod">
    参数 paramsJSON文本 <类型 = 文本型 @输出名 = "ParamsJSONText">
    {
        // 多浏览器CDP支持: browser_id参数指定目标浏览器, 观察者自动切换附着
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (目标浏览器ID > 0)
        {
            变量 目标CDP浏览器 <类型 = 类_FBrowser_浏览器>
            目标CDP浏览器 = FBrowser_浏览器_通过ID取浏览器 (目标浏览器ID)
            如果 (目标CDP浏览器.是否为空 () || 目标CDP浏览器.是否已关闭 ())
            {
                // 指定浏览器无效: 明确失败, 不静默落到主浏览器执行
                返回 (MCP_响应构建.命令失败 (命令ID, "目标浏览器不存在或已关闭: browser_id=" + 到文本 (目标浏览器ID)))
            }
            browser = 目标CDP浏览器
        }
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            // Debugger类CDP命令统一自愈: 反检测Debugger禁用与断点调试根本冲突(illegal instruction崩溃), 先恢复内核Debugger
            如果 (是否以 (cdpMethod, "Debugger."))
            {
                确保Debugger可用 (browser)
            }
            变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
            vip_ctrl = browser.取VIP控制器 ()
            如果 (vip_ctrl.是否为空 () == 假)
            {
                // CDP通道自动就绪 —— **只在"未注册"时注册**, 不再支持"附着于别的浏览器时切过去"。
                // ★ 依据(本轮实测, 含应用自身日志): 观察者是**单个**全局对象, 切到另一个浏览器再切回来,
                //   日志会打印"已自动注册到浏览器 ID:1"(即 API 报告成功), 但**通道其实再也回不来**:
                //   随后的 get_text 从 0.02s 变成 10s 且返回 null、execute_js 从 0.02s 变成 30s
                //   (即 CDP 已死、退化为原生路径), 且**整场会话不恢复**。
                //   三臂对照已把触发点钉死: 仅创建第二个浏览器无害(0.02s), 一旦**在它上面执行 JS** 就崩。
                //   故对"非当前附着浏览器"直接**快速失败**, 让调用方立刻回退原生路径 ——
                //   既避免破坏 CDP, 又免掉原先白等的 30 秒。
                如果 (CDP观察者已注册 == 假)
                {
                    持久CDP观察者.创建 (类_MCP_DevTools观察者)
                    变量 重注册结果 <类型 = 逻辑型>
                    重注册结果 = vip_ctrl.开发者消息_启用监管者事件 (持久CDP观察者)
                    如果 (重注册结果)
                    {
                        CDP观察者已注册 = 真
                        CDP附着浏览器ID = browser.取ID ()
                        控制台输出 ("[MCP] CDP观察者已自动注册到浏览器 ID:" + 到文本 (CDP附着浏览器ID))
                    }
                    否则
                    {
                        // 契约: 返回假 = 已存在 或 创建失败。此前丢弃返回值会声称注册成功,
                        // 而 开发者消息_执行方法 不检查观察者 → 命令发出但响应永不回来 → 必然超时。
                        CDP观察者已注册 = 假
                        CDP附着浏览器ID = 0
                        持久CDP观察者.置空 ()
                    }
                }
                否则 (CDP附着浏览器ID != 0 && CDP附着浏览器ID != browser.取ID ())
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "CDP 通道当前附着在浏览器 ID=" + 到文本 (CDP附着浏览器ID) + "; 本会话不支持切换到 browser_id=" + 到文本 (browser.取ID ()) + " —— 实测切换附着会**永久破坏** CDP 通道(需重启进程才能恢复) | 该浏览器的操作会自动走原生路径(多数工具已内置回退), 若确实需要对这个浏览器用 CDP, 请另开一个进程实例"))
                }
                // 修复: 观察者确实不在册时**快速失败**, 不再发出一条注定收不到响应的 CDP 命令
                // 并让调用方干等到内部超时(20~45s)。这同时暴露真实原因, 便于定位。
                如果 (CDP观察者已注册 == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "CDP 通道不可用: DevTools观察者未在册 | 该类 CDP 工具(debugger_*/cdp_*/reverse CDP类)将全部失效 | 常见原因: 曾调用 browser_vip_enable_devtools_observer/enable_inspector 关闭了观察者 | 恢复: 重启 AI-Fbowser-Mcp.exe"))
                }
                变量 params_value <类型 = 类_FBrowser_值>
                params_value = FBrowser_Parser_解析JSON (paramsJSON文本, JSON解析.RFC)
                变量 params_dict <类型 = 类_FBrowser_字典值>
                params_dict.创建 ()
                如果 (params_value.是否为空 () == 假)
                {
                    params_dict = params_value.取字典值 ()
                }
                否则 (paramsJSON文本 != "" && paramsJSON文本 != "{}")
                {
                    控制台输出 ("[MCP] CDP params JSON解析失败,使用空字典: " + 取文本左边 (paramsJSON文本, 200))
                }
                // 清除同 task_id 旧结果,避免同步等待误读上一轮 CDP 缓存
                删除异步结果 (命令ID)
                // 分配CDP消息ID并记录映射:CDP消息ID → MCP请求ID
                变量 cdpMsgId <类型 = 整数>
                cdpMsgId = 分配CDP消息ID ()
                记录CDP请求映射 (cdpMsgId, 命令ID, cdpMethod)
                vip_ctrl.开发者消息_执行方法 (cdpMsgId, cdpMethod, params_dict)
                变量 异步对象 <类型 = YYJSON对象类>
                异步对象.创建自文本 ("{}")
                异步对象.加入文本成员 ("id", 命令ID)
                异步对象.加入逻辑值成员 ("success", 真)
                异步对象.加入逻辑值成员 ("_async", 真)
                异步对象.加入文本成员 ("task_id", 命令ID)
                异步对象.加入文本成员 ("message", "CDP已提交:" + cdpMethod)
                返回 (异步对象.到可读文本 (YYJSON格式化选项.压缩))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
    }

    # ==== 零前置: 需要"页面处于暂停态"的调试工具统一入口 ====

    方法 确保调试器已暂停 <公开 静态 类型 = 逻辑型 注释 = "零前置: 页面未暂停时, 先启用调试器域、安排一个必然很快执行的语句, 再 Debugger.pause, 从而**可靠**地制造暂停点并等到 Debugger.paused; 已暂停则直接返回真(不重复暂停)。成功返回真。" @输出名 = "EnsureDebuggerPaused" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    {
        如果 (取CDP事件数据JSON ("Debugger.paused") != "")
        {
            返回 (真)
        }
        // ① 必须**先**显式启用调试器域, 再发 Debugger.pause。
        //    实测教训(第一次实现踩到): 只靠 执行CDP并同步等待 的**反应式**补域是不够的 ——
        //    那次 pause 请求被接受, 但 5 秒内始终等不到 Debugger.paused, 直到**下一次**工具调用
        //    才发现页面其实已经暂停(即本次 pause 白做、下次才生效)。原因是启用调试器域会重置
        //    "下一语句暂停"标志: 先 pause 后 enable == pause 被清掉。故这里主动、显式地先 enable。
        变量 启用域 <类型 = 文本型>
        启用域 = 执行CDP并同步等待 ("_dbg_en", "Debugger.enable", "{}", 6000)
        如果 (CDP同步结果是否成功 (启用域) == 假)
        {
            返回 (假)
        }
        // 最多尝试两轮: 个别时序下 pause 标志会因页面恰好无语句执行而错过, 重来一轮即可,
        // 不至于让调用方看到失败后自己反复重试(那正是本目标要消灭的体验)。
        计次循环 (2)
        {
            如果 (取CDP事件数据JSON ("Debugger.paused") != "")
            {
                返回 (真)
            }
            // ② 安排"必然很快执行"的执行点: 直接 Debugger.pause 在无JS执行点的页面上永不返回
            //    (原 browser_debugger_pause 被禁用的原因), 故先让 30ms 后必有一个语句执行,
            //    使 pause 有落点、等待有界。安排语句用的是页面里已有的 setTimeout, 不需要额外 Hook。
            变量 布置 <类型 = 文本型>
            布置 = 执行CDP并同步等待 ("_dbg_land", "Runtime.evaluate", "{\"expression\":\"setTimeout(function(){var _mcpPauseLanding=1;},30)\",\"returnByValue\":true}", 4000)
            如果 (CDP同步结果是否成功 (布置) == 假)
            {
                返回 (假)
            }
            // 清掉可能残留的旧暂停事件, 否则会把上一次的暂停误当成本次制造出来的
            清除CDP事件记录 ("Debugger.paused")
            变量 暂停请求 <类型 = 文本型>
            暂停请求 = 执行CDP并同步等待 ("_dbg_pause", "Debugger.pause", "{}", 4000)
            如果 (CDP同步结果是否成功 (暂停请求) == 假)
            {
                返回 (假)
            }
            变量 已暂停 <类型 = 文本型>
            已暂停 = 等待CDP事件 ("Debugger.paused", 6000, 假)
            如果 (已暂停 != "")
            {
                MCP_响应构建.记录自动处理 ("Debugger.pause(页面原本未暂停, 已自动启用调试器域并安排执行点制造暂停点; 用完请 browser_debugger_resume 恢复页面)")
                返回 (真)
            }
        }
        返回 (假)
    }

    方法 执行CDP命令 <公开 静态 类型 = 文本型 @输出名 = "ExecuteCDPCommand" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 cdpMethod <类型 = 文本型 @输出名 = "CDPMethod">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 params_text <类型 = 文本型>
        params_text = yyjson取JSON文本 (参数JSON, "params")
        如果 (params_text == "")
        {
            params_text = "{}"
        }
        返回 (执行CDP命令_带参数 (命令ID, cdpMethod, params_text))
    }

    # ======== CDP请求映射 (解决CDP结果不回传问题, v2.4 TTL清理) ==========

    变量 CDP消息计数器 <公开 静态 类型 = 整数 值 = 0 @输出名 = "CDPMessageCounter">
    变量 CDP请求映射表 <公开 静态 类型 = 类_FBrowser_字典值 @输出名 = "CDPRequestMapTable">
    变量 CDP观察者已注册 <公开 静态 类型 = 逻辑型 值 = 假 @输出名 = "CDPObserverRegistered">
    变量 持久CDP观察者 <公开 静态 类型 = 类_FBrowser_事件智能指针 @输出名 = "PersistentCDPObserver">
    变量 CDP映射清理计数 <公开 静态 类型 = 整数 值 = 0 @输出名 = "CDPMapCleanCount">

    # 反检测"禁用Debugger检测"与CDP断点调试根本冲突(内核开关禁用后断点触发illegal instruction崩溃):
    # debugger类工具入口调用本方法自愈 — 恢复内核Debugger并复位持久标志

    方法 确保Debugger可用 <公开 静态 @输出名 = "EnsureDebuggerAvailable" @强制输出 = 真>
    参数 目标浏览器 <类型 = 类_FBrowser_浏览器 @输出名 = "TargetBrowser">
    {
        // 反检测三件套(禁用Debugger检测/UA伪装/禁用自动化标志)均与CDP断点调试根本冲突:
        // 冲突触发STATUS_ILLEGAL_INSTRUCTION渲染进程崩溃, 调试器使用时统一清除
        如果 (持久反检测_禁用Debugger检测 == 假 && 持久反检测_伪装UA == "" && 持久反检测_禁用自动化标志 == 假)
        {
            返回
        }
        变量 dbgBrowser <类型 = 类_FBrowser_浏览器>
        dbgBrowser = 目标浏览器
        如果 (dbgBrowser.是否为空 () == 假)
        {
            变量 dbgVip <类型 = 类_FBrowserVIP_控制器>
            dbgVip = dbgBrowser.取VIP控制器 ()
            如果 (dbgVip.是否为空 () == 假)
            {
                dbgVip.内核开关_禁用Debugger (假)
            }
        }
        持久反检测_禁用Debugger检测 = 假
        如果 (持久反检测_伪装UA != "")
        {
            持久反检测_伪装UA = ""
            控制台输出 ("[MCP] 反检测UA伪装与断点调试冲突, 已自动清除 (可重新设置)")
        }
        如果 (持久反检测_禁用自动化标志)
        {
            持久反检测_禁用自动化标志 = 假
            控制台输出 ("[MCP] 反检测自动化标志与断点调试冲突, 已自动关闭")
        }
        控制台输出 ("[MCP] 检测到反检测Debugger禁用与断点调试冲突, 已自动恢复Debugger功能 (页面需刷新后断点生效)")
    }

    方法 确保CDP观察者已注册 <公开 静态 @输出名 = "EnsureCDPObserverRegistered" @强制输出 = 真>
    {
        如果 (MCP正在关闭 || CDP观察者已注册)
        {
            返回
        }
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 () == 假)
        {
            变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
            vip_ctrl = browser.取VIP控制器 ()
            如果 (vip_ctrl.是否为空 () == 假)
            {
                持久CDP观察者.创建 (类_MCP_DevTools观察者)
                                // 类库契约(FBroVip.wsv:697): 开发者消息_启用监管者事件 返回逻辑型 ——
                //   "创建成功返回真, 已创建或者创建失败返回假"。
                // 而 开发者消息_执行方法(FBroVip.wsv:693) **不检查观察者是否在册**:
                //   命令照发, 但响应走观察者回调 → 不在册则响应永不到达 → 该工具同步等待到超时。
                // 后果: 观察者一旦被关闭(如 browser_vip_enable_devtools_observer 缺参数),
                //   重注册即使返回假也宣称成功, /health 的 cdp_ready(读本标志) 报真, 实际 CDP 全废。
                变量 附加结果 <类型 = 逻辑型>
                附加结果 = vip_ctrl.开发者消息_启用监管者事件 (持久CDP观察者)
                如果 (附加结果)
                {
                    CDP观察者已注册 = 真
                    CDP附着浏览器ID = browser.取ID ()
                    控制台输出 ("[MCP] CDP DevTools观察者已注册")
                }
                否则
                {
                    CDP观察者已注册 = 假
                    CDP附着浏览器ID = 0
                    持久CDP观察者.置空 ()
                    控制台输出 ("[MCP] ⚠ CDP观察者注册失败(已存在或创建失败) | CDP类工具将直接报错而非超时 | 需重启进程恢复")
                }
            }
        }
    }

    方法 注销CDP观察者 <公开 静态 @输出名 = "UnregisterCDPObserver" @强制输出 = 真>
    {
        如果 (CDP观察者已注册 == 假)
        {
            返回
        }
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取浏览器ByID (CDP附着浏览器ID)
        如果 (browser.是否为空 ())
        {
            browser = 取主浏览器 ()
        }
        如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
        {
            变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
            vip_ctrl = browser.取VIP控制器 ()
            如果 (vip_ctrl.是否为空 () == 假)
            {
                // 修复: 原实现丢弃返回值。类库契约(FBroVip.wsv:710)该命令返回逻辑型。
                // 关闭失败却照样置 已注册=假, 会使后续"重注册"路径以为可以重新附加,
                // 实际控制器侧仍持有旧观察者 → 启用返回假 → CDP 永久失效(需重启进程)。
                变量 关闭结果 <类型 = 逻辑型>
                关闭结果 = vip_ctrl.开发者消息_关闭监管者事件 ()
                如果 (关闭结果 == 假)
                {
                    控制台输出 ("[MCP] ⚠ CDP观察者关闭失败 | CDP类工具将不可用, 需重启进程恢复")
                }
            }
        }
        CDP观察者已注册 = 假
        CDP附着浏览器ID = 0
        // 释放观察者引用, 防止关闭后残留指针被CDP事件回调误用
        持久CDP观察者.置空 ()
        控制台输出 ("[MCP] CDP DevTools观察者已注销")
    }

    方法 等待MCP命令排空 <公开 静态 注释 = "关闭前阻塞直到当前浏览器命令执行完毕" @输出名 = "WaitMCPCommandArrangeEmpty" @强制输出 = 真>
    {
        MCP执行锁.加锁 ()
        MCP执行锁.解锁 ()
    }

    方法 缓存数据库可用 <公开 静态 类型 = 逻辑型 @输出名 = "CacheDataLibAvailable" @强制输出 = 真>
    {
        返回 (缓存数据库已打开 && MCP正在关闭 == 假)
    }

    方法 加入持久V8扩展 <公开 静态 @输出名 = "AddPersistentV8Extension" @强制输出 = 真>
    参数 注入标识 <类型 = 文本型 @输出名 = "InjectKey">
    参数 安全code <类型 = 文本型 @输出名 = "SafeCode">
    参数 类型后缀 <类型 = 文本型 @输出名 = "TypeSuffix">
    {
        // 存储侧转义管道符, 防止code内含"|"导致读取侧分割错位
        // 四层最长token优先转义, 读取侧用占位符逆序还原, 保证 {PIPE}/{PIPE_ESC}/{PIPE_ESC_ESC} 字面量往返无损
        变量 转义code <类型 = 文本型>
        转义code = 安全code
        子文本替换 (转义code, "{PIPE_ESC_ESC}", "{PIPE_ESC_ESC_ESC}", , , 假)
        子文本替换 (转义code, "{PIPE_ESC}", "{PIPE_ESC_ESC}", , , 假)
        子文本替换 (转义code, "{PIPE}", "{PIPE_ESC}", , , 假)
        子文本替换 (转义code, "|", "{PIPE}", , , 假)
        变量 条目 <类型 = 文本型>
        条目 = 注入标识 + "|" + 转义code + "|" + 类型后缀
        变量 前缀长 <类型 = 整数>
        前缀长 = 取文本长度 (注入标识) + 1
        变量 idx <类型 = 整数>
        // 列表由浏览器事件线程读取(应用持久V8到框架), 突变必须持锁
        异步缓存锁.加锁 ()
        计次循环 (持久V8扩展列表.取成员数 ())
        {
            idx = 取循环索引 ()
            变量 现有项 <类型 = 文本型>
            现有项 = 持久V8扩展列表.取成员 (idx)
            如果 (取文本长度 (现有项) >= 前缀长 && 取文本左边 (现有项, 前缀长) == 注入标识 + "|")
            {
                持久V8扩展列表.删除成员 (idx)
                跳出循环
            }
        }
        持久V8扩展列表.加入成员 (条目)
        判断循环 (持久V8扩展列表.取成员数 () > MCP_常量.持久V8扩展上限)
        {
            持久V8扩展列表.删除成员 (0)
        }
        异步缓存锁.解锁 ()
    }

    方法 清空持久V8扩展 <公开 静态 @输出名 = "ClearPersistentV8Extension" @强制输出 = 真>
    {
        异步缓存锁.加锁 ()
        判断循环 (持久V8扩展列表.取成员数 () > 0)
        {
            持久V8扩展列表.删除成员 (0)
        }
        异步缓存锁.解锁 ()
    }

    方法 分配CDP消息ID <公开 静态 类型 = 整数 @输出名 = "AllocateCDPMessageID" @强制输出 = 真>
    {
                变量 新ID <类型 = 整数>
        @ @<新ID> = (INT)InterlockedIncrement((LONG volatile*)&@<CDP消息计数器>);
        如果 (新ID <= 0)
        {
            @ InterlockedExchange((LONG volatile*)&@<CDP消息计数器>, 1);
            新ID = 1
            控制台输出 ("[MCP] CDP消息ID已回绕, ID从1重新开始(保留在途映射)")
        }
        返回 (新ID)
    }

    方法 记录CDP请求映射 <公开 静态 @输出名 = "RecordCDPRequestMap" @强制输出 = 真>
    参数 cdpMsgId <类型 = 整数 @输出名 = "CDPMsgID">
    参数 mcp请求ID <类型 = 文本型 @输出名 = "MCPRequestID">
    参数 cdpMethod <类型 = 文本型 @输出名 = "CDPMethod">
    {
        异步缓存锁.加锁 ()
        如果 (CDP请求映射表.是否为空对象 () || CDP请求映射表.是否为空 ())
        {
            CDP请求映射表.创建 ()
        }
        CDP请求映射表.置文本值 (到文本 (cdpMsgId), mcp请求ID)
        CDP请求映射表.置文本值 ("method_" + 到文本 (cdpMsgId), cdpMethod)
        // 秒级存储防32位回绕: 毫秒约24.86天回绕为负导致过期映射永不清理, 秒级约68年
        CDP请求映射表.置整数值 ("ts_" + 到文本 (cdpMsgId), (整数)(取启动时间 () / 1000))
        // 每 N 次CDP请求触发一次过期清理 (计数移入锁内, 修复与 清理过期CDP映射 清零的竞态)
        CDP映射清理计数 = CDP映射清理计数 + 1
        异步缓存锁.解锁 ()
        如果 (CDP映射清理计数 >= MCP_常量.CDP映射清理间隔)
        {
            清理过期CDP映射 ()
        }
    }

    方法 清空CDP请求映射 <公开 静态 @输出名 = "ClearCDPRequestMap" @强制输出 = 真>
    {
        异步缓存锁.加锁 ()
        CDP请求映射表.创建 ()
        CDP映射清理计数 = 0
        异步缓存锁.解锁 ()
    }

    # 清理超过TTL的CDP映射(无响应的CDP请求会永久残留, 需定期清理)

    方法 清理过期CDP映射 <公开 静态 @输出名 = "CleanExpiredCDPMap" @强制输出 = 真>
    {
        变量 需记录清理 <类型 = 逻辑型 值 = 假>
        变量 cleaned <类型 = 整数 值 = 0>
        异步缓存锁.加锁 ()
        CDP映射清理计数 = 0
        如果 (CDP请求映射表.是否为空对象 () == 假 && CDP请求映射表.是否为空 () == 假)
        {
            变量 当前时间 <类型 = 长整数>
            当前时间 = 取启动时间 ()
            变量 过期阈值 <类型 = 长整数>
            过期阈值 = (当前时间 - MCP_常量.CDP映射TTL毫秒) / 1000  // ts为秒级存储, 阈值同步换算
            // 从最大消息ID向下扫描, 清理过期条目
            变量 maxID <类型 = 整数>
            maxID = CDP消息计数器
            如果 (maxID <= 0)
            {
                maxID = 0
            }
            变量 scanLimit <类型 = 整数>
            scanLimit = maxID + 1
            如果 (scanLimit <= 0 || scanLimit > 100000)
            {
                scanLimit = 100000  // 防溢出/死循环: 最多扫描10万条
            }
            计次循环 (scanLimit)
            {
                变量 cid <类型 = 整数>
                cid = maxID - 取循环索引 ()
                变量 ts <类型 = 整数>
                ts = CDP请求映射表.取整数值 ("ts_" + 到文本 (cid))
                如果 (ts > 0 && ts < (整数)过期阈值)
                {
                    CDP请求映射表.移除 (到文本 (cid))
                    CDP请求映射表.移除 ("method_" + 到文本 (cid))
                    CDP请求映射表.移除 ("ts_" + 到文本 (cid))
                    cleaned = cleaned + 1
                }
            }
            如果 (cleaned > 0)
            {
                需记录清理 = 真
            }
        }
        异步缓存锁.解锁 ()
        // 日志移出锁外: 控制台I/O可能阻塞, 不延长异步缓存锁持有时间
        如果 (需记录清理)
        {
            控制台输出 (到文本 ("[MCP] CDP映射清理:") + 到文本 (cleaned) + "条过期")
        }
    }

    # 将全局持久配置(代理/缩放/静音)应用到指定浏览器, 新浏览器创建时调用

    方法 应用持久配置到浏览器 <公开 静态 @输出名 = "ApplyPersistentConfigToBrowser" @强制输出 = 真>
    参数 浏览器 <类型 = 类_FBrowser_浏览器 @输出名 = "Browser">
    {
        如果 (浏览器.是否为空 () || 浏览器.是否已关闭 ())
        {
            返回
        }
        // 修复: 持久字段在MCP线程写入/UI线程此处读取, 加锁快照防撕裂(文本型为引用计数堆串, 裸读有堆损坏风险)
        变量 应用代理 <类型 = 文本型 值 = "">
        变量 应用账号 <类型 = 文本型 值 = "">
        变量 应用密码 <类型 = 文本型 值 = "">
        变量 应用缩放 <类型 = 小数 值 = 0>
        变量 应用静音 <类型 = 逻辑型 值 = 假>
        持久配置锁.加锁 ()
        应用代理 = 持久代理地址
        应用账号 = 持久代理账号
        应用密码 = 持久代理密码
        应用缩放 = 持久缩放级别
        应用静音 = 持久静音状态
        // 修复: 反检测三字段同样纳入锁快照 (持久反检测_伪装UA 为CVolString, 与代理地址同模式的跨线程堆损坏风险)
        变量 应用禁用Debugger <类型 = 逻辑型 值 = 假>
        变量 应用伪装UA <类型 = 文本型 值 = "">
        变量 应用禁用自动化 <类型 = 逻辑型 值 = 假>
        应用禁用Debugger = 持久反检测_禁用Debugger检测
        应用伪装UA = 持久反检测_伪装UA
        应用禁用自动化 = 持久反检测_禁用自动化标志
        持久配置锁.解锁 ()
        如果 (应用代理 != "")
        {
            浏览器.设置代理 (应用代理, 应用账号, 应用密码)
        }
        如果 (应用缩放 > 0)
        {
            浏览器.置缩放级别 (应用缩放)
        }
        浏览器.置页面静音 (应用静音)
        // v2.6.2: 反检测预配置 — 浏览器创建时自动应用, 无需逐命令
        如果 (应用禁用Debugger)
        {
            变量 vipCtrl <类型 = 类_FBrowserVIP_控制器>
            vipCtrl = 浏览器.取VIP控制器 ()
            如果 (vipCtrl.是否为空 () == 假)
            {
                vipCtrl.内核开关_禁用Debugger (真)
                控制台输出 ("[MCP] 反检测: 已禁用Debugger检测 (浏览器创建时自动应用)")
            }
        }
        如果 (应用伪装UA != "")
        {
            变量 vipUACtrl <类型 = 类_FBrowserVIP_控制器>
            vipUACtrl = 浏览器.取VIP控制器 ()
            如果 (vipUACtrl.是否为空 () == 假)
            {
                变量 uaData <类型 = 类_FBrowserVIP_UA数据>
                uaData.创建 ()
                uaData.置UserAgent (应用伪装UA)
                vipUACtrl.指纹_虚拟UserAgent (uaData)
                控制台输出 ("[MCP] 反检测: UA伪装已应用 (浏览器创建时自动)")
            }
        }
        如果 (应用禁用自动化)
        {
            变量 vipAutoCtrl <类型 = 类_FBrowserVIP_控制器>
            vipAutoCtrl = 浏览器.取VIP控制器 ()
            如果 (vipAutoCtrl.是否为空 () == 假)
            {
                vipAutoCtrl.指纹_虚拟Webdriver (假)
                控制台输出 ("[MCP] 反检测: 自动化标志已禁用 (浏览器创建时自动)")
            }
        }
    }

    # 持久 inject: 浏览器进程在框架载入时执行 (规避渲染进程静态列表不可见 + 火山跳过 mid-file 方法)

    方法 应用持久V8到框架 <公开 静态 @输出名 = "ApplyPersistentV8ToFrame" @强制输出 = 真>
    参数 框架 <类型 = 类_FBrowser_框架 @输出名 = "Frame">
    {
        如果 (框架.是否为空 ())
        {
            返回
        }
        // 持锁快照列表, 避免与MCP线程的加入/清空并发撕裂; JS执行在锁外进行
        变量 快照 <类型 = 文本数组类>
        异步缓存锁.加锁 ()
        如果 (持久V8扩展列表.取成员数 () == 0)
        {
            异步缓存锁.解锁 ()
            返回
        }
        计次循环 (持久V8扩展列表.取成员数 ())
        {
            快照.加入成员 (持久V8扩展列表.取成员 (取循环索引 ()))
        }
        异步缓存锁.解锁 ()
        变量 已见标识 <类型 = 文本型 值 = "\n">
        变量 总数 <类型 = 整数>
        总数 = 快照.取成员数 ()
        计次循环 (总数)
        {
            变量 idx <类型 = 整数>
            idx = 总数 - 1 - 取循环索引 ()
            变量 注入项 <类型 = 文本型>
            注入项 = 快照.取成员 (idx)
            如果 (注入项 == "")
            {
                到循环尾
            }
            变量 parts <类型 = 文本数组类>
            分割文本 (注入项, "|", parts, 真, 假)
            如果 (parts.取成员数 () < 3)
            {
                到循环尾
            }
            变量 extName <类型 = 文本型>
            extName = parts.取成员 (0)
            如果 (寻找文本 (已见标识, "\n" + extName + "\n", 0, 假) != -1)
            {
                到循环尾
            }
            已见标识 = 已见标识 + extName + "\n"
            变量 extCode <类型 = 文本型>
            extCode = parts.取成员 (1)
            变量 extType <类型 = 文本型>
            extType = parts.取成员 (2)
            // 还原: 先用占位符保护最长token, 防串级还原 (修复 {PIPE_ESC}/{PIPE_ESC_ESC} 字面量被误还原)
            // 占位符 {MPE1}/{MPE2}/{MPE3} 形似非法JS片段, 实际注入代码几乎不可能包含
            子文本替换 (extCode, "{PIPE_ESC_ESC_ESC}", "{MPE3}", , , 假)
            子文本替换 (extCode, "{PIPE_ESC_ESC}", "{MPE2}", , , 假)
            子文本替换 (extCode, "{PIPE_ESC}", "{MPE1}", , , 假)
            子文本替换 (extCode, "{PIPE}", "|", , , 假)
            子文本替换 (extCode, "{MPE1}", "{PIPE}", , , 假)
            子文本替换 (extCode, "{MPE2}", "{PIPE_ESC}", , , 假)
            子文本替换 (extCode, "{MPE3}", "{PIPE_ESC_ESC}", , , 假)
            如果 (extType == "js" || extType == "handler")
            {
                框架.执行JS代码 (extCode)
            }
        }
    }

    方法 处理CDP响应 <公开 静态 @输出名 = "HandleCDPResponse" @强制输出 = 真>
    参数 消息ID <类型 = 整数 @输出名 = "MessageID">
    参数 成功 <类型 = 逻辑型 @输出名 = "Success">
    参数 结果指针 <类型 = 变整数 @输出名 = "ResultPtr">
    参数 结果大小 <类型 = 整数 @输出名 = "ResultSize">
    {
        // 从CDP映射表提取请求信息(锁保护, 与记录CDP请求映射配对)
        // v2.4: 单次持锁完成提取+清理, 避免双重加锁
        变量 mcp请求ID <类型 = 文本型>
        变量 cdpMethod <类型 = 文本型>
        mcp请求ID = ""
        cdpMethod = ""
        异步缓存锁.加锁 ()
        如果 (CDP请求映射表.是否为空对象 () == 假 && CDP请求映射表.是否为空 () == 假)
        {
            mcp请求ID = CDP请求映射表.取文本值 (到文本 (消息ID))
            cdpMethod = CDP请求映射表.取文本值 ("method_" + 到文本 (消息ID))
            // 清理映射: 移除条目防止字典无限增长
            如果 (mcp请求ID != "")
            {
                CDP请求映射表.移除 (到文本 (消息ID))
                CDP请求映射表.移除 ("method_" + 到文本 (消息ID))
                CDP请求映射表.移除 ("ts_" + 到文本 (消息ID))
            }
        }
        异步缓存锁.解锁 ()
        如果 (mcp请求ID != "")
        {
            变量 结果对象 <类型 = YYJSON对象类>
            结果对象.创建自文本 ("{}")
            结果对象.加入逻辑值成员 ("success", 成功)
            结果对象.加入整数成员 ("messageId", 消息ID)
            如果 (cdpMethod != "")
            {
                结果对象.加入文本成员 ("method", cdpMethod)
            }
            变量 结果文本 <类型 = 文本型>
            结果文本 = ""
            如果 (结果指针 != 0 && 结果大小 > 0)
            {
                变量 结果UTF8 <类型 = 字节集类>
                结果UTF8 = 指针到字节集 (结果指针, 结果大小)
                结果文本 = UTF8到文本 (结果UTF8)
                // 修复: 按字节安全截断(阈值语义为字节), 原按字符比较会放大至约3倍且切多字节字符产生U+FFFD
                如果 (取字节集长度 (结果UTF8) > MCP_常量.截断_CDP结果最大字节)
                {
                    结果文本 = 字节安全截断 (结果文本, MCP_常量.截断_CDP结果最大字节) + "...[CDP结果已截断]"
                }
            }
            如果 (成功)
            {
                如果 (结果文本 != "")
                {
                    结果对象.加入文本成员 ("result", 结果文本)
                }
            }
            否则
            {
                如果 (结果文本 != "")
                {
                    结果对象.加入文本成员 ("error", 结果文本)
                }
            }
            // 存储结果(不在锁内调用, 避免锁嵌套)
            存储异步结果 (mcp请求ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩))
        }
    }

    方法 存储CDPDevTools事件 <公开 静态 @输出名 = "StoreCDPDevToolsEvent" @强制输出 = 真>
    参数 事件方法名 <类型 = 文本型 @输出名 = "EventMethodName">
    参数 参数JSON <类型 = 文本型 @输出名 = "ParamJSON">
    {
        如果 (事件方法名 == "")
        {
            返回
        }
        变量 参数字段 <类型 = 文本型>
        参数字段 = 参数JSON
        如果 (参数字段 == "")
        {
            参数字段 = "{}"
        }
        // 缓存存裸 params,避免 wrapper.message 二次解析失败
        存储异步结果 ("cdp_event:" + 事件方法名, 参数字段)
        // CDP 事件高频, 仅保留 async 缓存供 wait/event 查询, 不写 event_log 防膨胀
        // v2.8.2 例外: Debugger.scriptParsed 每脚本只上报一次, 但单槽缓存只留最后一条,
        // 结果拿不到全部 scriptId → searchInContent/getPossibleBreakpoints/setScriptSource 全都无法实现。
        // 故单独累积进脚本注册表(去重+上限), 作为 V8 级插装的前置基础设施。
        如果 (事件方法名 == "Debugger.scriptParsed")
        {
            添加脚本注册表项 (参数字段)
        }
        // v2.8.2: 导航后旧文档的 scriptId 全部失效(检索会报 "No script for id"),
        // 故在 frameNavigated 时清表; 新文档的脚本会由后续 scriptParsed 重新累积。
        // (不清表会让注册表越滚越大且带一堆死 id, 实测已出现 stale_scripts=10)
        如果 (事件方法名 == "Page.frameNavigated")
        {
            清空脚本注册表 ()
            // 新文档里不可能还存在按下的触摸点, 触摸状态必须跟着清零,
            // 否则后续 touch_move 会误以为"已有按下点"而把事件发进一个不存在的触摸序列(静默无反应)。
            触摸点已按下 = 假
            触摸点X = -1
            触摸点Y = -1
        }
        // CDP监控订阅钩子: 命中 browser_kernel_cdp_monitor 订阅的方法模式时写入 event_log。
                MCP_内核分派.检查CDP监控 (事件方法名, 参数字段)
    }

    # ======== v2.8.2: V8 脚本注册表 ==========
    # scriptId 是 Debugger.searchInContent / getPossibleBreakpoints / setScriptSource 的前置条件,
    # 而通用 CDP 事件缓存按方法名单槽存储(后到覆盖先到), 无法枚举全部脚本 —— 故独立累积。

    方法 添加脚本注册表项 <公开 静态 @输出名 = "AddScriptRegistryItem" @强制输出 = 真>
    参数 脚本参数JSON <类型 = 文本型 @输出名 = "ScriptParamJSON">
    {
        如果 (脚本参数JSON == "")
        {
            返回
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (脚本参数JSON) == 假)
        {
            返回
        }
        变量 脚本ID <类型 = 文本型>
        脚本ID = yyjson取文本 (解析, "scriptId")
        如果 (脚本ID == "")
        {
            返回
        }
        // 去重: 同一 scriptId 可能重复上报(重复 enable / 同脚本多次编译)
        计次循环 (脚本ID表.取成员数 ())
        {
            如果 (脚本ID表.取成员 (取循环索引 ()) == 脚本ID)
            {
                返回
            }
        }
        // 上限约束: 长时间会话/大量动态脚本(eval/blob/Worker)下防无限增长, 超限淘汰最旧
        判断循环 (脚本ID表.取成员数 () >= 500)
        {
            脚本ID表.删除成员 (0)
            脚本URL表.删除成员 (0)
            脚本长度表.删除成员 (0)
            脚本注册表.删除成员 (0)
        }
        变量 脚本URL <类型 = 文本型>
        脚本URL = yyjson取文本 (解析, "url")
        变量 脚本长 <类型 = 整数>
        脚本长 = yyjson取整数 (解析, "length")
        变量 条目 <类型 = YYJSON对象类>
        条目.创建自文本 ("{}")
        条目.加入文本成员 ("scriptId", 脚本ID)
        条目.加入文本成员 ("url", 脚本URL)
        条目.加入整数成员 ("length", 脚本长)
        条目.加入整数成员 ("startLine", yyjson取整数 (解析, "startLine"))
        条目.加入整数成员 ("endLine", yyjson取整数 (解析, "endLine"))
        条目.加入逻辑值成员 ("isModule", 解析.取逻辑值 ("isModule"))
        脚本ID表.加入成员 (脚本ID)
        脚本URL表.加入成员 (脚本URL)
        脚本长度表.加入成员 (到文本 (脚本长))
        脚本注册表.加入成员 (条目.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 取最大脚本ID <公开 静态 类型 = 文本型 注释 = "返回当前注册表中字节长度最大的 scriptId(混淆包通常最大)。空注册表返回空文本。" @输出名 = "GetLargestScriptID" @强制输出 = 真>
    {
        如果 (脚本ID表.取成员数 () == 0)
        {
            返回 ("")
        }
        变量 最大长 <类型 = 整数 值 = -1>
        变量 最大ID <类型 = 文本型 值 = "">
        计次循环 (脚本ID表.取成员数 ())
        {
            变量 本长 <类型 = 整数>
            本长 = 文本到整数 (脚本长度表.取成员 (取循环索引 ()))
            如果 (本长 > 最大长)
            {
                最大长 = 本长
                最大ID = 脚本ID表.取成员 (取循环索引 ())
            }
        }
        返回 (最大ID)
    }

    方法 取脚本URL按ID <公开 静态 类型 = 文本型 @输出名 = "GetScriptURLByID" @强制输出 = 真>
    参数 脚本ID <类型 = 文本型 @输出名 = "ScriptID">
    {
        计次循环 (脚本ID表.取成员数 ())
        {
            如果 (脚本ID表.取成员 (取循环索引 ()) == 脚本ID)
            {
                返回 (脚本URL表.取成员 (取循环索引 ()))
            }
        }
        返回 ("")
    }

    方法 确保脚本注册表就绪 <公开 静态 类型 = 整数 注释 = "零前置: 注册表为空时自动启用调试器并等待 Debugger.scriptParsed 上报(最多约1.8秒), 返回就绪后的脚本条数。三个需要 scriptId 的工具共用本实现 —— 同一逻辑只留一份。" @输出名 = "EnsureScriptRegistryReady" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    {
        如果 (脚本ID表.取成员数 () > 0)
        {
            返回 (脚本ID表.取成员数 ())
        }
        执行CDP并同步等待 (命令ID + "_ben", "Debugger.enable", "{}", 15000)
        变量 等待次数 <类型 = 整数 值 = 0>
        判断循环 (等待次数 < 12 && 脚本ID表.取成员数 () == 0)
        {
            延时 (150)
            等待次数 = 等待次数 + 1
        }
        MCP_响应构建.记录自动补域 ("Debugger")
        返回 (脚本ID表.取成员数 ())
    }

    方法 取脚本注册表JSON <公开 静态 类型 = 文本型 @输出名 = "GetScriptRegistryJSON" @强制输出 = 真>
    {
        变量 结果 <类型 = 文本型>
        结果 = "["
        计次循环 (脚本注册表.取成员数 ())
        {
            如果 (取循环索引 () > 0)
            {
                结果 = 结果 + ","
            }
            结果 = 结果 + 脚本注册表.取成员 (取循环索引 ())
        }
        结果 = 结果 + "]"
        返回 (结果)
    }

    方法 清空脚本注册表 <公开 静态 @输出名 = "ClearScriptRegistry" @强制输出 = 真>
    {
        判断循环 (脚本ID表.取成员数 () > 0)
        {
            脚本ID表.删除成员 (0)
            脚本URL表.删除成员 (0)
            脚本长度表.删除成员 (0)
            脚本注册表.删除成员 (0)
        }
    }

    # 部分 FBrowser 版本仅走 OnDevToolsMessage，不走 OnDevToolsEvent

    方法 处理DevTools原始消息 <公开 静态 @输出名 = "HandleDevToolsRawMessage" @强制输出 = 真>
    参数 消息JSON <类型 = 文本型 @输出名 = "MessageJSON">
    {
        如果 (消息JSON == "")
        {
            返回
        }
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (消息JSON) == 假)
        {
            返回
        }
        变量 事件Method <类型 = 文本型>
        事件Method = yyjson取文本 (包装, "method")
        如果 (事件Method == "")
        {
            返回
        }
        变量 响应ID <类型 = 文本型>
        响应ID = yyjson取文本 (包装, "id")
        如果 (响应ID != "")
        {
            返回
        }
        变量 paramsJSON <类型 = 文本型>
        paramsJSON = yyjson取JSON文本 (包装, "params")
        // resume后立即清除paused事件缓存: 防 debugger 快速失败检查误判"仍在暂停"
        如果 (事件Method == "Debugger.resumed")
        {
            清除CDP事件记录 ("Debugger.paused")
        }
        存储CDPDevTools事件 (事件Method, paramsJSON)
    }

    # ======== Debugger/CDP 事件辅助 (断点命中 → 帧求值 → 继续) ==========

    方法 取CDP事件数据JSON <公开 静态 类型 = 文本型 @输出名 = "GetCDPEventDataJSON" @强制输出 = 真>
    参数 事件名 <类型 = 文本型 @输出名 = "EventName">
    {
        变量 cache <类型 = 文本型>
        cache = 查询任务结果 ("cdp_event:" + 事件名)
        如果 (cache != "")
        {
            返回 (解包CDPDevTools事件JSON (cache))
        }
        变量 logs <类型 = 文本型>
        logs = 查询事件日志 ("cdp_event", 事件名, 0, 1)
        如果 (logs != "" && logs != "[]" && 是否以 (logs, "["))
        {
            // 0-based语义: 去掉首尾的[ ], 内容从索引1起 len-2 个字符
            返回 (解包CDPDevTools事件JSON (取文本中间 (logs, 1, 取文本长度 (logs) - 2)))
        }
        返回 ("")
    }

    # 存储格式为 {success,message,cdpEvent} 时解出 params；已是 callFrames 则原样返回

    方法 解包CDPDevTools事件JSON <公开 静态 类型 = 文本型 @输出名 = "UnpackCDPDevToolsEventJSON" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        如果 (存储JSON == "")
        {
            返回 ("")
        }
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (存储JSON) == 假)
        {
            返回 (存储JSON)
        }
        变量 cfDirect <类型 = YYJSON只读数组类>
        cfDirect = 包装.取数组 ("callFrames")
        如果 (cfDirect.取成员数 () > 0)
        {
            返回 (存储JSON)
        }
        变量 msg <类型 = 文本型>
        msg = yyjson取文本 (包装, "message")
        如果 (msg == "")
        {
            msg = yyjson取JSON文本 (包装, "message")
        }
        如果 (msg != "")
        {
            变量 inner <类型 = YYJSON只读对象类>
            如果 (inner.创建自文本 (msg))
            {
                返回 (msg)
            }
            如果 (寻找文本 (msg, "\"callFrames\"", 0, 假) != -1)
            {
                返回 (msg)
            }
        }
        返回 (存储JSON)
    }

    方法 提取JSON文本字段值 <公开 静态 类型 = 文本型 @输出名 = "ExtractJSONTextFieldValue" @强制输出 = 真>
    参数 JSON文本 <类型 = 文本型 @输出名 = "JSONText">
    参数 字段名 <类型 = 文本型 @输出名 = "FieldName">
    {
        // 修复: 改yyjson解析, 正确处理转义引号/冒号后空白 (原手写定位遇CDP事件含转义会截断错位)
        如果 (JSON文本 == "" || 字段名 == "")
        {
            返回 ("")
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (JSON文本) == 假)
        {
            返回 ("")
        }
        返回 (yyjson取文本 (解析, 字段名))
    }

    方法 提取JSON整数字段值 <公开 静态 类型 = 整数 @输出名 = "ExtractJSONIntFieldValue" @强制输出 = 真>
    参数 JSON文本 <类型 = 文本型 @输出名 = "JSONText">
    参数 字段名 <类型 = 文本型 @输出名 = "FieldName">
    {
                如果 (JSON文本 == "" || 字段名 == "")
        {
            返回 (0)
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (JSON文本) == 假)
        {
            返回 (0)
        }
        返回 (yyjson取整数 (解析, 字段名))
    }

    方法 解析双文本表 <公开 静态 类型 = FBrowser_双文本数组 @输出名 = "ParseDoubleTextTable" @强制输出 = 真>
    参数 文本 <类型 = 文本型 @输出名 = "Text">
    {
        // 把紧凑写法 "brand:version,brand2:version2" 解析成类库的 FBrowser_双文本数组 ——
        // browser_fingerprint_ua 的 brands / full_version_list 要的就是它。
        // 为什么不用 JSON 数组: 本项目存在 YYJSON 嵌套数组的崩溃风险, 紧凑文本既避开它,
        // 也更好让 AI 生成; 没有冒号的一段按"只有 brand、version 留空"处理。
        变量 结果 <类型 = FBrowser_双文本数组>
        结果.创建 ()
        变量 段数组 <类型 = 文本数组类>
        分割文本 (文本, ",", 段数组, 真, 真)
        变量 段数 <类型 = 整数>
        段数 = 段数组.取成员数 ()
        计次循环 (段数)
        {
            变量 一段 <类型 = 文本型>
            一段 = 删首尾空 (段数组.取成员 (取循环索引 ()))
            如果 (一段 != "")
            {
                变量 项 <类型 = FBrowser_双文本>
                变量 冒号位 <类型 = 整数>
                冒号位 = 寻找文本 (一段, ":", 0, 假)
                如果 (冒号位 == -1)
                {
                    项.name = 一段
                    项.value = ""
                }
                否则
                {
                    项.name = 取文本左边 (一段, 冒号位)
                    项.value = 取文本中间 (一段, 冒号位 + 1, 取文本长度 (一段) - 冒号位 - 1)
                }
                结果.加入成员 (项)
            }
        }
        返回 (结果)
    }

    方法 从Debugger暂停文本构建摘要 <公开 静态 类型 = 文本型 @输出名 = "FromDebuggerPauseTextBuildSummary" @强制输出 = 真>
    参数 源JSON <类型 = 文本型 @输出名 = "SourceJSON">
    {
        变量 text <类型 = 文本型>
        text = 解包CDPDevTools事件JSON (源JSON)
        如果 (text == "")
        {
            返回 ("{}")
        }
        变量 callFrameId <类型 = 文本型>
        callFrameId = 提取JSON文本字段值 (text, "callFrameId")
        如果 (callFrameId == "")
        {
            返回 ("{}")
        }
        变量 reason <类型 = 文本型>
        reason = 提取JSON文本字段值 (text, "reason")
        变量 funcName <类型 = 文本型>
        funcName = 提取JSON文本字段值 (text, "functionName")
        变量 url <类型 = 文本型>
        url = 提取JSON文本字段值 (text, "url")
        变量 scriptId <类型 = 文本型>
        scriptId = 提取JSON文本字段值 (text, "scriptId")
        变量 lineNo <类型 = 整数>
        lineNo = 提取JSON整数字段值 (text, "lineNumber")
        变量 colNo <类型 = 整数>
        colNo = 提取JSON整数字段值 (text, "columnNumber")
        变量 framesJSON <类型 = 文本型>
        framesJSON = "[{\"callFrameId\":\"" + MCP_响应构建.JSON转义文本 (callFrameId) + "\",\"functionName\":\"" + MCP_响应构建.JSON转义文本 (funcName) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (url) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\",\"lineNumber\":" + 到文本 (lineNo) + ",\"columnNumber\":" + 到文本 (colNo) + "}]"
        返回 ("{\"reason\":\"" + MCP_响应构建.JSON转义文本 (reason) + "\",\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (callFrameId) + "\",\"functionName\":\"" + MCP_响应构建.JSON转义文本 (funcName) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (url) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\",\"lineNumber\":" + 到文本 (lineNo) + ",\"columnNumber\":" + 到文本 (colNo) + ",\"scopes\":[],\"hitBreakpoints\":[],\"frames\":" + framesJSON + ",\"_fallback\":true}")
    }

    方法 等待CDP事件 <公开 静态 类型 = 文本型 @输出名 = "WaitCDPEvent" @强制输出 = 真>
    参数 事件名 <类型 = 文本型 @输出名 = "EventName">
    参数 最大毫秒 <类型 = 整数 @输出名 = "MaxMs">
    参数 清除旧记录 <类型 = 逻辑型 @默认值 = 假 @输出名 = "ClearDelOldRecord">
    {
        如果 (事件名 == "")
        {
            返回 ("")
        }
        如果 (最大毫秒 <= 0)
        {
            最大毫秒 = 30000
        }
        如果 (清除旧记录)
        {
            清除CDP事件记录 (事件名)
        }
        变量 截止 <类型 = 长整数>
        截止 = 取启动时间 () + 最大毫秒
        判断循环 (取启动时间 () < 截止)
        {
            如果 (MCP正在关闭)
            {
                返回 ("")
            }
            变量 data <类型 = 文本型>
            // 释放 MCP 锁,让 CEF/VIP DevTools 回调与导航继续推进
            MCP执行锁.解锁 ()
            data = 取CDP事件数据JSON (事件名)
            MCP执行锁.加锁 ()
            如果 (data != "")
            {
                // 锁已在本循环内重新获取, 直接返回让调用者(执行浏览器命令)统一解锁, 避免双重解锁
                返回 (data)
            }
            MCP执行锁.解锁 ()
            延时 (100)
            MCP执行锁.加锁 ()
        }
        返回 ("")
    }

    # 释放 MCP 锁的短延时 — 避免 UI 线程 sleep 导致 CEF/CDP/Debugger 回调饿死

    方法 MCP可中断延时 <公开 静态 @输出名 = "MCPCanInterruptDelay" @强制输出 = 真>
    参数 毫秒 <类型 = 整数 @输出名 = "Ms">
    参数 分片毫秒 <类型 = 整数 @默认值 = 50 @输出名 = "ShardMs">
    参数 是否持锁 <类型 = 逻辑型 注释 = "调用方已持有MCP执行锁时默认真(延时期间放锁); 未持锁必须传假, 否则对未持有锁解锁是未定义行为" @默认值 = 真 @输出名 = "IsHoldLock">
    {
        如果 (毫秒 <= 0)
        {
            返回
        }
        变量 截止 <类型 = 长整数>
        截止 = 取启动时间 () + 毫秒
        判断循环 (取启动时间 () < 截止)
        {
            如果 (MCP正在关闭 || MCP_编排分派.工作流应停止)
            {
                返回
            }
            如果 (是否持锁)
            {
                MCP执行锁.解锁 ()
                延时 (分片毫秒)
                MCP执行锁.加锁 ()
            }
            否则
            {
                                延时 (分片毫秒)
            }
        }
    }

    方法 DebuggerFlow尝试Resume <公开 静态 类型 = 逻辑型 @输出名 = "DebuggerFlowTryResume" @强制输出 = 真>
    参数 命令ID前缀 <类型 = 文本型 @输出名 = "CommandIDPrefix">
    {
        变量 i <类型 = 整数>
        i = 0
        判断循环 (i < 3)
        {
            变量 rsRaw <类型 = 文本型>
            rsRaw = 执行CDP并同步等待 (命令ID前缀 + "_rs" + 到文本 (i), "Debugger.resume", "{}", 8000)
            如果 (rsRaw != "" && CDP同步结果是否成功 (rsRaw))
            {
                返回 (真)
            }
            i = i + 1
        }
        返回 (假)
    }

    方法 DebuggerFlow失败返回 <公开 静态 类型 = 文本型 @输出名 = "DebuggerFlowFailureReturn" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 错误JSON <类型 = 文本型 @输出名 = "ErrorJSON">
    {
        DebuggerFlow尝试Resume (命令ID + "_fail")
        返回 (错误JSON)
    }

    方法 构建Debugger帧列表JSON <公开 静态 类型 = 文本型 @输出名 = "BuildDebuggerFrameListJSON" @强制输出 = 真>
    参数 frames <类型 = YYJSON只读数组类 @输出名 = "Frames">
    参数 最大条数 <类型 = 整数 @默认值 = 8 @输出名 = "MaxCount">
    {
        如果 (frames.是否为空对象 () || frames.取成员数 () == 0)
        {
            返回 ("[]")
        }
        变量 上限 <类型 = 整数>
        上限 = (整数)frames.取成员数 ()
        如果 (上限 > 最大条数)
        {
            上限 = 最大条数
        }
        变量 out <类型 = 文本型>
        out = "["
        计次循环 (上限)
        {
            如果 (取循环索引 () > 0)
            {
                out = out + ","
            }
            变量 fi <类型 = YYJSON只读对象类>
            fi = frames.取成员 (取循环索引 ())
            变量 locFi <类型 = YYJSON只读对象类>
            locFi = fi.取对象 ("location")
            变量 fnLine <类型 = 整数>
            fnLine = yyjson取整数 (fi, "lineNumber")
            如果 (fnLine == 0)
            {
                fnLine = yyjson取整数 (locFi, "lineNumber")
            }
            变量 fnCol <类型 = 整数>
            fnCol = yyjson取整数 (fi, "columnNumber")
            如果 (fnCol == 0)
            {
                fnCol = yyjson取整数 (locFi, "columnNumber")
            }
            变量 fnScript <类型 = 文本型>
            fnScript = yyjson取文本 (locFi, "scriptId")
            out = out + "{\"callFrameId\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (fi, "callFrameId")) + "\",\"functionName\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (fi, "functionName")) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (fi, "url")) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (fnScript) + "\",\"lineNumber\":" + 到文本 (fnLine) + ",\"columnNumber\":" + 到文本 (fnCol) + "}"
        }
        out = out + "]"
        返回 (out)
    }

    方法 构建Debugger作用域摘要JSON <公开 静态 类型 = 文本型 @输出名 = "BuildDebuggerScopeSummaryJSON" @强制输出 = 真>
    参数 scopeChain <类型 = YYJSON只读数组类 @输出名 = "ScopeChain">
    参数 最大条数 <类型 = 整数 @默认值 = 6 @输出名 = "MaxCount">
    {
        如果 (scopeChain.是否为空对象 () || scopeChain.取成员数 () == 0)
        {
            返回 ("[]")
        }
        变量 上限 <类型 = 整数>
        上限 = (整数)scopeChain.取成员数 ()
        如果 (上限 > 最大条数)
        {
            上限 = 最大条数
        }
        变量 out <类型 = 文本型>
        out = "["
        计次循环 (上限)
        {
            如果 (取循环索引 () > 0)
            {
                out = out + ","
            }
            变量 sc <类型 = YYJSON只读对象类>
            sc = scopeChain.取成员 (取循环索引 ())
            变量 scObj <类型 = YYJSON只读对象类>
            scObj = sc.取对象 ("object")
            out = out + "{\"type\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (sc, "type")) + "\",\"name\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (sc, "name")) + "\",\"className\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (scObj, "className")) + "\"}"
        }
        out = out + "]"
        返回 (out)
    }

    方法 解析Debugger暂停摘要 <公开 静态 类型 = 文本型 @输出名 = "ParseDebuggerPauseSummary" @强制输出 = 真>
    参数 包装JSON <类型 = 文本型 @输出名 = "WrapperJSON">
    {
        包装JSON = 解包CDPDevTools事件JSON (包装JSON)
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (包装JSON) == 假)
        {
            返回 (从Debugger暂停文本构建摘要 (包装JSON))
        }
        变量 msg <类型 = 文本型>
        msg = yyjson取JSON文本 (包装, "message")
        如果 (msg == "")
        {
            msg = yyjson取文本 (包装, "message")
        }
        变量 暂停 <类型 = YYJSON只读对象类>
        变量 已解析 <类型 = 逻辑型 值 = 假>
        如果 (msg != "" && 暂停.创建自文本 (msg))
        {
            已解析 = 真
        }
        如果 (已解析 == 假)
        {
            变量 cfTry <类型 = YYJSON只读数组类>
            cfTry = 包装.取数组 ("callFrames")
            如果 (cfTry.取成员数 () > 0)
            {
                暂停 = 包装
                已解析 = 真
            }
        }
        如果 (已解析 == 假)
        {
            返回 (从Debugger暂停文本构建摘要 (包装JSON))
        }
        变量 reason <类型 = 文本型>
        reason = yyjson取文本 (暂停, "reason")
        变量 frames <类型 = YYJSON只读数组类>
        frames = 暂停.取数组 ("callFrames")
        变量 callFrameId <类型 = 文本型>
        callFrameId = ""
        变量 funcName <类型 = 文本型>
        funcName = ""
        变量 url <类型 = 文本型>
        url = ""
        变量 lineNo <类型 = 整数>
        lineNo = 0
        变量 colNo <类型 = 整数>
        colNo = 0
        变量 scriptId <类型 = 文本型>
        scriptId = ""
        变量 scopesJSON <类型 = 文本型>
        scopesJSON = "[]"
        如果 (frames.取成员数 () > 0)
        {
            变量 frame0 <类型 = YYJSON只读对象类>
            frame0 = frames.取成员 (0)
            callFrameId = yyjson取文本 (frame0, "callFrameId")
            funcName = yyjson取文本 (frame0, "functionName")
            url = yyjson取文本 (frame0, "url")
            变量 loc0 <类型 = YYJSON只读对象类>
            loc0 = frame0.取对象 ("location")
            lineNo = yyjson取整数 (frame0, "lineNumber")
            如果 (lineNo == 0)
            {
                lineNo = yyjson取整数 (loc0, "lineNumber")
            }
            colNo = yyjson取整数 (frame0, "columnNumber")
            如果 (colNo == 0)
            {
                colNo = yyjson取整数 (loc0, "columnNumber")
            }
            scriptId = yyjson取文本 (loc0, "scriptId")
            scopesJSON = 构建Debugger作用域摘要JSON (frame0.取数组 ("scopeChain"), 6)
        }
        变量 framesJSON <类型 = 文本型>
        framesJSON = 构建Debugger帧列表JSON (frames, 8)
        变量 hitJSON <类型 = 文本型>
        hitJSON = yyjson取JSON文本 (暂停, "hitBreakpoints")
        如果 (hitJSON == "")
        {
            hitJSON = "[]"
        }
        返回 ("{\"reason\":\"" + MCP_响应构建.JSON转义文本 (reason) + "\",\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (callFrameId) + "\",\"functionName\":\"" + MCP_响应构建.JSON转义文本 (funcName) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (url) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\",\"lineNumber\":" + 到文本 (lineNo) + ",\"columnNumber\":" + 到文本 (colNo) + ",\"scopes\":" + scopesJSON + ",\"hitBreakpoints\":" + hitJSON + ",\"frames\":" + framesJSON + "}")
    }

    方法 执行Debugger帧求值并等待 <公开 静态 类型 = 文本型 @输出名 = "ExecuteDebuggerFrameEvaluateAndWait" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 callFrameId <类型 = 文本型 @输出名 = "CallFrameID">
    参数 expression <类型 = 文本型 @输出名 = "Expression">
    参数 最大毫秒 <类型 = 整数 @默认值 = 8000 @输出名 = "MaxMs">
    参数 returnByValue <类型 = 逻辑型 @默认值 = 真 @输出名 = "ReturnByValue">
    {
        如果 (callFrameId == "" || expression == "")
        {
            返回 ("")
        }
        变量 evParams <类型 = YYJSON对象类>
        evParams.创建自文本 ("{}")
        evParams.加入文本成员 ("callFrameId", callFrameId)
        evParams.加入文本成员 ("expression", expression)
        如果 (returnByValue)
        {
            evParams.加入逻辑值成员 ("returnByValue", 真)
        }
        变量 子ID <类型 = 文本型>
        子ID = 命令ID + "_ev"
        执行CDP命令_带参数 (子ID, "Debugger.evaluateOnCallFrame", evParams.到可读文本 (YYJSON格式化选项.压缩))
        返回 (同步等待异步任务 (子ID, 最大毫秒))
    }

    方法 取Debugger求值展开 <公开 静态 类型 = 逻辑型 @输出名 = "GetDebuggerEvaluateExpand" @强制输出 = 真>
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        // 修复: 原用 yyjson取文本 读布尔参数 —— yyjson取文本 对 JSON 布尔节点返回空串,
        // 故 expand:false(真布尔) 读不到, 恒返回真, 无法关闭 object/function 属性展开。
        // 改走 yyjson取逻辑_默认(按节点类型取值: 布尔/数值/文本分别处理, 缺键回默认)。
        返回 (yyjson取逻辑_默认 (参数JSON, "expand", 真))
    }

    方法 取Debugger求值ReturnByValue <公开 静态 类型 = 逻辑型 @输出名 = "GetDebuggerEvaluateReturnByValue" @强制输出 = 真>
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        // 修复: 同 取Debugger求值展开 —— 原 yyjson取文本 对布尔节点返回空串,
        // 故 return_by_value:false 被忽略, 恒用 returnByValue=true。
        返回 (yyjson取逻辑_默认 (参数JSON, "return_by_value", 真))
    }

    方法 RemoteObject摘要JSON <公开 静态 类型 = 文本型 @输出名 = "RemoteObjectSummaryJSON" @强制输出 = 真>
    参数 remote <类型 = YYJSON只读对象类 @输出名 = "Remote">
    {
        如果 (remote.是否为空对象 () || remote.是否为空 ())
        {
            返回 ("{}")
        }
        变量 valType <类型 = 文本型>
        valType = yyjson取文本 (remote, "type")
        变量 val <类型 = 文本型>
        val = yyjson取文本 (remote, "value")
        变量 desc <类型 = 文本型>
        desc = yyjson取文本 (remote, "description")
        变量 unser <类型 = 文本型>
        unser = yyjson取文本 (remote, "unserializableValue")
        变量 objId <类型 = 文本型>
        objId = yyjson取文本 (remote, "objectId")
        变量 cls <类型 = 文本型>
        cls = yyjson取文本 (remote, "className")
        变量 sub <类型 = 文本型>
        sub = yyjson取文本 (remote, "subtype")
        如果 (val == "" && unser != "")
        {
            val = unser
        }
        返回 ("{\"type\":\"" + MCP_响应构建.JSON转义文本 (valType) + "\",\"value\":\"" + MCP_响应构建.JSON转义文本 (val) + "\",\"description\":\"" + MCP_响应构建.JSON转义文本 (desc) + "\",\"objectId\":\"" + MCP_响应构建.JSON转义文本 (objId) + "\",\"className\":\"" + MCP_响应构建.JSON转义文本 (cls) + "\",\"subtype\":\"" + MCP_响应构建.JSON转义文本 (sub) + "\"}")
    }

    方法 Runtime取对象属性JSON <公开 静态 类型 = 文本型 @输出名 = "RuntimeGetObjectAttributeJSON" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 objectId <类型 = 文本型 @输出名 = "ObjectID">
    参数 最大属性数 <类型 = 整数 @默认值 = 40 @输出名 = "MaxAttributeNum">
    {
        如果 (objectId == "")
        {
            返回 ("[]")
        }
        变量 gpParams <类型 = YYJSON对象类>
        gpParams.创建自文本 ("{}")
        gpParams.加入文本成员 ("objectId", objectId)
        gpParams.加入逻辑值成员 ("ownProperties", 真)
        gpParams.加入逻辑值成员 ("generatePreview", 真)
        变量 raw <类型 = 文本型>
        raw = 执行CDP并同步等待 (命令ID + "_gp", "Runtime.getProperties", gpParams.到可读文本 (YYJSON格式化选项.压缩), 8000)
        如果 (CDP同步结果是否成功 (raw) == 假)
        {
            返回 ("[]")
        }
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (raw) == 假)
        {
            返回 ("[]")
        }
        变量 cdpText <类型 = 文本型>
        cdpText = yyjson取文本 (包装, "result")
        变量 cdp <类型 = YYJSON只读对象类>
        如果 (cdpText == "" || cdp.创建自文本 (cdpText) == 假)
        {
            返回 ("[]")
        }
        变量 props <类型 = YYJSON只读数组类>
        props = cdp.取数组 ("result")
        如果 (props.是否为空对象 () || props.取成员数 () == 0)
        {
            返回 ("[]")
        }
        变量 上限 <类型 = 整数>
        上限 = (整数)props.取成员数 ()
        如果 (上限 > 最大属性数)
        {
            上限 = 最大属性数
        }
        变量 out <类型 = 文本型>
        out = "["
        计次循环 (上限)
        {
            如果 (取循环索引 () > 0)
            {
                out = out + ","
            }
            变量 pi <类型 = YYJSON只读对象类>
            pi = props.取成员 (取循环索引 ())
            变量 pval <类型 = YYJSON只读对象类>
            pval = pi.取对象 ("value")
            out = out + "{\"name\":\"" + MCP_响应构建.JSON转义文本 (yyjson取文本 (pi, "name")) + "\",\"value\":" + RemoteObject摘要JSON (pval) + "}"
        }
        out = out + "]"
        返回 (out)
    }

    方法 取Debugger表达式Raw文本 <公开 静态 类型 = 文本型 @输出名 = "GetDebuggerExpressionRawText" @强制输出 = 真>
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 raw <类型 = 文本型>
        raw = yyjson取文本 (参数JSON, "expressions")
        如果 (raw == "")
        {
            变量 jsonArr <类型 = 文本型>
            jsonArr = yyjson取JSON文本 (参数JSON, "expressions")
            如果 (是否以 (jsonArr, "["))
            {
                raw = jsonArr
            }
        }
        如果 (raw == "")
        {
            raw = yyjson取文本 (参数JSON, "expression")
        }
        如果 (raw == "")
        {
            变量 jsonOne <类型 = 文本型>
            jsonOne = yyjson取JSON文本 (参数JSON, "expression")
            如果 (jsonOne != "" && 是否以 (jsonOne, "{"))
            {
                // 忽略误读的整段 params 对象
            }
            否则 (jsonOne != "")
            {
                raw = jsonOne
            }
        }
        返回 (raw)
    }

    方法 取DebuggerFlow应Resume <公开 静态 类型 = 逻辑型 @输出名 = "GetDebuggerFlowShouldResume" @强制输出 = 真>
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        // 修复: 原实现先用 yyjson取逻辑(缺键返回假) 判真假, 再回退取文本/取JSON文本,
        // 导致**未传 resume 时返回假** —— 与 schema 声明的默认 true 相反
        // (用户不传 resume, 本应求值后自动继续, 实际却停在断点)。
        // 统一走 yyjson取逻辑_默认: 布尔/数值/文本三种表示都能正确识别, 缺键回默认真。
        返回 (yyjson取逻辑_默认 (参数JSON, "resume", 真))
    }

    方法 确保Debugger已恢复 <公开 静态 @输出名 = "EnsureDebuggerRestored" @强制输出 = 真>
    参数 命令ID前缀 <类型 = 文本型 @输出名 = "CommandIDPrefix">
    {
        // 快速检查: 无缓存暂停事件时跳过resume, 省去6s无意义CDP超时
        变量 暂停缓存 <类型 = 文本型>
        暂停缓存 = 取CDP事件数据JSON ("Debugger.paused")
        如果 (暂停缓存 != "")
        {
            执行CDP并同步等待 (命令ID前缀 + "_rs0", "Debugger.resume", "{}", 3000)
        }
        执行CDP并同步等待 (命令ID前缀 + "_dis", "Debugger.disable", "{}", 5000)
        清除CDP事件记录 ("Debugger.paused")
    }

    方法 清除CDP事件记录 <公开 静态 @输出名 = "ClearDelCDPEventRecord" @强制输出 = 真>
    参数 事件名 <类型 = 文本型 @输出名 = "EventName">
    {
        如果 (事件名 == "")
        {
            返回
        }
        如果 (缓存数据库可用 ())
        {
            异步缓存锁.加锁 ()
            变量 stmt <类型 = SQLite记录集类>
            stmt = 缓存数据库.取记录集 ("DELETE FROM event_log WHERE log_type=? AND event_name=?", )
            stmt.置文本参数数据 (1, "cdp_event")
            stmt.置文本参数数据 (2, 事件名)
            stmt.执行语句 ()
            stmt.释放 ()
            异步缓存锁.解锁 ()
        }
        删除异步结果 ("cdp_event:" + 事件名)
    }

    方法 执行CDP并同步等待 <公开 静态 类型 = 文本型 @输出名 = "ExecuteCDPAndSyncWait" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 cdpMethod <类型 = 文本型 @输出名 = "CDPMethod">
    参数 paramsJSON文本 <类型 = 文本型 @输出名 = "ParamsJSONText">
    参数 最大毫秒 <类型 = 整数 @默认值 = 20000 @输出名 = "MaxMs">
    {
        如果 (paramsJSON文本 == "")
        {
            paramsJSON文本 = "{}"
        }
        // ★ 派发阶段若已失败, 就**根本没有异步任务可等** —— 继续 同步等待异步任务 只会白等到超时。
        //   实测(第 72 轮): 目标是第二个浏览器时, execute_js 白等 30 秒、get_text 白等 10 秒, 而且
        //   与调用方传的 max_ms **无关**(此处用的是调用点写死的预算), 用户完全看不出为什么慢。
        //   判据: 失败回执形如 {"success":false,...}; 成功提回执形如 {"_async":true,"task_id":...}。
        //   空串(异常情况)仍按原逻辑等待, 以免改动既有行为。
        变量 提交回执 <类型 = 文本型>
        提交回执 = 执行CDP命令_带参数 (命令ID, cdpMethod, paramsJSON文本)
        如果 (提交回执 != "" && 寻找文本 (提交回执, "\"success\":false", 0, 假) != -1)
        {
            返回 (提交回执)
        }
        变量 结果 <类型 = 文本型>
        结果 = 同步等待异步任务 (命令ID, 最大毫秒)
        // ── v2.8.3 核心: 隐式前置自动补齐 ──
        // "agent is not enabled"(如 Runtime.compileScript / Runtime.queryObjects / Debugger.* 需要
        // 先启用对应域)属于**隐式前置**: 报错原文里看不出该调什么命令, 用户和 AI 代理只能反复换方法试错。
        // 这里反应式地补一次 enable 并重试本命令, 成功则把补过的域交给响应构建器**如实上报**
        // (auto_prepared 字段), 做到"零前置但不静默改状态"。
        // 反应式而非预先启用: 未报此错时完全不改变任何既有行为。
        如果 (CDP同步结果是否成功 (结果) == 假)
        {
            变量 cdp错误 <类型 = 文本型>
            cdp错误 = 取CDP同步结果错误 (结果)
            如果 (寻找文本 (cdp错误, "agent is not enabled", 0, 假) != -1)
            {
                变量 cdp域 <类型 = 文本型>
                cdp域 = ""
                变量 cdp点 <类型 = 整数>
                cdp点 = 寻找文本 (cdpMethod, ".", 0, 假)
                如果 (cdp点 > 0)
                {
                    cdp域 = 取文本左边 (cdpMethod, cdp点)
                }
                如果 (cdp域 != "" && cdpMethod != cdp域 + ".enable")
                {
                    执行CDP命令_带参数 (命令ID + "_den", cdp域 + ".enable", "{}")
                    变量 域启用结果 <类型 = 文本型>
                    域启用结果 = 同步等待异步任务 (命令ID + "_den", 8000)
                    如果 (CDP同步结果是否成功 (域启用结果))
                    {
                        执行CDP命令_带参数 (命令ID + "_rt", cdpMethod, paramsJSON文本)
                        变量 重试结果 <类型 = 文本型>
                        重试结果 = 同步等待异步任务 (命令ID + "_rt", 最大毫秒)
                        如果 (CDP同步结果是否成功 (重试结果))
                        {
                            MCP_响应构建.记录自动补域 (cdp域)
                            返回 (重试结果)
                        }
                        // 补了域仍失败: 返回重试结果(信息量比原始错误更大)
                        返回 (重试结果)
                    }
                }
            }
            否则 (cdp错误 == "timeout")
            {
                // ── 卡死自救: 页面停在断点上而无人 resume, 会让**之后每一个**工具都超时 ──
                // 这是"明明没做错却连续失败、只能反复换方法试"的头号成因(实测: 一次断点命中未恢复后,
                // execute_js / debugger_enable / 连 browser_status 都开始超时)。
                // 判据: CDP 等待超时 **且** 存在未处理的 Debugger.paused 事件 → 自动 resume 并重试一次,
                // 并经 auto_prepared 如实上报; 用户不需要知道"要先调 browser_debugger_resume"。
                如果 (取CDP事件数据JSON ("Debugger.paused") != "")
                {
                    执行CDP命令_带参数 (命令ID + "_rsq", "Debugger.resume", "{}")
                    同步等待异步任务 (命令ID + "_rsq", 5000)
                    清除CDP事件记录 ("Debugger.paused")
                    执行CDP命令_带参数 (命令ID + "_rt2", cdpMethod, paramsJSON文本)
                    变量 解卡结果 <类型 = 文本型>
                    解卡结果 = 同步等待异步任务 (命令ID + "_rt2", 最大毫秒)
                    如果 (CDP同步结果是否成功 (解卡结果))
                    {
                        MCP_响应构建.记录自动处理 ("Debugger.resume(页面原卡在断点, 已自动恢复并重试成功)")
                        返回 (解卡结果)
                    }
                    返回 (解卡结果)
                }
            }
        }
        返回 (结果)
    }

    方法 CDP同步结果是否成功 <公开 静态 类型 = 逻辑型 @输出名 = "CDPSyncResultIsSuccess" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        如果 (存储JSON == "")
        {
            返回 (假)
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (存储JSON) == 假)
        {
            返回 (假)
        }
        返回 (解析.取逻辑值 ("success"))
    }

    方法 取CDP同步结果错误 <公开 静态 类型 = 文本型 @输出名 = "GetCDPSyncResultError" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        如果 (存储JSON == "")
        {
            返回 ("timeout")
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (存储JSON) == 假)
        {
            返回 ("invalid_cdp_result")
        }
        变量 err <类型 = 文本型>
        err = yyjson取文本 (解析, "error")
        如果 (err == "")
        {
            err = yyjson取文本 (解析, "result")
        }
        如果 (err == "")
        {
            err = yyjson取文本 (解析, "message")
        }
        如果 (err == "")
        {
            err = "cdp_failed"
        }
        如果 (err != "" && 是否以 (err, "{"))
        {
            变量 errObj <类型 = YYJSON只读对象类>
            如果 (errObj.创建自文本 (err))
            {
                变量 msg <类型 = 文本型>
                msg = yyjson取文本 (errObj, "message")
                如果 (msg != "")
                {
                    err = msg
                }
            }
        }
        返回 (err)
    }

    # ======== CDP Runtime.evaluate 内联执行 (替换 CEF JS回调链) ==========

    # ==== 用 CDP 派发鼠标事件(不破坏 CDP 通道) ====
    # 根因(实测): 内核级鼠标注入(高级鼠标_* → 高级_发送鼠标事件)会让 **CDP 通道整体失效** ——
    #   browser_mouse_move 之后 browser_dom_query 从 0.0s 变 10.3s 且返回 null,
    #   注销重注册监管者/重新导航/等待 四种恢复手段全部无效, 只能重启进程。
    #   打击面: browser_mouse_move / browser_mouse_click / browser_mouse_wheel 全部命中;
    #   对照: 纯读工具与该函数本身都不受影响。
    # 而用 CDP 的 Input.dispatchMouseEvent 派发**同样不会**让通道失效(已实测),
    #   虽然它不是内核注入, 但仍是经浏览器输入管线派发的真实输入事件。
    # 故鼠标三件套改为"CDP 派发优先, 内核注入作为显式 opt-in(kernel:true)"。

    方法 CDP派发鼠标事件 <公开 静态 类型 = 逻辑型 注释 = "用 CDP Input.dispatchMouseEvent 派发鼠标事件; 成功返回真。实测该方式不会破坏 CDP 通道" @输出名 = "CDPDispatchMouseEvent" @强制输出 = 真>
    参数 事件类型 <类型 = 文本型 @默认值 = "mouseMoved" @输出名 = "EventType">
    参数 横坐标 <类型 = 整数 @输出名 = "X">
    参数 纵坐标 <类型 = 整数 @输出名 = "Y">
    参数 按键 <类型 = 文本型 @默认值 = "left" @输出名 = "Button">
    参数 增量X <类型 = 整数 @默认值 = 0 @输出名 = "DeltaX">
    参数 增量Y <类型 = 整数 @默认值 = 0 @输出名 = "DeltaY">
    {
        变量 参 <类型 = YYJSON对象类>
        参.创建自文本 ("{}")
        参.加入文本成员 ("type", 事件类型)
        参.加入整数成员 ("x", 横坐标)
        参.加入整数成员 ("y", 纵坐标)
        如果 (事件类型 == "mouseWheel")
        {
            参.加入整数成员 ("deltaX", 增量X)
            参.加入整数成员 ("deltaY", 增量Y)
        }
        否则 (事件类型 == "mousePressed" || 事件类型 == "mouseReleased")
        {
            变量 按钮名 <类型 = 文本型>
            按钮名 = 按键
            如果 (按钮名 == "")
            {
                按钮名 = "left"
            }
            参.加入文本成员 ("button", 按钮名)
            参.加入整数成员 ("clickCount", 1)
        }
        否则
        {
            // mouseMoved: buttons=0 表示无按键按下
            参.加入整数成员 ("buttons", 0)
        }
        变量 临时ID <类型 = 文本型>
        临时ID = "_inp_" + 到文本 (取启动时间 ()) + "_" + 到文本 (取随机数 (1000, 9999))
        变量 原始结果 <类型 = 文本型>
        原始结果 = 执行CDP并同步等待 (临时ID, "Input.dispatchMouseEvent", 参.到可读文本 (YYJSON格式化选项.压缩), 8000)
        如果 (原始结果 == "")
        {
            返回 (假)
        }
        变量 解析 <类型 = YYJSON只读对象类>
        如果 (解析.创建自文本 (原始结果) == 假)
        {
            返回 (假)
        }
        返回 (解析.取逻辑值 ("success"))
    }

    # ==== CDP 触摸派发 (与鼠标同源: 走浏览器输入管线, 不经内核注入) ====
    # 为什么必须存在(真机实测): 触摸三件套原先只走 VIP 内核注入 高级触摸_*,
    #   而内核级输入注入实测会让 CDP 通道在**本会话内永久失效**(此后每个 CDP 优先工具都白等超时,
    #   连 browser_status 都会挂, 只能重启进程)。CDP 的 Input.dispatchTouchEvent 是经浏览器
    #   输入管线派发的真实触摸事件, 不破坏通道, 故触摸与鼠标一样改为"CDP 派发优先"。

    方法 CDP派发触摸点一次 <静态 类型 = 逻辑型 注释 = "单次 CDP Input.dispatchTouchEvent 原语(不含前置与状态处理), 供 CDP派发触摸事件 复用" @输出名 = "CDPDispatchTouchPointOnce" @强制输出 = 真>
    参数 触摸类型 <类型 = 文本型 @输出名 = "TouchType">
    参数 横坐标 <类型 = 整数 @输出名 = "X">
    参数 纵坐标 <类型 = 整数 @输出名 = "Y">
    {
        // touchPoints 是"数组套对象"的嵌套结构, 而本项目实测 YYJSON对象类.加入数组成员/加入成员
        // 嵌套多层会触发 0xC0000005(工具列表构建处 L6 的结论), 故按项目既定做法纯文本拼接构造参数。
        变量 参文本 <类型 = 文本型>
        如果 (触摸类型 == "touchEnd" || 触摸类型 == "touchCancel")
        {
            // 协议要求: 释放类事件的 touchPoints 必须为空, 由浏览器释放已存点; 带点会被 CDP 拒绝
            参文本 = "{\"type\":\"" + 触摸类型 + "\",\"touchPoints\":[]}"
        }
        否则
        {
            参文本 = "{\"type\":\"" + 触摸类型 + "\",\"touchPoints\":[{\"x\":" + 到文本 (横坐标) + ",\"y\":" + 到文本 (纵坐标) + ",\"radiusX\":1,\"radiusY\":1,\"force\":1,\"id\":0}]}"
        }
        变量 临时ID <类型 = 文本型>
        临时ID = "_tch_" + 到文本 (取启动时间 ()) + "_" + 到文本 (取随机数 (1000, 9999))
        变量 原始结果 <类型 = 文本型>
        原始结果 = 执行CDP并同步等待 (临时ID, "Input.dispatchTouchEvent", 参文本, 8000)
        返回 (CDP同步结果是否成功 (原始结果))
    }

    方法 CDP派发触摸事件 <公开 静态 类型 = 逻辑型 注释 = "用 CDP Input.dispatchTouchEvent 派发触摸/拖动; 成功返回真。自动开启触摸仿真、自动维护按下态(零前置)。实测该方式不会破坏 CDP 通道(内核级触摸注入会)" @输出名 = "CDPDispatchTouchEvent" @强制输出 = 真>
    参数 触摸类型 <类型 = 文本型 @默认值 = "touchStart" @输出名 = "TouchType">
    参数 横坐标 <类型 = 整数 @输出名 = "X">
    参数 纵坐标 <类型 = 整数 @输出名 = "Y">
    {
        变量 实际类型 <类型 = 文本型>
        实际类型 = 触摸类型
        如果 (实际类型 != "touchStart" && 实际类型 != "touchMove" && 实际类型 != "touchEnd" && 实际类型 != "touchCancel")
        {
            返回 (假)
        }
        // 零前置①: 触摸仿真未开启时 Input.dispatchTouchEvent 会被 CDP 直接拒绝
        // ("Touch events are not enabled") —— 这正是以前必须先手工调 browser_fingerprint_touch_enable
        // 的原因, 也是"要试很多次才成功"的隐式前置之一。该命令幂等且廉价, 故每次调用都确保一遍。
        变量 仿真参 <类型 = YYJSON对象类>
        仿真参.创建自文本 ("{}")
        仿真参.加入逻辑值成员 ("enabled", 真)
        仿真参.加入整数成员 ("maxTouchPoints", 5)
        变量 仿真结果 <类型 = 文本型>
        仿真结果 = 执行CDP并同步等待 ("_tch_emu", "Emulation.setTouchEmulationEnabled", 仿真参.到可读文本 (YYJSON格式化选项.压缩), 8000)
        如果 (CDP同步结果是否成功 (仿真结果) == 假)
        {
            返回 (假)
        }
        MCP_响应构建.记录自动处理 ("Emulation.setTouchEmulationEnabled(触摸派发的隐式前置; 此前需手工调 fingerprint touch_enable)")
        // 零前置②: 没有按下点时 touchMove 会被浏览器静默丢弃(不报错, 只是毫无反应)。
        // "直接拖拽而未先按下"是最常见的调用方式, 故自动补一次 touchStart, 并经 auto_prepared 如实上报。
        如果 (实际类型 == "touchMove" && 触摸点已按下 == 假)
        {
            // 补按下的**锚点**决定这次拖动是否真实:
            //   · 有历史坐标 -> 从上次位置补按下, 这才是一次真正的拖动;
            //   · 无历史坐标 -> 只能从目标坐标补按下, 起点==终点, 浏览器不会产生 touchmove。
            //     这种情况必须如实告知调用方(否则就是"静默假成功"), 故分开上报两种情形。
            变量 锚点X <类型 = 整数>
            变量 锚点Y <类型 = 整数>
            如果 (触摸点X >= 0 && 触摸点Y >= 0)
            {
                锚点X = 触摸点X
                锚点Y = 触摸点Y
            }
            否则
            {
                锚点X = 横坐标
                锚点Y = 纵坐标
            }
            如果 (CDP派发触摸点一次 ("touchStart", 锚点X, 锚点Y) == 假)
            {
                返回 (假)
            }
            触摸点已按下 = 真
            触摸点X = 锚点X
            触摸点Y = 锚点Y
            如果 (锚点X == 横坐标 && 锚点Y == 纵坐标)
            {
                MCP_响应构建.记录自动处理 ("touchStart(自动补按下; 但尚无历史坐标, 起点与终点相同 —— 浏览器不会产生 touchmove。要真实拖动请先 browser_touch_press 指定起点)")
            }
            否则
            {
                MCP_响应构建.记录自动处理 ("touchStart(无按下点, 已自动从上次坐标 " + 到文本 (锚点X) + "," + 到文本 (锚点Y) + " 补按下)")
            }
        }
        如果 (CDP派发触摸点一次 (实际类型, 横坐标, 纵坐标) == 假)
        {
            返回 (假)
        }
        // 按下态必须与浏览器真实状态一致, 否则后续 touchMove 会被静默忽略。集中在唯一出口更新。
        如果 (实际类型 == "touchStart")
        {
            触摸点已按下 = 真
            触摸点X = 横坐标
            触摸点Y = 纵坐标
        }
        否则 (实际类型 == "touchMove")
        {
            触摸点X = 横坐标
            触摸点Y = 纵坐标
        }
        否则
        {
            触摸点已按下 = 假
        }
        返回 (真)
    }

    # ==== 原生同步 JS 执行(CDP 不可用时的回退目标) ====
    # 为什么需要它(真机实测):
    #   CDP 通道并非总是可用 —— 已确认 browser_vip_enable_js_env {enable:true} 会**破坏 CDP**,
    #   且重新注册监管者也无法恢复; 全新实例上首次 CDP 调用也可能失败。
    #   而"CDP 优先"的读取工具此前的回退目标是原生 `取元素内容/取元素属性` 这条
    #   经 CEF JS 回调取值的老路 —— 它在本内核下**恒返回空值并被写成字面 null**,
    #   也就是又回到了"静默给出错误答案"。实测 scrape 在 CDP 失效时就返回了 text:"null"。
    #   本方法走 `执行JS代码_带返回值`(即 browser_execute_js 用的那条), 实测在 CDP 失效时**仍然可用**,
    #   因此把它作为回退目标, 比回退到老路正确得多。

    方法 原生执行JS并等待 <公开 静态 类型 = 文本型 注释 = "原生同步路径执行JS并取回结果(执行JS代码_带返回值 + 同步轮询); 用作 CDP 不可用时的回退目标" @输出名 = "NativeExecJSAndWait" @强制输出 = 真>
    参数 JS代码 <类型 = 文本型 @输出名 = "JSCode">
    参数 最大等待毫秒 <类型 = 整数 @默认值 = 10000 @输出名 = "MaxWaitMs">
    {
        变量 browser <类型 = 类_FBrowser_浏览器>
        browser = 取主浏览器 ()
        如果 (browser.是否为空 ())
        {
            返回 ("")
        }
        变量 执行框架 <类型 = 类_FBrowser_框架>
        执行框架 = 取安全主框架 (browser)
        如果 (执行框架.是否为空 () || 执行框架.是否有效 () == 假)
        {
            返回 ("")
        }
        变量 原生ID <类型 = 文本型>
        原生ID = 生成异步任务ID ()
        // 预占位: 即使 CEF 回调丢失, 任务也不会"消失", 轮询能看到 _waiting 并在超时后退出
        变量 预占位 <类型 = YYJSON对象类>
        预占位.创建自文本 ("{}")
        预占位.加入逻辑值成员 ("_waiting", 真)
        预占位.加入文本成员 ("what", "native_exec")
        预占位.加入长整数成员 ("start_time", 取启动时间 ())
        存储异步结果 (原生ID, 预占位.到可读文本 (YYJSON格式化选项.压缩), browser.取ID ())
        变量 JS回调 <类型 = 类_FBrowser_事件智能指针>
        JS回调.创建 (类_MCP_JS异步回调)
        JS回调.取执行类 (类_MCP_JS异步回调).任务ID = 原生ID
        执行框架.执行JS代码_带返回值 (JS代码, "", 0, JS回调)
        变量 存储结果 <类型 = 文本型>
        存储结果 = 等待异步任务完成 (原生ID, 最大等待毫秒, "_nativejs", "native_exec_js")
        如果 (存储结果 == "")
        {
            返回 ("")
        }
        变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (存储结果) == 假)
        {
            返回 ("")
        }
        如果 (结果解析.取逻辑值 ("success") == 假)
        {
            返回 ("")
        }
        返回 (yyjson取文本 (结果解析, "message"))
    }

    方法 CDP执行JS并等待 <公开 静态 类型 = 文本型 注释 = "通过CDP Runtime.evaluate执行JS并sync-wait取回结果, 绕过不稳定的CEF JS回调; CDP不可用时回退原生同步JS" @输出名 = "CDPExecuteJSAndWait" @强制输出 = 真>
    参数 JS代码 <类型 = 文本型 @输出名 = "JSCode">
    参数 最大等待毫秒 <类型 = 整数 @默认值 = 15000 @输出名 = "MaxWaitMs">
    参数 返回ByValue <类型 = 逻辑型 @默认值 = 真 @输出名 = "ReturnByValue">
    {
        变量 临时命令ID <类型 = 文本型>
        临时命令ID = "_rtev_" + 到文本 (取启动时间 ()) + "_" + 到文本 (取随机数 (1000, 9999))
        变量 evalParams <类型 = YYJSON对象类>
        evalParams.创建自文本 ("{}")
        evalParams.加入文本成员 ("expression", JS代码)
        evalParams.加入逻辑值成员 ("returnByValue", 返回ByValue)
        evalParams.加入逻辑值成员 ("awaitPromise", 假)
        evalParams.加入逻辑值成员 ("includeCommandLineAPI", 假)
        变量 存储结果 <类型 = 文本型>
        存储结果 = 执行CDP并同步等待 (临时命令ID, "Runtime.evaluate", evalParams.到可读文本 (YYJSON格式化选项.压缩), 最大等待毫秒)
        如果 (存储结果 == "")
        {
            // CDP 无响应(通道不可用) -> 回退原生同步 JS, 而不是让调用方退回"恒返回 null"的老路
            返回 (原生执行JS并等待 (JS代码, 最大等待毫秒))
        }
        变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (存储结果) == 假)
        {
            返回 (原生执行JS并等待 (JS代码, 最大等待毫秒))
        }
        如果 (结果解析.取逻辑值 ("success") == 假)
        {
            变量 cdpErr <类型 = 文本型>
            cdpErr = 取CDP同步结果错误 (存储结果)
            变量 原生回退值 <类型 = 文本型>
            原生回退值 = 原生执行JS并等待 (JS代码, 最大等待毫秒)
            如果 (原生回退值 != "")
            {
                返回 (原生回退值)
            }
            返回 ("{\"error\":\"CDP执行失败:" + MCP_响应构建.JSON转义文本 (cdpErr) + "\"}")
        }
        变量 cdpResult <类型 = 文本型>
        cdpResult = yyjson取文本 (结果解析, "result")
        如果 (cdpResult == "")
        {
            返回 (原生执行JS并等待 (JS代码, 最大等待毫秒))
        }
        变量 cdpObj <类型 = YYJSON只读对象类>
        如果 (cdpObj.创建自文本 (cdpResult) == 假)
        {
            返回 (cdpResult)
        }
        // Runtime.evaluate 返回 {result: {type, value/description}, exceptionDetails: ...}
        // 注: yyjson取JSON文本 对缺失键返回非空(空节点序列化), 不能仅凭非空判断存在异常
        变量 exceptionJSON <类型 = 文本型>
        exceptionJSON = yyjson取JSON文本 (cdpObj, "exceptionDetails")
        变量 excObj <类型 = YYJSON只读对象类>
        如果 (exceptionJSON != "" && excObj.创建自文本 (exceptionJSON))
        {
            变量 excText <类型 = 文本型>
            excText = ""
            // ★ 修(可诊断性, 实测): CDP 的 exceptionDetails.text **固定就是 "Uncaught"** ——
            //   真正的原因在 exceptionDetails.exception.description
            //   (例: "SyntaxError: Invalid or unexpected token")。
            //   原实现优先读 text, 于是**所有**走这条路径的 JS 异常都只报 "JS异常:Uncaught",
            //   完全不可行动: 实测 browser_reverse_search 就因此把真实的解析期错误掩盖成 "Uncaught"。
            变量 excInnerJSON <类型 = 文本型>
            excInnerJSON = yyjson取JSON文本 (excObj, "exception")
            变量 excInner <类型 = YYJSON只读对象类>
            如果 (excInnerJSON != "" && excInner.创建自文本 (excInnerJSON))
            {
                excText = yyjson取文本 (excInner, "description")
            }
            如果 (excText == "")
            {
                excText = yyjson取文本 (excObj, "text")
            }
            // 附上行列: 解析期错误只有行列号, 靠它才能定位到注入串里的具体位置
            变量 excLine <类型 = 整数>
            excLine = yyjson取整数 (excObj, "lineNumber")
            变量 excCol <类型 = 整数>
            excCol = yyjson取整数 (excObj, "columnNumber")
            如果 (excLine != 0 || excCol != 0)
            {
                excText = excText + " @line " + 到文本 (excLine) + " col " + 到文本 (excCol)
            }

            如果 (excText != "")
            {
                返回 ("{\"error\":\"JS异常:" + MCP_响应构建.JSON转义文本 (excText) + "\"}")
            }
            // 异常文本为空(空节点/占位): 落到结果解析继续处理
        }
        变量 resultObj <类型 = YYJSON只读对象类>
        变量 resultRaw <类型 = 文本型>
        resultRaw = yyjson取JSON文本 (cdpObj, "result")
        如果 (resultRaw != "" && resultObj.创建自文本 (resultRaw))
        {
            变量 valType <类型 = 文本型>
            valType = yyjson取文本 (resultObj, "type")
            如果 (valType == "string")
            {
                返回 (yyjson取文本 (resultObj, "value"))
            }
            否则 (valType == "undefined" || valType == "null")
            {
                // ★ 关键: CDP **传输成功但结果是 null/undefined** —— 这正是 CDP 被破坏后的表现
                // (实测 browser_vip_enable_js_env {enable:true} 之后, CDP 查询恒得 null:
                //  通道还在, 但求值落在了拿不到 DOM 的执行环境里)。
                // 此前的实现直接返回字面 "null", 调用方看到的就是"元素存在却没有文本"这种静默错误答案。
                // 现在先试原生同步 JS(实测该路径在 CDP 失效时仍可用), 拿到有效值就用它。
                变量 原生兜底值 <类型 = 文本型>
                原生兜底值 = 原生执行JS并等待 (JS代码, 最大等待毫秒)
                如果 (原生兜底值 != "" && 原生兜底值 != "null" && 原生兜底值 != "undefined")
                {
                    返回 (原生兜底值)
                }
                返回 ("null")
            }
            变量 val <类型 = 文本型>
            val = yyjson取文本 (resultObj, "value")
            如果 (val != "")
            {
                返回 (val)
            }
            变量 desc <类型 = 文本型>
            desc = yyjson取文本 (resultObj, "description")
            如果 (desc != "")
            {
                返回 (desc)
            }
            返回 (resultRaw)
        }
        返回 (cdpResult)
    }

    # ======== CDP Debugger.getScriptSource 静态下载脚本 ==========

    方法 CDP设置断点结果是否成功 <公开 静态 类型 = 逻辑型 @输出名 = "CDPSetBreakpointResultIsSuccess" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        如果 (CDP同步结果是否成功 (存储JSON))
        {
            返回 (真)
        }
        变量 errText <类型 = 文本型>
        errText = 取CDP同步结果错误 (存储JSON)
        返回 (寻找文本 (errText, "already exists", 0, 假) != -1)
    }
    方法 CDP断点是否零命中 <公开 静态 类型 = 逻辑型 @输出名 = "CDPBreakpointHasZeroLocations" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        // 为什么要单独一个 helper: Debugger.setBreakpointByUrl 在 urlRegex/行号匹配到 **0 个**
        // 脚本位置时**仍然返回成功**(带 "locations":[])。所以"断点设置成功"与"永远不可能命中"
        // 是两件事 —— browser_debugger_auto/flow 曾据此把 0 命中判成设置成功, 然后死等到超时。
        // 判据: 同步**成功** 且 结果体里 locations 是空数组。
        // 用法注意: 只有"调用方不会导航"时 0 位置才是终局失败; 若会导航, urlRegex 会在新脚本上重新解析。
        如果 (CDP同步结果是否成功 (存储JSON) == 假)
        {
            返回 (假)
        }
        变量 体文本 <类型 = 文本型>
        体文本 = 取CDP同步结果体文本 (存储JSON)
        如果 (体文本 == "")
        {
            返回 (假)
        }
        如果 (寻找文本 (体文本, "\"locations\":[]", 0, 假) != -1)
        {
            返回 (真)
        }
        返回 (寻找文本 (体文本, "\"locations\": []", 0, 假) != -1)
    }

    方法 解析Debugger求值结果 <公开 静态 类型 = 文本型 @输出名 = "ParseDebuggerEvaluateResult" @强制输出 = 真>
    参数 异步结果JSON <类型 = 文本型 @输出名 = "AsyncResultJSON">
    参数 命令ID前缀 <类型 = 文本型 @默认值 = "" @输出名 = "CommandIDPrefix">
    参数 callFrameId <类型 = 文本型 @默认值 = "" @输出名 = "CallFrameID">
    参数 expression <类型 = 文本型 @默认值 = "" @输出名 = "Expression">
    参数 展开对象 <类型 = 逻辑型 @默认值 = 假 @输出名 = "ExpandObject">
    {
        如果 (异步结果JSON == "")
        {
            返回 ("{\"ok\":false,\"error\":\"empty\"}")
        }
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (异步结果JSON) == 假)
        {
            返回 ("{\"ok\":false,\"error\":\"invalid_json\"}")
        }
        如果 (yyjson取逻辑 (包装, "success") == 假)
        {
            // ★ 修(失败原因被吞): 原来只读包装里的 "message" —— 但写入失败原因的是 处理CDP响应,
            //   它写的键是 "error"(失败) / "result"(成功), **从来没有 "message"**;
            //   于是任何真实失败都被翻译成 {"ok":false,"error":""}, 调用方看不到原因。
            变量 求值失败原因 <类型 = 文本型>
            求值失败原因 = yyjson取文本 (包装, "message")
            如果 (求值失败原因 == "")
            {
                求值失败原因 = yyjson取文本 (包装, "error")
            }
            如果 (求值失败原因 == "")
            {
                求值失败原因 = yyjson取文本 (包装, "result")
            }
            // 把"帧 ID 失效"翻译成可行动提示(帧 ID 是 CDP 的不透明句柄, 工具无法修复调用方给的旧帧,
            // 只能说明它从哪来、为什么失效 —— 这是"让失败可行动", 不是"让它成功")。
            如果 (寻找文本 (求值失败原因, "Invalid call frame id", 0, 假) != -1)
            {
                求值失败原因 = 求值失败原因 + " | call_frame_id 与当前暂停点绑定: 页面 resume 之后立即失效 —— 而 browser_debugger_flow / browser_debugger_auto 默认 resume:true, 它们返回体里的 paused.call_frame_id 在返回时通常已失效 | 取活帧: browser_debugger_wait_paused 或 browser_debugger_last_paused, 拿到后立即 evaluate; 也可以不传 call_frame_id(本工具会自动取活帧)"
            }
            如果 (求值失败原因 == "")
            {
                求值失败原因 = "cdp_failed"
            }
            返回 ("{\"ok\":false,\"error\":\"" + MCP_响应构建.JSON转义文本 (求值失败原因) + "\"}")
        }
        变量 cdpText <类型 = 文本型>
        cdpText = yyjson取文本 (包装, "result")
        如果 (cdpText == "")
        {
            返回 ("{\"ok\":false,\"error\":\"no_cdp_result\"}")
        }
        变量 cdp <类型 = YYJSON只读对象类>
        如果 (cdp.创建自文本 (cdpText) == 假)
        {
            返回 ("{\"ok\":false,\"error\":\"cdp_parse\"}")
        }
        变量 remote <类型 = YYJSON只读对象类>
        remote = yyjson取对象成员_安全 (cdp, "result")
        变量 exObj <类型 = YYJSON只读对象类>
        exObj = yyjson取对象成员_安全 (cdp, "exceptionDetails")
        如果 (remote.是否为空对象 () || remote.是否为空 ())
        {
            变量 exAlt <类型 = YYJSON只读对象类>
            exAlt = exObj.取对象 ("result")
            如果 (yyjson取文本 (exAlt, "type") != "")
            {
                remote = exAlt
            }
        }
        如果 ((remote.是否为空对象 () || remote.是否为空 ()) && exObj.是否为空对象 () == 假 && exObj.是否为空 () == 假)
        {
            变量 exMsg <类型 = 文本型>
            exMsg = yyjson取文本 (exObj, "text")
            变量 exId <类型 = 整数>
            exId = yyjson取整数 (exObj, "exceptionId")
            如果 (exMsg != "" || exId != 0)
            {
                变量 exText <类型 = 文本型>
                exText = yyjson取JSON文本 (cdp, "exceptionDetails")
                返回 ("{\"ok\":false,\"exception\":" + 选择 (exText == "", "{}", exText) + "}")
            }
        }
        如果 (remote.是否为空对象 () || remote.是否为空 ())
        {
            返回 ("{\"ok\":true,\"raw\":" + 选择 (cdpText == "", "null", cdpText) + "}")
        }
        变量 valType <类型 = 文本型>
        valType = yyjson取文本 (remote, "type")
        变量 val <类型 = 文本型>
        val = yyjson取文本 (remote, "value")
        变量 desc <类型 = 文本型>
        desc = yyjson取文本 (remote, "description")
        变量 unser <类型 = 文本型>
        unser = yyjson取文本 (remote, "unserializableValue")
        变量 objId <类型 = 文本型>
        objId = yyjson取文本 (remote, "objectId")
        变量 cls <类型 = 文本型>
        cls = yyjson取文本 (remote, "className")
        如果 (val == "" && unser != "")
        {
            val = unser
        }
        变量 valPart <类型 = 文本型>
        valPart = yyjson取JSON文本 (remote, "value")
        如果 (valPart != "" && valType == "string" && 是否以 (valPart, "\"") == 假)
        {
            valPart = "\"" + MCP_响应构建.JSON转义文本 (选择 (val != "", val, valPart)) + "\""
        }
        如果 (valPart == "")
        {
            如果 (valType == "number" || valType == "boolean")
            {
                valPart = val
                如果 (valPart == "" && desc != "")
                {
                    valPart = desc
                }
                如果 (valPart == "" && valType == "boolean")
                {
                    valPart = "false"
                }
                如果 (valPart == "" && valType == "number")
                {
                    valPart = "0"
                }
            }
            否则 (valType == "undefined")
            {
                valPart = "null"
            }
            否则
            {
                valPart = "\"" + MCP_响应构建.JSON转义文本 (val) + "\""
            }
        }
        变量 out <类型 = 文本型>
        out = "{\"ok\":true,\"type\":\"" + MCP_响应构建.JSON转义文本 (valType) + "\",\"value\":" + valPart + ",\"description\":\"" + MCP_响应构建.JSON转义文本 (desc) + "\",\"className\":\"" + MCP_响应构建.JSON转义文本 (cls) + "\",\"objectId\":\"" + MCP_响应构建.JSON转义文本 (objId) + "\""
        如果 (展开对象 && objId != "" && (valType == "object" || valType == "function"))
        {
            out = out + ",\"properties\":" + Runtime取对象属性JSON (命令ID前缀, objId, 40)
        }
        如果 (展开对象 && valType == "function" && callFrameId != "" && expression != "")
        {
            变量 srcExpr <类型 = 文本型>
            srcExpr = "(function(){try{var __v=(" + expression + ");return typeof __v==='function'?__v.toString():''}catch(e){return ''}})()"
            变量 srcRaw <类型 = 文本型>
            srcRaw = 执行Debugger帧求值并等待 (命令ID前缀 + "_fn", callFrameId, srcExpr, 6000, 真)
            变量 srcParsed <类型 = YYJSON只读对象类>
            如果 (srcParsed.创建自文本 (解析Debugger求值结果 (srcRaw, "", "", "", 假)))
            {
                变量 srcText <类型 = 文本型>
                srcText = yyjson取文本 (srcParsed, "value")
                如果 (srcText != "")
                {
                    out = out + ",\"source\":\"" + MCP_响应构建.JSON转义文本 (srcText) + "\""
                }
            }
        }
        out = out + "}"
        返回 (out)
    }

    方法 Debugger帧内批量求值JSON <公开 静态 类型 = 文本型 @输出名 = "DebuggerInFrameBatchEvaluateJSON" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 callFrameId <类型 = 文本型 @输出名 = "CallFrameID">
    参数 exprRaw <类型 = 文本型 @输出名 = "ExprRaw">
    参数 展开对象 <类型 = 逻辑型 @默认值 = 真 @输出名 = "ExpandObject">
    参数 returnByValue <类型 = 逻辑型 @默认值 = 真 @输出名 = "ReturnByValue">
    {
        变量 evalOut <类型 = 文本型>
        evalOut = "["
        变量 evalCount <类型 = 整数 值 = 0>
        变量 effectiveRbV <类型 = 逻辑型>
        effectiveRbV = returnByValue
        如果 (展开对象)
        {
            effectiveRbV = 假
        }
        如果 (callFrameId == "" || exprRaw == "")
        {
            返回 ("[]")
        }
        如果 (是否以 (exprRaw, "["))
        {
            变量 exprArr <类型 = YYJSON只读数组类>
            exprArr = 取JSON数组自文本 (exprRaw, "expressions")
            如果 (exprArr.取成员数 () > 0)
            {
                计次循环 ((整数)exprArr.取成员数 ())
                {
                    变量 oneExpr <类型 = 文本型>
                    oneExpr = exprArr.取文本 (取循环索引 ())
                    如果 (oneExpr == "")
                    {
                        到循环尾
                    }
                    如果 (evalCount > 0)
                    {
                        evalOut = evalOut + ","
                    }
                    变量 evRaw <类型 = 文本型>
                    evRaw = 执行Debugger帧求值并等待 (命令ID + "_ev" + 到文本 (evalCount), callFrameId, oneExpr, 8000, effectiveRbV)
                    evalOut = evalOut + "{\"expression\":\"" + MCP_响应构建.JSON转义文本 (oneExpr) + "\",\"eval\":" + 解析Debugger求值结果 (evRaw, 命令ID + "_ev" + 到文本 (evalCount), callFrameId, oneExpr, 展开对象) + "}"
                    evalCount = evalCount + 1
                }
            }
        }
        否则
        {
            变量 evRaw2 <类型 = 文本型>
            evRaw2 = 执行Debugger帧求值并等待 (命令ID + "_ev0", callFrameId, exprRaw, 8000, effectiveRbV)
            evalOut = evalOut + "{\"expression\":\"" + MCP_响应构建.JSON转义文本 (exprRaw) + "\",\"eval\":" + 解析Debugger求值结果 (evRaw2, 命令ID + "_ev0", callFrameId, exprRaw, 展开对象) + "}"
            evalCount = 1
        }
        evalOut = evalOut + "]"
        返回 (evalOut)
    }

    方法 执行Debugger断点流程JSON <公开 静态 类型 = 文本型 @输出名 = "ExecuteDebuggerBreakpointWorkflowJSON" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 bpRegex <类型 = 文本型>
        bpRegex = yyjson取文本 (参数JSON, "breakpoint")
        如果 (bpRegex == "")
        {
            bpRegex = yyjson取文本 (参数JSON, "url_regex")
        }
        如果 (bpRegex == "")
        {
            bpRegex = "example\\.com"
        }
        变量 navUrl <类型 = 文本型>
        navUrl = yyjson取文本 (参数JSON, "url")
        变量 maxMs <类型 = 整数>
        maxMs = yyjson取整数 (参数JSON, "max_ms")
        如果 (maxMs == 0)
        {
            // 原默认 45000ms 远超常见客户端耐心(台账实测客户端 15s 就放弃), 结果是
            // "客户端先超时 + 服务端还在等" —— 调用方只看到 timed out, 看不到任何原因。
            // 压到 12000ms(与 browser_debugger_auto 的同类决定一致): 让服务端在客户端放弃之前
            // 给出明确结论。需要更久请显式传 max_ms。
            maxMs = 12000
        }
        变量 应Resume <类型 = 逻辑型>
        应Resume = 取DebuggerFlow应Resume (参数JSON)
        // 若上次断点未 resume || tool_test 遗留 paused,先恢复再 enable
        确保Debugger已恢复 (命令ID + "_pre")
        变量 enRaw <类型 = 文本型>
        enRaw = 执行CDP并同步等待 (命令ID + "_en", "Debugger.enable", "{}", 20000)
        如果 (CDP同步结果是否成功 (enRaw) == 假)
        {
            // 浏览器可能已崩溃: 先检查后再重试, 避免无谓的20秒等待
            变量 flowBrowser <类型 = 类_FBrowser_浏览器>
            flowBrowser = 取主浏览器 ()
            如果 (flowBrowser.是否为空 () || flowBrowser.是否已关闭 ())
            {
                返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"enable\",\"error\":\"browser_closed\"}"))
            }
            确保Debugger已恢复 (命令ID + "_retry")
            enRaw = 执行CDP并同步等待 (命令ID + "_en2", "Debugger.enable", "{}", 20000)
        }
        如果 (CDP同步结果是否成功 (enRaw) == 假)
        {
            返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"enable\",\"error\":\"" + MCP_响应构建.JSON转义文本 (取CDP同步结果错误 (enRaw)) + "\"}"))
        }
        MCP可中断延时 (200)
        变量 bpParams <类型 = YYJSON对象类>
        bpParams.创建自文本 ("{}")
        bpParams.加入文本成员 ("urlRegex", bpRegex)
        变量 flowLine <类型 = 整数>
        flowLine = yyjson取整数 (参数JSON, "line")
        如果 (flowLine == 0)
        {
            flowLine = yyjson取整数 (参数JSON, "line_number")
        }
        bpParams.加入整数成员 ("lineNumber", flowLine)
        变量 flowCol <类型 = 整数>
        flowCol = yyjson取整数 (参数JSON, "column")
        如果 (flowCol == 0)
        {
            flowCol = yyjson取整数 (参数JSON, "column_number")
        }
        变量 flowHasCol <类型 = 逻辑型 值 = 假>
        如果 (yyjson取文本 (参数JSON, "column") != "" || yyjson取文本 (参数JSON, "column_number") != "")
        {
            flowHasCol = 真
        }
        如果 (flowHasCol)
        {
            bpParams.加入整数成员 ("columnNumber", flowCol)
        }
        变量 bpRaw <类型 = 文本型>
        bpRaw = 执行CDP并同步等待 (命令ID + "_bp", "Debugger.setBreakpointByUrl", bpParams.到可读文本 (YYJSON格式化选项.压缩), 20000)
        如果 (CDP设置断点结果是否成功 (bpRaw) == 假)
        {
            返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"set_breakpoint\",\"error\":\"" + MCP_响应构建.JSON转义文本 (取CDP同步结果错误 (bpRaw)) + "\",\"breakpoint\":\"" + MCP_响应构建.JSON转义文本 (bpRegex) + "\"}"))
        }
        // 须在 navigate 之前清除,否则加载时命中断点的事件会被误删
        清除CDP事件记录 ("Debugger.paused")
        如果 (navUrl != "")
        {
            如果 (验证URL安全 (navUrl) == 假)
            {
                返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"navigate\",\"error\":\"unsafe_url\"}"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = 取主浏览器 ()
            如果 (browser.是否为空 ())
            {
                返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"navigate\",\"error\":\"no_browser\"}"))
            }
            变量 navFrame <类型 = 类_FBrowser_框架>
            navFrame = 取安全主框架 (browser)
            如果 (navFrame.是否为空 () || navFrame.是否有效 () == 假)
            {
                返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"navigate\",\"error\":\"no_frame\"}"))
            }
            navFrame.载入地址 (navUrl)
            MCP可中断延时 (800)
        }
        变量 pausedRaw <类型 = 文本型>
        pausedRaw = 等待CDP事件 ("Debugger.paused", maxMs, 假)
        如果 (pausedRaw == "")
        {
                        // 保留 step/error 两个既有键值不动(分派层按键值前缀分类), 只**追加**原因与可行动提示。
            变量 flow等待说明 <类型 = 文本型>
            flow等待说明 = "等待 Debugger.paused 超时(" + 到文本 (maxMs) + "ms)"
            如果 (navUrl == "")
            {
                flow等待说明 = flow等待说明 + " | 未传 url: 本工具不会导航, 只有当前页面自己执行到断点位置才可能命中"
            }
            否则
            {
                flow等待说明 = flow等待说明 + " | 已导航到 " + navUrl + ", 但该窗口内脚本未执行到断点位置"
            }
            返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"wait_paused\",\"error\":\"timeout\",\"breakpoint\":\"" + MCP_响应构建.JSON转义文本 (bpRegex) + "\",\"waited_ms\":" + 到文本 (maxMs) + ",\"reason\":\"" + MCP_响应构建.JSON转义文本 (flow等待说明) + "\",\"hint\":\"可行动: ①用 browser_reverse_get_possible_breakpoints 确认该脚本真正可下断的行列(混淆脚本常整包压成一行, 按行下断必然 0 位置) ②确认 url_regex 能匹配到目标脚本 ③需要更久请显式传 max_ms\"}"))
        }
        变量 pausedSummary <类型 = 文本型>
        pausedSummary = 解析Debugger暂停摘要 (pausedRaw)
        变量 pausedObj <类型 = YYJSON只读对象类>
        变量 frameId <类型 = 文本型>
        frameId = ""
        如果 (pausedObj.创建自文本 (pausedSummary))
        {
            frameId = yyjson取文本 (pausedObj, "call_frame_id")
        }
        如果 (frameId == "")
        {
            frameId = 提取JSON文本字段值 (pausedSummary, "call_frame_id")
        }
        变量 exprRaw <类型 = 文本型>
        exprRaw = 取Debugger表达式Raw文本 (参数JSON)
        如果 (exprRaw == "")
        {
            exprRaw = "[\"location.href\",\"document.title\",\"typeof window\",\"window.__mcp_dbg\"]"
        }
        变量 flowExpand <类型 = 逻辑型>
        flowExpand = 取Debugger求值展开 (参数JSON)
        变量 flowRbV <类型 = 逻辑型>
        flowRbV = 取Debugger求值ReturnByValue (参数JSON)
        变量 evalOut <类型 = 文本型>
        evalOut = Debugger帧内批量求值JSON (命令ID, frameId, exprRaw, flowExpand, flowRbV)
        变量 resumed <类型 = 逻辑型 值 = 假>
        如果 (应Resume)
        {
            resumed = DebuggerFlow尝试Resume (命令ID + "_done")
        }
        如果 (resumed == 假 && 应Resume)
        {
            返回 (DebuggerFlow失败返回 (命令ID, "{\"ok\":false,\"step\":\"resume\",\"error\":\"resume_failed\",\"breakpoint\":\"" + MCP_响应构建.JSON转义文本 (bpRegex) + "\",\"paused\":" + pausedSummary + ",\"evaluations\":" + evalOut + "}"))
        }
        返回 ("{\"ok\":true,\"breakpoint\":\"" + MCP_响应构建.JSON转义文本 (bpRegex) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (navUrl) + "\",\"paused\":" + pausedSummary + ",\"evaluations\":" + evalOut + ",\"resumed\":" + 选择 (resumed, "true", "false") + "}")
    }

    方法 取CDP同步结果体文本 <公开 静态 类型 = 文本型 @输出名 = "GetCDPSyncResultBodyText" @强制输出 = 真>
    参数 存储JSON <类型 = 文本型 @输出名 = "StoreJSON">
    {
        如果 (存储JSON == "")
        {
            返回 ("")
        }
        变量 包装 <类型 = YYJSON只读对象类>
        如果 (包装.创建自文本 (存储JSON) == 假)
        {
            返回 ("")
        }
        返回 (yyjson取文本 (包装, "result"))
    }

    方法 解析Debugger帧位置JSON <公开 静态 类型 = 文本型 @输出名 = "ParseDebuggerFrameBitSetJSON" @强制输出 = 真>
    参数 暂停摘要JSON <类型 = 文本型 @输出名 = "PauseSummaryJSON">
    参数 目标帧ID <类型 = 文本型 @默认值 = "" @输出名 = "TargetFrameID">
    {
        变量 摘要 <类型 = YYJSON只读对象类>
        如果 (摘要.创建自文本 (暂停摘要JSON) == 假)
        {
            返回 ("{\"ok\":false,\"error\":\"invalid_paused_summary\"}")
        }
        变量 frameId <类型 = 文本型>
        frameId = 目标帧ID
        如果 (frameId == "")
        {
            frameId = yyjson取文本 (摘要, "call_frame_id")
        }
        变量 scriptId <类型 = 文本型>
        scriptId = ""
        变量 url <类型 = 文本型>
        url = ""
        变量 lineNo <类型 = 整数>
        lineNo = 0
        变量 colNo <类型 = 整数>
        colNo = 0
        变量 已匹配 <类型 = 逻辑型 值 = 假>
        变量 frames <类型 = YYJSON只读数组类>
        frames = 摘要.取数组 ("frames")
        如果 (frames.取成员数 () > 0)
        {
            计次循环 ((整数)frames.取成员数 ())
            {
                变量 fi <类型 = YYJSON只读对象类>
                fi = frames.取成员 (取循环索引 ())
                变量 cfId <类型 = 文本型>
                cfId = yyjson取文本 (fi, "callFrameId")
                如果 (frameId != "" && cfId != frameId)
                {
                    到循环尾
                }
                变量 locFi <类型 = YYJSON只读对象类>
                locFi = fi.取对象 ("location")
                scriptId = yyjson取文本 (fi, "scriptId")
                如果 (scriptId == "")
                {
                    scriptId = yyjson取文本 (locFi, "scriptId")
                }
                url = yyjson取文本 (fi, "url")
                lineNo = yyjson取整数 (fi, "lineNumber")
                如果 (lineNo == 0)
                {
                    lineNo = yyjson取整数 (locFi, "lineNumber")
                }
                colNo = yyjson取整数 (fi, "columnNumber")
                如果 (colNo == 0)
                {
                    colNo = yyjson取整数 (locFi, "columnNumber")
                }
                如果 (frameId == "")
                {
                    frameId = cfId
                }
                已匹配 = 真
                跳出循环
            }
        }
        如果 (已匹配 == 假)
        {
            scriptId = yyjson取文本 (摘要, "scriptId")
            url = yyjson取文本 (摘要, "url")
            lineNo = yyjson取整数 (摘要, "lineNumber")
            colNo = yyjson取整数 (摘要, "columnNumber")
            如果 (frameId == "")
            {
                frameId = yyjson取文本 (摘要, "call_frame_id")
            }
        }
        如果 (scriptId == "")
        {
            返回 ("{\"ok\":false,\"error\":\"missing_script_id\",\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (frameId) + "\"}")
        }
        返回 ("{\"ok\":true,\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (frameId) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (url) + "\",\"lineNumber\":" + 到文本 (lineNo) + ",\"columnNumber\":" + 到文本 (colNo) + "}")
    }

    方法 构建Debugger脚本行上下文JSON <公开 静态 类型 = 文本型 @输出名 = "BuildDebuggerScriptLineContextJSON" @强制输出 = 真>
    参数 scriptSource <类型 = 文本型 @输出名 = "ScriptSource">
    参数 lineNo <类型 = 整数 @输出名 = "LineNo">
    参数 contextLines <类型 = 整数 @默认值 = 3 @输出名 = "ContextLines">
    {
        如果 (scriptSource == "")
        {
            返回 ("{\"currentLine\":\"\",\"contextSnippet\":\"\",\"lineCount\":0}")
        }
        变量 srcNorm <类型 = 文本型>
        srcNorm = scriptSource
        子文本替换 (srcNorm, "\r\n", "\n", , , 假)
        子文本替换 (srcNorm, "\r", "\n", , , 假)
        变量 lines <类型 = 文本数组类>
        分割文本 (srcNorm, "\n", lines, 真, 假)
        变量 total <类型 = 整数>
        total = (整数)lines.取成员数 ()
        变量 idx <类型 = 整数>
        idx = lineNo
        如果 (idx < 0)
        {
            idx = 0
        }
        如果 (idx >= total && total > 0)
        {
            idx = total - 1
        }
        变量 currentLine <类型 = 文本型>
        currentLine = ""
        如果 (total > 0)
        {
            currentLine = lines.取成员 (idx)
        }
        变量 ctx <类型 = 整数>
        ctx = contextLines
        如果 (ctx < 0)
        {
            ctx = 0
        }
        如果 (ctx > 20)
        {
            ctx = 20
        }
        变量 start <类型 = 整数>
        start = idx - ctx
        如果 (start < 0)
        {
            start = 0
        }
        变量 end <类型 = 整数>
        end = idx + ctx
        如果 (end >= total)
        {
            end = total - 1
        }
        变量 snippet <类型 = 文本型>
        snippet = ""
        如果 (total > 0 && end >= start)
        {
            变量 i <类型 = 整数>
            i = start
            判断循环 (i <= end)
            {
                如果 (snippet != "")
                {
                    snippet = snippet + "\n"
                }
                变量 ln <类型 = 文本型>
                ln = lines.取成员 (i)
                变量 prefix <类型 = 文本型>
                prefix = 选择 (i == idx, "> ", "  ")
                snippet = snippet + prefix + 到文本 (i + 1) + " | " + ln
                i = i + 1
            }
        }
        返回 ("{\"currentLine\":\"" + MCP_响应构建.JSON转义文本 (currentLine) + "\",\"contextSnippet\":\"" + MCP_响应构建.JSON转义文本 (snippet) + "\",\"lineCount\":" + 到文本 (total) + ",\"lineNumber\":" + 到文本 (idx) + "}")
    }

    方法 执行Debugger脚本源JSON <公开 静态 类型 = 文本型 @输出名 = "ExecuteDebuggerScriptSourceJSON" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        变量 scriptId <类型 = 文本型>
        scriptId = yyjson取文本 (参数JSON, "script_id")
        如果 (scriptId == "")
        {
            scriptId = yyjson取文本 (参数JSON, "scriptId")
        }
        变量 lineNo <类型 = 整数>
        lineNo = -1
        变量 colNo <类型 = 整数>
        colNo = -1
        变量 url <类型 = 文本型>
        url = yyjson取文本 (参数JSON, "url")
        变量 frameId <类型 = 文本型>
        frameId = yyjson取文本 (参数JSON, "call_frame_id")
        变量 ctxLines <类型 = 整数>
        ctxLines = yyjson取整数 (参数JSON, "context_lines")
        如果 (ctxLines <= 0)
        {
            ctxLines = 3
        }
        变量 lineParam <类型 = 整数>
        lineParam = yyjson取整数 (参数JSON, "line")
        如果 (lineParam == 0 && yyjson取文本 (参数JSON, "line") == "")
        {
            lineParam = yyjson取整数 (参数JSON, "line_number")
        }
        如果 (lineParam == 0 && yyjson取文本 (参数JSON, "line_number") == "")
        {
            lineParam = yyjson取整数 (参数JSON, "lineNumber")
        }
        如果 (yyjson取文本 (参数JSON, "line") != "" || yyjson取文本 (参数JSON, "line_number") != "" || yyjson取文本 (参数JSON, "lineNumber") != "")
        {
            lineNo = lineParam
        }
        变量 colParam <类型 = 整数>
        colParam = yyjson取整数 (参数JSON, "column")
        如果 (colParam == 0 && yyjson取文本 (参数JSON, "column") == "")
        {
            colParam = yyjson取整数 (参数JSON, "column_number")
        }
        如果 (colParam == 0 && yyjson取文本 (参数JSON, "column_number") == "")
        {
            colParam = yyjson取整数 (参数JSON, "columnNumber")
        }
        如果 (yyjson取文本 (参数JSON, "column") != "" || yyjson取文本 (参数JSON, "column_number") != "" || yyjson取文本 (参数JSON, "columnNumber") != "")
        {
            colNo = colParam
        }
        如果 (scriptId == "" || lineNo < 0 || frameId == "")
        {
            变量 rawPaused <类型 = 文本型>
            rawPaused = 取CDP事件数据JSON ("Debugger.paused")
            如果 (rawPaused == "")
            {
                返回 ("{\"ok\":false,\"error\":\"no_paused_state | 请先 wait_paused 或 flow\"}")
            }
            变量 summary <类型 = 文本型>
            summary = 解析Debugger暂停摘要 (rawPaused)
            变量 posJSON <类型 = 文本型>
            posJSON = 解析Debugger帧位置JSON (summary, frameId)
            如果 (是否以 (posJSON, "{\"ok\":false"))
            {
                返回 (posJSON)
            }
            变量 posObj <类型 = YYJSON只读对象类>
            posObj.创建自文本 (posJSON)
            如果 (scriptId == "")
            {
                scriptId = yyjson取文本 (posObj, "scriptId")
            }
            如果 (lineNo < 0)
            {
                lineNo = yyjson取整数 (posObj, "lineNumber")
            }
            如果 (colNo < 0)
            {
                colNo = yyjson取整数 (posObj, "columnNumber")
            }
            如果 (url == "")
            {
                url = yyjson取文本 (posObj, "url")
            }
            如果 (frameId == "")
            {
                frameId = yyjson取文本 (posObj, "call_frame_id")
            }
        }
        如果 (scriptId == "")
        {
            返回 ("{\"ok\":false,\"error\":\"missing_script_id\"}")
        }
        如果 (lineNo < 0)
        {
            lineNo = 0
        }
        如果 (colNo < 0)
        {
            colNo = 0
        }
        变量 gpObj <类型 = YYJSON对象类>
        gpObj.创建自文本 ("{}")
        gpObj.加入文本成员 ("scriptId", scriptId)
        变量 syncRaw <类型 = 文本型>
        syncRaw = 执行CDP并同步等待 (命令ID + "_gs", "Debugger.getScriptSource", gpObj.到可读文本 (YYJSON格式化选项.压缩), 20000)
        如果 (syncRaw == "" || CDP同步结果是否成功 (syncRaw) == 假)
        {
            返回 ("{\"ok\":false,\"error\":\"" + MCP_响应构建.JSON转义文本 (取CDP同步结果错误 (syncRaw)) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\"}")
        }
        变量 cdpBody <类型 = 文本型>
        cdpBody = 取CDP同步结果体文本 (syncRaw)
        变量 cdpObj <类型 = YYJSON只读对象类>
        如果 (cdpObj.创建自文本 (cdpBody) == 假)
        {
            返回 ("{\"ok\":false,\"error\":\"cdp_parse\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\"}")
        }
        变量 scriptSource <类型 = 文本型>
        scriptSource = yyjson取文本 (cdpObj, "scriptSource")
        如果 (scriptSource == "")
        {
            返回 ("{\"ok\":false,\"error\":\"empty_script_source\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\"}")
        }
        变量 includeSource <类型 = 逻辑型>
        includeSource = 真
        如果 (参数JSON.是否为空 () == 假)
        {
            // 缺失键保持默认真 (老式文本判断会把默认翻成假)
            includeSource = yyjson取逻辑_默认 (参数JSON, "include_source", 真)
        }
        变量 ctxJSON <类型 = 文本型>
        ctxJSON = 构建Debugger脚本行上下文JSON (scriptSource, lineNo, ctxLines)
        变量 ctxObj <类型 = YYJSON只读对象类>
        ctxObj.创建自文本 (ctxJSON)
        变量 currentLine <类型 = 文本型>
        currentLine = yyjson取文本 (ctxObj, "currentLine")
        变量 contextSnippet <类型 = 文本型>
        contextSnippet = yyjson取文本 (ctxObj, "contextSnippet")
        变量 lineCount <类型 = 整数>
        lineCount = yyjson取整数 (ctxObj, "lineCount")
        变量 srcPart <类型 = 文本型>
        srcPart = ""
        如果 (includeSource)
        {
            srcPart = ",\"scriptSource\":\"" + MCP_响应构建.JSON转义文本 (scriptSource) + "\""
        }
        返回 ("{\"ok\":true,\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (frameId) + "\",\"scriptId\":\"" + MCP_响应构建.JSON转义文本 (scriptId) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (url) + "\",\"lineNumber\":" + 到文本 (lineNo) + ",\"columnNumber\":" + 到文本 (colNo) + ",\"lineCount\":" + 到文本 (lineCount) + ",\"currentLine\":\"" + MCP_响应构建.JSON转义文本 (currentLine) + "\",\"contextSnippet\":\"" + MCP_响应构建.JSON转义文本 (contextSnippet) + "\"" + srcPart + "}")
    }

    # 从 JSON 数组文本解析只读数组 (只读数组类无 创建自文本, 须 object 包装)

    方法 取JSON数组自文本 <公开 静态 类型 = YYJSON只读数组类 @输出名 = "GetJSONArrayAutoText" @强制输出 = 真>
    参数 数组JSON <类型 = 文本型 @输出名 = "ArrayJSON">
    参数 包装键名 <类型 = 文本型 @默认值 = "items" @输出名 = "WrapperKeyName">
    {
        变量 空数组 <类型 = YYJSON只读数组类>
        如果 (数组JSON == "" || 是否以 (数组JSON, "[") == 假)
        {
            返回 (空数组)
        }
        变量 wrapText <类型 = 文本型>
        wrapText = "{\"" + 包装键名 + "\":" + 数组JSON + "}"
        变量 wrapObj <类型 = YYJSON只读对象类>
        如果 (wrapObj.创建自文本 (wrapText) == 假)
        {
            返回 (空数组)
        }
        返回 (wrapObj.取数组 (包装键名))
    }

    # ======== SQLite 缓存数据库 (v2.3) ==========
    # ======== 墙钟时间辅助 — 持久化保留期统一使用墙钟(区别于取启动时间的系统运行时长) ========

    方法 取现行时间毫秒 <公开 静态 类型 = 长整数 @输出名 = "GetCurrentRowTimeMs" @强制输出 = 真>
    {
        // 取现行时间() 返回 OLE 日期(自1899-12-30起的天数, 小数), ×86400000 得墙钟毫秒
        返回 ((长整数)(取现行时间 () * 86400000))
    }

    方法 打开缓存数据库 <公开 静态 @输出名 = "OpenCacheDataLib" @强制输出 = 真>
    {
        变量 dbPath <类型 = 文本型>
        dbPath = 取运行目录 () + "\\mcp_cache.db"
        如果 (缓存数据库.打开 (dbPath))
        {
            // WAL 模式: 并发读取 + 单写入, 性能最优
            缓存数据库.执行SQL语句 ("PRAGMA journal_mode=WAL", )
            缓存数据库.执行SQL语句 ("PRAGMA synchronous=NORMAL", )
            // 创建异步结果表
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS async_results (task_id TEXT PRIMARY KEY, result_json TEXT NOT NULL, is_waiting INTEGER DEFAULT 0, browser_id INTEGER DEFAULT 0, created_at INTEGER NOT NULL, poll_count INTEGER DEFAULT 0)", )
            缓存数据库.执行SQL语句 ("CREATE INDEX IF NOT EXISTS idx_async_created ON async_results(created_at)", )
            缓存数据库.执行SQL语句 ("CREATE INDEX IF NOT EXISTS idx_async_waiting_browser ON async_results(browser_id, is_waiting)", )
            // 兼容旧表: 仅当browser_id列不存在时才添加 (消除每次启动的冗余错误记录)
            变量 列检查 <类型 = SQLite记录集类>
            列检查 = 缓存数据库.取记录集 ("PRAGMA table_info(async_results)", )
            变量 已有browserID列 <类型 = 逻辑型 值 = 假>
            循环判断首 ()
            {
                如果 (列检查.执行语句 () != 100)
                {
                    跳出循环
                }
                如果 (列检查.读文本数据 (1) == "browser_id")
                {
                    已有browserID列 = 真
                    跳出循环
                }
            }
            循环判断尾 (真)
            列检查.释放 ()
            如果 (已有browserID列 == 假)
            {
                缓存数据库.执行SQL语句 ("ALTER TABLE async_results ADD COLUMN browser_id INTEGER DEFAULT 0", )
            }
            // 创建事件日志表
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS event_log (id INTEGER PRIMARY KEY AUTOINCREMENT, log_type TEXT NOT NULL, event_name TEXT, browser_id INTEGER, data_json TEXT NOT NULL, created_at INTEGER NOT NULL)", )
            缓存数据库.执行SQL语句 ("CREATE INDEX IF NOT EXISTS idx_log_type ON event_log(log_type, created_at)", )
            缓存数据库.执行SQL语句 ("CREATE INDEX IF NOT EXISTS idx_log_event ON event_log(event_name, browser_id)", )
            // 创建响应缓存表
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS response_cache (url TEXT PRIMARY KEY, mime_type TEXT, body BLOB, size INTEGER, created_at INTEGER NOT NULL)", )
            控制台输出 (到文本 ("[MCP] SQLite缓存数据库已打开:") + 到文本 (dbPath))
        }
        否则
        {
            控制台输出 ("[MCP] 警告: 无法打开缓存数据库, 使用内存模式降级")
            缓存数据库.打开 (":memory:")
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS async_results (task_id TEXT PRIMARY KEY, result_json TEXT NOT NULL, is_waiting INTEGER DEFAULT 0, browser_id INTEGER DEFAULT 0, created_at INTEGER NOT NULL, poll_count INTEGER DEFAULT 0)", )
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS event_log (id INTEGER PRIMARY KEY AUTOINCREMENT, log_type TEXT NOT NULL, event_name TEXT, browser_id INTEGER, data_json TEXT NOT NULL, created_at INTEGER NOT NULL)", )
            缓存数据库.执行SQL语句 ("CREATE TABLE IF NOT EXISTS response_cache (url TEXT PRIMARY KEY, mime_type TEXT, body BLOB, size INTEGER, created_at INTEGER NOT NULL)", )
        }
        // 启动时一次性清理上次进程运行的残留数据 (仅在首次打开数据库时执行)
        异步缓存锁.加锁 ()
        如果 (缓存数据库已首清 == 假)
        {
            缓存数据库已首清 = 真
            缓存数据库.执行SQL语句 ("DELETE FROM async_results WHERE is_waiting=0", )
            缓存数据库.执行SQL语句 ("DELETE FROM event_log", )
            缓存数据库.执行SQL语句 ("DELETE FROM response_cache", )
        }
        异步缓存锁.解锁 ()
        // 按保留期清理过期数据 (墙钟时间, 与 created_at 写入时钟一致)
        清理过期缓存 ()
        缓存数据库已打开 = 真
    }

    方法 关闭缓存数据库 <公开 静态 @输出名 = "CloseCacheDataLib" @强制输出 = 真>
    {
        如果 (缓存数据库已打开 == 假)
        {
            返回
        }
        缓存数据库已打开 = 假
                异步缓存锁.加锁 ()
        缓存数据库.关闭 ()
        异步缓存锁.解锁 ()
        控制台输出 ("[MCP] SQLite缓存数据库已关闭")
    }

    # ======== 异步任务ID生成 ==========

    方法 生成异步任务ID <公开 静态 类型 = 文本型 @输出名 = "GenToAsyncTaskID" @强制输出 = 真>
    {
                变量 当前计数 <类型 = 长整数>
        @ @<当前计数> = (LONGLONG)InterlockedIncrement64((LONGLONG volatile*)&@<异步任务计数器>);
        变量 时间戳 <类型 = 长整数>
        时间戳 = 取启动时间 ()
        变量 随机盐 <类型 = 整数>
        随机盐 = 取随机数 (10000, 99999)
        返回 ("task_" + 到文本 (时间戳) + "_" + 到文本 (随机盐) + "_" + 到文本 (当前计数))
    }

    # ======== 参数化SQL辅助 (防SQL注入, 替换旧 SQL转义 字符串拼接) ==========

    方法 执行参数化INSERT <公开 静态 @输出名 = "ExecuteParamConvertINSERT" @强制输出 = 真>
    参数 sql模板 <类型 = 文本型 @输出名 = "SQLTemplate">
    参数 p1 <类型 = 文本型 @默认值 = "" @输出名 = "P1">
    参数 p2 <类型 = 文本型 @默认值 = "" @输出名 = "P2">
    参数 p3 <类型 = 整数 @默认值 = 0 @输出名 = "P3">
    参数 p4 <类型 = 长整数 @默认值 = 0 @输出名 = "P4">
    {
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 (sql模板, )
        如果 (p1 != "")
        {
            stmt.置文本参数数据 (1, p1)
        }
        如果 (p2 != "")
        {
            stmt.置文本参数数据 (2, p2)
        }
        如果 (p3 != -1)
        {
            stmt.置整数参数数据 (3, p3)
        }
        如果 (p4 != -1)
        {
            stmt.置长整数参数数据 (4, p4)
        }
        stmt.执行语句 ()
        stmt.释放 ()
    }

    方法 执行参数化DELETE <公开 静态 @输出名 = "ExecuteParamConvertDELETE" @强制输出 = 真>
    参数 sql模板 <类型 = 文本型 @输出名 = "SQLTemplate">
    参数 p1 <类型 = 文本型 @默认值 = "" @输出名 = "P1">
    {
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 (sql模板, )
        如果 (p1 != "")
        {
            stmt.置文本参数数据 (1, p1)
        }
        stmt.执行语句 ()
        stmt.释放 ()
    }

    # ======== 异步结果存储 (SQLite) — v2.4 参数化查询 ==========

    方法 规范化异步结果JSON <公开 静态 类型 = 文本型 @输出名 = "NormalizeAsyncResultJSON" @强制输出 = 真>
    参数 结果JSON <类型 = 文本型 @输出名 = "ResultJSON">
    {
        如果 (结果JSON == "")
        {
            返回 (结果JSON)
        }
        变量 原始长度 <类型 = 整数>
        原始长度 = 取文本长度 (结果JSON)
        如果 (原始长度 <= MCP_常量.异步结果JSON最大字符)
        {
            返回 (结果JSON)
        }
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 假)
        包装对象.加入文本成员 ("error", "async结果过大(" + 到文本 (原始长度) + "字符), 已拒绝写入SQLite | 请缩小响应或使用 consume:true 及时读取")
        包装对象.加入整数成员 ("original_size", 原始长度)
        包装对象.加入整数成员 ("max_size", MCP_常量.异步结果JSON最大字符)
        返回 (包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 尝试占用URL请求槽 <公开 静态 类型 = 逻辑型 @输出名 = "TryAcquireURLRequestSlot" @强制输出 = 真>
    {
        异步缓存锁.加锁 ()
        如果 (活动URL请求数 >= MCP_常量.URL请求最大并发)
        {
            异步缓存锁.解锁 ()
            返回 (假)
        }
        活动URL请求数 = 活动URL请求数 + 1
        如果 (活动URL请求数 >= MCP_常量.URL请求最大并发 && URL请求槽满起始毫秒 == 0)
        {
            URL请求槽满起始毫秒 = 取启动时间 ()
        }
        异步缓存锁.解锁 ()
        返回 (真)
    }

    方法 释放URL请求槽 <公开 静态 @输出名 = "ReleaseURLRequestSlot" @强制输出 = 真>
    {
        异步缓存锁.加锁 ()
        如果 (活动URL请求数 > 0)
        {
            活动URL请求数 = 活动URL请求数 - 1
            最后URL请求槽释放时间 = 取启动时间 ()
            如果 (活动URL请求数 < MCP_常量.URL请求最大并发)
            {
                URL请求槽满起始毫秒 = 0
            }
        }
        异步缓存锁.解锁 ()
    }

    方法 存储异步结果 <公开 静态 @输出名 = "StoreAsyncResult" @强制输出 = 真>
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    参数 结果JSON <类型 = 文本型 @输出名 = "ResultJSON">
    参数 浏览器ID <类型 = 整数 @默认值 = 0 @输出名 = "BrowserID">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        变量 存储JSON <类型 = 文本型>
        存储JSON = 规范化异步结果JSON (结果JSON)
        异步缓存锁.加锁 ()
        变量 是否等待 <类型 = 整数>
        是否等待 = 0
        变量 当前时间 <类型 = 长整数>
        当前时间 = 取现行时间毫秒 ()  // created_at 保留期统一墙钟
        变量 pollCount <类型 = 整数>
        pollCount = 0
        变量 解析浏览器ID <类型 = 整数>
        解析浏览器ID = 浏览器ID
        变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (存储JSON))
        {
            pollCount = yyjson取整数 (结果解析, "_poll_count")
            如果 (结果解析.取逻辑值 ("_waiting"))
            {
                是否等待 = 1
            }
            // 如果参数未传浏览器ID, 尝试从JSON中提取
            如果 (解析浏览器ID == 0)
            {
                解析浏览器ID = yyjson取整数 (结果解析, "_browser_id")
            }
        }
        否则 (寻找文本 (存储JSON, "\"_waiting\":true", 0, 假) != -1 || 寻找文本 (存储JSON, "\"_waiting\": true", 0, 假) != -1)
        {
            是否等待 = 1
        }
        // 如果仍未取到浏览器ID, 保留DB中已有值 (防止回调结果覆盖预占位的browser_id为0)
        如果 (解析浏览器ID == 0)
        {
            变量 旧记录集 <类型 = SQLite记录集类>
            旧记录集 = 缓存数据库.取记录集 ("SELECT browser_id FROM async_results WHERE task_id=?", )
            旧记录集.置文本参数数据 (1, 任务ID)
            如果 (旧记录集.执行语句 () == 100)
            {
                解析浏览器ID = 旧记录集.读整数数据 (0)
            }
            旧记录集.释放 ()
        }
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 ("INSERT OR REPLACE INTO async_results (task_id, result_json, is_waiting, browser_id, created_at, poll_count) VALUES (?, ?, ?, ?, ?, ?)", )
        stmt.置文本参数数据 (1, 任务ID)
        stmt.置文本参数数据 (2, 存储JSON)
        stmt.置整数参数数据 (3, 是否等待)
        stmt.置整数参数数据 (4, 解析浏览器ID)
        stmt.置长整数参数数据 (5, 当前时间)
        stmt.置整数参数数据 (6, pollCount)
        stmt.执行语句 ()
        stmt.释放 ()
        修剪异步结果表_已持锁 ()
        异步缓存锁.解锁 ()
    }

    # ── 浏览器事件驱动的等待任务解析 ──

    方法 解析等待任务 <公开 静态 @输出名 = "ParseWaitTask" @强制输出 = 真>
    参数 事件类型 <类型 = 文本型 注释 = "load_start/load_end/navigate" @输出名 = "EventType">
    参数 浏览器ID <类型 = 整数 @输出名 = "BrowserID">
    参数 事件数据 <类型 = 文本型 注释 = "URL或其他上下文" @输出名 = "EventData">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT task_id, result_json FROM async_results WHERE is_waiting=1 AND (browser_id=0 OR browser_id=?)", )
        记录集.置整数参数数据 (1, 浏览器ID)
        循环判断首 ()
        {
            变量 rc <类型 = 整数>
            rc = 记录集.执行语句 ()
            如果 (rc != 100)
            {
                跳出循环
            }
            变量 任务ID <类型 = 文本型>
            变量 结果JSON <类型 = 文本型>
            任务ID = 记录集.读文本数据 (0)
            结果JSON = 记录集.读文本数据 (1)
            如果 (任务ID == "")
            {
                到循环尾
            }
            变量 解析 <类型 = YYJSON只读对象类>
            如果 (解析.创建自文本 (结果JSON))
            {
                变量 等待类型 <类型 = 文本型>
                等待类型 = 解析.取文本 ("what")
                变量 匹配 <类型 = 逻辑型 值 = 假>
                如果 (事件类型 == "load_end")
                {
                    如果 (等待类型 == "load_end" || 等待类型 == "navigate")
                    {
                        匹配 = 真
                    }
                }
                否则 (事件类型 == "load_start")
                {
                    如果 (等待类型 == "load_start")
                    {
                        匹配 = 真
                    }
                }
                否则 (事件类型 == "navigate")
                {
                    如果 (等待类型 == "navigate" || 等待类型 == "url_contains")
                    {
                        变量 目标值 <类型 = 文本型>
                        目标值 = 解析.取文本 ("value")
                        如果 (目标值 != "" && 寻找文本 (事件数据, 目标值, 0, 假) != -1)
                        {
                            匹配 = 真
                        }
                    }
                }
                如果 (匹配)
                {
                    变量 完成JSON <类型 = YYJSON对象类>
                    完成JSON.创建自文本 ("{}")
                    完成JSON.加入逻辑值成员 ("success", 真)
                    完成JSON.加入逻辑值成员 ("_sync_waited", 真)
                    完成JSON.加入文本成员 ("event", 事件类型)
                    完成JSON.加入文本成员 ("url", 事件数据)
                    完成JSON.加入文本成员 ("message", "等待条件满足: " + 事件类型 + " → " + 事件数据)
                    变量 更新JSON <类型 = 文本型>
                    更新JSON = 完成JSON.到可读文本 (YYJSON格式化选项.压缩)
                    变量 updateStmt <类型 = SQLite记录集类>
                    updateStmt = 缓存数据库.取记录集 ("UPDATE async_results SET result_json=?, is_waiting=0 WHERE task_id=?", )
                    updateStmt.置文本参数数据 (1, 更新JSON)
                    updateStmt.置文本参数数据 (2, 任务ID)
                    updateStmt.执行语句 ()
                    updateStmt.释放 ()
                }
            }
        }
        循环判断尾 (真)
        记录集.释放 ()
        异步缓存锁.解锁 ()
    }

    方法 存储等待任务错误 <公开 静态 @输出名 = "StoreWaitTaskError" @强制输出 = 真>
    参数 浏览器ID <类型 = 整数 @输出名 = "BrowserID">
    参数 错误消息 <类型 = 文本型 @输出名 = "ErrorMessage">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        // 仅失败该浏览器的等待任务: 本方法仅用于"该浏览器已崩溃/关闭"场景, 精确匹配防误伤全局(browser_id=0)任务
        记录集 = 缓存数据库.取记录集 ("SELECT task_id FROM async_results WHERE is_waiting=1 AND browser_id=?", )
        记录集.置整数参数数据 (1, 浏览器ID)
        循环判断首 ()
        {
            变量 rc <类型 = 整数>
            rc = 记录集.执行语句 ()
            如果 (rc != 100)
            {
                跳出循环
            }
            变量 任务ID <类型 = 文本型>
            任务ID = 记录集.读文本数据 (0)
            如果 (任务ID != "")
            {
                变量 错误对象 <类型 = YYJSON对象类>
                错误对象.创建自文本 ("{}")
                错误对象.加入逻辑值成员 ("success", 假)
                错误对象.加入文本成员 ("error", 错误消息)
                变量 错误JSON <类型 = 文本型>
                错误JSON = 错误对象.到可读文本 (YYJSON格式化选项.压缩)
                变量 updateStmt <类型 = SQLite记录集类>
                updateStmt = 缓存数据库.取记录集 ("UPDATE async_results SET result_json=?, is_waiting=0 WHERE task_id=?", )
                updateStmt.置文本参数数据 (1, 错误JSON)
                updateStmt.置文本参数数据 (2, 任务ID)
                updateStmt.执行语句 ()
                updateStmt.释放 ()
            }
        }
        循环判断尾 (真)
        记录集.释放 ()
        异步缓存锁.解锁 ()
    }

    方法 查询异步结果 <公开 静态 类型 = 文本型 @输出名 = "QueryAsyncResult" @强制输出 = 真>
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    参数 取走后删除 <类型 = 逻辑型 @默认值 = 假 @输出名 = "ConsumeAfterDelete">
    {
        变量 result <类型 = 文本型>
        result = ""
        如果 (缓存数据库可用 () == 假)
        {
            返回 ("")
        }
        异步缓存锁.加锁 ()
        变量 记录集 <类型 = SQLite记录集类>
        记录集 = 缓存数据库.取记录集 ("SELECT result_json, is_waiting FROM async_results WHERE task_id=?", )
        记录集.置文本参数数据 (1, 任务ID)
        如果 (记录集.执行语句 () == 100)  // SQLITE_ROW
        {
            result = 记录集.读文本数据 (0)
            变量 waiting <类型 = 整数>
            waiting = 记录集.读整数数据 (1)
            如果 (取走后删除 && waiting == 0)
            {
                执行参数化DELETE ("DELETE FROM async_results WHERE task_id=?", 任务ID)
            }
        }
        记录集.释放 ()
        异步缓存锁.解锁 ()
        返回 (result)
    }

    方法 删除异步结果 <公开 静态 @输出名 = "DeleteAsyncResult" @强制输出 = 真>
    参数 任务ID <类型 = 文本型 @输出名 = "TaskID">
    {
        如果 (任务ID == "")
        {
            返回
        }
        异步缓存锁.加锁 ()
        执行参数化DELETE ("DELETE FROM async_results WHERE task_id=?", 任务ID)
        异步缓存锁.解锁 ()
    }

    # 兼容旧接口: 存储任务结果 (SQLite 封装, v2.4 参数化)

    方法 存储任务结果 <公开 静态 @输出名 = "StoreTaskResult" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 结果JSON <类型 = 文本型 @输出名 = "ResultJSON">
    {
        如果 (缓存数据库可用 () == 假)
        {
            返回
        }
        异步缓存锁.加锁 ()
        变量 当前时间 <类型 = 长整数>
        当前时间 = 取现行时间毫秒 ()  // created_at 保留期统一墙钟
        变量 存储JSON <类型 = 文本型>
        存储JSON = 规范化异步结果JSON (结果JSON)
        变量 是否等待 <类型 = 整数>
        是否等待 = 0
                变量 结果解析 <类型 = YYJSON只读对象类>
        如果 (结果解析.创建自文本 (存储JSON))
        {
            如果 (结果解析.取逻辑值 ("_waiting"))
            {
                是否等待 = 1
            }
        }
                变量 保留浏览器ID <类型 = 整数>
        保留浏览器ID = 0
        变量 保留轮询数 <类型 = 整数>
        保留轮询数 = 0
        如果 (结果解析.创建自文本 (存储JSON))
        {
            保留浏览器ID = yyjson取整数 (结果解析, "_browser_id")
            保留轮询数 = yyjson取整数 (结果解析, "_poll_count")
        }
        如果 (保留浏览器ID == 0 || 保留轮询数 == 0)
        {
            变量 旧记录集 <类型 = SQLite记录集类>
            旧记录集 = 缓存数据库.取记录集 ("SELECT browser_id, poll_count FROM async_results WHERE task_id=?", )
            旧记录集.置文本参数数据 (1, 命令ID)
            如果 (旧记录集.执行语句 () == 100)
            {
                如果 (保留浏览器ID == 0)
                {
                    保留浏览器ID = 旧记录集.读整数数据 (0)
                }
                如果 (保留轮询数 == 0)
                {
                    保留轮询数 = 旧记录集.读整数数据 (1)
                }
            }
            旧记录集.释放 ()
        }
        变量 stmt <类型 = SQLite记录集类>
        stmt = 缓存数据库.取记录集 ("INSERT OR REPLACE INTO async_results (task_id, result_json, is_waiting, browser_id, created_at, poll_count) VALUES (?, ?, ?, ?, ?, ?)", )
        stmt.置文本参数数据 (1, 命令ID)
        stmt.置文本参数数据 (2, 存储JSON)
        stmt.置整数参数数据 (3, 是否等待)
        stmt.置整数参数数据 (4, 保留浏览器ID)
        stmt.置长整数参数数据 (5, 当前时间)
        stmt.置整数参数数据 (6, 保留轮询数)
        stmt.执行语句 ()
        stmt.释放 ()
        修剪异步结果表_已持锁 ()
        异步缓存锁.解锁 ()
    }

    # 兼容旧接口: 查询任务结果 (SQLite 封装, v2.4 参数化)

    方法 查询任务结果 <公开 静态 类型 = 文本型 @输出名 = "QueryTaskResult" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    {
