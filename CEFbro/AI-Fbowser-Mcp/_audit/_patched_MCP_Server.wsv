        添加工具JSON ("batch", "批量执行(默认自动等待子命令异步结果, async_only:true关闭)", 单参数Schema文本 ("commands", "text", "JSON数组"))
        添加工具JSON ("workflow_list", "列出 workflows 目录下的 JSON 工作流")
        添加工具JSON ("workflow_get", "读取工作流定义", 单参数Schema文本 ("name", "text", "工作流名(无.json)"))
        添加工具JSON ("workflow_run", "执行工作流(同步)", 多属性Schema文本 (属性项JSON ("name", "text", "工作流文件名") + "," + 属性项JSON ("definition", "text", "完整JSON定义") + "," + 属性项JSON ("steps", "text", "内联步骤JSON数组") + "," + 属性项JSON ("on_error", "text", "stop|continue"), "\"name\""))
        添加工具JSON ("workflow_stop", "停止正在运行的工作流")
        添加工具JSON ("browser_kernel_cert", "内核层: 证书错误管理。action=list查看页面证书错误记录(SSL校验失败URL/错误码), ignore开启忽略证书错误(自动放行跳转), ignore_off关闭, clear清空, status查开关状态", 多属性Schema文本 (属性项JSON ("action", "text", "list/ignore/ignore_off/clear/status"), "\"action\""))
        添加工具JSON ("browser_kernel_auth", "内核层: HTTP认证凭据(Basic/Digest)。action=set {host,port,username,password,realm} 注入站点认证账号密码(浏览器_获得需授权证书事件自动应答), clear {host,port} 清除, list 列出", 多属性Schema文本 (属性项JSON ("action", "text", "set/clear/list") + "," + 属性项JSON ("host", "text", "主机(例: example.com)") + "," + 属性项JSON ("port", "integer", "端口(默认443)") + "," + 属性项JSON ("username", "text", "账号(set时必填)") + "," + 属性项JSON ("password", "text", "密码(set时必填)") + "," + 属性项JSON ("realm", "text", "认证域(可选)"), "\"action\""))
        添加工具JSON ("browser_kernel_download", "内核层: 下载控制。action=pause/resume/cancel {url或download_id} 排队控制进行中下载(浏览器_正在下载事件即时执行), clear_queue清空队列; 下载进度用 browser_event 查询 download_progress", 多属性Schema文本 (属性项JSON ("action", "text", "pause/resume/cancel/clear_queue") + "," + 属性项JSON ("url", "text", "下载URL(匹配包含)") + "," + 属性项JSON ("download_id", "text", "下载标识(整数文本)"), "\"action\""))
        添加工具JSON ("browser_kernel_scheme", "内核层: 自定义协议方案。action=register {domain,mime,data或file} 注册 mcp://域名 动态内容(CEF资源处理器返回), unregister {domain} 解除, clear 清理全部, list 列出。注册后用 browser_navigate 访问 mcp://域名/", 多属性Schema文本 (属性项JSON ("action", "text", "register/unregister/clear/list") + "," + 属性项JSON ("domain", "text", "方案域名(例: api → mcp://api)") + "," + 属性项JSON ("mime", "text", "响应MIME(默认text/html)") + "," + 属性项JSON ("data", "text", "响应内容(与file二选一)") + "," + 属性项JSON ("file", "text", "响应内容文件路径(与data二选一)"), "\"action\""))
        添加工具JSON ("browser_kernel_menu", "内核层: 右键快捷菜单屏蔽。action=disable屏蔽页面右键菜单(内核事件拦截), enable恢复, status查状态(触发条件以实际内核为准)", 单参数Schema文本 ("action", "text", "disable/enable/status"))
        添加工具JSON ("browser_kernel_reverse_probe", "动态插桩总包: 五维API插桩(XHR/fetch/WebSocket/定时器/事件监听), 记录URL/状态/响应/调用栈。action=enable注入, get取回(window.__MCP_PROBE__), clear清空, disable移除", 单参数Schema文本 ("action", "text", "enable/get/clear/disable"))
        添加工具JSON ("browser_kernel_reverse_trace", "动态调用追踪: 包装目标函数记录调用栈+参数+返回值+耗时。targets为JSON数组(如 [\"window.fetch\",\"crypto.subtle.encrypt\"] 点路径逐级解析)。action=start/get/clear/stop", 多属性Schema文本 (属性项JSON ("action", "text", "start/get/clear/stop") + "," + 属性项JSON ("targets", "text", "JSON数组: [\"obj.path.fn\",...]"), "\"action\""))
        添加工具JSON ("browser_kernel_reverse_algo", "动态算法Hook: 包装CryptoJS全算法(MD5/SHA/AES/DES/RC4/HMAC等)+全局哈希/base64+WebCrypto subtle(encrypt/decrypt/digest/sign), 记录算法名/参数/输出/调用栈(window.__MCP_ALGO_LOG__)。action=start/get/clear/stop", 单参数Schema文本 ("action", "text", "start/get/clear/stop"))
        添加工具JSON ("browser_kernel_reverse_functions", "动态函数提取: 枚举window全局函数+常用对象链+核心类prototype方法, 输出路径/函数名/参数个数/源码toString。filter按路径关键词过滤, max上限(默认500)", 多属性Schema文本 (属性项JSON ("filter", "text", "路径关键词过滤(可选)") + "," + 属性项JSON ("max", "integer", "上限(默认500,最大1000)"), ""))
        添加工具JSON ("browser_kernel_reverse_sources", "动态JS源码提取: document.scripts全量(含inline), index指定单脚本(从1起), max_len单脚本截断(默认20000,最大200000)", 多属性Schema文本 (属性项JSON ("index", "integer", "单脚本索引(0=全部)") + "," + 属性项JSON ("max_len", "integer", "单脚本截断字符"), ""))
        添加工具JSON ("browser_kernel_reverse_watch_global", "全局变量动态追踪: defineProperty包装指定全局变量, 记录写入者调用栈+新值(window.__MCP_GWATCH__)。names为JSON数组(如 [\"token\",\"sign\"] )。action=start/get/clear/stop", 多属性Schema文本 (属性项JSON ("action", "text", "start/get/clear/stop") + "," + 属性项JSON ("names", "text", "JSON数组: [\"var1\",\"var2\"]"), "\"action\""))
        // ======== 能力补齐: 以下 14 个工具在源码中早已完整实现(分派分支齐全),
        // 但从未登记到 添加工具JSON, 导致 AI 代理在 tools/list 里看不到、无法调用。
                添加工具JSON ("browser_kernel_ipc_queue", "内核层: 渲染侧IPC消息队列读取。读取注入脚本收集的 __mcp_ipc_queue(渲染进程与浏览器进程间的IPC消息)。action 必填: queue 取回队列JSON, clear 清空。用于逆向分析渲染侧通信协议", 单参数Schema文本 ("action", "text", "queue 取回队列 / clear 清空"))
        添加工具JSON ("browser_kernel_ipc_clear", "内核层: 清空渲染侧IPC消息队列(__mcp_ipc_queue)。action 必填且只能为 clear。等价于 browser_kernel_ipc_queue action=clear, 保留独立工具名兼容旧调用", 单参数Schema文本 ("action", "text", "固定传 clear"))
        添加工具JSON ("browser_kernel_cdp_monitor", "内核层: CDP事件订阅监控。action=add {methods,max} 订阅CDP事件(方法名模式, 默认*通配, max为缓存上限默认500最大5000), remove移除, clear清空, enable/disable总开关。配合 browser_cdp_event 读取捕获到的事件", 多属性Schema文本 (属性项JSON ("action", "text", "add/remove/clear/enable/disable") + "," + 属性项JSON ("methods", "text", "CDP方法名模式(默认*匹配全部, 例: Network.*)") + "," + 属性项JSON ("max", "integer", "事件缓存上限(默认500, 最大5000)"), "\"action\""))
        添加工具JSON ("browser_kernel_reactor", "内核层: 事件反应器。action=add {event,code,cooldown_ms} 注册规则——当浏览器事件触发时自动在页面执行指定JS; cooldown_ms限流防抖(默认1000), clear清空全部规则。用于无人值守自动化。**事件名必须用下面列出的真实值**: 写错(如 load_end)的规则会被接受但**永不触发**且无任何提示 —— 可用 * 通配兜底", 多属性Schema文本 (属性项JSON ("action", "text", "add/clear") + "," + 属性项JSON ("event", "text", "事件名(真实值): * (通配, 推荐先用它验证链路) / navigate / url_changed / loading_state_change / load_progress / resource_request / resource_response / resource_redirect / popup / popup_failed / download_start / download_progress / fullscreen / favicon / find_result / key_press / status_message / before_unload / browser_created / browser_closing / do_close") + "," + 属性项JSON ("code", "text", "事件触发时执行的JS代码") + "," + 属性项JSON ("cooldown_ms", "integer", "冷却毫秒(默认1000)"), "\"action\""))
        添加工具JSON ("browser_kernel_watch", "内核层: 定时监视。action=start {expression,key,interval_ms} 周期性求值页面表达式并记录值变化(表达式例: document.title / window.__token), stop停止, clear清空; 同key覆盖去重, interval_ms最小500默认2000。用于轮询等待页面状态变化", 多属性Schema文本 (属性项JSON ("action", "text", "start/stop/clear") + "," + 属性项JSON ("expression", "text", "被监视的JS表达式(例: document.title)") + "," + 属性项JSON ("key", "text", "监视任务标识(缺省自动生成)") + "," + 属性项JSON ("interval_ms", "integer", "轮询间隔毫秒(最小500, 默认2000)"), "\"action\""))
        添加工具JSON ("browser_kernel_events_all", "内核层: 全事件流总开关。action 必填: enable 一次性打开 **28** 个开关(13 事件族 + 3 日志 + 12 扩展族: 含菜单/快捷菜单/导航意图/界面细节/插件/启动/渲染/渲染WS/权限/离屏), 与 browser_collect action=event_all_enable 的集合**完全一致**; disable 全部关闭。免去逐个 browser_event action=*_enable 的繁琐", 单参数Schema文本 ("action", "text", "enable 全开 / disable 全关"))
        添加工具JSON ("browser_set_s5_proxy", "VIP代理: 设置SOCKS5代理。address为 host:port, username/password可选认证。设置后需刷新页面生效。用于换IP/绕过地域限制", 多属性Schema文本 (属性项JSON ("address", "text", "代理地址 host:port (必填)") + "," + 属性项JSON ("username", "text", "代理账号(可选)") + "," + 属性项JSON ("password", "text", "代理密码(可选)"), "\"address\""))
        添加工具JSON ("browser_vip_clear_s5_proxy", "VIP代理: 清除已设置的SOCKS5代理并恢复直连, 需刷新页面生效")
        添加工具JSON ("browser_vip_mouse_click", "VIP输入: 内核级鼠标单击。x,y为页面坐标(0~32767), button为按键(0左/1中/2右, 默认0)。经CEF内核注入真实输入事件, 比JS模拟更难被检测, 用于过反爬 | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("x", "integer", "X坐标(0~32767, 必填)") + "," + 属性项JSON ("y", "integer", "Y坐标(0~32767, 必填)") + "," + 属性项JSON ("button", "integer", "按键: 0左/1中/2右 (默认0)"), "\"x\",\"y\""))
        添加工具JSON ("browser_vip_mouse_move", "VIP输入: 内核级鼠标移动到指定坐标(不点击)。x,y为页面坐标。常与 browser_vip_mouse_click 配合模拟真实移动轨迹 | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("x", "integer", "X坐标(必填)") + "," + 属性项JSON ("y", "integer", "Y坐标(必填)"), "\"x\",\"y\""))
        添加工具JSON ("browser_vip_mouse_wheel", "VIP输入: 内核级鼠标滚轮。x,y为滚轮所在坐标, delta_x/delta_y为滚动量(正值向下滚)。用于触发依赖滚轮事件的懒加载 | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("x", "integer", "X坐标(必填)") + "," + 属性项JSON ("y", "integer", "Y坐标(必填)") + "," + 属性项JSON ("delta_x", "integer", "水平滚动量(默认0)") + "," + 属性项JSON ("delta_y", "integer", "垂直滚动量(正值向下)"), "\"x\",\"y\""))
        添加工具JSON ("browser_vip_key_press", "VIP输入: 内核级按键按下(不放开)。key_code为Windows虚拟键码1~255(回车13/空格32/A65)。按住类组合键时先press再release | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("key_code", "integer", "虚拟键码1~255 (必填, 例: 回车13)"), "\"key_code\""))
        添加工具JSON ("browser_vip_key_release", "VIP输入: 内核级按键放开。key_code为Windows虚拟键码1~255, 与 browser_vip_key_press 配对使用以完成按住/组合键 | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("key_code", "integer", "虚拟键码1~255 (必填)"), "\"key_code\""))
        添加工具JSON ("browser_vip_key_click", "VIP输入: 内核级按键单击(按下+放开)。key_code为Windows虚拟键码1~255(回车13/空格32/A65)。最常用的按键工具 | **警告: 本工具走内核级注入, 实测每次调用都会让 CDP 通道在本会话内失效**(之后所有 CDP 优先工具都会超时/退化, 连 browser_status 都可能挂), 必须重启 AI-Fbowser-Mcp.exe 才能恢复;如后续还要用 CDP 类工具, 请改用 CDP 版: browser_mouse_click / browser_mouse_move / browser_mouse_wheel / browser_key_event", 多属性Schema文本 (属性项JSON ("key_code", "integer", "虚拟键码1~255 (必填, 例: 回车13)"), "\"key_code\""))
        添加工具JSON ("browser_refresh_cookies", "把内存中的 Cookie 刷写到磁盘| 用于持久化登录态, 一般无需手动调用")
