<火山程序 类型 = "通常" 版本 = 1 />
包 火山.程序
类 校准样本 <公开 @全局类 = 真 @输出名 = "CalibSample">
{
    // ============================================================
    // 情形 1: 校准样本 —— 无条件 返回 之后紧跟同级兄弟语句 (应当命中)
    //         形状取自 MCP_Server_Core.wsv 的 browser_mouse_click 结尾
    // ============================================================
    方法 情形1_应命中 <公开 静态 类型 = 文本型 @输出名 = "Case1">
    参数 命令ID <类型 = 文本型>
    {
        如果 (参数可用 == 假)
        {
            返回 ("必须同时提供 x 与 y")
        }
        变量 browser <类型 = 对象>
        browser = 取浏览器 ()
        如果 (browser.是否为空 () == 假)
        {
            如果 (取逻辑 ("kernel") == 假)
            {
                如果 (CDP派发 ("mousePressed"))
                {
                    返回 ("经 CDP 派发")
                }
            }
            // CDP 派发失败时不再静默回退内核注入
            返回 ("CDP 派发失败")
            vip_ctrl.高级鼠标_单击 (x, y, 按钮类型)
            返回 ("VIP点击")
        }
        返回 ("无浏览器")
    }

    // ============================================================
    // 情形 2: if/else 穷尽链(含兜底 否则)全分支返回 -> 链后语句不可达
    //         只应被"探测 B"命中, 不应出现在"探测 A"(因为返回在分支内部)
    // ============================================================
    方法 情形2_仅B命中 <公开 静态 类型 = 整数 @输出名 = "Case2">
    {
        变量 结果 <类型 = 整数 值 = 0>
        如果 (条件A)
        {
            返回 (1)
        }
        否则 (条件B)
        {
            返回 (2)
        }
        否则
        {
            返回 (3)
        }
        结果 = 计算 ()
        返回 (结果)
    }

    // ============================================================
    // 情形 2b: 无 否则 的 如果 分支内返回, 分支后同级语句可达 (A/B 都不得命中)
    // ============================================================
    方法 情形2b_都不得命中 <公开 静态 类型 = 整数 @输出名 = "Case2b">
    {
        变量 结果 <类型 = 整数 值 = 0>
        如果 (条件A)
        {
            返回 (1)
        }
        结果 = 计算 ()
        返回 (结果)
    }

    // ============================================================
    // 情形 3: 如果分支内 返回, 之后有同级 否则 分支 (不得命中)
    // ============================================================
    方法 情形3_不得命中 <公开 静态 @输出名 = "Case3">
    {
        如果 (甲)
        {
            返回 (1)
        }
        否则 (乙)
        {
            记录日志 ("乙")
        }
        否则
        {
            记录日志 ("其它")
        }
    }

    // ============================================================
    // 情形 4: 循环体内无条件 跳出循环 之后有同级语句 (应当命中)
    // ============================================================
    方法 情形4_应命中 <公开 静态 @输出名 = "Case4">
    {
        循环判断首 ()
        {
            如果 (应退出)
            {
                跳出循环
            }
            跳出循环
            记录日志 ("这行不可达")
            计数器 = 计数器 + 1
        }
        循环判断尾 (真)
    }

    // ============================================================
    // 情形 5: 字符串/注释/内嵌C++ 里的花括号不得扰乱层级 (不得命中)
    // ============================================================
    方法 情形5_括号干扰 <公开 静态 @输出名 = "Case5">
    {
        变量 空对象 <类型 = 文本型>
        空对象 = "{\"a\":{\"b\":1}}"
        // 注释里的括号: {{{{{{ 未闭合
        # 文档注释里的括号: }}}{{{{
        @ {
        @     if (a) { b(); }
        @     struct S { int x; };
        @ }
        返回 (空对象)
    }
}
