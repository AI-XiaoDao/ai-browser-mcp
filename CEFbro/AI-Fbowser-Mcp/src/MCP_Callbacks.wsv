# ================================================================
# VIP通用回调 — 用于高级_执行JS/枚举DOM/预查找文本等VIP异步操作
# ================================================================

类 类_MCP_VIP通用回调 <公开 基础类 = 类_FBrowserVIP_通用回调>
{
    变量 任务ID <公开 类型 = 文本型>

    方法 数据回调 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 标识ID <类型 = 整数>
    参数 成功 <类型 = 逻辑型>
    参数 数据指针 <类型 = 变整数>
    参数 数据大小 <类型 = 整数>
    {
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 成功)
        如果 (成功 && 数据指针 != 0 && 数据大小 > 0)
        {
            变量 结果UTF8 <类型 = 字节集类>
            结果UTF8 = 指针到字节集 (数据指针, 数据大小)
            变量 结果文本 <类型 = 文本型>
            结果文本 = UTF8到文本 (结果UTF8)
            // 修复: 按字节安全截断(常量语义为字节), 防截断切在多字节字符中间产生U+FFFD
            如果 (取字节集长度 (结果UTF8) > MCP_常量.截断_VIP数据最大字节)
            {
                结果文本 = MCP命令服务器.字节安全截断 (结果文本, MCP_常量.截断_VIP数据最大字节) + "...[MCP截断]"
            }
            包装对象.加入文本成员 ("message", 结果文本)
            包装对象.加入整数成员 ("data_size", 数据大小)
        }
        否则
        {
            包装对象.加入文本成员 ("error", "VIP操作失败或返回空数据")
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    方法 列表数据回调 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 标识ID <类型 = 整数>
    参数 成功 <类型 = 逻辑型>
    参数 列表值 <类型 = 类_FBrowser_列表值>
    {
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 成功)
        如果 (成功 && 列表值.是否为空 () == 假)
        {
            变量 列表大小 <类型 = 整数>
            列表大小 = 列表值.取大小 ()
            变量 结果数组 <类型 = YYJSON数组类>
            结果数组.创建自文本数据 (取空文本数组 ())
            计次循环 (列表大小)
            {
                变量 idx <类型 = 整数>
                idx = 取循环索引 ()
                变量 类型码 <类型 = 整数>
                类型码 = 列表值.取类型 (idx)
                如果 (类型码 == 值类型.无效 || 类型码 == 值类型.空)
                {
                    结果数组.加入文本成员 ("null")
                }
                否则 (类型码 == 值类型.逻辑)
                {
                    结果数组.加入文本成员 (到文本 (列表值.取逻辑值 (idx)))
                }
                否则 (类型码 == 值类型.整数型)
                {
                    结果数组.加入整数成员 (列表值.取整数值 (idx))
                }
                否则 (类型码 == 值类型.双精度小数型)
                {
                    结果数组.加入小数成员 (列表值.取双精度小数值 (idx))
                }
                否则 (类型码 == 值类型.文本)
                {
                    结果数组.加入文本成员 (列表值.取文本值 (idx))
                }
                否则 (类型码 == 值类型.字节集型)
                {
                    结果数组.加入文本成员 ("[bytes]")
                }
                否则 (类型码 == 值类型.字典值型)
                {
                    结果数组.加入文本成员 ("[dict]")
                }
                否则 (类型码 == 值类型.列表型)
                {
                    结果数组.加入文本成员 ("[list]")
                }
                否则
                {
                    结果数组.加入文本成员 ("[type:" + 到文本 (类型码) + "]")
                }
            }
            包装对象.加入数组成员 ("data", 结果数组)
            包装对象.加入整数成员 ("count", 列表大小)
        }
        否则
        {
            包装对象.加入文本成员 ("error", "VIP操作失败或返回空列表")
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

# ================================================================
# URL请求回调 — 参照样例 browser_event1.wsv: 类_FBrowser_URL请求事件
# ================================================================

类 类_MCP_URL请求回调 <公开 基础类 = 类_FBrowser_URL请求事件>
{
    变量 任务ID <公开 类型 = 文本型>
    变量 响应数据 <公开 类型 = 字节集类>
    变量 已截断 <类型 = 逻辑型 值 = 假>
    变量 已释放槽 <类型 = 整数 值 = 0 注释 = "原子标志: 0=未释放, 1=已释放。使用InterlockedExchange确保多核安全">

    方法 释放槽_一次
    {
        @ // 原子比较交换: 仅当旧值为0时置1并执行释放, 多核安全
        @ if (InterlockedExchange((LONG volatile*)&@<已释放槽>, 1) == 0)
        @ {
        MCP命令服务器.释放URL请求槽 ()
        @ }
    }

    方法 获取到数据 <公开 @虚拟方法 = 可覆盖>
    参数 标识 <类型 = 长整数>
    参数 URL请求 <类型 = 类_FBrowser_URL请求>
    参数 数据 <类型 = 字节集类>
    {
        如果 (已截断)
        {
            返回
        }
        变量 当前长度 <类型 = 整数>
        当前长度 = 取字节集长度 (响应数据)
        如果 (当前长度 + 取字节集长度 (数据) > MCP_常量.URL响应累积最大字节)
        {
            已截断 = 真
            // 修复: 按结果载荷需求封顶累积(1MB字节≈256KB字符上限的4倍余量), 原按50MB攒满再截断浪费内存
            返回
        }
        如果 (当前长度 > 0)
        {
            响应数据.添加字节集 (数据)
        }
        否则
        {
            响应数据 = 数据
        }
    }

    方法 读取结束 <公开 @虚拟方法 = 可覆盖>
    参数 标识 <类型 = 长整数>
    {
        释放槽_一次 ()
        // End 先于 OnRequestComplete 或未触发即将完成时, 避免 task 永久无结果
        变量 已有结果 <类型 = 文本型>
        已有结果 = MCP命令服务器.查询异步结果 (任务ID)
        如果 (已有结果 == "")
        {
            MCP命令服务器.存储异步结果 (任务ID, MCP_响应构建.构建标准失败JSON ("URL请求已结束但未收到响应体"))
        }
    }

    方法 即将完成 <公开 @虚拟方法 = 可覆盖>
    参数 标识 <类型 = 长整数>
    参数 URL请求 <类型 = 类_FBrowser_URL请求>
    {
        释放槽_一次 ()
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 真)
        变量 结果文本 <类型 = 文本型>
        如果 (响应数据.字节集是否为空 () == 假 && 取字节集长度 (响应数据) > 0)
        {
            结果文本 = UTF8到文本 (响应数据)
            如果 (取文本长度 (结果文本) > MCP_常量.截断_响应文本最大字符)
            {
                结果文本 = 取文本左边 (结果文本, MCP_常量.截断_响应文本最大字符) + "...[MCP截断]"
            }
            包装对象.加入文本成员 ("message", 结果文本)
            包装对象.加入整数成员 ("data_size", 取字节集长度 (响应数据))
            如果 (已截断)
            {
                包装对象.加入逻辑值成员 ("truncated", 真)
            }
        }
        否则
        {
            如果 (已截断)
            {
                // 超限丢弃场景: 已收数据在上限判断后保留, 但本分支覆盖响应体为空的边界情况
                包装对象.加入逻辑值成员 ("truncated", 真)
                包装对象.加入文本成员 ("message", "请求完成(响应体超过上限已丢弃)")
            }
            否则
            {
                包装对象.加入文本成员 ("message", "请求完成(无响应体)")
            }
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

