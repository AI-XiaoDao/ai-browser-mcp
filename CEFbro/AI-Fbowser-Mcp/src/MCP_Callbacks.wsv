# ================================================================
# 下载图片回调 — 参照样例 browser_callback.wsv: 类_FBrowser_下载图片回调
# ================================================================

类 类_MCP_下载图片回调 <公开 基础类 = 类_FBrowser_下载图片回调>
{
    变量 任务ID <公开 类型 = 文本型>

    方法 图片下载完成 <公开 @虚拟方法 = 可覆盖>
    参数 图片链接 <类型 = 文本型>
    参数 状态码 <类型 = 整数>
    参数 图片 <类型 = 类_FBrowser_图片>
    {
        如果 (图片.是否为空 () == 假 && 状态码 == 200)
        {
            变量 实际比例 <类型 = 小数类>
            变量 宽度 <类型 = 整数类>
            变量 高度 <类型 = 整数类>
            图片.取图片信息 (1, 实际比例, 宽度, 高度)
            变量 data <类型 = 类_FBrowser_字节集>
            data = 图片.取图片数据_PNG (1, 0, 宽度, 高度)
            变量 字节集数据 <类型 = 字节集类>
            字节集数据 = data.取字节集 ()
            变量 结果JSON <类型 = 文本型>
            结果JSON = MCP_响应构建.构建Base64图片异步JSON (字节集数据, "image/png", 取字节集长度 (字节集数据))
            变量 包装对象 <类型 = YYJSON对象类>
            包装对象.创建自文本 (结果JSON)
            包装对象.加入文本成员 ("url", 图片链接)
            包装对象.加入整数成员 ("width", 宽度.值)
            包装对象.加入整数成员 ("height", 高度.值)
            MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
        }
        否则
        {
            MCP命令服务器.存储异步结果 (任务ID, MCP_响应构建.构建标准失败JSON ("下载失败, 状态码:" + 到文本 (状态码)))
        }
    }

    #
}

# ================================================================
# 响应缓存过滤器 — browser_intercept cache 时收集响应体写入 SQLite
# ================================================================

类 类_MCP_缓存过滤器 <公开 基础类 = 类_FBrowser_资源过滤器>
{
    变量 资源地址 <公开 类型 = 文本型>
    变量 资源MIME <公开 类型 = 文本型>
    变量 数据缓存 <类型 = 字节集类>
    变量 已截断 <类型 = 逻辑型 值 = 假>

    方法 初始化过滤器 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    {
        返回 (真)
    }

    方法 获取数据 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 数据指针 <类型 = 变整数 注释 = "传递过来的数据指针">
    参数 数据大小 <类型 = 整数 注释 = "当前数据大小">
    {
        如果 (已截断)
        {
            返回
        }
        如果 (取字节集长度 (数据缓存) + 数据大小 > MCP_常量.响应缓存单条最大字节)
        {
            已截断 = 真
            数据缓存.清空字节集 ()
            返回
        }
        添加字节集 (数据缓存, 指针到字节集 (数据指针, 数据大小))
    }

    方法 修改数据 <公开 类型 = 整数 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 输入指针 <类型 = 变整数>
    参数 输入大小 <类型 = 整数>
    参数 输入读取大小 <类型 = 整数类>
    参数 输出指针 <类型 = 变整数>
    参数 输出大小 <类型 = 整数>
    参数 输出写入大小 <类型 = 整数类>
    {
        如果 (输入大小 > 输出大小)
        {
            输入读取大小.值 = 输出大小
            输出写入大小.值 = 输出大小
            内存复制 (输出指针, 输入指针, 输出大小)
            返回 (资源过滤器.需要更多数据)
        }
        否则
        {
            输入读取大小.值 = 输入大小
            输出写入大小.值 = 输入大小
            内存复制 (输出指针, 输入指针, 输入大小)
            返回 (资源过滤器.完成)
        }
        // 注: 两个分支均无条件返回, 此行为预期
    }

    方法 结束 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    {
        如果 (资源地址 != "" && 取字节集长度 (数据缓存) > 0)
        {
            MCP命令服务器.存储响应缓存 (资源地址, 资源MIME, 数据缓存, 取字节集长度 (数据缓存))
        }
        数据缓存.清空字节集 ()
    }
}

# ================================================================
# 手写资源篡改过滤器 — 不依赖VIP官方过滤器, 基于FBrowser资源过滤器(ResponseFilter)事件通道
# 支持: block(屏蔽) / replace_data(数据替换) / replace_file(本地文件替换) / modify(流式内容搜索替换)
# 由 浏览器_获取资源过滤器 事件按URL规则匹配后挂载 (规则文本见 MCP命令服务器.资源替换规则)
# 注: replace_file 经UTF8文本转换, 仅适用于文本类资源(JS/CSS/HTML/JSON等)
# ================================================================

类 类_MCP_篡改过滤器 <公开 基础类 = 类_FBrowser_资源过滤器>
{
    变量 动作 <公开 类型 = 文本型>
    变量 搜索文本 <公开 类型 = 文本型>
    变量 替换文本 <公开 类型 = 文本型>
    变量 尾部文本 <公开 类型 = 文本型>
    变量 尾部字节 <类型 = 字节集类>
    变量 待输出文本 <公开 类型 = 文本型>
    变量 修改已放弃 <公开 类型 = 逻辑型 值 = 假>
    变量 原始数据缓存 <类型 = 字节集类>
    变量 行替换开始 <公开 类型 = 整数>
    变量 行替换结束 <公开 类型 = 整数>
    变量 当前行号 <类型 = 整数 值 = 0>

    方法 初始化过滤器 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    {
        控制台输出 ("[MCP篡改] 初始化 动作=" + 动作)
        返回 (真)
    }

    # 获取数据: 与类_MCP_缓存过滤器同形 (原始数据累积, 保证框架数据通道一致)
    方法 获取数据 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 数据指针 <类型 = 变整数>
    参数 数据大小 <类型 = 整数>
    {
        如果 (取字节集长度 (原始数据缓存) < 4000000)
        {
            添加字节集 (原始数据缓存, 指针到字节集 (数据指针, 数据大小))
        }
    }

    # 吐出一部分待输出文本 (二分定位截断点, O(log n)次编码; 返回真=全部吐完)
    方法 输出待输出文本 <类型 = 逻辑型>
    参数 输出指针 <类型 = 变整数>
    参数 输出大小 <类型 = 整数>
    参数 输出写入大小 <类型 = 整数类>
    {
        如果 (待输出文本 == "")
        {
            输出写入大小.值 = 0
            返回 (真)
        }
        如果 (输出大小 <= 0)
        {
            输出写入大小.值 = 0
            返回 (假)
        }
        变量 尝试文本 <类型 = 文本型>
        尝试文本 = 待输出文本
        变量 尝试字节 <类型 = 字节集类>
        尝试字节 = 文本到UTF8 (尝试文本, 假)
        如果 (取字节集长度 (尝试字节) > 输出大小)
        {
            // 二分定位能完整放下的最大字符数
            变量 低位 <类型 = 整数>
            变量 高位 <类型 = 整数>
            低位 = 1
            高位 = 取文本长度 (尝试文本)
            判断循环 (低位 < 高位)
            {
                变量 中位 <类型 = 整数>
                中位 = (低位 + 高位) / 2
                变量 中位文本 <类型 = 文本型>
                中位文本 = 取文本左边 (尝试文本, 中位)
                变量 中位字节 <类型 = 字节集类>
                中位字节 = 文本到UTF8 (中位文本, 假)
                如果 (取字节集长度 (中位字节) <= 输出大小)
                {
                    低位 = 中位 + 1
                }
                否则
                {
                    高位 = 中位
                }
            }
            低位 = 低位 - 1
            如果 (低位 <= 0)
            {
                // 单个字符都放不下: 不丢弃, 返回假等待更大的输出缓冲
                输出写入大小.值 = 0
                控制台输出 ("[MCP篡改] 输出缓冲过小(" + 到文本 (输出大小) + "字节), 等待下次调用")
                返回 (假)
            }
            尝试文本 = 取文本左边 (尝试文本, 低位)
        }
        变量 输出字节 <类型 = 字节集类>
        输出字节 = 文本到UTF8 (尝试文本, 假)
        内存复制 (输出指针, 取字节集指针 (输出字节), 取字节集长度 (输出字节))
        输出写入大小.值 = 取字节集长度 (输出字节)
        如果 (取文本长度 (尝试文本) < 取文本长度 (待输出文本))
        {
            待输出文本 = 取文本右边 (待输出文本, 取文本长度 (待输出文本) - 取文本长度 (尝试文本))
            返回 (假)
        }
        待输出文本 = ""
        返回 (真)
    }

    # modify放弃替换: 转入透传通道; 冲刷当前已解码文本与字节尾(防末尾3字节丢失)
    方法 转入透传
    参数 透传文本 <类型 = 文本型>
    参数 放弃原因 <类型 = 文本型>
    {
        修改已放弃 = 真
        待输出文本 = 待输出文本 + 透传文本 + UTF8到文本 (尾部字节)
        尾部文本 = ""
        尾部字节.清空字节集 ()
        控制台输出 ("[MCP篡改] modify放弃替换(" + 放弃原因 + "), 转为透传")
    }

    # 修改数据: 统一文本通道; 遵守CEF契约 — 输入大小==0(EOF)时必须返回完成
    方法 修改数据 <公开 类型 = 整数 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 输入指针 <类型 = 变整数>
    参数 输入大小 <类型 = 整数>
    参数 输入读取大小 <类型 = 整数类>
    参数 输出指针 <类型 = 变整数>
    参数 输出大小 <类型 = 整数>
    参数 输出写入大小 <类型 = 整数类>
    {
        // 输出缓冲不可用: 不消费输入不丢弃; EOF时按契约必须完成(剩余截断)
        如果 (输出大小 <= 0)
        {
            输入读取大小.值 = 0
            输出写入大小.值 = 0
            如果 (输入大小 == 0)
            {
                // EOF+零缓冲: 保留待输出等待正常缓冲调用 (不抹除)
                如果 (待输出文本 != "")
                {
                    返回 (资源过滤器.需要更多数据)
                }
                尾部文本 = ""
                返回 (资源过滤器.完成)
            }
            返回 (资源过滤器.需要更多数据)
        }
        // ── 待输出未吐完: 先吐, 不消费输入 ──
        如果 (待输出文本 != "")
        {
            输入读取大小.值 = 0
            输出待输出文本 (输出指针, 输出大小, 输出写入大小)
            如果 (输入大小 == 0)
            {
                如果 (待输出文本 == "")
                {
                    返回 (资源过滤器.完成)
                }
                如果 (输出写入大小.值 == 0)
                {
                    // EOF且输出缓冲异常(无进展): 放弃剩余防无限循环
                    控制台输出 ("[MCP篡改] EOF无进展截断: 待输出剩余 " + 到文本 (取文本长度 (待输出文本)) + " 字符")
                    待输出文本 = ""
                    返回 (资源过滤器.完成)
                }
                // EOF但有进展: 继续排空 (框架会以输入==0再次调用)
            }
            返回 (资源过滤器.需要更多数据)
        }
        // ── EOF最终调用: 并入尾部后收尾 (FBrowser通常不发送此调用, 防御性保留) ──
        如果 (输入大小 == 0)
        {
            输入读取大小.值 = 0
            待输出文本 = 待输出文本 + 尾部文本 + UTF8到文本 (尾部字节)
            尾部字节.清空字节集 ()
            尾部文本 = ""
            如果 (待输出文本 != "")
            {
                输出待输出文本 (输出指针, 输出大小, 输出写入大小)
                如果 (待输出文本 != "")
                {
                    如果 (输出写入大小.值 == 0)
                    {
                        // EOF且输出缓冲异常(无进展): 放弃剩余防无限循环
                        控制台输出 ("[MCP篡改] EOF无进展截断: 待输出剩余 " + 到文本 (取文本长度 (待输出文本)) + " 字符")
                        待输出文本 = ""
                    }
                    否则
                    {
                        // EOF但有进展: 继续排空 (框架会以输入==0再次调用)
                        返回 (资源过滤器.需要更多数据)
                    }
                }
            }
            否则
            {
                输出写入大小.值 = 0
            }
            控制台输出 ("[MCP篡改] 完成 动作=" + 动作 + " 原始输入字节=" + 到文本 (取字节集长度 (原始数据缓存)))
            返回 (资源过滤器.完成)
        }
        // ── 有输入 ──
        // line_replace: 流式即时输出 (FBrowser不发送EOF调用, 输出必须在输入调用期完成; 尾部部分行跨块携带)
        如果 (动作 == "line_replace")
        {
            输入读取大小.值 = 输入大小
            // 修复: UTF-8边界处理 — 与modify分支一致的字节尾机制(保留末尾最多3字节),
            // 防多字节字符被分包切开后解码成替换符导致输出损坏
            变量 行新字节 <类型 = 字节集类>
            行新字节 = 指针到字节集 (输入指针, 输入大小)
            变量 行合并字节 <类型 = 字节集类>
            添加字节集 (行合并字节, 尾部字节)
            添加字节集 (行合并字节, 行新字节)
            变量 行合并总长 <类型 = 整数>
            行合并总长 = 取字节集长度 (行合并字节)
            变量 行完整字节 <类型 = 字节集类>
            行完整字节 = 行合并字节
            尾部字节.清空字节集 ()
            如果 (行合并总长 > 3)
            {
                // 末尾3字节保留到下一块 (完整UTF-8字符最长4字节, 不完整序列最多3字节)
                添加字节集 (尾部字节, 指针到字节集 (取字节集指针 (行合并字节) + (行合并总长 - 3), 3))
                行完整字节 = 指针到字节集 (取字节集指针 (行合并字节), 行合并总长 - 3)
            }
            变量 行处理文本 <类型 = 文本型>
            行处理文本 = 尾部文本 + UTF8到文本 (行完整字节)
            尾部文本 = ""
            // 逐字符扫描: 用已验证count语义的取文本左边/右边 (取文本中间1字符语义存疑)
            变量 行输出 <类型 = 文本型>
            行输出 = ""
            变量 行扫描位置 <类型 = 整数>
            行扫描位置 = 1
            变量 行开始 <类型 = 整数>
            行开始 = 1
            变量 扫描总长 <类型 = 整数>
            扫描总长 = 取文本长度 (行处理文本)
            判断循环 (行扫描位置 <= 扫描总长)
            {
                变量 前缀文本 <类型 = 文本型>
                前缀文本 = 取文本左边 (行处理文本, 行扫描位置)
                如果 (取文本右边 (前缀文本, 1) == "\x0A")
                {
                    当前行号 = 当前行号 + 1
                    变量 行内容 <类型 = 文本型>
                    行内容 = 取文本左边 (行处理文本, 行扫描位置 - 1)
                    行内容 = 取文本右边 (行内容, 取文本长度 (行内容) - 行开始 + 1)
                    // 修复: CRLF资源 — 剥离行尾\r并记录行尾风格, 替换行与未替换行保持一致的换行序列
                    变量 行尾序列 <类型 = 文本型>
                    行尾序列 = "\n"
                    如果 (取文本长度 (行内容) > 0 && 取文本右边 (行内容, 1) == "\x0D")
                    {
                        行尾序列 = "\r\n"
                        行内容 = 取文本左边 (行内容, 取文本长度 (行内容) - 1)
                    }
                    如果 (当前行号 >= 行替换开始 && 当前行号 <= 行替换结束)
                    {
                        如果 (当前行号 == 行替换开始)
                        {
                            行输出 = 行输出 + 替换文本 + 行尾序列
                        }
                    }
                    否则
                    {
                        行输出 = 行输出 + 行内容 + 行尾序列
                    }
                    行开始 = 行扫描位置 + 1
                }
                行扫描位置 = 行扫描位置 + 1
            }
            如果 (行开始 <= 扫描总长)
            {
                变量 尾余文本 <类型 = 文本型>
                尾余文本 = 取文本右边 (行处理文本, 扫描总长 - 行开始 + 1)
                尾部文本 = 尾余文本
            }
            待输出文本 = 待输出文本 + 行输出
            输出待输出文本 (输出指针, 输出大小, 输出写入大小)
            返回 (资源过滤器.需要更多数据)
        }
        // 非modify动作: 替换数据在挂载时已放入待输出文本, 这里仅消费原始输入后完成
        如果 (动作 != "modify")
        {
            输入读取大小.值 = 输入大小
            输出写入大小.值 = 0
            返回 (资源过滤器.完成)
        }
        // 放弃替换: 直接透传输入 (防超大资源被截断)
        如果 (修改已放弃)
        {
            变量 透传大小 <类型 = 整数>
            透传大小 = 选择 (输入大小 > 输出大小, 输出大小, 输入大小)
            内存复制 (输出指针, 输入指针, 透传大小)
            输出写入大小.值 = 透传大小
            输入读取大小.值 = 透传大小
            返回 (资源过滤器.需要更多数据)
        }
        // modify: 流式搜索替换 (字节级尾部拼接 + 文本级搜索尾部, 双尾机制)
        变量 新字节 <类型 = 字节集类>
        新字节 = 指针到字节集 (输入指针, 输入大小)
        输入读取大小.值 = 输入大小
        // 字节尾: 上一块末尾最多3字节(UTF8最大字符4字节)拼回, 防多字节字符跨块被破坏
        变量 合并字节 <类型 = 字节集类>
        添加字节集 (合并字节, 尾部字节)
        添加字节集 (合并字节, 新字节)
        变量 合并总长 <类型 = 整数>
        合并总长 = 取字节集长度 (合并字节)
        变量 完整字节 <类型 = 字节集类>
        完整字节 = 合并字节
        尾部字节.清空字节集 ()
        如果 (合并总长 > 3)
        {
            // 保留末尾3字节作下一块字节尾 (指针算术切片)
            添加字节集 (尾部字节, 指针到字节集 (取字节集指针 (合并字节) + (合并总长 - 3), 3))
            完整字节 = 指针到字节集 (取字节集指针 (合并字节), 合并总长 - 3)
        }
        变量 新文本 <类型 = 文本型>
        新文本 = UTF8到文本 (完整字节)
        变量 合并文本 <类型 = 文本型>
        合并文本 = 尾部文本 + 新文本
        // 输入侧与输出侧双重上限: 高倍率扩容替换防内存爆炸
        如果 (取文本长度 (合并文本) > 4000000)
        {
            转入透传 (合并文本, "输入超限")
        }
        否则
        {
            // 替换前最坏情况预估: 合并文本 × (替换/搜索) 比值, 超限先放弃再做, 防单次替换分配撑爆内存
            变量 预估输出 <类型 = 长整数>
            预估输出 = 取文本长度 (合并文本)
            如果 (搜索文本 != "" && 取文本长度 (替换文本) > 取文本长度 (搜索文本))
            {
                预估输出 = (长整数)取文本长度 (合并文本) * (长整数)取文本长度 (替换文本) / (长整数)取文本长度 (搜索文本)
            }
            如果 (预估输出 > 16000000)
            {
                转入透传 (合并文本, "输出膨胀预估超限")
            }
            否则
            {
                变量 替换后文本 <类型 = 文本型>
                替换后文本 = 合并文本
                如果 (搜索文本 != "")
                {
                    // 区分大小写替换 (对齐VIP字节级替换语义; URL匹配保持不区分)
                    子文本替换 (替换后文本, 搜索文本, 替换文本, , , 真)
                }
                // 输出侧上限: 替换后积压超限同样放弃透传
                如果 (取文本长度 (替换后文本) + 取文本长度 (待输出文本) > 4000000)
                {
                    转入透传 (合并文本, "输出膨胀超限")
                }
                否则
                {
                    // 尾部保留 搜索文本长度-1 字符, 供下一块跨块匹配
                    如果 (取文本长度 (搜索文本) > 1)
                    {
                        变量 尾长 <类型 = 整数>
                        尾长 = 取文本长度 (搜索文本) - 1
                        如果 (取文本长度 (替换后文本) >= 尾长)
                        {
                            尾部文本 = 取文本右边 (替换后文本, 尾长)
                            替换后文本 = 取文本左边 (替换后文本, 取文本长度 (替换后文本) - 尾长)
                        }
                        否则
                        {
                            尾部文本 = 替换后文本
                            替换后文本 = ""
                        }
                    }
                    待输出文本 = 待输出文本 + 替换后文本
                }
            }
        }
        // 处理后立即尝试吐出
        输出待输出文本 (输出指针, 输出大小, 输出写入大小)
        返回 (资源过滤器.需要更多数据)
    }

    方法 结束 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    {
        尾部文本 = ""
        尾部字节.清空字节集 ()
        待输出文本 = ""
    }
}
