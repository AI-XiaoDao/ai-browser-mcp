<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# ================================================================
# MCP回调类 — JS异步/字符串/截图/Cookie/DevTools/文件对话框/PDF/任务/VIP/URL/清理缓存/下载图片
# 被 MCP_Server.wsv 和 main.wsv 引用
# ================================================================

类 类_MCP_JS异步回调 <公开 基础类 = 类_FBrowser_JS回调>
{
    变量 任务ID <公开 类型 = 文本型>

    方法 回调 <公开 @虚拟方法 = 可覆盖>
    参数 返回结果 <类型 = 类_FBrowser_列表值>
    {
        变量 结果文本 <类型 = 文本型>
        变量 返回值类型 <类型 = 整数 值 = JS返回值类型.无效>
        如果 (返回结果.是否有效 ())
        {
            返回值类型 = 返回结果.取整数值 (1)
            // JS返回值类型: 无效=-1 空值=0 整数值=1 文本值=2 逻辑值=3 双精度小数=4 时间文本=5 数组=6 数组缓存=7 方法=8 类=9
            如果 (返回值类型 == JS返回值类型.文本值)
            {
                结果文本 = 返回结果.取文本值 (2)
            }
            否则 (返回值类型 == JS返回值类型.逻辑值)
            {
                结果文本 = 到文本 (返回结果.取逻辑值 (2))
            }
            否则 (返回值类型 == JS返回值类型.整数值)
            {
                结果文本 = 到文本 (返回结果.取整数值 (2))
            }
            否则 (返回值类型 == JS返回值类型.双精度小数值)
            {
                结果文本 = 到文本 (返回结果.取双精度小数值 (2))
            }
            否则 (返回值类型 == JS返回值类型.空值)
            {
                结果文本 = "null"
            }
            否则 (返回值类型 == JS返回值类型.无效)
            {
                // V8无法序列化此返回值 (如DOM对象/函数/循环引用)
                // 尝试提取文本描述替代报错
                结果文本 = 返回结果.取文本值 (1)
                如果 (结果文本 == "")
                {
                    // 两种典型成因: ①JS返回不可序列化值 ②原生填表API目标不存在/类型不符(如对非select元素取选择项)
                    结果文本 = "[无法序列化的值] 可能原因: ①JS返回了DOM对象/函数等(建议JSON.stringify()包裹) ②原生API目标元素不存在或类型不符(请检查selector与元素类型)"
                }
            }
            否则 (返回值类型 == JS返回值类型.时间文本值)
            {
                结果文本 = 返回结果.取文本值 (2)
            }
            否则 (返回值类型 == JS返回值类型.数组值 || 返回值类型 == JS返回值类型.数组缓存值)
            {
                结果文本 = "[array]"
            }
            否则 (返回值类型 == JS返回值类型.方法值 || 返回值类型 == JS返回值类型.类值)
            {
                结果文本 = "[function]"
            }
            否则
            {
                // 未知的返回值类型 (未来CEF版本可能新增) — 尝试文本提取
                结果文本 = 返回结果.取文本值 (1)
                如果 (结果文本 == "")
                {
                    结果文本 = "[未知类型:" + 到文本 (返回值类型) + "] 请联系开发者更新回调处理"
                }
            }
        }
        否则
        {
            结果文本 = "JS回调未返回有效结果 | 可能原因: 执行超时/V8环境不可用/跨域限制"
        }
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        如果 (返回值类型 == JS返回值类型.无效)
        {
            包装对象.加入逻辑值成员 ("success", 假)
            包装对象.加入文本成员 ("error", 结果文本)
        }
        否则
        {
            变量 语义失败 <类型 = 逻辑型 值 = 假>
            如果 (MCP命令服务器.JS消息是否表示失败 (结果文本, ""))
            {
                语义失败 = 真
            }
            如果 (语义失败)
            {
                包装对象.加入逻辑值成员 ("success", 假)
                包装对象.加入文本成员 ("error", 结果文本)
            }
            否则
            {
                包装对象.加入逻辑值成员 ("success", 真)
                包装对象.加入文本成员 ("message", 结果文本)
            }
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

# 元素存在后点击回调: browser_dom_click 原生链路 (存在检查→点击)

类 类_MCP_存在后点击回调 <公开 基础类 = 类_FBrowser_JS回调>
{
    变量 任务ID <公开 类型 = 文本型>
    变量 浏览器ID <公开 类型 = 整数>
    变量 选择器文本 <公开 类型 = 文本型>

    方法 回调 <公开 @虚拟方法 = 可覆盖>
    参数 返回结果 <类型 = 类_FBrowser_列表值>
    {
        变量 存在 <类型 = 逻辑型 值 = 假>
        如果 (返回结果.是否有效 ())
        {
            变量 返回值类型 <类型 = 整数>
            返回值类型 = 返回结果.取整数值 (1)
            如果 (返回值类型 == JS返回值类型.逻辑值)
            {
                存在 = 返回结果.取逻辑值 (2)
            }
        }
        变量 已点击 <类型 = 逻辑型 值 = 假>
        如果 (存在)
        {
            变量 bb <类型 = 类_FBrowser_浏览器>
            bb = FBrowser_浏览器_通过ID取浏览器 (浏览器ID)
            如果 (bb.是否为空 () == 假)
            {
                变量 ff <类型 = 类_FBrowser_填表框架>
                ff = bb.取主填表框架 ()
                如果 (ff.是否有效 ())
                {
                    ff.点击元素 (选择器文本, 0)
                    已点击 = 真
                }
            }
        }
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 已点击)
        如果 (已点击)
        {
            包装对象.加入文本成员 ("message", "已点击(原生): " + 选择器文本)
        }
        否则 (存在)
        {
            包装对象.加入文本成员 ("error", "element found but browser closed or fill frame invalid: " + 选择器文本)
        }
        否则
        {
            包装对象.加入文本成员 ("error", "element not found: " + 选择器文本)
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

# 存在后填表回调 — 元素存在后按操作类型执行 (set_value/click/focus/scroll/attr_set/trigger/select/set_html)

类 类_MCP_存在后填表回调 <公开 基础类 = 类_FBrowser_JS回调>
{
    变量 任务ID <公开 类型 = 文本型>
    变量 浏览器ID <公开 类型 = 整数>
    变量 选择器文本 <公开 类型 = 文本型>
    变量 操作类型 <公开 类型 = 文本型>
    变量 操作值 <公开 类型 = 文本型>
    变量 属性名 <公开 类型 = 文本型>
    变量 事件类型 <公开 类型 = 文本型>

    方法 回调 <公开 @虚拟方法 = 可覆盖>
    参数 返回结果 <类型 = 类_FBrowser_列表值>
    {
        变量 存在 <类型 = 逻辑型 值 = 假>
        变量 已执行 <类型 = 逻辑型 值 = 假>
        如果 (返回结果.是否有效 ())
        {
            变量 返回值类型 <类型 = 整数>
            返回值类型 = 返回结果.取整数值 (1)
            如果 (返回值类型 == JS返回值类型.逻辑值)
            {
                存在 = 返回结果.取逻辑值 (2)
            }
        }
        如果 (存在)
        {
            变量 bb <类型 = 类_FBrowser_浏览器>
            bb = FBrowser_浏览器_通过ID取浏览器 (浏览器ID)
            如果 (bb.是否为空 () == 假)
            {
                变量 ff <类型 = 类_FBrowser_填表框架>
                ff = bb.取主填表框架 ()
                如果 (ff.是否有效 ())
                {
                    如果 (操作类型 == "set_value")
                    {
                        已执行 = 真
                        // 优先原生 setter + 完整输入事件链, 框架无效时回退置元素内容
                        变量 svFrame <类型 = 类_FBrowser_框架>
                        svFrame = bb.取主框架 ()
                        如果 (svFrame.是否为空 () == 假 && svFrame.是否有效 ())
                        {
                            变量 svSel <类型 = 文本型>
                            svSel = MCP命令服务器.简单转义JS (选择器文本)
                            变量 svVal <类型 = 文本型>
                            svVal = MCP命令服务器.简单转义JS (操作值)
                            svFrame.执行JS代码 ("(function(){var e=document.querySelector('" + svSel + "');if(e){try{e.focus();var n=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value');if(n&&n.set)n.set.call(e,'" + svVal + "');else e.value='" + svVal + "';e.dispatchEvent(new KeyboardEvent('keydown',{bubbles:true,cancelable:true}));e.dispatchEvent(new Event('beforeinput',{bubbles:true,cancelable:true}));e.dispatchEvent(new InputEvent('input',{bubbles:true,cancelable:true,inputType:'insertText',data:'" + svVal + "'}));e.dispatchEvent(new KeyboardEvent('keyup',{bubbles:true,cancelable:true}));e.dispatchEvent(new Event('change',{bubbles:true,cancelable:true}));}catch(x){e.value='" + svVal + "';e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));}})()", "", 0)
                        }
                        否则
                        {
                            ff.置元素内容 (选择器文本, 0, 操作值)
                        }
                    }
                    否则 (操作类型 == "click")
                    {
                        已执行 = 真
                        ff.点击元素 (选择器文本, 0)
                    }
                    否则 (操作类型 == "focus")
                    {
                        已执行 = 真
                        ff.置元素焦点 (选择器文本, 0, 真)
                    }
                    否则 (操作类型 == "scroll")
                    {
                        已执行 = 真
                        ff.滚动到元素 (选择器文本, 0, 真)
                    }
                    否则 (操作类型 == "attr_set")
                    {
                        已执行 = 真
                        // 属性设置走原生 setAttribute, 框架无效时回退置元素属性
                        变量 asFrame <类型 = 类_FBrowser_框架>
                        asFrame = bb.取主框架 ()
                        如果 (asFrame.是否为空 () == 假 && asFrame.是否有效 ())
                        {
                            变量 asSel <类型 = 文本型>
                            asSel = MCP命令服务器.简单转义JS (选择器文本)
                            变量 asAttr <类型 = 文本型>
                            asAttr = MCP命令服务器.简单转义JS (属性名)
                            变量 asVal <类型 = 文本型>
                            asVal = MCP命令服务器.简单转义JS (操作值)
                            asFrame.执行JS代码 ("(function(){var e=document.querySelector('" + asSel + "');if(e){e.setAttribute('" + asAttr + "','" + asVal + "');}})()", "", 0)
                        }
                        否则
                        {
                            ff.置元素属性 (选择器文本, 0, 属性名, 操作值)
                        }
                    }
                    否则 (操作类型 == "trigger")
                    {
                        已执行 = 真
                        变量 evt <类型 = 文本型>
                        evt = 事件类型
                        如果 (evt == "")
                        {
                            evt = "click"
                        }
                        ff.触发元素事件 (选择器文本, 0, evt, 0)
                    }
                    否则 (操作类型 == "select_index")
                    {
                        已执行 = 真
                        // 下拉选择项: 操作值为整数索引 (置元素选择项 官方API)
                        变量 selIdx <类型 = 整数>
                        selIdx = 文本到整数 (操作值)
                        如果 (selIdx < 0)
                        {
                            selIdx = 0
                        }
                        ff.置元素选择项 (选择器文本, 0, selIdx)
                    }
                    否则 (操作类型 == "select")
                    {
                        已执行 = 真
                        变量 选择状态 <类型 = 逻辑型>
                        选择状态 = 真
                        变量 valLower <类型 = 文本型>
                        valLower = 到小写 (删首尾空 (操作值))
                        如果 (valLower == "false" || valLower == "0" || valLower == "off" || valLower == "no" || valLower == "unchecked" || valLower == "unselected")
                        {
                            选择状态 = 假
                        }
                        ff.置元素选择框 (选择器文本, 0, 选择状态)
                    }
                    否则 (操作类型 == "set_html")
                    {
                        已执行 = 真
                        // innerHTML 走原生赋值, 框架无效时回退置元素内代码
                        变量 shFrame <类型 = 类_FBrowser_框架>
                        shFrame = bb.取主框架 ()
                        如果 (shFrame.是否为空 () == 假 && shFrame.是否有效 ())
                        {
                            变量 shSel <类型 = 文本型>
                            shSel = MCP命令服务器.简单转义JS (选择器文本)
                            变量 shVal <类型 = 文本型>
                            shVal = MCP命令服务器.简单转义JS (操作值)
                            shFrame.执行JS代码 ("(function(){var e=document.querySelector('" + shSel + "');if(e){e.innerHTML='" + shVal + "';}})()", "", 0)
                        }
                        否则
                        {
                            ff.置元素内代码 (选择器文本, 0, 操作值)
                        }
                    }
                }
            }
        }
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        // 修复: success 绑定"操作真正执行"而非"元素存在"; 存在但浏览器关闭/填表框架无效时如实报error
        如果 (已执行)
        {
            包装对象.加入逻辑值成员 ("success", 真)
            包装对象.加入文本成员 ("message", "已执行(" + 操作类型 + "): " + 选择器文本)
        }
        否则
        {
            包装对象.加入逻辑值成员 ("success", 假)
            如果 (存在)
            {
                包装对象.加入文本成员 ("error", "element found but browser closed or fill frame invalid: " + 选择器文本)
            }
            否则
            {
                包装对象.加入文本成员 ("error", "element not found: " + 选择器文本)
            }
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

类 类_MCP_字符串异步回调 <公开 基础类 = 类_FBrowser_字符串回调>
{
    变量 任务ID <公开 类型 = 文本型>
    变量 最大字符数 <公开 类型 = 整数 值 = MCP_常量.截断_响应文本最大字符 注释 = "回调侧mcp_result载荷上限(256KB), 与工具描述一致; 与 MCP_常量.截断_源码默认字节(512KB) 为不同层级, 勿混淆">

    方法 回调 <公开 @虚拟方法 = 可覆盖>
    参数 文本 <类型 = 文本型>
    {
        变量 输出文本 <类型 = 文本型>
        输出文本 = 文本
        变量 原始长度 <类型 = 整数>
        原始长度 = 取文本长度 (文本)
        // 防止大源码撑爆mcp_result响应导致curl传输失败
        如果 (原始长度 > 最大字符数)
        {
            输出文本 = 取文本左边 (文本, 最大字符数) + "...\n\n[MCP: 源码已截断, 原始大小=" + 到文本 (原始长度) + " 字节, 截断至=" + 到文本 (最大字符数) + "]"
            控制台输出 (到文本 ("[MCP] 源码截断:") + ", " + 到文本 (原始长度) + ", " + 到文本 ("->") + ", " + 到文本 (最大字符数))
        }
        变量 包装对象 <类型 = YYJSON对象类>
        包装对象.创建自文本 ("{}")
        包装对象.加入逻辑值成员 ("success", 真)
        包装对象.加入文本成员 ("message", 输出文本)
        如果 (原始长度 > 最大字符数)
        {
            包装对象.加入整数成员 ("truncated", 原始长度)
            包装对象.加入整数成员 ("truncated_to", 最大字符数)
        }
        MCP命令服务器.存储异步结果 (任务ID, 包装对象.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

# ================================================================
# 步回调类
# ================================================================
# ================================================================
# 截图异步回调 (VIP)
# ================================================================

类 类_MCP_截图异步回调 <公开 基础类 = 类_FBrowserVIP_通用回调>
{
    变量 任务ID <公开 类型 = 文本型>
    变量 图片格式 <公开 类型 = 文本型 值 = "png">

    方法 数据回调 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 标识ID <类型 = 整数>
    参数 成功 <类型 = 逻辑型>
    参数 数据指针 <类型 = 变整数>
    参数 数据大小 <类型 = 整数>
    {
        如果 (成功 && 数据指针 != 0 && 数据大小 > 0)
        {
            变量 字节数据 <类型 = 字节集类>
            字节数据 = 指针到字节集 (数据指针, 数据大小)
            变量 结果JSON <类型 = 文本型>
            结果JSON = MCP_响应构建.构建Base64图片异步JSON (字节数据, "image/" + 图片格式, 数据大小)
            MCP命令服务器.存储异步结果 (任务ID, 结果JSON)
        }
        否则
        {
            MCP命令服务器.存储异步结果 (任务ID, MCP_响应构建.构建标准失败JSON ("截图失败"))
        }
    }

    #
}

# ================================================================
# Cookie收集回调 — 纯异步 (官方 FBrowser Cookie API)
# ================================================================

类 类_MCP_Cookie收集回调 <公开 基础类 = 类_FBrowser_Cookie回调>
{
    变量 Cookie列表JSON <类型 = 文本型 值 = "[">
    变量 首项 <类型 = 逻辑型 值 = 真>
    变量 最大项数 <公开 类型 = 整数 值 = MCP_常量.Cookie默认项数>
    变量 异步任务ID <公开 类型 = 文本型 值 = "">
    变量 当前总数 <类型 = 整数 值 = 0 注释 = "缓存访问()中的总数参数, 供结束()使用">

    方法 开始 <公开 @虚拟方法 = 可覆盖>
    {
        Cookie列表JSON = "["
        首项 = 真
    }

    方法 访问 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 Cookie数据 <类型 = FBrowser_Cookie数据>
    参数 当前项 <类型 = 整数>
    参数 总数 <类型 = 整数>
    参数 删除当前cookie <类型 = 逻辑型类>
    {
        当前总数 = 总数
        如果 (当前项 >= 最大项数)
        {
            返回 (假)
        }
        变量 项JSON <类型 = YYJSON对象类>
        项JSON.创建自文本 ("{}")
        项JSON.加入文本成员 ("name", Cookie数据.名)
        项JSON.加入文本成员 ("value", Cookie数据.值)
        项JSON.加入文本成员 ("domain", Cookie数据.域)
        项JSON.加入文本成员 ("path", Cookie数据.路径)
        项JSON.加入逻辑值成员 ("http_only", Cookie数据.是否只有http)
        如果 (Cookie数据.是否有过期时间)
        {
            项JSON.加入逻辑值成员 ("has_expires", 真)
        }
        如果 (首项)
        {
            Cookie列表JSON = Cookie列表JSON + 项JSON.到可读文本 (YYJSON格式化选项.压缩)
            首项 = 假
        }
        否则
        {
            Cookie列表JSON = Cookie列表JSON + "," + 项JSON.到可读文本 (YYJSON格式化选项.压缩)
        }
        返回 (真)
    }

    方法 结束 <公开 @虚拟方法 = 可覆盖>
    {
        Cookie列表JSON = Cookie列表JSON + "]"
        变量 结果包装 <类型 = YYJSON对象类>
        结果包装.创建自文本 ("{}")
        结果包装.加入逻辑值成员 ("success", 真)
        结果包装.加入文本成员 ("message", Cookie列表JSON)
        结果包装.加入整数成员 ("total", 当前总数)
        如果 (当前总数 > 最大项数)
        {
            结果包装.加入逻辑值成员 ("truncated", 真)
            结果包装.加入整数成员 ("truncated_to", 最大项数)
        }
        MCP命令服务器.存储异步结果 (异步任务ID, 结果包装.到可读文本 (YYJSON格式化选项.压缩))
    }

    #
}

# ================================================================
# DevTools消息观察者 — 解决CDP结果不回传的核心类
# 使用姿势: 注册到VIP控制器的开发者消息_启用监管者事件中
# ================================================================

类 类_MCP_DevTools观察者 <公开 基础类 = 类_FBrowser_开发者消息事件>
{
    方法 开发者消息_VIP_收到消息 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 消息指针 <类型 = 变整数>
    参数 消息大小 <类型 = 整数>
    {
        如果 (消息大小 > 0 && 消息指针 != 0)
        {
            变量 消息UTF8 <类型 = 字节集类>
            消息UTF8 = 指针到字节集 (消息指针, 消息大小)
            变量 消息文本 <类型 = 文本型>
            消息文本 = UTF8到文本 (消息UTF8)
            MCP命令服务器.处理DevTools原始消息 (消息文本)
        }
        返回 (假)
    }

    方法 开发者消息_VIP_执行完成 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 消息ID <类型 = 整数>
    参数 成功 <类型 = 逻辑型>
    参数 结果指针 <类型 = 变整数>
    参数 结果大小 <类型 = 整数>
    {
        // 关键! CDP结果到达时自动存入MCP异步结果缓存
        MCP命令服务器.处理CDP响应 (消息ID, 成功, 结果指针, 结果大小)
    }

    方法 开发者消息_VIP_收到事件 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 方法名 <类型 = 文本型>
    参数 参数指针 <类型 = 变整数>
    参数 参数大小 <类型 = 整数>
    {
        // CDP事件(如Debugger.paused, Network.requestWillBeSent)也存入缓存
        // 事件键名为 \"cdp_event:方法名\"
        变量 事件文本 <类型 = 文本型>
        如果 (参数大小 > 0 && 参数指针 != 0)
        {
            变量 事件UTF8 <类型 = 字节集类>
            事件UTF8 = 指针到字节集 (参数指针, 参数大小)
            事件文本 = UTF8到文本 (事件UTF8)
        }
        否则
        {
            事件文本 = "{}"
        }
        MCP命令服务器.存储CDPDevTools事件 (方法名, 事件文本)
    }

    #
}

# ================================================================
# 文件对话框回调 — 参照样例 browser_callback.wsv: 类_FBrowser_打开文件对话框回调
