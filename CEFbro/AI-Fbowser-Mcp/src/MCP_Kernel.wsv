<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# ================================================================
# MCP_内核分派 — 浏览器内核层面能力扩展 (FBrowser CEF 内核 API)
# 工具: browser_kernel_cert    — 证书错误收集/忽略开关
#       browser_kernel_auth    — HTTP 认证凭据注入 (Basic/Digest)
#       browser_kernel_download— 下载暂停/恢复/取消 (事件内即时执行)
#       browser_kernel_scheme  — 自定义协议方案 (mcp:// 资源响应)
#       browser_kernel_menu    — 右键快捷菜单屏蔽
# 事件接线: MCP_BrowserEvents.wsv (证书错误/认证/下载/快捷菜单)
# 初始化期: main.wsv 注册自定义方案 "mcp" (CEF 要求初始化前声明)
# 路由: MCP_Server.wsv 执行浏览器命令 前缀直投 browser_kernel_
# 依据: FBrowser浏览器 类库官方签名 (FBroLib / FBroEventControl / FBroCallback)
# ================================================================

类 MCP_内核分派 <公开 @全局类 = 真>
{

    # ── 证书错误 (浏览器_请求证书错误 事件) ──

    变量 忽略证书错误 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "为真时证书错误自动继续并放行">
    变量 证书错误条目 <公开 静态 类型 = 文本数组类 注释 = "JSON 行: {time_ms,error_code,url,browser_id}">
    变量 证书错误锁 <公开 静态 类型 = 互斥锁类 注释 = "CEF主进程事件线程写 / MCP线程读">

    # ── HTTP 认证凭据 (浏览器_获得需授权证书 事件) ──

    变量 认证凭据键 <公开 静态 类型 = 文本数组类 注释 = "host:port[:realm] 键">
    变量 认证凭据用户 <公开 静态 类型 = 文本数组类>
    变量 认证凭据密码 <公开 静态 类型 = 文本数组类>
    变量 认证凭据锁 <公开 静态 类型 = 互斥锁类>

    # ── 下载控制 (浏览器_正在下载 事件内即时执行) ──

    变量 待执行下载操作 <公开 静态 类型 = 文本数组类 注释 = "JSON: {action,url,id} 待执行队列">
    变量 下载操作锁 <公开 静态 类型 = 互斥锁类>

    # ── 快捷菜单 (浏览器_即将运行快捷菜单 事件) ──

    变量 屏蔽快捷菜单 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "为真时屏蔽右键快捷菜单(触发条件以实际内核为准)">

    # ── 自定义方案 (FBrowser_自定义方案_注册 + 类_MCP_方案资源处理器) ──

    变量 方案内容键 <公开 静态 类型 = 文本数组类 注释 = "scheme://domain 键">
    变量 方案内容值 <公开 静态 类型 = 文本数组类 注释 = "JSON: {mime, body}">
    变量 方案内容锁 <公开 静态 类型 = 互斥锁类 注释 = "MCP线程写 / CEF资源处理线程读">

    # ============================================================
    # 分类分派: browser_kernel_*
    # ============================================================

    方法 分类分派_内核操作 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 方法名 <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        如果 (方法名 == "browser_kernel_cert")
        {
            返回 (分派_证书管理 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_auth")
        {
            返回 (分派_认证管理 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_download")
        {
            返回 (分派_下载管理 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_scheme")
        {
            返回 (分派_方案管理 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_menu")
        {
            返回 (分派_菜单管理 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_ipc_queue" || 方法名 == "browser_kernel_ipc_clear")
        {
            返回 (分派_IPC队列 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_cdp_monitor")
        {
            返回 (分派_CDP监控 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reactor")
        {
            返回 (分派_反应器 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_watch")
        {
            返回 (分派_定时监视 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_events_all")
        {
            返回 (分派_全事件流 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_probe")
        {
            返回 (分派_动态探针 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_trace")
        {
            返回 (分派_调用追踪 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_algo")
        {
            返回 (分派_算法Hook (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_functions")
        {
            返回 (分派_函数提取 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_sources")
        {
            返回 (分派_源码提取 (命令ID, 参数JSON))
        }
        否则 (方法名 == "browser_kernel_reverse_watch_global")
        {
            返回 (分派_全局变量追踪 (命令ID, 参数JSON))
        }
        返回 ("")
    }

    # ==================== 证书管理 ====================

    方法 分派_证书管理 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "ignore")
        {
            忽略证书错误 = 真
            返回 (MCP_响应构建.命令成功 (命令ID, "已开启忽略证书错误(所有证书错误自动放行跳转)"))
        }
        否则 (动作 == "ignore_off" || 动作 == "off")
        {
            忽略证书错误 = 假
            返回 (MCP_响应构建.命令成功 (命令ID, "已关闭忽略证书错误"))
        }
        否则 (动作 == "clear")
        {
            证书错误锁.加锁 ()
            证书错误条目 = MCP命令服务器.取空文本数组 ()
            证书错误锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "证书错误记录已清空"))
        }
        否则 (动作 == "status")
        {
            变量 st <类型 = YYJSON对象类>
            st.创建自文本 ("{}")
            st.加入逻辑值成员 ("ignore_errors", 忽略证书错误)
            st.加入整数成员 ("recorded", 证书错误条目.取成员数 ())
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, st.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // 默认 list: 返回全部记录
        证书错误锁.加锁 ()
        变量 结果 <类型 = 文本型>
        结果 = "["
        变量 首项 <类型 = 逻辑型 值 = 真>
        计次循环 (证书错误条目.取成员数 ())
        {
            如果 (首项)
            {
                首项 = 假
            }
            否则
            {
                结果 = 结果 + ","
            }
            结果 = 结果 + 证书错误条目.取成员 (取循环索引 ())
        }
        结果 = 结果 + "]"
        证书错误锁.解锁 ()
        变量 包 <类型 = YYJSON对象类>
        包.创建自文本 ("{}")
        包.加入逻辑值成员 ("success", 真)
        包.加入逻辑值成员 ("ignore_errors", 忽略证书错误)
        包.加入文本成员 ("errors", 结果)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ==================== HTTP 认证凭据 ====================

    方法 分派_认证管理 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "set")
        {
            变量 主机 <类型 = 文本型>
            主机 = MCP命令服务器.yyjson取文本 (参数JSON, "host")
            如果 (主机 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "host 不能为空 | 例: example.com"))
            }
            变量 端口 <类型 = 整数>
            端口 = MCP命令服务器.yyjson取整数 (参数JSON, "port")
            如果 (端口 <= 0)
            {
                端口 = 443
            }
            变量 域名 <类型 = 文本型>
            域名 = MCP命令服务器.yyjson取文本 (参数JSON, "realm")
            变量 用户名 <类型 = 文本型>
            用户名 = MCP命令服务器.yyjson取文本 (参数JSON, "username")
            变量 密码 <类型 = 文本型>
            密码 = MCP命令服务器.yyjson取文本 (参数JSON, "password")
            变量 键 <类型 = 文本型>
            键 = 主机 + ":" + 到文本 (端口)
            如果 (域名 != "")
            {
                键 = 键 + ":" + 域名
            }
            认证凭据锁.加锁 ()
            变量 已更新 <类型 = 逻辑型 值 = 假>
            计次循环 (认证凭据键.取成员数 ())
            {
                如果 (认证凭据键.取成员 (取循环索引 ()) == 键)
                {
                    数组置成员 (认证凭据用户, 取循环索引 (), 用户名)
                    数组置成员 (认证凭据密码, 取循环索引 (), 密码)
                    已更新 = 真
                    跳出循环
                }
            }
            如果 (已更新 == 假)
            {
                认证凭据键.加入成员 (键)
                认证凭据用户.加入成员 (用户名)
                认证凭据密码.加入成员 (密码)
            }
            认证凭据锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "认证凭据已设置: " + 主机 + ":" + 到文本 (端口)))
        }
        否则 (动作 == "clear")
        {
            变量 清除主机 <类型 = 文本型>
            清除主机 = MCP命令服务器.yyjson取文本 (参数JSON, "host")
            如果 (清除主机 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "host 不能为空"))
            }
            变量 清除端口 <类型 = 整数>
            清除端口 = MCP命令服务器.yyjson取整数 (参数JSON, "port")
            如果 (清除端口 <= 0)
            {
                清除端口 = 443
            }
            变量 清除键 <类型 = 文本型>
            清除键 = 清除主机 + ":" + 到文本 (清除端口)
            认证凭据锁.加锁 ()
            变量 清除索引 <类型 = 整数 值 = -1>
            计次循环 (认证凭据键.取成员数 ())
            {
                如果 (是否以 (认证凭据键.取成员 (取循环索引 ()), 清除键))
                {
                    清除索引 = 取循环索引 ()
                    跳出循环
                }
            }
            如果 (清除索引 != -1)
            {
                认证凭据键.删除成员 (清除索引)
                认证凭据用户.删除成员 (清除索引)
                认证凭据密码.删除成员 (清除索引)
            }
            认证凭据锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "认证凭据已清除: " + 清除主机))
        }
        否则 (动作 == "list")
        {
            认证凭据锁.加锁 ()
            变量 列表 <类型 = 文本型>
            列表 = "["
            变量 首 <类型 = 逻辑型 值 = 真>
            计次循环 (认证凭据键.取成员数 ())
            {
                如果 (首)
                {
                    首 = 假
                }
                否则
                {
                    列表 = 列表 + ","
                }
                变量 条目 <类型 = YYJSON对象类>
                条目.创建自文本 ("{}")
                条目.加入文本成员 ("host_port", 认证凭据键.取成员 (取循环索引 ()))
                条目.加入文本成员 ("username", 认证凭据用户.取成员 (取循环索引 ()))
                列表 = 列表 + 条目.到可读文本 (YYJSON格式化选项.压缩)
            }
            列表 = 列表 + "]"
            认证凭据锁.解锁 ()
            返回 (MCP_响应构建.构建简单JSON ("credentials", 列表))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 set/clear/list"))
    }

    # ==================== 下载控制 ====================

    方法 分派_下载管理 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "pause" || 动作 == "resume" || 动作 == "cancel")
        {
            // 排队: 由 浏览器_正在下载 事件在下次回调时即时执行
            变量 匹配URL <类型 = 文本型>
            匹配URL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            变量 匹配ID <类型 = 文本型>
            匹配ID = MCP命令服务器.yyjson取文本 (参数JSON, "download_id")
            如果 (匹配URL == "" && 匹配ID == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "url 或 download_id 必填其一 | 先用 action=list 查看进行中的下载"))
            }
            变量 操作条目 <类型 = YYJSON对象类>
            操作条目.创建自文本 ("{}")
            操作条目.加入文本成员 ("action", 动作)
            操作条目.加入文本成员 ("url", 匹配URL)
            操作条目.加入文本成员 ("id", 匹配ID)
            下载操作锁.加锁 ()
            待执行下载操作.加入成员 (操作条目.到可读文本 (YYJSON格式化选项.压缩))
            下载操作锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "下载" + 动作 + "已排队, 将在下次下载进度回调时执行"))
        }
        否则 (动作 == "clear_queue")
        {
            下载操作锁.加锁 ()
            待执行下载操作 = MCP命令服务器.取空文本数组 ()
            下载操作锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "待执行下载操作队列已清空"))
        }
        // 默认 list: 返回待执行队列
        变量 快照列表 <类型 = 文本型>
        快照列表 = "["
        变量 快照首 <类型 = 逻辑型 值 = 真>
        下载操作锁.加锁 ()
        计次循环 (待执行下载操作.取成员数 ())
        {
            如果 (快照首)
            {
                快照首 = 假
            }
            否则
            {
                快照列表 = 快照列表 + ","
            }
            快照列表 = 快照列表 + 待执行下载操作.取成员 (取循环索引 ())
        }
        下载操作锁.解锁 ()
        快照列表 = 快照列表 + "]"
        变量 包 <类型 = YYJSON对象类>
        包.创建自文本 ("{}")
        包.加入逻辑值成员 ("success", 真)
        包.加入文本成员 ("note", "下载进度请用 browser_event 查询 download_progress; 暂停/恢复/取消经本队列在下一次进度回调时即时执行")
        包.加入文本成员 ("pending_ops", 快照列表)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ==================== 自定义方案 ====================

    方法 分派_方案管理 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "register")
        {
            变量 域名 <类型 = 文本型>
            域名 = MCP命令服务器.yyjson取文本 (参数JSON, "domain")
            如果 (域名 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "domain 不能为空 | 访问形式: mcp://域名/任意路径"))
            }
            变量 mime <类型 = 文本型>
            mime = MCP命令服务器.yyjson取文本 (参数JSON, "mime")
            如果 (mime == "")
            {
                mime = "text/html"
            }
            变量 body <类型 = 文本型>
            body = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (body == "" && 文件是否存在 (MCP命令服务器.yyjson取文本 (参数JSON, "file")))
            {
                body = 读入文本文件 (MCP命令服务器.yyjson取文本 (参数JSON, "file"))
            }
            变量 键 <类型 = 文本型>
            键 = "mcp://" + 域名
            变量 内容对象 <类型 = YYJSON对象类>
            内容对象.创建自文本 ("{}")
            内容对象.加入文本成员 ("mime", mime)
            内容对象.加入文本成员 ("body", body)
            方案内容锁.加锁 ()
            变量 方案已更新 <类型 = 逻辑型 值 = 假>
            计次循环 (方案内容键.取成员数 ())
            {
                如果 (方案内容键.取成员 (取循环索引 ()) == 键)
                {
                    数组置成员 (方案内容值, 取循环索引 (), 内容对象.到可读文本 (YYJSON格式化选项.压缩))
                    方案已更新 = 真
                    跳出循环
                }
            }
            如果 (方案已更新 == 假)
            {
                方案内容键.加入成员 (键)
                方案内容值.加入成员 (内容对象.到可读文本 (YYJSON格式化选项.压缩))
            }
            方案内容锁.解锁 ()
            // 挂载资源处理器 (运行期注册 handler factory; 方案名 mcp 已在初始化期声明)
            变量 处理器 <类型 = 类_FBrowser_事件智能指针>
            处理器.创建 (类_MCP_方案资源处理器)
            FBrowser_自定义方案_注册 ("mcp", 域名, 处理器)
            返回 (MCP_响应构建.命令成功 (命令ID, "自定义方案已注册: mcp://" + 域名 + " (mime=" + mime + ", " + 到文本 (取文本长度 (body)) + "字符)"))
        }
        否则 (动作 == "unregister")
        {
            变量 解除域名 <类型 = 文本型>
            解除域名 = MCP命令服务器.yyjson取文本 (参数JSON, "domain")
            变量 解除键 <类型 = 文本型>
            解除键 = "mcp://" + 解除域名
            方案内容锁.加锁 ()
            变量 解除索引 <类型 = 整数 值 = -1>
            计次循环 (方案内容键.取成员数 ())
            {
                如果 (方案内容键.取成员 (取循环索引 ()) == 解除键)
                {
                    解除索引 = 取循环索引 ()
                    跳出循环
                }
            }
            如果 (解除索引 != -1)
            {
                方案内容键.删除成员 (解除索引)
                方案内容值.删除成员 (解除索引)
            }
            方案内容锁.解锁 ()
            如果 (解除索引 == -1)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未找到已注册的方案: " + 解除键))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "方案已解除: " + 解除键))
        }
        否则 (动作 == "clear")
        {
            方案内容锁.加锁 ()
            方案内容键 = MCP命令服务器.取空文本数组 ()
            方案内容值 = MCP命令服务器.取空文本数组 ()
            方案内容锁.解锁 ()
            FBrowser_自定义方案_清理 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "全部自定义方案已清理"))
        }
        否则 (动作 == "list")
        {
            方案内容锁.加锁 ()
            变量 方案列表 <类型 = 文本型>
            方案列表 = "["
            变量 方案首 <类型 = 逻辑型 值 = 真>
            计次循环 (方案内容键.取成员数 ())
            {
                如果 (方案首)
                {
                    方案首 = 假
                }
                否则
                {
                    方案列表 = 方案列表 + ","
                }
                变量 方案条目 <类型 = YYJSON对象类>
                方案条目.创建自文本 ("{}")
                方案条目.加入文本成员 ("url_prefix", 方案内容键.取成员 (取循环索引 ()))
                方案条目.加入文本成员 ("config", 方案内容值.取成员 (取循环索引 ()))
                方案列表 = 方案列表 + 方案条目.到可读文本 (YYJSON格式化选项.压缩)
            }
            方案列表 = 方案列表 + "]"
            方案内容锁.解锁 ()
            返回 (MCP_响应构建.构建简单JSON ("schemes", 方案列表))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 register/unregister/clear/list"))
    }

    # ==================== 快捷菜单 ====================

    方法 分派_菜单管理 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "disable")
        {
            屏蔽快捷菜单 = 真
            返回 (MCP_响应构建.命令成功 (命令ID, "已屏蔽右键快捷菜单(内核事件拦截)"))
        }
        否则 (动作 == "enable")
        {
            屏蔽快捷菜单 = 假
            返回 (MCP_响应构建.命令成功 (命令ID, "已恢复右键快捷菜单"))
        }
        否则 (动作 == "status")
        {
            变量 st <类型 = YYJSON对象类>
            st.创建自文本 ("{}")
            st.加入逻辑值成员 ("disabled", 屏蔽快捷菜单)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, st.到可读文本 (YYJSON格式化选项.压缩)))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 disable/enable/status"))
    }

    # ==================== IPC 队列 (渲染侧应答通道) ====================
    # 链路: browser_ipc_send_all/to 下发 → 渲染进程间消息_收到主进程消息 注入
    # window.__mcp_ipc_queue → 页面JS应答写入队列 → 本工具取回 (双工IPC)

    方法 分派_IPC队列 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "clear")
        {
            MCP命令服务器.CDP执行JS并等待 ("(window.__mcp_ipc_queue=[])", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "渲染侧IPC队列已清空"))
        }
        // 默认 queue: 读取渲染侧队列 (CDP Runtime.evaluate 同步取回)
        变量 队列JSON <类型 = 文本型>
        队列JSON = MCP命令服务器.CDP执行JS并等待 ("JSON.stringify((window.__mcp_ipc_queue||[]))", 8000, 真)
        如果 (队列JSON == "")
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "读取IPC队列失败(页面无响应) | 请确认页面已加载并已收到过IPC消息"))
        }
        如果 (是否以 (队列JSON, "{\"error\""))
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "读取IPC队列失败: " + 队列JSON))
        }
        变量 包 <类型 = YYJSON对象类>
        包.创建自文本 ("{}")
        包.加入逻辑值成员 ("success", 真)
        包.加入文本成员 ("queue", 队列JSON)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ==================== CDP 事件订阅监控 ====================

    变量 CDP监控启用 <公开 静态 类型 = 逻辑型 值 = 假>
    变量 CDP监控模式 <公开 静态 类型 = 文本数组类 注释 = "CDP方法前缀, 如 Network.*">
    变量 CDP监控上限 <公开 静态 类型 = 整数 值 = 200>

    方法 分派_CDP监控 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "add")
        {
            变量 方法模式 <类型 = 文本型>
            方法模式 = MCP命令服务器.yyjson取文本 (参数JSON, "methods")
            如果 (方法模式 == "")
            {
                方法模式 = "*"
            }
            变量 新上限 <类型 = 整数>
            新上限 = MCP命令服务器.yyjson取整数 (参数JSON, "max")
            如果 (新上限 > 0 && 新上限 <= 5000)
            {
                CDP监控上限 = 新上限
            }
            变量 已存在 <类型 = 逻辑型 值 = 假>
            计次循环 (CDP监控模式.取成员数 ())
            {
                如果 (CDP监控模式.取成员 (取循环索引 ()) == 方法模式)
                {
                    已存在 = 真
                    跳出循环
                }
            }
            如果 (已存在 == 假)
            {
                CDP监控模式.加入成员 (方法模式)
            }
            CDP监控启用 = 真
            返回 (MCP_响应构建.命令成功 (命令ID, "CDP监控已添加: " + 方法模式 + " (max=" + 到文本 (CDP监控上限) + ")"))
        }
        否则 (动作 == "remove")
        {
            变量 删除模式 <类型 = 文本型>
            删除模式 = MCP命令服务器.yyjson取文本 (参数JSON, "methods")
            如果 (删除模式 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "methods 不能为空"))
            }
            变量 删除索引 <类型 = 整数 值 = -1>
            计次循环 (CDP监控模式.取成员数 ())
            {
                如果 (CDP监控模式.取成员 (取循环索引 ()) == 删除模式)
                {
                    删除索引 = 取循环索引 ()
                    跳出循环
                }
            }
            如果 (删除索引 != -1)
            {
                CDP监控模式.删除成员 (删除索引)
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "CDP监控已移除: " + 删除模式))
        }
        否则 (动作 == "clear")
        {
            CDP监控模式 = MCP命令服务器.取空文本数组 ()
            CDP监控启用 = 假
            返回 (MCP_响应构建.命令成功 (命令ID, "CDP监控已清空"))
        }
        否则 (动作 == "enable")
        {
            CDP监控启用 = 真
            返回 (MCP_响应构建.命令成功 (命令ID, "CDP监控已启用"))
        }
        否则 (动作 == "disable")
        {
            CDP监控启用 = 假
            返回 (MCP_响应构建.命令成功 (命令ID, "CDP监控已禁用"))
        }
        // 默认 list
        变量 st <类型 = YYJSON对象类>
        st.创建自文本 ("{}")
        st.加入逻辑值成员 ("enabled", CDP监控启用)
        st.加入整数成员 ("max", CDP监控上限)
        变量 模式列表 <类型 = 文本型>
        模式列表 = "["
        变量 模式首 <类型 = 逻辑型 值 = 真>
        计次循环 (CDP监控模式.取成员数 ())
        {
            如果 (模式首)
            {
                模式首 = 假
            }
            否则
            {
                模式列表 = 模式列表 + ","
            }
            模式列表 = 模式列表 + "\"" + MCP_响应构建.JSON转义文本 (CDP监控模式.取成员 (取循环索引 ())) + "\""
        }
        模式列表 = 模式列表 + "]"
        st.加入文本成员 ("patterns", 模式列表)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, st.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # 钩子: 存储CDPDevTools事件 内调用 (MCP_Server.wsv), 命中订阅写入 event_log

    方法 检查CDP监控 <公开 静态>
    参数 事件方法名 <类型 = 文本型>
    参数 参数JSON <类型 = 文本型>
    {
        如果 (CDP监控启用 == 假 || CDP监控模式.取成员数 () == 0 || 事件方法名 == "")
        {
            返回
        }
        变量 命中 <类型 = 逻辑型 值 = 假>
        计次循环 (CDP监控模式.取成员数 ())
        {
            变量 模式 <类型 = 文本型>
            模式 = CDP监控模式.取成员 (取循环索引 ())
            如果 (模式 == "*" || 模式 == 事件方法名 || 是否以 (事件方法名, 模式))
            {
                命中 = 真
                跳出循环
            }
        }
        如果 (命中)
        {
            // 写入 event_log 供 browser_event 查询 (log_type=cdp_monitor, 查询事件日志按类型过滤)
            MCP命令服务器.记录事件日志 ("cdp_monitor", 事件方法名, 0, 参数JSON)
        }
    }

    # ==================== 事件反应器 (事件组合引擎) ====================

    变量 反应器规则 <公开 静态 类型 = 文本数组类 注释 = "JSON: {event,code,cooldown_ms}">
    变量 反应器冷却 <公开 静态 类型 = 文本数组类 注释 = "event|index → 上次触发毫秒文本">

    方法 分派_反应器 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "add")
        {
            变量 事件模式 <类型 = 文本型>
            事件模式 = MCP命令服务器.yyjson取文本 (参数JSON, "event")
            如果 (事件模式 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "event 不能为空 | 例: load_end / navigate / url_changed / *"))
            }
            变量 代码 <类型 = 文本型>
            代码 = MCP命令服务器.yyjson取文本 (参数JSON, "code")
            如果 (代码 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "code 不能为空 | 事件触发时在页面执行的JS"))
            }
            变量 冷却 <类型 = 整数>
            冷却 = MCP命令服务器.yyjson取整数 (参数JSON, "cooldown_ms")
            如果 (冷却 <= 0)
            {
                冷却 = 1000
            }
            变量 规则 <类型 = YYJSON对象类>
            规则.创建自文本 ("{}")
            规则.加入文本成员 ("event", 事件模式)
            规则.加入文本成员 ("code", 代码)
            规则.加入整数成员 ("cooldown_ms", 冷却)
            反应器规则.加入成员 (规则.到可读文本 (YYJSON格式化选项.压缩))
            返回 (MCP_响应构建.命令成功 (命令ID, "反应器规则已添加: event=" + 事件模式 + " cooldown=" + 到文本 (冷却) + "ms"))
        }
        否则 (动作 == "clear")
        {
            反应器规则 = MCP命令服务器.取空文本数组 ()
            反应器冷却 = MCP命令服务器.取空文本数组 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "反应器规则已清空"))
        }
        // 默认 list
        变量 规则列表 <类型 = 文本型>
        规则列表 = "["
        变量 规则首 <类型 = 逻辑型 值 = 真>
        计次循环 (反应器规则.取成员数 ())
        {
            如果 (规则首)
            {
                规则首 = 假
            }
            否则
            {
                规则列表 = 规则列表 + ","
            }
            规则列表 = 规则列表 + 反应器规则.取成员 (取循环索引 ())
        }
        规则列表 = 规则列表 + "]"
        返回 (MCP_响应构建.构建简单JSON ("rules", 规则列表))
    }

    # 钩子: 记录监控事件 内调用 (事件被记录时触发规则动作)

    方法 检查反应器 <公开 静态>
    参数 事件类型 <类型 = 文本型>
    {
        如果 (反应器规则.取成员数 () == 0 || 事件类型 == "")
        {
            返回
        }
        变量 现行毫秒 <类型 = 长整数>
        现行毫秒 = 取现行时间毫秒 ()
        计次循环 (反应器规则.取成员数 ())
        {
            变量 规则解析 <类型 = YYJSON只读对象类>
            如果 (规则解析.创建自文本 (反应器规则.取成员 (取循环索引 ())))
            {
                变量 事件模式 <类型 = 文本型>
                事件模式 = MCP命令服务器.yyjson取文本 (规则解析, "event")
                如果 (事件模式 == "*" || 事件模式 == 事件类型)
                {
                    变量 冷却 <类型 = 整数>
                    冷却 = MCP命令服务器.yyjson取整数 (规则解析, "cooldown_ms")
                    变量 冷却键 <类型 = 文本型>
                    冷却键 = 事件类型 + "|" + 到文本 (取循环索引 ())
                    变量 上次毫秒 <类型 = 长整数>
                    上次毫秒 = 0
                    计次循环 (反应器冷却.取成员数 ())
                    {
                        变量 冷却条目 <类型 = 文本型>
                        冷却条目 = 反应器冷却.取成员 (取循环索引 ())
                        如果 (寻找文本 (冷却条目, 冷却键 + "=", 0, 假) == 0)
                        {
                            上次毫秒 = 文本到长整数 (取文本右边 (冷却条目, 取文本长度 (冷却条目) - 取文本长度 (冷却键) - 1))
                            跳出循环
                        }
                    }
                    如果 (现行毫秒 - 上次毫秒 >= 冷却)
                    {
                        // 更新冷却
                        变量 已更新冷却 <类型 = 逻辑型 值 = 假>
                        计次循环 (反应器冷却.取成员数 ())
                        {
                            如果 (寻找文本 (反应器冷却.取成员 (取循环索引 ()), 冷却键 + "=", 0, 假) == 0)
                            {
                                数组置成员 (反应器冷却, 取循环索引 (), 冷却键 + "=" + 到文本 (现行毫秒))
                                已更新冷却 = 真
                                跳出循环
                            }
                        }
                        如果 (已更新冷却 == 假)
                        {
                            反应器冷却.加入成员 (冷却键 + "=" + 到文本 (现行毫秒))
                        }
                        // 执行动作: 异步提交JS任务 (页面执行代码)
                        变量 动作代码 <类型 = 文本型>
                        动作代码 = MCP命令服务器.yyjson取文本 (规则解析, "code")
                        变量 动作浏览器 <类型 = 类_FBrowser_浏览器>
                        动作浏览器 = MCP命令服务器.取主浏览器 ()
                        如果 (动作浏览器.是否为空 () == 假 && 动作浏览器.是否已关闭 () == 假 && 动作代码 != "")
                        {
                            变量 动作任务ID <类型 = 文本型>
                            动作任务ID = MCP命令服务器.生成异步任务ID ()
                            MCP命令服务器.提交异步JS任务 (动作浏览器, 动作代码, 动作任务ID)
                        }
                    }
                }
            }
        }
    }

    # ==================== 定时监视 (表达式周期监控 → watch_changed 事件) ====================

    变量 监视任务 <公开 静态 类型 = 文本数组类 注释 = "JSON: {key,expr,interval_ms}">
    变量 监视上次值 <公开 静态 类型 = 文本数组类 注释 = "key → 上次结果文本">
    变量 监视提交态 <公开 静态 类型 = 文本数组类 注释 = "key → taskID 或 空">
    变量 监视提交毫秒 <公开 静态 类型 = 文本数组类 注释 = "key → 上次提交毫秒文本">

    方法 分派_定时监视 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "start")
        {
            变量 表达式 <类型 = 文本型>
            表达式 = MCP命令服务器.yyjson取文本 (参数JSON, "expression")
            如果 (表达式 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "expression 不能为空 | 例: document.title / window.__token"))
            }
            变量 键 <类型 = 文本型>
            键 = MCP命令服务器.yyjson取文本 (参数JSON, "key")
            如果 (键 == "")
            {
                键 = "watch_" + 到文本 (监视任务.取成员数 ())
            }
            变量 间隔 <类型 = 整数>
            间隔 = MCP命令服务器.yyjson取整数 (参数JSON, "interval_ms")
            如果 (间隔 < 500)
            {
                间隔 = 2000
            }
            // 去重: 同 key 覆盖
            变量 监视已存在 <类型 = 逻辑型 值 = 假>
            计次循环 (监视任务.取成员数 ())
            {
                变量 旧任务解析 <类型 = YYJSON只读对象类>
                如果 (旧任务解析.创建自文本 (监视任务.取成员 (取循环索引 ())))
                {
                    如果 (MCP命令服务器.yyjson取文本 (旧任务解析, "key") == 键)
                    {
                        监视已存在 = 真
                        变量 新任务 <类型 = YYJSON对象类>
                        新任务.创建自文本 ("{}")
                        新任务.加入文本成员 ("key", 键)
                        新任务.加入文本成员 ("expr", 表达式)
                        新任务.加入整数成员 ("interval_ms", 间隔)
                        数组置成员 (监视任务, 取循环索引 (), 新任务.到可读文本 (YYJSON格式化选项.压缩))
                        跳出循环
                    }
                }
            }
            如果 (监视已存在 == 假)
            {
                变量 新任务2 <类型 = YYJSON对象类>
                新任务2.创建自文本 ("{}")
                新任务2.加入文本成员 ("key", 键)
                新任务2.加入文本成员 ("expr", 表达式)
                新任务2.加入整数成员 ("interval_ms", 间隔)
                监视任务.加入成员 (新任务2.到可读文本 (YYJSON格式化选项.压缩))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "定时监视已启动: " + 键 + " (interval=" + 到文本 (间隔) + "ms) | 变更记录为 watch_changed 事件"))
        }
        否则 (动作 == "stop")
        {
            变量 停止键 <类型 = 文本型>
            停止键 = MCP命令服务器.yyjson取文本 (参数JSON, "key")
            如果 (停止键 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "key 不能为空"))
            }
            变量 停止索引 <类型 = 整数 值 = -1>
            计次循环 (监视任务.取成员数 ())
            {
                变量 停止解析 <类型 = YYJSON只读对象类>
                如果 (停止解析.创建自文本 (监视任务.取成员 (取循环索引 ())))
                {
                    如果 (MCP命令服务器.yyjson取文本 (停止解析, "key") == 停止键)
                    {
                        停止索引 = 取循环索引 ()
                        跳出循环
                    }
                }
            }
            如果 (停止索引 != -1)
            {
                监视任务.删除成员 (停止索引)
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "定时监视已停止: " + 停止键))
        }
        否则 (动作 == "clear")
        {
            监视任务 = MCP命令服务器.取空文本数组 ()
            监视上次值 = MCP命令服务器.取空文本数组 ()
            监视提交态 = MCP命令服务器.取空文本数组 ()
            监视提交毫秒 = MCP命令服务器.取空文本数组 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "定时监视已全部停止"))
        }
        // 默认 list
        变量 监视列表 <类型 = 文本型>
        监视列表 = "["
        变量 监视首 <类型 = 逻辑型 值 = 真>
        计次循环 (监视任务.取成员数 ())
        {
            如果 (监视首)
            {
                监视首 = 假
            }
            否则
            {
                监视列表 = 监视列表 + ","
            }
            监视列表 = 监视列表 + 监视任务.取成员 (取循环索引 ())
        }
        监视列表 = 监视列表 + "]"
        返回 (MCP_响应构建.构建简单JSON ("watches", 监视列表))
    }

    # 钩子: main.wsv 主循环节拍 调用 (每500ms), 提交/查询/对比监视表达式

    方法 检查定时监视 <公开 静态>
    {
        如果 (监视任务.取成员数 () == 0)
        {
            返回
        }
        变量 现行毫秒 <类型 = 长整数>
        现行毫秒 = 取现行时间毫秒 ()
        变量 监视浏览器 <类型 = 类_FBrowser_浏览器>
        监视浏览器 = MCP命令服务器.取主浏览器 ()
        如果 (监视浏览器.是否为空 () || 监视浏览器.是否已关闭 ())
        {
            返回
        }
        计次循环 (监视任务.取成员数 ())
        {
            变量 任务解析 <类型 = YYJSON只读对象类>
            如果 (任务解析.创建自文本 (监视任务.取成员 (取循环索引 ())))
            {
                变量 键 <类型 = 文本型>
                键 = MCP命令服务器.yyjson取文本 (任务解析, "key")
                变量 表达式 <类型 = 文本型>
                表达式 = MCP命令服务器.yyjson取文本 (任务解析, "expr")
                变量 间隔 <类型 = 整数>
                间隔 = MCP命令服务器.yyjson取整数 (任务解析, "interval_ms")
                如果 (间隔 <= 0)
                {
                    间隔 = 2000
                }
                // 1. 查询进行中的任务结果
                变量 进行任务ID <类型 = 文本型>
                进行任务ID = 取监视平行值 (监视提交态, 键)
                如果 (进行任务ID != "")
                {
                    变量 任务结果 <类型 = 文本型>
                    任务结果 = MCP命令服务器.查询异步结果 (进行任务ID)
                    如果 (任务结果 != "")
                    {
                        变量 任务解析2 <类型 = YYJSON只读对象类>
                        如果 (任务解析2.创建自文本 (任务结果))
                        {
                            如果 (任务解析2.取逻辑值 ("_waiting") == 假)
                            {
                                // 2. 结果就绪: 提取值并对比
                                变量 结果消息 <类型 = 文本型>
                                结果消息 = MCP命令服务器.yyjson取文本 (任务解析2, "message")
                                变量 上次值 <类型 = 文本型>
                                上次值 = 取监视平行值 (监视上次值, 键)
                                如果 (结果消息 != 上次值)
                                {
                                    变量 变更数据 <类型 = YYJSON对象类>
                                    变更数据.创建自文本 ("{}")
                                    变更数据.加入文本成员 ("key", 键)
                                    变更数据.加入文本成员 ("previous", 上次值)
                                    变更数据.加入文本成员 ("current", 结果消息)
                                    变更数据.加入长整数成员 ("time_ms", 现行毫秒)
                                    MCP命令服务器.记录事件日志 ("watch_changed", 键, 0, 变更数据.到可读文本 (YYJSON格式化选项.压缩))
                                    // 页面JS可主动上报变更提示
                                    置监视平行值 (监视上次值, 键, 结果消息)
                                }
                                // 任务消费完毕
                                置监视平行值 (监视提交态, 键, "")
                            }
                        }
                    }
                }
                // 3. 到达间隔则提交新求值
                变量 上次提交 <类型 = 长整数>
                上次提交 = 文本到长整数 (取监视平行值 (监视提交毫秒, 键))
                如果 (进行任务ID == "" && 现行毫秒 - 上次提交 >= 间隔)
                {
                    置监视平行值 (监视提交毫秒, 键, 到文本 (现行毫秒))
                    变量 求值任务ID <类型 = 文本型>
                    求值任务ID = MCP命令服务器.生成异步任务ID ()
                    变量 求值包装 <类型 = 文本型>
                    求值包装 = "JSON.stringify((function(){try{var v=" + 表达式 + ";return (typeof v==='string')?v:JSON.stringify(v)}catch(e){return 'ERR:'+e.message}})())"
                    变量 提交返回 <类型 = 文本型>
                    提交返回 = MCP命令服务器.提交异步JS任务 (监视浏览器, 求值包装, 求值任务ID)
                    如果 (提交返回 == "")
                    {
                        置监视平行值 (监视提交态, 键, 求值任务ID)
                    }
                }
            }
        }
    }

    # 平行数组辅助: 数组置成员 (文本数组类无置成员方法, 重建保序)

    方法 数组置成员 <公开 静态>
    参数 数组 <类型 = 文本数组类>
    参数 索引 <类型 = 整数>
    参数 值 <类型 = 文本型>
    {
        变量 新数组 <类型 = 文本数组类>
        新数组 = MCP命令服务器.取空文本数组 ()
        计次循环 (数组.取成员数 ())
        {
            如果 (取循环索引 () == 索引)
            {
                新数组.加入成员 (值)
            }
            否则
            {
                新数组.加入成员 (数组.取成员 (取循环索引 ()))
            }
        }
        数组 = 新数组
    }

    # 平行数组辅助: 按键取/置值 (数组元素格式 "key=value")

    方法 取监视平行值 <公开 静态 类型 = 文本型>
    参数 数组 <类型 = 文本数组类>
    参数 键 <类型 = 文本型>
    {
        变量 值 <类型 = 文本型>
        值 = ""
        计次循环 (数组.取成员数 ())
        {
            变量 条目 <类型 = 文本型>
            条目 = 数组.取成员 (取循环索引 ())
            如果 (寻找文本 (条目, 键 + "=", 0, 假) == 0)
            {
                值 = 取文本右边 (条目, 取文本长度 (条目) - 取文本长度 (键) - 1)
                跳出循环
            }
        }
        返回 (值)
    }

    方法 置监视平行值 <公开 静态>
    参数 数组 <类型 = 文本数组类>
    参数 键 <类型 = 文本型>
    参数 值 <类型 = 文本型>
    {
        变量 已更新 <类型 = 逻辑型 值 = 假>
        计次循环 (数组.取成员数 ())
        {
            如果 (寻找文本 (数组.取成员 (取循环索引 ()), 键 + "=", 0, 假) == 0)
            {
                数组置成员 (数组, 取循环索引 (), 键 + "=" + 值)
                已更新 = 真
                跳出循环
            }
        }
        如果 (已更新 == 假)
        {
            数组.加入成员 (键 + "=" + 值)
        }
    }

    # ==================== 全事件流一键开关 ====================

    方法 分派_全事件流 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "enable" || 动作 == "")
        {
            // 浏览器事件全开 (13项)
            MCP命令服务器.是否监控载入事件 = 真
            MCP命令服务器.是否监控标题改变 = 真
            MCP命令服务器.是否监控加载进度 = 真
            MCP命令服务器.是否监控资源事件 = 真
            MCP命令服务器.是否监控对话框 = 真
            MCP命令服务器.是否监控全屏 = 真
            MCP命令服务器.是否监控图标 = 真
            MCP命令服务器.是否监控查找 = 真
            MCP命令服务器.是否监控框架 = 真
            MCP命令服务器.是否监控下载事件 = 真
            MCP命令服务器.是否监控键盘焦点 = 真
            MCP命令服务器.是否监控生命周期 = 真
            MCP命令服务器.是否监控应用事件 = 真
            // 日志全开
            MCP命令服务器.是否记录控制台 = 真
            MCP命令服务器.是否记录网络 = 真
            MCP命令服务器.是否详细记录网络 = 真
            返回 (MCP_响应构建.命令成功 (命令ID, "全事件流已开启: 13项浏览器/应用事件 + 控制台 + 网络详细 | 查询: browser_event / browser_network list / browser_collect console_get"))
        }
        否则 (动作 == "disable")
        {
            MCP命令服务器.是否监控载入事件 = 假
            MCP命令服务器.是否监控标题改变 = 假
            MCP命令服务器.是否监控加载进度 = 假
            MCP命令服务器.是否监控资源事件 = 假
            MCP命令服务器.是否监控对话框 = 假
            MCP命令服务器.是否监控全屏 = 假
            MCP命令服务器.是否监控图标 = 假
            MCP命令服务器.是否监控查找 = 假
            MCP命令服务器.是否监控框架 = 假
            MCP命令服务器.是否监控下载事件 = 假
            MCP命令服务器.是否监控键盘焦点 = 假
            MCP命令服务器.是否监控生命周期 = 假
            MCP命令服务器.是否监控应用事件 = 假
            MCP命令服务器.是否记录控制台 = 假
            MCP命令服务器.是否记录网络 = 假
            MCP命令服务器.是否详细记录网络 = 假
            返回 (MCP_响应构建.命令成功 (命令ID, "全事件流已关闭"))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 enable/disable"))
    }

    # ================================================================
    # 动态逆向能力套件 (页面内 JS 插桩, 经 CDP Runtime.evaluate 注入/取回)
    # 数据落点: window.__MCP_PROBE__ / __MCP_TRACE__ / __MCP_ALGO_LOG__
    #          / __MCP_GWATCH__; 可配合 IPC 队列与事件反应器联动
    # ================================================================
    # ── 动态探针: XHR/fetch/WebSocket/定时器/事件监听 五维 API 插桩 ──

    方法 分派_动态探针 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "enable" || 动作 == "")
        {
            变量 注入代码 <类型 = 文本型>
            注入代码 = "(function(){if(window.__MCP_PROBE__)return'__already';var L=window.__MCP_PROBE__={xhr:[],fetch:[],ws:[],timers:[],listeners:[],limit:300,orig:{}};function P(k,o){if(L[k].length>=L.limit)L[k].shift();L[k].push(o);}var OX=XMLHttpRequest.prototype;['open','send'].forEach(function(m){var f=OX[m];OX[m]=function(){try{if(m==='open'){this.__u=String(arguments[1]);this.__m=arguments[0];this.__t=Date.now();this.__s=new Error().stack}else{var self=this;var resp='';try{resp=self.responseType==='json'?JSON.stringify(self.response).slice(0,500):String(self.response).slice(0,500)}catch(e){}P('xhr',{u:self.__u,m:self.__m,status:self.status,t:Date.now()-self.__t,resp:resp,st:self.__s?self.__s.slice(0,400):''})}}catch(e){}return f.apply(this,arguments)}});var OF=window.fetch;window.fetch=function(){try{var u=(arguments[0]&&arguments[0].url)?arguments[0].url:String(arguments[0]);var o=arguments[1]||{};P('fetch',{u:u,method:o.method||'GET',st:new Error().stack.slice(0,400),t:Date.now()})}catch(e){}return OF.apply(this,arguments)};try{var WS=window.WebSocket;var OWS=WS.prototype;['send','close'].forEach(function(m){var f=OWS[m];OWS[m]=function(){try{if(m==='send'){P('ws',{send:typeof arguments[0]==='string'?arguments[0].slice(0,300):'[binary]',st:new Error().stack.slice(0,400)})}}catch(e){}return f.apply(this,arguments)}})}catch(e){}['setTimeout','setInterval'].forEach(function(m){var f=window[m];window[m]=function(){try{P('timers',{m:m,d:arguments[1],st:new Error().stack.slice(0,300)})}catch(e){}return f.apply(this,arguments)}});var OE=EventTarget.prototype.addEventListener;EventTarget.prototype.addEventListener=function(t,fn,o){try{P('listeners',{t:t,fn:fn&&fn.toString?fn.toString().slice(0,200):'',st:new Error().stack.slice(0,300)})}catch(e){}return OE.call(this,t,fn,o)};return'__ok'})()"
            变量 注入结果 <类型 = 文本型>
            注入结果 = MCP命令服务器.CDP执行JS并等待 (注入代码, 10000, 真)
            如果 (注入结果 == "" || 是否以 (注入结果, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "探针注入失败: " + 注入结果))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "动态探针已注入(五维API插桩): " + 注入结果 + " | 数据在 window.__MCP_PROBE__, 用 action=get 取回"))
        }
        否则 (动作 == "get")
        {
            变量 数据 <类型 = 文本型>
            数据 = MCP命令服务器.CDP执行JS并等待 ("JSON.stringify(window.__MCP_PROBE__||{note:'not_injected'})", 10000, 真)
            如果 (数据 == "" || 是否以 (数据, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "读取探针数据失败: " + 数据))
            }
            变量 包 <类型 = YYJSON对象类>
            包.创建自文本 ("{}")
            包.加入逻辑值成员 ("success", 真)
            包.加入文本成员 ("probe", 数据)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (动作 == "clear")
        {
            MCP命令服务器.CDP执行JS并等待 ("(window.__MCP_PROBE__&&(window.__MCP_PROBE__.xhr=[],window.__MCP_PROBE__.fetch=[],window.__MCP_PROBE__.ws=[],window.__MCP_PROBE__.timers=[],window.__MCP_PROBE__.listeners=[]),'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "探针数据已清空"))
        }
        否则 (动作 == "disable")
        {
            // 页面刷新后插桩自然失效; 重注入需先刷新
            MCP命令服务器.CDP执行JS并等待 ("(delete window.__MCP_PROBE__,'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "探针已移除(建议刷新页面彻底清除)"))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 enable/get/clear/disable"))
    }

    # ── 动态调用追踪: 目标函数包装, 记录调用栈/参数/返回值/耗时 ──

    方法 分派_调用追踪 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "start" || 动作 == "")
        {
            变量 目标文本 <类型 = 文本型>
            目标文本 = MCP命令服务器.yyjson取文本 (参数JSON, "targets")
            如果 (目标文本 == "")
            {
                // 兼容 JSON 数组参数
                目标文本 = MCP命令服务器.yyjson取JSON文本 (参数JSON, "targets")
            }
            如果 (目标文本 == "" || 取文本左边 (目标文本, 1) != "[")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "targets 不能为空 | 例: [\"window.fetch\",\"crypto.subtle.encrypt\"]"))
            }
            变量 注入代码 <类型 = 文本型>
            注入代码 = "(function(){if(window.__MCP_TRACE__)return'__already';var T=window.__MCP_TRACE__={calls:[],limit:200,errors:0};function S(v){try{if(v===undefined)return'undefined';if(v===null)return'null';if(typeof v==='function')return'[Function '+(v.name||'')+']';if(typeof v==='object'){var s=JSON.stringify(v);return s?s.slice(0,200):'[Object]'}return String(v).slice(0,200)}catch(e){return'[unserializable]'}}function wrap(path,obj,name){try{var f=obj[name];if(typeof f!=='function'||f.__mcp_tr)return;var orig=f;obj[name]=function(){var args=[].slice.call(arguments);var st=new Error().stack;var t0=Date.now();try{var r=orig.apply(this,arguments);T.calls.push({p:path,a:args.map(S).slice(0,10),r:S(r),ms:Date.now()-t0,st:st?st.slice(0,300):''});if(T.calls.length>T.limit)T.calls.shift();return r}catch(e){T.calls.push({p:path,a:args.map(S).slice(0,10),err:e.message,st:st?st.slice(0,300):''});if(T.calls.length>T.limit)T.calls.shift();throw e}};obj[name].__mcp_tr=true}catch(e){T.errors++}}var targets=" + 目标文本 + ";for(var i=0;i<targets.length;i++){var parts=String(targets[i]).split('.');var o=window;var ok=true;for(var j=0;j<parts.length-1;j++){if(o[parts[j]]==null){ok=false;break}o=o[parts[j]]}if(ok&&o[parts[parts.length-1]]!=null)wrap(targets[i],o,parts[parts.length-1])}return'__ok wrapped='+window.__MCP_TRACE__.errors+'fail'})()"
            变量 注入结果 <类型 = 文本型>
            注入结果 = MCP命令服务器.CDP执行JS并等待 (注入代码, 10000, 真)
            如果 (注入结果 == "" || 是否以 (注入结果, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "调用追踪注入失败: " + 注入结果))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "调用追踪已启动: " + 注入结果 + " | 数据在 window.__MCP_TRACE__"))
        }
        否则 (动作 == "get")
        {
            变量 数据 <类型 = 文本型>
            数据 = MCP命令服务器.CDP执行JS并等待 ("JSON.stringify(window.__MCP_TRACE__||{note:'not_injected'})", 10000, 真)
            如果 (数据 == "" || 是否以 (数据, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "读取追踪数据失败: " + 数据))
            }
            变量 包 <类型 = YYJSON对象类>
            包.创建自文本 ("{}")
            包.加入逻辑值成员 ("success", 真)
            包.加入文本成员 ("trace", 数据)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (动作 == "clear")
        {
            MCP命令服务器.CDP执行JS并等待 ("(window.__MCP_TRACE__&&(window.__MCP_TRACE__.calls=[],window.__MCP_TRACE__.errors=0),'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "追踪数据已清空"))
        }
        否则 (动作 == "stop")
        {
            MCP命令服务器.CDP执行JS并等待 ("(delete window.__MCP_TRACE__,'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "追踪已停止(建议刷新页面彻底恢复原函数)"))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 start/get/clear/stop"))
    }

    # ── 动态算法 Hook: CryptoJS/全局哈希/base64/WebCrypto 参数与结果全记录 ──

    方法 分派_算法Hook <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "start" || 动作 == "")
        {
            变量 注入代码 <类型 = 文本型>
            注入代码 = "(function(){if(window.__MCP_ALGO_LOG__)return'__already';var L=window.__MCP_ALGO_LOG__={calls:[],limit:200};function P(alg,args,res){try{var map=args.map(function(x){try{if(x===undefined)return'undefined';if(typeof x==='string')return x.slice(0,100);if(x&&x.words&&x.sigBytes!=null)return'[WordArray len='+x.sigBytes+']';if(typeof x==='object'){var s=JSON.stringify(x);return s?s.slice(0,100):'[obj]'}return String(x).slice(0,100)}catch(e){return'?'}}).slice(0,6);var rr='';try{rr=typeof res==='string'?res.slice(0,100):(res&&res.toString?res.toString().slice(0,100):String(res))}catch(e){rr='[?]'}L.calls.push({a:alg,args:map,r:rr,st:new Error().stack?new Error().stack.slice(0,300):'',ts:Date.now()});if(L.calls.length>L.limit)L.calls.shift()}catch(e){}}try{if(window.CryptoJS){var CA=['MD5','SHA1','SHA256','SHA512','SHA3','RIPEMD160','AES','DES','TripleDES','RC4','Rabbit','RabbitLegacy','HmacMD5','HmacSHA1','HmacSHA256','HmacSHA512'];CA.forEach(function(n){var fn=CryptoJS[n];if(typeof fn==='function'&&!fn.__mcp_al){CryptoJS[n]=function(){try{P('CryptoJS.'+n,[].slice.call(arguments),fn.apply(this,arguments))}catch(e){throw e}};CryptoJS[n].__mcp_al=true}})}}catch(e){}try{['md5','sha1','sha256','sha512','btoa','atob','encodeURIComponent','decodeURIComponent'].forEach(function(n){var fn=window[n];if(typeof fn==='function'&&!fn.__mcp_al){window[n]=function(){try{P('window.'+n,[].slice.call(arguments),fn.apply(this,arguments))}catch(e){throw e}};window[n].__mcp_al=true}})}catch(e){}try{if(window.crypto&&crypto.subtle){['encrypt','decrypt','digest','sign','verify','deriveKey','deriveBits'].forEach(function(n){var fn=crypto.subtle[n];if(typeof fn==='function'&&!fn.__mcp_al){crypto.subtle[n]=function(){try{P('subtle.'+n,[].slice.call(arguments),'[promise]')}catch(e){}return fn.apply(this,arguments)};crypto.subtle[n].__mcp_al=true}})}}catch(e){}return'__ok'})()"
            变量 注入结果 <类型 = 文本型>
            注入结果 = MCP命令服务器.CDP执行JS并等待 (注入代码, 10000, 真)
            如果 (注入结果 == "" || 是否以 (注入结果, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "算法Hook注入失败: " + 注入结果))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "算法Hook已启动(CryptoJS+哈希+base64+WebCrypto) | 数据在 window.__MCP_ALGO_LOG__"))
        }
        否则 (动作 == "get")
        {
            变量 数据 <类型 = 文本型>
            数据 = MCP命令服务器.CDP执行JS并等待 ("JSON.stringify(window.__MCP_ALGO_LOG__||{note:'not_injected'})", 10000, 真)
            如果 (数据 == "" || 是否以 (数据, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "读取算法日志失败: " + 数据))
            }
            变量 包 <类型 = YYJSON对象类>
            包.创建自文本 ("{}")
            包.加入逻辑值成员 ("success", 真)
            包.加入文本成员 ("algo_log", 数据)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (动作 == "clear")
        {
            MCP命令服务器.CDP执行JS并等待 ("(window.__MCP_ALGO_LOG__&&(window.__MCP_ALGO_LOG__.calls=[],window.__MCP_ALGO_LOG__.errors=0),'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "算法日志已清空"))
        }
        否则 (动作 == "stop")
        {
            MCP命令服务器.CDP执行JS并等待 ("(delete window.__MCP_ALGO_LOG__,'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "算法Hook已停止(建议刷新页面彻底恢复)"))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 start/get/clear/stop"))
    }

    # ── 动态函数提取: 枚举 window/对象链/prototype 函数与源码(toString) ──

    方法 分派_函数提取 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 最大数 <类型 = 整数>
        最大数 = MCP命令服务器.yyjson取整数 (参数JSON, "max")
        如果 (最大数 <= 0 || 最大数 > 1000)
        {
            最大数 = 500
        }
        变量 过滤词 <类型 = 文本型>
        过滤词 = MCP命令服务器.yyjson取文本 (参数JSON, "filter")
        变量 注入代码 <类型 = 文本型>
        注入代码 = "JSON.stringify((function(){var out=[];var seen={};var MAX=" + 到文本 (最大数) + ";var FIL='' ;function add(p,f){try{if(typeof f!=='function')return;var src=f.toString();if(FIL&&p.indexOf(FIL)<0)return;var k=src.length+'|'+src.slice(0,40);if(seen[k])return;seen[k]=1;out.push({p:p,n:f.name||'',l:f.length,s:src.slice(0,1500)})}catch(e){}}try{Object.keys(window).forEach(function(k){try{if(typeof window[k]==='function')add('window.'+k,window[k])}catch(e){}})}catch(e){}['location','navigator','document','history','crypto','performance','localStorage','sessionStorage','console'].forEach(function(o){try{var obj=window[o];if(!obj)return;Object.keys(obj).forEach(function(k){try{if(typeof obj[k]==='function')add(o+'.'+k,obj[k])}catch(e){}})}catch(e){}})['XMLHttpRequest','WebSocket','Promise','Map','Set','Array','Object','String','Number','Date','RegExp','JSON','WebAssembly','URL','Blob','FileReader','FormData','Headers','Request','Response','AbortController','IntersectionObserver','MutationObserver','ResizeObserver'].forEach(function(c){try{var C=window[c];if(!C||typeof C!=='function')return;add('window.'+c,C);try{Object.getOwnPropertyNames(C.prototype).forEach(function(k){try{add(c+'.prototype.'+k,C.prototype[k])}catch(e){}})}catch(e){}}catch(e){}})return out.slice(0,MAX)})())"
        // 过滤词注入 (单引号安全)
        如果 (过滤词 != "")
        {
            子文本替换 (注入代码, "var FIL=''", "var FIL='" + MCP命令服务器.简单转义JS (过滤词) + "'", , , 假)
        }
        变量 数据 <类型 = 文本型>
        数据 = MCP命令服务器.CDP执行JS并等待 (注入代码, 15000, 真)
        如果 (数据 == "" || 是否以 (数据, "{\"error\""))
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "函数提取失败: " + 数据))
        }
        变量 包 <类型 = YYJSON对象类>
        包.创建自文本 ("{}")
        包.加入逻辑值成员 ("success", 真)
        包.加入整数成员 ("max", 最大数)
        包.加入文本成员 ("functions", 数据)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ── 动态 JS 源码提取: document.scripts 全量(含inline), 按索引/截断 ──

    方法 分派_源码提取 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 单脚本上限 <类型 = 整数>
        单脚本上限 = MCP命令服务器.yyjson取整数 (参数JSON, "max_len")
        如果 (单脚本上限 <= 0 || 单脚本上限 > 200000)
        {
            单脚本上限 = 20000
        }
        变量 索引 <类型 = 整数>
        索引 = MCP命令服务器.yyjson取整数 (参数JSON, "index")
        变量 注入代码 <类型 = 文本型>
        注入代码 = "JSON.stringify((function(){var ss=Array.prototype.slice.call(document.scripts);var MAXL=" + 到文本 (单脚本上限) + ";var IDX=" + 到文本 (索引) + ";if(IDX>0){var s=ss[IDX-1];return s?{i:IDX-1,src:s.src||'(inline)',len:(s.textContent||'').length,source:(s.textContent||'').slice(0,MAXL)}:{error:'script_not_found_at_'+IDX}}return ss.map(function(s,i){return {i:i,src:s.src||'(inline)',type:s.type||'',len:(s.textContent||'').length,source:(s.textContent||'').slice(0,MAXL)}})})())"
        变量 数据 <类型 = 文本型>
        数据 = MCP命令服务器.CDP执行JS并等待 (注入代码, 15000, 真)
        如果 (数据 == "" || 是否以 (数据, "{\"error\""))
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "源码提取失败: " + 数据))
        }
        变量 包 <类型 = YYJSON对象类>
        包.创建自文本 ("{}")
        包.加入逻辑值成员 ("success", 真)
        包.加入整数成员 ("max_len", 单脚本上限)
        包.加入文本成员 ("scripts", 数据)
        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
    }

    # ── 全局变量动态追踪: defineProperty setter 记录写入者调用栈与新值 ──

    方法 分派_全局变量追踪 <公开 静态 类型 = 文本型>
    参数 命令ID <类型 = 文本型>
    参数 参数JSON <类型 = YYJSON只读对象类>
    {
        变量 动作 <类型 = 文本型>
        动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
        如果 (动作 == "start" || 动作 == "")
        {
            变量 名称文本 <类型 = 文本型>
            名称文本 = MCP命令服务器.yyjson取文本 (参数JSON, "names")
            如果 (名称文本 == "")
            {
                名称文本 = MCP命令服务器.yyjson取JSON文本 (参数JSON, "names")
            }
            如果 (名称文本 == "" || 取文本左边 (名称文本, 1) != "[")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "names 不能为空 | 例: [\"token\",\"sign\",\"session\"]"))
            }
            变量 注入代码 <类型 = 文本型>
            注入代码 = "(function(){if(window.__MCP_GWATCH__)return'__already';var L=window.__MCP_GWATCH__={hits:[],limit:200};function S(v){try{if(v===undefined)return'undefined';if(v===null)return'null';if(typeof v==='object'){var s=JSON.stringify(v);return s?s.slice(0,200):'[obj]'}return String(v).slice(0,200)}catch(e){return'?'}}var names=" + 名称文本 + ";names.forEach(function(n){try{var v=window[n];Object.defineProperty(window,n,{get:function(){return v},set:function(nv){try{L.hits.push({n:n,v:S(nv),st:new Error().stack?new Error().stack.slice(0,400):'',ts:Date.now()});if(L.hits.length>L.limit)L.hits.shift()}catch(e){}v=nv},configurable:true})}catch(e){}});return'__ok watched='+names.length})()"
            变量 注入结果 <类型 = 文本型>
            注入结果 = MCP命令服务器.CDP执行JS并等待 (注入代码, 10000, 真)
            如果 (注入结果 == "" || 是否以 (注入结果, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "全局变量追踪注入失败: " + 注入结果))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "全局变量追踪已启动: " + 注入结果 + " | 数据在 window.__MCP_GWATCH__"))
        }
        否则 (动作 == "get")
        {
            变量 数据 <类型 = 文本型>
            数据 = MCP命令服务器.CDP执行JS并等待 ("JSON.stringify(window.__MCP_GWATCH__||{note:'not_injected'})", 10000, 真)
            如果 (数据 == "" || 是否以 (数据, "{\"error\""))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "读取变量追踪数据失败: " + 数据))
            }
            变量 包 <类型 = YYJSON对象类>
            包.创建自文本 ("{}")
            包.加入逻辑值成员 ("success", 真)
            包.加入文本成员 ("watch_global", 数据)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (动作 == "clear")
        {
            MCP命令服务器.CDP执行JS并等待 ("(window.__MCP_GWATCH__&&(window.__MCP_GWATCH__.hits=[],window.__MCP_GWATCH__.errors=0),'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "变量追踪数据已清空"))
        }
        否则 (动作 == "stop")
        {
            MCP命令服务器.CDP执行JS并等待 ("(delete window.__MCP_GWATCH__,'ok')", 8000, 真)
            返回 (MCP_响应构建.命令成功 (命令ID, "变量追踪已停止(建议刷新页面彻底恢复)"))
        }
        返回 (MCP_响应构建.命令失败 (命令ID, "action 须为 start/get/clear/stop"))
    }

    # ==================== 事件侧辅助 (供 MCP_BrowserEvents 调用) ====================
    # 记录证书错误 (浏览器_请求证书错误 事件内调用)

    方法 记录证书错误 <公开 静态>
    参数 浏览器ID <类型 = 整数>
    参数 错误代码 <类型 = 整数>
    参数 目标地址 <类型 = 文本型>
    {
        变量 条目 <类型 = YYJSON对象类>
        条目.创建自文本 ("{}")
        条目.加入长整数成员 ("time_ms", 取现行时间毫秒 ())
        条目.加入整数成员 ("error_code", 错误代码)
        条目.加入文本成员 ("url", 目标地址)
        条目.加入整数成员 ("browser_id", 浏览器ID)
        证书错误锁.加锁 ()
        证书错误条目.加入成员 (条目.到可读文本 (YYJSON格式化选项.压缩))
        如果 (证书错误条目.取成员数 () > 200)
        {
            证书错误条目.删除成员 (0)
        }
        证书错误锁.解锁 ()
    }

    # 查询认证凭据 (浏览器_获得需授权证书 事件内调用), 返回 "user|pass", 未命中返回 ""

    方法 查询认证凭据 <公开 静态 类型 = 文本型>
    参数 主机 <类型 = 文本型>
    参数 端口 <类型 = 整数>
    参数 域名 <类型 = 文本型>
    {
        变量 结果 <类型 = 文本型>
        结果 = ""
        变量 键 <类型 = 文本型>
        键 = 主机 + ":" + 到文本 (端口)
        认证凭据锁.加锁 ()
        计次循环 (认证凭据键.取成员数 ())
        {
            变量 现有键 <类型 = 文本型>
            现有键 = 认证凭据键.取成员 (取循环索引 ())
            // 精确匹配 host:port 或 host:port:realm
            如果 (现有键 == 键 || 是否以 (现有键, 键 + ":"))
            {
                如果 (域名 == "" || 现有键 == 键 || 是否以 (现有键, 键 + ":" + 域名))
                {
                    结果 = 认证凭据用户.取成员 (取循环索引 ()) + "|" + 认证凭据密码.取成员 (取循环索引 ())
                    跳出循环
                }
            }
        }
        认证凭据锁.解锁 ()
        返回 (结果)
    }

    # 消费下载操作 (浏览器_正在下载 事件内调用), 返回命中动作 "", 未命中返回 ""

    方法 消费下载操作 <公开 静态 类型 = 文本型>
    参数 下载标识 <类型 = 文本型>
    参数 下载地址 <类型 = 文本型>
    {
        变量 命中动作 <类型 = 文本型>
        命中动作 = ""
        下载操作锁.加锁 ()
        变量 命中索引 <类型 = 整数 值 = -1>
        计次循环 (待执行下载操作.取成员数 ())
        {
            变量 操作解析 <类型 = YYJSON只读对象类>
            如果 (操作解析.创建自文本 (待执行下载操作.取成员 (取循环索引 ())))
            {
                变量 匹配ID <类型 = 文本型>
                匹配ID = MCP命令服务器.yyjson取文本 (操作解析, "id")
                变量 匹配URL <类型 = 文本型>
                匹配URL = MCP命令服务器.yyjson取文本 (操作解析, "url")
                如果 (匹配ID != "" && 匹配ID == 下载标识)
                {
                    命中动作 = MCP命令服务器.yyjson取文本 (操作解析, "action")
                    命中索引 = 取循环索引 ()
                    跳出循环
                }
                如果 (匹配URL != "" && 下载地址 != "" && 寻找文本 (下载地址, 匹配URL, 0, 假) != -1)
                {
                    命中动作 = MCP命令服务器.yyjson取文本 (操作解析, "action")
                    命中索引 = 取循环索引 ()
                    跳出循环
                }
            }
        }
        如果 (命中索引 != -1)
        {
            待执行下载操作.删除成员 (命中索引)
        }
        下载操作锁.解锁 ()
        返回 (命中动作)
    }

    # 查询方案内容 (类_MCP_方案资源处理器 事件内调用), 返回 {"mime":..,"body":..}, 未找到返回 ""

    方法 取方案内容 <公开 静态 类型 = 文本型>
    参数 请求地址 <类型 = 文本型>
    {
        变量 结果 <类型 = 文本型>
        结果 = ""
        方案内容锁.加锁 ()
        计次循环 (方案内容键.取成员数 ())
        {
            变量 前缀 <类型 = 文本型>
            前缀 = 方案内容键.取成员 (取循环索引 ())
            如果 (请求地址 != "" && 寻找文本 (请求地址, 前缀, 0, 假) == 0)
            {
                变量 配置解析 <类型 = YYJSON只读对象类>
                如果 (配置解析.创建自文本 (方案内容值.取成员 (取循环索引 ())))
                {
                    结果 = 方案内容值.取成员 (取循环索引 ())
                }
                跳出循环
            }
        }
        方案内容锁.解锁 ()
        返回 (结果)
    }
}

# ================================================================
# 自定义方案资源处理器 — 为 mcp://domain 提供动态内容
# 范式参照: FBrowser模块例子/Scheme_callback.wsv (官方)
# ================================================================

类 类_MCP_方案资源处理器 <公开 基础类 = 类_FBrowser_资源处理器>
{
    变量 响应字节集 <类型 = 字节集类>
    变量 当前MIME <类型 = 文本型>

    方法 打开 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 处理请求 <类型 = 逻辑型类 注释 = "设置为真才会启用事件 处理请求">
    参数 回调 <类型 = 类_FBrowser_回调>
    {
        变量 方案结果 <类型 = 文本型>
        方案结果 = MCP_内核分派.取方案内容 (请求.取地址 ())
        如果 (方案结果 == "")
        {
            返回 (假)
        }
        变量 方案解析 <类型 = YYJSON只读对象类>
        如果 (方案解析.创建自文本 (方案结果) == 假)
        {
            返回 (假)
        }
        当前MIME = MCP命令服务器.yyjson取文本 (方案解析, "mime")
        响应字节集 = 文本到UTF8 (MCP命令服务器.yyjson取文本 (方案解析, "body"), 假)
        处理请求.值 = 真
        回调.继续 ()
        返回 (真)
    }

    方法 处理请求 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 回调 <类型 = 类_FBrowser_回调>
    {
        回调.继续 ()
        返回 (真)
    }

    方法 取响应头 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 响应 <类型 = 类_FBrowser_响应>
    参数 响应长度 <类型 = 长整数类 注释 = "需修改的数据大小, 大于0修改才会有效">
    参数 重定向地址 <类型 = FBrowser_文本>
    {
        响应.置MIME类型 (当前MIME)
        响应.置状态 (200)
        响应长度.值 = 响应字节集.取字节集长度 ()
    }

    方法 忽略 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 可忽略大小 <类型 = 长整数>
    参数 被忽略大小 <类型 = 长整数类>
    参数 资源忽略回调 <类型 = 类_FBrowser_资源忽略回调>
    {
        返回 (假)
    }

    方法 读取 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    参数 输出数据指针 <类型 = 变整数 注释 = "data_out">
    参数 读取大小 <类型 = 整数 注释 = "bytes_to_read">
    参数 读入大小 <类型 = 整数类 注释 = "写入数据大小">
    参数 资源读取回调 <类型 = 类_FBrowser_资源读取回调>
    {
        变量 size <类型 = 整数>
        size = 响应字节集.取字节集长度 ()
        如果 (size == 0)
        {
            返回 (假)
        }
        如果 (size > 读取大小)
        {
            内存复制 (输出数据指针, 响应字节集.取字节集指针 (), 读取大小)
            读入大小.值 = 读取大小
            取字节集右边 (响应字节集, size - 读取大小)
        }
        否则
        {
            内存复制 (输出数据指针, 响应字节集.取字节集指针 (), size)
            读入大小.值 = size
            响应字节集.清空字节集 ()
        }
        返回 (真)
    }

    方法 退出 <公开 @虚拟方法 = 可覆盖>
    参数 标识ID <类型 = 长整数>
    {
        响应字节集.清空字节集 ()
    }
}
