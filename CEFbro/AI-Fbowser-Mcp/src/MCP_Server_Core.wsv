                }
                变量 gfStore <类型 = 文本型>
                gfStore = MCP命令服务器.同步等待异步任务 (gfTaskID, gfWanted)
                如果 (gfStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "表单枚举超时 | 页面可能正在导航"))
                }
                变量 gfWrap <类型 = YYJSON只读对象类>
                如果 (gfWrap.创建自文本 (gfStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (gfWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "表单枚举错误: " + MCP命令服务器.yyjson取文本 (gfWrap, "error")))
                    }
                    变量 gfMsg <类型 = 文本型>
                    gfMsg = MCP命令服务器.yyjson取文本 (gfWrap, "message")
                    如果 (gfMsg != "")
                    {
                        变量 gfData <类型 = YYJSON对象类>
                        gfData.创建自文本 ("{}")
                        gfData.加入逻辑值成员 ("success", 真)
                        gfData.加入文本成员 ("forms_json", gfMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, gfData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "表单结果解析失败 | 请重试"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_highlight")
        {
            变量 hlAction <类型 = 文本型>
            hlAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (hlAction == "")
            {
                hlAction = "show"
            }
            变量 hlBrowser <类型 = 类_FBrowser_浏览器>
            hlBrowser = MCP命令服务器.取主浏览器 ()
            如果 (hlBrowser.是否为空 () == 假 && hlBrowser.是否已关闭 () == 假)
            {
                变量 hlCode <类型 = 文本型>
                如果 (hlAction == "clear")
                {
                    // clear 时同步清除自动清除定时器, 防手动清除后定时器残留副作用
                    hlCode = "(function(){clearTimeout(window.__MCP_HL_TIMER__);window.__MCP_HL_TIMER__=null;var a=window.__MCP_HL__||[];for(var k=0;k<a.length;k++){var q=a[k];if(q&&q.__mcpOrigOutline!==undefined){q.style.outline=q.__mcpOrigOutline;q.style.outlineOffset=q.__mcpOrigOffset;delete q.__mcpOrigOutline;delete q.__mcpOrigOffset;}}window.__MCP_HL__=[];return JSON.stringify({cleared:true,count:a.length});})()"
                }
                否则
                {
                    变量 hlSel <类型 = 文本型>
                    hlSel = MCP命令服务器.简单转义JS (MCP命令服务器.yyjson取文本 (参数JSON, "selector"))
                    如果 (hlSel == "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "selector " + MCP_常量.错误_缺少参数))
                    }
                    变量 hlDur <类型 = 整数>
                    hlDur = MCP命令服务器.yyjson取整数 (参数JSON, "duration_ms")
                    // duration_ms 三态: 未传 -> 默认 3000; 显式传 0 -> 不注册自动清除定时器; 显式传正数 -> 用该值
                    变量 hlNoAutoClear <类型 = 逻辑型 值 = 假>
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "duration_ms") == 假)
                    {
                        hlDur = 3000
                    }
                    否则 (hlDur <= 0)
                    {
                        hlNoAutoClear = 真
                    }
                    hlCode = "(function(){var els=document.querySelectorAll('" + hlSel + "');"
                    hlCode = hlCode + "var prev=(window.__MCP_HL__||[]);for(var i=0;i<prev.length;i++){var p=prev[i];if(p&&p.__mcpOrigOutline!==undefined){p.style.outline=p.__mcpOrigOutline;p.style.outlineOffset=p.__mcpOrigOffset;delete p.__mcpOrigOutline;delete p.__mcpOrigOffset;}}"
                    hlCode = hlCode + "var list=[];for(var j=0;j<els.length;j++){var e=els[j];e.__mcpOrigOutline=e.style.outline;e.__mcpOrigOffset=e.style.outlineOffset;e.style.outline='3px dashed #ff3344';e.style.outlineOffset='2px';list.push(e);}"
                    hlCode = hlCode + "window.__MCP_HL__=list;"
                    如果 (hlNoAutoClear)
                    {
                        // 不自动清除: 清掉可能存在的旧定时器, 并**不**注册新定时器
                        hlCode = hlCode + "clearTimeout(window.__MCP_HL_TIMER__);window.__MCP_HL_TIMER__=null;return JSON.stringify({highlighted:els.length,auto_clear_ms:0,no_auto_clear:true});})()"
                    }
                    否则
                    {
                        hlCode = hlCode + "clearTimeout(window.__MCP_HL_TIMER__);window.__MCP_HL_TIMER__=setTimeout(function(){var a=window.__MCP_HL__||[];for(var k=0;k<a.length;k++){var q=a[k];if(q&&q.__mcpOrigOutline!==undefined){q.style.outline=q.__mcpOrigOutline;q.style.outlineOffset=q.__mcpOrigOffset;delete q.__mcpOrigOutline;delete q.__mcpOrigOffset;}}window.__MCP_HL__=[];},"
                        hlCode = hlCode + 到文本 (hlDur) + ");return JSON.stringify({highlighted:els.length,auto_clear_ms:" + 到文本 (hlDur) + "});})()"
                    }
                }
                变量 hlWanted <类型 = 整数>
                hlWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 hlTaskID <类型 = 文本型>
                hlTaskID = MCP命令服务器.生成异步任务ID ()
                变量 hlSubmit <类型 = 文本型>
                hlSubmit = MCP命令服务器.提交异步JS任务 (hlBrowser, hlCode, hlTaskID)
                如果 (是否以 (hlSubmit, "{\"error\""))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效 + " | " + hlSubmit))
                }
                变量 hlStore <类型 = 文本型>
                hlStore = MCP命令服务器.同步等待异步任务 (hlTaskID, hlWanted)
                如果 (hlStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "高亮执行超时"))
                }
                变量 hlWrap <类型 = YYJSON只读对象类>
                如果 (hlWrap.创建自文本 (hlStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (hlWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "高亮执行错误: " + MCP命令服务器.yyjson取文本 (hlWrap, "error")))
                    }
                    变量 hlMsg <类型 = 文本型>
                    hlMsg = MCP命令服务器.yyjson取文本 (hlWrap, "message")
                    如果 (hlMsg != "")
                    {
                        变量 hlData <类型 = YYJSON对象类>
                        hlData.创建自文本 ("{}")
                        hlData.加入逻辑值成员 ("success", 真)
                        hlData.加入文本成员 ("result_json", hlMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, hlData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "高亮结果解析失败"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 滚动控制 (JS通道同步, AI翻页采集) ===
        否则 (方法名 == "browser_get_scroll")
        {
            变量 gsBrowser <类型 = 类_FBrowser_浏览器>
            gsBrowser = MCP命令服务器.取主浏览器 ()
            如果 (gsBrowser.是否为空 () == 假 && gsBrowser.是否已关闭 () == 假)
            {
                变量 gsSel <类型 = 文本型>
                gsSel = MCP命令服务器.简单转义JS (MCP命令服务器.yyjson取文本 (参数JSON, "selector"))
                变量 gsCode <类型 = 文本型>
                如果 (gsSel != "")
                {
                    gsCode = "(function(){var el=document.querySelector('" + gsSel + "');if(!el)return JSON.stringify({error:'selector_not_found'});return JSON.stringify({x:el.scrollLeft,y:el.scrollTop,max_y:el.scrollHeight-el.clientHeight,max_x:el.scrollWidth-el.clientWidth});})()"
                }
                否则
                {
                    gsCode = "(function(){var x=window.pageXOffset||document.documentElement.scrollLeft||0;var y=window.pageYOffset||document.documentElement.scrollTop||0;return JSON.stringify({x:x,y:y,max_y:(document.documentElement.scrollHeight-document.documentElement.clientHeight)||0,max_x:(document.documentElement.scrollWidth-document.documentElement.clientWidth)||0});})()"
                }
                变量 gsWanted <类型 = 整数>
                gsWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 gsTaskID <类型 = 文本型>
                gsTaskID = MCP命令服务器.生成异步任务ID ()
                变量 gsSubmit <类型 = 文本型>
                gsSubmit = MCP命令服务器.提交异步JS任务 (gsBrowser, gsCode, gsTaskID)
                如果 (是否以 (gsSubmit, "{\"error\""))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
                }
                变量 gsStore <类型 = 文本型>
                gsStore = MCP命令服务器.同步等待异步任务 (gsTaskID, gsWanted)
                如果 (gsStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "滚动位置查询超时"))
                }
                变量 gsWrap <类型 = YYJSON只读对象类>
                如果 (gsWrap.创建自文本 (gsStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (gsWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "查询错误: " + MCP命令服务器.yyjson取文本 (gsWrap, "error")))
                    }
                    变量 gsMsg <类型 = 文本型>
                    gsMsg = MCP命令服务器.yyjson取文本 (gsWrap, "message")
                    如果 (gsMsg != "")
                    {
                        变量 gsData <类型 = YYJSON对象类>
                        gsData.创建自文本 ("{}")
                        gsData.加入逻辑值成员 ("success", 真)
                        gsData.加入文本成员 ("scroll_json", gsMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, gsData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "滚动位置解析失败"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_scroll_by")
        {
            变量 sbBrowser <类型 = 类_FBrowser_浏览器>
            sbBrowser = MCP命令服务器.取主浏览器 ()
            如果 (sbBrowser.是否为空 () == 假 && sbBrowser.是否已关闭 () == 假)
            {
                变量 sbX <类型 = 整数>
                sbX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                变量 sbY <类型 = 整数>
                sbY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                如果 (MCP命令服务器.参数键存在 (参数JSON, "y") == 假 && MCP命令服务器.参数键存在 (参数JSON, "x") == 假)
                {
                    // 仅当 x/y 两轴都未传时才用文档声明的默认值(向下 800); 显式传 0 按 0 执行(不滚动)
                    sbY = 800
                }
                变量 sbSmooth <类型 = 逻辑型>
                sbSmooth = MCP命令服务器.yyjson取逻辑 (参数JSON, "smooth")
                变量 sbCode <类型 = 文本型>
                sbCode = "(function(){window.scrollBy({left:" + 到文本 (sbX) + ",top:" + 到文本 (sbY) + ",behavior:" + 选择 (sbSmooth, "'smooth'", "'auto'") + "});var x=window.pageXOffset||document.documentElement.scrollLeft||0;var y=window.pageYOffset||document.documentElement.scrollTop||0;return JSON.stringify({x:x,y:y,scrolled_by_x:" + 到文本 (sbX) + ",scrolled_by_y:" + 到文本 (sbY) + "});})()"
                变量 sbWanted <类型 = 整数>
                sbWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 sbTaskID <类型 = 文本型>
                sbTaskID = MCP命令服务器.生成异步任务ID ()
                变量 sbSubmit <类型 = 文本型>
                sbSubmit = MCP命令服务器.提交异步JS任务 (sbBrowser, sbCode, sbTaskID)
                如果 (是否以 (sbSubmit, "{\"error\""))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
                }
                变量 sbStore <类型 = 文本型>
                sbStore = MCP命令服务器.同步等待异步任务 (sbTaskID, sbWanted)
                如果 (sbStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "滚动超时"))
                }
                变量 sbWrap <类型 = YYJSON只读对象类>
                如果 (sbWrap.创建自文本 (sbStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (sbWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "滚动错误: " + MCP命令服务器.yyjson取文本 (sbWrap, "error")))
                    }
                    变量 sbMsg <类型 = 文本型>
                    sbMsg = MCP命令服务器.yyjson取文本 (sbWrap, "message")
                    如果 (sbMsg != "")
                    {
                        变量 sbData <类型 = YYJSON对象类>
                        sbData.创建自文本 ("{}")
                        sbData.加入逻辑值成员 ("success", 真)
                        sbData.加入文本成员 ("scroll_json", sbMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, sbData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "滚动结果解析失败"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 按快照索引操作 (snapshot的data-mcp-id闭环, 免手写选择器) ===
        否则 (方法名 == "browser_element_action")
        {
            变量 eaIndex <类型 = 整数>
            eaIndex = MCP命令服务器.yyjson取整数 (参数JSON, "index")
            如果 (MCP命令服务器.参数键存在 (参数JSON, "index") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "index 不能省略 | 它指向 browser_snapshot 返回的 i 字段; 省略会被当成 0 而**误点快照里的第 0 个元素** | 请先 browser_snapshot 取索引, 再显式传 index"))
            }
            变量 eaAction <类型 = 文本型>
            eaAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (eaAction == "")
            {
                eaAction = "click"
            }
            变量 eaBrowser <类型 = 类_FBrowser_浏览器>
            eaBrowser = MCP命令服务器.取主浏览器 ()
            如果 (eaBrowser.是否为空 () == 假 && eaBrowser.是否已关闭 () == 假)
            {
                变量 eaVal <类型 = 文本型>
                eaVal = MCP命令服务器.简单转义JS (MCP命令服务器.yyjson取文本 (参数JSON, "value"))
                变量 eaCode <类型 = 文本型>
                eaCode = "(function(){var el=document.querySelector('[data-mcp-id=\\'m" + 到文本 (eaIndex) + "\\']');if(!el)return JSON.stringify({ok:false,error:'index_not_found(请重新browser_snapshot, 快照索引随页面刷新失效)',index:" + 到文本 (eaIndex) + "});"
                eaCode = eaCode + "var r=el.getBoundingClientRect();var cx=r.left+r.width/2,cy=r.top+r.height/2;"
                如果 (eaAction == "click")
                {
                    eaCode = eaCode + "function fire(t){el.dispatchEvent(new MouseEvent(t,{bubbles:true,cancelable:true,view:window,clientX:cx,clientY:cy}));}fire('mouseover');fire('mousedown');fire('mouseup');fire('click');"
                }
                否则 (eaAction == "set_value")
                {
                    eaCode = eaCode + "try{el.focus();var n=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value');if(n&&n.set)n.set.call(el,'" + eaVal + "');else el.value='" + eaVal + "';el.dispatchEvent(new InputEvent('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));}catch(x){el.value='" + eaVal + "';}"
                }
                否则 (eaAction == "focus")
                {
                    eaCode = eaCode + "el.focus();el.scrollIntoView({block:'center'});"
                }
                否则 (eaAction == "scroll")
                {
                    eaCode = eaCode + "el.scrollIntoView({block:'center',behavior:'smooth'});"
                }
                否则 (eaAction == "get_value")
                {
                    eaCode = eaCode + "return JSON.stringify({ok:true,action:'get_value',value:el.value||el.innerText||''});"
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + eaAction + " | 支持: click/set_value/focus/scroll/get_value"))
                }
                eaCode = eaCode + "return JSON.stringify({ok:true,action:'" + eaAction + "',tag:el.tagName.toLowerCase(),text:(el.innerText||el.value||'').replace(/\\s+/g,' ').trim().substring(0,60)});})()"
                变量 eaWanted <类型 = 整数>
                eaWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 eaTaskID <类型 = 文本型>
                eaTaskID = MCP命令服务器.生成异步任务ID ()
                变量 eaSubmit <类型 = 文本型>
                eaSubmit = MCP命令服务器.提交异步JS任务 (eaBrowser, eaCode, eaTaskID)
                如果 (是否以 (eaSubmit, "{\"error\""))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
                }
                变量 eaStore <类型 = 文本型>
                eaStore = MCP命令服务器.同步等待异步任务 (eaTaskID, eaWanted)
                如果 (eaStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "元素操作超时"))
                }
                变量 eaWrap <类型 = YYJSON只读对象类>
                如果 (eaWrap.创建自文本 (eaStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (eaWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "操作错误: " + MCP命令服务器.yyjson取文本 (eaWrap, "error")))
                    }
                    变量 eaMsg <类型 = 文本型>
                    eaMsg = MCP命令服务器.yyjson取文本 (eaWrap, "message")
                    如果 (eaMsg != "")
                    {
                        变量 eaData <类型 = YYJSON对象类>
                        eaData.创建自文本 ("{}")
                        eaData.加入逻辑值成员 ("success", 真)
                        eaData.加入文本成员 ("result_json", eaMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, eaData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "操作结果解析失败"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        返回 ("")  // 链末: 交给 分类分派_填表操作 / 分类分派_系统操作
    }

    #
}
