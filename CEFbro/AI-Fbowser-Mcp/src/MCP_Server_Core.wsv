<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# MCP_核心分派 — 从 MCP_Server.wsv 拆分 (L5)

类 MCP_核心分派 <公开 @全局类 = 真 @输出名 = "MCPCoreDispatch">
{

    # ⚠ 方言坑(实测代价高): 这两个方法最初写成单行 `如果 (c) { 返回 (x) }`, 火山**不接受**;
    #   症状不是本行报错, 而是**整个类构建失败** —— 编译器随后在别的文件里报
    #   `没有找到"MCP_核心分派"` 之类的级联错误, 从报错位置根本看不出真因。
    #   故本文件里所有 if 块一律写多行形式。
    # === 清理缓存的对象/类型掩码: 单项名称 → 类库常量 ===
    # 为什么拆成"单项"而不是一次解析整串: 火山没有按引用输出参数, 无法在一次调用里同时回传
    # "掩码"与"哪个名字不认识"。故这里只做单项映射(未知返回 -1), 由调用方分词、累加、并在遇到 -1 时
    # 如实报出是哪个名字不认识(而不是静默忽略 —— 静默忽略会让"清一半"看起来像"清成功")。

    方法 取清理对象掩码 <公开 静态 类型 = 长整数 注释 = "把单个清理对象名映射为类库 清理缓存.* 掩码; 名称无法识别返回 -1" @输出名 = "GetClearTargetMask" @强制输出 = 真>
    参数 单项名称 <类型 = 文本型 @输出名 = "ItemName">
    {
        变量 名 <类型 = 文本型>
        名 = 到小写 (单项名称)
        如果 (名 == "appcache")
        {
            返回 (清理缓存.Appcache)
        }
        如果 (名 == "cookies")
        {
            返回 (清理缓存.Cookies)
        }
        如果 (名 == "filesystem")
        {
            返回 (清理缓存.FileSystem)
        }
        如果 (名 == "indexeddb")
        {
            返回 (清理缓存.IndexedDB)
        }
        如果 (名 == "localstorage")
        {
            返回 (清理缓存.LocalStorage)
        }
        如果 (名 == "shadercache")
        {
            返回 (清理缓存.ShaderCache)
        }
        如果 (名 == "websql")
        {
            返回 (清理缓存.WebSql)
        }
        如果 (名 == "serviceworkers")
        {
            返回 (清理缓存.ServiceWorkers)
        }
        如果 (名 == "cachestorage")
        {
            返回 (清理缓存.CacheStorage)
        }
        如果 (名 == "pluginprivatedata")
        {
            返回 (清理缓存.PluginPrivateData)
        }
        如果 (名 == "backgroundfetch")
        {
            返回 (清理缓存.BackGroundFetch)
        }
        如果 (名 == "conversions")
        {
            返回 (清理缓存.Conversions)
        }
        如果 (名 == "all" || 名 == "全部")
        {
            返回 (清理缓存.全部)
        }
        返回 (-1)
    }

    方法 取缓存类型掩码 <公开 静态 类型 = 长整数 注释 = "把单个存储类型名映射为类库 缓存类型.* 掩码; 名称无法识别返回 -1" @输出名 = "GetStorageTypeMask" @强制输出 = 真>
    参数 单项名称 <类型 = 文本型 @输出名 = "ItemName">
    {
        变量 名 <类型 = 文本型>
        名 = 到小写 (单项名称)
        如果 (名 == "temporary" || 名 == "临时")
        {
            返回 (缓存类型.临时)
        }
        如果 (名 == "persistent" || 名 == "永久")
        {
            返回 (缓存类型.永久)
        }
        如果 (名 == "syncable" || 名 == "可用")
        {
            返回 (缓存类型.可用)
        }
        如果 (名 == "all" || 名 == "全部")
        {
            返回 (缓存类型.全部)
        }
        返回 (-1)
    }

    # 清理范围解析(对象/类型两个逗号列表 → 位掩码): browser_clear_cache 与 browser_clear_cache_browser 共用
    # (同一逻辑只留一份)。返回 JSON {mask, error}; error 非空表示整体失败(不静默忽略坏名字)。

    方法 解析清理掩码列表 <公开 静态 类型 = 文本型 @输出名 = "ParseClearMaskList" @强制输出 = 真>
    参数 逗号列表 <类型 = 文本型 @输出名 = "CSV">
    参数 列表种类 <类型 = 文本型 @输出名 = "ListKind">
    {
        变量 掩码合计 <类型 = 长整数 值 = 0>
        变量 坏名 <类型 = 文本型>
        如果 (逗号列表 != "")
        {
            变量 清理令牌组 <类型 = 文本数组类>
            分割文本 (逗号列表, ",", 清理令牌组, 真, 真)
            计次循环 (清理令牌组.取成员数 ())
            {
                变量 单项掩码 <类型 = 长整数>
                单项掩码 = -1
                如果 (列表种类 == "targets")
                {
                    单项掩码 = 取清理对象掩码 (清理令牌组.取成员 (取循环索引 ()))
                }
                否则
                {
                    单项掩码 = 取缓存类型掩码 (清理令牌组.取成员 (取循环索引 ()))
                }
                如果 (单项掩码 < 0)
                {
                    坏名 = 清理令牌组.取成员 (取循环索引 ())
                }
                否则
                {
                    掩码合计 = 掩码合计 + 单项掩码
                }
            }
        }
        返回 ("{\"mask\":" + 到文本 (掩码合计) + ",\"error\":\"" + MCP_响应构建.JSON转义文本 (坏名) + "\"}")
    }

    # === 分类分派: 核心操作 (导航/内容/JS/DevTools/窗口管理) ===

    方法 分类分派_核心操作 <公开 静态 类型 = 文本型 @输出名 = "DispatchClassCore" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        // 名称规范化已由执行浏览器命令入口统一处理, 此处省略
        如果 (方法名 == "browser_navigate")
        {
            变量 url <类型 = 文本型>
            url = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (url != "")
            {
                // 安全: 允许 http/https/about/ftp; data: 仅图片 MIME(见 验证URL安全 的白名单)
                如果 (MCP命令服务器.验证URL安全 (url) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_不支持的URL协议))
                }
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 navFrame <类型 = 类_FBrowser_框架>
                    navFrame = MCP命令服务器.取安全主框架 (browser)
                    如果 (navFrame.是否为空 () == 假 && navFrame.是否有效 ())
                    {
                        // 提交式跳转(补类库 载入请求 缺口): 给了 method(非GET)/headers/body 时用自定义请求载入。
                        // 此时**不能走同址快速路径** —— 即使地址相同也必须真的发一次(否则"重放提交"静默变成不做事)。
                        变量 nav方法 <类型 = 文本型>
                        nav方法 = MCP命令服务器.yyjson取文本 (参数JSON, "method")
                        变量 nav头 <类型 = 文本型>
                        nav头 = MCP命令服务器.yyjson取文本 (参数JSON, "headers")
                        变量 nav体 <类型 = 文本型>
                        nav体 = MCP命令服务器.yyjson取文本 (参数JSON, "body")
                        变量 需要自定义请求 <类型 = 逻辑型>
                        需要自定义请求 = nav头 != "" || nav体 != ""
                        如果 (nav方法 != "" && nav方法 != "GET")
                        {
                            需要自定义请求 = 真
                        }
                        如果 (需要自定义请求)
                        {
                            变量 请求发起毫秒 <类型 = 长整数>
                            请求发起毫秒 = 取启动时间 ()
                            变量 载入码 <类型 = 整数>
                            载入码 = MCP命令服务器.载入框架请求 (navFrame, url, nav方法, nav头, nav体)
                            如果 (载入码 != 0)
                            {
                                如果 (载入码 == -1)
                                {
                                    返回 (MCP_响应构建.命令失败 (命令ID, "载入请求失败: 主框架无效"))
                                }
                                返回 (MCP_响应构建.命令失败 (命令ID, "载入请求失败: url 为空"))
                            }
                            变量 实际方法文本 <类型 = 文本型>
                            实际方法文本 = nav方法
                            如果 (实际方法文本 == "")
                            {
                                如果 (nav体 != "")
                                {
                                    实际方法文本 = "POST"
                                }
                                否则
                                {
                                    实际方法文本 = "GET"
                                }
                            }
                            变量 waitLoadReq <类型 = 逻辑型>
                            waitLoadReq = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                            如果 (waitLoadReq && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                            {
                                返回 (MCP命令服务器.注册加载等待任务 (命令ID, 参数JSON, browser, "等待提交式跳转完成: " + 实际方法文本 + " " + url, "已用自定义请求提交: " + 实际方法文本 + " " + url + " | 等待载入完成, 通过mcp_result查询", 请求发起毫秒))
                            }
                            返回 (MCP_响应构建.命令成功 (命令ID, "已用自定义请求提交: " + 实际方法文本 + " " + url))
                        }
                        // 同址导航: 主框架已在目标URL且未在加载时直接返回成功(载入地址前判等, 无竞态);
                        // 否则依赖后续load事件或超时, 快速路径避免30s无谓等待
                        如果 (navFrame.取地址 () == url && 浏览器容器.取加载状态 () == 假)
                        {
                            返回 (MCP_响应构建.命令成功 (命令ID, "已在目标页面: " + url + " | 未重复导航"))
                        }
                        // 记录导航发起时刻(载入地址前), 供注册加载等待任务判序load_end是否属于本次导航
                        变量 导航发起毫秒 <类型 = 长整数>
                        导航发起毫秒 = 取启动时间 ()
                        navFrame.载入地址 (url)
                        // wait_for_load 默认真: AI导航后立即操作DOM/填表, 等待载入完成大幅提升成功率
                        // 传 "false"/"0" 或 async_only:true 可跳过等待
                        // 注: 缺失键必须保持默认真 (取逻辑对缺失键返回假, 老式文本判断会把默认翻成假)
                        变量 waitLoad <类型 = 逻辑型>
                        waitLoad = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                        如果 (waitLoad && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                        {
                            返回 (MCP命令服务器.注册加载等待任务 (命令ID, 参数JSON, browser, "等待导航完成: " + url, "已导航到: " + url + " | 等待载入完成, 通过mcp_result查询", 导航发起毫秒))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, "已导航到: " + url))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 url 不能为空"))
        }
        否则 (方法名 == "browser_get_url")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 urlFrame <类型 = 类_FBrowser_框架>
                urlFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (urlFrame.是否为空 () == 假 && urlFrame.是否有效 ())
                {
                    返回 (MCP_响应构建.构建简单JSON ("url", urlFrame.取地址 ()))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_get_title")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // 原生路径: CEF OnTitleChange 事件缓存 (async_only时走JS回退)
                如果 (浏览器容器.取页面标题 () != "" && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                {
                    返回 (MCP_响应构建.构建简单JSON ("title", 浏览器容器.取页面标题 ()))
                }
                // 回退: 缓存为空时走异步JS (页面尚未触发标题事件)
                变量 异步标题ID <类型 = 文本型>
                异步标题ID = MCP命令服务器.生成异步任务ID ()
                MCP命令服务器.提交异步JS任务 (browser, "document.title", 异步标题ID)
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步标题ID, "标题获取已提交(页面缓存为空, 已异步回退) | 通过 mcp_result {request_id:'" + 异步标题ID + "'} 查询结果", 150))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 导航控制 ===
        否则 (方法名 == "browser_back")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.可否后退 ())
            {
                // 与 navigate/reload 同款: **载入前**记录发起时刻, 供 注册加载等待任务 判序
                // load_end 是否属于本次历史导航(否则会把上一次的 load_end 误当成本次完成)。
                变量 后退发起毫秒 <类型 = 长整数>
                后退发起毫秒 = 取启动时间 ()
                browser.后退 ()
                变量 bkWaitLoad <类型 = 逻辑型>
                bkWaitLoad = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                如果 (bkWaitLoad && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                {
                    返回 (MCP命令服务器.注册加载等待任务 (命令ID, 参数JSON, browser, "等待后退完成", "已后退 | 等待载入完成, 通过mcp_result查询", 后退发起毫秒))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "已后退"))
            }
            如果 (browser.是否为空 () == 真)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "无法后退 — 无导航历史 | 当前页面没有可后退的历史记录"))
        }
        否则 (方法名 == "browser_forward")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.可否前进 ())
            {
                // 同 后退: 记录发起时刻后再前进, 交由 注册加载等待任务 等待本次载入完成
                变量 前进发起毫秒 <类型 = 长整数>
                前进发起毫秒 = 取启动时间 ()
                browser.前进 ()
                变量 fwWaitLoad <类型 = 逻辑型>
                fwWaitLoad = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                如果 (fwWaitLoad && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                {
                    返回 (MCP命令服务器.注册加载等待任务 (命令ID, 参数JSON, browser, "等待前进完成", "已前进 | 等待载入完成, 通过mcp_result查询", 前进发起毫秒))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "已前进"))
            }
            如果 (browser.是否为空 () == 真)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "无法前进 — 无导航历史 | 当前页面没有可前进的历史记录"))
        }
        否则 (方法名 == "browser_reload")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 忽略缓存 <类型 = 逻辑型>
                忽略缓存 = MCP命令服务器.yyjson取逻辑 (参数JSON, "ignore_cache")
                // 记录重载发起时刻(重新载入前), 供注册加载等待任务判序load_end是否属于本次刷新
                变量 重载发起毫秒 <类型 = 长整数>
                重载发起毫秒 = 取启动时间 ()
                如果 (忽略缓存)
                {
                    browser.重新载入_忽略缓存 ()
                }
                否则
                {
                    browser.重新载入 ()
                }
                // wait_for_load 默认真 (同navigate, "false"/"0"或async_only:true跳过)
                // 注: 缺失键必须保持默认真
                变量 relWaitLoad <类型 = 逻辑型>
                relWaitLoad = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "wait_for_load", 真)
                如果 (relWaitLoad && MCP命令服务器.yyjson取逻辑 (参数JSON, "async_only") == 假)
                {
                    返回 (MCP命令服务器.注册加载等待任务 (命令ID, 参数JSON, browser, "等待刷新完成", "页面已刷新 | 等待载入完成, 通过mcp_result查询", 重载发起毫秒))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "页面已刷新"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_stop")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.停止载入 ()
                返回 (MCP_响应构建.命令成功 (命令ID, "加载已停止"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === JS执行 ===
        否则 (方法名 == "browser_execute_js")
        {
            变量 code <类型 = 文本型>
            code = MCP命令服务器.解码JS代码 (参数JSON)
            如果 (code == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未能取得要执行的 JS: 三种传法都试过了 | ① code(内联字符串) ② code_base64(Base64, 免转义) ③ file(文件路径) —— **file 仅允许进程运行目录内的文件**(安全守卫), 目录外路径会被拒绝; 若你确实给了 file 却看到本错误, 请把脚本放到运行目录下, 或改用 code/code_base64 | 另: file 指向的文件必须存在且非空"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // frame_id: CEF 框架ID(`6-XXXX`) / 框架名 / 框架序号 三选一, 缺省为主框架。
                // 契约: 解析不出来时**明确报错**, 绝不静默回退主框架(那会在错误的框架里执行用户代码)。
                变量 目标框架 <类型 = 文本型>
                目标框架 = MCP命令服务器.yyjson取文本 (参数JSON, "frame_id")
                如果 (目标框架 != "")
                {
                    // 子框架执行有两条路, 产出的"世界"不同, 故必须由调用方显式选择并如实说明:
                    //   world 缺省/isolated: CDP **隔离世界** —— 同步、重复调用稳定(本机 12/12),
                    //       DOM 可达; 但**页面自己在子框架里挂的全局变量/函数一律不可见**
                    //       (实测: 隔离世界里 String(window.<页面全局>) 恒 undefined, 页面定义的函数 typeof 也不是函数)。
                    //   world=main: 原生 CEF 框架对象 —— 在**该框架自己的页面主世界**求值(页面全局可读写),
                    //       但走的是原生"带返回值 JS"通道, 实测约 8% 概率回调丢失 -> 5s 超时
                    //       (同一现象在主框架的 browser_evaluate 上同样存在, 属该通道固有性质, 非本功能引入);
                    //       偶发超时后通道会短暂连带失败, 单次重试通常即可恢复。
                    变量 目标世界 <类型 = 文本型>
                    目标世界 = MCP命令服务器.yyjson取文本 (参数JSON, "world")
                    如果 (目标世界 == "main" || 目标世界 == "主世界")
                    {
                        变量 框架对象 <类型 = 类_FBrowser_框架>
                        框架对象 = MCP命令服务器.解析框架对象 (browser, 目标框架)
                        如果 (框架对象.是否为空 () || 框架对象.是否有效 () == 假)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "未找到框架: " + 目标框架 + " | 请先用 browser_get_frames 取当前框架清单(其 id / name / 序号 都可作为 frame_id); 主框架请省略 frame_id 或传 main"))
                        }
                        变量 框架JS_ID <类型 = 文本型>
                        框架JS_ID = MCP命令服务器.生成异步任务ID ()
                        变量 框架预占位 <类型 = YYJSON对象类>
                        框架预占位.创建自文本 ("{}")
                        框架预占位.加入逻辑值成员 ("_waiting", 真)
                        框架预占位.加入文本成员 ("what", "js_exec")
                        框架预占位.加入文本成员 ("message", "JS执行中...")
                        框架预占位.加入长整数成员 ("start_time", 取启动时间 ())
                        框架预占位.加入整数成员 ("max_ms", MCP_常量.同步等待_JS执行超时)
                        框架预占位.加入整数成员 ("_browser_id", browser.取ID ())
                        MCP命令服务器.存储异步结果 (框架JS_ID, 框架预占位.到可读文本 (YYJSON格式化选项.压缩), browser.取ID ())
                        变量 框架JS回调 <类型 = 类_FBrowser_事件智能指针>
                        框架JS回调.创建 (类_MCP_JS异步回调)
                        框架JS回调.取执行类 (类_MCP_JS异步回调).任务ID = 框架JS_ID
                        框架对象.执行JS代码_带返回值 (code, "", 0, 框架JS回调)
                        // browser_execute_js 在 应同步等待 白名单里, 故本回执会被外层同步等待成真正的结果(一次调用拿到值)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 框架JS_ID, "已在子框架(" + 目标框架 + ")内提交执行(该框架自己的页面主世界)"))
                    }
                    变量 框架上下文 <类型 = 整数>
                    框架上下文 = MCP命令服务器.解析框架执行上下文 (browser, 目标框架)
                    如果 (框架上下文 == -1)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "未找到框架: " + 目标框架 + " | 请先用 browser_get_frames 取当前框架清单(其 id / name / 序号 都可作为 frame_id); 主框架请省略 frame_id 或传 main | 不会回退到主框架执行(否则会在错误的框架里跑你的代码)"))
                    }
                    变量 子框架值 <类型 = 文本型>
                    子框架值 = MCP命令服务器.CDP执行JS并等待 (code, MCP_常量.同步等待_JS执行超时, 真, 框架上下文)
                    如果 (是否以 (子框架值, "{\"error\":\"JS异常:"))
                    {
                        变量 子异常解析 <类型 = YYJSON只读对象类>
                        变量 子异常文本 <类型 = 文本型>
                        如果 (子异常解析.创建自文本 (子框架值))
                        {
                            子异常文本 = MCP命令服务器.yyjson取文本 (子异常解析, "error")
                        }
                        如果 (子异常文本 == "")
                        {
                            子异常文本 = 子框架值
                        }
                        返回 (MCP_响应构建.命令失败 (命令ID, 子异常文本 + " | 该异常由你提供的 code 在框架(" + 目标框架 + ")内抛出, 属终局结论"))
                    }
                    // 约束: 子框架模式**不走主框架回退**(回退只支持主框架, 会把代码放到错误框架里跑);
                    // 另: 求值结果为 undefined/null 是**合法值**(隔离世界里读页面全局必然如此), 不当作通道失败。
                    如果 (子框架值 == "" || 是否以 (子框架值, "{\"error\""))
                    {
                        如果 (子框架值 == "")
                        {
                            子框架值 = "CDP 无回执(通道不可用), 且该框架已禁用原生回退(原生只支持主框架, 会跑错框架)"
                        }
                        返回 (MCP_响应构建.命令失败 (命令ID, "子框架(" + 目标框架 + ")内求值失败: " + 子框架值))
                    }
                    返回 (MCP_响应构建.命令成功 (命令ID, 子框架值))
                }
                变量 CDP值 <类型 = 文本型>
                CDP值 = MCP命令服务器.CDP执行JS并等待 (code, MCP_常量.同步等待_JS执行超时, 真)
                // ★ 契约(正确性+副作用安全, 实测): CDP 已**明确**报出"用户 JS 抛异常"时, 该结论是终局的。
                //   若与"CDP 通道不可用"共用同一条判据(只要以 {"error" 开头就继续往下走原生回退),
                //   于是用户代码抛错会: ①真原因被丢弃 ②**在原生路径上再执行一次**(副作用跑两遍)
                //   ③最终报成与原因无关的 "[无法序列化的值]"。
                //   实测: browser_execute_js {code:"throw new Error(...)"} 就是这样掩盖了异常原因的。
                //   注: "CDP执行失败:" 等通道类错误仍照旧回退 —— 那才是回退存在的意义。
                如果 (是否以 (CDP值, "{\"error\":\"JS异常:"))
                {
                    变量 cdp异常解析 <类型 = YYJSON只读对象类>
                    变量 cdp异常文本 <类型 = 文本型>
                    如果 (cdp异常解析.创建自文本 (CDP值))
                    {
                        cdp异常文本 = MCP命令服务器.yyjson取文本 (cdp异常解析, "error")
                    }
                    如果 (cdp异常文本 == "")
                    {
                        cdp异常文本 = CDP值
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, cdp异常文本 + " | 该异常由你提供的 code 抛出, 属终局结论: CDP 已明确回答, 未再走原生回退(避免把 code 重复执行一遍)"))
                }
                如果 (CDP值 != "" && CDP值 != "undefined" && 是否以 (CDP值, "{\"error\"") == 假)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, CDP值))
                }
                // === 以下为原生回退链路 ===
                变量 execFrame <类型 = 类_FBrowser_框架>
                execFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (execFrame.是否为空 () == 假 && execFrame.是否有效 ())
                {
                    变量 异步JSID <类型 = 文本型>
                    异步JSID = MCP命令服务器.生成异步任务ID ()
                    // 预存pending占位 — 即使CEF回调因页面变化丢失, 任务也不"消失"
                    变量 预占位 <类型 = YYJSON对象类>
                    预占位.创建自文本 ("{}")
                    预占位.加入逻辑值成员 ("_waiting", 真)
                    预占位.加入文本成员 ("what", "js_exec")
                    预占位.加入文本成员 ("message", "JS执行中...")
                    预占位.加入长整数成员 ("start_time", 取启动时间 ())
                    预占位.加入整数成员 ("max_ms", MCP_常量.同步等待_JS执行超时)
                    预占位.加入整数成员 ("_browser_id", browser.取ID ())
                    MCP命令服务器.存储异步结果 (异步JSID, 预占位.到可读文本 (YYJSON格式化选项.压缩), browser.取ID ())
                    变量 JS回调 <类型 = 类_FBrowser_事件智能指针>
                    JS回调.创建 (类_MCP_JS异步回调)
                    JS回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步JSID
                    execFrame.执行JS代码_带返回值 (code, "", 0, JS回调)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步JSID, "JS已提交执行, 通过mcp_result查询结果"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_evaluate")
        {
            变量 code <类型 = 文本型>
            code = MCP命令服务器.解码JS代码 (参数JSON)
            如果 (code == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未能取得要执行的 JS: 三种传法都试过了 | ① code(内联字符串) ② code_base64(Base64, 免转义) ③ file(文件路径) —— **file 仅允许进程运行目录内的文件**(安全守卫), 目录外路径会被拒绝; 若你确实给了 file 却看到本错误, 请把脚本放到运行目录下, 或改用 code/code_base64 | 另: file 指向的文件必须存在且非空"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // CDP 优先(与 browser_execute_js 主框架同款, 实测 0.02~0.05s 稳定): 旧实现走原生
                // "带返回值JS"通道, 实测约 8% 概率回调丢失 → 5s 超时(execute_js 注释同证), 与
                // "一次稳定调用成功"冲突; 原生通道降级为 CDP 不可用时的回退。
                变量 CDP值 <类型 = 文本型>
                CDP值 = MCP命令服务器.CDP执行JS并等待 (code, MCP_常量.同步等待_JS执行超时, 真)
                如果 (是否以 (CDP值, "{\"error\":\"JS异常:"))
                {
                    变量 cdp异常解析 <类型 = YYJSON只读对象类>
                    变量 cdp异常文本 <类型 = 文本型>
                    如果 (cdp异常解析.创建自文本 (CDP值))
                    {
                        cdp异常文本 = MCP命令服务器.yyjson取文本 (cdp异常解析, "error")
                    }
                    如果 (cdp异常文本 == "")
                    {
                        cdp异常文本 = CDP值
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, cdp异常文本 + " | 该异常由你提供的 code 抛出, 属终局结论"))
                }
                如果 (CDP值 != "" && CDP值 != "undefined" && 是否以 (CDP值, "{\"error\"") == 假)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, CDP值))
                }
                变量 rawResult <类型 = 文本型>
                rawResult = MCP命令服务器.提交异步JS任务 (browser, code)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, rawResult, "result", "JS执行已提交"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 页面内容 ===
        否则 (方法名 == "browser_get_source")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 maxChars <类型 = 整数>
                maxChars = MCP命令服务器.yyjson取整数 (参数JSON, "max_chars")
                如果 (maxChars <= 0 || maxChars > MCP_常量.截断_源码最大字节)
                {
                    maxChars = MCP_常量.截断_源码默认字节
                }
                变量 source <类型 = 文本型>
                source = MCP命令服务器.提交异步取源码任务 (browser, , maxChars)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, source, "source", "源码获取已提交(max=" + 到文本 (maxChars) + ")"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_get_text")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 selector <类型 = 文本型>
                selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
                如果 (selector != "")
                {
                    // 加前缀哨兵: 元素**存在但文本本来就是空**时, 直接返回 "" 会与"读不到"无法区分,
                    // 于是被判成失败、退到原生填表框架, 而那条路对第二个浏览器会给出字面 null。
                    // 用 __MCP_TEXT__ 前缀把"读到了空串"与"没读到"彻底分开。
                    变量 js取文码 <类型 = 文本型>
                    js取文码 = "(function(){var e=document.querySelector('" + MCP命令服务器.简单转义JS (selector) + "');if(!e)return '__MCP_NO_ELEM__';var t=e.textContent;return '__MCP_TEXT__'+String(t===null||t===undefined?'':t)})()"
                    变量 js取文值 <类型 = 文本型>
                    js取文值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js取文码, 10000)
                    如果 (js取文值 == "__MCP_NO_ELEM__")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                    }
                    如果 (是否以 (js取文值, "__MCP_TEXT__"))
                    {
                        // 去掉哨兵前缀: 空文本如实返回空串(不再退化成 null)
                        返回 (MCP_响应构建.命令成功 (命令ID, 取文本右边 (js取文值, 取文本长度 (js取文值) - 取文本长度 ("__MCP_TEXT__"))))
                    }
                    // 约束: 指定了子框架时**到此为止**。下面的原生链路(原生执行JS并等待 / 填表框架 / 异步回执)
                    // 都不看 frame_id, 一律去主框架取值 —— 那会让"带了 frame_id 却读到主框架内容"这种
                    // 最难发现的假答案通过。故这里把 CDP 的报错(含"未找到框架")原样上报。
                    变量 gt子框架 <类型 = 文本型>
                    gt子框架 = MCP命令服务器.yyjson取文本 (参数JSON, "frame_id")
                    如果 (gt子框架 != "" && gt子框架 != "main" && gt子框架 != "主框架")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "子框架(" + gt子框架 + ")内取文本失败: " + 取文本左边 (js取文值, 300) + " | 已在回退到主框架之前中止(后续回退链路不看 frame_id, 会读到主框架内容)"))
                    }
                    // 第二跳: 显式走**原生同步 JS**(复用既有 helper, 它内部用 取主浏览器 因而尊重 browser_id)。
                    // 覆盖"CDP 通道没附着到目标浏览器"时的取值 —— 实测第二个浏览器上
                    // browser_execute_js 能正常执行 JS(0.06s), 而本工具此前直接掉到填表框架并给出 null。
                    变量 原生文值 <类型 = 文本型>
                    原生文值 = MCP命令服务器.原生执行JS并等待 (js取文码, 10000)
                    如果 (原生文值 == "__MCP_NO_ELEM__")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                    }
                    如果 (是否以 (原生文值, "__MCP_TEXT__"))
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, 取文本右边 (原生文值, 取文本长度 (原生文值) - 取文本长度 ("__MCP_TEXT__"))))
                    }
                    // 第三跳: 改成"提交原生 JS + 返回异步回执", 与 `browser_execute_js` 的原生回退**同一机制**。
                    // 为什么不用"填表框架 取元素内容": 实测对**第二个浏览器**,
                    // 填表框架那条路会立刻以 null 结束, 于是本工具返回 `success:true, message:"null"` ——
                    // 一个**静默的假值**。而同一浏览器上 `browser_execute_js` 用"提交回调 + 让外层同步跟随去等"
                    // 的方式能正常取回内容(0.06s)。两者差别不在能否执行, 而在**谁来等**: 内联等待
                    // (`原生执行JS并等待` 里的 等待异步任务完成)拿不到回调结果、返回空串, 而把回执交回外层
                    // 由 尝试同步跟随异步响应 去等就成功。故此处复用后者这条已验证的机制。
                    变量 原生框架 <类型 = 类_FBrowser_框架>
                    原生框架 = MCP命令服务器.取安全主框架 (browser)
                    如果 (原生框架.是否为空 () == 假 && 原生框架.是否有效 ())
                    {
                        变量 异步文ID <类型 = 文本型>
                        异步文ID = MCP命令服务器.生成异步任务ID ()
                        变量 预占位文 <类型 = YYJSON对象类>
                        预占位文.创建自文本 ("{}")
                        预占位文.加入逻辑值成员 ("_waiting", 真)
                        预占位文.加入文本成员 ("what", "get_text_native")
                        预占位文.加入文本成员 ("message", "文本获取中...")
                        预占位文.加入长整数成员 ("start_time", 取启动时间 ())
                        // max_ms 必须一并写入: 外层"同步跟随"是**按占位里的 max_ms**决定等多久的。
                        // 漏写这一项时外层只等 0ms 就报"等待超时(0ms)" —— 必须与 browser_execute_js
                        // 的占位逐字对齐后才对(那里就写了 max_ms)。
                        预占位文.加入整数成员 ("max_ms", MCP_常量.同步等待_JS执行超时)
                        预占位文.加入整数成员 ("_browser_id", browser.取ID ())
                        MCP命令服务器.存储异步结果 (异步文ID, 预占位文.到可读文本 (YYJSON格式化选项.压缩), browser.取ID ())
                        变量 文回调 <类型 = 类_FBrowser_事件智能指针>
                        文回调.创建 (类_MCP_JS异步回调)
                        文回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步文ID
                        // 异步这条路**必须用不带哨兵前缀的片段**: 回调结果由外层"同步跟随"直接作为消息交回客户端,
                        // 工具侧没有机会去掉前缀(已见: `__MCP_TEXT__Example Domain` 会原样漏给用户)
                        // (内部哨兵绝不能出现在面向用户的返回里)。
                        // 此处可以不加哨兵: 走到这一跳时, 前面两条同步路径已经判定过"元素是否存在"
                        // (不存在会提前返回明确失败), 故这里只需返回文本本身, 空文本即空串。
                        变量 js直读码 <类型 = 文本型>
                        js直读码 = "(function(){var e=document.querySelector('" + MCP命令服务器.简单转义JS (selector) + "');if(!e)return '';var t=e.textContent;return String(t===null||t===undefined?'':t)})()"
                        原生框架.执行JS代码_带返回值 (js直读码, "", 0, 文回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步文ID, "文本(原生JS)获取已提交"))
                    }
                    // 框架无效时才退到最后手段: 填表框架(对第二个浏览器可能给出 null, 故排在原生JS之后)
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步选文本ID <类型 = 文本型>
                        异步选文本ID = MCP命令服务器.生成异步任务ID ()
                        变量 文本回调 <类型 = 类_FBrowser_事件智能指针>
                        文本回调.创建 (类_MCP_JS异步回调)
                        文本回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步选文本ID
                        填表框架.取元素内容 (selector, 0, 文本回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步选文本ID, "文本(原生)获取已提交"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                否则
                {
                    // selector为空: 获取页面全部文本内容
                    // CDP JS 同步取 body.innerText (上限 10s), 取不到回退原生异步路径
                    变量 全文JS <类型 = 文本型>
                    全文JS = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, "(function(){var b=document.body;if(!b)return '__MCP_NO_BODY__';return '__MCP_TEXT__'+String(b.innerText||b.textContent||'')})()", 10000)
                    如果 (全文JS == "__MCP_NO_BODY__")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "页面正文不存在(可能尚未开始加载) | 建议: 先用 browser_navigate 的 wait_for_load 确认页面就绪"))
                    }
                    如果 (是否以 (全文JS, "__MCP_TEXT__"))
                    {
                        变量 全文正文 <类型 = 文本型>
                        全文正文 = 取文本右边 (全文JS, 取文本长度 (全文JS) - 取文本长度 ("__MCP_TEXT__"))
                        变量 全文上限 <类型 = 整数>
                        // max_chars 必须真的生效: 此前 schema 声明了它但实现写死常量(声明未读 = 误导调用方)。
                        全文上限 = MCP命令服务器.yyjson取整数 (参数JSON, "max_chars")
                        如果 (全文上限 <= 0 || 全文上限 > MCP_常量.截断_源码最大字节)
                        {
                            全文上限 = MCP_常量.截断_源码默认字节
                        }
                        如果 (取文本长度 (全文正文) > 全文上限)
                        {
                            变量 全文截断 <类型 = YYJSON对象类>
                            全文截断.创建自文本 ("{}")
                            全文截断.加入逻辑值成员 ("success", 真)
                            全文截断.加入文本成员 ("message", 取文本左边 (全文正文, 全文上限))
                            全文截断.加入整数成员 ("truncated", 取文本长度 (全文正文))
                            全文截断.加入整数成员 ("truncated_to", 全文上限)
                            返回 (全文截断.到可读文本 (YYJSON格式化选项.压缩))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, 全文正文))
                    }
                    // 约束: 同 selector 分支 —— 指定子框架时不得回退到主框架取全文。
                    变量 gt全文框架 <类型 = 文本型>
                    gt全文框架 = MCP命令服务器.yyjson取文本 (参数JSON, "frame_id")
                    如果 (gt全文框架 != "" && gt全文框架 != "main" && gt全文框架 != "主框架")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "子框架(" + gt全文框架 + ")内取全文失败: " + 取文本左边 (全文JS, 300) + " | 已在回退到主框架之前中止(回退链路不看 frame_id)"))
                    }
                    变量 fullText <类型 = 文本型>
                    fullText = MCP命令服务器.提交异步取文本任务 (browser)
                    返回 (MCP命令服务器.包装异步提交结果 (命令ID, fullText, "text", "全文获取已提交"))
                }
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 开发者工具 ===
        否则 (方法名 == "browser_open_devtools")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.打开开发者工具 ("AI调试工具", 0, 0, 0, 1024, 800)
                返回 (MCP_响应构建.命令成功 (命令ID, "DevTools已打开"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_close_devtools")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.关闭开发者工具 ()
                返回 (MCP_响应构建.命令成功 (命令ID, "DevTools已关闭"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 窗口管理 ===
        否则 (方法名 == "browser_create")
        {
            变量 url <类型 = 文本型>
            url = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (url == "")
            {
                url = "about:blank"
            }
            如果 (MCP命令服务器.验证URL安全 (url) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_不支持的URL协议))
            }
            // 后台浏览器(完全无窗口): 复用同一条"待创建"握手通道, 以 `__BG__` 前缀告知 UI 线程改用
            // FBrowser_创建后台浏览器 —— 与 main.wsv 里 `__SHUTDOWN__` 前缀同一惯例, 无需额外握手字段。
            变量 后台模式 <类型 = 逻辑型>
            后台模式 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "background", 假)
            变量 握手URL <类型 = 文本型>
            握手URL = url
            如果 (后台模式)
            {
                握手URL = "__BG__" + url
            }
            // 限制浏览器实例数量
            如果 (FBrowser_浏览器_取数量 () >= MCP_常量.浏览器实例最大数量)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "浏览器实例已达上限(" + 到文本 (MCP_常量.浏览器实例最大数量) + ")"))
            }
            // 通过UI线程时钟(500ms)创建浏览器
            // 释放MCP执行锁让其他命令继续执行, 仅保留待创建URL供时钟线程消费
            // 待创建锁保护握手字段, 防止并发create/shutdown互相覆盖
            MCP命令服务器.待创建锁.加锁 ()
            MCP命令服务器.待创建完成 = 假
            MCP命令服务器.待创建令牌 = 命令ID
            变量 标识参数 <类型 = 文本型>
            标识参数 = MCP命令服务器.yyjson取文本 (参数JSON, "tag")
            // 未传 tag 时写空串: 否则上一次创建的标识会泄漏给这个新浏览器(标识重复会取到既有那个)。
            MCP命令服务器.待创建标识 = 标识参数
            MCP命令服务器.待创建URL = 握手URL
            MCP命令服务器.待创建锁.解锁 ()
            变量 等待次数 <类型 = 整数 值 = 0>
            变量 创建成功 <类型 = 逻辑型 值 = 假>
            判断循环 (等待次数 < 200)
            {
                MCP命令服务器.待创建锁.加锁 ()
                创建成功 = MCP命令服务器.待创建完成
                MCP命令服务器.待创建锁.解锁 ()
                如果 (创建成功)
                {
                    跳出循环
                }
                等待次数 = 等待次数 + 1
                如果 (MCP命令服务器.MCP正在关闭)
                {
                    跳出循环
                }
                MCP命令服务器.MCP执行锁.解锁 ()
                // 此处已显式解锁, 延时传 是否持锁=假, 防无主解锁破坏锁计数
                MCP命令服务器.MCP可中断延时 (50, 50, 假)
                MCP命令服务器.MCP执行锁.加锁 ()
            }
            MCP命令服务器.待创建锁.加锁 ()
            创建成功 = MCP命令服务器.待创建完成
            变量 覆盖原因 <类型 = 文本型>
            覆盖原因 = ""
            如果 (创建成功 && MCP命令服务器.待创建令牌 != 命令ID)
            {
                // 并发覆盖: 等待期间另一个 create/shutdown 覆写了握手字段(令牌不匹配) ——
                // 本命令的 URL 从未被创建, 如实报失败而不是把对方的成功当成自己的。
                创建成功 = 假
                覆盖原因 = "并发 browser_create 握手被覆盖(等待期间另有 create/shutdown 写入), 本次 URL 未创建"
            }
            如果 (创建成功)
            {
                // 仅清除本命令写入的URL: 若等待期间shutdown已写入 __SHUTDOWN__ 标记则保留, 防止关闭请求被抹掉
                如果 (MCP命令服务器.待创建URL == 握手URL)
                {
                    MCP命令服务器.待创建URL = ""
                }
                如果 (MCP命令服务器.待创建令牌 == 命令ID)
                {
                    MCP命令服务器.待创建令牌 = ""
                }
            }
            否则
            {
                // 超时未创建: 若URL仍为本命令写入值则清除, 防止时钟线程稍后补建造成"失败却创建"。
                // 协议锁下shutdown不会并发写该字段, 比较-清除安全; 非本命令URL(理论上不出现)不动
                如果 (MCP命令服务器.待创建URL == 握手URL)
                {
                    MCP命令服务器.待创建URL = ""
                }
                如果 (MCP命令服务器.待创建令牌 == 命令ID)
                {
                    MCP命令服务器.待创建令牌 = ""
                }
            }
            MCP命令服务器.待创建锁.解锁 ()
            如果 (创建成功)
            {
                如果 (后台模式)
                {
                    // 后台浏览器没有窗口与窗口句柄, browser_list 里仍能看到, 后续任何工具传 browser_id 即可操作它。
                    // 实测(三臂对照): 创建与使用第二个浏览器**不影响主浏览器的 CDP 通道**
                    // (修复前会让主浏览器 get_text 退化为 10s+null、execute_js 退化为 30s 且整场不恢复;
                    //  根因是 CDP 观察者在浏览器之间被来回切换附着, 已改为"只注册不切换")。
                    // 实测: 目标隔离正确、不影响主浏览器 CDP 工具、且在第二个浏览器上读取也正常
                    // (browser_execute_js 与 browser_get_text 均可取到它自己的内容)。此前记录的三项限制
                    // —— 30 秒白等 / 主浏览器退化 / get_text 返回 null —— 均已修复, 故不再在此警示。
                    返回 (MCP_响应构建.命令成功 (命令ID, "后台浏览器已创建(完全无窗口, 不显示): " + url + " | 通过 browser_list 取它的 id, 之后任何工具传 browser_id=<该id> 即可操作它(实测目标隔离正确, 且不影响主浏览器的 CDP 工具)"))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "浏览器已创建: " + url + " | 通过 browser_list 查看详情"))
            }
            如果 (覆盖原因 != "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, 覆盖原因 + " | 请重试"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "浏览器创建超时, 请重试"))
        }
        否则 (方法名 == "browser_close")
        {
            变量 closeID <类型 = 整数>
            closeID = MCP命令服务器.yyjson取整数 (参数JSON, "browser_id")
            变量 closeBrowser <类型 = 类_FBrowser_浏览器>
            如果 (closeID > 0)
            {
                closeBrowser = FBrowser_浏览器_通过ID取浏览器 (closeID)
            }
            否则
            {
                closeBrowser = MCP命令服务器.取主浏览器 ()
            }
            如果 (closeBrowser.是否为空 () == 假 && closeBrowser.是否已关闭 () == 假)
            {
                // 主窗口认定: ID 清单里**最小** id(与 browser_close_try 口径一致; 不能经 取主浏览器(),
                // 它受本命令 browser_id 目标影响, 恒返回目标自己)
                变量 close主ID <类型 = 整数 值 = 0>
                变量 closeID清单 <类型 = 类_FBrowser_列表值>
                closeID清单 = FBrowser_浏览器_取ID清单 ()
                如果 (closeID清单.是否为空 () == 假)
                {
                    计次循环 (closeID清单.取大小 ())
                    {
                        变量 closeListID <类型 = 整数>
                        closeListID = closeID清单.取整数值 (取循环索引 ())
                        如果 (close主ID == 0 || closeListID < close主ID)
                        {
                            close主ID = closeListID
                        }
                    }
                }
                变量 close目标是主窗口 <类型 = 逻辑型>
                close目标是主窗口 = closeID <= 0 || closeID == close主ID
                如果 (close目标是主窗口 && MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "关闭主浏览器窗口等于退出整个 AI-Fbowser-Mcp.exe 服务(MCP 连接会一起断开), 需显式 confirm:true | 关闭非主窗口: 传 browser_id(用 browser_list 查看存活清单)"))
                }
                变量 closingID <类型 = 整数>
                closingID = closeBrowser.取ID ()
                closeBrowser.关闭浏览器 ()
                // ★ 回读验证(不静默假成功): 类库 关闭浏览器 是异步生效(实测: 成功后立即 browser_list
                //   仍能看到该 id, 数百毫秒后才从清单消失)。故轮询确认(≤2.5s): 通过ID取不到(空对象)
                //   或 是否已关闭()=真 才算真关; 期间按 create 同款"解锁-延时-加锁"让步, 不占死协议锁。
                变量 关闭确认 <类型 = 逻辑型 值 = 假>
                变量 关闭验证 <类型 = 类_FBrowser_浏览器>
                关闭验证 = FBrowser_浏览器_通过ID取浏览器 (closingID)
                计次循环 (50)
                {
                    如果 (关闭验证.是否为空 () || 关闭验证.是否已关闭 ())
                    {
                        关闭确认 = 真
                        跳出循环
                    }
                    MCP命令服务器.MCP执行锁.解锁 ()
                    MCP命令服务器.MCP可中断延时 (50, 50, 假)
                    MCP命令服务器.MCP执行锁.加锁 ()
                    关闭验证 = FBrowser_浏览器_通过ID取浏览器 (closingID)
                }
                如果 (关闭确认)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, "浏览器已关闭: id=" + 到文本 (closingID) + " (回读确认: 已从浏览器清单移除)"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "已提交关闭, 但 2.5s 内回读未确认(浏览器清单仍含该 id) | 稍后用 browser_list 复核; 若仍在且确需关闭, 请重试或重启程序"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "浏览器不可用或已关闭"))
        }
        否则 (方法名 == "browser_list")
        {
            // 锁内只取 ID 快照(轻量): 取主框架/取地址 是 CEF 调用, 可能等待数百毫秒,
            // 全程持锁会让 UI 线程的 创建完毕/即将关闭 事件全部阻塞(2025-09-13 修正原实现)。
            MCP命令服务器.浏览器数组锁.加锁 ()
            变量 ID清单 <类型 = 类_FBrowser_列表值>
            ID清单 = FBrowser_浏览器_取ID清单 ()
            MCP命令服务器.浏览器数组锁.解锁 ()
            // 防御: ID清单可能为空
            如果 (ID清单.是否为空 () == 假)
            {
                变量 列表JSON <类型 = 文本型>
                列表JSON = "["
                变量 首项标志 <类型 = 逻辑型 值 = 真>
                变量 listSize <类型 = 整数>
                listSize = ID清单.取大小 ()
                计次循环 (listSize)
                {
                    变量 bid <类型 = 整数>
                    bid = ID清单.取整数值 (取循环索引 ())
                    变量 b <类型 = 类_FBrowser_浏览器>
                    b = FBrowser_浏览器_通过ID取浏览器 (bid)
                    如果 (b.是否为空 () == 假 && b.是否已关闭 () == 假)
                    {
                        如果 (首项标志)
                        {
                            首项标志 = 假
                        }
                        否则
                        {
                            列表JSON = 列表JSON + ","
                        }
                        // 锁外取框架: 取安全主框架含8秒等待, 持数组锁会阻塞全部取主浏览器命令
                        变量 listUrlFrame <类型 = 类_FBrowser_框架>
                        listUrlFrame = b.取主框架 ()
                        变量 urlText <类型 = 文本型>
                        如果 (listUrlFrame.是否为空 () == 假)
                        {
                            urlText = listUrlFrame.取地址 ()
                        }
                        否则
                        {
                            urlText = ""
                        }
                        变量 浏览器项 <类型 = YYJSON对象类>
                        浏览器项.创建自文本 ("{}")
                        浏览器项.加入整数成员 ("id", bid)
                        浏览器项.加入文本成员 ("url", urlText)
                        列表JSON = 列表JSON + 浏览器项.到可读文本 (YYJSON格式化选项.压缩)
                    }
                }
                列表JSON = 列表JSON + "]"
                返回 (MCP_响应构建.构建命令嵌套JSON (命令ID, 真, "browsers", 列表JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "无法获取浏览器ID清单"))
        }
        // === 缩放 ===
        否则 (方法名 == "browser_set_zoom")
        {
            变量 level <类型 = 文本型>
            level = MCP命令服务器.yyjson取文本 (参数JSON, "level")
            如果 (level == "")
            {
                // 兼容数值型参数(如1.0/1.5): 取文本对数值成员返回空, 用取小数/取整数兜底
                // JSON整数(1)取小数可能返回0, 需再试取整数
                变量 levelNum <类型 = 小数>
                levelNum = MCP命令服务器.yyjson取小数 (参数JSON, "level")
                如果 (levelNum == 0)
                {
                    levelNum = MCP命令服务器.yyjson取整数 (参数JSON, "level")
                }
                如果 (levelNum > 0)
                {
                    level = 到文本 (levelNum)
                }
                否则 (levelNum == 0)
                {
                    // level 缺失(未知/空值)视为未提供; 显式 0 合法(= 复位默认缩放)
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "level"))
                    {
                        level = "0"
                    }
                }
            }
            如果 (level != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    // 允许0(CEF缩放0=100%复位默认), 单次转换复用局部变量
                    变量 lvNum <类型 = 小数>
                    lvNum = 文本到小数 (level)
                    // 仅当解析结果为 0 而原文并非零写法时判非法 (合法写法如 "1.50"/"0.0" 不误伤)
                    变量 lv文本 <类型 = 文本型>
                    lv文本 = 删首尾空 (level)
                    如果 (lvNum == 0 && lv文本 != "0" && lv文本 != "0.0" && lv文本 != "0.00" && lv文本 != ".0" && lv文本 != "-0" && lv文本 != "+0")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "level 不是有效数字: " + level + " | 请传 0~10 的数字, 如 1.0 / 1.5 / 0.8 (0=复位默认100%)"))
                    }
                    如果 (lvNum < 0 || lvNum > 10)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "level 须在 0~10 之间(如1.0/1.5/0.8; 0=复位默认100%)"))
                    }
                    browser.置缩放级别 (lvNum)
                    MCP命令服务器.持久配置锁.加锁 ()
                    MCP命令服务器.持久缩放级别 = lvNum
                    MCP命令服务器.持久配置锁.解锁 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "缩放(持久): " + level))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 level 不能为空"))
        }
        // === 查找 ===
        否则 (方法名 == "browser_find")
        {
            变量 text <类型 = 文本型>
            text = MCP命令服务器.yyjson取文本 (参数JSON, "text")
            如果 (text != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    browser.查找 (text, 真, 假, 假)
                    返回 (MCP_响应构建.命令成功 (命令ID, "查找: " + text))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 text 不能为空"))
        }
        否则 (方法名 == "browser_stop_find")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.停止查找 (真)
                返回 (MCP_响应构建.命令成功 (命令ID, "查找已停止"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 鼠标 ===
        否则 (方法名 == "browser_mouse_click")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当作 (0,0) 而在页面左上角误点, 故拒绝执行; 如需点左上角请显式传 x=0 y=0"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 x <类型 = 整数>
                变量 y <类型 = 整数>
                x = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                y = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                如果 (x < 0 || y < 0 || x > 32767 || y > 32767)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "坐标越界 | x,y 须在 0~32767 范围内"))
                }
                // 按钮文本→枚举只映射一份: 原先 VIP 路径与 CEF 退路各抄一份, 且字符串"right"当整数用会误按左键
                变量 按钮文本 <类型 = 文本型>
                按钮文本 = MCP命令服务器.yyjson取文本 (参数JSON, "button")
                变量 按钮类型 <类型 = 整数>
                如果 (按钮文本 == "right")
                {
                    按钮类型 = 鼠标按键类型.右键
                }
                否则 (按钮文本 == "middle")
                {
                    按钮类型 = 鼠标按键类型.中键
                }
                否则 (按钮文本 == "left" || 按钮文本 == "")
                {
                    按钮类型 = 鼠标按键类型.左键
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知按钮类型: " + 按钮文本 + " | 支持: left/right/middle"))
                }
                变量 cdp按钮名 <类型 = 文本型>
                cdp按钮名 = 按钮文本
                如果 (cdp按钮名 == "")
                {
                    cdp按钮名 = "left"
                }
                // 缺省路径: CDP 派发(按下+抬起)。CDP 与 VIP 控制器无关, 故不再嵌在 VIP 分支内
                // (原先嵌在里面 -> VIP 不可用时永不尝试 CDP, 直接掉到 CEF 退路)
                如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
                {
                    如果 (MCP命令服务器.CDP派发鼠标事件 ("mousePressed", x, y, cdp按钮名) && MCP命令服务器.CDP派发鼠标事件 ("mouseReleased", x, y, cdp按钮名))
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, "点击 (" + 到文本 (x) + "," + 到文本 (y) + ") 按钮:" + cdp按钮名 + " | 经 CDP 派发(不破坏 CDP 会话) | 如需内核级注入请传 kernel:true"))
                    }
                    // 失败不静默回退内核注入: 内核注入会让 CDP 通道在本会话内永久失效, 一次点击失败不该连累整场会话
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发鼠标事件") + " | 可用替代: browser_element_action 点击元素 / browser_execute_js 派发事件"))
                }
                // kernel:true = 显式要求内核级注入(过反爬场景), 此处**确实执行**注入
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级鼠标_单击 (x, y, 按钮类型)
                    返回 (MCP_响应构建.命令成功 (命令ID, "点击 (" + 到文本 (x) + "," + 到文本 (y) + ") 按钮:" + 按钮文本 + " | ⚠ 内核级鼠标注入: 实测会使 CDP 通道在本会话内失效(此后 CDP 优先工具退化), 需重启 AI-Fbowser-Mcp.exe 恢复"))
                }
                // VIP 控制器不可用时的退路: 普通 CEF 事件(不经内核, 也不破坏 CDP)
                变量 鼠标事件 <类型 = FBrowser_鼠标事件>
                鼠标事件.横坐标 = x
                鼠标事件.纵坐标 = y
                鼠标事件.修饰键 = 事件标识.无
                browser.发送鼠标点击事件 (按钮类型, 鼠标事件, 假, 1)
                browser.发送鼠标点击事件 (按钮类型, 鼠标事件, 真, 1)
                返回 (MCP_响应构建.命令成功 (命令ID, "点击 (" + 到文本 (x) + "," + 到文本 (y) + ") 按钮:" + 按钮文本 + " | 经 CEF 事件派发(VIP控制器不可用时的退路)"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_mouse_move")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 x <类型 = 整数>
                变量 y <类型 = 整数>
                x = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                y = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                如果 (x < 0 || y < 0 || x > 32767 || y > 32767)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "坐标越界 | x,y 须在 0~32767 范围内"))
                }
                // 缺省路径: CDP Input.dispatchMouseEvent(真实输入事件, 不破坏 CDP 会话)
                如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
                {
                    如果 (MCP命令服务器.CDP派发鼠标事件 ("mouseMoved", x, y))
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, "鼠标移动到 (" + 到文本 (x) + "," + 到文本 (y) + ") | 经 CDP Input.dispatchMouseEvent 派发(不破坏 CDP 会话) | 如需内核级注入请传 kernel:true"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发鼠标事件") + " | 可用替代: browser_element_action / browser_execute_js 派发事件"))
                }
                // kernel:true = 显式要求内核级注入(过反爬场景), 此处**确实执行**注入
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级鼠标_移动 (x, y)
                    返回 (MCP_响应构建.命令成功 (命令ID, "鼠标移动到 (" + 到文本 (x) + "," + 到文本 (y) + ") | ⚠ 内核级鼠标注入: 实测会使 CDP 通道在本会话内失效(此后 CDP 优先工具退化), 需重启 AI-Fbowser-Mcp.exe 恢复"))
                }
                // VIP 控制器不可用时的退路: 普通 CEF 鼠标移动事件
                变量 鼠标事件 <类型 = FBrowser_鼠标事件>
                鼠标事件.横坐标 = x
                鼠标事件.纵坐标 = y
                鼠标事件.修饰键 = 事件标识.无
                browser.发送鼠标移动事件 (鼠标事件, 假)
                返回 (MCP_响应构建.命令成功 (命令ID, "鼠标移动到 (" + 到文本 (x) + "," + 到文本 (y) + ") | 经 CEF 事件派发(VIP控制器不可用时的退路)"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 键盘 ===
        否则 (方法名 == "browser_key_event")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 key <类型 = 整数>
                key = MCP命令服务器.yyjson取整数 (参数JSON, "key_code")
                如果 (key <= 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "参数 key_code 必须为有效虚拟键码(>0)"))
                }
                变量 类型文本 <类型 = 文本型>
                类型文本 = MCP命令服务器.yyjson取文本 (参数JSON, "type")
                // 修饰键位掩码, 与类库 `高级键盘_按下/放开/单击` 第 2 参的约定一致:
                //   Alt=1, Ctrl=2, Meta/Command=4, Shift=8 (FBroVip.wsv 该参数注释原文)。
                // ⚠ 该值原先只在下面的 CEF 退路里被使用, VIP 三处调用**都没传** ⇒
                //   按 schema 传 modifiers 时组合键静默失效(schema 承诺了却没生效)。现三处都传。
                变量 修饰掩码 <类型 = 整数>
                修饰掩码 = MCP命令服务器.yyjson取整数 (参数JSON, "modifiers")
                如果 (类型文本 != "keydown" && 类型文本 != "keyup" && 类型文本 != "" && 类型文本 != "char" && 类型文本 != "click" && 类型文本 != "press")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + 类型文本 + " | 支持: keydown/keyup/char"))
                }
                // CDP 优先(与鼠标三件套同策略): VIP 高级键盘_* 是内核级注入, 实测会让本会话 CDP 通道失效(需重启);
                // 默认走 CDP Input.dispatchKeyEvent(页面真实收到且不破坏通道), kernel:true 才走内核注入。
                如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
                {
                    变量 CDP按键错误 <类型 = 文本型>
                    CDP按键错误 = MCP命令服务器.CDP派发按键事件 (key, 类型文本, 修饰掩码)
                    如果 (CDP按键错误 == "")
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, "按键 key_code=" + 到文本 (key) + " type=" + 选择 (类型文本 == "", "click", 类型文本) + " modifiers=" + 到文本 (修饰掩码) + " | 经 CDP 派发(不破坏 CDP 会话) | 如需内核级注入请传 kernel:true"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, CDP按键错误))
                }
                // kernel:true = 显式要求内核级注入(过反爬场景), 此处**确实执行**注入
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假 && key <= 255)
                {
                    如果 (类型文本 == "keydown")
                    {
                        vip_ctrl.高级键盘_按下 (key, 修饰掩码, 假)
                        返回 (MCP_响应构建.命令成功 (命令ID, "VIP按下 key_code=" + 到文本 (key) + " modifiers=" + 到文本 (修饰掩码)))
                    }
                    否则 (类型文本 == "keyup")
                    {
                        vip_ctrl.高级键盘_放开 (key, 修饰掩码, 假)
                        返回 (MCP_响应构建.命令成功 (命令ID, "VIP放开 key_code=" + 到文本 (key) + " modifiers=" + 到文本 (修饰掩码)))
                    }
                    否则 (类型文本 == "" || 类型文本 == "char" || 类型文本 == "click" || 类型文本 == "press")
                    {
                        vip_ctrl.高级键盘_单击 (key, 修饰掩码, 50, 假)
                        返回 (MCP_响应构建.命令成功 (命令ID, "VIP单击 key_code=" + 到文本 (key) + " modifiers=" + 到文本 (修饰掩码)))
                    }
                    否则
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + 类型文本 + " | 支持: keydown/keyup/char"))
                    }
                }
                // 普通CEF按键 (VIP不可用时退路)
                变量 按键事件 <类型 = FBrowser_按键事件>
                如果 (类型文本 == "keydown")
                {
                    按键事件.类型 = 按键事件.按下
                }
                否则 (类型文本 == "keyup")
                {
                    按键事件.类型 = 按键事件.放开
                }
                否则 (类型文本 == "" || 类型文本 == "char" || 类型文本 == "click" || 类型文本 == "press")
                {
                    按键事件.类型 = 按键事件.单击
                }
                否则
                {
                    // 未知type显式拒绝, 与VIP路径语义对齐
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + 类型文本 + " | 支持: keydown/keyup/char"))
                }
                按键事件.系统按键 = key
                // 修饰键换算: 对外统一用 VIP 约定(Alt=1/Ctrl=2/Meta=4/Shift=8), 而 CEF 事件旗标是另一套位序
                //   (SHIFT=2, CONTROL=4, ALT=8, COMMAND=16) —— 必须按**语义**换算, 直接把掩码塞进去会让
                //   Ctrl 变成 Shift 之类的错键(旧注释 "1=Ctrl,2=Alt,4=Shift" 与两边约定都不符, 已删)。
                变量 修饰位 <类型 = 整数 值 = 0>
                如果 (位与 (修饰掩码, 1) != 0)
                {
                    修饰位 = 修饰位 + 8
                }
                如果 (位与 (修饰掩码, 2) != 0)
                {
                    修饰位 = 修饰位 + 4
                }
                如果 (位与 (修饰掩码, 4) != 0)
                {
                    修饰位 = 修饰位 + 16
                }
                如果 (位与 (修饰掩码, 8) != 0)
                {
                    修饰位 = 修饰位 + 2
                }
                按键事件.修饰位 = 修饰位
                browser.发送按键事件 (按键事件)
                返回 (MCP_响应构建.命令成功 (命令ID, "按键已发送 key_code=" + 到文本 (key) + " type=" + 类型文本 + " modifiers=" + 到文本 (修饰位)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 静音/打印/缓存 ===
        否则 (方法名 == "browser_set_mute")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "mute") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "mute 不能省略 | 它是持久配置(对新窗口同样生效), 省略等同于取消静音; 请显式传 true=静音 / false=取消静音"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 静音 <类型 = 逻辑型>
                静音 = MCP命令服务器.yyjson取逻辑 (参数JSON, "mute")
                browser.置页面静音 (静音)
                MCP命令服务器.持久配置锁.加锁 ()
                MCP命令服务器.持久静音状态 = 静音
                MCP命令服务器.持久配置锁.解锁 ()
                返回 (MCP_响应构建.命令成功 (命令ID, "静音(持久): " + 到文本 (静音)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_print")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.打印 ()
                返回 (MCP_响应构建.命令成功 (命令ID, "打印已触发"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_print_to_pdf")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 路径 <类型 = 文本型>
                路径 = MCP命令服务器.yyjson取文本 (参数JSON, "path")
                // 安全: 先检查用户提供的路径, 再处理空路径默认值 (PDF写入仅允许运行目录内)
                如果 (路径 != "" && MCP命令服务器.验证安全路径 (路径, 真) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "路径不允许: " + 路径 + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))
                }
                如果 (路径 == "")
                {
                    路径 = 取运行目录 () + "\\mcp_output.pdf"
                }
                // 最终兜底校验: 默认路径也须通过安全验证
                如果 (MCP命令服务器.验证安全路径 (路径, 真) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "路径安全校验失败: " + 路径 + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))
                }
                // 文件覆盖保护: overwrite参数必须为true才能覆盖已存在的文件
                如果 (文件是否存在 (路径))
                {
                    变量 覆盖确认 <类型 = 逻辑型>
                    覆盖确认 = MCP命令服务器.yyjson取逻辑 (参数JSON, "overwrite")
                    如果 (覆盖确认 == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "文件已存在: " + 路径 + " | 请设置 overwrite: true 确认覆盖, 或更换path参数"))
                    }
                }
                变量 PDF设置 <类型 = FBrowser_PDF打印设置>
                变量 异步PDFID <类型 = 文本型>
                异步PDFID = MCP命令服务器.生成异步任务ID ()
                变量 PDF回调 <类型 = 类_FBrowser_事件智能指针>
                PDF回调.创建 (类_MCP_打印PDF回调)
                PDF回调.取执行类 (类_MCP_打印PDF回调).任务ID = 异步PDFID
                browser.打印为PDF (路径, PDF设置, PDF回调)
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步PDFID, "PDF打印已提交, 通过mcp_result查询结果", 2000))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === Cookie ===
        否则 (方法名 == "browser_get_cookies")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // 可配置上限 (常量统一定义于 MCP_Constants.wsv)
                变量 cookieLimit <类型 = 整数>
                cookieLimit = MCP命令服务器.yyjson取整数 (参数JSON, "limit")
                如果 (cookieLimit <= 0)
                {
                    cookieLimit = MCP_常量.Cookie默认项数
                }
                // Cookie最大项数(500) < Cookie绝对上限(1000), 单项钳制即达硬上限, 无需二次判断
                如果 (cookieLimit > MCP_常量.Cookie最大项数)
                {
                    cookieLimit = MCP_常量.Cookie最大项数
                }
                // 使用官方 FBrowser Cookie管理器 回调 API (含HttpOnly)
                变量 异步CookieID <类型 = 文本型>
                异步CookieID = MCP命令服务器.生成异步任务ID ()
                变量 Cookie回调 <类型 = 类_FBrowser_事件智能指针>
                Cookie回调.创建 (类_MCP_Cookie收集回调)
                Cookie回调.取执行类 (类_MCP_Cookie收集回调).异步任务ID = 异步CookieID
                Cookie回调.取执行类 (类_MCP_Cookie收集回调).最大项数 = cookieLimit
                变量 urlFrame <类型 = 类_FBrowser_框架>
                urlFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (urlFrame.是否为空 () == 假)
                {
                    FBrowser_Cookie管理器_取全局 ().取地址Cookie (urlFrame.取地址 (), 真, Cookie回调)
                }
                否则
                {
                    // 框架不可用时立即存储错误结果, 防止客户端无限轮询
                    MCP命令服务器.存储异步结果 (异步CookieID, MCP_响应构建.构建标准失败JSON ("无法获取Cookie | " + MCP_常量.错误_主框架无效))
                }
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步CookieID, "Cookie获取已提交(含HttpOnly), 通过mcp_result查询", 300))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_set_cookie")
        {
            变量 name <类型 = 文本型>
            变量 value <类型 = 文本型>
            变量 domain <类型 = 文本型>
            name = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            value = MCP命令服务器.yyjson取文本 (参数JSON, "value")
            domain = MCP命令服务器.yyjson取文本 (参数JSON, "domain")
            如果 (name == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 name 不能为空"))
            }
            如果 (value == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 value 不能为空"))
            }
            如果 (domain == "")
            {
                // 从当前浏览器URL自动提取域名
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 currentURL <类型 = 文本型>
                    变量 setCookieFrame <类型 = 类_FBrowser_框架>
                    setCookieFrame = MCP命令服务器.取安全主框架 (browser)
                    如果 (setCookieFrame.是否为空 () == 假)
                    {
                        currentURL = setCookieFrame.取地址 ()
                    }
                    // 简单提取: 取://后到第一个 / ? # 之间的部分作为域名
                    变量 schemeEnd <类型 = 整数>
                    schemeEnd = 寻找文本 (currentURL, "://", 0, 假)
                    如果 (schemeEnd > 0)
                    {
                        变量 hostStart <类型 = 整数>
                        hostStart = schemeEnd + 3
                        变量 hostEnd <类型 = 整数>
                        hostEnd = 寻找文本 (currentURL, "/", hostStart, 假)
                        // 域名终止符也可能是 ? 或 # (如 https://example.com?x=1), 取最早者
                        变量 hostEndQuery <类型 = 整数>
                        hostEndQuery = 寻找文本 (currentURL, "?", hostStart, 假)
                        如果 (hostEndQuery > 0 && (hostEnd < 0 || hostEndQuery < hostEnd))
                        {
                            hostEnd = hostEndQuery
                        }
                        变量 hostEndHash <类型 = 整数>
                        hostEndHash = 寻找文本 (currentURL, "#", hostStart, 假)
                        如果 (hostEndHash > 0 && (hostEnd < 0 || hostEndHash < hostEnd))
                        {
                            hostEnd = hostEndHash
                        }
                        如果 (hostEnd < 0)
                        {
                            // 无路径斜杠/查询串/锚点, 域名到末尾: 取://之后全部文本
                            domain = 取文本中间 (currentURL, hostStart, 取文本长度 (currentURL) - hostStart + 1)
                        }
                        否则
                        {
                            // 提取 :// 和终止符之间的域名
                            domain = 取文本中间 (currentURL, hostStart, hostEnd - hostStart)
                        }
                        // 去除端口号 (如 example.com:8080 → example.com); 0-based: 冒号位置=域名字符数
                        变量 冒号位置 <类型 = 整数>
                        冒号位置 = 寻找文本 (domain, ":", 0, 假)
                        如果 (冒号位置 > 0)
                        {
                            domain = 取文本左边 (domain, 冒号位置)
                        }
                        // 加前导点以匹配子域名, 同时去掉可能的尾随空白
                        domain = "." + domain
                    }
                }
                如果 (domain == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法获取域名,请显式提供domain参数"))
                }
            }
            否则
            {
                // 显式提供domain时, 验证domain与当前页面URL的域名匹配, 防止向任意域注入Cookie
                变量 currentURL <类型 = 文本型>
                变量 setCookieFrame <类型 = 类_FBrowser_框架>
                变量 setBrowser <类型 = 类_FBrowser_浏览器>
                setBrowser = MCP命令服务器.取主浏览器 ()
                如果 (setBrowser.是否为空 () == 假)
                {
                    setCookieFrame = MCP命令服务器.取安全主框架 (setBrowser)
                    如果 (setCookieFrame.是否为空 () == 假)
                    {
                        currentURL = setCookieFrame.取地址 ()
                    }
                }
                如果 (currentURL == "")
                {
                    // 框架无效时无法校验归属, 拒绝显式domain (防止向任意域注入Cookie)
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法校验domain与当前页面归属 | " + MCP_常量.错误_主框架无效 + " | 请先 navigate 后再设置显式domain"))
                }
                // 内联提取当前页面的域名, 与显式提供的domain进行匹配验证
                变量 currentDomain <类型 = 文本型>
                currentDomain = ""
                变量 csEnd <类型 = 整数>
                csEnd = 寻找文本 (currentURL, "://", 0, 假)
                如果 (csEnd > 0)
                {
                    变量 chStart <类型 = 整数>
                    chStart = csEnd + 3
                    变量 chEnd <类型 = 整数>
                    chEnd = 寻找文本 (currentURL, "/", chStart, 假)
                    // 域名终止符也可能是 ? 或 #, 取最早者
                    变量 chEndQuery <类型 = 整数>
                    chEndQuery = 寻找文本 (currentURL, "?", chStart, 假)
                    如果 (chEndQuery > 0 && (chEnd < 0 || chEndQuery < chEnd))
                    {
                        chEnd = chEndQuery
                    }
                    变量 chEndHash <类型 = 整数>
                    chEndHash = 寻找文本 (currentURL, "#", chStart, 假)
                    如果 (chEndHash > 0 && (chEnd < 0 || chEndHash < chEnd))
                    {
                        chEnd = chEndHash
                    }
                    如果 (chEnd < 0)
                    {
                        chEnd = 取文本长度 (currentURL) + 1
                    }
                    currentDomain = 取文本中间 (currentURL, chStart, chEnd - chStart)
                    // 去除端口号; 0-based: cpPos=域名字符数
                    变量 cpPos <类型 = 整数>
                    cpPos = 寻找文本 (currentDomain, ":", 0, 假)
                    如果 (cpPos > 0)
                    {
                        currentDomain = 取文本左边 (currentDomain, cpPos)
                    }
                }
                变量 cleanDomain <类型 = 文本型>
                cleanDomain = domain
                // 去掉用户可能添加的前导点, 统一比较
                如果 (是否以 (cleanDomain, "."))
                {
                    cleanDomain = 取文本右边 (cleanDomain, 取文本长度 (cleanDomain) - 1)
                }
                如果 (currentDomain != "" && cleanDomain != "" && currentDomain != cleanDomain && 是否以文本结束 (currentDomain, "." + cleanDomain) == 假 && 是否以文本结束 (cleanDomain, "." + currentDomain) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "Cookie domain(" + domain + ") 与当前页面域名(" + currentDomain + ")不匹配, 拒绝跨域设置"))
                }
            }
            // 构建URL时去除域名的前导点(如.baidu.com → baidu.com)
            变量 urlDomain <类型 = 文本型>
            urlDomain = domain
            如果 (MCP命令服务器.是否以 (urlDomain, "."))
            {
                // 去除前导点; 0-based: 从索引1起取 len-1 个字符
                urlDomain = 取文本中间 (urlDomain, 1, 取文本长度 (urlDomain) - 1)
            }
            变量 Cookie数据 <类型 = FBrowser_Cookie数据>
            Cookie数据.名 = name
            Cookie数据.值 = value
            Cookie数据.域 = domain
            Cookie数据.路径 = "/"
            Cookie数据.是否只有http = 假
            Cookie数据.是否有过期时间 = 假
            FBrowser_Cookie管理器_取全局 ().置Cookie ("http://" + urlDomain, Cookie数据)
            返回 (MCP_响应构建.命令成功 (命令ID, "Cookie已设置: " + name))
        }
        否则 (方法名 == "browser_delete_cookies")
        {
            变量 确认 <类型 = 逻辑型>
            确认 = MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm")
            如果 (确认 == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "此操作将清除所有域名下所有Cookie, 请设置 confirm: true 以确认操作"))
            }
            FBrowser_Cookie管理器_取全局 ().删除Cookie ("", "")
            返回 (MCP_响应构建.命令成功 (命令ID, "Cookie已全部清除"))
        }
        否则 (方法名 == "browser_clear_cache")
        {
            变量 全局清理ID <类型 = 文本型>
            全局清理ID = MCP命令服务器.生成异步任务ID ()
            变量 全局清理回调 <类型 = 类_FBrowser_事件智能指针>
            全局清理回调.创建 (类_MCP_清理缓存回调)
            全局清理回调.取执行类 (类_MCP_清理缓存回调).任务ID = 全局清理ID
            // 能力缺口补参数(与 browser_clear_cache_browser 同款三参): 原先全缺省, 只能"全部对象/全部类型";
            // 解析复用 解析清理掩码列表(同一逻辑只留一份)。
            变量 全origin <类型 = 文本型>
            全origin = MCP命令服务器.yyjson取文本 (参数JSON, "origin")
            变量 全目标 <类型 = 文本型>
            全目标 = MCP命令服务器.yyjson取文本 (参数JSON, "targets")
            变量 全类型 <类型 = 文本型>
            全类型 = MCP命令服务器.yyjson取文本 (参数JSON, "storage_types")
            变量 全掩码 <类型 = 长整数>
            全掩码 = 清理缓存.全部
            变量 全类型掩码 <类型 = 长整数>
            全类型掩码 = 缓存类型.全部
            如果 (全目标 != "")
            {
                变量 全目标解析 <类型 = YYJSON只读对象类>
                全目标解析.创建自文本 (解析清理掩码列表 (全目标, "targets"))
                如果 (MCP命令服务器.yyjson取文本 (全目标解析, "error") != "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "targets 里有无法识别的清理对象: " + MCP命令服务器.yyjson取文本 (全目标解析, "error") + " | 可用值(逗号分隔): appcache,cookies,filesystem,indexeddb,localstorage,shadercache,websql,serviceworkers,cachestorage,pluginprivatedata,backgroundfetch,conversions,all"))
                }
                全掩码 = MCP命令服务器.yyjson取长整数 (全目标解析, "mask")
            }
            如果 (全类型 != "")
            {
                变量 全类型解析 <类型 = YYJSON只读对象类>
                全类型解析.创建自文本 (解析清理掩码列表 (全类型, "storage_types"))
                如果 (MCP命令服务器.yyjson取文本 (全类型解析, "error") != "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "storage_types 里有无法识别的类型: " + MCP命令服务器.yyjson取文本 (全类型解析, "error") + " | 可用值(逗号分隔): temporary,persistent,syncable,all"))
                }
                全类型掩码 = MCP命令服务器.yyjson取长整数 (全类型解析, "mask")
            }
            FBrowser_清理全局缓存 (全origin, 全掩码, 全类型掩码, 全局清理回调)
            返回 (MCP命令服务器.命令成功_异步 (命令ID, 全局清理ID, "全局缓存清理已提交 | origin=" + 全origin + " | 清理对象掩码=" + 到文本 (全掩码) + " | 存储类型掩码=" + 到文本 (全类型掩码) + " | 通过mcp_result查询", 500))
        }
        // === 状态查询 ===
        否则 (方法名 == "browser_is_loading")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建逻辑值JSON ("loading", browser.是否读取中 ()))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_can_navigate")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 navObj <类型 = YYJSON对象类>
                navObj.创建自文本 ("{}")
                navObj.加入逻辑值成员 ("success", 真)
                navObj.加入逻辑值成员 ("can_go_back", browser.可否后退 ())
                navObj.加入逻辑值成员 ("can_go_forward", browser.可否前进 ())
                返回 (navObj.到可读文本 (YYJSON格式化选项.压缩))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_get_id")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建整数值JSON ("id", browser.取ID ()))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 鼠标滚轮 ===
        否则 (方法名 == "browser_mouse_wheel")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会退化成在 (0,0) 滚动"))
            }
            如果 (MCP命令服务器.参数键存在 (参数JSON, "delta_y") == 假 && MCP命令服务器.参数键存在 (参数JSON, "delta_x") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须提供 delta_y 或 delta_x (滚动量, 正数向下/向右) | 省略会造成滚动 0 像素却报成功"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 x <类型 = 整数>
                变量 y <类型 = 整数>
                变量 deltaX <类型 = 整数>
                变量 deltaY <类型 = 整数>
                x = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                y = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                deltaX = MCP命令服务器.yyjson取整数 (参数JSON, "delta_x")
                deltaY = MCP命令服务器.yyjson取整数 (参数JSON, "delta_y")
                如果 (x < 0 || y < 0 || x > 32767 || y > 32767)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "坐标越界 | x,y 须在 0~32767 范围内"))
                }
                如果 (deltaX < -10000 || deltaX > 10000 || deltaY < -10000 || deltaY > 10000)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "滚轮增量越界 | delta_x/delta_y 须在 ±10000 范围内"))
                }
                // 缺省路径: CDP 派发 mouseWheel
                如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
                {
                    如果 (MCP命令服务器.CDP派发鼠标事件 ("mouseWheel", x, y, "left", deltaX, deltaY))
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, "滚轮 (" + 到文本 (x) + "," + 到文本 (y) + ") delta:" + 到文本 (deltaX) + "," + 到文本 (deltaY) + " | 经 CDP 派发(不破坏 CDP 会话) | 如需内核级注入请传 kernel:true"))
                    }
                    // 自愈(全量扫测实测 2025-09-13): 窗口不可见/被遮挡时 mouseWheel 派发会耗尽 8 秒预算失败;
                    // 强制显示窗口后重试一次(实测恢复后 0.03 秒), 仍失败才如实报成因。
                    browser.显示隐藏窗口 (真)
                    如果 (MCP命令服务器.CDP派发鼠标事件 ("mouseWheel", x, y, "left", deltaX, deltaY))
                    {
                        MCP_响应构建.记录自动处理 ("滚轮: 首次派发失败(窗口不可见/被遮挡), 已自动强制显示窗口并重试成功")
                        返回 (MCP_响应构建.命令成功 (命令ID, "滚轮 (" + 到文本 (x) + "," + 到文本 (y) + ") delta:" + 到文本 (deltaX) + "," + 到文本 (deltaY) + " | 经 CDP 派发(不破坏 CDP 会话); 首次失败(窗口不可见/被遮挡), 已自动强制显示窗口并重试成功 | 如需内核级注入请传 kernel:true"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发鼠标事件") + " | 已尝试强制显示窗口并重试一次, 仍失败 | 可用替代: browser_element_action / browser_execute_js 派发事件"))
                }
                // kernel:true = 显式要求内核级注入(过反爬场景), 此处**确实执行**注入
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级鼠标_滚轮滚动 (x, y, deltaX, deltaY)
                    返回 (MCP_响应构建.命令成功 (命令ID, "滚轮 (" + 到文本 (x) + "," + 到文本 (y) + ") delta:" + 到文本 (deltaX) + "," + 到文本 (deltaY) + " | ⚠ 内核级鼠标注入: 实测会使 CDP 通道在本会话内失效(此后 CDP 优先工具退化), 需重启 AI-Fbowser-Mcp.exe 恢复"))
                }
                // VIP 控制器不可用时的退路: 普通 CEF 鼠标滚轮事件
                变量 鼠标事件 <类型 = FBrowser_鼠标事件>
                鼠标事件.横坐标 = x
                鼠标事件.纵坐标 = y
                鼠标事件.修饰键 = 事件标识.无
                browser.发送鼠标滚轮事件 (鼠标事件, deltaX, deltaY)
                返回 (MCP_响应构建.命令成功 (命令ID, "滚轮 (" + 到文本 (x) + "," + 到文本 (y) + ") delta:" + 到文本 (deltaX) + "," + 到文本 (deltaY) + " | 经 CEF 事件派发(VIP控制器不可用时的退路)"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 缩放获取 ===
        否则 (方法名 == "browser_get_zoom")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建简单JSON ("zoom_level", 到文本 (browser.取缩放级别 ())))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 代理 ===
        否则 (方法名 == "browser_set_proxy")
        {
            变量 address <类型 = 文本型>
            变量 username <类型 = 文本型>
            变量 password <类型 = 文本型>
            address = MCP命令服务器.yyjson取文本 (参数JSON, "address")
            如果 (address != "")
            {
                username = MCP命令服务器.yyjson取文本 (参数JSON, "username")
                password = MCP命令服务器.yyjson取文本 (参数JSON, "password")
                // 地址格式守卫: 该工具会把地址**持久化**到新浏览器自动应用, 垃圾地址(如探针占位串)会污染
                // 整个后续会话; 要求形如 host:port。
                如果 (寻找文本 (address, ":", 0, 假) == -1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "address 形如 host:port(如 127.0.0.1:1080 或 proxy.example.com:8080): " + address))
                }
                // 第4参(分诊确认原实现恒为假): 关闭S5错误提示 —— S5 认证失败弹窗在无人值守时是硬阻塞,
                // 与 browser_screenshot 曾写死参数同类缺陷; 现可显式传 close_s5_error_prompt:true。
                变量 s5提示 <类型 = 逻辑型>
                s5提示 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "close_s5_error_prompt", 假)
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    // VIP优先: SOCKS5代理 (通过CDP注入, 更安全可靠)
                    变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                    vip_ctrl = browser.取VIP控制器 ()
                    如果 (vip_ctrl.是否为空 () == 假)
                    {
                        vip_ctrl.高级_设置代理 (address, username, password, s5提示)
                        MCP命令服务器.持久配置锁.加锁 ()
                        MCP命令服务器.持久代理地址 = address
                        MCP命令服务器.持久代理账号 = username
                        MCP命令服务器.持久代理密码 = password
                        MCP命令服务器.持久配置锁.解锁 ()
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "S5代理已设置: " + address + " | close_s5_error_prompt=" + 选择 (s5提示, "true", "false")))
                    }
                    // 普通HTTP代理 (VIP不可用时退路)
                    browser.设置代理 (address, username, password)
                    // 持久化: 新浏览器自动应用
                    MCP命令服务器.持久配置锁.加锁 ()
                    MCP命令服务器.持久代理地址 = address
                    MCP命令服务器.持久代理账号 = username
                    MCP命令服务器.持久代理密码 = password
                    MCP命令服务器.持久配置锁.解锁 ()
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "代理已设置(持久): " + address))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 address 不能为空"))
        }
        否则 (方法名 == "browser_clear_proxy")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // VIP优先: 清空SOCKS5代理
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级_清空代理 ()
                    MCP命令服务器.持久配置锁.加锁 ()
                    MCP命令服务器.持久代理地址 = ""
                    MCP命令服务器.持久代理账号 = ""
                    MCP命令服务器.持久代理密码 = ""
                    MCP命令服务器.持久配置锁.解锁 ()
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "S5代理已清除"))
                }
                // 普通HTTP代理清除 (VIP不可用时退路)
                browser.清空代理 ()
                MCP命令服务器.持久配置锁.加锁 ()
                MCP命令服务器.持久代理地址 = ""
                MCP命令服务器.持久代理账号 = ""
                MCP命令服务器.持久代理密码 = ""
                MCP命令服务器.持久配置锁.解锁 ()
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "代理已清除"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 下载 ===
        否则 (方法名 == "browser_start_download")
        {
            变量 url <类型 = 文本型>
            url = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (url != "")
            {
                如果 (MCP命令服务器.验证URL安全 (url) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "不支持的URL协议, 仅允许 http/https"))
                }
                // 共享校验器允许的协议面比下载宽(如 ftp 可导航但 CefDownloadHandler 不承接) —— 下载分支再收窄一次,
                // 否则回执说"仅允许 http/https"却把 ftp 放进来(实测回执矛盾)。
                如果 (是否以 (url, "http://") == 假 && 是否以 (url, "https://") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "不支持的URL协议, 仅允许 http/https"))
                }
                // save_dir(可选): 覆盖保存目录(默认 运行目录\Downloads)。事件侧(即将下载)单次消费后清空,
                // 故每次调用必须显式传; 不传=回默认目录。
                变量 保存目录 <类型 = 文本型>
                保存目录 = MCP命令服务器.yyjson取文本 (参数JSON, "save_dir")
                如果 (保存目录 != "")
                {
                    如果 (MCP命令服务器.验证安全路径 (保存目录, 假) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "save_dir 路径不允许(含路径遍历): " + 保存目录))
                    }
                    MCP命令服务器.下载保存目录覆盖 = 保存目录
                }
                否则
                {
                    MCP命令服务器.下载保存目录覆盖 = ""
                }
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    browser.开始下载 (url)
                    返回 (MCP_响应构建.命令成功 (命令ID, "下载已触发: " + url + " | 保存目录=" + 选择 (保存目录 == "", 取运行目录 () + "\\Downloads", 保存目录)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 url 不能为空"))
        }
        // === 编辑操作 ===
        否则 (方法名 == "browser_edit_undo")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 undoFrame <类型 = 类_FBrowser_框架>
                undoFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (undoFrame.是否为空 () == 假 && undoFrame.是否有效 ())
                {
                    undoFrame.撤销 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "撤销成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_redo")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
