            rvCode = "(function(){var __orig=" + rvOriginal + ";var __reimpl=" + rvReimpl + ";var __inputs=" + rvInputs + ";var R=[];for(var i=0;i<__inputs.length;i++){var inp=__inputs[i];var o=__orig(inp);var r=__reimpl(inp);var match=" + 选择 (rvMode == "strict", "o===r", "JSON.stringify(o)===JSON.stringify(r)") + ";R.push({input:inp,original:o,reimpl:r,match:match})}return JSON.stringify({verified:R.every(function(x){return x.match}),total:R.length,results:R})})()"
