            {
                变量 redoFrame <类型 = 类_FBrowser_框架>
                redoFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (redoFrame.是否为空 () == 假 && redoFrame.是否有效 ())
                {
                    redoFrame.恢复 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "恢复成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_cut")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 cutFrame <类型 = 类_FBrowser_框架>
                cutFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (cutFrame.是否为空 () == 假 && cutFrame.是否有效 ())
                {
                    cutFrame.剪切 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "剪切成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_copy")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 copyFrame <类型 = 类_FBrowser_框架>
                copyFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (copyFrame.是否为空 () == 假 && copyFrame.是否有效 ())
                {
                    copyFrame.复制 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "复制成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_paste")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 pasteFrame <类型 = 类_FBrowser_框架>
                pasteFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (pasteFrame.是否为空 () == 假 && pasteFrame.是否有效 ())
                {
                    pasteFrame.粘贴 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "粘贴成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_delete")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 delFrame <类型 = 类_FBrowser_框架>
                delFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (delFrame.是否为空 () == 假 && delFrame.是否有效 ())
                {
                    delFrame.删除 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "删除成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_edit_select_all")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 selFrame <类型 = 类_FBrowser_框架>
                selFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (selFrame.是否为空 () == 假 && selFrame.是否有效 ())
                {
                    selFrame.全选 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "全选成功"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 框架列表 (原生 API, 非JS) ===
        否则 (方法名 == "browser_get_frames")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 id数组 <类型 = FBrowser_文本数组>
                id数组 = browser.取框架ID ()
                变量 name数组 <类型 = FBrowser_文本数组>
                name数组 = browser.取框架名称 ()
                变量 帧JSON <类型 = 文本型>
                帧JSON = "["
                变量 帧首项 <类型 = 逻辑型 值 = 真>
                变量 帧数 <类型 = 整数>
                帧数 = id数组.取个数 ()
                计次循环 (帧数)
                {
                    变量 fi <类型 = 整数>
                    fi = 取循环索引 ()
                    如果 (帧首项)
                    {
                        帧首项 = 假
                    }
                    否则
                    {
                        帧JSON = 帧JSON + ","
                    }
                    变量 帧项 <类型 = YYJSON对象类>
                    帧项.创建自文本 ("{}")
                    如果 (fi < id数组.取个数 ())
                    {
                        帧项.加入文本成员 ("id", id数组.取数据 (fi))
                    }
                    如果 (fi < name数组.取个数 ())
                    {
                        帧项.加入文本成员 ("name", name数组.取数据 (fi))
                    }
                    // 约束: is_main 必须问**框架对象本身**(是否为主框架), 不能按"第 0 项就是主框架"推断 ——
                    // 实测 类库 取框架ID() 的顺序**不保证主框架在前**(本机出现过 [子框架, 主框架] 的次序),
                    // 按序号推断会把子框架标成 is_main 真、把主框架标成假, 调用方据此选框架就会操作错对象。
                    变量 帧主判定 <类型 = 逻辑型>
                    帧主判定 = 假
                    如果 (fi < id数组.取个数 ())
                    {
                        变量 帧实体 <类型 = 类_FBrowser_框架>
                        帧实体 = browser.取框架_ID (id数组.取数据 (fi))
                        如果 (帧实体.是否为空 () == 假 && 帧实体.是否有效 ())
                        {
                            帧主判定 = 帧实体.是否为主框架 ()
                            // 地址一并给出: 跨域(OOPIF)框架不在 CDP 框架树里, 按地址对照是唯一可靠的手段
                            帧项.加入文本成员 ("url", 帧实体.取地址 ())
                            // 框架层级(补类库 取父框架 缺口 —— 该方法是全项目 0 调用):
                            //   平铺清单无法表达"谁是谁的子框架", 而广告/嵌套/OOPIF iframe 常需逐级向上操作。
                            //   主框架没有父框架 ⇒ parent_id 为空串(如实表达"无父", 不用 0/假值代替)。
                            变量 帧父框架 <类型 = 类_FBrowser_框架>
                            帧父框架 = 帧实体.取父框架 ()
                            如果 (帧父框架.是否为空 () == 假 && 帧父框架.是否有效 ())
                            {
                                帧项.加入文本成员 ("parent_id", 帧父框架.取框架ID ())
                            }
                            否则
                            {
                                帧项.加入文本成员 ("parent_id", "")
                            }
                            // 焦点框架(类库 是否为焦点框架, 此前亦零调用): 键盘输入/按键会落到哪个框架, 代理必须能看出来
                            如果 (帧实体.是否为焦点框架 ())
                            {
                                帧项.加入逻辑值成员 ("is_focused", 真)
                            }
                            否则
                            {
                                帧项.加入逻辑值成员 ("is_focused", 假)
                            }
                        }
                    }
                    如果 (帧主判定)
                    {
                        帧项.加入逻辑值成员 ("is_main", 真)
                    }
                    否则
                    {
                        帧项.加入逻辑值成员 ("is_main", 假)
                    }
                    帧JSON = 帧JSON + 帧项.到可读文本 (YYJSON格式化选项.压缩)
                }
                帧JSON = 帧JSON + "]"
                返回 (MCP_响应构建.构建命令嵌套JSON (命令ID, 真, "frames", 帧JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 窗口句柄/可见性/焦点 ===
        否则 (方法名 == "browser_get_window_handle")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建简单JSON ("hwnd", 到文本 (browser.取窗口句柄 ())))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_set_focus")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "focus") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "focus 不能省略 | 省略等同于让窗口失去焦点; 请显式传 true=获得焦点 / false=失去焦点"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 焦点 <类型 = 逻辑型>
                焦点 = MCP命令服务器.yyjson取逻辑 (参数JSON, "focus")
                browser.置焦点 (焦点)
                返回 (MCP_响应构建.命令成功 (命令ID, "焦点" + 选择 (焦点, "已获得", "已失去")))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 静音状态 ===
        否则 (方法名 == "browser_is_muted")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建逻辑值JSON ("muted", browser.是否页面静音 ()))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 内存压缩 ===
        否则 (方法名 == "browser_compress_memory")
        {
            FBrowser_内存_压缩清理 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "内存已压缩清理"))
        }
        // === FBrowser版本 ===
        否则 (方法名 == "browser_fbro_version")
        {
            变量 版本号 <类型 = 文本型>
            版本号 = FBrowser_取版本号 ()
            返回 (MCP_响应构建.构建简单JSON ("fbro_version", 版本号))
        }
        // === DOM查询 (原生填表框架 API, 非JS) ===
        否则 (方法名 == "browser_dom_query")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 attribute <类型 = 文本型>
                    attribute = MCP命令服务器.yyjson取文本 (参数JSON, "attribute")
                    // ★ index 必须真的生效: 此前实现写死 querySelector(第 1 个匹配), 传 index=3 会**静默拿到第 1 个**
                    //   —— 属"静默错答案", 比报错更危险。改用 querySelectorAll[index]; 越界时如实报"实际有几个匹配"。
                    变量 查询索引 <类型 = 整数>
                    查询索引 = MCP命令服务器.yyjson取整数 (参数JSON, "index")
                    如果 (查询索引 < 0)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "index 不能为负: " + 到文本 (查询索引) + " | 索引从 0 开始(0=第 1 个匹配)"))
                    }
                    变量 js查询码 <类型 = 文本型>
                    如果 (attribute != "")
                    {
                        js查询码 = "(function(){var l=document.querySelectorAll('" + MCP命令服务器.简单转义JS (selector) + "');if(!l.length)return '__MCP_NO_ELEM__';var i=" + 到文本 (查询索引) + ";if(i>=l.length)return '__MCP_NO_INDEX__:'+l.length;var v=l[i].getAttribute('" + MCP命令服务器.简单转义JS (attribute) + "');return v===null?'__MCP_NO_ATTR__':v})()"
                    }
                    否则
                    {
                        js查询码 = "(function(){var l=document.querySelectorAll('" + MCP命令服务器.简单转义JS (selector) + "');if(!l.length)return '__MCP_NO_ELEM__';var i=" + 到文本 (查询索引) + ";if(i>=l.length)return '__MCP_NO_INDEX__:'+l.length;return l[i].textContent})()"
                    }
                    变量 js查询值 <类型 = 文本型>
                    js查询值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js查询码, 10000)
                    如果 (js查询值 != "" && js查询值 != "null" && js查询值 != "undefined" && 是否以 (js查询值, "{\"error\"") == 假)
                    {
                        如果 (js查询值 == "__MCP_NO_ELEM__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                        }
                        如果 (js查询值 == "__MCP_NO_ATTR__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "属性不存在: 元素已找到, 但没有该 HTML 属性 | 提示: textContent/innerText/value 等是 DOM 属性(property)而非 HTML 属性, 取它们请用 browser_get_text 或 browser_dom_query 的 selector 模式"))
                        }
                        // 索引越界: 如实报"实际有几个匹配", 绝不退回第一个(否则就是静默错答案)
                        如果 (是否以 (js查询值, "__MCP_NO_INDEX__:"))
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "index 越界: 请求 index=" + 到文本 (查询索引) + ", 但该选择器**实际只有 " + 取文本右边 (js查询值, 取文本长度 (js查询值) - 取文本长度 ("__MCP_NO_INDEX__:")) + " 个匹配** | 索引从 0 开始; 去掉 index 参数即取第 1 个匹配"))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, js查询值))
                    }
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        如果 (attribute != "")
                        {
                            变量 异步填表ID <类型 = 文本型>
                            异步填表ID = MCP命令服务器.生成异步任务ID ()
                            变量 填表回调 <类型 = 类_FBrowser_事件智能指针>
                            填表回调.创建 (类_MCP_JS异步回调)
                            填表回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步填表ID
                            填表框架.取元素属性 (selector, 查询索引, attribute, 填表回调)
                            返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步填表ID, "DOM属性查询(原生)已提交"))
                        }
                        否则
                        {
                            变量 异步内容ID <类型 = 文本型>
                            异步内容ID = MCP命令服务器.生成异步任务ID ()
                            变量 内容回调 <类型 = 类_FBrowser_事件智能指针>
                            内容回调.创建 (类_MCP_JS异步回调)
                            内容回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步内容ID
                            填表框架.取元素内容 (selector, 查询索引, 内容回调)
                            返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步内容ID, "DOM内容查询(原生)已提交"))
                        }
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM点击 (原生链: 元素是否存在→点击元素) ===
        否则 (方法名 == "browser_dom_click")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步点击ID <类型 = 文本型>
                        异步点击ID = MCP命令服务器.生成异步任务ID ()
                        变量 点击回调 <类型 = 类_FBrowser_事件智能指针>
                        点击回调.创建 (类_MCP_存在后点击回调)
                        点击回调.取执行类 (类_MCP_存在后点击回调).任务ID = 异步点击ID
                        点击回调.取执行类 (类_MCP_存在后点击回调).浏览器ID = browser.取ID ()
                        点击回调.取执行类 (类_MCP_存在后点击回调).选择器文本 = selector
                        填表框架.元素是否存在 (selector, 0, 点击回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步点击ID, "DOM点击(原生)已提交, 通过mcp_result查询"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM设置值 (原生填表框架 API, 非JS) ===
        否则 (方法名 == "browser_dom_set_value")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            变量 value <类型 = 文本型>
            value = MCP命令服务器.yyjson取文本 (参数JSON, "value")
            如果 (selector == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空 | CSS选择器示例: #id / .class / input[name='q']"))
            }
            如果 (value == "" && MCP命令服务器.yyjson取整数 (参数JSON, "allow_empty") == 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 value 不能为空 | 如需清空请设置 allow_empty:1"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 js置值 <类型 = 文本型>
                js置值 = "(function(){var e=document.querySelector('" + MCP命令服务器.简单转义JS (selector) + "');if(!e)return '__MCP_NO_ELEM__';var v='" + MCP命令服务器.简单转义JS (value) + "';var P=(e.tagName==='TEXTAREA')?window.HTMLTextAreaElement.prototype:(e.tagName==='SELECT')?window.HTMLSelectElement.prototype:window.HTMLInputElement.prototype;try{e.focus();var n=Object.getOwnPropertyDescriptor(P,'value');if(n&&n.set)n.set.call(e,v);else e.value=v;}catch(x){e.value=v;}e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}));return String(e.value)})()"
                变量 js置回读 <类型 = 文本型>
                js置回读 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js置值, 10000)
                如果 (js置回读 == "__MCP_NO_ELEM__")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + selector + " | 设置值未执行 | 建议: 先用 browser_snapshot 或 browser_get_forms 确认元素存在"))
                }
                如果 (js置回读 == value)
                {
                    变量 置值回执 <类型 = YYJSON对象类>
                    置值回执.创建自文本 ("{}")
                    置值回执.加入逻辑值成员 ("success", 真)
                    置值回执.加入文本成员 ("selector", selector)
                    置值回执.加入文本成员 ("value", js置回读)
                    置值回执.加入逻辑值成员 ("verified", 真)
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 置值回执.到可读文本 (YYJSON格式化选项.压缩)))
                }
                如果 (js置回读 != "" && js置回读 != "null" && js置回读 != "undefined" && 是否以 (js置回读, "{\"error\"") == 假)
                {
                    // 回读成功但与请求值不符: 元素对值做了规范化或拒绝(如 input[type=number] 收到非数字)
                    返回 (MCP_响应构建.命令失败 (命令ID, "设置值未生效或已被元素规范化: 请求=" + value + " 实际=" + js置回读 + " | 元素类型可能不接受该值(如 input[type=number]/date 会丢弃非法输入)"))
                }
                变量 ff <类型 = 类_FBrowser_填表框架>
                ff = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                如果 (ff.是否有效 ())
                {
                    变量 异步ID <类型 = 文本型>
                    异步ID = MCP命令服务器.生成异步任务ID ()
                    变量 fcb <类型 = 类_FBrowser_事件智能指针>
                    fcb.创建 (类_MCP_存在后填表回调)
                    fcb.取执行类 (类_MCP_存在后填表回调).任务ID = 异步ID
                    fcb.取执行类 (类_MCP_存在后填表回调).浏览器ID = browser.取ID ()
                    fcb.取执行类 (类_MCP_存在后填表回调).选择器文本 = selector
                    fcb.取执行类 (类_MCP_存在后填表回调).操作类型 = "set_value"
                    fcb.取执行类 (类_MCP_存在后填表回调).操作值 = value
                    ff.元素是否存在 (selector, 0, fcb)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步ID, "DOM设置已提交, 通过mcp_result查询"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === DOM获取HTML (原生取源码_异步, 非JS) ===
        否则 (方法名 == "browser_dom_get_html")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 maxChars <类型 = 整数>
                maxChars = MCP命令服务器.yyjson取整数 (参数JSON, "max_chars")
                如果 (maxChars <= 0 || maxChars > MCP_常量.截断_源码最大字节)
                {
                    maxChars = MCP_常量.截断_源码默认字节
                }
                如果 (selector != "")
                {
                    // 原生: 填表框架取元素外代码 (=outerHTML)
                    变量 填表框架2 <类型 = 类_FBrowser_填表框架>
                    填表框架2 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架2.是否有效 ())
                    {
                        变量 异步外码ID <类型 = 文本型>
                        异步外码ID = MCP命令服务器.生成异步任务ID ()
                        变量 外码回调 <类型 = 类_FBrowser_事件智能指针>
                        外码回调.创建 (类_MCP_JS异步回调)
                        外码回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步外码ID
                        填表框架2.取元素外代码 (selector, 0, 外码回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步外码ID, "HTML(原生outerHTML)已提交"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                否则
                {
                    // 无selector: 使用原生取源码_异步 API
                    变量 source <类型 = 文本型>
                    source = MCP命令服务器.提交异步取源码任务 (browser, , maxChars)
                    返回 (MCP命令服务器.包装异步提交结果 (命令ID, source, "html", "HTML获取(原生)已提交"))
                }
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === DOM元素坐标 (原生填表框架, 非JS) ===
        否则 (方法名 == "browser_dom_rect")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 js坐标 <类型 = 文本型>
                    js坐标 = "(function(){var s='" + MCP命令服务器.简单转义JS (selector) + "';var e=document.querySelector(s);if(!e)return '__MCP_NO_ELEM__';var r=e.getBoundingClientRect();return JSON.stringify({selector:s,x:r.x,y:r.y,left:r.left,top:r.top,width:r.width,height:r.height,visible:(r.width>0&&r.height>0)})})()"
                    变量 js坐标值 <类型 = 文本型>
                    js坐标值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js坐标, 10000)
                    如果 (js坐标值 != "" && js坐标值 != "null" && js坐标值 != "undefined" && 是否以 (js坐标值, "{\"error\"") == 假)
                    {
                        如果 (js坐标值 == "__MCP_NO_ELEM__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, js坐标值))
                    }
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步坐标ID <类型 = 文本型>
                        异步坐标ID = MCP命令服务器.生成异步任务ID ()
                        变量 坐标回调 <类型 = 类_FBrowser_事件智能指针>
                        坐标回调.创建 (类_MCP_JS异步回调)
                        坐标回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步坐标ID
                        填表框架.取元素坐标 (selector, 0, 坐标回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步坐标ID, "元素坐标(原生)获取已提交; 该原生路径只返回「x, y」且无宽度/高度, 如需宽高请重试以走 CDP 路径"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM元素 innerHTML (原生填表框架, 非JS) ===
        否则 (方法名 == "browser_dom_inner_html")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 js内码 <类型 = 文本型>
                    js内码 = "(function(){var e=document.querySelector('" + MCP命令服务器.简单转义JS (selector) + "');return e?e.innerHTML:'__MCP_NO_ELEM__'})()"
                    变量 js内码值 <类型 = 文本型>
                    js内码值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js内码, 10000)
                    如果 (js内码值 != "" && js内码值 != "null" && js内码值 != "undefined" && 是否以 (js内码值, "{\"error\"") == 假)
                    {
                        如果 (js内码值 == "__MCP_NO_ELEM__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, js内码值))
                    }
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步内码ID <类型 = 文本型>
                        异步内码ID = MCP命令服务器.生成异步任务ID ()
                        变量 内码回调 <类型 = 类_FBrowser_事件智能指针>
                        内码回调.创建 (类_MCP_JS异步回调)
                        内码回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步内码ID
                        填表框架.取元素内代码 (selector, 0, 内码回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步内码ID, "innerHTML(原生)获取已提交"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM获取勾选状态 (原生填表框架, 非JS) ===
        否则 (方法名 == "browser_dom_checked")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 js勾选 <类型 = 文本型>
                    js勾选 = "(function(){var s='" + MCP命令服务器.简单转义JS (selector) + "';var e=document.querySelector(s);if(!e)return '__MCP_NO_ELEM__';if(!('checked' in e))return '__MCP_NOT_CHECKABLE__';return JSON.stringify({selector:s,checked:!!e.checked,type:e.type||'',name:e.name||'',value:e.value||''})})()"
                    变量 js勾选值 <类型 = 文本型>
                    js勾选值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js勾选, 10000)
                    如果 (js勾选值 != "" && js勾选值 != "null" && js勾选值 != "undefined" && 是否以 (js勾选值, "{\"error\"") == 假)
                    {
                        如果 (js勾选值 == "__MCP_NO_ELEM__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                        }
                        如果 (js勾选值 == "__MCP_NOT_CHECKABLE__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "该元素没有勾选状态(不是 checkbox/radio): " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_snapshot 或 browser_dom_query 的 selector 模式确认元素类型"))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, js勾选值))
                    }
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步勾选ID <类型 = 文本型>
                        异步勾选ID = MCP命令服务器.生成异步任务ID ()
                        变量 勾选回调 <类型 = 类_FBrowser_事件智能指针>
                        勾选回调.创建 (类_MCP_JS异步回调)
                        勾选回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步勾选ID
                        填表框架.取元素选择框 (selector, 0, 勾选回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步勾选ID, "checkbox状态(原生)获取已提交; 该原生路径只返回 1/0, 1=已勾选"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM获取选中项 (原生填表框架, 非JS) ===
        否则 (方法名 == "browser_dom_selected")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 js选中 <类型 = 文本型>
                    js选中 = "(function(){var s='" + MCP命令服务器.简单转义JS (selector) + "';var e=document.querySelector(s);if(!e)return '__MCP_NO_ELEM__';if(e.tagName!=='SELECT')return '__MCP_NOT_SELECT__';var o=e.selectedOptions||[];var vs=[];var ts=[];for(var i=0;i<o.length;i++){vs.push(o[i].value);ts.push(o[i].text)}return JSON.stringify({selector:s,index:e.selectedIndex,value:e.value||'',text:(o[0]?o[0].text:''),values:vs,texts:ts,multiple:!!e.multiple,option_count:e.options.length})})()"
                    变量 js选中值 <类型 = 文本型>
                    js选中值 = MCP命令服务器.CDP执行JS按框架 (browser, 参数JSON, js选中, 10000)
                    如果 (js选中值 != "" && js选中值 != "null" && js选中值 != "undefined" && 是否以 (js选中值, "{\"error\"") == 假)
                    {
                        如果 (js选中值 == "__MCP_NO_ELEM__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "元素不存在或取不到值: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在"))
                        }
                        如果 (js选中值 == "__MCP_NOT_SELECT__")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "该元素不是 select 下拉框, 没有选中项: " + MCP命令服务器.简单转义JS (selector) + " | 建议: 先用 browser_snapshot 或 browser_dom_query 的 selector 模式确认元素类型"))
                        }
                        返回 (MCP_响应构建.命令成功 (命令ID, js选中值))
                    }
                    变量 填表框架 <类型 = 类_FBrowser_填表框架>
                    填表框架 = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (填表框架.是否有效 ())
                    {
                        变量 异步选中ID <类型 = 文本型>
                        异步选中ID = MCP命令服务器.生成异步任务ID ()
                        变量 选中回调 <类型 = 类_FBrowser_事件智能指针>
                        选中回调.创建 (类_MCP_JS异步回调)
                        选中回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步选中ID
                        填表框架.取元素选择项 (selector, 0, 选中回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步选中ID, "select选项(原生)获取已提交; 该原生路径只返回选中项**索引**(非 value), 请勿当作值使用"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM设置 select 选中项 (事件驱动: 先检查存在再操作) ===
        否则 (方法名 == "browser_dom_select")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            变量 index <类型 = 整数>
            index = MCP命令服务器.yyjson取整数 (参数JSON, "index")
            如果 (selector != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 ff <类型 = 类_FBrowser_填表框架>
                    ff = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (ff.是否有效 ())
                    {
                        变量 异步ID <类型 = 文本型>
                        异步ID = MCP命令服务器.生成异步任务ID ()
                        变量 fcb <类型 = 类_FBrowser_事件智能指针>
                        fcb.创建 (类_MCP_存在后填表回调)
                        fcb.取执行类 (类_MCP_存在后填表回调).任务ID = 异步ID
                        fcb.取执行类 (类_MCP_存在后填表回调).浏览器ID = browser.取ID ()
                        fcb.取执行类 (类_MCP_存在后填表回调).选择器文本 = selector
                        fcb.取执行类 (类_MCP_存在后填表回调).操作类型 = "select_index"
                        fcb.取执行类 (类_MCP_存在后填表回调).操作值 = 到文本 (index)
                        ff.元素是否存在 (selector, 0, fcb)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步ID, "DOM select已提交, 通过mcp_result查询"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector 不能为空"))
        }
        // === DOM设置 innerHTML (事件驱动: 先检查存在再操作) ===
        否则 (方法名 == "browser_dom_set_html")
        {
            变量 selector <类型 = 文本型>
            selector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            变量 html <类型 = 文本型>
            html = MCP命令服务器.yyjson取文本 (参数JSON, "html")
            如果 (selector != "" && html != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 ff <类型 = 类_FBrowser_填表框架>
                    ff = MCP命令服务器.解析填表框架 (browser, MCP命令服务器.yyjson取文本 (参数JSON, "frame_id"))
                    如果 (ff.是否有效 ())
                    {
                        变量 异步ID <类型 = 文本型>
                        异步ID = MCP命令服务器.生成异步任务ID ()
                        变量 fcb <类型 = 类_FBrowser_事件智能指针>
                        fcb.创建 (类_MCP_存在后填表回调)
                        fcb.取执行类 (类_MCP_存在后填表回调).任务ID = 异步ID
                        fcb.取执行类 (类_MCP_存在后填表回调).浏览器ID = browser.取ID ()
                        fcb.取执行类 (类_MCP_存在后填表回调).选择器文本 = selector
                        fcb.取执行类 (类_MCP_存在后填表回调).操作类型 = "set_html"
                        fcb.取执行类 (类_MCP_存在后填表回调).操作值 = html
                        ff.元素是否存在 (selector, 0, fcb)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步ID, "DOM innerHTML已提交, 通过mcp_result查询"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_填表框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 selector/html 不能为空"))
        }
        // === 控制台执行 ===
        否则 (方法名 == "browser_console_eval")
        {
            // 支持 file 参数: 从文件读取JS代码 (避免JSON转义问题)
            变量 expression <类型 = 文本型>
            expression = MCP命令服务器.yyjson取文本 (参数JSON, "expression")
            如果 (expression == "")
            {
                expression = MCP命令服务器.yyjson取文本 (参数JSON, "file")
                如果 (expression != "")
                {
                    如果 (MCP命令服务器.验证安全路径 (expression) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "文件路径不允许: " + expression + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))
                    }
                    变量 consoleFileBytes <类型 = 字节集类>
                    consoleFileBytes = 读入文件 (expression)
                    如果 (取字节集长度 (consoleFileBytes) > 0)
                    {
                        expression = UTF8到文本 (consoleFileBytes)
                    }
                    否则
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "文件读取失败: " + expression))
                    }
                }
            }
            如果 (expression != "")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    // CDP 优先(与 browser_execute_js/browser_evaluate 同款, 稳定 0.02~0.05s):
                    // 原生"带返回值JS"通道约 8% 概率回调丢失 → 5s 超时(2025-09-13 全量扫测实测)。
                    变量 ceCDP值 <类型 = 文本型>
                    ceCDP值 = MCP命令服务器.CDP执行JS并等待 (expression, MCP_常量.同步等待_JS执行超时, 真)
                    如果 (是否以 (ceCDP值, "{\"error\":\"JS异常:"))
                    {
                        变量 ce异常解析 <类型 = YYJSON只读对象类>
                        变量 ce异常文本 <类型 = 文本型>
                        如果 (ce异常解析.创建自文本 (ceCDP值))
                        {
                            ce异常文本 = MCP命令服务器.yyjson取文本 (ce异常解析, "error")
                        }
                        如果 (ce异常文本 == "")
                        {
                            ce异常文本 = ceCDP值
                        }
                        返回 (MCP_响应构建.命令失败 (命令ID, ce异常文本 + " | 该异常由你提供的 expression 抛出, 属终局结论"))
                    }
                    如果 (ceCDP值 != "" && ceCDP值 != "undefined" && 是否以 (ceCDP值, "{\"error\"") == 假)
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, ceCDP值))
                    }
                    // CDP 不可用时回退原生异步通道(保持原有行为)
                    变量 异步ID <类型 = 文本型>
                    异步ID = MCP命令服务器.生成异步任务ID ()
                    MCP命令服务器.提交异步JS任务 (browser, expression, 异步ID)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步ID, "表达式已提交, 通过mcp_result查询", 150))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "缺少参数: 请提供 expression(JS表达式), 例如: document.title"))
        }
        // === 指纹 ===
        否则 (方法名 == "browser_fingerprint")
        {
            变量 action <类型 = 文本型>
            action = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (action == "clear")
                    {
                        vip_ctrl.清理数据 ()
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "指纹已清除"))
                    }
                    否则 (action == "count")
                    {
                        返回 (MCP_响应构建.构建简单JSON ("count", vip_ctrl.指纹_取调用计数 ()))
                    }
                    否则 (action == "clear_count")
                    {
                        vip_ctrl.指纹_清空调用计数 ()
                        变量 清计数回执 <类型 = YYJSON对象类>
                        清计数回执.创建自文本 ("{}")
                        清计数回执.加入逻辑值成员 ("success", 真)
                        清计数回执.加入逻辑值成员 ("cleared", 真)
                        清计数回执.加入文本成员 ("count", vip_ctrl.指纹_取调用计数 ())
                        返回 (清计数回执.到可读文本 (YYJSON格式化选项.压缩))
                    }
                    否则 (action == "canvas_random")
                    {
                        变量 minN <类型 = 整数>
                        minN = MCP命令服务器.yyjson取整数 (参数JSON, "min")
                        变量 maxN <类型 = 整数>
                        maxN = MCP命令服务器.yyjson取整数 (参数JSON, "max")
                        如果 (minN == 0)
                        {
                            minN = 5
                        }
                        如果 (maxN == 0)
                        {
                            maxN = 50
                        }
                        vip_ctrl.指纹_虚拟Canvas_随机 (minN, maxN, MCP命令服务器.yyjson取整数 (参数JSON, "seed"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Canvas指纹已随机化"))
                    }
                    否则 (action == "webgl_random")
                    {
                        变量 minN <类型 = 整数>
                        minN = MCP命令服务器.yyjson取整数 (参数JSON, "min")
                        变量 maxN <类型 = 整数>
                        maxN = MCP命令服务器.yyjson取整数 (参数JSON, "max")
                        如果 (minN == 0)
                        {
                            minN = 3
                        }
                        如果 (maxN == 0)
                        {
                            maxN = 30
                        }
                        vip_ctrl.指纹_虚拟WebGL_随机 (minN, maxN, MCP命令服务器.yyjson取整数 (参数JSON, "seed"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "WebGL指纹已随机化"))
                    }
                    否则 (action == "audio_random")
                    {
                        变量 minN <类型 = 整数>
                        minN = MCP命令服务器.yyjson取整数 (参数JSON, "min")
                        变量 maxN <类型 = 整数>
                        maxN = MCP命令服务器.yyjson取整数 (参数JSON, "max")
                        如果 (minN == 0)
                        {
                            minN = 100
                        }
                        如果 (maxN == 0)
                        {
                            maxN = 500
                        }
                        vip_ctrl.指纹_虚拟Audio_随机 (minN, maxN, MCP命令服务器.yyjson取整数 (参数JSON, "seed"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Audio指纹已随机化"))
                    }
                    否则 (action == "audio_param")
                    {
                        变量 sampleRate <类型 = 整数>
                        sampleRate = MCP命令服务器.yyjson取整数 (参数JSON, "sample_rate")
                        变量 channels <类型 = 整数>
                        channels = MCP命令服务器.yyjson取整数 (参数JSON, "channels")
                        变量 framesPerBuffer <类型 = 整数>
                        framesPerBuffer = MCP命令服务器.yyjson取整数 (参数JSON, "frames_per_buffer")
                        如果 (sampleRate == 0 && channels == 0 && framesPerBuffer == 0)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "audio_param 需要 sample_rate/channels/frames_per_buffer 至少一项"))
                        }
                        变量 配置JSON <类型 = 文本型>
                        配置JSON = "{"
                        变量 首字段 <类型 = 逻辑型 值 = 真>
                        如果 (sampleRate > 0)
                        {
                            配置JSON = 配置JSON + "\"sample_rate\":" + 到文本 (sampleRate)
                            首字段 = 假
                        }
                        如果 (channels > 0)
                        {
                            如果 (首字段 == 假)
                            {
                                配置JSON = 配置JSON + ","
                            }
                            配置JSON = 配置JSON + "\"channels\":" + 到文本 (channels)
                            首字段 = 假
                        }
                        如果 (framesPerBuffer > 0)
                        {
                            如果 (首字段 == 假)
                            {
                                配置JSON = 配置JSON + ","
                            }
                            配置JSON = 配置JSON + "\"frames_per_buffer\":" + 到文本 (framesPerBuffer)
                        }
                        配置JSON = 配置JSON + "}"
                        MCP命令服务器.音频指纹配置 = 配置JSON
                        MCP命令服务器.是否Hook音频 = 真
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "音频参数Hook已启用(事件通道), 刷新后生效: " + 配置JSON))
                    }
                    否则 (action == "webrtc")
                    {
                        vip_ctrl.指纹_虚拟WebrtcIP (MCP命令服务器.yyjson取文本 (参数JSON, "public_ip"), MCP命令服务器.yyjson取文本 (参数JSON, "local_ip"), MCP命令服务器.yyjson取文本 (参数JSON, "host"), MCP命令服务器.yyjson取逻辑 (参数JSON, "disable"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "WebRTC已设置"))
                    }
                    否则 (action == "geolocation")
                    {
                        变量 lat <类型 = 小数>
                        lat = MCP命令服务器.yyjson取小数 (参数JSON, "latitude")
                        变量 lng <类型 = 小数>
                        lng = MCP命令服务器.yyjson取小数 (参数JSON, "longitude")
                        // 名称兼容(实测缺陷修正): 兄弟工具 browser_vip_fingerprint_geolocation 用的是 lat/lng,
                        // 而本入口原先只认 latitude/longitude —— 调用方照另一处文档传 lat/lng 会被**静默忽略**
                        // (坐标保持 0 且回 success)。改为两者都接受(专用名优先), 免得调用方去记两套名字。
                        如果 (lat == 0 && MCP命令服务器.参数键存在 (参数JSON, "lat"))
                        {
                            lat = MCP命令服务器.yyjson取小数 (参数JSON, "lat")
                        }
                        如果 (lng == 0 && MCP命令服务器.参数键存在 (参数JSON, "lng"))
                        {
                            lng = MCP命令服务器.yyjson取小数 (参数JSON, "lng")
                        }
                        vip_ctrl.指纹_虚拟定位 (lng, lat, 10, -10000, -1, -1, -1)
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "定位已设置"))
                    }
                    否则 (action == "timezone")
                    {
                        vip_ctrl.指纹_虚拟Date时区 (MCP命令服务器.yyjson取整数 (参数JSON, "offset_h"), MCP命令服务器.yyjson取整数 (参数JSON, "offset_m"), MCP命令服务器.yyjson取文本 (参数JSON, "name"), MCP命令服务器.yyjson取文本 (参数JSON, "iana"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "时区已设置"))
                    }
                    否则 (action == "ssl")
                    {
                        变量 tls_min_int <类型 = 整数>
                        变量 tls_max_int <类型 = 整数>
                        变量 tls_min_enum <类型 = TLS版本>
                        变量 tls_max_enum <类型 = TLS版本>
                        tls_min_int = MCP命令服务器.yyjson取整数 (参数JSON, "tls_min")
                        tls_max_int = MCP命令服务器.yyjson取整数 (参数JSON, "tls_max")
                        // 整数→TLS版本枚举映射 (使用 MCP_服务器工具 统一方法)
                        tls_min_enum = MCP_服务器工具.整数到TLS版本 (tls_min_int)
                        tls_max_enum = MCP_服务器工具.整数到TLS版本 (tls_max_int)
                        vip_ctrl.指纹_设置SSL加密套件 (tls_min_enum, tls_max_enum, MCP命令服务器.yyjson取文本 (参数JSON, "ciphers"))
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "SSL加密套件已设置"))
                    }
                    否则 (action == "set_batch")
                    {
                        变量 config_text <类型 = 文本型>
                        config_text = MCP命令服务器.yyjson取JSON文本 (参数JSON, "config")
                        变量 配置解析 <类型 = YYJSON只读对象类>
                        如果 (config_text != "" && 配置解析.创建自文本 (config_text))
                        {
                            变量 appliedCount <类型 = 整数 值 = 0>
                            变量 val <类型 = 文本型>
                            val = MCP命令服务器.yyjson取文本 (配置解析, "user_agent")
                            如果 (val != "")
                            {
                                变量 ua <类型 = 类_FBrowserVIP_UA数据>
                                ua.创建 ()
                                ua.置UserAgent (val)
                                vip_ctrl.指纹_虚拟UserAgent (ua)
                                appliedCount = appliedCount + 1
                            }
                            val = MCP命令服务器.yyjson取文本 (配置解析, "vendor")
                            如果 (val != "")
                            {
                                vip_ctrl.指纹_虚拟Vendor (val)
                                appliedCount = appliedCount + 1
                            }
                            val = MCP命令服务器.yyjson取文本 (配置解析, "product")
                            如果 (val != "")
                            {
                                vip_ctrl.指纹_虚拟Product (val)
                                appliedCount = appliedCount + 1
                            }
                            val = MCP命令服务器.yyjson取文本 (配置解析, "languages")
                            如果 (val != "")
                            {
                                vip_ctrl.指纹_虚拟Languages (val)
                                appliedCount = appliedCount + 1
                            }
                            val = MCP命令服务器.yyjson取文本 (配置解析, "webgl_vendor")
                            如果 (val != "")
                            {
                                vip_ctrl.指纹_虚拟Webglvendor (val)
                                appliedCount = appliedCount + 1
                            }
                            val = MCP命令服务器.yyjson取文本 (配置解析, "webgl_renderer")
                            如果 (val != "")
                            {
                                vip_ctrl.指纹_虚拟Webglrenderer (val)
                                appliedCount = appliedCount + 1
                            }
                            变量 intVal <类型 = 整数>
                            intVal = MCP命令服务器.yyjson取整数 (配置解析, "hardware_concurrency")
                            如果 (intVal > 0)
                            {
                                vip_ctrl.指纹_虚拟HardwareConcurrency (intVal)
                                appliedCount = appliedCount + 1
                            }
                            intVal = MCP命令服务器.yyjson取整数 (配置解析, "device_memory")
                            如果 (intVal > 0)
                            {
                                vip_ctrl.指纹_虚拟DeviceMemory (intVal)
                                appliedCount = appliedCount + 1
                            }
                            // 仅当 config 存在 webdriver 键时才应用并计数 (取对象+取类型, 未知=缺失键)
                            变量 wd节点 <类型 = YYJSON只读对象类>
                            wd节点 = 配置解析.取对象 ("webdriver")
                            如果 (wd节点.取类型 () != YYJSON值类型.未知)
                            {
                                vip_ctrl.指纹_虚拟Webdriver (MCP命令服务器.yyjson取逻辑 (配置解析, "webdriver"))
                                appliedCount = appliedCount + 1
                            }
                            变量 w <类型 = 整数>
                            w = MCP命令服务器.yyjson取整数 (配置解析, "width")
                            变量 h <类型 = 整数>
                            h = MCP命令服务器.yyjson取整数 (配置解析, "height")
                            如果 (w > 0 && h > 0)
                            {
                                vip_ctrl.指纹_虚拟屏幕分辨率 (h, w)
                                appliedCount = appliedCount + 1
                            }
                            w = MCP命令服务器.yyjson取整数 (配置解析, "avail_width")
                            h = MCP命令服务器.yyjson取整数 (配置解析, "avail_height")
                            如果 (w > 0 && h > 0)
                            {
                                vip_ctrl.指纹_虚拟屏幕可用高度和宽度 (h, w)
                                appliedCount = appliedCount + 1
                            }
                            如果 (appliedCount == 0)
                            {
                                返回 (MCP_响应构建.命令失败 (命令ID, "config未包含任何可识别的指纹字段 | 支持: user_agent/vendor/product/languages/webgl_vendor/webgl_renderer/hardware_concurrency/device_memory/webdriver/width/height/avail_width/avail_height"))
                            }
                            返回 (MCP_响应构建.响应_需要刷新 (命令ID, "指纹批量设置完成(" + 到文本 (appliedCount) + "项)"))
                        }
                        返回 (MCP_响应构建.命令失败 (命令ID, "config JSON无效"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + action + " | 支持: clear/count/clear_count/canvas_random/webgl_random/audio_random/audio_param/webrtc/geolocation/timezone/ssl/set_batch"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 拦截 (双通道: VIP API + 事件Hook toggle) ===
        否则 (方法名 == "browser_intercept")
        {
            变量 action <类型 = 文本型>
            action = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (MCP命令服务器.参数键存在 (参数JSON, "action") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 不能省略 | 请显式指定操作, 例如 clear / block / modify / replace_data / replace_file / line_replace / navigate_block / navigate_redirect | 注: 省略会落到规则分支并报出与真实原因无关的『参数 url 不能为空』"))
            }
            如果 (action == "clear")
            {
                // 清除所有事件Hook规则和开关 (手写过滤器通道无需逐浏览器清理)
                MCP命令服务器.是否缓存响应 = 假
                MCP命令服务器.是否Hook资源 = 假
                MCP命令服务器.是否Hook导航 = 假
                MCP命令服务器.是否Hook音频 = 假
                MCP命令服务器.是否Hook弹窗 = 假
                // 规则清空与UI线程的规则匹配并发: 加规则锁防撕裂读写
                MCP命令服务器.规则锁.加锁 ()
                MCP命令服务器.资源替换规则 = ""
                MCP命令服务器.导航拦截规则 = ""
                MCP命令服务器.规则锁.解锁 ()
                MCP命令服务器.音频指纹配置 = ""
                MCP命令服务器.弹窗配置 = ""
                返回 (MCP_响应构建.命令成功 (命令ID, "所有拦截规则已清除(手写过滤器通道)"))
            }
            否则 (action == "ws_hook")
            {
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                    vip_ctrl = browser.取VIP控制器 ()
                    如果 (vip_ctrl.是否为空 () == 假)
                    {
                        vip_ctrl.WebSocket_启用拦截 ()
                        返回 (MCP_响应构建.命令成功 (命令ID, "WebSocket拦截已启用"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            否则 (action == "cache")
            {
                MCP命令服务器.是否缓存响应 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "响应缓存已启用 (SQLite → response_cache表)"))
            }
            否则 (action == "uncache")
            {
                MCP命令服务器.是否缓存响应 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "响应缓存已禁用"))
            }
            否则 (action == "popup_config")
            {
                // 事件Hook通道: 自定义弹窗属性 (无需VIP, 无需浏览器实例)
                变量 弹窗宽度 <类型 = 整数>
                弹窗宽度 = MCP命令服务器.yyjson取整数 (参数JSON, "width")
                变量 弹窗高度 <类型 = 整数>
                弹窗高度 = MCP命令服务器.yyjson取整数 (参数JSON, "height")
                变量 弹窗X <类型 = 整数>
                弹窗X = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                变量 弹窗Y <类型 = 整数>
                弹窗Y = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                如果 (弹窗宽度 <= 0 || 弹窗高度 <= 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "popup_config 需要 width/height > 0"))
                }
                MCP命令服务器.是否Hook弹窗 = 真
                MCP命令服务器.弹窗配置 = "{\"width\":" + 到文本 (弹窗宽度) + ",\"height\":" + 到文本 (弹窗高度) + ",\"x\":" + 到文本 (弹窗X) + ",\"y\":" + 到文本 (弹窗Y) + "}"
                返回 (MCP_响应构建.命令成功 (命令ID, "弹窗配置已设置: " + 到文本 (弹窗宽度) + "x" + 到文本 (弹窗高度)))
            }
            否则 (action == "popup_disable")
            {
                MCP命令服务器.是否Hook弹窗 = 假
                MCP命令服务器.弹窗配置 = ""
                返回 (MCP_响应构建.命令成功 (命令ID, "弹窗配置已禁用"))
            }
            // -- 规则类操作 (全局规则存储, 无需浏览器实例; 浏览器未创建时也可预置规则) --
            变量 url <类型 = 文本型>
            url = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (url == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 url 不能为空"))
            }
            // -- 导航拦截 (事件Hook通道) --
            如果 (action == "navigate_block" || action == "navigate_redirect")
            {
                变量 原始action <类型 = 文本型>
                原始action = action  // 保存原始值, 子文本替换会原地修改action
                变量 规则动作 <类型 = 文本型>
                规则动作 = action
                子文本替换 (规则动作, "navigate_", "", , , 假)
                变量 新行 <类型 = 文本型>
                新行 = 规则动作 + "|" + url
                如果 (原始action == "navigate_redirect")
                {
                    变量 重定向目标 <类型 = 文本型>
                    重定向目标 = MCP命令服务器.yyjson取文本 (参数JSON, "target")
                    如果 (重定向目标 == "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "navigate_redirect 需要 target 参数指定重定向目标URL"))
                    }
                    // 重定向目标将被实际导航, 必须通过URL安全校验 (与 navigate 同级别防护)
                    如果 (MCP命令服务器.验证URL安全 (重定向目标) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_不支持的URL协议 + " | target: " + 重定向目标))
                    }
                    新行 = 新行 + "|" + 重定向目标
                }
                MCP命令服务器.追加导航拦截规则 (新行)
                MCP命令服务器.是否Hook导航 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "导航拦截规则已添加(VIP可选): " + url))
            }
            // -- 资源拦截 (手写过滤器通道, 不依赖VIP官方过滤器) --
            如果 (action == "modify")
            {
                变量 search_text <类型 = 文本型>
                search_text = MCP命令服务器.yyjson取文本 (参数JSON, "search_text")
                变量 replace_text <类型 = 文本型>
                replace_text = MCP命令服务器.yyjson取文本 (参数JSON, "replace_text")
                // 替换文本允许为空(删除匹配内容); 搜索文本必填
                如果 (search_text != "")
                {
                    MCP命令服务器.是否Hook资源 = 真
                    MCP命令服务器.添加资源替换规则 (action, url, search_text, replace_text, "", "")
                    返回 (MCP_响应构建.命令成功 (命令ID, "内容修改已设置(手写过滤器): " + url + " | 文本类资源加载时流式搜索替换, 刷新页面后生效"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "modify需要search_text"))
            }
            否则 (action == "replace_data")
            {
                变量 replace_data_text <类型 = 文本型>
                replace_data_text = MCP命令服务器.yyjson取文本 (参数JSON, "replace_text")
                // 数据允许为空(置空响应体)
                MCP命令服务器.是否Hook资源 = 真
                MCP命令服务器.添加资源替换规则 (action, url, "", replace_data_text, "", "")
                返回 (MCP_响应构建.命令成功 (命令ID, "资源替换已设置(手写过滤器): " + url + " | 命中请求将整体替换为指定数据, 刷新页面后生效"))
            }
            否则 (action == "replace_file")
            {
                变量 file_path <类型 = 文本型>
                file_path = MCP命令服务器.yyjson取文本 (参数JSON, "file_path")
                如果 (file_path != "")
                {
                    如果 (MCP命令服务器.验证安全路径 (file_path, 假) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "file_path 不合法 | 路径遍历或非法字符: " + file_path + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))
                    }
                    // 防御性检查: 拒绝不存在的文件
                    如果 (文件是否存在 (file_path) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "替换文件不存在: " + file_path))
                    }
                    // MCP线程预读文件内容入缓存: 挂载时UI线程免磁盘IO
                    MCP命令服务器.缓存篡改文件内容 (file_path, UTF8到文本 (读入文件 (file_path)))
                    MCP命令服务器.是否Hook资源 = 真
                    MCP命令服务器.添加资源替换规则 (action, url, "", "", file_path, "")
                    返回 (MCP_响应构建.命令成功 (命令ID, "本地文件替换已设置(手写过滤器): " + file_path + " | 命中请求将整体替换为文件内容, 刷新页面后生效"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "replace_file需要file_path"))
            }
            否则 (action == "block")
            {
                MCP命令服务器.是否Hook资源 = 真
                MCP命令服务器.添加资源替换规则 (action, url, "", "", "", "")
                返回 (MCP_响应构建.命令成功 (命令ID, "资源已屏蔽(手写过滤器): " + url + " | 命中请求将返回屏蔽提示页, 刷新页面后生效"))
            }
            否则 (action == "line_replace")
            {
                变量 line_start <类型 = 整数>
                line_start = MCP命令服务器.yyjson取整数 (参数JSON, "line_start")
                变量 line_end <类型 = 整数>
                line_end = MCP命令服务器.yyjson取整数 (参数JSON, "line_end")
                变量 line_repl <类型 = 文本型>
                line_repl = MCP命令服务器.yyjson取文本 (参数JSON, "replace_text")
                如果 (line_start < 1 || line_end < line_start)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "line_replace 需要 line_start>=1 且 line_end>=line_start"))
                }
                MCP命令服务器.是否Hook资源 = 真
                // 搜索文本字段携带 "start:end" 行区间
                MCP命令服务器.添加资源替换规则 (action, url, 到文本 (line_start) + ":" + 到文本 (line_end), line_repl, "", "")
                返回 (MCP_响应构建.命令成功 (命令ID, "行号区间替换已设置(手写过滤器): 第" + 到文本 (line_start) + "-" + 到文本 (line_end) + "行 → " + url + " | 刷新页面后生效"))
            }
            否则 (action == "unmodify")
            {
                // 按 URL 撤销资源替换规则(与添加/命中同口径: 请求URL包含规则URL)
                变量 unmodify删数 <类型 = 整数>
                unmodify删数 = MCP命令服务器.删除资源替换规则 (url, "")
                返回 (MCP_响应构建.命令成功 (命令ID, "已按 URL 撤销资源替换规则 " + 到文本 (unmodify删数) + " 条 | 口径: 请求URL包含规则URL(与命中同口径) | url=" + url + " | 作用域: 手写过滤器通道(不含 VIP 过滤器) | 只影响后续请求, 刷新页面后生效"))
            }
            否则 (action == "unreplace")
            {
                // 与 unmodify 同构, 但只撤销文件替换(replace_file)类规则
                变量 unreplace删数 <类型 = 整数>
                unreplace删数 = MCP命令服务器.删除资源替换规则 (url, "replace_file")
                返回 (MCP_响应构建.命令成功 (命令ID, "已按 URL 撤销文件替换规则 " + 到文本 (unreplace删数) + " 条 | 口径: 请求URL包含规则URL | url=" + url + " | 作用域: 手写过滤器通道(不含 VIP 过滤器) | 只刷新影响后续请求"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + action + " | 支持: modify/replace_data/replace_file/block/line_replace/unmodify/unreplace/navigate_block/navigate_redirect/popup_config/popup_disable/cache/uncache/clear/ws_hook"))
        }
        // === 截图 ===
        否则 (方法名 == "browser_screenshot")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 fmt <类型 = 文本型>
                    fmt = MCP命令服务器.yyjson取文本 (参数JSON, "format")
                    如果 (fmt == "")
                    {
                        fmt = "png"
                    }
                    如果 (fmt != "png" && fmt != "jpeg" && fmt != "webp")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "不支持的截图格式: " + fmt + " | 仅支持 png/jpeg/webp"))
                    }
                    变量 截图大小 <类型 = FBrowser_截图边框数据>
                    截图大小.横坐标 = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                    截图大小.纵坐标 = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                    截图大小.宽度 = MCP命令服务器.yyjson取整数 (参数JSON, "width")
                    截图大小.高度 = MCP命令服务器.yyjson取整数 (参数JSON, "height")
                    如果 (截图大小.宽度 <= 0)
                    {
                        截图大小.宽度 = 1920
                    }
                    如果 (截图大小.高度 <= 0)
                    {
                        截图大小.高度 = 1080
                    }
                    // 尺寸上限钳制, 防超大分辨率截图内存分配风险
                    如果 (截图大小.宽度 > 7680)
                    {
                        截图大小.宽度 = 7680
                    }
                    如果 (截图大小.高度 > 7680)
                    {
                        截图大小.高度 = 7680
                    }
                    截图大小.缩放 = MCP命令服务器.yyjson取整数 (参数JSON, "scale")
                    如果 (截图大小.缩放 <= 0)
                    {
                        截图大小.缩放 = 1
                    }
                    如果 (截图大小.缩放 > 4)
                    {
                        截图大小.缩放 = 4
                    }
                    // 类库第 2/4/5 参此前被写死成 80/假/假 ⇒ **整页截图做不到**、jpeg 质量不可调。现全部开放:
                    变量 截图质量 <类型 = 整数>
                    截图质量 = MCP命令服务器.yyjson取整数 (参数JSON, "quality")
                    如果 (截图质量 <= 0)
                    {
                        截图质量 = 80
                    }
                    如果 (截图质量 > 100)
                    {
                        截图质量 = 100
                    }
                    // ★ 默认**必须为真**(实测三臂): 第4参(fromSurface)为假时, 类库截的是 **view(窗口可见区)**,
                    //   传入的 width/height/x/y/scale **全部被忽略** —— 实测 800x600 请求拿到的是 984x705(窗口客户区)。
                    //   置真后: ①rect 生效(800x600 → 800x600) ②captureBeyondViewport 生效(整页 → 高度=scrollHeight=5350)。
                    //   想回到旧的"只截窗口可见区"行为请显式传 from_surface:false。
                    变量 从表面截图 <类型 = 逻辑型>
                    从表面截图 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "from_surface", 真)
                    变量 视窗之外 <类型 = 逻辑型>
                    视窗之外 = MCP命令服务器.yyjson取逻辑 (参数JSON, "capture_beyond_viewport")
                    变量 整页截图 <类型 = 逻辑型>
                    整页截图 = MCP命令服务器.yyjson取逻辑 (参数JSON, "full_page")
                    变量 整页测量说明 <类型 = 文本型>
                    整页测量说明 = ""
                    如果 (整页截图)
                    {
                        // 整页必须先**量出文档真实尺寸**再按它裁剪: 类库的 rect 宽高不能为 0,
                        // 只把 captureBeyondViewport 置真而高度仍传视口大小, 拿到的还是视口那一屏。
                        变量 页高文本 <类型 = 文本型>
                        页高文本 = MCP命令服务器.CDP执行JS并等待 ("(function(){var d=document.documentElement,b=document.body;return Math.max(d?d.scrollHeight:0,b?b.scrollHeight:0,window.innerHeight||0)})()", 8000, 真)
                        变量 页宽文本 <类型 = 文本型>
                        页宽文本 = MCP命令服务器.CDP执行JS并等待 ("(function(){var d=document.documentElement,b=document.body;return Math.max(d?d.scrollWidth:0,b?b.scrollWidth:0,window.innerWidth||0)})()", 8000, 真)
                        变量 页高 <类型 = 整数>
                        页高 = 文本到整数 (页高文本)
                        变量 页宽 <类型 = 整数>
                        页宽 = 文本到整数 (页宽文本)
                        如果 (页高 > 0)
                        {
                            截图大小.高度 = 页高
                            整页测量说明 = "按文档实际尺寸裁剪 height=" + 到文本 (页高)
                        }
                        如果 (页宽 > 0)
                        {
                            截图大小.宽度 = 页宽
                            如果 (整页测量说明 != "")
                            {
                                整页测量说明 = 整页测量说明 + ", "
                            }
                            整页测量说明 = 整页测量说明 + "width=" + 到文本 (页宽)
                        }
                        截图大小.横坐标 = 0
                        截图大小.纵坐标 = 0
                        视窗之外 = 真
                        // 整页高度另有天花板: 通用 7680 钳制是为"超大分辨率内存风险"设的, 整页需要更高上限
                        如果 (截图大小.高度 > 20000)
                        {
                            截图大小.高度 = 20000
                            整页测量说明 = 整页测量说明 + " (高度已按 20000 上限钳制)"
                        }
                        如果 (截图大小.宽度 > 7680)
                        {
                            截图大小.宽度 = 7680
                            整页测量说明 = 整页测量说明 + " (宽度已按 7680 上限钳制)"
                        }
                        如果 (整页测量说明 == "")
                        {
                            整页测量说明 = "未能量出文档尺寸(页面可能未就绪), 已按传入的 width/height 裁剪 + captureBeyondViewport"
                        }
                    }
                    // ── 默认走 CDP(Page.captureScreenshot): 实测它**不破坏** CDP 命令通道 ──
                    变量 截图路线 <类型 = 文本型>
                    截图路线 = MCP命令服务器.yyjson取文本 (参数JSON, "via")
                    如果 (截图路线 == "")
                    {
                        截图路线 = "cdp"
                    }
                    如果 (截图路线 != "cdp" && 截图路线 != "library")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "via 只接受 cdp(默认)/library | library = 类库内核路线, **实测会让本会话 CDP 命令通道失效**, 仅在你确知后果时显式选用"))
                    }
                    如果 (截图路线 == "cdp")
                    {
                        变量 cdpClip <类型 = YYJSON对象类>
                        cdpClip.创建自文本 ("{}")
                        cdpClip.加入整数成员 ("x", 截图大小.横坐标)
                        cdpClip.加入整数成员 ("y", 截图大小.纵坐标)
                        cdpClip.加入整数成员 ("width", 截图大小.宽度)
                        cdpClip.加入整数成员 ("height", 截图大小.高度)
                        cdpClip.加入整数成员 ("scale", 截图大小.缩放)
                        // ⚠ 参数必须**整段拼接**: 本项目的 YYJSON 对象不支持嵌套对象成员 ——
                        //   用 加入文本成员("clip", "{...}") 会把它变成**字符串**, CDP 直接回 Invalid parameters
                        //   (既有做法也都是字符串拼接, 见 汇总JSON 等)。
                        变量 cdp截图参数文本 <类型 = 文本型>
                        cdp截图参数文本 = "{\"format\":\"" + fmt + "\""
                        如果 (fmt != "png")
                        {
                            cdp截图参数文本 = cdp截图参数文本 + ",\"quality\":" + 到文本 (截图质量)
                        }
                        cdp截图参数文本 = cdp截图参数文本 + ",\"fromSurface\":" + 选择 (从表面截图, "true", "false")
                        如果 (视窗之外)
                        {
                            cdp截图参数文本 = cdp截图参数文本 + ",\"captureBeyondViewport\":true"
                        }
                        cdp截图参数文本 = cdp截图参数文本 + ",\"clip\":" + cdpClip.到可读文本 (YYJSON格式化选项.压缩) + "}"
                        变量 cdp截图结果 <类型 = 文本型>
                        cdp截图结果 = MCP命令服务器.执行CDP并同步等待 (命令ID + "_shot", "Page.captureScreenshot", cdp截图参数文本, 20000)
                        如果 (MCP命令服务器.CDP同步结果是否成功 (cdp截图结果))
                        {
                            // 载荷提取容错: 同步结果里 CDP 的原始载荷可能在 `result`(包装过的工具)或
                            // `message`(裸 CDP 通道实测形态: {"success":true,"message":"{\"data\":\"<base64>\"}"}),
                            // 故两个键都试; 载荷本身可能是 JSON 对象(取 data)也可能就是 base64(直接用)。
                            // 注: 本项目读取器 `yyjson取文本` 的**第一参必须是 YYJSON 对象**, 故这里先建对象再取值。
                            变量 cdp载荷文本 <类型 = 文本型>
                            cdp载荷文本 = MCP命令服务器.yyjson取文本 (MCP命令服务器.取CDP结果对象 (cdp截图结果), "data")
                            如果 (cdp载荷文本 == "")
                            {
                                变量 cdp同步对象 <类型 = YYJSON只读对象类>
                                如果 (cdp同步对象.创建自文本 (cdp截图结果))
                                {
                                    变量 cdp消息文本 <类型 = 文本型>
                                    cdp消息文本 = MCP命令服务器.yyjson取文本 (cdp同步对象, "message")
                                    如果 (cdp消息文本 != "")
                                    {
                                        变量 cdp消息对象 <类型 = YYJSON只读对象类>
                                        如果 (cdp消息对象.创建自文本 (cdp消息文本))
                                        {
                                            cdp载荷文本 = MCP命令服务器.yyjson取文本 (cdp消息对象, "data")
                                        }
                                        如果 (cdp载荷文本 == "")
                                        {
                                            cdp载荷文本 = cdp消息文本
                                        }
                                    }
                                }
                            }
                            变量 cdp结果文本 <类型 = 文本型>
                            cdp结果文本 = ""
                            如果 (cdp载荷文本 != "")
                            {
                                // 只接受"看起来像 base64"的载荷: 够长且不含 '{'(否则会把一段 JSON 文本当图片塞回去 = 假成功)
                                如果 (取文本长度 (cdp载荷文本) > 200 && 寻找文本 (取文本左边 (cdp载荷文本, 20), "{", 0, 假) == -1)
                                {
                                    cdp结果文本 = cdp载荷文本
                                }
                            }
                            如果 (cdp结果文本 != "")
                            {
                                变量 cdp截图回包 <类型 = YYJSON对象类>
                                cdp截图回包.创建自文本 ("{}")
                                cdp截图回包.加入逻辑值成员 ("success", 真)
                                cdp截图回包.加入文本成员 ("via", "cdp:Page.captureScreenshot")
                                cdp截图回包.加入文本成员 ("format", fmt)
                                cdp截图回包.加入整数成员 ("width", 截图大小.宽度)
                                cdp截图回包.加入整数成员 ("height", 截图大小.高度)
                                cdp截图回包.加入整数成员 ("image_base64_length", 取文本长度 (cdp结果文本))
                                cdp截图回包.加入文本成员 ("image", "data:image/" + fmt + ";base64," + cdp结果文本)
                                如果 (整页测量说明 != "")
                                {
                                    cdp截图回包.加入文本成员 ("full_page_note", 整页测量说明)
                                }
                                如果 (取文本长度 (cdp结果文本) > 700000)
                                {
                                    // 与项目既有实测一致: MCP 的 HTTP 通道在参数/回包约 1MB 处会被断连且无错误码
                                    cdp截图回包.加入文本成员 ("warning", "图片 base64 约 " + 到文本 (取文本长度 (cdp结果文本) / 1024) + "KB, 接近 MCP HTTP 通道约 1MB 的断连阈值; 建议 format=jpeg + quality 降一档, 或缩小 width/height/scale")
                                }
                                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, cdp截图回包.到可读文本 (YYJSON格式化选项.压缩)))
                            }
                            返回 (MCP_响应构建.命令失败 (命令ID, "CDP Page.captureScreenshot 返回成功但没有 data 字段 | 可显式改用 via:library(类库内核路线, **实测会让本会话 CDP 命令通道失效**)"))
                        }
                        返回 (MCP_响应构建.命令失败 (命令ID, "CDP 截图失败: " + MCP命令服务器.取CDP同步结果错误 (cdp截图结果) + " | 常见原因: CDP 通道不可用(可用 browser_cdp_status 看) | 替代: via:library 走类库内核路线(**实测会让本会话 CDP 命令通道失效**, 仅在确知后果时使用)"))
                    }
                    // via=library: 类库内核路线(功能等价但会打死 CDP 通道, 故只在显式选用时使用)
                    // 全部异步: 生成task_id, 回调触发时存储结果
                    变量 异步截图ID <类型 = 文本型>
                    异步截图ID = MCP命令服务器.生成异步任务ID ()
                    变量 截图回调 <类型 = 类_FBrowser_事件智能指针>
                    截图回调.创建 (类_MCP_截图异步回调)
                    截图回调.取执行类 (类_MCP_截图异步回调).任务ID = 异步截图ID
                    截图回调.取执行类 (类_MCP_截图异步回调).图片格式 = fmt
                    vip_ctrl.高级_网页截图 (fmt, 截图质量, 截图大小, 从表面截图, 视窗之外, 截图回调)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步截图ID, "截图已提交(经类库内核路线; 质量=" + 到文本 (截图质量) + ", 表面=" + 选择 (从表面截图, "真", "假") + ", 视窗之外=" + 选择 (视窗之外, "真", "假") + 选择 (整页测量说明 == "", "", " | 整页: " + 整页测量说明) + "), 通过mcp_result查询 | ⚠ 实测: 该路线会让本会话的 CDP 命令通道失效(之后 CDP 类工具会退化为原生回退, 每次 10~35 秒且可能超时), 需重启进程恢复; 下次请用默认的 via:cdp)", 800))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 等待(AI自动化) ===
        否则 (方法名 == "browser_wait")
        {
            变量 what <类型 = 文本型>
            what = MCP命令服务器.yyjson取文本 (参数JSON, "what")
            变量 value <类型 = 文本型>
            value = MCP命令服务器.yyjson取文本 (参数JSON, "value")
            变量 maxMs <类型 = 整数>
            maxMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_ms")
            如果 (maxMs <= 0)
            {
                maxMs = 15000  // 与同步等待默认一致, 慢页面等待更充分 (负数钳制防立即超时)
            }
            如果 (maxMs > 300000)
            {
                maxMs = 300000  // 最多等5分钟, 防永久阻塞(本地桌面放宽)
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                如果 (what == "timeout")
                {
                    变量 异步超时ID <类型 = 文本型>
                    异步超时ID = MCP命令服务器.生成异步任务ID ()
                    // 将等待规格存储为异步任务, 客户端通过mcp_result轮询
                    变量 超时存储 <类型 = YYJSON对象类>
                    超时存储.创建自文本 ("{}")
                    超时存储.加入逻辑值成员 ("_waiting", 真)
                    超时存储.加入文本成员 ("what", "timeout")
                    超时存储.加入整数成员 ("max_ms", maxMs)
                    超时存储.加入长整数成员 ("start_time", 取启动时间 ())
                    超时存储.加入整数成员 ("_poll_count", 0)
                    MCP命令服务器.存储异步结果 (异步超时ID, 超时存储.到可读文本 (YYJSON格式化选项.压缩))
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步超时ID, "等待已提交, 通过mcp_result轮询结果"))
                }
                如果 (what != "selector" && what != "text" && what != "load_end" && what != "load_start" && what != "navigate" && what != "network_idle" && what != "url_contains")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知what: " + what + " | 支持: selector/text/timeout/load_end/load_start/navigate/network_idle/url_contains"))
                }
                // load_end/load_start/network_idle 不需要 value; navigate 无 value 时等同 load_end
                如果 (what != "load_end" && what != "load_start" && what != "navigate" && what != "network_idle" && value == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "value 不能为空: what=" + what + " 需要指定等待目标值"))
                }
                如果 (what == "navigate" && value == "")
                {
                    what = "load_end"
                }
                // === 异步轮询模式: 生成task_id, 每次mcp_result做一次检查, 避免阻塞MCP线程 ===
                变量 异步等待ID <类型 = 文本型>
                异步等待ID = MCP命令服务器.生成异步任务ID ()
                变量 checkCode <类型 = 文本型>
                如果 (what == "selector")
                {
                    checkCode = "(function(){var el=document.querySelector('" + MCP命令服务器.简单转义JS (value) + "');return JSON.stringify({found:!!el,text:el?el.innerText.substring(0,500):null,tag:el?el.tagName:null})})()"
                }
                否则 (what == "text")
                {
                    checkCode = "(function(){if(!document.body)return JSON.stringify({found:false,error:'document.body not ready'});var idx=document.body.innerText.indexOf('" + MCP命令服务器.简单转义JS (value) + "');return JSON.stringify({found:idx>=0,position:idx})})()"
                }
                否则 (what == "load_end")
                {
                    // 原生: CEF OnLoadEnd 事件缓存, 非JS document.readyState
                    checkCode = ""
                }
                否则 (what == "load_start")
                {
                    // 原生: CEF OnLoadStart 事件缓存, 非JS document.readyState
                    checkCode = ""
                }
                否则 (what == "navigate")
                {
                    checkCode = "(function(){var t='" + MCP命令服务器.简单转义JS (value) + "';var h=window.location.href;var f=(h===t||(t.length>0&&h.indexOf(t)===0));return JSON.stringify({found:f,url:h,target:t})})()"
                }
                否则 (what == "url_contains")
                {
                    checkCode = "(function(){var t='" + MCP命令服务器.简单转义JS (value) + "';return JSON.stringify({found:window.location.href.indexOf(t)!==-1,url:window.location.href})})()"
                }
                否则 (what == "network_idle")
                {
                    // 服务端检查: 活动URL请求数是否为0 + 最后释放时间
                    // check_code 留空, 由 mcp_result 轮询时做服务端判断
                    checkCode = ""
                }
                // 存储等待上下文, 客户端通过mcp_result轮询 — 每次轮询触发一次JS条件检查
                变量 等待存储 <类型 = YYJSON对象类>
                等待存储.创建自文本 ("{}")
                等待存储.加入逻辑值成员 ("_waiting", 真)
                等待存储.加入文本成员 ("what", what)
                等待存储.加入文本成员 ("value", value)
                等待存储.加入文本成员 ("check_code", checkCode)
                等待存储.加入整数成员 ("max_ms", maxMs)
                等待存储.加入长整数成员 ("start_time", 取启动时间 ())
                等待存储.加入整数成员 ("_poll_count", 0)
                等待存储.加入整数成员 ("_browser_id", browser.取ID ())
                MCP命令服务器.存储异步结果 (异步等待ID, 等待存储.到可读文本 (YYJSON格式化选项.压缩))
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步等待ID, "等待已提交(what=" + what + " value=" + value + "), 请用mcp_result轮询, 每次轮询做一次条件检查"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 一站式爬虫: navigate→wait→extract (异步状态机) ===
        否则 (方法名 == "browser_scrape")
        {
            变量 sUrl <类型 = 文本型>
            sUrl = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (sUrl == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "url " + MCP_常量.错误_缺少参数))
            }
            如果 (MCP命令服务器.验证URL安全 (sUrl) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_不支持的URL协议))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            变量 sFrame <类型 = 类_FBrowser_框架>
            sFrame = MCP命令服务器.取安全主框架 (browser)
            // 声明在外层: 该值后面(存储任务时)还要用, 块内声明会因作用域不可见而编译不过
            变量 sPrevUrl <类型 = 文本型>
            sPrevUrl = ""
            // 本次导航发起时刻: 与 browser_navigate 同款判据(载入结束时刻 >= 本时刻 才算"本次导航已完成")
            变量 sNavStart <类型 = 长整数>
            sNavStart = 0
            如果 (sFrame.是否为空 () == 假 && sFrame.是否有效 ())
            {
                // 记录提交前的页面地址: Phase 0 用它判断"页面是否真的换了"(见下方爬虫状态机)
                sPrevUrl = sFrame.取地址 ()
                sNavStart = 取启动时间 ()
                sFrame.载入地址 (sUrl)
            }
            否则
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            变量 sTaskID <类型 = 文本型>
            sTaskID = MCP命令服务器.生成异步任务ID ()
            变量 sMaxMs <类型 = 整数>
            sMaxMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_ms")
            如果 (sMaxMs <= 0)
            {
                sMaxMs = 30000
            }
            如果 (sMaxMs > 300000)
            {
                sMaxMs = 300000  // 上限5分钟, 防极大max_ms使任务永不超时长期占用_waiting
            }
            变量 sStore <类型 = YYJSON对象类>
            sStore.创建自文本 ("{}")
            sStore.加入逻辑值成员 ("_waiting", 真)
            sStore.加入文本成员 ("what", "scrape")
            sStore.加入整数成员 ("max_ms", sMaxMs)
            sStore.加入长整数成员 ("start_time", 取启动时间 ())
            sStore.加入整数成员 ("_phase", 0)
            sStore.加入整数成员 ("_browser_id", browser.取ID ())
            变量 sWait <类型 = 文本型>
            sWait = MCP命令服务器.yyjson取文本 (参数JSON, "wait_selector")
            变量 sExtract <类型 = 文本型>
            sExtract = MCP命令服务器.yyjson取文本 (参数JSON, "extract_selector")
            如果 (sWait != "")
            {
                sStore.加入文本成员 ("wait_selector", sWait)
            }
            如果 (sExtract != "")
            {
                sStore.加入文本成员 ("extract_selector", sExtract)
            }
            否则
            {
                sStore.加入文本成员 ("extract_selector", "")
            }
            // target_url/prev_url: 供爬虫状态机 Phase 0 判断"页面是否真的换了"。
            // 实测缺陷: 冷启动第一次 scrape 会在 0.03s 内返回**欢迎页**的 h1 —— 因为 载入地址
            // 刚调用时 容器.取加载状态() 仍是"未加载", Phase 0 立刻以为加载完成就去提取了当前页。
            sStore.加入文本成员 ("target_url", sUrl)
            sStore.加入文本成员 ("prev_url", sPrevUrl)
            sStore.加入长整数成员 ("nav_start_ms", sNavStart)
            MCP命令服务器.存储异步结果 (sTaskID, sStore.到可读文本 (YYJSON格式化选项.压缩))
            返回 (MCP命令服务器.命令成功_异步 (命令ID, sTaskID, "爬虫任务已提交: " + sUrl + " | 通过mcp_result轮询"))
        }
        // === 右键菜单自定义(方案甲: 只暂存规格, 由 CEF 回调在模型有效期内施加) ===
        否则 (方法名 == "browser_menu_alias")
        {
            // 菜单 command_id ⇄ 别名: 把 context_menu_command 事件里的数字认成"用户点了什么"。
            // 纯计算、不碰浏览器 ⇒ 零风险且可完全回读验证(反向查表由既有正向链求值, 不新建第二份表)。
            变量 ma动作 <类型 = 文本型>
            ma动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            变量 ma别名 <类型 = 文本型>
            ma别名 = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            变量 ma命令ID <类型 = 整数>
            ma命令ID = MCP命令服务器.yyjson取整数 (参数JSON, "command_id")
            // 零前置: action 可省略 —— 按已给参数自动选(与 browser_reverse_runtime 等既有做法一致)
            如果 (ma动作 == "")
            {
                如果 (MCP命令服务器.参数键存在 (参数JSON, "command_id"))
                {
                    ma动作 = "to_name"
                }
                否则 (ma别名 != "")
                {
                    ma动作 = "to_id"
                }
                否则
                {
                    ma动作 = "list"
                }
            }
            变量 ma说明 <类型 = 文本型>
            ma说明 = "本表是 CEF 标准菜单项ID(取自本机 cef_types.h), 不是本应用菜单的真实内容; 实测修改类指向默认菜单项不会生效(见 browser_context_menu), 故只有标识/诊断价值"
            如果 (ma动作 == "list")
            {
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"list\",\"count\":" + 到文本 (MCP命令服务器.菜单别名候选.取成员数 ()) + ",\"aliases\":" + MCP命令服务器.取菜单别名清单JSON () + ",\"caveat\":\"" + MCP_响应构建.JSON转义文本 (ma说明) + "\"}"))
            }
            如果 (ma动作 == "to_name")
            {
                如果 (MCP命令服务器.参数键存在 (参数JSON, "command_id") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "action=to_name 需要 command_id | 例: command_id=113 反查得 copy | 也可 action=list 看全部"))
                }
                变量 ma命中别名 <类型 = 文本型>
                ma命中别名 = MCP命令服务器.菜单命令ID到别名 (ma命令ID)
                变量 ma区间 <类型 = 文本型>
                ma区间 = MCP命令服务器.菜单命令ID所属区间 (ma命令ID)
                变量 ma已识别文本 <类型 = 文本型>
                如果 (ma命中别名 != "")
                {
                    ma已识别文本 = "true"
                }
                否则
                {
                    ma已识别文本 = "false"
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"to_name\",\"command_id\":" + 到文本 (ma命令ID) + ",\"alias\":\"" + MCP_响应构建.JSON转义文本 (ma命中别名) + "\",\"recognized\":" + ma已识别文本 + ",\"id_range\":\"" + ma区间 + "\",\"caveat\":\"" + MCP_响应构建.JSON转义文本 (ma说明) + "\"}"))
            }
            如果 (ma动作 == "to_id")
            {
                如果 (ma别名 == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "action=to_id 需要 name(别名文本) | 例: name=copy | 也可 action=list 看全部"))
                }
                变量 ma解析ID <类型 = 整数>
                ma解析ID = MCP命令服务器.解析菜单命令ID (ma别名)
                如果 (ma解析ID <= 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知菜单命令别名: " + ma别名 + " | 已知别名见 action=list; 纯数字ID(如 113 或自建项 26501)可直接作为命令ID 使用"))
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"to_id\",\"name\":\"" + MCP_响应构建.JSON转义文本 (ma别名) + "\",\"command_id\":" + 到文本 (ma解析ID) + ",\"id_range\":\"" + MCP命令服务器.菜单命令ID所属区间 (ma解析ID) + "\",\"caveat\":\"" + MCP_响应构建.JSON转义文本 (ma说明) + "\"}"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + ma动作 + " | 支持 list/to_name/to_id; 省略 action 时按已给参数自动选"))
        }
        否则 (方法名 == "browser_context_menu")
        {
            变量 cmAction <类型 = 文本型>
            cmAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (cmAction == "")
            {
                // 默认 get(只读)而非 set: 空参调用应当**成功且给出状态**, 而不是报"缺少 items"
                cmAction = "get"
            }
            如果 (cmAction == "set")
            {
                变量 cmItems <类型 = 文本型>
                cmItems = MCP命令服务器.yyjson取文本 (参数JSON, "items")
                如果 (cmItems == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "set 需要 items(逐行菜单规格) | 格式: 类型|标签|命令ID|参数|父命令ID|快捷键; 类型=item/check/radio/sep/sub; 命令ID 须在 26500..28500(留0自动分配)"))
                }
                // 校验并自动分配命令ID(留 0 / 重复的按 26501 起顺序补齐), 越界或类型非法直接拒绝(不静默丢弃)
                变量 cm行数组 <类型 = 文本数组类>
                分割文本 (cmItems, "\n", cm行数组, 真, 假)
                变量 cm有效数 <类型 = 整数>
                cm有效数 = 0
                变量 cm自动ID <类型 = 整数>
                cm自动ID = 26501
                变量 cm新规格 <类型 = 文本型>
                cm新规格 = ""
                变量 cm已用ID <类型 = 整数>
                变量 cm警告 <类型 = 文本型>
                cm警告 = ""
                变量 cm含wipe <类型 = 逻辑型 值 = 假>
                计次循环 (cm行数组.取成员数 ())
                {
                    变量 cm行 <类型 = 文本型>
                    cm行 = cm行数组.取成员 (取循环索引 ())
                    如果 (cm行 == "")
                    {
                        到循环尾
                    }
                    变量 cm段 <类型 = 文本数组类>
                    分割文本 (cm行, "|", cm段, 假, 假)
                    如果 (cm段.取成员数 () < 3)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行字段不足(至少 类型|标签|命令ID): " + cm行))
                    }
                    // 合法规格最多 6 列(类型|标签|命令ID|参数|父命令ID|快捷键)。多于 6 列几乎总是**列位写错**
                    // (例如把"修改类的新标签"写到第4列, 于是 参数/父命令ID 整体错位, 施加时被当成子项跳过)。
                    变量 cm段数 <类型 = 整数>
                    cm段数 = cm段.取成员数 ()
                    如果 (cm段数 == 7 && cm段.取成员 (6) == "")
                    {
                        // 行尾多补一个 | 是常见写法, 按 6 列处理(不算错位)
                        cm段数 = 6
                    }
                    如果 (cm段数 > 6)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行字段过多(" + 到文本 (cm段.取成员数 ()) + " 段, 格式只有 6 列): " + cm行 + " | 列位固定为 类型|标签|命令ID|参数|父命令ID|快捷键 —— 修改类的**新标签写第2列**(如 relabel|新名字|26501|1|0|), 快捷键写第6列(如 accel||26501|1|0|70C|); 若某列留空就写成连续两个 |, 不要在该列填别的内容"))
                    }
                    变量 cm类型 <类型 = 文本型>
                    cm类型 = cm段.取成员 (0)
                    // 创建类: item/check/radio/sep/sub(新条目, 需自定义区间ID)
                    // 修改类: del/relabel/vis/dis/mark/accel/noaccel
                    // 实测结论: 修改类只对**本服务自建项**(26500..28500)有效; 浏览器默认菜单项(100..130)
                    // 上 relabel/vis/dis/del 一律返回假、加删快捷键也不生效 —— 施加失败会由 apply_failed 报出。
                    如果 (cm类型 != "item" && cm类型 != "check" && cm类型 != "radio" && cm类型 != "sep" && cm类型 != "sub" && cm类型 != "wipe" && MCP命令服务器.是菜单修改类 (cm类型) == 假 && MCP命令服务器.是菜单索引类 (cm类型) == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行类型非法: " + cm类型 + " | 创建类(按命令ID新建): item/check/radio/sep/sub | 修改类(按命令ID改已有项): del/relabel/vis/dis/mark/accel/noaccel/color | 索引类(按位置改, **唯一能作用于浏览器默认菜单项的通道**): accelat/noaccelat/colorat/checkat/fontat | 清空本次菜单: wipe(需 confirm_wipe:true 且必须唯一一行)"))
                    }
                    变量 cm是修改类 <类型 = 逻辑型>
                    cm是修改类 = MCP命令服务器.是菜单修改类 (cm类型)
                    变量 cm是索引类 <类型 = 逻辑型>
                    cm是索引类 = MCP命令服务器.是菜单索引类 (cm类型)
                    // 索引类: 第3列是**索引**(纯位置寻址) —— 浏览器默认菜单项的命令ID无法反查, 只有位置寻址能改到它们。
                    // 故这里既不要求ID存在, 也不做 26500..28500 区间校验; 但要挡住"把索引列填成命令ID"这种错位。
                    如果 (cm是索引类)
                    {
                        变量 cm索引 <类型 = 整数>
                        cm索引 = 文本到整数 (cm段.取成员 (2))
                        如果 (cm索引 >= 100 && cm索引 <= 28500)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行是索引类(" + cm类型 + ")但第3列填的像**命令ID**(" + 到文本 (cm索引) + ") | 索引类第3列是**索引**(从0开始的位置号; 用 browser_menu_probe 可读到实际条目数) | 想按命令ID改请用 accel/noaccel/del/relabel/vis/dis/mark"))
                        }
                        如果 (cm索引 < 0 || cm索引 > 500)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行索引越界: " + 到文本 (cm索引) + " | 索引从0开始, 上限500"))
                        }
                        变量 cm索引行 <类型 = 文本型>
                        cm索引行 = cm类型 + "|" + cm段.取成员 (1) + "|" + 到文本 (cm索引)
                        如果 (cm段.取成员数 () >= 4)
                        {
                            cm索引行 = cm索引行 + "|" + cm段.取成员 (3)
                        }
                        如果 (cm段.取成员数 () >= 5)
                        {
                            cm索引行 = cm索引行 + "|" + cm段.取成员 (4)
                        }
                        如果 (cm段.取成员数 () >= 6)
                        {
                            cm索引行 = cm索引行 + "|" + cm段.取成员 (5)
                        }
                        如果 (cm新规格 == "")
                        {
                            cm新规格 = cm索引行
                        }
                        否则
                        {
                            cm新规格 = cm新规格 + "\n" + cm索引行
                        }
                        cm有效数 = cm有效数 + 1
                        到循环尾
                    }
                    变量 cmID <类型 = 整数>
                    // 命令ID 列支持 CEF 标准菜单项别名(back/reload/copy/…)便于书写与识别;
                    // 但实测**默认菜单项改不动**, 别名在本应用里只有标识/诊断价值。
                    cmID = MCP命令服务器.解析菜单命令ID (cm段.取成员 (2))
                    如果 (cm是修改类)
                    {
                        // 实测: 指向浏览器默认菜单项(标准ID < 26500)的修改类不会生效, 提前如实告知
                        如果 (cmID > 0 && cmID < 26500)
                        {
                            cm警告 = cm警告 + "[修改类 " + cm类型 + " 指向默认项ID " + 到文本 (cmID) + ": 实测本应用不支持修改浏览器默认项, 右键后不会生效] "
                        }
                        // 修改类引用**已存在**的条目: 允许 CEF 标准区间(如浏览器默认菜单项), 但不允许 0
                        如果 (cmID < 1)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行是修改类(" + cm类型 + ")但命令ID无法识别: [" + cm段.取成员 (2) + "] | 修改类必须给出已存在的命令ID: 用你自建项的 26500..28500(别名 back/forward/reload/reload_nocache/stop/undo/redo/cut/copy/paste/delete/selectall/find/print/viewsource/nosuggestions/addtodict 与标准ID 如 back=100 也能解析, 但实测默认项改不动)"))
                        }
                    }
                    否则 (cm类型 != "sep")
                    {
                        如果 (cmID == 0 || cmID < 26500 || cmID > 28500)
                        {
                            // 留 0 = 让服务端分配; 越界则明确拒绝(CEF 自定义区间外的 ID 不会生效)
                            如果 (cmID == 0)
                            {
                                cmID = cm自动ID
                                cm自动ID = cm自动ID + 1
                            }
                            否则
                            {
                                返回 (MCP_响应构建.命令失败 (命令ID, "规格第 " + 到文本 (取循环索引 () + 1) + " 行命令ID越界: " + 到文本 (cmID) + " | 创建类新项的命令ID 必须在 26500..28500(留0自动分配) | 修改类(del/relabel/vis/dis/mark/accel/noaccel)只能作用于自建项: 实测浏览器默认菜单项(标准ID/别名)在本应用上改不动"))
                            }
                        }
                        cm已用ID = cm已用ID + 1
                    }
                    // 回写规范化后的行(标签保持原样, 由回调侧反转义)
                    变量 cm新行 <类型 = 文本型>
                    cm新行 = cm类型 + "|" + cm段.取成员 (1) + "|" + 到文本 (cmID)
                    如果 (cm段.取成员数 () >= 4)
                    {
                        cm新行 = cm新行 + "|" + cm段.取成员 (3)
                    }
                    如果 (cm段.取成员数 () >= 5)
                    {
                        cm新行 = cm新行 + "|" + cm段.取成员 (4)
                    }
                    如果 (cm段.取成员数 () >= 6)
                    {
                        cm新行 = cm新行 + "|" + cm段.取成员 (5)
                    }
                    如果 (cm新规格 == "")
                    {
                        cm新规格 = cm新行
                    }
                    否则
                    {
                        cm新规格 = cm新规格 + "\n" + cm新行
                    }
                    如果 (cm类型 == "wipe")
                    {
                        cm含wipe = 真
                    }
                    cm有效数 = cm有效数 + 1
                }
                // wipe 是**破坏性**动作: 必须唯一一行 + 显式确认。理由(项目既有禁令的延伸):
                // 规格为空时清空菜单会把 CEF 默认菜单整片抹掉 —— 用户会以为右键坏了; 且每次右键都是新模型,
                // 所以"清空"只影响本次。要的是"屏蔽右键"应当用 browser_kernel_menu action=disable。
                如果 (cm含wipe)
                {
                    如果 (cm有效数 > 1)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "wipe 必须是规格里**唯一**的一行(当前共 " + 到文本 (cm有效数) + " 行) | 清空与其它行混用语义不明"))
                    }
                    如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm_wipe") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "wipe 会清空**本次右键**的整个菜单: 右键后一个条目都没有(用户会以为右键坏了); 下一次右键会恢复默认菜单 | 想要的是屏蔽右键请用 browser_kernel_menu action=disable | 确认清空请显式传 confirm_wipe:true"))
                    }
                }
                如果 (cm有效数 == 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "规格里没有有效条目"))
                }
                MCP命令服务器.菜单规格文本 = cm新规格
                // 实验性动作(fontat)默认拒绝, 只在本行规格显式 experimental:true 时放行(单次生效, 下次 set 自动复位)
                MCP命令服务器.菜单允许实验字体 = MCP命令服务器.yyjson取逻辑 (参数JSON, "experimental")
                变量 cmEnable <类型 = 逻辑型>
                cmEnable = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "enable", 真)
                MCP命令服务器.菜单已启用 = cmEnable
                MCP命令服务器.菜单施加次数 = 0
                MCP命令服务器.菜单最近施加条数 = 0
                MCP命令服务器.菜单施加失败 = ""
                MCP命令服务器.菜单上次错误 = ""
                // 零前置: 菜单事件监控默认是关的, 这里自动打开(否则事件不记录、状态无从观察)
                MCP命令服务器.是否监控菜单事件 = 真
                变量 cm提示 <类型 = 文本型>
                cm提示 = "菜单规格已预置(启用=" + 选择 (cmEnable, "true", "false") + ", 条目=" + 到文本 (cm有效数) + ", 含命令ID条目=" + 到文本 (cm已用ID) + ") | 每次右键时由 CEF 回调施加, 本工具无法即时修改已打开的菜单 | 已自动开启菜单事件监控"
                如果 (cm含wipe)
                {
                    cm提示 = cm提示 + " | ⚠ 含 wipe: 右键后菜单会被清空(仅本次)"
                }
                如果 (cmEnable == 假)
                {
                    cm提示 = cm提示 + " | 注意: 规格已保存但当前处于**禁用**状态(enable=false), 右键不会施加"
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"applied\":false,\"warnings\":\"" + MCP_响应构建.JSON转义文本 (cm警告) + "\",\"spec_lines\":" + 到文本 (cm有效数) + ",\"enabled\":" + 选择 (cmEnable, "true", "false") + ",\"message\":\"" + MCP_响应构建.JSON转义文本 (cm提示) + "\",\"note\":\"规格已暂存: 右键一次后可用 action=get 查看施加次数与条数\"}"))
            }
            否则 (cmAction == "get")
            {
                变量 cm规格回显 <类型 = 文本型>
                cm规格回显 = MCP命令服务器.菜单规格文本
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"enabled\":" + 选择 (MCP命令服务器.菜单已启用, "true", "false") + ",\"apply_count\":" + 到文本 (MCP命令服务器.菜单施加次数) + ",\"last_applied_items\":" + 到文本 (MCP命令服务器.菜单最近施加条数) + ",\"menu_item_count\":" + 到文本 (MCP命令服务器.菜单最近项数) + ",\"verified_items\":" + 到文本 (MCP命令服务器.菜单回读确认条数) + ",\"verify_mismatch\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.菜单回读不一致) + "\",\"verify_unavailable\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.菜单未验证说明) + "\",\"apply_failed\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.菜单施加失败) + "\",\"last_apply_time\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.菜单上次施加时刻) + "\",\"last_error\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.菜单上次错误) + "\",\"spec\":\"" + MCP_响应构建.JSON转义文本 (cm规格回显) + "\",\"event_monitor\":" + 选择 (MCP命令服务器.是否监控菜单事件, "true", "false") + ",\"note\":\"apply_count=右键次数; last_applied_items=实际生效条数; apply_failed=逐条说明哪条没生效及原因(最常见是指向默认项ID, 实测默认项改不动); verify_mismatch=回读与期望不符\"}"))
            }
            否则 (cmAction == "clear")
            {
                MCP命令服务器.菜单规格文本 = ""
                MCP命令服务器.菜单已启用 = 假
                MCP命令服务器.菜单最近施加条数 = 0
                MCP命令服务器.菜单施加失败 = ""
                返回 (MCP_响应构建.命令成功 (命令ID, "右键菜单自定义已撤销(规格清空, 恢复浏览器默认菜单) | 幂等: 本就未设置时同样返回成功"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + cmAction + " | 支持: set/get/clear"))
        }
        // === 右键菜单**只读实况探针** ===
        // 为什么需要: 规格类工具只能"写", 而默认菜单项改不动 —— 代理看不见菜单里到底有什么, 只能靠猜。
        // 本工具在 CEF 回调内(模型有效期内)、**施加规格之前**读: 条目数 + 每项是否带快捷键提示。
        // 可读范围是类库能力边界(`是否可见/是否选中/取菜单类型` 只收命令ID, 对默认项读不到), 故不谎报更多。
        否则 (方法名 == "browser_menu_probe")
        {
            变量 mpAction <类型 = 文本型>
            mpAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (mpAction == "")
            {
                mpAction = "arm"
            }
            如果 (mpAction == "clear")
            {
                MCP命令服务器.菜单快照JSON = ""
                MCP命令服务器.菜单快照时刻 = ""
                MCP命令服务器.菜单快照已武装 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "菜单快照已清空(幂等)"))
            }
            如果 (mpAction == "get")
            {
                // wait_ms: 等一次**尚在途**的采集(菜单打开是异步的, 且原生菜单模态 ⇒ 采集可能晚到)
                变量 mp等待 <类型 = 整数>
                mp等待 = MCP命令服务器.yyjson取整数 (参数JSON, "wait_ms")
                如果 (mp等待 <= 0)
                {
                    mp等待 = 2000
                }
                如果 (mp等待 > 10000)
                {
                    mp等待 = 10000
                }
                变量 mp已等 <类型 = 整数 值 = 0>
                判断循环 (mp已等 * 50 < mp等待 && MCP命令服务器.菜单快照JSON == "")
                {
                    MCP命令服务器.MCP执行锁.解锁 ()
                    MCP命令服务器.MCP可中断延时 (50, 50, 假)
                    MCP命令服务器.MCP执行锁.加锁 ()
                    mp已等 = mp已等 + 1
                }
                如果 (MCP命令服务器.菜单快照JSON == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "还没有快照(已等 " + 到文本 (mp等待) + "ms) | 做法: ① action=arm 会自动右键一次 ② action=arm {trigger:false} 后你自己在页面右键 ③ 若上一个菜单还开着: 原生右键菜单是**模态**的, CDP 事件关不掉它, 请到浏览器窗口里点一下把它关掉再 arm | 注意: 每次『菜单被打开』最多只能采集一次"))
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.菜单快照JSON))
            }
            如果 (mpAction != "arm")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + mpAction + " | 支持: arm(默认)/get/clear"))
            }
            变量 mpBrowser <类型 = 类_FBrowser_浏览器>
            mpBrowser = MCP命令服务器.取主浏览器 ()
            如果 (mpBrowser.是否为空 () || mpBrowser.是否已关闭 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            MCP命令服务器.菜单快照JSON = ""
            MCP命令服务器.菜单快照时刻 = ""
            MCP命令服务器.菜单快照已武装 = 真
            // 武装有效期 30 秒: 一次 arm 只在该窗口内被"兑现", 避免很久以后一次无关右键把快照填进来让人误判
            MCP命令服务器.菜单快照武装截止 = 取启动时间 () + 30000
            变量 mpTrigger <类型 = 逻辑型>
            mpTrigger = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "trigger", 真)
            如果 (mpTrigger == 假)
            {
                返回 (MCP_响应构建.命令成功 (命令ID, "已武装: 请现在手动右键一次(或改用 trigger:true 自动右键), 然后 action=get 取快照"))
            }
            变量 mpX <类型 = 整数>
            mpX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
            如果 (mpX <= 0)
            {
                mpX = 300
            }
            变量 mpY <类型 = 整数>
            mpY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
            如果 (mpY <= 0)
            {
                mpY = 200
            }
            // ⚠ 实测约束(三次独立运行一致, 如实写进回包与描述):
            //   · 第 1 次 arm 必成功(0.06~0.36s 拿到 17 项快照);
            //   · 第 2/3 次必然等不到菜单回调 —— 原生右键菜单是**模态**的, 它开着时新的右键请求被吞掉,
            //     而 CDP 的 Esc 走渲染器, **关不掉**原生菜单(加了"清场 + 3 次尝试"仍然第 2 次必失败)。
            // 故这里只派发**一次** + 短等 1.5 秒; 抓不到就以"已武装"如实返回, 由调用方 get 继续等,
            // 或到窗口里点一下关掉旧菜单 —— 不假装自己能自动关菜单(那会让调用方白等 5.7 秒)。
            如果 (MCP命令服务器.CDP派发鼠标事件 ("mousePressed", mpX, mpY, "right") == 假 || MCP命令服务器.CDP派发鼠标事件 ("mouseReleased", mpX, mpY, "right") == 假)
            {
                MCP命令服务器.菜单快照已武装 = 假
                MCP命令服务器.菜单快照武装截止 = 0
                返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 右键派发") + " | 替代: 传 trigger:false 后手动右键, 再 action=get"))
            }
            变量 mp轮询 <类型 = 整数 值 = 0>
            判断循环 (mp轮询 < 30 && MCP命令服务器.菜单快照JSON == "")
            {
                MCP命令服务器.MCP执行锁.解锁 ()
                MCP命令服务器.MCP可中断延时 (50, 50, 假)
                MCP命令服务器.MCP执行锁.加锁 ()
                mp轮询 = mp轮询 + 1
            }
            如果 (MCP命令服务器.菜单快照JSON != "")
            {
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.菜单快照JSON))
            }
            返回 (MCP_响应构建.命令成功 (命令ID, "已武装(30 秒内有效)并在(" + 到文本 (mpX) + "," + 到文本 (mpY) + ")派发了一次右键, 但 1.5 秒内没等到菜单回调 | 实测原因: 原生右键菜单是**模态**的 —— 它开着时后续右键会被吞掉, 且 CDP 的 Esc(走渲染器)关不掉它 | 下一步: ① browser_menu_probe {action:\"get\", wait_ms:8000} 继续等(采集可能晚到) ② 或到浏览器窗口里点一下关掉已开着的菜单, 再 action=arm ③ 想在你自己的右键上采集: action=arm {trigger:false} 后手动右键, 再 get"))
        }
        // === 数据提取: 链接/图片/表格 结构化JSON ===
        否则 (方法名 == "browser_extract")
        {
            变量 extractBrowser <类型 = 类_FBrowser_浏览器>
            extractBrowser = MCP命令服务器.取主浏览器 ()
            如果 (extractBrowser.是否为空 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            变量 extractType <类型 = 文本型>
            extractType = MCP命令服务器.yyjson取文本 (参数JSON, "type")
            变量 extractLimit <类型 = 整数>
            extractLimit = MCP命令服务器.yyjson取整数 (参数JSON, "limit")
            如果 (extractLimit <= 0)
            {
                extractLimit = 100
            }
            如果 (extractLimit > 5000)
            {
                extractLimit = 5000  // 上限防超大limit令JS遍历海量DOM并返回巨型JSON
            }
            如果 (extractType == "links")
            {
                变量 linksJS <类型 = 文本型>
                linksJS = "(function(){var r=[];var as=document.querySelectorAll('a[href]');for(var i=0;i<Math.min(as.length," + 到文本 (extractLimit) + ");i++){var a=as[i];r.push({href:a.href,text:a.innerText.trim().substring(0,200)})}return JSON.stringify(r)})()"
                // CDP 优先(原生"带返回值JS"通道约 8% 丢回调→5s 超时, 2025-09-13 全量扫测实测)
                变量 linksCDP值 <类型 = 文本型>
                linksCDP值 = MCP命令服务器.CDP执行JS并等待 (linksJS, MCP_常量.同步等待_JS执行超时, 真)
                如果 (linksCDP值 != "" && linksCDP值 != "undefined" && 是否以 (linksCDP值, "{\"error\"") == 假)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, linksCDP值))
                }
                变量 linksResult <类型 = 文本型>
                linksResult = MCP命令服务器.提交异步JS任务 (extractBrowser, linksJS)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, linksResult, "links", "链接提取已提交"))
            }
            否则 (extractType == "images")
            {
                变量 imagesJS <类型 = 文本型>
                imagesJS = "(function(){var r=[];var imgs=document.querySelectorAll('img[src]');for(var i=0;i<Math.min(imgs.length," + 到文本 (extractLimit) + ");i++){var img=imgs[i];r.push({src:img.src,alt:img.alt||'',width:img.naturalWidth,height:img.naturalHeight})}return JSON.stringify(r)})()"
                // CDP 优先(同 links: 原生通道约 8% 丢回调→5s 超时)
                变量 imagesCDP值 <类型 = 文本型>
                imagesCDP值 = MCP命令服务器.CDP执行JS并等待 (imagesJS, MCP_常量.同步等待_JS执行超时, 真)
                如果 (imagesCDP值 != "" && imagesCDP值 != "undefined" && 是否以 (imagesCDP值, "{\"error\"") == 假)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, imagesCDP值))
                }
                变量 imagesResult <类型 = 文本型>
                imagesResult = MCP命令服务器.提交异步JS任务 (extractBrowser, imagesJS)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, imagesResult, "images", "图片提取已提交"))
            }
            否则 (extractType == "tables")
            {
                // 自动检测<thead>提取列名, 输出{headers:[],data:[[],...]} 结构化JSON
                变量 tablesJS <类型 = 文本型>
                tablesJS = "(function(){var r=[];var ts=document.querySelectorAll('table');for(var i=0;i<Math.min(ts.length," + 到文本 (extractLimit) + ");i++){var table=ts[i];var headers=[];var thead=table.querySelector('thead');if(thead){var ths=thead.querySelectorAll('th');for(var h=0;h<Math.min(ths.length,50);h++){headers.push(ths[h].innerText.trim().substring(0,200))}}if(headers.length===0){var firstRow=table.querySelector('tr');if(firstRow){var fcs=firstRow.querySelectorAll('th,td');for(var h=0;h<Math.min(fcs.length,50);h++){headers.push(fcs[h].innerText.trim().substring(0,200))}}}var rows=table.querySelectorAll('tr');var tdata=[];var startRow=headers.length>0?1:0;for(var j=startRow;j<Math.min(rows.length,200);j++){var cells=rows[j].querySelectorAll('td,th');var row=[];for(var k=0;k<Math.min(cells.length,50);k++){row.push(cells[k].innerText.trim().substring(0,500))}if(row.length>0)tdata.push(row)}r.push({table_index:i,headers:headers,columns:headers.length,rows:tdata.length,data:tdata})}return JSON.stringify(r)})()"
                // CDP 优先(同 links: 原生通道约 8% 丢回调→5s 超时)
                变量 tablesCDP值 <类型 = 文本型>
                tablesCDP值 = MCP命令服务器.CDP执行JS并等待 (tablesJS, MCP_常量.同步等待_JS执行超时, 真)
                如果 (tablesCDP值 != "" && tablesCDP值 != "undefined" && 是否以 (tablesCDP值, "{\"error\"") == 假)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, tablesCDP值))
                }
                变量 tablesResult <类型 = 文本型>
                tablesResult = MCP命令服务器.提交异步JS任务 (extractBrowser, tablesJS)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, tablesResult, "tables", "表格提取已提交"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + extractType + " | 支持: links/images/tables"))
        }
        // === 注入(AI自动化) ===
        否则 (方法名 == "browser_inject")
        {
            变量 injectType <类型 = 文本型>
            injectType = MCP命令服务器.yyjson取文本 (参数JSON, "type")
            变量 code <类型 = 文本型>
            code = MCP命令服务器.yyjson取文本 (参数JSON, "code")
            变量 persist <类型 = 逻辑型>
            persist = MCP命令服务器.yyjson取逻辑 (参数JSON, "persist")
            如果 (injectType != "" && code != "")
            {
                如果 (persist && injectType == "js")
                {
                    // 持久js模式: 存入持久V8扩展列表; 真正生效路径是 浏览器_载入开始 事件 → 应用持久V8到框架(框架)
                    //   → 框架.执行JS代码。实测有效: 设置后 reload 与 navigate 到新地址都能读到哨兵。
                    //   (旧注释写"由 渲染_即将创建V8环境 注入" —— 那是渲染进程事件, 在本项目不派发, 注释与实现不符, 已订正)
                    变量 注入标识 <类型 = 文本型>
                    注入标识 = MCP命令服务器.yyjson取文本 (参数JSON, "inject_id")
                    如果 (注入标识 == "")
                    {
                        注入标识 = "mcp_inject_js_" + 到文本 (取启动时间 ())
                    }
                    // 转义code中的|防止分隔符冲突, 解析侧(MCP_BrowserEvents)会反向还原
                    变量 安全code_js <类型 = 文本型>
                    安全code_js = code
                    子文本替换 (安全code_js, "{PIPE}", "{PIPE_ESC}", , , 假)
                    子文本替换 (安全code_js, "|", "{PIPE}", , , 假)
                    MCP命令服务器.加入持久V8扩展 (注入标识, 安全code_js, "js")
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "V8 JS持久注入已排队 | 将在新页面/新iframe加载时自动生效"))
                }
                如果 (persist && injectType == "handler")
                {
                    // ⚠ 诚实化: 该模式**做不到它承诺的事** —— 实测它的代码最终走 应用持久V8到框架 → 框架.执行JS代码,
                    //   即被当作**普通页面 JS** 执行(哨兵可读), 而不是"页面 JS 调原生、原生同步回值"的 handler 桥。
                    //   真实 handler 桥需要渲染进程内 FBrowser_V8_注册JS扩展(或 FBrowser_JS交互_注册), 而本项目的
                    //   渲染进程事件不派发到主进程, 后者也已被两轮实测判定不可用(_audit/remove_js_query_bridge.py)。
                    //   故这里**明确拒绝**并给出实测有效的替代, 而不是回一句"已排队"让人以为桥通了。
                    返回 (MCP_响应构建.命令失败 (命令ID, "type=handler 本机不支持: 它承诺的『页面 JS 调原生并同步回值』需要渲染进程内注册 JS 扩展(FBrowser_V8_注册JS扩展 / FBrowser_JS交互_注册), 而本项目渲染进程事件不派发到主进程、JS 交互桥也经实测不可用 | 实测现状: 传 handler 时你的代码会被当作**普通页面 JS** 执行(不是原生桥) | 替代: ①只想在页面里预置代码 → 用 type:js + persist:true(实测: 设置后导航/重载都生效) ②要在页面自身脚本**之前**注入 → browser_reverse_preload(已修: 会自动 Page.enable) ③只对当前页执行一次 → browser_execute_js"))
                }
                变量 browser <类型 = 类_FBrowser_浏览器>
                browser = MCP命令服务器.取主浏览器 ()
                如果 (browser.是否为空 () == 假)
                {
                    变量 injectFrame <类型 = 类_FBrowser_框架>
                    injectFrame = MCP命令服务器.取安全主框架 (browser)
                    如果 (injectFrame.是否为空 () == 假 && injectFrame.是否有效 ())
                    {
                        如果 (injectType == "js")
                        {
                            // 事件驱动: 使用 执行JS代码_带返回值 + 回调, 报告注入成功/失败
                            变量 注入JS_ID <类型 = 文本型>
                            注入JS_ID = MCP命令服务器.生成异步任务ID ()
                            变量 注入JS回调 <类型 = 类_FBrowser_事件智能指针>
                            注入JS回调.创建 (类_MCP_JS异步回调)
                            注入JS回调.取执行类 (类_MCP_JS异步回调).任务ID = 注入JS_ID
                            injectFrame.执行JS代码_带返回值 (code, "", 0, 注入JS回调)
                            返回 (MCP命令服务器.命令成功_异步 (命令ID, 注入JS_ID, "JS注入已提交, 通过mcp_result查询"))
                        }
                        否则 (injectType == "css")
                        {
                            // CSS无原生API, 需通过JS注入style标签 (事件驱动回调)
                            变量 cssCode <类型 = 文本型>
                            cssCode = "try{var s=document.createElement('style');s.textContent='" + MCP命令服务器.简单转义JS (code) + "';document.head.appendChild(s);'injected'}catch(e){'Error: '+e.message}"
                            变量 注入CSS_ID <类型 = 文本型>
                            注入CSS_ID = MCP命令服务器.生成异步任务ID ()
                            变量 注入CSS回调 <类型 = 类_FBrowser_事件智能指针>
                            注入CSS回调.创建 (类_MCP_JS异步回调)
                            注入CSS回调.取执行类 (类_MCP_JS异步回调).任务ID = 注入CSS_ID
                            injectFrame.执行JS代码_带返回值 (cssCode, "", 0, 注入CSS回调)
                            返回 (MCP命令服务器.命令成功_异步 (命令ID, 注入CSS_ID, "CSS注入已提交, 通过mcp_result查询"))
                        }
                        否则
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + injectType + ",支持: js/css"))
                        }
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "参数 type/code 不能为空"))
        }
        // === 网络日志 ===
        否则 (方法名 == "browser_network")
        {
            变量 action <类型 = 文本型>
            action = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (action == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 不能省略 | 可用: list(查询, 不改开关) / enable / detail_enable / disable / clear / get / network_get | 省略会隐式启用网络日志, 故拒绝"))
            }
            如果 (action == "body" || action == "network_body")
            {
                // 入口别名: 直接转交同一分派, 不在这里重写一份取响应体逻辑(不重复造轮子)
                返回 (分类分派_核心操作 (命令ID, "browser_network_body", 参数JSON))
            }
            如果 (action == "enable" || action == "network_enable")
            {
                MCP命令服务器.是否记录网络 = 真
                MCP命令服务器.是否详细记录网络 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "网络日志已启用(基础模式)"))
            }
            如果 (action == "detail_enable" || action == "network_detail_enable")
            {
                MCP命令服务器.是否记录网络 = 真
                MCP命令服务器.是否详细记录网络 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "网络日志已启用(详细模式)"))
            }
            如果 (action == "disable" || action == "network_disable")
            {
                MCP命令服务器.是否记录网络 = 假
                MCP命令服务器.是否详细记录网络 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "网络日志已禁用"))
            }
            如果 (action == "clear" || action == "network_clear")
            {
                MCP命令服务器.执行SQL ("DELETE FROM event_log WHERE log_type='network' OR log_type='network_detail'")
                返回 (MCP_响应构建.命令成功 (命令ID, "已清空"))
            }
            如果 (action == "list" || action == "get" || action == "network_get")
            {
                // 首次使用自动启用网络日志 (auto_enable:false 可跳过)
                如果 (MCP命令服务器.是否记录网络 == 假)
                {
                    变量 应自动启用 <类型 = 逻辑型 值 = 真>
                    如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "auto_enable") == 假 && MCP命令服务器.yyjson取文本 (参数JSON, "auto_enable") != "")
                    {
                        应自动启用 = 假
                    }
                    如果 (应自动启用)
                    {
                        MCP命令服务器.是否记录网络 = 真
                    }
                }
                变量 限制 <类型 = 整数>
                限制 = MCP命令服务器.yyjson取整数 (参数JSON, "limit")
                如果 (限制 <= 0)
                {
                    限制 = 500
                }
                如果 (限制 > 1000)
                {
                    限制 = 1000
                }
                变量 日志数组 <类型 = 文本型>
                日志数组 = MCP命令服务器.查询网络日志 (限制)
                变量 头对象 <类型 = YYJSON对象类>
                头对象.创建自文本 ("{}")
                头对象.加入逻辑值成员 ("network_enabled", MCP命令服务器.是否记录网络)
                头对象.加入逻辑值成员 ("network_detail", MCP命令服务器.是否详细记录网络)
                如果 (日志数组 == "[]" || 日志数组 == "")
                {
                    如果 (MCP命令服务器.是否记录网络 == 假)
                    {
                        头对象.加入文本成员 ("hint", "网络日志未启用; 请 action=enable 或 config enable_network_log=true, navigate 后再 list")
                    }
                    否则
                    {
                        头对象.加入文本成员 ("hint", "尚无记录; 仅记录 enable 之后的新请求, 磁盘缓存命中可能无 req/res")
                    }
                }
                变量 头JSON <类型 = 文本型>
                头JSON = 头对象.到可读文本 (YYJSON格式化选项.压缩)
                变量 内层JSON <类型 = 文本型>
                内层JSON = 取文本左边 (头JSON, 取文本长度 (头JSON) - 1) + ",\"network_logs\":" + 日志数组 + "}"
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 内层JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + action + " | 支持: list/get/enable/disable/clear/detail_enable (别名 network_*)"))
        }
        // === 自动化重试机制 ===
        否则 (方法名 == "browser_retry")
        {
            变量 retTool <类型 = 文本型>
            retTool = MCP命令服务器.yyjson取文本 (参数JSON, "tool")
            如果 (retTool == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "retry 需要 tool 参数: 要重试的MCP工具名"))
            }
            如果 (retTool == "browser_retry" || retTool == "browser.retry" || retTool == "retry")
            {
                // 自引用防护: 允许 retry 自身会指数级递归直至栈溢出
                返回 (MCP_响应构建.命令失败 (命令ID, "browser_retry 不支持重试自身"))
            }
            变量 retArgs <类型 = YYJSON只读对象类>
            retArgs = MCP命令服务器.yyjson取对象成员 (参数JSON, "args")
            如果 (retArgs.是否为空 ())
            {
                变量 空retArgs <类型 = YYJSON只读对象类>
                空retArgs.创建自文本 ("{}")
                retArgs = 空retArgs
            }
            变量 retMaxRetries <类型 = 整数>
            retMaxRetries = MCP命令服务器.yyjson取整数 (参数JSON, "max_retries")
            如果 (retMaxRetries <= 0 || retMaxRetries > 10)
            {
                retMaxRetries = 3
            }
            变量 retBackoffMs <类型 = 整数>
            retBackoffMs = MCP命令服务器.yyjson取整数 (参数JSON, "backoff_ms")
            如果 (retBackoffMs <= 0)
            {
                retBackoffMs = 1000
            }
            如果 (retBackoffMs > 30000)
            {
                retBackoffMs = 30000
            }
            变量 retMaxTotalMs <类型 = 整数>
            retMaxTotalMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_total_ms")
            如果 (retMaxTotalMs <= 0)
            {
                retMaxTotalMs = 60000
            }
            变量 retStartTime <类型 = 长整数>
            retStartTime = 取启动时间 ()
            变量 retSuccess <类型 = 逻辑型 值 = 假>
            变量 retFinalResult <类型 = 文本型>
            retFinalResult = ""
            变量 retAttempt <类型 = 整数 值 = 0>
            判断循环 (retAttempt < retMaxRetries && retSuccess == 假)
            {
                如果 (取启动时间 () - retStartTime > retMaxTotalMs)
                {
                    跳出循环
                }
                retAttempt = retAttempt + 1
                MCP命令服务器.MCP执行锁.解锁 ()
                retFinalResult = MCP命令服务器.执行浏览器命令 (命令ID + "_r" + 到文本 (retAttempt), retTool, retArgs)
                MCP命令服务器.MCP执行锁.加锁 ()
                变量 retParsed <类型 = YYJSON只读对象类>
                如果 (retParsed.创建自文本 (retFinalResult))
                {
                    如果 (retParsed.取逻辑值 ("success"))
                    {
                        retSuccess = 真
                        跳出循环
                    }
                }
                如果 (retAttempt < retMaxRetries && retSuccess == 假)
                {
                    变量 retDelay <类型 = 整数>
                    retDelay = retBackoffMs
                    如果 (retAttempt > 1)
                    {
                        retDelay = retBackoffMs * retAttempt  // 线性退避
                    }
                    如果 (retDelay > retMaxTotalMs - (整数)(取启动时间 () - retStartTime))
                    {
                        retDelay = retMaxTotalMs - (整数)(取启动时间 () - retStartTime)
                    }
                    如果 (retDelay > 0)
                    {
                        MCP命令服务器.MCP可中断延时 (retDelay)
                    }
                }
            }
            如果 (retSuccess)
            {
                返回 (retFinalResult)
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "重试" + 到文本 (retAttempt) + "次后仍失败 | tool=" + retTool + " | 最后错误已输出"))
        }
        // === Canvas指纹噪点注入 (反检测, JS实现, 不需VIP) ===
        否则 (方法名 == "browser_canvas_noise")
        {
            变量 cnAction <类型 = 文本型>
            cnAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (cnAction == "")
            {
                cnAction = "inject"
            }
            变量 cnBrowser <类型 = 类_FBrowser_浏览器>
            cnBrowser = MCP命令服务器.取主浏览器 ()
            如果 (cnBrowser.是否为空 () == 假 && cnBrowser.是否已关闭 () == 假)
            {
                变量 cnFrame <类型 = 类_FBrowser_框架>
                cnFrame = MCP命令服务器.取安全主框架 (cnBrowser)
                如果 (cnFrame.是否为空 () == 假 && cnFrame.是否有效 ())
                {
                    如果 (cnAction == "inject" || cnAction == "enable")
                    {
                        变量 cnNoiseLevel <类型 = 整数>
                        cnNoiseLevel = MCP命令服务器.yyjson取整数 (参数JSON, "level")
                        如果 (cnNoiseLevel <= 0 || cnNoiseLevel > 5)
                        {
                            cnNoiseLevel = 1
                        }
                        // JS层Canvas噪声注入: 修改toDataURL/toBlob/getImageData, 对每个像素添加±level的噪声
                        // 兼容所有Canvas2D指纹检测, 不依赖VIP内核API
                        变量 cnCode <类型 = 文本型>
                        cnCode = "(function(){var L=" + 到文本 (cnNoiseLevel) + ";"
                        cnCode = cnCode + "if(window.__MCP_CANVAS_NOISED__)return'Canvas noise already active(level='+window.__MCP_CANVAS_NOISE_LVL__+')';"
                        cnCode = cnCode + "var origToDataURL=HTMLCanvasElement.prototype.toDataURL;"
                        cnCode = cnCode + "var origToBlob=HTMLCanvasElement.prototype.toBlob;"
                        cnCode = cnCode + "var origGetImageData=CanvasRenderingContext2D.prototype.getImageData;"
                        // 备份原生实现, 供remove恢复 (delete原型会连同原生实现一起永久删除)
                        cnCode = cnCode + "if(!window.__MCP_CANVAS_ORIG__){window.__MCP_CANVAS_ORIG__={toDataURL:origToDataURL,toBlob:origToBlob,getImageData:origGetImageData};}"
                        cnCode = cnCode + "var addNoise=function(imgData,level){var d=imgData.data;if(!d)return imgData;"
                        cnCode = cnCode + "for(var i=0;i<d.length;i+=4){"
                        cnCode = cnCode + "var r=Math.floor(Math.random()*level*2-level);"
                        cnCode = cnCode + "d[i]=Math.min(255,Math.max(0,d[i]+r));"
                        cnCode = cnCode + "d[i+1]=Math.min(255,Math.max(0,d[i+1]+r));"
                        cnCode = cnCode + "d[i+2]=Math.min(255,Math.max(0,d[i+2]+r));"
                        cnCode = cnCode + "}return imgData;};"
                        // 核心: getImageData → 加噪 → 返回加噪后的数据
                        cnCode = cnCode + "CanvasRenderingContext2D.prototype.getImageData=function(x,y,w,h){"
                        cnCode = cnCode + "var imgData=origGetImageData.call(this,x,y,w,h);"
                        cnCode = cnCode + "return addNoise(imgData,L);};"
                        // 对toDataURL/toBlob也注入噪声: 临时替换getImageData, 完成后恢复
                        cnCode = cnCode + "HTMLCanvasElement.prototype.toDataURL=function(){"
                        cnCode = cnCode + "var ctx=this.getContext('2d');if(!ctx)return origToDataURL.apply(this,arguments);"
                        cnCode = cnCode + "var imgData=ctx.getImageData(0,0,this.width,this.height);"
                        cnCode = cnCode + "ctx.putImageData(addNoise(imgData,L),0,0);"
                        cnCode = cnCode + "return origToDataURL.apply(this,arguments);};"
                        cnCode = cnCode + "HTMLCanvasElement.prototype.toBlob=function(cb){"
                        cnCode = cnCode + "var ctx=this.getContext('2d');if(!ctx)return origToBlob.apply(this,arguments);"
                        cnCode = cnCode + "var imgData=ctx.getImageData(0,0,this.width,this.height);"
                        cnCode = cnCode + "ctx.putImageData(addNoise(imgData,L),0,0);"
                        cnCode = cnCode + "return origToBlob.apply(this,arguments);};"
                        cnCode = cnCode + "window.__MCP_CANVAS_NOISED__=true;"
                        cnCode = cnCode + "window.__MCP_CANVAS_NOISE_LVL__=L;"
                        cnCode = cnCode + "return'Canvas noise injected(level='+L+')';"
                        cnCode = cnCode + "})()"
                        变量 cnResult <类型 = 文本型>
                        cnResult = MCP命令服务器.提交异步JS任务 (cnBrowser, cnCode)
                        返回 (MCP命令服务器.包装异步提交结果 (命令ID, cnResult, "message", "Canvas噪声已注入(level=" + 到文本 (cnNoiseLevel) + ") | 通过mcp_result查询"))
                    }
                    否则 (cnAction == "remove" || cnAction == "disable")
                    {
                        变量 cnRemoveCode <类型 = 文本型>
                        // 从备份恢复原生实现 (勿直接delete原型属性, 否则原生API连同补丁一起永久消失)
                        cnRemoveCode = "(function(){var o=window.__MCP_CANVAS_ORIG__;if(o){if(o.toDataURL)HTMLCanvasElement.prototype.toDataURL=o.toDataURL;if(o.toBlob)HTMLCanvasElement.prototype.toBlob=o.toBlob;if(o.getImageData)CanvasRenderingContext2D.prototype.getImageData=o.getImageData;delete window.__MCP_CANVAS_ORIG__;}else if(window.__MCP_CANVAS_NOISED__){delete HTMLCanvasElement.prototype.toDataURL;delete HTMLCanvasElement.prototype.toBlob;delete CanvasRenderingContext2D.prototype.getImageData;}delete window.__MCP_CANVAS_NOISED__;delete window.__MCP_CANVAS_NOISE_LVL__;return'Canvas noise removed'})()"
                        MCP命令服务器.提交异步JS任务 (cnBrowser, cnRemoveCode)
                        返回 (MCP_响应构建.命令成功 (命令ID, "Canvas噪声已移除(原生API已恢复) | 刷新页面可重新注入"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + cnAction + " | 支持: inject/enable/remove/disable"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 网络日志 HAR 导出 ===
        否则 (方法名 == "browser_network_export")
        {
            变量 neFormat <类型 = 文本型>
            neFormat = MCP命令服务器.yyjson取文本 (参数JSON, "format")
            如果 (neFormat == "")
            {
                neFormat = "json"
            }
            变量 neLimit <类型 = 整数>
            neLimit = MCP命令服务器.yyjson取整数 (参数JSON, "limit")
            如果 (neLimit <= 0 || neLimit > 50000)
            {
                neLimit = 2000
            }
            变量 neResult <类型 = 文本型>
            neResult = MCP命令服务器.查询事件日志 ("network", "", 0, neLimit)
            如果 (neFormat == "har")
            {
                // 构建 HAR 格式 (HTTP Archive 1.2) — 纯文本拼接, 规避yyjson嵌套加入崩溃(0xC0000005红线)
                // neResult 为单行JSON数组文本(查询事件日志无换行拼接), 按数组解析
                变量 neArr <类型 = YYJSON只读数组类>
                neArr = MCP命令服务器.取JSON数组自文本 (neResult, "items")
                变量 neCount <类型 = 整数>
                neCount = (整数)neArr.取成员数 ()
                变量 harEntries <类型 = 文本型>
                harEntries = "["
                变量 harFirst <类型 = 逻辑型 值 = 真>
                计次循环 (neCount)
                {
                    变量 neJson <类型 = YYJSON只读对象类>
                    neJson = neArr.取成员 (取循环索引 ())
                    如果 (neJson.是否为空 () == 假)
                    {
                        如果 (harFirst)
                        {
                            harFirst = 假
                        }
                        否则
                        {
                            harEntries = harEntries + ","
                        }
                        harEntries = harEntries + "{\"startedDateTime\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.yyjson取文本 (neJson, "timestamp")) + "\",\"time\":\"0\",\"request\":{\"method\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.yyjson取文本 (neJson, "method")) + "\",\"url\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.yyjson取文本 (neJson, "url")) + "\"},\"response\":{\"status\":" + 到文本 (MCP命令服务器.yyjson取整数 (neJson, "status")) + ",\"statusText\":\"OK\",\"mimeType\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.yyjson取文本 (neJson, "mime")) + "\",\"content_size\":" + 到文本 (MCP命令服务器.yyjson取整数 (neJson, "content_length")) + "},\"serverIPAddress\":\"\",\"cache\":{},\"timings\":{\"send\":0,\"wait\":0,\"receive\":0}}"
                    }
                }
                harEntries = harEntries + "]"
                // 外层同样文本拼接
                变量 harOut <类型 = 文本型>
                harOut = "{\"log\":{\"version\":\"1.2\",\"creator\":{\"name\":\"AI浏览器 MCP Server\",\"version\":\"" + MCP_常量.MCP_版本号 + "\"},\"entries\":" + harEntries + "}}"
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, harOut))
            }
            否则
            {
                // JSON 格式: 返回原始条目数组
                返回 (MCP_响应构建.构建简单JSON ("network_logs", neResult))
            }
        }
        // === 权限API伪装 (反检测) ===
        否则 (方法名 == "browser_permission_spoof")
        {
            变量 psAction <类型 = 文本型>
            psAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (psAction == "")
            {
                psAction = "apply"
            }
            变量 psBrowser <类型 = 类_FBrowser_浏览器>
            psBrowser = MCP命令服务器.取主浏览器 ()
            如果 (psBrowser.是否为空 () == 假 && psBrowser.是否已关闭 () == 假)
            {
                变量 psFrame <类型 = 类_FBrowser_框架>
                psFrame = MCP命令服务器.取安全主框架 (psBrowser)
                如果 (psFrame.是否为空 () == 假 && psFrame.是否有效 ())
                {
                    如果 (psAction == "apply" || psAction == "spoof")
                    {
                        变量 psState <类型 = 文本型>
                        psState = MCP命令服务器.yyjson取文本 (参数JSON, "state")
                        如果 (psState == "")
                        {
                            psState = "granted"
                        }
                        变量 psPerms <类型 = 文本型>
                        psPerms = MCP命令服务器.yyjson取文本 (参数JSON, "permissions")
                        如果 (psPerms == "")
                        {
                            psPerms = "geolocation,notifications,camera,microphone,midi,clipboard-read,clipboard-write"
                        }
                        // 通过 JS 注入覆盖 Permissions API
                        变量 psCode <类型 = 文本型>
                        psCode = "(function(){"
                        psCode = psCode + "var state='" + MCP命令服务器.简单转义JS (psState) + "';"
                        // 先转义用户数据再按逗号拆分(顺序反了会使 perms.indexOf 恒为 -1, 伪装失效)
                        psPerms = MCP命令服务器.简单转义JS (psPerms)
                        子文本替换 (psPerms, ",", "','", , , 假)
                        psCode = psCode + "var perms=['" + psPerms + "'];"
                        psCode = psCode + "if(navigator.permissions&&navigator.permissions.query){"
                        psCode = psCode + "var origQuery=navigator.permissions.query.bind(navigator.permissions);"
                        psCode = psCode + "navigator.permissions.query=function(desc){"
                        psCode = psCode + "if(perms.indexOf(desc.name)!==-1){"
                        psCode = psCode + "return Promise.resolve({state:state,onchange:null});"
                        psCode = psCode + "}return origQuery(desc);"
                        psCode = psCode + "}}"
                        // 同时覆盖 MediaDevices API
                        psCode = psCode + "if(navigator.mediaDevices&&navigator.mediaDevices.enumerateDevices){"
                        psCode = psCode + "var origEnum=navigator.mediaDevices.enumerateDevices.bind(navigator.mediaDevices);"
                        psCode = psCode + "navigator.mediaDevices.enumerateDevices=function(){"
                        psCode = psCode + "if(state==='denied')return Promise.resolve([]);"
                        psCode = psCode + "return origEnum();}"
                        psCode = psCode + "}"
                        psCode = psCode + "return 'Permissions API 已伪装: ' + perms.join(',') + ' → ' + state;"
                        psCode = psCode + "})()"
                        变量 psResult <类型 = 文本型>
                        psResult = MCP命令服务器.提交异步JS任务 (psBrowser, psCode)
                        返回 (MCP命令服务器.包装异步提交结果 (命令ID, psResult, "message", "权限API伪装已注入 | 权限:" + psPerms + " → " + psState + " | 通过mcp_result查询"))
                    }
                    否则 (psAction == "reset" || psAction == "remove")
                    {
                        变量 psResetCode <类型 = 文本型>
                        psResetCode = "(function(){delete navigator.permissions.query;delete navigator.mediaDevices.enumerateDevices;return '权限伪装已移除, 刷新后恢复默认'})()"
                        MCP命令服务器.提交异步JS任务 (psBrowser, psResetCode)
                        返回 (MCP_响应构建.命令成功 (命令ID, "权限伪装已尝试移除 | 建议刷新页面恢复默认"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + psAction + " | 支持: apply/spoof/reset/remove"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 收集 ===
        否则 (方法名 == "browser_collect")
        {
            变量 action <类型 = 文本型>
            action = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (action == "network_enable" || action == "network_detail_enable" || action == "network_disable" || action == "network_get" || action == "network_clear" || action == "list" || action == "get" || action == "enable" || action == "disable" || action == "clear" || action == "detail_enable")
            {
                返回 (分类分派_核心操作 (命令ID, "browser_network", 参数JSON))
            }
            否则 (action == "cache_enable")
            {
                MCP命令服务器.是否缓存响应 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "响应缓存已启用 (SQLite)"))
            }
            否则 (action == "cache_clear")
            {
                MCP命令服务器.执行SQL ("DELETE FROM response_cache")
                返回 (MCP_响应构建.命令成功 (命令ID, "响应缓存已清空 (SQLite, 缓存仍启用)"))
            }
            否则 (action == "console_enable")
            {
                MCP命令服务器.是否记录控制台 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "控制台日志已启用"))
            }
            // === 场景预备: 逆向分析 ===
            否则 (action == "reverse_prepare")
            {
                如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "clear") != 假)
                {
                    MCP命令服务器.执行SQL ("DELETE FROM event_log WHERE log_type='network' OR log_type='network_detail'")
                }
                MCP命令服务器.是否记录网络 = 真
                MCP命令服务器.是否详细记录网络 = 真
                MCP命令服务器.是否记录控制台 = 真
                变量 指南 <类型 = YYJSON对象类>
                指南.创建自文本 ("{}")
                指南.加入文本成员 ("scenario", "reverse_analyze")
                指南.加入文本成员 ("tip", "navigate 后 browser_network list + browser_evaluate 扫描 script")
                指南.加入文本成员 ("script", "node mcp_bridge.js --call browser_collect '{\"action\":\"reverse_prepare\"}'")
                指南.加入文本成员 ("workflow", "workflow_run name=reverse_analyze")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 指南.到可读文本 (YYJSON格式化选项.压缩)))
            }
            // === 场景预备: 断点调试 ===
            否则 (action == "debug_prepare")
            {
                MCP命令服务器.是否记录网络 = 真
                MCP命令服务器.是否详细记录网络 = 真
                变量 指南1 <类型 = YYJSON对象类>
                指南1.创建自文本 ("{}")
                指南1.加入文本成员 ("scenario", "debugger")
                指南1.加入文本成员 ("tip", "VIP: debugger_flow 一键 | 或 enable→breakpoint→navigate→wait_paused→inspect→resume")
                指南1.加入文本成员 ("script", "browser_debugger_flow 或 mcp_bridge.js --call browser_debugger_flow")
                指南1.加入文本成员 ("workflow", "workflow_run name=debugger_full")
                指南1.加入文本成员 ("next_tools", "browser_debugger_flow {url,breakpoint,expressions} | wait_paused → inspect / script_source → resume")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 指南1.到可读文本 (YYJSON格式化选项.压缩)))
            }
            否则 (action == "debug_wait_paused")
            {
                变量 wMs <类型 = 整数>
                wMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_ms")
                如果 (wMs == 0)
                {
                    wMs = 30000
                }
                变量 rawW <类型 = 文本型>
                rawW = MCP命令服务器.等待CDP事件 ("Debugger.paused", wMs)
                如果 (rawW == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "等待 Debugger.paused 超时"))
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.解析Debugger暂停摘要 (rawW)))
            }
            否则 (action == "debug_inspect")
            {
                返回 (分类分派_核心操作 (命令ID, "browser_debugger_inspect", 参数JSON))
            }
            否则 (action == "debug_resume")
            {
                返回 (分类分派_核心操作 (命令ID, "browser_debugger_resume", 参数JSON))
            }
            否则 (action == "debug_flow")
            {
                返回 (分类分派_核心操作 (命令ID, "browser_debugger_flow", 参数JSON))
            }
            否则 (action == "debug_script_source")
            {
                返回 (分类分派_核心操作 (命令ID, "browser_debugger_script_source", 参数JSON))
            }
            // === 场景预备: 自动化 ===
            否则 (action == "automation_prepare")
            {
                变量 指南2 <类型 = YYJSON对象类>
                指南2.创建自文本 ("{}")
                指南2.加入文本成员 ("scenario", "automation")
                指南2.加入文本成员 ("tip", "fill_* / dom_* / wait / batch / screenshot 组合使用")
                指南2.加入文本成员 ("script", "workflow_run name=automation_form 或 mcp_bridge.js --call")
                指南2.加入文本成员 ("workflow", "workflow_run name=automation_form")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 指南2.到可读文本 (YYJSON格式化选项.压缩)))
            }
            否则 (action == "console_disable")
            {
                MCP命令服务器.是否记录控制台 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "控制台日志已禁用"))
            }
            否则 (action == "console_get")
            {
                如果 (MCP命令服务器.是否记录控制台 == 假)
                {
                    MCP命令服务器.是否记录控制台 = 真
                }
                // keyword 参数按日志内容关键词搜索 (定位Hook输出/报错/特征字符串)
                变量 consoleKeyword <类型 = 文本型>
                consoleKeyword = MCP命令服务器.yyjson取文本 (参数JSON, "keyword")
                如果 (consoleKeyword != "")
                {
                    返回 (MCP_响应构建.构建简单JSON ("console_logs", MCP命令服务器.查询控制台日志_带关键词 (consoleKeyword, MCP命令服务器.yyjson取整数 (参数JSON, "limit"))))
                }
                返回 (MCP_响应构建.构建简单JSON ("console_logs", MCP命令服务器.查询事件日志 ("console", "", 0, 500)))
            }
            否则 (action == "console_clear")
            {
                MCP命令服务器.执行SQL ("DELETE FROM event_log WHERE log_type='console'")
                返回 (MCP_响应构建.命令成功 (命令ID, "已清空"))
            }
            // === 浏览器事件监控 ===
            否则 (action == "event_load_enable")
            {
                MCP命令服务器.是否监控载入事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "载入事件监控已启用 (load_start/load_end/load_error/navigate/popup/loading_state_change)"))
            }
            // === v3.2 事件族单独开关 (可按需只开某一类, 不必用 event_all_enable 全开) ===
            否则 (action == "event_menu_enable")
            {
                MCP命令服务器.是否监控菜单事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "右键菜单事件监控已启用 (context_menu_opening/run/command/dismissed)"))
            }
            否则 (action == "event_quickmenu_enable")
            {
                MCP命令服务器.是否监控快捷菜单 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "快捷菜单事件监控已启用 (quick_menu_command/dismissed)"))
            }
            否则 (action == "event_navintent_enable")
            {
                MCP命令服务器.是否监控导航意图 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "导航意图监控已启用 (open_url_from_tab 弹窗/新标签, protocol_execution 页面调起外部程序, main_document_creating)"))
            }
            否则 (action == "event_ui_enable")
            {
                MCP命令服务器.是否监控界面细节 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "界面细节监控已启用 (tooltip/cursor_changed/auto_resize/render_view_ready/draggable_regions_changed/client_cert_selected)"))
            }
            否则 (action == "event_extension_enable")
            {
                MCP命令服务器.是否监控插件生命周期 = 真
                // 双闸不一致(实测缺陷): 扩展族事件经 记录应用监控事件 包装写入, 包装里还有总闸
                // 是否监控应用事件(默认假) —— 只置族开关会拿到"已启用"回执但事件一条不落库(假成功)。
                // 故这里同时打开总闸, 回执如实说明。
                MCP命令服务器.是否监控应用事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "插件生命周期监控已启用 (查询用 app_extension_created / app_extension_create_failed / app_extension_loaded / app_extension_unloaded) | 已同时打开应用事件总闸(事件写入包装受总闸控制, 只开族开关会拿到已启用回执但事件不落库)"))
            }
            否则 (action == "event_startup_enable")
            {
                MCP命令服务器.是否监控启动流程 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "启动流程监控开关已置真 (可查 app_startup_request_context_ready / app_startup_cmdline / app_startup_child_process / app_startup_message_pump)。两点说明: ① 这些事件在进程启动阶段触发, 开启监控**之后**的启动流程才会被记录; ② app_startup_webkit_init 属渲染进程事件, 在本架构下不会被派发, 不会产生记录"))
            }
            否则 (action == "event_render_enable")
            {
                MCP命令服务器.是否监控渲染细节 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "渲染细节监控开关已置真。⚠ 实测说明: 本族事件(渲染_*)由 CEF 渲染进程触发, 而渲染进程是 SDK 自带的 FBroSubprocess.exe, 与承载本项目代码的浏览器进程分离; 经真机验证, 这些事件**不会**被派发到本项目的事件覆盖上, 因此 app_render_* **不会产生任何记录**。开启本开关不会报错, 但请不要依赖其查询结果。需要页面侧信息请改用 browser_execute_js / browser_snapshot / browser_dom_query 等主进程侧工具"))
            }
            否则 (action == "event_renderws_enable")
            {
                MCP命令服务器.是否监控WebSocket渲染 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "渲染侧WebSocket监控开关已置真。⚠ 实测说明: 本族事件同属渲染进程事件(渲染_VIP_WebSocket客户端_*), 在本架构下不会被派发, app_render_ws_* **不会产生记录**。若要观察 WebSocket 流量, 请改用 browser_intercept(手写过滤器) 或 browser_reverse_websocket / browser_network 等主进程侧能力"))
            }
            否则 (action == "event_permission_enable")
            {
                MCP命令服务器.是否监控许可提示 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "许可提示监控已启用 (permission_media_request/prompt_show/prompt_close) | 可感知页面索要摄像头/麦克风/定位等权限"))
            }
            否则 (action == "event_offscreen_enable")
            {
                MCP命令服务器.是否监控离屏渲染 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "离屏渲染(OSR)事件族监控开关已置真 (可查 offscreen_get_screen_point / get_screen_info / popup_show / paint / paint_accelerated / start_dragging / update_drag_cursor / scroll_offset / ime_range / text_selection / virtual_keyboard)。⚠ 本族事件仅在离屏渲染模式下由 CEF 回调, 本项目采用窗口内嵌渲染, 因此**不会触发、不会产生记录**; 开启不会报错, 但请勿依赖其查询结果"))
            }
            否则 (action == "event_devtoolspopup_enable")
            {
                MCP命令服务器.是否监控开发者窗口 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "开发者窗口(DevTools 弹窗)监控已启用 (devtools_popup) | 非用户命令打开 DevTools 时会记录; 该事件在类库中无返回值类型, 本覆盖不改变 CEF 行为"))
            }
            否则 (action == "event_urlreq_enable")
            {
                MCP命令服务器.是否监控自建URL请求 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "自建URL请求监控已启用 (urlreq_start / urlreq_download / urlreq_auth) | 仅记录 browser_network_body 一类自建请求; 进度只写 event_log, 不写异步结果槽"))
            }
            否则 (action == "event_title_enable")
            {
                MCP命令服务器.是否监控标题改变 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "标题改变监控已启用"))
            }
            否则 (action == "event_progress_enable")
            {
                MCP命令服务器.是否监控加载进度 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "加载进度监控已启用 (0/25/50/75/100里程碑)"))
            }
            否则 (action == "event_resource_enable")
            {
                MCP命令服务器.是否监控资源事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "资源事件监控已启用 (主框架request/response/redirect)"))
            }
            否则 (action == "event_dialog_enable")
            {
                MCP命令服务器.是否监控对话框 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "JS对话框监控已启用 (alert/confirm/prompt/before_unload/file_dialog)"))
            }
            否则 (action == "event_fullscreen_enable")
            {
                MCP命令服务器.是否监控全屏 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "全屏事件监控已启用"))
            }
            否则 (action == "event_lifecycle_enable")
            {
                MCP命令服务器.是否监控生命周期 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "生命周期事件监控已启用 (browser_created/closing/url_changed/do_close)"))
            }
            否则 (action == "event_favicon_enable")
            {
                MCP命令服务器.是否监控图标 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "网页图标事件监控已启用"))
            }
            否则 (action == "event_find_enable")
            {
                MCP命令服务器.是否监控查找 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "页内查找事件监控已启用"))
            }
            否则 (action == "event_frame_enable")
            {
                MCP命令服务器.是否监控框架 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "框架生命周期事件监控已启用"))
            }
            否则 (action == "event_download_enable")
            {
                MCP命令服务器.是否监控下载事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "下载事件监控已启用 (download_request/start/progress)"))
            }
            否则 (action == "event_focus_enable")
            {
                MCP命令服务器.是否监控键盘焦点 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "键盘/焦点事件监控已启用"))
            }
            否则 (action == "event_all_enable")
            {
                MCP命令服务器.是否监控载入事件 = 真
                MCP命令服务器.是否监控标题改变 = 真
                MCP命令服务器.是否监控加载进度 = 真
                MCP命令服务器.是否监控资源事件 = 真
                MCP命令服务器.是否监控对话框 = 真
                MCP命令服务器.是否监控全屏 = 真
                MCP命令服务器.是否监控图标 = 真
                MCP命令服务器.是否监控查找 = 真
                MCP命令服务器.是否监控框架 = 真
                MCP命令服务器.是否监控下载事件 = 真
                MCP命令服务器.是否监控键盘焦点 = 真
                MCP命令服务器.是否监控生命周期 = 真
                MCP命令服务器.是否监控应用事件 = 真
                MCP命令服务器.是否记录控制台 = 真
                MCP命令服务器.是否记录网络 = 真
                MCP命令服务器.是否详细记录网络 = 真
                MCP命令服务器.是否监控菜单事件 = 真
                MCP命令服务器.是否监控快捷菜单 = 真
                MCP命令服务器.是否监控导航意图 = 真
                MCP命令服务器.是否监控界面细节 = 真
                MCP命令服务器.是否监控插件生命周期 = 真
                MCP命令服务器.是否监控启动流程 = 真
                MCP命令服务器.是否监控渲染细节 = 真
                MCP命令服务器.是否监控WebSocket渲染 = 真
                MCP命令服务器.是否监控许可提示 = 真
                MCP命令服务器.是否监控离屏渲染 = 真
                MCP命令服务器.是否监控开发者窗口 = 真
                MCP命令服务器.是否监控自建URL请求 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "全部事件监控已启用(28 项: 13 事件族 + 3 日志 + 12 扩展族, 与 browser_kernel_events_all 的集合**完全一致**) | event_log 上限 " + 到文本 (MCP_常量.事件日志最大条目) + " 条"))
            }
            否则 (action == "event_app_enable")
            {
                MCP命令服务器.是否监控应用事件 = 真
                返回 (MCP_响应构建.命令成功 (命令ID, "应用事件监控已启用 (v8/异常/焦点/渲染载入/IPC)"))
            }
            否则 (action == "event_all_disable")
            {
                MCP命令服务器.是否监控载入事件 = 假
                MCP命令服务器.是否监控标题改变 = 假
                MCP命令服务器.是否监控加载进度 = 假
                MCP命令服务器.是否监控资源事件 = 假
                MCP命令服务器.是否监控对话框 = 假
                MCP命令服务器.是否监控全屏 = 假
                MCP命令服务器.是否监控图标 = 假
                MCP命令服务器.是否监控查找 = 假
                MCP命令服务器.是否监控框架 = 假
                MCP命令服务器.是否监控下载事件 = 假
                MCP命令服务器.是否监控键盘焦点 = 假
                MCP命令服务器.是否监控生命周期 = 假
                MCP命令服务器.是否监控应用事件 = 假
                MCP命令服务器.是否记录控制台 = 假
                MCP命令服务器.是否记录网络 = 假
                MCP命令服务器.是否详细记录网络 = 假
                MCP命令服务器.是否监控菜单事件 = 假
                MCP命令服务器.是否监控快捷菜单 = 假
                MCP命令服务器.是否监控导航意图 = 假
                MCP命令服务器.是否监控界面细节 = 假
                MCP命令服务器.是否监控插件生命周期 = 假
                MCP命令服务器.是否监控启动流程 = 假
                MCP命令服务器.是否监控渲染细节 = 假
                MCP命令服务器.是否监控WebSocket渲染 = 假
                MCP命令服务器.是否监控许可提示 = 假
                MCP命令服务器.是否监控离屏渲染 = 假
                MCP命令服务器.是否监控开发者窗口 = 假
                MCP命令服务器.是否监控自建URL请求 = 假
                返回 (MCP_响应构建.命令成功 (命令ID, "全部事件监控已禁用(28 项, 与 event_all_enable 逐项对称)"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + action + " | 支持: network_enable/detail_enable/disable/get/clear, cache_enable/clear, console_enable/get/clear, event_*_enable/all_enable/all_disable"))
        }
        // === 浏览器完整状态 ===
        如果 (方法名 == "browser_status")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 状态对象 <类型 = YYJSON对象类>
                状态对象.创建自文本 ("{}")
                状态对象.加入逻辑值成员 ("is_popup", browser.是否为弹窗 ())
                状态对象.加入逻辑值成员 ("has_document", browser.是否有文档 ())
                状态对象.加入逻辑值成员 ("can_go_back", browser.可否后退 ())
                状态对象.加入逻辑值成员 ("can_go_forward", browser.可否前进 ())
                状态对象.加入逻辑值成员 ("is_loading", browser.是否读取中 ())
                状态对象.加入逻辑值成员 ("is_muted", browser.是否页面静音 ())
                状态对象.加入整数成员 ("browser_id", browser.取ID ())
                状态对象.加入整数成员 ("zoom_level_pct", 取整 (四舍五入 (browser.取缩放级别 () * 100, 0)))
                变量 statusUrlFrame <类型 = 类_FBrowser_框架>
                statusUrlFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (statusUrlFrame.是否为空 () == 假)
                {
                    状态对象.加入文本成员 ("url", statusUrlFrame.取地址 ())
                }
                否则
                {
                    状态对象.加入文本成员 ("url", "")
                }
                状态对象.加入文本成员 ("window_title", browser.取窗口标题 ())
                状态对象.加入文本成员 ("user_flag", browser.取用户标识 ())
                变量 hwnd <类型 = 变整数>
                hwnd = browser.取窗口句柄 ()
                状态对象.加入文本成员 ("hwnd", 到文本 (hwnd))
                状态对象.加入逻辑值成员 ("is_closed", browser.是否已关闭 ())
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 状态对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // 浏览器关闭入口: 统一入口, 两条路径都**转发**到既有实现(不另写一份关闭逻辑)
        否则 (方法名 == "browser_close_try")
        {
            // 类库的 尝试关闭浏览器(TryCloseBrowser) 在本项目恒返回假(没有它要求的"顶层窗口关闭处理器"),
            // 故这里**不调用它**, 而是按目标分类转发:
            // · browser_id 指向非主浏览器 → browser_close(真正关闭, 实测可关后台浏览器)
            // · 指向主窗口(未传 id / id 就是主浏览器) → 关它等于退出整个 MCP 服务 ⇒ 需 confirm:true,
            //   转发 browser_shutdown 的安全关闭序列(响应先返回, 关闭经 UI 时钟延迟 1~3 秒执行)
            变量 ctID <类型 = 整数>
            ctID = MCP命令服务器.yyjson取整数 (参数JSON, "browser_id")
            变量 ct确认 <类型 = 逻辑型>
            ct确认 = MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm")
            // ⚠ 判"是不是主窗口"**不能**用 取主浏览器 (): 路由层已把参数里的 browser_id 写进静态
            //   目标浏览器ID, 而 取主浏览器() 在该值 >0 时**返回的就是目标自己** ⇒ "目标==主窗口"恒成立,
            //   后台浏览器也会被当成主窗口(实测踩到)。改按 ID 清单的**最小 id** 认定主窗口
            //   (主窗口最先创建; 枚举方式与 browser_list 一致), 期间持数组锁。
            变量 ct主ID <类型 = 整数 值 = 0>
            MCP命令服务器.浏览器数组锁.加锁 ()
            变量 ct清单 <类型 = 类_FBrowser_列表值>
            ct清单 = FBrowser_浏览器_取ID清单 ()
            如果 (ct清单.是否为空 () == 假)
            {
                变量 ct数量 <类型 = 整数>
                ct数量 = ct清单.取大小 ()
                计次循环 (ct数量)
                {
                    变量 ct项 <类型 = 整数>
                    ct项 = ct清单.取整数值 (取循环索引 ())
                    如果 (ct主ID == 0 || ct项 < ct主ID)
                    {
                        ct主ID = ct项
                    }
                }
            }
            MCP命令服务器.浏览器数组锁.解锁 ()
            如果 (ctID > 0 && ctID != ct主ID)
            {
                返回 (MCP_核心分派.分类分派_核心操作 (命令ID, "browser_close", 参数JSON))
            }
            如果 (ct确认)
            {
                返回 (MCP_系统分派.分类分派_系统操作 (命令ID, "browser_shutdown", 参数JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "关闭主浏览器窗口等于退出整个 AI-Fbowser-Mcp.exe 服务(MCP 连接会一起断开), 故需显式 confirm:true —— 加上 confirm:true 就会执行安全关闭(响应先返回, 1~3 秒后退出) | 只想关后台/其它浏览器: 传 browser_id=<browser_list 里的 id>, 本工具会直接关闭它 | 只想离开当前页面: browser_navigate 到其它地址"))
        }
        // === 源码视图 ===
        否则 (方法名 == "browser_view_source")
        {
            // 安全设计: 源码文本经MCP返回, 不弹任何窗口(不调用原生 源码视图(), 其会弹记事本窗口阻塞控制台)
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 viewMaxChars <类型 = 整数>
                viewMaxChars = MCP命令服务器.yyjson取整数 (参数JSON, "max_chars")
                如果 (viewMaxChars <= 0 || viewMaxChars > MCP_常量.截断_源码最大字节)
                {
                    viewMaxChars = MCP_常量.截断_源码默认字节
                }
                变量 viewSource <类型 = 文本型>
                // CDP 优先(与 evaluate/extract 同策略: 原生取源码通道同样有约 8% 丢回调→5s 超时,
                // 2025-09-13 全量扫测实测); 原生异步通道降级为回退。
                viewSource = MCP命令服务器.CDP执行JS并等待 ("(function(){try{return document.documentElement?document.documentElement.outerHTML:''}catch(e){return ''}})()", MCP_常量.同步等待_JS执行超时, 真)
                如果 (viewSource != "" && 是否以 (viewSource, "{\"error\"") == 假)
                {
                    // 截断与异步通道同口径: 按 max_chars 截断, 防超大页面撑爆响应
                    如果 (取文本长度 (viewSource) > viewMaxChars)
                    {
                        viewSource = 取文本左边 (viewSource, viewMaxChars)
                    }
                    返回 (MCP_响应构建.命令成功 (命令ID, viewSource))
                }
                viewSource = MCP命令服务器.提交异步取源码任务 (browser, , viewMaxChars)
                返回 (MCP命令服务器.包装异步提交结果 (命令ID, viewSource, "source", "源码获取已提交(max=" + 到文本 (viewMaxChars) + ")"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 焦点框架 ===
        否则 (方法名 == "browser_get_focused_frame")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 focusFrame <类型 = 类_FBrowser_框架>
                focusFrame = browser.取当前焦点框架 ()
                如果 (focusFrame.是否为空 () == 假)
                {
                    变量 框架信息 <类型 = YYJSON对象类>
                    框架信息.创建自文本 ("{}")
                    框架信息.加入文本成员 ("url", focusFrame.取地址 ())
                    框架信息.加入文本成员 ("name", focusFrame.取框架名 ())
                    框架信息.加入文本成员 ("frame_id", focusFrame.取框架ID ())
                    框架信息.加入逻辑值成员 ("is_main", focusFrame.是否为主框架 ())
                    框架信息.加入逻辑值成员 ("is_focused", 真)
                    框架信息.加入逻辑值成员 ("is_valid", focusFrame.是否有效 ())
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 框架信息.到可读文本 (YYJSON格式化选项.压缩)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "没有焦点框架"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 下载图片 ===
        否则 (方法名 == "browser_download_image")
        {
            变量 url <类型 = 文本型>
            url = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (url == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 url 不能为空"))
            }
            变量 urlLower <类型 = 文本型>
            urlLower = 到小写 (url)
            如果 (MCP命令服务器.是否以 (urlLower, "http://") == 假 && MCP命令服务器.是否以 (urlLower, "https://") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "仅支持http/https URL"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 异步下载ID <类型 = 文本型>
                异步下载ID = MCP命令服务器.生成异步任务ID ()
                变量 下载回调 <类型 = 类_FBrowser_事件智能指针>
                下载回调.创建 (类_MCP_下载图片回调)
                下载回调.取执行类 (类_MCP_下载图片回调).任务ID = 异步下载ID
                browser.下载图片 (url, 假, 0, 假, 下载回调)
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步下载ID, "图片下载已提交, 通过mcp_result查询"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 元数据 ===
        否则 (方法名 == "browser_meta")
        {
            变量 元数据对象 <类型 = YYJSON对象类>
            元数据对象.创建自文本 ("{}")
            元数据对象.加入文本成员 ("machine_code", FBrowserVIP注册.VIP注册_取机器码 ())
            元数据对象.加入文本成员 ("start_date", FBrowserVIP注册.VIP注册_取开始时间 ())
            元数据对象.加入文本成员 ("end_date", FBrowserVIP注册.VIP注册_取到期时间 ())
            元数据对象.加入文本成员 ("features", FBrowserVIP注册.VIP注册_取注册功能 ())
            元数据对象.加入文本成员 ("license_version", FBrowserVIP注册.VIP注册_取注册版本 ())
            元数据对象.加入文本成员 ("license_type", FBrowserVIP注册.VIP注册_取注册码类型 ())
            元数据对象.加入整数成员 ("browser_count", FBrowser_浏览器_取数量 ())
            元数据对象.加入文本成员 ("fbro_version", FBrowser_取版本号 ())
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 元数据对象.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 任务结果查询 ===
        否则 (方法名 == "mcp.result" || 方法名 == "mcp_result")
        {
            变量 request_id <类型 = 文本型>
            request_id = MCP命令服务器.yyjson取文本 (参数JSON, "request_id")
            变量 consume <类型 = 逻辑型>
            consume = MCP命令服务器.yyjson取逻辑 (参数JSON, "consume")
            变量 实际任务ID <类型 = 文本型>
            实际任务ID = request_id
            如果 (request_id != "")
            {
                变量 存储结果 <类型 = 文本型>
                存储结果 = MCP命令服务器.查询任务结果 (request_id)
                如果 (存储结果 == "")
                {
                    // 兼容: 客户端传入 task_id 而非 JSON-RPC request id
                    存储结果 = MCP命令服务器.查询异步结果 (request_id)
                }
                如果 (存储结果 != "")
                {
                    变量 结果解析 <类型 = YYJSON只读对象类>
                    如果 (结果解析.创建自文本 (存储结果))
                    {
                        // 异步 stub 含 task_id 时, 自动跟随到真实结果
                        如果 (结果解析.取逻辑值 ("_async"))
                        {
                            变量 linkedTaskID <类型 = 文本型>
                            linkedTaskID = MCP命令服务器.yyjson取文本 (结果解析, "task_id")
                            如果 (linkedTaskID != "" && linkedTaskID != request_id)
                            {
                                变量 真实结果 <类型 = 文本型>
                                真实结果 = MCP命令服务器.查询异步结果 (linkedTaskID)
                                如果 (真实结果 != "")
                                {
                                    变量 真实解析 <类型 = YYJSON只读对象类>
                                    如果 (真实解析.创建自文本 (真实结果))
                                    {
                                        如果 (真实解析.取逻辑值 ("_waiting") == 假)
                                        {
                                            存储结果 = 真实结果
                                            实际任务ID = linkedTaskID
                                            结果解析.创建自文本 (存储结果)
                                        }
                                    }
                                }
                            }
                        }
                        // ================================================================
                        //  等待轮询状态机 (browser_wait 的客户端侧推进引擎)

                        //  每次 mcp_result 调用推进一个状态:
                        //  ┌─ 已超时(max_ms) ──→ what=timeout → 成功完成
                        //  │                  ──→ what=selector/text/navigate → 失败(超时)
                        //  │
                        //  └─ 未超时:
                        //       ├─ what=timeout → 返回 "等待中..."
                        //       └─ what=selector/text:
                        //            ├─ 阶段1 (无 _check_task_id) → 提交JS检查
                        //            └─ 阶段2 (有 _check_task_id) → 查询JS结果
                        //                 ├─ found=true  → 成功
                        //                 └─ found=false → 重置,下一轮重试
                        // ================================================================
                        如果 (结果解析.取逻辑值 ("_waiting"))
                        {
                            变量 waitWhat <类型 = 文本型>
                            waitWhat = MCP命令服务器.yyjson取文本 (结果解析, "what")
                            变量 waitStartTime <类型 = 长整数>
                            waitStartTime = MCP命令服务器.yyjson取长整数 (结果解析, "start_time")
                            变量 waitMaxMs <类型 = 整数>
                            waitMaxMs = MCP命令服务器.yyjson取整数 (结果解析, "max_ms")
                            // _poll_count 仅作诊断; 超时以 max_ms 为准 (避免高频轮询早于 max_ms 误中止)
                            变量 pollCount <类型 = 整数>
                            pollCount = MCP命令服务器.yyjson取整数 (结果解析, "_poll_count")
                            pollCount = pollCount + 1
                            // 更新_poll_count到存储
                            变量 更新计数存储 <类型 = YYJSON对象类>
                            更新计数存储.创建自文本 (存储结果)
                            MCP命令服务器.覆盖整数成员 (更新计数存储, "_poll_count", pollCount)
                            MCP命令服务器.存储异步结果 (request_id, 更新计数存储.到可读文本 (YYJSON格式化选项.压缩))
                            // 检查超时
                            如果 (取启动时间 () - waitStartTime >= waitMaxMs)
                            {
                                MCP命令服务器.清理等待检查子任务 (存储结果)
                                // timeout类型: 等待时间到达 = 成功完成
                                如果 (waitWhat == "timeout")
                                {
                                    变量 超时成功 <类型 = YYJSON对象类>
                                    超时成功.创建自文本 ("{}")
                                    超时成功.加入逻辑值成员 ("success", 真)
                                    超时成功.加入文本成员 ("message", "等待完成: timeout " + 到文本 (waitMaxMs) + "ms 已到达")
                                    MCP命令服务器.存储异步结果 (request_id, 超时成功.到可读文本 (YYJSON格式化选项.压缩))
                                    返回 (超时成功.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                // selector/text类型: 超时未匹配 = 失败
                                变量 超时结果 <类型 = YYJSON对象类>
                                超时结果.创建自文本 ("{}")
                                超时结果.加入逻辑值成员 ("success", 假)
                                超时结果.加入文本成员 ("error", "等待超时(" + 到文本 (waitMaxMs) + "ms): " + waitWhat + "=" + MCP命令服务器.yyjson取文本 (结果解析, "value"))
                                // 更新存储结果, 清除_waiting标记
                                MCP命令服务器.存储异步结果 (request_id, 超时结果.到可读文本 (YYJSON格式化选项.压缩))
                                返回 (超时结果.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            如果 (waitWhat == "timeout")
                            {
                                // timeout类型: 继续等待, 不更新状态
                                变量 继续等待 <类型 = YYJSON对象类>
                                继续等待.创建自文本 ("{}")
                                继续等待.加入逻辑值成员 ("success", 真)
                                继续等待.加入文本成员 ("message", "等待中... 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s/" + 到文本 (waitMaxMs / 1000) + "s")
                                继续等待.加入逻辑值成员 ("_waiting", 真)
                                继续等待.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                继续等待.加入长整数成员 ("remaining_ms", waitMaxMs - (取启动时间 () - waitStartTime))
                                返回 (继续等待.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            否则 (waitWhat == "network_idle")
                            {
                                // 服务端检查: 活动网络请求数==0 且最后释放后已过 idle_ms
                                变量 idleMs <类型 = 整数>
                                idleMs = MCP命令服务器.yyjson取整数 (结果解析, "idle_ms")
                                如果 (idleMs <= 0)
                                {
                                    idleMs = 2000
                                }
                                变量 最后释放 <类型 = 长整数>
                                变量 当前活动数 <类型 = 整数>
                                MCP命令服务器.异步缓存锁.加锁 ()
                                最后释放 = MCP命令服务器.最后URL请求槽释放时间
                                当前活动数 = MCP命令服务器.活动URL请求数
                                MCP命令服务器.异步缓存锁.解锁 ()
                                如果 (当前活动数 == 0 && (最后释放 == 0 || 取启动时间 () - 最后释放 >= idleMs))
                                {
                                    变量 idle成功 <类型 = YYJSON对象类>
                                    idle成功.创建自文本 ("{}")
                                    idle成功.加入逻辑值成员 ("success", 真)
                                    idle成功.加入文本成员 ("message", "网络已空闲: " + 到文本 (取启动时间 () - 最后释放) + "ms 无活动请求")
                                    MCP命令服务器.存储异步结果 (request_id, idle成功.到可读文本 (YYJSON格式化选项.压缩))
                                    MCP命令服务器.清理等待检查子任务 (存储结果)
                                    返回 (idle成功.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                // 未空闲: 返回等待中状态
                                变量 idle等待 <类型 = YYJSON对象类>
                                idle等待.创建自文本 ("{}")
                                idle等待.加入逻辑值成员 ("success", 真)
                                idle等待.加入逻辑值成员 ("_waiting", 真)
                                idle等待.加入文本成员 ("message", "等待网络空闲... 活跃请求:" + 到文本 (当前活动数) + " 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s")
                                idle等待.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                返回 (idle等待.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            否则 (waitWhat == "load_end" || waitWhat == "load_start")
                            {
                                // 事件驱动(browser_navigate/reload wait_for_load): 由 解析等待任务 在 OnLoadEnd/OnLoadStart 回调中解析
                                // 此状态机仅保活+超时, 不自作主张判断 页面加载中 标志 (避免导航尚未开始/旧页面残留状态导致的假阳性)
                                变量 是否事件驱动 <类型 = 逻辑型>
                                是否事件驱动 = MCP命令服务器.yyjson取逻辑 (结果解析, "_event_driven")
                                如果 (是否事件驱动)
                                {
                                    变量 ev等待 <类型 = YYJSON对象类>
                                    ev等待.创建自文本 ("{}")
                                    ev等待.加入逻辑值成员 ("success", 真)
                                    ev等待.加入逻辑值成员 ("_waiting", 真)
                                    ev等待.加入文本成员 ("message", "等待OnLoadEnd事件触发... 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s/" + 到文本 (waitMaxMs / 1000) + "s")
                                    ev等待.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                    ev等待.加入长整数成员 ("remaining_ms", waitMaxMs - (取启动时间 () - waitStartTime))
                                    返回 (ev等待.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                // 原生: CEF事件缓存 页面加载中 标志, 非JS document.readyState (poll-driven like browser_wait)
                                变量 期望加载 <类型 = 逻辑型>
                                期望加载 = waitWhat == "load_start"
                                变量 当前加载 <类型 = 逻辑型>
                                当前加载 = 浏览器容器.取加载状态 ()
                                如果 (当前加载 == 期望加载)
                                {
                                    变量 load成功 <类型 = YYJSON对象类>
                                    load成功.创建自文本 ("{}")
                                    load成功.加入逻辑值成员 ("success", 真)
                                    load成功.加入文本成员 ("message", "页面状态满足: " + waitWhat)
                                    MCP命令服务器.存储异步结果 (request_id, load成功.到可读文本 (YYJSON格式化选项.压缩))
                                    MCP命令服务器.清理等待检查子任务 (存储结果)
                                    返回 (load成功.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                变量 load等待 <类型 = YYJSON对象类>
                                load等待.创建自文本 ("{}")
                                load等待.加入逻辑值成员 ("success", 真)
                                load等待.加入逻辑值成员 ("_waiting", 真)
                                load等待.加入文本成员 ("message", "等待" + waitWhat + "... 当前加载=" + 到文本 (当前加载) + " 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s")
                                load等待.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                返回 (load等待.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            否则 (waitWhat == "js_exec")
                            {
                                // JS异步执行预占位: 等待CEF回调完成, 超时时走前面通用超时路径
                                变量 jsWaitMsg <类型 = YYJSON对象类>
                                jsWaitMsg.创建自文本 ("{}")
                                jsWaitMsg.加入逻辑值成员 ("success", 真)
                                jsWaitMsg.加入逻辑值成员 ("_waiting", 真)
                                jsWaitMsg.加入文本成员 ("message", MCP命令服务器.yyjson取文本 (结果解析, "message"))
                                jsWaitMsg.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                jsWaitMsg.加入长整数成员 ("remaining_ms", waitMaxMs - (取启动时间 () - waitStartTime))
                                返回 (jsWaitMsg.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            否则 (waitWhat == "scrape")
                            {
                                // 爬虫状态机: phase 0(等load)→1(等selector)→2(提取)→完成
                                // 浏览器已关闭时立即终止
                                变量 scrapeBrowser <类型 = 类_FBrowser_浏览器>
                                scrapeBrowser = MCP命令服务器.取主浏览器 ()
                                如果 (scrapeBrowser.是否为空 () || scrapeBrowser.是否已关闭 ())
                                {
                                    变量 sFail <类型 = YYJSON对象类>
                                    sFail.创建自文本 ("{}")
                                    sFail.加入逻辑值成员 ("success", 假)
                                    sFail.加入文本成员 ("error", "爬虫中断: 浏览器已关闭")
                                    MCP命令服务器.存储异步结果 (request_id, sFail.到可读文本 (YYJSON格式化选项.压缩))
                                    MCP命令服务器.清理等待检查子任务 (存储结果)
                                    返回 (sFail.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                变量 scrapePhase <类型 = 整数>
                                scrapePhase = MCP命令服务器.yyjson取整数 (结果解析, "_phase")
                                变量 scrapeWaitSel <类型 = 文本型>
                                scrapeWaitSel = MCP命令服务器.yyjson取文本 (结果解析, "wait_selector")
                                变量 scrapeExtSel <类型 = 文本型>
                                scrapeExtSel = MCP命令服务器.yyjson取文本 (结果解析, "extract_selector")
                                如果 (scrapePhase == 0)
                                {
                                    // Phase 0: 等待页面加载完成
                                    // 必须**先确认页面真的换成了目标页**, 再看加载状态 ——
                                    // 否则导航尚未开始时 取加载状态()=="未加载" 会被误判为"已加载完成",
                                    // 于是从**上一个页面**(冷启动时是欢迎页)提取, 返回静默错数据。
                                    变量 sTargetUrl <类型 = 文本型>
                                    sTargetUrl = MCP命令服务器.yyjson取文本 (结果解析, "target_url")
                                    变量 sPrevUrl2 <类型 = 文本型>
                                    sPrevUrl2 = MCP命令服务器.yyjson取文本 (结果解析, "prev_url")
                                    变量 sCurUrl <类型 = 文本型>
                                    sCurUrl = ""
                                    变量 sCurFrame <类型 = 类_FBrowser_框架>
                                    sCurFrame = MCP命令服务器.取安全主框架 (scrapeBrowser)
                                    如果 (sCurFrame.是否为空 () == 假)
                                    {
                                        sCurUrl = sCurFrame.取地址 ()
                                    }
                                    变量 sPageChanged <类型 = 逻辑型>
                                    sPageChanged = 真
                                    // 目标与旧地址不同, 但当前地址**仍是旧地址** -> 页面还没换过去, 继续等
                                    如果 (sTargetUrl != "" && sPrevUrl2 != "" && sTargetUrl != sPrevUrl2 && sCurUrl == sPrevUrl2)
                                    {
                                        sPageChanged = 假
                                    }
                                    // 第二条证据(与 browser_navigate 同款): 本次导航发起之后确实发生过一次载入结束。
                                    // 它能覆盖"目标就是当前页/原地重载, 地址不变"的情形, 与地址判据互补。
                                    变量 sNavStartMs <类型 = 长整数>
                                    sNavStartMs = MCP命令服务器.yyjson取长整数 (结果解析, "nav_start_ms")
                                    变量 sLoadEnded <类型 = 逻辑型>
                                    sLoadEnded = 假
                                    如果 (sNavStartMs > 0 && 浏览器容器.取最后载入结束毫秒 () >= sNavStartMs)
                                    {
                                        sLoadEnded = 真
                                    }
                                    如果 ((sPageChanged || sLoadEnded) && 浏览器容器.取加载状态 () == 假)
                                    {
                                        scrapePhase = 1
                                        变量 sUpd <类型 = YYJSON对象类>
                                        sUpd.创建自文本 (存储结果)
                                        MCP命令服务器.覆盖整数成员 (sUpd, "_phase", scrapePhase)
                                        MCP命令服务器.存储异步结果 (request_id, sUpd.到可读文本 (YYJSON格式化选项.压缩))
                                    }
                                }
                                如果 (scrapePhase == 1)
                                {
                                    // Phase 1: 等待selector (如指定) 或直接进入phase 2
                                    如果 (scrapeWaitSel != "")
                                    {
                                        变量 sCheckID <类型 = 文本型>
                                        sCheckID = MCP命令服务器.yyjson取文本 (结果解析, "_check_task_id")
                                        如果 (sCheckID == "")
                                        {
                                            变量 sCode <类型 = 文本型>
                                            sCode = "(function(){var el=document.querySelector('" + MCP命令服务器.简单转义JS (scrapeWaitSel) + "');return JSON.stringify({found:!!el})})()"
                                            变量 sBrowser <类型 = 类_FBrowser_浏览器>
                                            sBrowser = MCP命令服务器.取主浏览器 ()
                                            如果 (sBrowser.是否为空 () == 假)
                                            {
                                                变量 sSubmit <类型 = 文本型>
                                                sSubmit = MCP命令服务器.提交异步JS任务 (sBrowser, sCode)
                                                变量 sSubParse <类型 = YYJSON只读对象类>
                                                如果 (sSubParse.创建自文本 (sSubmit))
                                                {
                                                    sCheckID = sSubParse.取文本 ("task_id")
                                                    如果 (sCheckID != "")
                                                    {
                                                        变量 sUpd2 <类型 = YYJSON对象类>
                                                        sUpd2.创建自文本 (存储结果)
                                                        MCP命令服务器.覆盖文本成员 (sUpd2, "_check_task_id", sCheckID)
                                                        MCP命令服务器.存储异步结果 (request_id, sUpd2.到可读文本 (YYJSON格式化选项.压缩))
                                                    }
                                                }
                                            }
                                        }
                                        否则
                                        {
                                            变量 sCheckResult <类型 = 文本型>
                                            sCheckResult = MCP命令服务器.查询异步结果 (sCheckID)
                                            如果 (sCheckResult != "")
                                            {
                                                变量 sChkParse <类型 = YYJSON只读对象类>
                                                如果 (sChkParse.创建自文本 (sCheckResult))
                                                {
                                                    // 预占位(_waiting): JS尚未回调, 保持check_id等待
                                                    如果 (sChkParse.取逻辑值 ("_waiting"))
                                                    {
                                                        // 不处理, 落入下方等待响应
                                                    }
                                                    否则
                                                    {
                                                        // JS回调包装格式: {"success":...,"message":"{\"found\":...}"}
                                                        // found 在 message 内层, 需二次解析 (与 mcp_result 等待状态机同模式)
                                                        变量 sFoundMatch <类型 = 逻辑型 值 = 假>
                                                        变量 sChkMsg <类型 = 文本型>
                                                        sChkMsg = MCP命令服务器.yyjson取文本 (sChkParse, "message")
                                                        如果 (sChkMsg != "")
                                                        {
                                                            变量 sInner <类型 = YYJSON只读对象类>
                                                            如果 (sInner.创建自文本 (sChkMsg) && sInner.取逻辑值 ("found"))
                                                            {
                                                                sFoundMatch = 真
                                                            }
                                                        }
                                                        如果 (sFoundMatch)
                                                        {
                                                            scrapePhase = 2
                                                            变量 sUpd3 <类型 = YYJSON对象类>
                                                            sUpd3.创建自文本 (存储结果)
                                                            MCP命令服务器.覆盖整数成员 (sUpd3, "_phase", 2)
                                                            MCP命令服务器.覆盖文本成员 (sUpd3, "_check_task_id", "")
                                                            MCP命令服务器.存储异步结果 (request_id, sUpd3.到可读文本 (YYJSON格式化选项.压缩))
                                                        }
                                                        否则 (sChkParse.取逻辑值 ("success"))
                                                        {
                                                            // JS回调成功但found为false: 清除check_id, 下次轮询重新提交
                                                            变量 sUpd3b <类型 = YYJSON对象类>
                                                            sUpd3b.创建自文本 (存储结果)
                                                            MCP命令服务器.覆盖文本成员 (sUpd3b, "_check_task_id", "")
                                                            MCP命令服务器.存储异步结果 (request_id, sUpd3b.到可读文本 (YYJSON格式化选项.压缩))
                                                        }
                                                        // JS回调失败(success=假): 保持check_id重查, 由超时兜底
                                                    }
                                                }
                                            }
                                            // sCheckResult为空时保持_check_task_id, 等待JS回调完成
                                        }
                                    }
                                    否则
                                    {
                                        scrapePhase = 2
                                    }
                                }
                                如果 (scrapePhase == 2)
                                {
                                    // Phase 2: 提交提取任务 → 进入phase 3等待结果
                                    变量 sBrowser <类型 = 类_FBrowser_浏览器>
                                    sBrowser = MCP命令服务器.取主浏览器 ()
                                    如果 (sBrowser.是否为空 () == 假)
                                    {
                                        变量 sExtID <类型 = 文本型>
                                        sExtID = MCP命令服务器.生成异步任务ID ()
                                        如果 (scrapeExtSel != "" && scrapeExtSel != "body")
                                        {
                                            变量 sJs码 <类型 = 文本型>
                                            sJs码 = "(function(){var e=document.querySelector('" + MCP命令服务器.简单转义JS (scrapeExtSel) + "');if(!e)return '__MCP_NO_ELEM__';return '__MCP_TEXT__'+String(e.textContent)})()"
                                            变量 sJs值 <类型 = 文本型>
                                            sJs值 = MCP命令服务器.CDP执行JS并等待 (sJs码, 10000, 真)
                                            变量 sExt已定 <类型 = 逻辑型 值 = 假>
                                            如果 (sJs值 == "__MCP_NO_ELEM__")
                                            {
                                                变量 sNoElem <类型 = YYJSON对象类>
                                                sNoElem.创建自文本 ("{}")
                                                sNoElem.加入逻辑值成员 ("success", 假)
                                                sNoElem.加入文本成员 ("error", "元素不存在或取不到值: " + scrapeExtSel + " | 建议: 先用 browser_fill_exists 或 browser_snapshot 确认元素存在")
                                                MCP命令服务器.存储异步结果 (sExtID, sNoElem.到可读文本 (YYJSON格式化选项.压缩))
                                                sExt已定 = 真
                                            }
                                            否则 (是否以 (sJs值, "__MCP_TEXT__"))
                                            {
                                                变量 sJs正文 <类型 = 文本型>
                                                sJs正文 = 取文本右边 (sJs值, 取文本长度 (sJs值) - 取文本长度 ("__MCP_TEXT__"))
                                                变量 sOkObj <类型 = YYJSON对象类>
                                                sOkObj.创建自文本 ("{}")
                                                sOkObj.加入逻辑值成员 ("success", 真)
                                                sOkObj.加入文本成员 ("message", sJs正文)
                                                MCP命令服务器.存储异步结果 (sExtID, sOkObj.到可读文本 (YYJSON格式化选项.压缩))
                                                sExt已定 = 真
                                            }
                                            如果 (sExt已定 == 假)
                                            {
                                                变量 sNoCDP <类型 = YYJSON对象类>
                                                sNoCDP.创建自文本 ("{}")
                                                sNoCDP.加入逻辑值成员 ("success", 假)
                                                sNoCDP.加入文本成员 ("error", "提取失败: JS 通道未返回结果(CDP 与原生同步 JS 均未取到), 选择器=" + scrapeExtSel + " | 建议: ①重试本工具; ②改用 browser_get_text / browser_dom_query 直接取值; ③若刚调用过 browser_vip_enable_js_env(enable:true), 该操作已知会破坏本会话 JS 通道, 需重启进程")
                                                MCP命令服务器.存储异步结果 (sExtID, sNoCDP.到可读文本 (YYJSON格式化选项.压缩))
                                            }
                                        }
                                        否则
                                        {
                                            MCP命令服务器.提交异步取文本任务 (sBrowser, sExtID)
                                        }
                                        变量 sUpd4 <类型 = YYJSON对象类>
                                        sUpd4.创建自文本 (存储结果)
                                        MCP命令服务器.覆盖整数成员 (sUpd4, "_phase", 3)
                                        MCP命令服务器.覆盖文本成员 (sUpd4, "_extract_task_id", sExtID)
                                        MCP命令服务器.存储异步结果 (request_id, sUpd4.到可读文本 (YYJSON格式化选项.压缩))
                                    }
                                }
                                如果 (scrapePhase == 3)
                                {
                                    // Phase 3: 查询提取结果 → 完成
                                    变量 sExtTaskID <类型 = 文本型>
                                    sExtTaskID = MCP命令服务器.yyjson取文本 (结果解析, "_extract_task_id")
                                    变量 sExtResult <类型 = 文本型>
                                    sExtResult = MCP命令服务器.查询异步结果 (sExtTaskID)
                                    如果 (sExtResult != "")
                                    {
                                        变量 sExtParse <类型 = YYJSON只读对象类>
                                        如果 (sExtParse.创建自文本 (sExtResult))
                                        {
                                            // 提取任务仍为执行中占位: 继续等待, 不把占位消息当最终结果
                                            如果 (sExtParse.取逻辑值 ("_waiting") == 假)
                                            {
                                                // 提取失败: 任务置失败并带出error
                                                如果 (sExtParse.取逻辑值 ("success") == 假)
                                                {
                                                    变量 sFailFinal <类型 = YYJSON对象类>
                                                    sFailFinal.创建自文本 ("{}")
                                                    sFailFinal.加入逻辑值成员 ("success", 假)
                                                    变量 sErrMsg <类型 = 文本型>
                                                    sErrMsg = MCP命令服务器.yyjson取文本 (sExtParse, "error")
                                                    如果 (sErrMsg == "")
                                                    {
                                                        sErrMsg = "提取失败: " + sExtResult
                                                    }
                                                    sFailFinal.加入文本成员 ("error", sErrMsg)
                                                    MCP命令服务器.存储异步结果 (request_id, sFailFinal.到可读文本 (YYJSON格式化选项.压缩))
                                                    MCP命令服务器.清理等待检查子任务 (存储结果)
                                                    返回 (sFailFinal.到可读文本 (YYJSON格式化选项.压缩))
                                                }
                                                变量 sFinal <类型 = YYJSON对象类>
                                                sFinal.创建自文本 ("{}")
                                                sFinal.加入逻辑值成员 ("success", 真)
                                                变量 sMsg <类型 = 文本型>
                                                sMsg = MCP命令服务器.yyjson取文本 (sExtParse, "message")
                                                如果 (sMsg == "")
                                                {
                                                    sMsg = sExtResult
                                                }
                                                sFinal.加入文本成员 ("text", 取文本左边 (sMsg, MCP_常量.截断_响应文本最大字符))
                                                MCP命令服务器.存储异步结果 (request_id, sFinal.到可读文本 (YYJSON格式化选项.压缩))
                                                MCP命令服务器.清理等待检查子任务 (存储结果)
                                                返回 (sFinal.到可读文本 (YYJSON格式化选项.压缩))
                                            }
                                        }
                                        // _waiting 占位或不可解析: 继续等待
                                    }
                                }
                                // 未完成: 返回等待中
                                变量 sWaitResp <类型 = YYJSON对象类>
                                sWaitResp.创建自文本 ("{}")
                                sWaitResp.加入逻辑值成员 ("success", 真)
                                sWaitResp.加入逻辑值成员 ("_waiting", 真)
                                sWaitResp.加入文本成员 ("message", "爬虫中(phase=" + 到文本 (scrapePhase) + ") 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s")
                                sWaitResp.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                返回 (sWaitResp.到可读文本 (YYJSON格式化选项.压缩))
                            }
                            否则
                            {
                                // selector/text/navigate/url_contains类型: 两阶段异步检查
                                // 阶段1: 未提交检查 → 提交JS并存储check_task_id, 等待下一轮轮询
                                // 阶段2: 已有检查 → 查询异步缓存获取实际JS执行结果
                                变量 checkTaskID <类型 = 文本型>
                                checkTaskID = MCP命令服务器.yyjson取文本 (结果解析, "_check_task_id")
                                如果 (checkTaskID == "")
                                {
                                    // 阶段1: 提交新的JS条件检查
                                    变量 browser <类型 = 类_FBrowser_浏览器>
                                    browser = MCP命令服务器.取主浏览器 ()
                                    如果 (browser.是否为空 ())
                                    {
                                        MCP命令服务器.清理等待检查子任务 (存储结果)
                                        变量 浏览器不可用 <类型 = YYJSON对象类>
                                        浏览器不可用.创建自文本 ("{}")
                                        浏览器不可用.加入逻辑值成员 ("success", 假)
                                        浏览器不可用.加入文本成员 ("error", "等待中断: 浏览器已不可用")
                                        MCP命令服务器.存储异步结果 (request_id, 浏览器不可用.到可读文本 (YYJSON格式化选项.压缩))
                                        返回 (浏览器不可用.到可读文本 (YYJSON格式化选项.压缩))
                                    }
                                    变量 checkCode <类型 = 文本型>
                                    checkCode = MCP命令服务器.yyjson取文本 (结果解析, "check_code")
                                    如果 (checkCode != "")
                                    {
                                        变量 rawSubmit <类型 = 文本型>
                                        rawSubmit = MCP命令服务器.提交异步JS任务 (browser, checkCode)
                                        变量 submit解析 <类型 = YYJSON只读对象类>
                                        如果 (submit解析.创建自文本 (rawSubmit))
                                        {
                                            checkTaskID = submit解析.取文本 ("task_id")
                                            如果 (checkTaskID != "")
                                            {
                                                变量 更新等待存储 <类型 = YYJSON对象类>
                                                更新等待存储.创建自文本 (存储结果)
                                                MCP命令服务器.覆盖文本成员 (更新等待存储, "_check_task_id", checkTaskID)
                                                MCP命令服务器.覆盖整数成员 (更新等待存储, "_poll_count", pollCount)
                                                MCP命令服务器.存储异步结果 (request_id, 更新等待存储.到可读文本 (YYJSON格式化选项.压缩))
                                            }
                                        }
                                    }
                                    变量 等待提交 <类型 = YYJSON对象类>
                                    等待提交.创建自文本 ("{}")
                                    等待提交.加入逻辑值成员 ("success", 真)
                                    等待提交.加入逻辑值成员 ("_waiting", 真)
                                    等待提交.加入文本成员 ("message", "等待中... " + waitWhat + "=" + MCP命令服务器.yyjson取文本 (结果解析, "value") + " 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s/" + 到文本 (waitMaxMs / 1000) + "s")
                                    等待提交.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                    等待提交.加入长整数成员 ("remaining_ms", waitMaxMs - (取启动时间 () - waitStartTime))
                                    返回 (等待提交.到可读文本 (YYJSON格式化选项.压缩))
                                }
                                否则
                                {
                                    // 阶段2: 查询异步JS执行结果
                                    变量 checkResultJSON <类型 = 文本型>
                                    checkResultJSON = MCP命令服务器.查询异步结果 (checkTaskID, 真)
                                    如果 (checkResultJSON != "")
                                    {
                                        // JS结果已到达, 解析found字段
                                        变量 check解析 <类型 = YYJSON只读对象类>
                                        如果 (check解析.创建自文本 (checkResultJSON))
                                        {
                                            变量 checkMsg <类型 = 文本型>
                                            checkMsg = MCP命令服务器.yyjson取文本 (check解析, "message")
                                            变量 foundMatch <类型 = 逻辑型 值 = 假>
                                            // message 是 JS 回调包装的 JSON: {"found":true,...}
                                            如果 (checkMsg != "")
                                            {
                                                变量 innerParse <类型 = YYJSON只读对象类>
                                                如果 (innerParse.创建自文本 (checkMsg) && innerParse.取逻辑值 ("found"))
                                                {
                                                    foundMatch = 真
                                                }
                                            }
                                            如果 (foundMatch)
                                            {
                                                MCP命令服务器.清理等待检查子任务 (存储结果)
                                                变量 找到结果 <类型 = YYJSON对象类>
                                                找到结果.创建自文本 ("{}")
                                                找到结果.加入逻辑值成员 ("success", 真)
                                                找到结果.加入文本成员 ("message", "等待完成: " + waitWhat + " 匹配成功 (" + 到文本 (取启动时间 () - waitStartTime) + "ms)")
                                                找到结果.加入文本成员 ("result", checkMsg)
                                                MCP命令服务器.存储异步结果 (request_id, 找到结果.到可读文本 (YYJSON格式化选项.压缩))
                                                返回 (找到结果.到可读文本 (YYJSON格式化选项.压缩))
                                            }
                                        }
                                        // 条件未满足: 清除check_task_id, 下一轮重新提交检查
                                        变量 重置等待 <类型 = YYJSON对象类>
                                        重置等待.创建自文本 (存储结果)
                                        重置等待.删除成员 ("_check_task_id")
                                        MCP命令服务器.覆盖整数成员 (重置等待, "_poll_count", pollCount)
                                        MCP命令服务器.存储异步结果 (request_id, 重置等待.到可读文本 (YYJSON格式化选项.压缩))
                                    }
                                    // 检查结果尚未到达: 继续等待
                                    变量 等待结果 <类型 = YYJSON对象类>
                                    等待结果.创建自文本 ("{}")
                                    等待结果.加入逻辑值成员 ("success", 真)
                                    等待结果.加入逻辑值成员 ("_waiting", 真)
                                    等待结果.加入文本成员 ("message", "等待中... " + waitWhat + "=" + MCP命令服务器.yyjson取文本 (结果解析, "value") + " 已过" + 到文本 ((取启动时间 () - waitStartTime) / 1000) + "s/" + 到文本 (waitMaxMs / 1000) + "s")
                                    等待结果.加入长整数成员 ("elapsed_ms", 取启动时间 () - waitStartTime)
                                    等待结果.加入长整数成员 ("remaining_ms", waitMaxMs - (取启动时间 () - waitStartTime))
                                    返回 (等待结果.到可读文本 (YYJSON格式化选项.压缩))
                                }
                            }
                        }
                        变量 是否成功 <类型 = 逻辑型>
                        是否成功 = 结果解析.取逻辑值 ("success")
                        变量 msg <类型 = 文本型>
                        如果 (是否成功 == 假)
                        {
                            msg = MCP命令服务器.yyjson取文本 (结果解析, "error")
                            如果 (msg != "")
                            {
                                msg = "[任务" + request_id + "] " + msg
                            }
                            否则
                            {
                                msg = "[任务" + request_id + "] 任务执行失败"
                            }
                        }
                        否则
                        {
                            msg = MCP命令服务器.yyjson取文本 (结果解析, "message")
                            如果 (msg == "")
                            {
                                msg = "success"
                            }
                        }
                        变量 原始数据JSON <类型 = 文本型>
                        原始数据JSON = MCP命令服务器.yyjson取JSON文本 (结果解析, "data")
                        如果 (原始数据JSON == "" && 是否成功)
                        {
                            变量 msgContent <类型 = 文本型>
                            msgContent = MCP命令服务器.yyjson取文本 (结果解析, "message")
                            变量 msgParse <类型 = YYJSON只读对象类>
                            如果 (msgContent != "" && msgParse.创建自文本 (msgContent))
                            {
                                原始数据JSON = msgContent
                            }
                        }
                        变量 响应JSON <类型 = 文本型>
                        响应JSON = MCP_响应构建.构建任务查询结果JSON (是否成功, msg, 原始数据JSON, 实际任务ID)
                        如果 (consume && 结果解析.取逻辑值 ("_waiting") == 假)
                        {
                            MCP命令服务器.删除异步结果 (实际任务ID)
                            如果 (实际任务ID != request_id)
                            {
                                MCP命令服务器.删除异步结果 (request_id)
                            }
                        }
                        返回 (响应JSON)
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "未找到任务结果: " + request_id + " | 可能原因: ①任务仍在执行(2-5秒后重试) ②request_id拼写错误 ③任务已过期被清理 | 💡大多数工具已默认sync-wait(直接返回结果), 无需手动mcp_result轮询"))
            }
            返回 (MCP_响应构建.命令失败 ("", "参数 request_id 不能为空 | 异步任务请使用 task_id (tools/call 返回的 task_xxx)"))
        }
        // === MCP状态 ===
        否则 (方法名 == "mcp.status" || 方法名 == "mcp_status")
        {
            变量 状态对象 <类型 = YYJSON对象类>
            状态对象.创建自文本 ("{}")
            状态对象.加入文本成员 ("server", MCP_常量.MCP_服务器名)
            状态对象.加入文本成员 ("version", MCP_常量.MCP_版本号)
            状态对象.加入整数成员 ("port", MCP命令服务器.服务器端口)
            状态对象.加入整数成员 ("browser_count", FBrowser_浏览器_取数量 ())
            状态对象.加入整数成员 ("tool_count", MCP命令服务器.工具总数)
            状态对象.加入长整数成员 ("uptime_ms", MCP命令服务器.取现行时间毫秒 () - MCP命令服务器.服务器启动墙钟毫秒)
            状态对象.加入逻辑值成员 ("cdp_ready", MCP命令服务器.CDP观察者已注册)
            状态对象.加入文本成员 ("status", "running")
            变量 状态统计 <类型 = 文本型>
            状态统计 = MCP命令服务器.取数据库统计JSON ()
            如果 (状态统计 != "")
            {
                状态对象.加入文本成员 ("db_stats", 状态统计)
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 状态对象.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 帮助 ===
        否则 (方法名 == "mcp.help" || 方法名 == "mcp_help")
        {
            // 深链: mcp_help {tool:"browser_navigate"} 返回该工具的完整描述与参数 schema。
            // 与 /tools/brief 配套: 上下文紧张时先取精简清单, 再按需查少量工具的详情。
            变量 深链工具名 <类型 = 文本型>
            深链工具名 = MCP命令服务器.yyjson取文本 (参数JSON, "tool")
            如果 (深链工具名 == "")
            {
                深链工具名 = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            }
            如果 (深链工具名 != "")
            {
                变量 工具详情 <类型 = 文本型>
                工具详情 = MCP命令服务器.取工具详情JSON (深链工具名)
                如果 (工具详情 == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未找到工具: " + 深链工具名 + " | 用 /tools/brief 取全部工具名, 或 mcp_help 不带参数查看分类清单"))
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 工具详情))
            }
            变量 帮助文本 <类型 = 文本型>
            帮助文本 = "=== AI浏览器 MCP v" + MCP_常量.MCP_版本号 + " 工具列表 ===\r\n\r\n"
            帮助文本 = 帮助文本 + "【导航】navigate(url) get_url get_title back forward reload stop\r\n"
            帮助文本 = 帮助文本 + "【内容】get_source get_text(selector?) extract(type:links/images/tables)\r\n"
            帮助文本 = 帮助文本 + "【DOM-原生】dom_query(selector,attribute?) dom_click(selector) dom_set_value(selector,value) dom_get_html dom_rect(selector) dom_inner_html(selector) dom_set_html(selector,html) dom_checked(selector) dom_selected(selector) dom_select(selector,index)\r\n"
            帮助文本 = 帮助文本 + "【填表-原生】fill_set_value fill_click fill_focus fill_scroll fill_exists fill_attr_get fill_attr_set fill_trigger fill_select\r\n"
            帮助文本 = 帮助文本 + "【JS执行】evaluate(code) execute_js(code) console_eval(expression) inject(type:js/css,code,persist?)\r\n"
            帮助文本 = 帮助文本 + "【自动化】wait(what:selector/text/timeout/load_end/load_start/navigate/network_idle/url_contains,value?,max_ms?) scrape(url,wait_selector?,extract_selector?,max_ms?)\r\n"
            帮助文本 = 帮助文本 + "【爬虫】browser_extract(type:links/images/tables,limit?) browser_scrape(url,extract_selector,wait_selector?,max_ms?)\r\n"
            帮助文本 = 帮助文本 + "【抓包】network(action:enable/detail_enable/list/clear) network_body(url) collect(action:console_enable/console_get/network_enable)\r\n"
            帮助文本 = 帮助文本 + "【逆向】cdp_call(method,params?,max_ms?) debugger_flow(url,breakpoint,expressions?,resume?) debugger_auto(url,breakpoint,max_ms?) cdp_event debugger_wait_paused debugger_inspect\r\n"
            帮助文本 = 帮助文本 + "【拦截】intercept(action:modify/replace_data/replace_file/block/line_replace/unmodify/unreplace/navigate_block/navigate_redirect/popup_config/cache/uncache/clear/ws_hook)\r\n"
            帮助文本 = 帮助文本 + "【Cookie】get_cookies set_cookie(name,value,domain?) delete_cookies(confirm)\r\n"
            帮助文本 = 帮助文本 + "【代理】set_proxy(address,username?,password?) clear_proxy\r\n"
            帮助文本 = 帮助文本 + "【指纹-VIP】fingerprint(action:canvas_random/webgl_random/audio_random/ua/webrtc/geolocation/timezone/ssl/set_batch)\r\n"
            帮助文本 = 帮助文本 + "【交互】mouse_click(x,y) mouse_move(x,y) mouse_wheel(x,y,delta_x,delta_y) key_event(key_code,type) touch_press/release/move\r\n"
            帮助文本 = 帮助文本 + "【编辑】edit_undo redo cut copy paste delete select_all find(text) stop_find\r\n"
            帮助文本 = 帮助文本 + "【截图】screenshot(format:png/jpeg/webp) print_to_pdf(path?,overwrite?)\r\n"
            帮助文本 = 帮助文本 + "【窗口】set_zoom(level) get_zoom set_mute(mute) is_muted compress_memory list get_id get_window_handle set_focus window_info\r\n"
            帮助文本 = 帮助文本 + "【框架】get_frames frame_names frame_by_name(name)\r\n"
            帮助文本 = 帮助文本 + "【编码】base64_encode(data) base64_decode(data) uri_encode(data) uri_decode(data)\r\n"
            帮助文本 = 帮助文本 + "【工作流】workflow_list workflow_get(name) workflow_run(name/steps) workflow_stop\r\n"
            帮助文本 = 帮助文本 + "【AI交互-推荐】snapshot(页面交互元素快照) click_text(text) get_forms(表单枚举) fill_form(fields) highlight(selector) event(空=最近事件时间线)\r\n"
            帮助文本 = 帮助文本 + "【逆向新能力】scan_crypto(加密特征) string_refs(字符串定位) detect_obfuscator(混淆识别) hook_multi(批量Hook) stack_trace(调用栈) hook_logs(Hook日志)\r\n"
            帮助文本 = 帮助文本 + "【滚动/索引】get_scroll scroll_by(x,y) element_action(index,action)——snapshot后按索引操作,无需选择器\r\n"
            帮助文本 = 帮助文本 + "【系统】mcp_status ping mcp_result(request_id,consume?) mcp_help batch(commands) fbro_version clear_cache\r\n"
            帮助文本 = 帮助文本 + "\r\n提示:\r\n"
            帮助文本 = 帮助文本 + "- 所有browser_xxx支持短名(去前缀),如navigate等价browser_navigate\r\n"
            帮助文本 = 帮助文本 + "- 异步工具返回task_id,用mcp_result轮询: mcp_result{request_id,consume:true}\r\n"
            帮助文本 = 帮助文本 + "- 同步等待:任意工具加max_ms参数,sync_wait:true启用服务端阻塞等待\r\n"
            帮助文本 = 帮助文本 + "- 批量执行:batch{commands:[{name,arguments},...]}\r\n"
            帮助文本 = 帮助文本 + "- 网络抓包: browser_network detail_enable → 操作 → browser_network list\r\n"
            帮助文本 = 帮助文本 + "- 本列表是**速览**, 不是全量: 完整工具清单(权威)请用 MCP 标准 tools/list; 本服务另有 VIP/内核/逆向/工作流等族未逐条列在此\r\n"
            帮助文本 = 帮助文本 + "- 通用参数(入口统一处理, 多数工具 schema 未逐个声明): browser_id / max_ms / async_only / sync_wait\r\n"
            帮助文本 = 帮助文本 + "- 大参数注意: MCP HTTP 通道在请求体约 1MB 处会被内核直接断连且**没有错误码**; 大内容请改用文件类参数(如 browser_create_url_request 的 body_file)或 WebSocket/stdio 通道\r\n"
            返回 (MCP_响应构建.构建简单JSON ("help", 帮助文本))
        }
        // === 别名列表 ===
        否则 (方法名 == "aliases" || 方法名 == "browser_aliases")
        {
            变量 别名列表 <类型 = 文本型>
            别名列表 = "快捷别名(browser_前缀可省略):\r\n"
            别名列表 = 别名列表 + "navigate get_url get_title back forward reload stop\r\n"
            别名列表 = 别名列表 + "evaluate execute_js get_source get_text screenshot\r\n"
            别名列表 = 别名列表 + "dom_query dom_click dom_set_value dom_get_html\r\n"
            别名列表 = 别名列表 + "create close list inject collect network intercept\r\n"
            别名列表 = 别名列表 + "wait cdp mouse_click mouse_move mouse_wheel key_event\r\n"
            别名列表 = 别名列表 + "get_cookies set_cookie delete_cookies set_proxy clear_proxy\r\n"
            别名列表 = 别名列表 + "set_mute print find fingerprint status set_zoom get_zoom\r\n"
            别名列表 = 别名列表 + "batch(批量) ping(连通检查) aliases(本列表)\r\n"
            返回 (MCP_响应构建.构建简单JSON ("aliases", 别名列表))
        }
        // === CDP 结果回传 (异步命令的结果经 mcp_result 取回) ===
        否则 (方法名 == "browser_cdp_call")
        {
            变量 cdpMethod <类型 = 文本型>
            cdpMethod = MCP命令服务器.yyjson取文本 (参数JSON, "method")
            如果 (cdpMethod != "")
            {
                // CDP 方法名规范为 "域.方法" (Network.getResponseBody 等), 无点号必为非法 -> 快速失败(否则会持协议锁挂满 30s+ 拖住其它请求)
                如果 (寻找文本 (cdpMethod, ".", 0, 假) == -1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "非法 CDP 方法名: " + cdpMethod + " | 规范格式为 域.方法, 例: Network.getResponseBody / Runtime.evaluate / Page.navigate / Debugger.enable | 无点号的方法名不会得到内核响应, 会长时间挂起并阻塞其它请求, 故直接拒绝"))
                }
                // 观察者由 浏览器_创建完毕 事件自动注册, 此处仅检查不注册(避免阻塞)
                返回 (MCP命令服务器.执行CDP命令 (命令ID, cdpMethod, 参数JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "CDP需要method参数"))
        }
        // === 浏览器事件查询 ===
        否则 (方法名 == "browser_event")
        {
            变量 evtType <类型 = 文本型>
            evtType = MCP命令服务器.yyjson取文本 (参数JSON, "event_type")
            变量 evtLimit <类型 = 整数>
            evtLimit = MCP命令服务器.yyjson取整数 (参数JSON, "limit")
            如果 (evtLimit <= 0 || evtLimit > 500)
            {
                evtLimit = 50
            }
            如果 (evtType == "")
            {
                // 时间线模式: 返回最近的全部事件 (跨类型, 按时间倒序), 无需指定event_type
                变量 evtBrowser0 <类型 = 类_FBrowser_浏览器>
                evtBrowser0 = MCP命令服务器.取主浏览器 ()
                变量 evtBID0 <类型 = 整数>
                evtBID0 = 0
                如果 (evtBrowser0.是否为空 () == 假)
                {
                    evtBID0 = evtBrowser0.取ID ()
                }
                变量 evtTimeline <类型 = 文本型>
                evtTimeline = MCP命令服务器.查询事件日志 ("", "", evtBID0, evtLimit)
                如果 (evtTimeline != "[]")
                {
                    // 时间线返回结构: 直接透传事件数组, 外层包success
                    变量 evtTLOut <类型 = YYJSON对象类>
                    evtTLOut.创建自文本 ("{}")
                    evtTLOut.加入逻辑值成员 ("success", 真)
                    evtTLOut.加入整数成员 ("limit", evtLimit)
                    evtTLOut.加入文本成员 ("timeline_json", evtTimeline)
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, evtTLOut.到可读文本 (YYJSON格式化选项.压缩)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "暂无事件记录 | 事件监控已默认开启(载入/生命周期/标题/下载), 框架/资源/控制台等需通过 browser_collect event_*_enable 开启"))
            }
            如果 (evtType != "")
            {
                // 应用事件: event_type 以 app_ 开头 → 查询 event_log
                如果 (MCP命令服务器.是否以 (evtType, "app_"))
                {
                    变量 appResult <类型 = 文本型>
                    // 用调用方给的条数: 原先写死 1, 导致查 app_* 族时永远只回 1 条
                    appResult = MCP命令服务器.查询事件日志 ("app_event", evtType, 0, evtLimit)
                    如果 (appResult != "[]")
                    {
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, appResult))
                    }
                    // 约束(实测): 本机(该 CEF 构建)整个 app_* 族**不产生任何记录** —— 它们由渲染进程触发,
                    // 而渲染进程是 SDK 自带的 FBroSubprocess.exe, 事件不会派发到本项目的事件覆盖上。
                    // 故"查不到"有两种完全不同的成因, 必须分开如实告知, 否则调用方会一直以为"忘了开开关":
                    //   ① 开关没开 → 提示打开; ② 开关已开仍无记录 → 说明本机该族天生不来 + 给出可用替代。
                    变量 app开关已开 <类型 = 逻辑型>
                    // 把**所有** app_* 族开关都算进来: 漏掉本族开关会让"事件已入库"却报"开关未开启"
                    // (实测: app_startup_* 已入库, 却因这里没算 是否监控启动流程 而被拒绝查询)
                    app开关已开 = MCP命令服务器.是否监控应用事件 || MCP命令服务器.是否监控渲染细节 || MCP命令服务器.是否监控WebSocket渲染 || MCP命令服务器.是否监控启动流程 || MCP命令服务器.是否监控插件生命周期
                    如果 (app开关已开)
                    {
                        // 文案按**实测**收窄(原写"整个 app_* 族永不入库"已被推翻一半):
                        //   · 渲染族(app_render_*/app_v8_*/app_render_ws_*)由渲染进程 FBroSubprocess.exe 触发,
                        //     本机不派发到主进程覆盖 ⇒ 确实永远不入库;
                        //   · 主进程族**会**入库: app_startup_cmdline / app_startup_request_context_ready /
                        //     app_startup_child_process(实测已可查)、扩展生命周期 app_extension_*(运行期触发, 同样可查)。
                        返回 (MCP_响应构建.命令失败 (命令ID, "未找到应用事件: " + evtType + " | 监控开关**已开启**, 但该事件无记录 | 实测分界: ①**主进程族会入库** —— app_startup_cmdline / app_startup_request_context_ready / app_startup_child_process(已实测可查)与 app_extension_*(运行期扩展生命周期); ②**渲染族不会入库** —— app_render_* / app_v8_* / app_render_ws_* 由渲染进程(FBroSubprocess.exe)触发, 不派发到主进程覆盖 | 若你查的是渲染族, 请用替代: 页面侧事实用浏览器事件族(load_*/title_changed/url_changed/frame_* 已验证有效) + browser_execute_js / browser_console_* / browser_network; 主进程侧等价能力用 CDP 类工具(Emulation.* / Page.addScriptToEvaluateOnNewDocument / Debugger.setPauseOnExceptions)"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "未找到应用事件: " + evtType + " | 相关监控开关未开启, 请先 browser_collect action=event_app_enable(总闸) 或本族开关 action=event_startup_enable(启动族)/action=event_extension_enable(扩展族) | 注意: 启动族开关当前**默认已开**, 若仍无记录说明该事件本次进程未触发"))
                }
                // 浏览器事件: 需要浏览器ID → 查询 SQLite event_log
                变量 evtBrowser <类型 = 类_FBrowser_浏览器>
                evtBrowser = MCP命令服务器.取主浏览器 ()
                如果 (evtBrowser.是否为空 () == 假)
                {
                    变量 evtResult <类型 = 文本型>
                    变量 evt查询BID <类型 = 整数>
                    evt查询BID = evtBrowser.取ID ()
                    // crash 事件跨浏览器查询: 崩溃的浏览器已被移出数组(或重建后ID变化),
                    // 按当前主浏览器ID过滤将查不到历史崩溃记录 (渲染意外终止写入的crash事件在崩溃浏览器ID下)
                    如果 (evtType == "crash")
                    {
                        evt查询BID = 0
                    }
                    evtResult = MCP命令服务器.查询事件日志 ("browser_event", evtType, evt查询BID, evtLimit)
                    如果 (evtResult != "[]")
                    {
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, evtResult))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "未找到事件: " + evtType + " | 支持: load_start/load_end/load_error/crash/navigate/popup/popup_failed/loading_state_change/url_changed/browser_created/browser_closing/do_close/title_changed/load_progress/resource_*/js_dialog/before_unload/file_dialog/fullscreen/favicon/find_result/frame_*/download_*/key_press/focus_* | 菜单/快捷菜单/导航意图/界面细节: context_menu*/quick_menu*/nav_intent*/ui_* | 插件/启动/渲染/WS: app_extension_*/app_startup_*/app_render_*/app_render_ws_* | 权限/离屏: permission_*/offscreen_* | 应用事件: app_* | 族名可用通配(如 resource_*)"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "需要event_type参数 | 浏览器事件: load_end/crash/... 应用事件: app_xxx"))
        }
        否则 (方法名 == "browser_cdp_event")
        {
            变量 eventName <类型 = 文本型>
            eventName = MCP命令服务器.yyjson取文本 (参数JSON, "event_name")
            如果 (eventName == "")
            {
                eventName = MCP命令服务器.yyjson取文本 (参数JSON, "event")
            }
            如果 (eventName != "")
            {
                // 优先读 async 缓存 (CDP 事件不再写 event_log, 防 SQLite 膨胀)
                变量 eventKey <类型 = 文本型>
                eventKey = "cdp_event:" + eventName
                变量 eventResult <类型 = 文本型>
                eventResult = MCP命令服务器.查询异步结果 (eventKey)
                如果 (eventResult == "")
                {
                    eventResult = MCP命令服务器.查询任务结果 (eventKey)
                }
                如果 (eventResult != "")
                {
                    如果 (eventName == "Debugger.paused")
                    {
                        变量 摘要2 <类型 = 文本型>
                        摘要2 = MCP命令服务器.解析Debugger暂停摘要 (eventResult)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"event\":\"" + MCP_响应构建.JSON转义文本 (eventName) + "\",\"raw\":" + eventResult + ",\"paused\":" + 摘要2 + "}"))
                    }
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, eventResult))
                }
                变量 legacyLog <类型 = 文本型>
                legacyLog = MCP命令服务器.查询事件日志 ("cdp_event", eventName, 0, 1)
                如果 (legacyLog != "[]" && legacyLog != "" && MCP命令服务器.是否以 (legacyLog, "["))
                {
                    变量 内层JSON <类型 = 文本型>
                    // 0-based语义: 去掉首尾的[ ], 内容从索引1起 len-2 个字符
                    内层JSON = 取文本中间 (legacyLog, 1, 取文本长度 (legacyLog) - 2)
                    如果 (eventName == "Debugger.paused")
                    {
                        变量 摘要 <类型 = 文本型>
                        摘要 = MCP命令服务器.解析Debugger暂停摘要 (内层JSON)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"event\":\"" + MCP_响应构建.JSON转义文本 (eventName) + "\",\"raw\":" + 内层JSON + ",\"paused\":" + 摘要 + "}"))
                    }
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 内层JSON))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "未找到CDP事件: " + eventName + " | 请先 debugger_enable，命中断点后会写入 async 缓存"))
            }
            // 无指定则返回通用的异步存储结果
            返回 (MCP_响应构建.命令失败 (命令ID, "指定 event_name 或 event 参数，例如 Debugger.paused"))
        }
        // === 旧版别名兼容 (CDP命令) ===
        否则 (方法名 == "browser_cdp")
        {
            变量 cdpMethod <类型 = 文本型>
            cdpMethod = MCP命令服务器.yyjson取文本 (参数JSON, "method")
            如果 (cdpMethod != "")
            {
                返回 (MCP命令服务器.执行CDP命令 (命令ID, cdpMethod, 参数JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "CDP需要method参数, 例如: {method: \"Page.navigate\", params: \"{...}\"}"))
        }
        // === 网络抓包: 获取响应体 ===
        否则 (方法名 == "browser_network_body")
        {
            变量 requestId <类型 = 文本型>
            requestId = MCP命令服务器.yyjson取文本 (参数JSON, "request_id")
            变量 解析说明 <类型 = 文本型>
            解析说明 = ""
            如果 (requestId == "")
            {
                // 零前置: ①确保 Network 域与 Network.* 捕获都开着 ②按 url / 最新请求自动解析 requestId。
                // 为什么必须自动(实测+静态核实): 本工具原先**只能**收 request_id, 而项目里没有任何工具
                //   把 requestId 回传(browser_network list 是 CEF 层日志, 不含 CDP requestId), 调用方只能
                //   手工订阅 + 抓事件 + 手抄, 还要尽快调用否则响应体被回收 —— 正是"反复换方法才成功"的来源。
                解析说明 = MCP命令服务器.确保网络CDP捕获 (命令ID)
                变量 目标URL <类型 = 文本型>
                目标URL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
                变量 等待上限 <类型 = 整数>
                等待上限 = MCP命令服务器.yyjson取整数 (参数JSON, "wait_ms")
                如果 (等待上限 <= 0)
                {
                    等待上限 = 2000
                }
                如果 (等待上限 > 15000)
                {
                    等待上限 = 15000
                }
                变量 等待截止 <类型 = 长整数>
                等待截止 = 取启动时间 () + 等待上限
                变量 解析JSON <类型 = 文本型>
                变量 命中URL <类型 = 文本型>
                变量 候选条数 <类型 = 整数>
                命中URL = ""
                候选条数 = 0
                循环判断首 ()
                {
                    解析JSON = MCP命令服务器.查找CDP请求ID (目标URL)
                    变量 解析对象 <类型 = YYJSON只读对象类>
                    如果 (解析对象.创建自文本 (解析JSON))
                    {
                        requestId = MCP命令服务器.yyjson取文本 (解析对象, "requestId")
                        命中URL = MCP命令服务器.yyjson取文本 (解析对象, "url")
                        候选条数 = MCP命令服务器.yyjson取整数 (解析对象, "count")
                    }
                    如果 (requestId != "")
                    {
                        跳出循环
                    }
                    // 只给了 url 时才等: 等的就是"这一条请求出现", 没给 url 时等下去没有意义
                    如果 (目标URL == "" || 取启动时间 () >= 等待截止)
                    {
                        跳出循环
                    }
                    MCP命令服务器.MCP可中断延时 (250)
                }
                循环判断尾 (真)
                如果 (requestId == "")
                {
                    变量 失败前缀 <类型 = 文本型>
                    失败前缀 = "未能在本会话的 CDP 捕获里解析到 requestId"
                    如果 (目标URL != "")
                    {
                        失败前缀 = 失败前缀 + "(按 url=" + 目标URL + " 未命中)"
                    }
                    失败前缀 = 失败前缀 + " | 本次捕获到的请求条数: " + 到文本 (候选条数)
                    如果 (解析说明 != "")
                    {
                        失败前缀 = 失败前缀 + " | 已自动补齐: " + 解析说明
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, 失败前缀 + " | 如实说明: 响应体只能对**本 CDP 会话内、捕获开启之后**发生的请求取回 —— 请重新加载页面(或重发该请求)后再调用本工具; 也可显式传 request_id(取自 browser_cdp_event event_name=Network.requestWillBeSent 或 browser_kernel_cdp_monitor action=list 的 events_json)"))
                }
                解析说明 = 解析说明 + "requestId 已自动解析(url=" + 命中URL + ", 捕获请求数=" + 到文本 (候选条数) + ")"
            }
            // 前置廉价校验(挡住明显畸形值, 避免拿畸形 id 去占 CDP 协议锁), 但**不假设具体格式**:
            // 本机实测 requestId 是 **32 位十六进制**(如 A6EE022756279359D6FE08AC76711D8D),
            // 而旧代码按"数字串(形如 1000012345.5)"硬判首字符 —— 于是把**合法** id 全部拒掉,
            // 且它给出的"如何取得有效值"路径拿到的正是被它拒绝的那个值(自相矛盾, 必然死循环)。
            // 约束: 只接受长度上限内且不含空白/双引号/花括号的取值, 因此两种书写格式都能通过。
            变量 格式非法 <类型 = 逻辑型>
            格式非法 = 假
            如果 (取文本长度 (requestId) > 64)
            {
                格式非法 = 真
            }
            如果 (寻找文本 (requestId, " ", 0, 假) != -1)
            {
                格式非法 = 真
            }
            如果 (寻找文本 (requestId, "\"", 0, 假) != -1)
            {
                格式非法 = 真
            }
            如果 (寻找文本 (requestId, "{", 0, 假) != -1 || 寻找文本 (requestId, "}", 0, 假) != -1)
            {
                格式非法 = 真
            }
            如果 (格式非法 == 真)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "非法 CDP request_id: " + requestId + " | 合法形态: 本机为 32 位十六进制(如 A6EE022756279359D6FE08AC76711D8D), 其它实现可能是数字串(如 1000012345.5); 不能含空白/引号/花括号, 长度不超过 64 | 如何取得有效值: ① browser_kernel_cdp_monitor action=add methods=Network.* 订阅 ② browser_cdp_event event_name=Network.requestWillBeSent 取其中的 requestId ③ 尽快调用本工具(响应体可能被回收)"))
            }
            变量 bodyParams <类型 = YYJSON对象类>
            bodyParams.创建自文本 ("{}")
            bodyParams.加入文本成员 ("requestId", requestId)
            变量 body同步 <类型 = 文本型>
            body同步 = MCP命令服务器.执行CDP并同步等待 (命令ID, "Network.getResponseBody", bodyParams.到可读文本 (YYJSON格式化选项.压缩), 15000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (body同步) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "Network.getResponseBody 失败: " + MCP命令服务器.取CDP同步结果错误 (body同步) + " | 常见原因: 该请求的响应体已不在缓存中(要在请求发生后尽快取), 或 requestId 不属于当前页面 | 建议重新订阅并复现一次请求后立即取"))
            }
            变量 body体 <类型 = 文本型>
            body体 = MCP命令服务器.取CDP同步结果体文本 (body同步)
            变量 body内容 <类型 = 文本型>
            body内容 = ""
            变量 body是B64 <类型 = 逻辑型>
            body是B64 = 假
            如果 (body体 != "")
            {
                变量 body解析 <类型 = YYJSON只读对象类>
                如果 (body解析.创建自文本 (body体))
                {
                    body内容 = MCP命令服务器.yyjson取文本 (body解析, "body")
                    body是B64 = MCP命令服务器.yyjson取逻辑_默认 (body解析, "base64Encoded", 假)
                }
            }
            变量 body全长 <类型 = 整数>
            body全长 = 取文本长度 (body内容)
            变量 body上限 <类型 = 整数>
            body上限 = 200000
            变量 body已截 <类型 = 逻辑型>
            body已截 = 假
            如果 (body全长 > body上限)
            {
                body内容 = 取文本左边 (body内容, body上限)
                body已截 = 真
            }
            变量 body结果 <类型 = YYJSON对象类>
            body结果.创建自文本 ("{}")
            body结果.加入逻辑值成员 ("success", 真)
            body结果.加入文本成员 ("request_id", requestId)
            如果 (解析说明 != "")
            {
                body结果.加入文本成员 ("resolve_note", 解析说明)
            }
            body结果.加入逻辑值成员 ("base64_encoded", body是B64)
            body结果.加入整数成员 ("body_length", body全长)
            body结果.加入逻辑值成员 ("body_truncated", body已截)
            如果 (body是B64)
            {
                body结果.加入文本成员 ("body", body内容)
                body结果.加入文本成员 ("note", "body 为 base64 编码(该响应体是二进制或以二进制判定), 解码后才是原文; 可用 browser_base64_decode 解码")
            }
            否则
            {
                body结果.加入文本成员 ("body", body内容)
                body结果.加入文本成员 ("note", "body 为原文(未编码)")
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, body结果.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 断点调试: 暂停/继续 ===
        否则 (方法名 == "browser_debugger_pause")
        {
            // 安全设计: 裸发 Debugger.pause 在没有 JS 执行点的页面上**永不返回**, 且会堵塞 CDP 命令队列
            // (队列 FIFO —— 后续 CDP 命令与自动 resume 全排在它后面, 连锁超时, 连 browser_status 都可能挂)。
            // 故这里**不裸发** pause, 而是复用既有的 确保调试器已暂停: 先显式启用 Debugger 域 → 用页面自身的
            // setTimeout 安排一个 30ms 后**必然执行**的语句给 pause 一个落点 → 再 pause 并等 Debugger.paused
            // ⇒ "暂停"变成**有界**操作(失败会明确说明原因与替代, 不会静默堵住队列)。
            变量 暂停前已有 <类型 = 文本型>
            暂停前已有 = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
            MCP命令服务器.暂停前事件指纹 = 取文本左边 (暂停前已有, 200)
            如果 (暂停前已有 == "")
            {
                // 只在"由本次调用制造暂停"时武装防呆网(主循环 10 秒没等到暂停事件就自动 resume)
                MCP命令服务器.待恢复暂停时间 = 取启动时间 ()
            }
            如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法制造暂停点(已安排执行点 + Debugger.pause 并等待约6秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(about:blank/纯静态页) 或 CDP 通道不可用 | 替代: 先 browser_navigate 到有脚本的页面再暂停, 或用 browser_debugger_flow 一键断点"))
            }
            变量 暂停成功对象 <类型 = YYJSON对象类>
            暂停成功对象.创建自文本 ("{}")
            暂停成功对象.加入逻辑值成员 ("success", 真)
            暂停成功对象.加入文本成员 ("paused", "true")
            暂停成功对象.加入文本成员 ("note", "页面已暂停(暂停点=自动安排的30ms执行点或既有断点) | 看现场: browser_debugger_last_paused / browser_debugger_stack / browser_debugger_evaluate | 恢复: browser_debugger_resume (即使忘了恢复, 后续任意 CDP 工具都会自动 resume 并续等原请求, 不会把实例卡死)")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 暂停成功对象.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (方法名 == "browser_debugger_resume")
        {
            如果 (MCP命令服务器.取CDP事件数据JSON ("Debugger.paused") == "")
            {
                // ★ 改成幂等成功(原为失败): resume 是**清场/收尾**类工具, "本来就没暂停" 说明目标状态已达成,
                //   不是错误。若报失败会让调用方(尤其 AI)以为需要"先制造暂停再恢复" -> 无意义的多步调用,
                //   正是本目标要消灭的"反复换方法"。仍如实说明"未执行任何动作", 不谎报做过事。
                返回 (MCP_响应构建.命令成功 (命令ID, "页面本就未处于暂停状态, 无需恢复(幂等成功, 未执行任何动作)"))
            }
            变量 resume回执 <类型 = 文本型>
            resume回执 = MCP命令服务器.执行CDP命令 (命令ID, "Debugger.resume", 参数JSON)
            如果 (寻找文本 (resume回执, "Can only perform operation while paused", 0, 假) != -1 || 寻找文本 (resume回执, "not paused", 0, 假) != -1 || 寻找文本 (resume回执, "-32000", 0, 假) != -1)
            {
                // 陈旧暂停记录(页面其实已在运行): CDP 这句错误恰恰说明"无需恢复", 按幂等成功处理
                // 并清掉陈旧记录, 让后续 last_paused/单步工具看到真实状态(2025-09-13 全量扫测实测)。
                MCP命令服务器.清除CDP事件记录 ("Debugger.paused")
                返回 (MCP_响应构建.命令成功 (命令ID, "页面本就未处于暂停状态, 无需恢复(幂等成功; 已清除陈旧暂停记录)"))
            }
            如果 (resume回执 == "")
            {
                // CDP 无回执(通道恢复中/繁忙): 如实说明而不是返回空串落进回退链, 让其它分派器
                // 二次处理成误导性的裸 CDP 错误(2025-09-13 全量扫测实测的失败形态)。
                返回 (MCP_响应构建.命令失败 (命令ID, "Debugger.resume 无回执(CDP 通道恢复中或繁忙) | 页面状态未知: 用 browser_execute_js 验证页面是否可执行; 若仍在断点请稍后重试本工具"))
            }
            返回 (resume回执)
        }
        // === 断点调试: 单步执行 ===
        否则 (方法名 == "browser_debugger_step_over")
        {
            如果 (MCP命令服务器.断点注册表.取成员数 () == 0)
            {
                // 无断点可停: 单步没有检查点, 且实测 pause→step→resume 序列会毒化本会话 CDP 通道
                // (2025-09-13 全量扫测: step 后通道真坏, 活体短探连败被误判冷重启)。如实跳过实际单步。
                返回 (MCP_响应构建.命令成功 (命令ID, "本会话未设置任何断点, 单步没有可停靠的检查点, 已跳过实际单步(页面保持运行, 实例不受影响) | 要单步调试请先 browser_debugger_set_breakpoint 设断点, 或直接 browser_debugger_flow 一键断点流程"))
            }
            如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
            }
            变量 stepOver回执 <类型 = 文本型>
            stepOver回执 = MCP命令服务器.执行CDP命令 (命令ID, "Debugger.stepOver", 参数JSON)
            返回 (stepOver回执)
        }
        否则 (方法名 == "browser_debugger_step_into")
        {
            如果 (MCP命令服务器.断点注册表.取成员数 () == 0)
            {
                返回 (MCP_响应构建.命令成功 (命令ID, "本会话未设置任何断点, 单步没有可停靠的检查点, 已跳过实际单步(页面保持运行, 实例不受影响) | 要单步调试请先 browser_debugger_set_breakpoint 设断点, 或直接 browser_debugger_flow 一键断点流程"))
            }
            如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
            }
            变量 stepInto回执 <类型 = 文本型>
            stepInto回执 = MCP命令服务器.执行CDP命令 (命令ID, "Debugger.stepInto", 参数JSON)
            返回 (stepInto回执)
        }
        否则 (方法名 == "browser_debugger_step_out")
        {
            如果 (MCP命令服务器.断点注册表.取成员数 () == 0)
            {
                返回 (MCP_响应构建.命令成功 (命令ID, "本会话未设置任何断点, 单步没有可停靠的检查点, 已跳过实际单步(页面保持运行, 实例不受影响) | 要单步调试请先 browser_debugger_set_breakpoint 设断点, 或直接 browser_debugger_flow 一键断点流程"))
            }
            如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
            }
            变量 stepOut回执 <类型 = 文本型>
            stepOut回执 = MCP命令服务器.执行CDP命令 (命令ID, "Debugger.stepOut", 参数JSON)
            返回 (stepOut回执)
        }
        // === 断点设置: 按URL设置断点 ===
        否则 (方法名 == "browser_debugger_set_breakpoint")
        {
            变量 bpUrl <类型 = 文本型>
            bpUrl = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (bpUrl == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "url " + MCP_常量.错误_缺少参数))
            }
            变量 bpParams <类型 = YYJSON对象类>
            bpParams.创建自文本 ("{}")
            bpParams.加入文本成员 ("urlRegex", bpUrl)
            变量 bpLine <类型 = 整数>
            bpLine = MCP命令服务器.yyjson取整数 (参数JSON, "line")
            如果 (bpLine == 0)
            {
                bpLine = MCP命令服务器.yyjson取整数 (参数JSON, "line_number")
            }
            bpParams.加入整数成员 ("lineNumber", bpLine)
            变量 bpCol <类型 = 整数>
            bpCol = MCP命令服务器.yyjson取整数 (参数JSON, "column")
            如果 (bpCol == 0)
            {
                bpCol = MCP命令服务器.yyjson取整数 (参数JSON, "column_number")
            }
            变量 hasCol <类型 = 逻辑型 值 = 假>
            // column 可能是整数型: 取文本对数值成员返回空, 需同时按整数判断存在性
            // (显式 column:0 与省略等价, CDP 默认 columnNumber 即 0, 无行为差异)
            如果 (MCP命令服务器.yyjson取文本 (参数JSON, "column") != "" || MCP命令服务器.yyjson取文本 (参数JSON, "column_number") != "" || MCP命令服务器.yyjson取整数 (参数JSON, "column") != 0 || MCP命令服务器.yyjson取整数 (参数JSON, "column_number") != 0)
            {
                hasCol = 真
            }
            如果 (hasCol)
            {
                bpParams.加入整数成员 ("columnNumber", bpCol)
            }
            // 同步等待CDP响应, 解析breakpointId并记录断点注册表 (供 list/clear 管理)
            变量 bpRes <类型 = 文本型>
            bpRes = MCP命令服务器.执行CDP并同步等待 (命令ID, "Debugger.setBreakpointByUrl", bpParams.到可读文本 (YYJSON格式化选项.压缩), 12000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (bpRes))
            {
                变量 bpWrap <类型 = YYJSON只读对象类>
                如果 (bpWrap.创建自文本 (bpRes))
                {
                    变量 bpCdpText <类型 = 文本型>
                    bpCdpText = MCP命令服务器.yyjson取文本 (bpWrap, "result")
                    如果 (bpCdpText != "")
                    {
                        变量 bpCdp <类型 = YYJSON只读对象类>
                        如果 (bpCdp.创建自文本 (bpCdpText))
                        {
                            变量 bpId <类型 = 文本型>
                            bpId = MCP命令服务器.yyjson取文本 (bpCdp, "breakpointId")
                            // 记录注册表 (平行数组)
                            // 仅CDP返回有效断点ID时登记 (空ID条目clear永远漏删, 不登记)
                            如果 (bpId != "")
                            {
                                MCP命令服务器.断点注册表.加入成员 (bpUrl + "|" + 到文本 (bpLine))
                                MCP命令服务器.断点ID注册表.加入成员 (bpId)
                            }
                            控制台输出 ("[MCP] 断点已设置并记录: " + bpUrl + " 行 " + 到文本 (bpLine) + " id:" + bpId)
                        }
                    }
                }
                // 返回原始CDP结果 (含breakpointId/locations)
                变量 bpOut <类型 = YYJSON对象类>
                bpOut.创建自文本 ("{}")
                bpOut.加入逻辑值成员 ("success", 真)
                bpOut.加入文本成员 ("cdp_result", MCP命令服务器.yyjson取文本 (bpWrap, "result"))
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, bpOut.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "断点设置失败: " + MCP命令服务器.取CDP同步结果错误 (bpRes)))
        }
        // === 断点管理 ===
        否则 (方法名 == "browser_debugger_list_breakpoints")
        {
            // 返回断点注册表 (url|line 与 breakpointId 平行数组)
            变量 blOut <类型 = YYJSON对象类>
            blOut.创建自文本 ("{}")
            blOut.加入逻辑值成员 ("success", 真)
            blOut.加入整数成员 ("count", MCP命令服务器.断点注册表.取成员数 ())
            变量 blList <类型 = 文本型>
            blList = "["
            变量 blFirst <类型 = 逻辑型 值 = 真>
            计次循环 (MCP命令服务器.断点注册表.取成员数 ())
            {
                如果 (blFirst)
                {
                    blFirst = 假
                }
                否则
                {
                    blList = blList + ","
                }
                blList = blList + "{\"id\":" + 到文本 (取循环索引 ()) + ",\"location\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.断点注册表.取成员 (取循环索引 ())) + "\",\"cdp_id\":\"" + MCP_响应构建.JSON转义文本 (MCP命令服务器.断点ID注册表.取成员 (取循环索引 ())) + "\"}"
            }
            blList = blList + "]"
            blOut.加入文本成员 ("breakpoints", blList)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, blOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (方法名 == "browser_debugger_clear_breakpoints")
        {
            // 逐个移除CDP断点 (removeBreakpoint), 全部完成后清注册表
            变量 cbRemoved <类型 = 整数 值 = 0>
            变量 cbFailed <类型 = 整数 值 = 0>
            计次循环 (MCP命令服务器.断点ID注册表.取成员数 ())
            {
                变量 cbId <类型 = 文本型>
                cbId = MCP命令服务器.断点ID注册表.取成员 (取循环索引 ())
                如果 (cbId == "")
                {
                    到循环尾
                }
                变量 cbParams <类型 = YYJSON对象类>
                cbParams.创建自文本 ("{}")
                cbParams.加入文本成员 ("breakpointId", cbId)
                变量 cbRes <类型 = 文本型>
                cbRes = MCP命令服务器.执行CDP并同步等待 (命令ID + "_cb_" + 到文本 (取循环索引 ()), "Debugger.removeBreakpoint", cbParams.到可读文本 (YYJSON格式化选项.压缩), 8000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (cbRes))
                {
                    cbRemoved = cbRemoved + 1
                }
                否则
                {
                    cbFailed = cbFailed + 1
                }
            }
            判断循环 (MCP命令服务器.断点注册表.取成员数 () > 0)
            {
                MCP命令服务器.断点注册表.删除成员 (0)
            }
            判断循环 (MCP命令服务器.断点ID注册表.取成员数 () > 0)
            {
                MCP命令服务器.断点ID注册表.删除成员 (0)
            }
            变量 cbOut <类型 = YYJSON对象类>
            cbOut.创建自文本 ("{}")
            cbOut.加入逻辑值成员 ("success", 真)
            cbOut.加入整数成员 ("removed", cbRemoved)
            cbOut.加入整数成员 ("failed", cbFailed)
            cbOut.加入文本成员 ("note", "若页面仍暂停请 debugger_resume; 未成功移除的断点在页面刷新后消失")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, cbOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 调用栈 ===
        否则 (方法名 == "browser_debugger_stack")
        {
            如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已启用调试器域 + 安排执行点 + Debugger.pause 并等待6秒仍未收到 Debugger.paused) | 可能原因: CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
            }
            // 参数语义: Debugger.getStackTrace 要的不是**工具自身的 MCP 参数** —— CDP 该方法
            // 需要的是 `stackTraceId`(来自**错误对象**上的 stackTrace, 由 Runtime.exceptionThrown 给出),
            // 与"当前暂停点的调用栈"不是一回事 —— 于是只要调用方没传 stackTraceId 就必然报
            // "Failed to deserialize params.stackTraceId: mandatory field missing"(该缺陷此前被
            // "页面未处于暂停状态"的前置守卫挡在前面, 一直没暴露)。
            // 正确做法: 当前暂停栈从 Debugger.paused 事件的 callFrames 取(复用既有 解析Debugger暂停摘要);
            // 只有调用方**显式**给了 stack_trace_id 时才转发给 CDP 的 getStackTrace(保留原能力)。
            变量 stId <类型 = 文本型>
            stId = MCP命令服务器.yyjson取文本 (参数JSON, "stack_trace_id")
            如果 (stId != "")
            {
                返回 (MCP命令服务器.执行CDP命令 (命令ID, "Debugger.getStackTrace", 参数JSON))
            }
            变量 stPaused <类型 = 文本型>
            stPaused = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
            如果 (stPaused == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "已进入暂停态但取不到 Debugger.paused 事件 | 请重试, 或改用 browser_debugger_last_paused"))
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.解析Debugger暂停摘要 (stPaused)))
        }
        // === 断点处查看变量 ===
        否则 (方法名 == "browser_debugger_evaluate")
        {
            变量 frameId <类型 = 文本型>
            frameId = MCP命令服务器.yyjson取文本 (参数JSON, "call_frame_id")
            变量 expr <类型 = 文本型>
            expr = MCP命令服务器.yyjson取文本 (参数JSON, "expression")
            如果 (expr == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "expression " + MCP_常量.错误_缺少参数))
            }
            如果 (frameId == "")
            {
                // ★ 零前置(与 browser_debugger_inspect 同源逻辑): 未给帧ID 时自动取"当前活帧" ——
                //   已暂停则直接复用, 未暂停则先制造暂停点(经 auto_prepared 如实上报),
                //   再从最近一次 Debugger.paused 读 call_frame_id。
                //   缺帧 ID 时不能直接失败("call_frame_id和expression 参数不能为空"):
                //   而 AI 调用方最自然的用法就是"给个表达式让我看看" —— 于是第一次调用必失败。
                如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未给 call_frame_id 且无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 可行动: browser_debugger_wait_paused / browser_debugger_last_paused 取帧后立即重试, 或用 browser_debugger_inspect"))
                }
                变量 rawEvPaused <类型 = 文本型>
                rawEvPaused = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
                如果 (rawEvPaused != "")
                {
                    变量 evPauseSummary <类型 = 文本型>
                    evPauseSummary = MCP命令服务器.解析Debugger暂停摘要 (rawEvPaused)
                    变量 evPauseObj <类型 = YYJSON只读对象类>
                    如果 (evPauseObj.创建自文本 (evPauseSummary))
                    {
                        frameId = MCP命令服务器.yyjson取文本 (evPauseObj, "call_frame_id")
                    }
                }
            }
            如果 (frameId == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "无法取得活帧 call_frame_id | 可行动: browser_debugger_wait_paused 或 browser_debugger_last_paused 取帧后立即重试"))
            }
            如果 (MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "parse", 假))
            {
                变量 expandEv <类型 = 逻辑型>
                expandEv = MCP命令服务器.取Debugger求值展开 (参数JSON)
                变量 rbvEv <类型 = 逻辑型>
                rbvEv = MCP命令服务器.取Debugger求值ReturnByValue (参数JSON)
                变量 evRaw <类型 = 文本型>
                evRaw = MCP命令服务器.执行Debugger帧求值并等待 (命令ID, frameId, expr, 12000, rbvEv)
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.解析Debugger求值结果 (evRaw, 命令ID, frameId, expr, expandEv)))
            }
            变量 evParams <类型 = YYJSON对象类>
            evParams.创建自文本 ("{}")
            evParams.加入文本成员 ("callFrameId", frameId)
            evParams.加入文本成员 ("expression", expr)
            如果 (MCP命令服务器.取Debugger求值ReturnByValue (参数JSON))
            {
                evParams.加入逻辑值成员 ("returnByValue", 真)
            }
            返回 (MCP命令服务器.执行CDP命令_带参数 (命令ID, "Debugger.evaluateOnCallFrame", evParams.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 断点调试: 等待暂停 / 最近暂停 / 批量帧内求值 ===
        否则 (方法名 == "browser_debugger_wait_paused")
        {
            变量 maxMs <类型 = 整数>
            maxMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_ms")
            如果 (maxMs == 0)
            {
                maxMs = 30000
            }
            变量 清除旧 <类型 = 逻辑型>
            // 这里曾用 `参数键存在 && yyjson取逻辑` 绕过"缺键不回落到默认值"的缺陷; 该缺陷已在
            // 读取器本身修掉(见 `MCP命令服务器.yyjson取逻辑_默认` 顶部注释与本次事故记录),
            // 故直接调用读取器 —— 同一逻辑只保留一份实现, 不留两个真相。
            清除旧 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "fresh", 假)
            变量 rawPaused <类型 = 文本型>
            rawPaused = MCP命令服务器.等待CDP事件 ("Debugger.paused", maxMs, 清除旧)
            如果 (rawPaused == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "等待 Debugger.paused 超时(" + 到文本 (maxMs) + "ms) | 流程: debugger_enable → set_breakpoint → navigate"))
            }
            变量 摘要文本 <类型 = 文本型>
            摘要文本 = MCP命令服务器.解析Debugger暂停摘要 (rawPaused)
            变量 摘要对象 <类型 = YYJSON只读对象类>
            如果 (摘要对象.创建自文本 (摘要文本) == 假 || MCP命令服务器.yyjson取文本 (摘要对象, "call_frame_id") == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "Debugger.paused 事件无效或缺少 call_frame_id | 请检查 debugger_enable 与断点 URL"))
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 摘要文本))
        }
        否则 (方法名 == "browser_debugger_last_paused")
        {
            变量 rawLast <类型 = 文本型>
            rawLast = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
            如果 (rawLast == "")
            {
                // 零前置: 没有暂停事件时自动制造一个, 再重取(而不是让调用方先去编排断点)
                如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
                }
                rawLast = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
            }
            变量 摘要最后 <类型 = 文本型>
            摘要最后 = MCP命令服务器.解析Debugger暂停摘要 (rawLast)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 摘要最后))
        }
        否则 (方法名 == "browser_debugger_inspect")
        {
            变量 frameId2 <类型 = 文本型>
            frameId2 = MCP命令服务器.yyjson取文本 (参数JSON, "call_frame_id")
            如果 (frameId2 == "")
            {
                // 零前置: 未给帧ID 且页面未暂停时, 先自动制造暂停点(已暂停则立即返回真)
                如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
                }
                变量 rawInspect <类型 = 文本型>
                rawInspect = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
                如果 (rawInspect != "")
                {
                    变量 暂停摘要 <类型 = 文本型>
                    暂停摘要 = MCP命令服务器.解析Debugger暂停摘要 (rawInspect)
                    变量 暂停解析 <类型 = YYJSON只读对象类>
                    如果 (暂停解析.创建自文本 (暂停摘要))
                    {
                        frameId2 = MCP命令服务器.yyjson取文本 (暂停解析, "call_frame_id")
                    }
                }
            }
            如果 (frameId2 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "缺少 call_frame_id | 请先 browser_debugger_wait_paused 或 browser_debugger_last_paused"))
            }
            变量 exprRaw <类型 = 文本型>
            exprRaw = MCP命令服务器.取Debugger表达式Raw文本 (参数JSON)
            如果 (exprRaw == "")
            {
                exprRaw = "typeof location!=='undefined'?location.href:'(no location)'"
            }
            变量 expandInsp <类型 = 逻辑型>
            expandInsp = MCP命令服务器.取Debugger求值展开 (参数JSON)
            变量 rbvInsp <类型 = 逻辑型>
            rbvInsp = MCP命令服务器.取Debugger求值ReturnByValue (参数JSON)
            变量 evalOut <类型 = 文本型>
            evalOut = MCP命令服务器.Debugger帧内批量求值JSON (命令ID, frameId2, exprRaw, expandInsp, rbvInsp)
            变量 exprCount <类型 = 整数 值 = 0>
            变量 evalObj <类型 = YYJSON只读数组类>
            evalObj = MCP命令服务器.取JSON数组自文本 (evalOut, "items")
            如果 (evalObj.是否为空对象 () == 假)
            {
                exprCount = (整数)evalObj.取成员数 ()
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"call_frame_id\":\"" + MCP_响应构建.JSON转义文本 (frameId2) + "\",\"count\":" + 到文本 (exprCount) + ",\"evaluations\":" + evalOut + "}"))
        }
        否则 (方法名 == "browser_debugger_flow")
        {
            变量 flowBp <类型 = 文本型>
            flowBp = MCP命令服务器.yyjson取文本 (参数JSON, "breakpoint")
            如果 (flowBp == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "breakpoint 不能为空 | URL正则, 如: example\\.com/main\\.js | 无参调用不会进入断点流程"))
            }
            // 自愈: 反检测Debugger禁用与断点冲突, 自动恢复防止渲染进程illegal instruction崩溃
            MCP命令服务器.确保Debugger可用 (MCP命令服务器.取主浏览器 ())
            变量 flowJSON <类型 = 文本型>
            flowJSON = MCP命令服务器.执行Debugger断点流程JSON (命令ID, 参数JSON)
            如果 (flowJSON == "" || MCP命令服务器.是否以 (flowJSON, "{\"ok\":false"))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "debugger_flow 失败: " + flowJSON))
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, flowJSON))
        }
        否则 (方法名 == "browser_debugger_script_source")
        {
            // 无暂停上下文时快速返回, 防CDP调用挂起堵塞队列
            变量 srcCtx <类型 = 文本型>
            srcCtx = MCP命令服务器.取CDP事件数据JSON ("Debugger.paused")
            变量 srcCtx2 <类型 = 文本型>
            srcCtx2 = MCP命令服务器.yyjson取文本 (参数JSON, "script_id")
            如果 (srcCtx == "" && srcCtx2 == "")
            {
                // 零前置: 既未暂停又没给 script_id 时, 先自动制造暂停点再继续
                // (给了 script_id 的调用方无需暂停, 故不动那条路径)
                如果 (MCP命令服务器.确保调试器已暂停 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法自动制造暂停点(已安排执行点 + Debugger.pause 并等待5秒仍未收到 Debugger.paused) | 可能原因: 页面没有可执行的JS(纯静态页/about:blank) 或 CDP 通道不可用 | 替代: browser_debugger_flow 一键断点流程"))
                }
            }
            变量 srcJSON <类型 = 文本型>
            srcJSON = MCP命令服务器.执行Debugger脚本源JSON (命令ID, 参数JSON)
            如果 (srcJSON == "" || MCP命令服务器.是否以 (srcJSON, "{\"ok\":false"))
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "debugger_script_source 失败: " + srcJSON))
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, srcJSON))
        }
        // === 自动断点求值: 断点命中→自动执行JS→自动resume→循环 (持续监控模式) ===
        否则 (方法名 == "browser_debugger_auto")
        {
            变量 autoBpUrl <类型 = 文本型>
            autoBpUrl = MCP命令服务器.yyjson取文本 (参数JSON, "breakpoint")
            如果 (autoBpUrl == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "breakpoint 不能为空 | URL正则, 如: example\\\\.com/main\\\\.js"))
            }
            变量 autoMaxHits <类型 = 整数>
            autoMaxHits = MCP命令服务器.yyjson取整数 (参数JSON, "max_hits")
            如果 (autoMaxHits <= 0)
            {
                autoMaxHits = 5
            }
            如果 (autoMaxHits > 100)
            {
                autoMaxHits = 100
            }
            变量 autoExprRaw <类型 = 文本型>
            autoExprRaw = MCP命令服务器.yyjson取文本 (参数JSON, "expressions")
            如果 (autoExprRaw == "")
            {
                autoExprRaw = "[\"location.href\"]"
            }
            变量 autoMaxMs <类型 = 整数>
            autoMaxMs = MCP命令服务器.yyjson取整数 (参数JSON, "max_ms")
            如果 (autoMaxMs == 0)
            {
                // 原默认 60000ms/次: 远超常见客户端耐心(实测台账客户端 15s 就放弃),
                // 结果是"客户端超时 + 服务端还在等" —— 调用方只会看到一次次失败。
                // 压到 12000ms: 让服务端**在客户端放弃之前**给出明确结论(命中或诚实的失败)。
                // 需要更久可显式传 max_ms。
                autoMaxMs = 12000
            }
            变量 autoNavUrl <类型 = 文本型>
            autoNavUrl = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            // 步骤1: 启用调试器
            MCP命令服务器.确保Debugger已恢复 (命令ID + "_pre")
            变量 autoEnRaw <类型 = 文本型>
            autoEnRaw = MCP命令服务器.执行CDP并同步等待 (命令ID + "_en", "Debugger.enable", "{}", 15000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (autoEnRaw) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "Debugger.enable 失败"))
            }
            MCP命令服务器.MCP可中断延时 (300)
            // 步骤2: 设置断点
            变量 autoBpParams <类型 = YYJSON对象类>
            autoBpParams.创建自文本 ("{}")
            autoBpParams.加入文本成员 ("urlRegex", autoBpUrl)
            变量 autoLine <类型 = 整数>
            autoLine = MCP命令服务器.yyjson取整数 (参数JSON, "line")
            autoBpParams.加入整数成员 ("lineNumber", autoLine)
            MCP命令服务器.清除CDP事件记录 ("Debugger.paused")
            变量 autoBpRaw <类型 = 文本型>
            autoBpRaw = MCP命令服务器.执行CDP并同步等待 (命令ID + "_bp", "Debugger.setBreakpointByUrl", autoBpParams.到可读文本 (YYJSON格式化选项.压缩), 15000)
            如果 (MCP命令服务器.CDP设置断点结果是否成功 (autoBpRaw) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "断点设置失败: " + MCP命令服务器.取CDP同步结果错误 (autoBpRaw)))
            }
            // 记录"下断当时是否 0 位置"作为**诊断信息**, 但**不据此提前失败**。
            // ★ 实测依据(为什么不能提前失败): 本页所有已注册脚本的 url 都是空串(8/8), 于是任何
            //   urlRegex 都得到 locations:[]; 而 0 位置**不等于**永远不可能命中 —— 之后若有带真实
            //   URL 的脚本加载(真实站点外部脚本/SPA 动态加载), urlRegex 会在那时重新解析并命中。
            //   提前失败会把这种合法等待误判成失败, 反而制造"失败 + 反复换方法"。
            //   故这里只置标志, 由 0 命中时的失败信息附带说明(信息保留, 不越权结束等待)。
            变量 autoBp零命中 <类型 = 逻辑型 值 = 假>
            autoBp零命中 = MCP命令服务器.CDP断点是否零命中 (autoBpRaw)
            // 步骤3: 导航 (可选)
            如果 (autoNavUrl != "")
            {
                如果 (MCP命令服务器.验证URL安全 (autoNavUrl) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "URL 不安全: " + autoNavUrl))
                }
                变量 autoBrowser <类型 = 类_FBrowser_浏览器>
                autoBrowser = MCP命令服务器.取主浏览器 ()
                如果 (autoBrowser.是否为空 () == 假)
                {
                    变量 autoNavFrame <类型 = 类_FBrowser_框架>
                    autoNavFrame = MCP命令服务器.取安全主框架 (autoBrowser)
                    如果 (autoNavFrame.是否为空 () == 假 && autoNavFrame.是否有效 ())
                    {
                        autoNavFrame.载入地址 (autoNavUrl)
                        MCP命令服务器.MCP可中断延时 (1000)
                    }
                }
            }
            // 步骤4: 循环等待断点→自动求值→自动resume
            变量 autoHits <类型 = 整数 值 = 0>
            变量 autoResults <类型 = 文本数组类>
            变量 auto停止原因 <类型 = 文本型>
            auto停止原因 = "未知(循环提前结束)"
            判断循环 (autoHits < autoMaxHits)
            {
                如果 (MCP命令服务器.MCP正在关闭 || MCP_编排分派.工作流应停止)
                {
                    auto停止原因 = "服务正在关闭或工作流已请求停止"
                    跳出循环
                }
                MCP命令服务器.清除CDP事件记录 ("Debugger.paused")
                变量 autoPausedRaw <类型 = 文本型>
                autoPausedRaw = MCP命令服务器.等待CDP事件 ("Debugger.paused", autoMaxMs, 假)
                如果 (autoPausedRaw == "")
                {
                    auto停止原因 = "等待 Debugger.paused 超时(" + 到文本 (autoMaxMs) + "ms): 该窗口内页面未执行到断点位置"
                    跳出循环
                }
                autoHits = autoHits + 1
                变量 autoSummary <类型 = 文本型>
                autoSummary = MCP命令服务器.解析Debugger暂停摘要 (autoPausedRaw)
                变量 autoObj <类型 = YYJSON只读对象类>
                变量 autoFrameId <类型 = 文本型>
                autoFrameId = ""
                如果 (autoObj.创建自文本 (autoSummary))
                {
                    autoFrameId = MCP命令服务器.yyjson取文本 (autoObj, "call_frame_id")
                }
                如果 (autoFrameId == "")
                {
                    autoFrameId = MCP命令服务器.提取JSON文本字段值 (autoSummary, "call_frame_id")
                }
                变量 autoEvalOut <类型 = 文本型>
                autoEvalOut = "[]"
                如果 (autoFrameId != "")
                {
                    autoEvalOut = MCP命令服务器.Debugger帧内批量求值JSON (命令ID + "_ah" + 到文本 (autoHits), autoFrameId, autoExprRaw, 真, 真)
                }
                MCP命令服务器.DebuggerFlow尝试Resume (命令ID + "_ar" + 到文本 (autoHits))
                变量 autoHitResult <类型 = YYJSON对象类>
                autoHitResult.创建自文本 ("{}")
                autoHitResult.加入整数成员 ("hit", autoHits)
                autoHitResult.加入文本成员 ("frame_id", autoFrameId)
                autoHitResult.加入文本成员 ("evaluations", autoEvalOut)
                autoHitResult.加入文本成员 ("paused", autoSummary)
                autoResults.加入成员 (autoHitResult.到可读文本 (YYJSON格式化选项.压缩))
            }
            MCP命令服务器.确保Debugger已恢复 (命令ID + "_done")
            如果 (autoHits >= autoMaxHits)
            {
                auto停止原因 = "已达最大命中数(" + 到文本 (autoMaxHits) + ")"
            }
            //   也会返回 success:true, hits:0, 调用方会据此以为断点链路是好的。
            如果 (autoHits == 0)
            {
                变量 auto零命中说明 <类型 = 文本型>
                如果 (autoBp零命中)
                {
                    auto零命中说明 = " | 注: 下断当时该 urlRegex 匹配到 0 个脚本位置(locations 为空) —— 若之后有带真实 URL 的脚本加载仍可能命中, 可传 url 让本工具导航触发, 或显式传更大的 max_ms 继续等"
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "未捕获到任何断点命中(0 hits) | 停止原因: " + auto停止原因 + auto零命中说明 + " | 常见原因: ①断点此刻未匹配到脚本位置 ②等待窗口内页面没有执行到该代码 ③未传 url 且当前页面本就不会触发该代码 | 可行动: 用 browser_reverse_get_possible_breakpoints 查可下断行列; 或用 browser_debugger_flow 并传 url 触发; 或显式传更大的 max_ms"))
            }
            变量 auto汇总 <类型 = YYJSON对象类>
            auto汇总.创建自文本 ("{}")
            auto汇总.加入逻辑值成员 ("success", 真)
            auto汇总.加入逻辑值成员 ("completed", autoHits >= autoMaxHits)
            auto汇总.加入整数成员 ("hits", autoHits)
            auto汇总.加入文本成员 ("stop_reason", auto停止原因)
            auto汇总.加入文本成员 ("breakpoint", autoBpUrl)
            auto汇总.加入文本成员 ("results", MCP_编排分派.步骤JSON片段列表到数组文本 (autoResults))
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, auto汇总.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 启用调试器(开始断点调试前必须调用) ===
        否则 (方法名 == "browser_debugger_enable")
        {
            // 自愈: 同上
            MCP命令服务器.确保Debugger可用 (MCP命令服务器.取主浏览器 ())
            返回 (MCP命令服务器.执行CDP命令 (命令ID, "Debugger.enable", 参数JSON))
        }
        // === Base64编码/解码 (FBrowser官方API) ===
        否则 (方法名 == "browser_base64_encode")
        {
            变量 data <类型 = 文本型>
            data = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (data == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            变量 result <类型 = 文本型>
            result = FBrowser_Parser_Base64编码 (data)
            返回 (MCP_响应构建.构建简单JSON ("base64", result))
        }
        否则 (方法名 == "browser_base64_decode")
        {
            变量 data <类型 = 文本型>
            data = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (data == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            变量 字节结果 <类型 = 类_FBrowser_字节集>
            字节结果 = FBrowser_Parser_Base64解码 (data)
            如果 (字节结果.是否为空 () == 假)
            {
                变量 解码后文本 <类型 = 文本型>
                解码后文本 = 字节结果.取文本 ()
                返回 (MCP_响应构建.构建简单JSON ("decoded", 解码后文本))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "Base64解码失败"))
        }
        // === URI编码/解码 (FBrowser官方API) ===
        否则 (方法名 == "browser_uri_encode")
        {
            变量 data <类型 = 文本型>
            data = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (data == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            // use_plus: 类库注释 "If |use_plus| is true spaces will change to \"+\"" —— 表单语义
            变量 usePlus <类型 = 逻辑型>
            usePlus = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "use_plus", 假)
            变量 result <类型 = 文本型>
            result = FBrowser_Parser_URI编码 (data, usePlus)
            返回 (MCP_响应构建.构建简单JSON ("encoded", result))
        }
        否则 (方法名 == "browser_uri_decode")
        {
            变量 data <类型 = 文本型>
            data = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (data == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            变量 toUtf8 <类型 = 逻辑型>
            toUtf8 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "to_utf8", 真)
            // 类库第三参声明为**逻辑型**(注释却说它是 "URI保留规则" 位标识), 只能给两档。四种组合实测:
            //   真 -> 只还原非 ASCII("%E4%B8%AD%E6%96%87"->中文), %20/%26/%3D 原样返回;
            //   假 -> 什么都不还原(更差)。故默认取 真(类库原始行为), 不制造回归。
            变量 keepEscaped <类型 = 逻辑型>
            keepEscaped = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "keep_escaped", 真)
            变量 result <类型 = 文本型>
            result = FBrowser_Parser_URI解码 (data, toUtf8, keepEscaped)
            变量 走页面兜底 <类型 = 逻辑型>
            走页面兜底 = 假
            // 类库解不开 ASCII 特殊字符的转义时, 用页面内 decodeURIComponent 补齐(一次调用完成)。
            如果 (MCP命令服务器.含百分号转义 (data) && MCP命令服务器.含百分号转义 (result))
            {
                变量 兜底浏览器 <类型 = 类_FBrowser_浏览器>
                兜底浏览器 = MCP命令服务器.取主浏览器 ()
                如果 (兜底浏览器.是否为空 () == 假 && 兜底浏览器.是否已关闭 () == 假)
                {
                    变量 兜底值 <类型 = 文本型>
                    兜底值 = MCP命令服务器.CDP执行JS并等待 ("(function(){try{return decodeURIComponent(\"" + MCP_响应构建.JSON转义文本 (data) + "\")}catch(e){return null}})()", 8000, 真)
                    如果 (兜底值 != "" && 兜底值 != "null" && MCP命令服务器.含百分号转义 (兜底值) == 假)
                    {
                        result = 兜底值
                        走页面兜底 = 真
                    }
                }
            }
            变量 uOut <类型 = YYJSON对象类>
            uOut.创建自文本 ("{}")
            uOut.加入文本成员 ("decoded", result)
            如果 (走页面兜底)
            {
                uOut.加入文本成员 ("via", "js:decodeURIComponent")
            }
            否则
            {
                uOut.加入文本成员 ("via", "lib:FBrowser_Parser_URI解码")
            }
            如果 (MCP命令服务器.含百分号转义 (result))
            {
                uOut.加入文本成员 ("warning", "结果里仍残留 %HH: 类库解码器在本机无法还原 ASCII 特殊字符的转义, 且当时无可用浏览器可走页面兜底; 可用 browser_execute_js code=decodeURIComponent(…), 或先 browser_navigate 建页后重试")
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, uOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === JSON 校验 / 规范化 / base64 入口 (零风险纯函数: 类库 FBrowser_Parser_解析JSON / 写入JSON / 字节值解析为JSON) ===
        // 为什么需要: 代理拿到的常是 JSON 文本, 却没有"这串是不是合法 JSON"的可信判据, 只能自己猜;
        //   而类库解析失败会返回 NULL(注释原文), 正好可以给出**确定的结论**。
        否则 (方法名 == "browser_json")
        {
            变量 jsAction <类型 = 文本型>
            jsAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (jsAction == "")
            {
                jsAction = "validate"
            }
            如果 (jsAction != "validate" && jsAction != "normalize" && jsAction != "from_base64")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + jsAction + " | 支持: validate(默认, 只给校验结论) / normalize(合法则回规范化JSON) / from_base64(data 是 base64 文本)"))
            }
            变量 jsData <类型 = 文本型>
            jsData = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (jsData == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            // options: 类库 JSON解析.RFC(0)=严格; JSON解析.允许逗号(1)=容忍尾逗号。
            // 实测口径: 本参数**同时**作用于解析与写出(类库共用同一个 options 位)。
            变量 jsOptions <类型 = 整数>
            jsOptions = JSON解析.RFC
            如果 (MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "allow_trailing_commas", 假))
            {
                jsOptions = JSON解析.允许逗号
            }
            变量 js值 <类型 = 类_FBrowser_值>
            变量 js来源 <类型 = 文本型>
            js来源 = "text"
            如果 (jsAction == "from_base64")
            {
                // base64 → 字节集 → JSON: 走类库的字节入口, 不先把字节猜成某种编码再解析
                变量 jsBytes <类型 = 类_FBrowser_字节集>
                jsBytes = FBrowser_Parser_Base64解码 (jsData)
                如果 (jsBytes.是否为空 ())
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "base64 解码失败(空字节集): 请检查 data 是否为合法 base64 | 实测: 类库 字节值解析为JSON 对空字节值直接返回空值类, 故先判空"))
                }
                js值 = FBrowser_Parser_字节值解析为JSON (jsBytes, jsOptions)
                js来源 = "base64"
            }
            否则
            {
                js值 = FBrowser_Parser_解析JSON (jsData, jsOptions)
            }
            变量 js合法 <类型 = 逻辑型>
            js合法 = js值.是否为空 () == 假
            如果 (jsAction == "validate")
            {
                // validate 是**校验结论**: 非法输入也回 success(工具确实完成了校验), 用 valid=false 表达结果
                变量 jsOut <类型 = YYJSON对象类>
                jsOut.创建自文本 ("{}")
                jsOut.加入逻辑值成员 ("success", 真)
                jsOut.加入逻辑值成员 ("valid", js合法)
                jsOut.加入文本成员 ("input", js来源)
                jsOut.加入整数成员 ("input_length", 取文本长度 (jsData))
                jsOut.加入整数成员 ("options_used", jsOptions)
                如果 (js合法)
                {
                    变量 js类型值 <类型 = 整数>
                    js类型值 = js值.取类型 ()
                    jsOut.加入整数成员 ("value_type", js类型值)
                    jsOut.加入文本成员 ("value_type_name", MCP命令服务器.JSON值类型名 (js类型值))
                    变量 js规范化 <类型 = 文本型>
                    js规范化 = FBrowser_Parser_写入JSON (js值, jsOptions)
                    jsOut.加入整数成员 ("normalized_length", 取文本长度 (js规范化))
                }
                否则
                {
                    jsOut.加入文本成员 ("note", "不是合法 JSON —— 这是**校验结论**, 不是工具故障 | 常见原因: 尾逗号(可传 allow_trailing_commas:true) / 单引号 / 未加引号的键名 / 注释 / 截断 | 类库原文: 解析失败返回 NULL(本项目据此判定)")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, jsOut.到可读文本 (YYJSON格式化选项.压缩)))
            }
            如果 (js合法 == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, jsAction + " 需要合法 JSON, 但解析失败(input=" + js来源 + ", 长度=" + 到文本 (取文本长度 (jsData)) + ") | 先用 action=validate 拿到校验结论; 若是尾逗号请传 allow_trailing_commas:true; 若是二进制请改用 action=from_base64"))
            }
            变量 js规范化2 <类型 = 文本型>
            js规范化2 = FBrowser_Parser_写入JSON (js值, jsOptions)
            变量 jsOut2 <类型 = YYJSON对象类>
            jsOut2.创建自文本 ("{}")
            jsOut2.加入逻辑值成员 ("success", 真)
            jsOut2.加入逻辑值成员 ("valid", 真)
            jsOut2.加入文本成员 ("input", js来源)
            jsOut2.加入整数成员 ("value_type", js值.取类型 ())
            jsOut2.加入文本成员 ("value_type_name", MCP命令服务器.JSON值类型名 (js值.取类型 ()))
            jsOut2.加入文本成员 ("normalized", js规范化2)
            jsOut2.加入整数成员 ("options_used", jsOptions)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, jsOut2.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === data URI 构造(类库 FBrowser_Parser_取数据URI) ===
        否则 (方法名 == "browser_data_uri")
        {
            变量 duMime <类型 = 文本型>
            duMime = MCP命令服务器.yyjson取文本 (参数JSON, "mime")
            如果 (duMime == "")
            {
                duMime = "text/plain"
            }
            变量 duData <类型 = 文本型>
            duData = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (duData == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数 + " | 用 browser_data_uri 可直接得到可内联的 data: URI(本地图片/绕过 CSP 取图/构造内联资源的最短路径)"))
            }
            变量 du结果 <类型 = 文本型>
            du结果 = FBrowser_Parser_取数据URI (duMime, duData)
            如果 (du结果 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "类库未返回 data URI(输入为空或 mime 非法): mime=" + duMime))
            }
            变量 duOut <类型 = YYJSON对象类>
            duOut.创建自文本 ("{}")
            duOut.加入逻辑值成员 ("success", 真)
            duOut.加入文本成员 ("mime", duMime)
            duOut.加入整数成员 ("data_length", 取文本长度 (duData))
            duOut.加入整数成员 ("uri_length", 取文本长度 (du结果))
            duOut.加入文本成员 ("data_uri", du结果)
            duOut.加入文本成员 ("note", "data URI 长度约为输入文本的 4/3(含 base64 与前缀); MCP 的 HTTP 通道在参数/回包约 1MB 处会被断连且无错误码 —— 超大资源请改用 browser_kernel_scheme(mcp:// 方案)或落盘后用 file 参数")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, duOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 按序号取浏览器(类库 FBrowser_浏览器_通过序号取浏览器) ===
        否则 (方法名 == "browser_by_index")
        {
            变量 biIndex <类型 = 整数>
            biIndex = MCP命令服务器.yyjson取整数 (参数JSON, "index")
            如果 (biIndex < 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "index 必须 >= 0(从0开始) | 用 browser_list 看当前全部浏览器"))
            }
            变量 biBrowser <类型 = 类_FBrowser_浏览器>
            biBrowser = FBrowser_浏览器_通过序号取浏览器 (biIndex)
            如果 (biBrowser.是否为空 () || biBrowser.是否已关闭 ())
            {
                // 类库注释原文: 获取失败将返回一个空浏览器, 注意判断 —— 故这里如实失败, 绝不回 success
                变量 bi数量 <类型 = 整数>
                bi数量 = FBrowser_浏览器_取数量 ()
                返回 (MCP_响应构建.命令失败 (命令ID, "序号 " + 到文本 (biIndex) + " 没有对应浏览器(当前共 " + 到文本 (bi数量) + " 个) | index 从 0 开始; 用 browser_list 看全部(它按 ID 清单枚举, **顺序不保证与序号一致**) | 想按 ID/标签/窗口句柄定位: browser_cdp_call? 不必 —— 用 browser_find_by_tag / browser_find_by_hwnd / browser_list"))
            }
            变量 biOut <类型 = YYJSON对象类>
            biOut.创建自文本 ("{}")
            biOut.加入逻辑值成员 ("success", 真)
            biOut.加入整数成员 ("index", biIndex)
            biOut.加入整数成员 ("browser_id", biBrowser.取ID ())
            biOut.加入逻辑值成员 ("is_popup", biBrowser.是否为弹窗 ())
            变量 bi框架 <类型 = 类_FBrowser_框架>
            bi框架 = MCP命令服务器.取安全主框架 (biBrowser)
            如果 (bi框架.是否为空 () == 假)
            {
                biOut.加入文本成员 ("url", bi框架.取地址 ())
            }
            变量 bi清单 <类型 = 类_FBrowser_列表值>
            bi清单 = FBrowser_浏览器_取ID清单 ()
            如果 (bi清单.是否为空 () == 假)
            {
                变量 biID串 <类型 = 文本型>
                biID串 = ""
                计次循环 (bi清单.取大小 ())
                {
                    如果 (取循环索引 () > 0)
                    {
                        biID串 = biID串 + ","
                    }
                    biID串 = biID串 + 到文本 (bi清单.取整数值 (取循环索引 ()))
                }
                biOut.加入文本成员 ("id_list_in_order", biID串)
            }
            biOut.加入文本成员 ("note", "序号来自类库内置浏览器清单(与 browser_list 的 ID 清单**不保证同序**); 需要稳定引用请用返回的 browser_id")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, biOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 按ID取浏览器(类库 FBrowser_浏览器_通过ID取浏览器): 交叉核对确认的真缺口 ===
        // 与 browser_by_index 同族; 增量价值: 探测某 id 是否仍存活 / 把 id 映射为详情, 且不受公共
        // browser_id 解析的"数组由事件异步回填"窗口期影响。
        否则 (方法名 == "browser_by_id")
        {
            变量 biID <类型 = 整数>
            biID = MCP命令服务器.yyjson取整数 (参数JSON, "browser_id")
            如果 (biID <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "browser_id 必须 > 0 | 用 browser_list 看当前全部浏览器 ID"))
            }
            变量 biById <类型 = 类_FBrowser_浏览器>
            biById = FBrowser_浏览器_通过ID取浏览器 (biID)
            如果 (biById.是否为空 () || biById.是否已关闭 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "browser_id=" + 到文本 (biID) + " 不存在或已关闭 | 类库原文: 获取失败返回空浏览器, 注意判断 —— 本工具如实失败 | 用 browser_list 看存活清单"))
            }
            变量 biOut2 <类型 = YYJSON对象类>
            biOut2.创建自文本 ("{}")
            biOut2.加入逻辑值成员 ("success", 真)
            biOut2.加入整数成员 ("browser_id", biById.取ID ())
            biOut2.加入逻辑值成员 ("is_popup", biById.是否为弹窗 ())
            biOut2.加入逻辑值成员 ("is_closed", biById.是否已关闭 ())
            biOut2.加入长整数成员 ("hwnd", biById.取窗口句柄 ())
            biOut2.加入文本成员 ("tag", biById.取用户标识 ())
            变量 bi框架2 <类型 = 类_FBrowser_框架>
            bi框架2 = MCP命令服务器.取安全主框架 (biById)
            如果 (bi框架2.是否为空 () == 假)
            {
                biOut2.加入文本成员 ("url", bi框架2.取地址 ())
            }
            biOut2.加入文本成员 ("note", "把 browser_id 映射为详情, 不是选择后续操作目标(后续操作仍用公共参数 browser_id)")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, biOut2.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 取浏览器数量(类库 FBrowser_浏览器_取数量): 交叉核对确认的真缺口(此前只作为字段埋在别的回包里) ===
        否则 (方法名 == "browser_count")
        {
            变量 bc数量 <类型 = 整数>
            bc数量 = FBrowser_浏览器_取数量 ()
            变量 bc清单 <类型 = 类_FBrowser_列表值>
            bc清单 = FBrowser_浏览器_取ID清单 ()
            变量 bcID串 <类型 = 文本型>
            bcID串 = ""
            如果 (bc清单.是否为空 () == 假)
            {
                计次循环 (bc清单.取大小 ())
                {
                    如果 (取循环索引 () > 0)
                    {
                        bcID串 = bcID串 + ","
                    }
                    bcID串 = bcID串 + 到文本 (bc清单.取整数值 (取循环索引 ()))
                }
            }
            变量 bcOut <类型 = YYJSON对象类>
            bcOut.创建自文本 ("{}")
            bcOut.加入逻辑值成员 ("success", 真)
            bcOut.加入整数成员 ("count", bc数量)
            bcOut.加入文本成员 ("id_list", bcID串)
            bcOut.加入文本成员 ("note", "count 与 id_list 来自两个独立类库出口(取数量/取ID清单), 在创建/关闭瞬间可能短暂不一致; 详情用 browser_list")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, bcOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 零前置编解码: hex / UTF-8 / GBK多字节 (全部走 视窗基本类 已有函数, 零新模块) ===
        // 陷阱1: 文本到UTF8 / 文本到多字节 的第二参"是否包括结束零字符"【默认为真】, 会在结果尾部多一个零字节,
        //        本分支一律显式传 假 (项目既有调用点亦如此), 并把这一点写进工具描述。
        // 陷阱2: 类库对 hex 输出的【大小写】、sFromHexStr 对奇数长度与非hex字符的行为, 原文均未载明,
        //        故本分支自己做: 偶数长度校验 + 逐字符合法性校验 + 统一归一化成大写送库 + 回验字节数 + 按 uppercase 归一化输出。
        // 陷阱3: UTF8到文本 / 多字节到文本 按 C 字符串构造(遇内嵌 0x00 截断); 工具描述里如实声明, 二进制出口走 hex/base64。
        否则 (方法名 == "browser_codec")
        {
            变量 codec动作 <类型 = 文本型>
            codec动作 = ""
            如果 (MCP命令服务器.参数键存在 (参数JSON, "action"))
            {
                codec动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            }
            如果 (codec动作 != "hex_encode" && codec动作 != "hex_decode" && codec动作 != "utf8_encode" && codec动作 != "utf8_decode" && codec动作 != "gbk_encode" && codec动作 != "gbk_decode")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 必填且只能是: hex_encode | hex_decode | utf8_encode | utf8_decode | gbk_encode | gbk_decode | 实际: " + codec动作))
            }
            变量 codec数据 <类型 = 文本型>
            codec数据 = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (codec数据 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data " + MCP_常量.错误_缺少参数))
            }
            变量 codec输入 <类型 = 文本型>
            codec输入 = "text"
            如果 (MCP命令服务器.参数键存在 (参数JSON, "input"))
            {
                codec输入 = MCP命令服务器.yyjson取文本 (参数JSON, "input")
            }
            变量 codec输出 <类型 = 文本型>
            codec输出 = ""
            如果 (MCP命令服务器.参数键存在 (参数JSON, "output"))
            {
                codec输出 = MCP命令服务器.yyjson取文本 (参数JSON, "output")
            }
            变量 codec大写 <类型 = 逻辑型>
            codec大写 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "uppercase", 假)
            变量 codec允许空格 <类型 = 逻辑型>
            codec允许空格 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "allow_spaces", 真)
            变量 codec是编码 <类型 = 逻辑型>
            codec是编码 = 假
            如果 (codec动作 == "hex_encode" || codec动作 == "utf8_encode" || codec动作 == "gbk_encode")
            {
                codec是编码 = 真
            }
            变量 codec是GBK <类型 = 逻辑型>
            codec是GBK = 假
            如果 (codec动作 == "gbk_encode" || codec动作 == "gbk_decode")
            {
                codec是GBK = 真
            }
            变量 codec字节 <类型 = 字节集类>
            变量 codec实际字节数 <类型 = 整数>
            codec实际字节数 = 0
            如果 (codec是编码)
            {
                // 编码方向也要认 `input`(schema 原文: data怎么读: text/hex/base64)。
                // 此前这里一律按文本取字节, 于是 `hex_encode input=base64 data="qw=="` 得到的是
                // ASCII "qw==" 的十六进制(71773d3d), 而不是解码后单字节 0xAB 的 "ab" —— 故必须按 input 取字节。
                如果 (codec输入 == "base64")
                {
                    变量 codec编码B64 <类型 = 类_FBrowser_字节集>
                    codec编码B64 = FBrowser_Parser_Base64解码 (codec数据)
                    如果 (codec编码B64.是否为空 ())
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "base64 解码失败: 输入不是合法 base64 文本"))
                    }
                    codec字节 = codec编码B64.取字节集 ()
                }
                否则 (codec输入 == "hex")
                {
                    变量 codec编码清洗 <类型 = 文本型>
                    codec编码清洗 = 删全部空 (codec数据)
                    如果 (取文本长度 (codec编码清洗) == 0 || 取文本长度 (codec编码清洗) % 2 != 0)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 输入必须是非空偶数长度的十六进制文本(每字节两位)"))
                    }
                    codec字节 = 十六进制文本到字节集 (codec编码清洗)
                }
                否则
                {
                    // 文本入: 目标字符集由 action 决定
                    如果 (codec是GBK)
                    {
                        codec字节 = 文本到多字节 (codec数据, 假)
                    }
                    否则
                    {
                        codec字节 = 文本到UTF8 (codec数据, 假)
                    }
                }
            }
            否则
            {
                // 解码方向: data 是"字节的文本表示", 必须显式给 input
                如果 (codec输入 == "hex")
                {
                    变量 codec清洗 <类型 = 文本型>
                    codec清洗 = 删全部空 (codec数据)
                    如果 (codec允许空格 == 假 && codec清洗 != codec数据)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 输入含空白字符(空格/Tab/换行), 但 allow_spaces=false; 如需忽略空白请传 allow_spaces=true"))
                    }
                    变量 codec位数 <类型 = 整数>
                    codec位数 = 取文本长度 (codec清洗)
                    如果 (codec位数 == 0)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 输入为空(去掉空白后没有任何字符)"))
                    }
                    如果 (codec位数 % 2 != 0)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 长度必须为偶数(每字节两位十六进制), 实际 " + 到文本 (codec位数) + " 位 | 类库对奇数长度的行为未载明, 故工具层直接拒绝而非猜测"))
                    }
                    变量 codec上表 <类型 = 文本型>
                    codec上表 = "0123456789ABCDEF"
                    变量 codec下表 <类型 = 文本型>
                    codec下表 = "0123456789abcdef"
                    变量 codec规范 <类型 = 文本型>
                    codec规范 = ""
                    变量 codec非法 <类型 = 文本型>
                    codec非法 = ""
                    变量 codec位 <类型 = 整数>
                    codec位 = 0
                    变量 codec单元 <类型 = 文本型>
                    codec单元 = ""
                    变量 codec命中 <类型 = 整数>
                    codec命中 = 0
                    判断循环 (codec位 < codec位数)
                    {
                        codec单元 = 取文本中间 (codec清洗, codec位, 1)
                        codec命中 = 寻找文本 (codec上表, codec单元, 0, 假)
                        如果 (codec命中 >= 0)
                        {
                            codec规范 = codec规范 + 取文本中间 (codec上表, codec命中, 1)
                        }
                        否则
                        {
                            codec命中 = 寻找文本 (codec下表, codec单元, 0, 假)
                            如果 (codec命中 >= 0)
                            {
                                codec规范 = codec规范 + 取文本中间 (codec上表, codec命中, 1)
                            }
                            否则
                            {
                                codec非法 = codec单元
                                跳出循环
                            }
                        }
                        codec位 = codec位 + 1
                    }
                    如果 (codec非法 != "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 输入含非法字符: " + codec非法 + " (位置 " + 到文本 (codec位) + ", 0起) | 只接受 0-9 与 A-F/a-f(可带空格与换行)"))
                    }
                    codec字节 = 十六进制文本到字节集 (codec规范)
                    codec实际字节数 = 取字节集长度 (codec字节)
                    变量 codec期望字节数 <类型 = 整数>
                    codec期望字节数 = codec位数 / 2
                    如果 (codec实际字节数 != codec期望字节数)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "hex 解码字节数异常: 期望 " + 到文本 (codec期望字节数) + " 字节, 实际 " + 到文本 (codec实际字节数) + " 字节 | 类库 CVolMem::sFromHexStr 对异常输入的行为未载明, 原样上报以便实测判定"))
                    }
                }
                否则 (codec输入 == "base64")
                {
                    变量 codecB64 <类型 = 类_FBrowser_字节集>
                    codecB64 = FBrowser_Parser_Base64解码 (codec数据)
                    如果 (codecB64.是否为空 ())
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "base64 解码失败: 输入不是合法 base64 文本"))
                    }
                    codec字节 = codecB64.取字节集 ()
                }
                否则 (codec输入 == "text")
                {
                    // 文本入: 按 action 的字符集取字节(便于"文本到另一种编码的字节"直接自检)
                    如果 (codec是GBK)
                    {
                        codec字节 = 文本到多字节 (codec数据, 假)
                    }
                    否则
                    {
                        codec字节 = 文本到UTF8 (codec数据, 假)
                    }
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "input 只能是 text | hex | base64, 实际: " + codec输入))
                }
            }
            变量 codec结果 <类型 = 文本型>
            codec结果 = ""
            变量 codec结果hex <类型 = 文本型>
            codec结果hex = ""
            如果 (codec是编码)
            {
                如果 (codec输出 == "" || codec输出 == "hex")
                {
                    codec结果hex = 字节集到十六进制文本 (codec字节)
                    如果 (codec大写)
                    {
                        codec结果 = 到大写 (codec结果hex)
                    }
                    否则
                    {
                        codec结果 = 到小写 (codec结果hex)
                    }
                }
                否则 (codec输出 == "base64")
                {
                    codec结果 = 字节集到BASE64文本 (codec字节, , -1)
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "编码方向(hex_encode/utf8_encode/gbk_encode)的 output 只能是 hex | base64 | 实际: " + codec输出 + " | 要拿文本请用对应的 _decode 动作"))
                }
            }
            否则
            {
                如果 (codec输出 == "" || codec输出 == "text")
                {
                    如果 (codec是GBK)
                    {
                        codec结果 = 多字节到文本 (codec字节)
                    }
                    否则
                    {
                        codec结果 = UTF8到文本 (codec字节)
                    }
                }
                否则 (codec输出 == "hex")
                {
                    codec结果hex = 字节集到十六进制文本 (codec字节)
                    如果 (codec大写)
                    {
                        codec结果 = 到大写 (codec结果hex)
                    }
                    否则
                    {
                        codec结果 = 到小写 (codec结果hex)
                    }
                }
                否则 (codec输出 == "base64")
                {
                    codec结果 = 字节集到BASE64文本 (codec字节, , -1)
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "解码方向的 output 只能是 text | hex | base64 | 实际: " + codec输出))
                }
            }
            变量 codec字符集 <类型 = 文本型>
            codec字符集 = "utf8"
            如果 (codec是GBK)
            {
                codec字符集 = "gbk"
            }
            codec实际字节数 = 取字节集长度 (codec字节)
            变量 codec回包 <类型 = YYJSON对象类>
            codec回包.创建自文本 ("{}")
            codec回包.加入逻辑值成员 ("success", 真)
            codec回包.加入文本成员 ("action", codec动作)
            codec回包.加入文本成员 ("charset", codec字符集)
            codec回包.加入文本成员 ("input", codec输入)
            codec回包.加入文本成员 ("output", codec结果)
            codec回包.加入整数成员 ("bytes", codec实际字节数)
            codec回包.加入整数成员 ("chars", 取文本长度 (codec结果))
            codec回包.加入文本成员 ("note", "hex 输出默认小写(uppercase=true 切大写); 文本出口按 action 的字符集解释(utf8 或 gbk); 文本出口按类库C字符串语义构造, 遇内嵌零字节会截断, 二进制请用 output=hex 或 output=base64")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, codec回包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 时间戳换算与格式化: 全部走 视窗基本类 时间操作类 (零前置) ===
        // 陷阱1: 取时间戳 返回【整数】(32位) —— 2038-01-19 03:14:07Z 之后溢出, 故越界入参直接报错, 且秒级值只在 1902..2037 年份区间内计算。
        // 陷阱2: 时间到文本 会"省略为 0 的时分秒"(午夜/整点退化成日期), 故只作 friendly 人读字段; 机器可解析一律用 时间到格式文本。
        // 陷阱3: 时间戳语义 = 真 UTC(类库按【当前】时区 Bias 补偿, UTC+8 时 Bias=-480), 不含历史/DST 偏移。
        // 陷阱4: 到时间 解析失败返回哨兵值 数值范围.最小日期时间值(100年1月1日), 必须用 为最小时间 判定, 不能与空文本混淆。
        否则 (方法名 == "browser_time_convert")
        {
            变量 时间有时间戳 <类型 = 逻辑型>
            时间有时间戳 = MCP命令服务器.参数键存在 (参数JSON, "timestamp")
            变量 时间有文本 <类型 = 逻辑型>
            时间有文本 = MCP命令服务器.参数键存在 (参数JSON, "time_text")
            变量 时间动作 <类型 = 文本型>
            时间动作 = ""
            如果 (MCP命令服务器.参数键存在 (参数JSON, "action"))
            {
                时间动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            }
            如果 (时间动作 == "")
            {
                // action 可省略: 按已给参数自动选(与 browser_reverse_runtime 的既有约定一致)
                如果 (时间有时间戳)
                {
                    时间动作 = "ts_to_text"
                }
                否则 (时间有文本)
                {
                    时间动作 = "text_to_ts"
                }
                否则
                {
                    时间动作 = "now"
                }
            }
            如果 (时间动作 != "now" && 时间动作 != "ts_to_text" && 时间动作 != "text_to_ts" && 时间动作 != "verify_tz")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 只能是 now | ts_to_text | text_to_ts | verify_tz (省略时按已给参数自动选) | 实际: " + 时间动作))
            }
            变量 时间单位 <类型 = 文本型>
            时间单位 = "s"
            如果 (MCP命令服务器.参数键存在 (参数JSON, "unit"))
            {
                时间单位 = MCP命令服务器.yyjson取文本 (参数JSON, "unit")
            }
            如果 (时间单位 != "s" && 时间单位 != "ms")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "unit 只能是 s(秒) | ms(毫秒) | 实际: " + 时间单位))
            }
            变量 时间格式 <类型 = 文本型>
            时间格式 = MCP命令服务器.yyjson取文本 (参数JSON, "format")
            如果 (时间格式 == "")
            {
                时间格式 = "%Y-%m-%d %H:%M:%S"
            }
            变量 时间值 <类型 = 小数>
            时间值 = 0
            变量 时间戳输入 <类型 = 长整数>
            时间戳输入 = 0
            如果 (时间动作 == "now")
            {
                时间值 = 取现行时间 ()
            }
            否则 (时间动作 == "verify_tz")
            {
                // 免文本解析的时区自检锚点: UTC+8 机器上 指定时间(1970,1,1,8,0,0) 的 取时间戳 必须是 0
                时间值 = 指定时间 (1970, 1, 1, 8, 0, 0)
            }
            否则 (时间动作 == "ts_to_text")
            {
                如果 (时间有时间戳 == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "ts_to_text 需要 timestamp 参数(整数时间戳; 毫秒请同时传 unit=ms)"))
                }
                时间戳输入 = MCP命令服务器.yyjson取长整数 (参数JSON, "timestamp")
                变量 秒上界 <类型 = 长整数>
                秒上界 = 2147483647
                变量 秒下界 <类型 = 长整数>
                秒下界 = 0 - 秒上界 - 1
                如果 (时间单位 == "ms")
                {
                    时间值 = 毫秒时间戳到时间 (时间戳输入)
                }
                否则
                {
                    如果 (时间戳输入 > 秒上界 || 时间戳输入 < 秒下界)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "秒级时间戳超出类库可表示范围: 上限 2147483647 = 2038-01-19 03:14:07Z(类库 取时间戳 返回 32 位整数, 再往后会溢出) | 收到 " + 到文本 (时间戳输入) + " | 若你手上的数是毫秒, 请改传 unit=ms"))
                    }
                    时间值 = 时间戳到时间 (时间戳输入)
                }
                如果 (为有效时间 (时间值) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "时间戳无法转换为有效时间(超出 数值范围.最小/最大日期时间值): " + 到文本 (时间戳输入)))
                }
            }
            否则
            {
                如果 (时间有文本 == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "text_to_ts 需要 time_text 参数(时间文本)"))
                }
                变量 时间文本 <类型 = 文本型>
                时间文本 = MCP命令服务器.yyjson取文本 (参数JSON, "time_text")
                如果 (时间文本 == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "time_text 为空 | 空串不会被静默当作 1970-01-01, 请给出真实时间文本"))
                }
                变量 时间中文格式 <类型 = 逻辑型>
                时间中文格式 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "chinese", 真)
                时间值 = 到时间 (时间文本, 时间中文格式)
                如果 (为最小时间 (时间值))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "无法解析时间文本(类库 到时间 返回哨兵值 数值范围.最小日期时间值 = 100年1月1日): " + 时间文本 + " | 中文格式例: 1973年11月15日12时30分25秒 / 1973-11-15 12:30:25 | 若为月日年顺序请传 chinese=false"))
                }
            }
            变量 时间年份 <类型 = 整数>
            时间年份 = 取年份 (时间值)
            变量 时间戳秒 <类型 = 整数>
            时间戳秒 = 0
            变量 时间戳毫秒 <类型 = 长整数>
            时间戳毫秒 = 0
            变量 时间安全区 <类型 = 逻辑型>
            时间安全区 = 假
            如果 (时间年份 >= 1902 && 时间年份 <= 2037)
            {
                时间安全区 = 真
            }
            如果 (时间安全区)
            {
                时间戳秒 = 取时间戳 (时间值)
                时间戳毫秒 = 取毫秒时间戳 (时间值)
            }
            如果 (时间动作 == "ts_to_text" && 时间单位 == "ms")
            {
                // 毫秒档: 原样回显入参, 避免安全区外回显 0 造成误解(安全区内二者本就一致)
                时间戳毫秒 = 时间戳输入
            }
            变量 时间偏移分 <类型 = 整数>
            时间偏移分 = 0
            如果 (时间安全区)
            {
                // 本地相对 UTC 的分钟数: 取时间戳 已含 -Bias*60 补偿, 与"朴素本地秒"相减即得偏移(UTC+8 = -480)
                时间偏移分 = (时间戳秒 - (整数)取时间间隔 (时间值, 25569, 时间字段类型.秒)) / 60
            }
            变量 时间回包 <类型 = YYJSON对象类>
            时间回包.创建自文本 ("{}")
            时间回包.加入逻辑值成员 ("success", 真)
            时间回包.加入文本成员 ("action", 时间动作)
            时间回包.加入文本成员 ("unit", 时间单位)
            时间回包.加入小数成员 ("ole", 时间值)
            时间回包.加入整数成员 ("year", 时间年份)
            时间回包.加入整数成员 ("timestamp_s", 时间戳秒)
            时间回包.加入长整数成员 ("timestamp_ms", 时间戳毫秒)
            时间回包.加入文本成员 ("local", 时间到格式文本 (时间值, 时间格式))
            时间回包.加入文本成员 ("friendly", 时间到文本 (时间值))
            时间回包.加入整数成员 ("tz_offset_minutes", 时间偏移分)
            时间回包.加入文本成员 ("format", 时间格式)
            如果 (时间安全区 == 假)
            {
                时间回包.加入文本成员 ("warning", "年份 " + 到文本 (时间年份) + " 超出 取时间戳 的 32 位整数安全区(1902..2037): 类库 取时间戳 返回整数, 2038-01-19 03:14:07Z 之后溢出, 故本次不给出秒级时间戳与 tz_offset_minutes")
            }
            时间回包.加入文本成员 ("note", "local 按机器本地时区渲染; tz_offset_minutes 是本地相对 UTC 的分钟数(UTC+8 = -480); timestamp_s/timestamp_ms 是真 UTC 值; friendly 会省略为0的时分秒, 只作人读")
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 时间回包.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 哈希/摘要 (仰望模块 加密解密库; 本机已实测头文件在册) ===
        否则 (方法名 == "browser_hash")
        {
            变量 hash动作 <类型 = 文本型>
            hash动作 = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (hash动作 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 不能省略 | 支持: md5(文本) / md5_file(文件) / xxhash(文本) / crc32(文本)"))
            }
            变量 hash大写 <类型 = 逻辑型>
            hash大写 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "uppercase", 假)
            变量 hash路径 <类型 = 文本型>
            hash路径 = MCP命令服务器.yyjson取文本 (参数JSON, "path")
            变量 hash数据 <类型 = 文本型>
            hash数据 = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            如果 (hash动作 == "md5_file")
            {
                如果 (hash路径 == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "md5_file 需要 path(文件完整路径)"))
                }
                如果 (文件是否存在 (hash路径) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "文件不存在: " + hash路径 + " | 说明: 类库读不到文件时会退化成空字节集, 从而静默返回空文件的 MD5, 故这里先拒绝"))
                }
                变量 hash文件摘要 <类型 = 文本型>
                hash文件摘要 = MD5类_.取数据摘要3_ (hash路径, hash大写 == 假)
                如果 (hash大写)
                {
                    hash文件摘要 = 到大写 (hash文件摘要)
                }
                变量 hash文件结果 <类型 = YYJSON对象类>
                hash文件结果.创建自文本 ("{}")
                hash文件结果.加入文本成员 ("action", "md5_file")
                hash文件结果.加入文本成员 ("md5", hash文件摘要)
                hash文件结果.加入文本成员 ("path", hash路径)
                hash文件结果.加入文本成员 ("algorithm", "MD5(流式, 支持大文件)")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, hash文件结果.到可读文本 (YYJSON格式化选项.压缩)))
            }
            如果 (hash数据 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "data 不能为空 | 空串摘要无意义(空文件 MD5 恒为 d41d8cd98f00b204e9800998ecf8427e), 如需请显式传一个空格"))
            }
            变量 hash字节 <类型 = 字节集类>
            hash字节 = 文本到UTF8 (hash数据, 假)
            变量 hash结果 <类型 = YYJSON对象类>
            hash结果.创建自文本 ("{}")
            hash结果.加入文本成员 ("action", hash动作)
            hash结果.加入整数成员 ("bytes", 取字节集长度 (hash字节))
            如果 (hash动作 == "md5")
            {
                变量 hash摘要 <类型 = 文本型>
                hash摘要 = MD5类_.取数据摘要_ (hash字节, hash大写 == 假)
                如果 (hash大写)
                {
                    hash摘要 = 到大写 (hash摘要)
                }
                hash结果.加入文本成员 ("md5", hash摘要)
                hash结果.加入文本成员 ("algorithm", "MD5")
            }
            否则 (hash动作 == "xxhash")
            {
                变量 hash摘要X <类型 = 文本型>
                hash摘要X = XxHash数据摘要类_.取数据摘要_XxHash_数据 (hash字节, -1, 0)
                如果 (hash大写)
                {
                    hash摘要X = 到大写 (hash摘要X)
                }
                hash结果.加入文本成员 ("xxhash", hash摘要X)
                hash结果.加入文本成员 ("algorithm", "XXH128")
            }
            否则 (hash动作 == "crc32")
            {
                // 类库返回 整数(int32): `crc32("123456789")` = -873187034, 而 CRC-32/ISO-HDLC 的标准校验值
                // 是 0xCBF43926 = 3421780262 —— 同一组 32 位, 但拿标准值对照会以为算错。故两种表示都给。
                变量 hashCRC <类型 = 整数>
                hashCRC = CRC校验类_.取数据摘要_CRC32 (hash字节, 0)
                变量 hashCRC无符 <类型 = 长整数>
                hashCRC无符 = hashCRC
                如果 (hashCRC < 0)
                {
                    hashCRC无符 = hashCRC无符 + 4294967296
                }
                hash结果.加入整数成员 ("crc32", hashCRC)
                hash结果.加入长整数成员 ("crc32_unsigned", hashCRC无符)
                hash结果.加入文本成员 ("algorithm", "CRC32 (标准校验值请用 crc32_unsigned: 123456789 -> 3421780262 / 0xCBF43926)")
            }
            否则
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + hash动作 + " | 支持: md5 / md5_file / xxhash / crc32"))
            }
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, hash结果.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 触摸事件 (CDP 派发优先; 内核注入为显式 opt-in) ===
        // 与鼠标三件套同源: 内核级输入注入会让 CDP 通道在本会话内永久失效(见 CDP派发鼠标事件 的实测结论),
        // 故缺省走 CDP Input.dispatchTouchEvent; kernel:true 才走 VIP 内核注入(过反爬场景)。
        否则 (方法名 == "browser_touch_press")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当作 (0,0) 而在页面左上角误触, 故拒绝执行; 如需触左上角请显式传 x=0 y=0"))
            }
            变量 touchX <类型 = 整数>
            touchX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
            变量 touchY <类型 = 整数>
            touchY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
            如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
            {
                如果 (MCP命令服务器.CDP派发触摸事件 ("touchStart", touchX, touchY))
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸按下 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | 经 CDP 派发(不破坏 CDP 会话) | 如需内核级注入请传 kernel:true"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发触摸") + " | 可用替代: browser_cdp_call method=Input.dispatchTouchEvent / browser_execute_js 派发 TouchEvent | 如仍要内核注入请显式传 kernel:true"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip <类型 = 类_FBrowserVIP_控制器>
                vip = browser.取VIP控制器 ()
                如果 (vip.是否为空 () == 假)
                {
                    vip.高级触摸_按下 (touchX, touchY)
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸按下 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | ⚠ 内核级触摸注入实测会使 CDP 通道在本会话内失效, 需重启进程恢复"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_touch_release")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当作 (0,0) 而在页面左上角误触, 故拒绝执行; 如需触左上角请显式传 x=0 y=0"))
            }
            变量 touchX <类型 = 整数>
            touchX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
            变量 touchY <类型 = 整数>
            touchY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
            如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
            {
                如果 (MCP命令服务器.CDP派发触摸事件 ("touchEnd", touchX, touchY))
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸放开 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | 经 CDP 派发(不破坏 CDP 会话)"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发触摸") + " | 可用替代: browser_cdp_call method=Input.dispatchTouchEvent | 如仍要内核注入请显式传 kernel:true"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip <类型 = 类_FBrowserVIP_控制器>
                vip = browser.取VIP控制器 ()
                如果 (vip.是否为空 () == 假)
                {
                    vip.高级触摸_放开 (touchX, touchY)
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸放开 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | ⚠ 内核级触摸注入实测会使 CDP 通道在本会话内失效, 需重启进程恢复"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_touch_move")
        {
            如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当作 (0,0) 而在页面左上角误触, 故拒绝执行; 如需触左上角请显式传 x=0 y=0"))
            }
            变量 touchX <类型 = 整数>
            touchX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
            变量 touchY <类型 = 整数>
            touchY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
            如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "kernel") == 假)
            {
                如果 (MCP命令服务器.CDP派发触摸事件 ("touchMove", touchX, touchY))
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸拖动 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | 经 CDP 派发(不破坏 CDP 会话)"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP命令服务器.CDPInput失败原因文本 ("CDP 派发触摸") + " | 可用替代: browser_cdp_call method=Input.dispatchTouchEvent | 如仍要内核注入请显式传 kernel:true"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip <类型 = 类_FBrowserVIP_控制器>
                vip = browser.取VIP控制器 ()
                如果 (vip.是否为空 () == 假)
                {
                    vip.高级触摸_移动 (touchX, touchY)
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸拖动 (" + 到文本 (touchX) + "," + 到文本 (touchY) + ") | ⚠ 内核级触摸注入实测会使 CDP 通道在本会话内失效, 需重启进程恢复"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 弹窗/文档信息 ===
        否则 (方法名 == "browser_popup_info")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 popup对象 <类型 = YYJSON对象类>
                popup对象.创建自文本 ("{}")
                popup对象.加入逻辑值成员 ("is_popup", browser.是否为弹窗 ())
                popup对象.加入逻辑值成员 ("has_document", browser.是否有文档 ())
                popup对象.加入逻辑值成员 ("is_loading", browser.是否读取中 ())
                popup对象.加入整数成员 ("id", browser.取ID ())
                变量 popupUrlFrame <类型 = 类_FBrowser_框架>
                popupUrlFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (popupUrlFrame.是否为空 () == 假)
                {
                    popup对象.加入文本成员 ("url", popupUrlFrame.取地址 ())
                }
                否则
                {
                    popup对象.加入文本成员 ("url", "")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, popup对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 窗口标题/句柄/父窗口 ===
        否则 (方法名 == "browser_window_info")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                变量 win对象 <类型 = YYJSON对象类>
                win对象.创建自文本 ("{}")
                win对象.加入文本成员 ("title", browser.取窗口标题 ())
                win对象.加入长整数成员 ("hwnd", browser.取窗口句柄 ())
                win对象.加入长整数成员 ("parent_hwnd", browser.取父窗口句柄 ())
                win对象.加入长整数成员 ("opener_hwnd", browser.取打开者窗口句柄 ())
                win对象.加入逻辑值成员 ("has_devtools", browser.是否存在开发者工具 ())
                win对象.加入逻辑值成员 ("is_devtools", browser.是否为开发者 ())
                win对象.加入文本成员 ("user_tag", browser.取用户标识 ())
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, win对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_move_window")
        {
            // ★ 契约(诚实性): 本工具**不能**恒失败, 也不得用"嵌入式GUI浏览器不支持…由主窗口自动管理"这类文案 ——
            //   该前提与代码事实不符 —— 本项目是控制台程序, 创建浏览器时 父窗口句柄=0(以桌面为父),
            //   用户看到的窗口就是浏览器窗口本身(src/main.wsv 的窗口信息段)。
            //   类库确有 移动窗口(左边,顶边,宽度,高度,是否重画) -> FBroHsBrowserHost_MoveWindow,
            //   且**不需要 HWND**(宿主经 CefBrowserHost 隐式定位窗口)。
            //   类库该方法**无返回值**, 故这里用 CDP Browser.getWindowForTarget 回读 bounds 做验证,
            //   回读不到就如实报 verified=false —— 不假装成功(本项目的核心不变量)。
            变量 mwBrowser <类型 = 类_FBrowser_浏览器>
            mwBrowser = MCP命令服务器.取主浏览器 ()
            如果 (mwBrowser.是否为空 () == 假 && mwBrowser.是否已关闭 () == 假)
            {
                变量 mwX <类型 = 整数>
                mwX = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                变量 mwY <类型 = 整数>
                mwY = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                变量 mwW <类型 = 整数>
                mwW = MCP命令服务器.yyjson取整数 (参数JSON, "width")
                变量 mwH <类型 = 整数>
                mwH = MCP命令服务器.yyjson取整数 (参数JSON, "height")
                变量 mwRepaint <类型 = 逻辑型>
                mwRepaint = MCP命令服务器.yyjson取逻辑 (参数JSON, "repaint")
                // 宽/高可省略 -> 保持当前尺寸: 先回读一次拿当前 bounds
                变量 mw前 <类型 = 文本型>
                mw前 = MCP命令服务器.执行CDP并同步等待 (命令ID + "_w0", "Browser.getWindowForTarget", "{}", 5000)
                变量 mw前体 <类型 = 文本型>
                mw前体 = MCP命令服务器.取CDP同步结果体文本 (mw前)
                变量 mw前色 <类型 = YYJSON只读对象类>
                如果 (mw前体 != "")
                {
                    变量 mw前JSON <类型 = YYJSON只读对象类>
                    如果 (mw前JSON.创建自文本 (mw前体))
                    {
                        mw前色 = MCP命令服务器.yyjson取对象成员_安全 (mw前JSON, "bounds")
                    }
                }
                如果 (mwW <= 0)
                {
                    mwW = MCP命令服务器.yyjson取整数 (mw前色, "width")
                }
                如果 (mwH <= 0)
                {
                    mwH = MCP命令服务器.yyjson取整数 (mw前色, "height")
                }
                // 类库签名: 移动窗口(左边, 顶边, 宽度, 高度, 是否重画)
                mwBrowser.移动窗口 (mwX, mwY, mwW, mwH, mwRepaint)
                // 回读验证(类库无返回值, 只能靠读回): 稍等渲染线程应用后再读
                MCP命令服务器.MCP可中断延时 (250)
                变量 mw后 <类型 = 文本型>
                mw后 = MCP命令服务器.执行CDP并同步等待 (命令ID + "_w1", "Browser.getWindowForTarget", "{}", 5000)
                变量 mw后体 <类型 = 文本型>
                mw后体 = MCP命令服务器.取CDP同步结果体文本 (mw后)
                变量 mw后色 <类型 = YYJSON只读对象类>
                如果 (mw后体 != "")
                {
                    变量 mw后JSON <类型 = YYJSON只读对象类>
                    如果 (mw后JSON.创建自文本 (mw后体))
                    {
                        mw后色 = MCP命令服务器.yyjson取对象成员_安全 (mw后JSON, "bounds")
                    }
                }
                变量 mw实左 <类型 = 整数>
                mw实左 = MCP命令服务器.yyjson取整数 (mw后色, "left")
                变量 mw实顶 <类型 = 整数>
                mw实顶 = MCP命令服务器.yyjson取整数 (mw后色, "top")
                变量 mw实宽 <类型 = 整数>
                mw实宽 = MCP命令服务器.yyjson取整数 (mw后色, "width")
                变量 mw实高 <类型 = 整数>
                mw实高 = MCP命令服务器.yyjson取整数 (mw后色, "height")
                变量 mw结果 <类型 = YYJSON对象类>
                mw结果.创建自文本 ("{}")
                mw结果.加入整数成员 ("requested_x", mwX)
                mw结果.加入整数成员 ("requested_y", mwY)
                mw结果.加入整数成员 ("requested_width", mwW)
                mw结果.加入整数成员 ("requested_height", mwH)
                mw结果.加入整数成员 ("actual_left", mw实左)
                mw结果.加入整数成员 ("actual_top", mw实顶)
                mw结果.加入整数成员 ("actual_width", mw实宽)
                mw结果.加入整数成员 ("actual_height", mw实高)
                变量 mw已验 <类型 = 逻辑型>
                mw已验 = mw实宽 > 0 && mw实宽 == mwW && mw实高 == mwH
                mw结果.加入逻辑值成员 ("verified", mw已验)
                如果 (mw已验)
                {
                    mw结果.加入文本成员 ("message", "窗口已移动并回读确认")
                }
                否则
                {
                    mw结果.加入文本成员 ("message", "已调用类库 移动窗口, 但回读未确认生效(可能被窗口管理器/宿主约束) | 请以 actual_* 为准 | 类库该方法无返回值, 故不谎报成功")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, mw结果.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 框架名称列表 (原生 API) ===
        否则 (方法名 == "browser_frame_names")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 name数组 <类型 = FBrowser_文本数组>
                name数组 = browser.取框架名称 ()
                变量 名称JSON <类型 = 文本型>
                名称JSON = "["
                变量 n首项 <类型 = 逻辑型 值 = 真>
                变量 n总数 <类型 = 整数>
                n总数 = name数组.取个数 ()
                计次循环 (n总数)
                {
                    如果 (n首项)
                    {
                        n首项 = 假
                    }
                    否则
                    {
                        名称JSON = 名称JSON + ","
                    }
                    名称JSON = 名称JSON + "\"" + MCP_响应构建.JSON转义文本 (name数组.取数据 (取循环索引 ())) + "\""
                }
                名称JSON = 名称JSON + "]"
                返回 (MCP_响应构建.构建命令嵌套JSON (命令ID, 真, "names", 名称JSON))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 按名称取框架信息 ===
        否则 (方法名 == "browser_frame_by_name")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 frameName <类型 = 文本型>
                frameName = MCP命令服务器.yyjson取文本 (参数JSON, "name")
                如果 (frameName == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "name " + MCP_常量.错误_缺少参数))
                }
                变量 frame <类型 = 类_FBrowser_框架>
                frame = browser.取框架_名称 (frameName)
                变量 f对象 <类型 = YYJSON对象类>
                f对象.创建自文本 ("{}")
                如果 (frame.是否为空 () == 假 && frame.是否有效 ())
                {
                    f对象.加入逻辑值成员 ("found", 真)
                    f对象.加入文本成员 ("url", frame.取地址 ())
                    f对象.加入文本成员 ("name", frameName)
                    f对象.加入逻辑值成员 ("is_main", frame.是否为主框架 ())
                    f对象.加入逻辑值成员 ("is_focused", frame.是否为焦点框架 ())
                    f对象.加入文本成员 ("frame_id", frame.取框架ID ())
                }
                否则
                {
                    f对象.加入逻辑值成员 ("found", 假)
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, f对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 按框架ID取框架信息(与 browser_frame_by_name 对称) ===
        // browser_get_frames 已经把 frame_id 交给调用方, 这里给出"按 ID 取回"的入口。
        // 类库注释警告: ID 错误会返回空类, 对空类执行操作会崩溃 —— 故先判空/判有效再取字段。
        否则 (方法名 == "browser_frame_by_id")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 frameId <类型 = 文本型>
                frameId = MCP命令服务器.yyjson取文本 (参数JSON, "frame_id")
                如果 (frameId == "")
                {
                    // browser_get_frames 回包里的字段名是 id(不是 frame_id), 这里兼容, 免得调用方还要猜
                    frameId = MCP命令服务器.yyjson取文本 (参数JSON, "id")
                }
                如果 (frameId == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "frame_id " + MCP_常量.错误_缺少参数 + " | 框架ID 取自 browser_get_frames 回包里的 id 字段(两处都接受 frame_id 与 id)"))
                }
                变量 frame <类型 = 类_FBrowser_框架>
                frame = browser.取框架_ID (frameId)
                变量 f对象 <类型 = YYJSON对象类>
                f对象.创建自文本 ("{}")
                如果 (frame.是否为空 () == 假 && frame.是否有效 ())
                {
                    f对象.加入逻辑值成员 ("found", 真)
                    f对象.加入文本成员 ("frame_id", frame.取框架ID ())
                    f对象.加入文本成员 ("url", frame.取地址 ())
                    f对象.加入逻辑值成员 ("is_main", frame.是否为主框架 ())
                    f对象.加入逻辑值成员 ("is_focused", frame.是否为焦点框架 ())
                }
                否则
                {
                    f对象.加入逻辑值成员 ("found", 假)
                    f对象.加入文本成员 ("frame_id", frameId)
                    f对象.加入文本成员 ("hint", "该 frame_id 不存在或框架已销毁(导航/刷新后 ID 会变): 请用 browser_get_frames 重新取")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, f对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 浏览器查找(按标识) ===
        否则 (方法名 == "browser_find_by_tag")
        {
            变量 tag <类型 = 文本型>
            tag = MCP命令服务器.yyjson取文本 (参数JSON, "tag")
            如果 (tag == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "tag " + MCP_常量.错误_缺少参数))
            }
            变量 found <类型 = 类_FBrowser_浏览器>
            found = FBrowser_浏览器_通过用户标识取浏览器 (tag)
            如果 (found.是否为空 () == 假 && found.是否已关闭 () == 假)
            {
                变量 info对象 <类型 = YYJSON对象类>
                info对象.创建自文本 ("{}")
                info对象.加入整数成员 ("id", found.取ID ())
                变量 tagUrlFrame <类型 = 类_FBrowser_框架>
                tagUrlFrame = MCP命令服务器.取安全主框架 (found)
                如果 (tagUrlFrame.是否为空 () == 假)
                {
                    info对象.加入文本成员 ("url", tagUrlFrame.取地址 ())
                }
                否则
                {
                    info对象.加入文本成员 ("url", "")
                }
                info对象.加入文本成员 ("tag", tag)
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, info对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未找到标识为: " + tag + " 的浏览器 | 设置方式: 用户标识**只能在创建浏览器时**指定(类库不支持运行期设置), 即 browser_create {url:…, tag:「你的标识」} | browser_user_tags 是**只读**的标识清单(旧文案说它「设置」标识, 与事实不符, 已更正) | 也可能该浏览器已关闭 | 可行动: 先 browser_user_tags 看现有标识, 或 browser_list 按 id 定位"))
        }
        // === 请求环境信息 ===
        否则 (方法名 == "browser_request_context")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 reqCtx <类型 = 类_FBrowser_请求环境>
                reqCtx = browser.取请求环境 ()
                变量 ctx对象 <类型 = YYJSON对象类>
                ctx对象.创建自文本 ("{}")
                如果 (reqCtx.是否为空 () == 假)
                {
                    ctx对象.加入逻辑值成员 ("has_context", 真)
                }
                否则
                {
                    ctx对象.加入逻辑值成员 ("has_context", 假)
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, ctx对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 资源加载信息 ===
        否则 (方法名 == "browser_loading_info")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 info对象 <类型 = YYJSON对象类>
                info对象.创建自文本 ("{}")
                info对象.加入逻辑值成员 ("is_loading", browser.是否读取中 ())
                info对象.加入逻辑值成员 ("can_go_back", browser.可否后退 ())
                info对象.加入逻辑值成员 ("can_go_forward", browser.可否前进 ())
                info对象.加入逻辑值成员 ("is_popup", browser.是否为弹窗 ())
                变量 loadingUrlFrame <类型 = 类_FBrowser_框架>
                loadingUrlFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (loadingUrlFrame.是否为空 () == 假)
                {
                    info对象.加入文本成员 ("url", loadingUrlFrame.取地址 ())
                }
                否则
                {
                    info对象.加入文本成员 ("url", "")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, info对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 批量操作 ===
        否则 (方法名 == "batch" || 方法名 == "browser_batch")
        {
            返回 (MCP命令服务器.处理_批量操作 (命令ID, 参数JSON))
        }
        // === 浏览器实例方法 ===
        否则 (方法名 == "browser_set_parent")
        {
            变量 hwnd <类型 = 变整数>
            hwnd = (变整数)MCP命令服务器.yyjson取长整数 (参数JSON, "hwnd")
            如果 (hwnd == 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "hwnd 不能为0 | 请提供有效的父窗口句柄"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                browser.置父窗口 (hwnd)
                返回 (MCP_响应构建.命令成功 (命令ID, "父窗口已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_get_window_title")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                返回 (MCP_响应构建.构建简单JSON ("title", browser.取窗口标题 ()))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_get_main_browser")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                变量 openerHWND <类型 = 变整数>
                openerHWND = browser.取打开者窗口句柄 ()
                返回 (MCP_响应构建.构建简单JSON ("opener_hwnd", 到文本 (openerHWND)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_is_same")
        {
            变量 otherID <类型 = 整数>
            otherID = MCP命令服务器.yyjson取整数 (参数JSON, "other_id")
            如果 (otherID <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "other_id 必须为正整数"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                变量 other <类型 = 类_FBrowser_浏览器>
                other = FBrowser_浏览器_通过ID取浏览器 (otherID)
                如果 (other.是否为空 () == 假 && other.是否已关闭 () == 假)
                {
                    返回 (MCP_响应构建.构建逻辑值JSON ("same", browser.是否相同 (other)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "other_id=" + 到文本 (otherID) + " 对应的浏览器不存在或已关闭"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_is_view")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                返回 (MCP_响应构建.构建逻辑值JSON ("is_view", browser.是否浏览器视图 ()))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 窗口管理 ===
        否则 (方法名 == "browser_show_window")
        {
            // ★ 补能力(能力面反查确认的真缺口): 类库 显示隐藏窗口(显示隐藏) -> FBroHsBrowserHost_ShowWindows。
            //   原"嵌入式GUI浏览器窗口由主窗口统一管理"的前提已被推翻(控制台程序, 父窗口句柄=0,
            //   用户看到的窗口就是浏览器窗口本身), 故该能力可做到。
            //   验证: 回读 GWL_STYLE 的 WS_VISIBLE 位(0x10000000)前后对比 —— 项目已在用 取窗口属性。
            如果 (MCP命令服务器.参数键存在 (参数JSON, "visible") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "visible 不能省略 | true=显示窗口 / false=隐藏窗口 | 缺省语义不明, 故不接受缺省"))
            }
            变量 swBrowser <类型 = 类_FBrowser_浏览器>
            swBrowser = MCP命令服务器.取主浏览器 ()
            如果 (swBrowser.是否为空 () == 假 && swBrowser.是否已关闭 () == 假)
            {
                变量 sw目标 <类型 = 逻辑型>
                sw目标 = MCP命令服务器.yyjson取逻辑 (参数JSON, "visible")
                变量 sw前 <类型 = 整数>
                sw前 = swBrowser.取窗口属性 (MCP_常量.窗口样式_GWL_STYLE)
                swBrowser.显示隐藏窗口 (sw目标)
                MCP命令服务器.MCP可中断延时 (250)
                变量 sw后 <类型 = 整数>
                sw后 = swBrowser.取窗口属性 (MCP_常量.窗口样式_GWL_STYLE)
                变量 sw可见前 <类型 = 逻辑型>
                sw可见前 = 位与 (sw前, 268435456) != 0
                变量 sw可见后 <类型 = 逻辑型>
                sw可见后 = 位与 (sw后, 268435456) != 0
                变量 sw结果 <类型 = YYJSON对象类>
                sw结果.创建自文本 ("{}")
                sw结果.加入逻辑值成员 ("requested_visible", sw目标)
                sw结果.加入逻辑值成员 ("visible_before", sw可见前)
                sw结果.加入逻辑值成员 ("visible_after", sw可见后)
                sw结果.加入整数成员 ("style_before", sw前)
                sw结果.加入整数成员 ("style_after", sw后)
                如果 (sw可见后 == sw目标)
                {
                    sw结果.加入逻辑值成员 ("verified", 真)
                    sw结果.加入文本成员 ("message", "窗口可见性已按请求设置(回读 GWL_STYLE 的 WS_VISIBLE 位确认)")
                }
                否则
                {
                    sw结果.加入逻辑值成员 ("verified", 假)
                    sw结果.加入文本成员 ("message", "已调用类库 显示隐藏窗口, 但回读 GWL_STYLE 的 WS_VISIBLE 位未变成请求的状态 | 可能被宿主/桌面环境约束 | 以 style_before/style_after 为准, 不谎报成功")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, sw结果.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_set_auto_resize")
        {
            // ★ 补能力: 同 browser_move_window, 原"恒失败"的前提已被推翻。
            //   类库: 置自动调整大小(启用,最小高度,最小宽度,最大高度,最大宽度) -> SetAutoResizeEnabled。
            //   ⚠ 类库声明顺序是 最小**高度**、最小**宽度**(与 CEF CefSize 的 {width,height} 相反),
            //     官方样例全用对称值故无法消歧 —— 这里按类库声明顺序传, 并在回复里如实标注该风险。
            //   类库无返回值 -> 只能报"已调用", 不假装已生效(该类设置也没有可回读的查询接口)。
            变量 arBrowser <类型 = 类_FBrowser_浏览器>
            arBrowser = MCP命令服务器.取主浏览器 ()
            如果 (arBrowser.是否为空 () == 假 && arBrowser.是否已关闭 () == 假)
            {
                如果 (MCP命令服务器.参数键存在 (参数JSON, "enable") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "必须显式指定 enable | 例: enable:true(窗口可随内容增长) / enable:false(关闭) | 缺省语义不明故不接受缺省"))
                }
                变量 ar启用 <类型 = 逻辑型>
                ar启用 = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
                变量 ar最小高 <类型 = 整数>
                ar最小高 = MCP命令服务器.yyjson取整数 (参数JSON, "min_height")
                变量 ar最小宽 <类型 = 整数>
                ar最小宽 = MCP命令服务器.yyjson取整数 (参数JSON, "min_width")
                变量 ar最大高 <类型 = 整数>
                ar最大高 = MCP命令服务器.yyjson取整数 (参数JSON, "max_height")
                变量 ar最大宽 <类型 = 整数>
                ar最大宽 = MCP命令服务器.yyjson取整数 (参数JSON, "max_width")
                arBrowser.置自动调整大小 (ar启用, ar最小高, ar最小宽, ar最大高, ar最大宽)
                变量 ar结果 <类型 = YYJSON对象类>
                ar结果.创建自文本 ("{}")
                ar结果.加入逻辑值成员 ("enable", ar启用)
                ar结果.加入整数成员 ("min_height", ar最小高)
                ar结果.加入整数成员 ("min_width", ar最小宽)
                ar结果.加入整数成员 ("max_height", ar最大高)
                ar结果.加入整数成员 ("max_width", ar最大宽)
                ar结果.加入逻辑值成员 ("verified", 假)
                ar结果.加入文本成员 ("message", "已调用类库 置自动调整大小(SetAutoResizeEnabled) | 类库该设置无返回值、也没有可回读的查询接口, 故无法确认是否生效: 本工具不谎报 verified=true | 参数按类库声明顺序 最小高度/最小宽度 传入(与 CEF 的 {width,height} 顺序相反, 传非对称值请自行确认)")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, ar结果.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_restore_gui")
        {
            浏览器容器.标记需要恢复布局 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "已请求恢复GUI布局与欢迎页 | UI线程将在800ms内执行"))
        }
        否则 (方法名 == "browser_file_dialog")
        {
            // 安全设计: 传 path 参数直接返回该路径(验证存在性), 不弹任何窗口(不调用原生OS文件对话框, 其会阻塞控制台)
            变量 fdPath <类型 = 文本型>
            fdPath = MCP命令服务器.yyjson取文本 (参数JSON, "path")
            如果 (fdPath == "")
            {
                fdPath = MCP命令服务器.yyjson取文本 (参数JSON, "file_path")
            }
            如果 (fdPath == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "文件对话框已改为程序化选择(不弹窗口) | 请传 path 参数指定目标文件路径"))
            }
            如果 (MCP命令服务器.验证安全路径 (fdPath, 假) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "path 不合法: " + fdPath + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))
            }
            如果 (文件是否存在 (fdPath) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "文件不存在: " + fdPath))
            }
            变量 fdOut <类型 = YYJSON对象类>
            fdOut.创建自文本 ("{}")
            fdOut.加入逻辑值成员 ("success", 真)
            fdOut.加入文本成员 ("selected", fdPath)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, fdOut.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === IPC 进程间通信 ===
        否则 (方法名 == "browser_ipc_send_all")
        {
            变量 msgName <类型 = 文本型>
            msgName = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            如果 (msgName == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "name " + MCP_常量.错误_缺少参数))
            }
            变量 msgData <类型 = 文本型>
            msgData = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                browser.进程间消息_发送数据_到全部渲染进程 (msgName, 文本到字节集 (msgData))
                返回 (MCP_响应构建.命令成功 (命令ID, "已向全部渲染进程发送消息"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_ipc_send_to")
        {
            变量 processID <类型 = 整数>
            processID = MCP命令服务器.yyjson取整数 (参数JSON, "process_id")
            如果 (processID <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "process_id 必须为正整数"))
            }
            变量 msgName <类型 = 文本型>
            msgName = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            如果 (msgName == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "name " + MCP_常量.错误_缺少参数))
            }
            变量 msgData <类型 = 文本型>
            msgData = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                browser.进程间消息_发送数据_到指定渲染进程 (processID, msgName, 文本到字节集 (msgData))
                返回 (MCP_响应构建.命令成功 (命令ID, "已向进程 " + 到文本 (processID) + " 发送消息"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_ipc_renderer_count")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 清单 <类型 = 整数数组类>
                清单 = browser.进程间消息_取渲染进程ID清单 ()
                返回 (MCP_响应构建.构建整数值JSON ("count", 清单.取成员数 ()))
            }
            返回 (MCP_响应构建.构建整数值JSON ("count", 0))
        }
        否则 (方法名 == "browser_ipc_renderer_ids")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            变量 ids数组 <类型 = YYJSON数组类>
            ids数组.创建自文本数据 (取空文本数组 ())
            如果 (browser.是否为空 () == 假)
            {
                变量 清单 <类型 = 整数数组类>
                清单 = browser.进程间消息_取渲染进程ID清单 ()
                计次循环 (清单.取成员数 ())
                {
                    ids数组.加入整数成员 (清单.取成员 (取循环索引 ()))
                }
            }
            变量 ids包装 <类型 = YYJSON对象类>
            ids包装.创建自文本 ("{}")
            ids包装.加入数组成员 ("ids", ids数组)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, ids包装.到可读文本 (YYJSON格式化选项.压缩)))
        }
        // === 全局函数 ===
        否则 (方法名 == "browser_create_url_request")
        {
            变量 reqURL <类型 = 文本型>
            reqURL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            如果 (reqURL == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "url " + MCP_常量.错误_缺少参数))
            }
            如果 (MCP命令服务器.验证URL安全 (reqURL) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_不支持的URL协议))
            }
            如果 (MCP命令服务器.尝试占用URL请求槽 () == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "URL请求并发已满(" + 到文本 (MCP_常量.URL请求最大并发) + "), 请稍后重试或 mcp_result consume 已完成的请求"))
            }
            变量 reqMethod <类型 = 文本型>
            reqMethod = MCP命令服务器.yyjson取文本 (参数JSON, "method")
            // 请求体与请求头(缺这些就只能发 GET): 有 body 且调用方没显式给 method -> 用 POST
            变量 reqBody <类型 = 文本型>
            reqBody = MCP命令服务器.yyjson取文本 (参数JSON, "body")
            // 大请求体走文件 —— 为什么需要: MCP HTTP 通道在 arguments ≥1MB 时会被内核直接断连
            //   (客户端只看到"无响应", 拿不到错误码), 且该墙早于本项目的事件处理, 服务端无法拦截;
            //   故提供 body_file: 请求体从文件直传(类库 置数据_文件 → CEF SetToFile),
            //   无需把内容塞进 arguments, 也不必读进内存。
            变量 reqBodyFile <类型 = 文本型>
            reqBodyFile = MCP命令服务器.yyjson取文本 (参数JSON, "body_file")
            变量 体来自文件 <类型 = 逻辑型>
            体来自文件 = 假
            如果 (reqBody == "" && reqBodyFile != "")
            {
                如果 (文件是否存在 (reqBodyFile) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "body_file 不存在: " + reqBodyFile + " | 请给**绝对路径**(相对路径按进程运行目录解析) | 提示: 大请求体请用 body_file 而不是 body —— 实测 MCP HTTP 通道在 arguments 约 1MB 处会被内核直接断连(客户端只看到无响应)"))
                }
                体来自文件 = 真
            }
            如果 (reqBody != "" && MCP命令服务器.参数键存在 (参数JSON, "method") == 假)
            {
                reqMethod = "POST"
            }
            如果 (reqMethod == "")
            {
                reqMethod = "GET"
            }
            变量 请求 <类型 = 类_FBrowser_请求>
            请求.创建 ()
            请求.置地址 (reqURL)
            请求.置类型 (reqMethod)
            // 自定义请求头: 每行一条 "名: 值"(也接受 "名=值"); 覆盖=真 表示同名覆盖
            变量 reqHeaders <类型 = 文本型>
            reqHeaders = MCP命令服务器.yyjson取文本 (参数JSON, "headers")
            // 复用 应用请求头文本(与"载入请求"路径同一份解析实现, 避免两份漂移)
            变量 头行数 <类型 = 整数>
            头行数 = MCP命令服务器.应用请求头文本 (请求, reqHeaders)
            // 请求体: 类库要求"数据编码必须是UTF8"(FBroLib.wsv:2610 注释原文), 故按 UTF-8 送
            // 复用 应用请求体文本(同上; 返回的是 UTF-8 字节数); body_file 走类库文件直传
            变量 体字节数 <类型 = 整数>
            如果 (体来自文件)
            {
                变量 文件元素 <类型 = 类_FBrowser_POST元素>
                文件元素.创建 ()
                文件元素.置数据_文件 (reqBodyFile)
                变量 文件体数据 <类型 = 类_FBrowser_POST数据>
                文件体数据.创建 ()
                文件体数据.增加元素 (文件元素)
                请求.置POST数据 (文件体数据)
                体字节数 = 0  // 文件直传不读入内存, 故不报字节数(避免为了报数把整个文件读一遍)
            }
            否则
            {
                体字节数 = MCP命令服务器.应用请求体文本 (请求, reqBody)
            }
            // ── 零前置①: 有请求体时自动置 UR_FLAG_REPORT_UPLOAD_PROGRESS, 否则**上传进度事件永远不会回调**
            //   (类库原文 FBroEventControl.wsv:2314 注释: 只有在请求上设置了该标志时才会调用 上传进度)
            //   置标志是纯请求侧设置, 不改变请求语义(只是让 CEF 报告进度), 故可安全自动置位并经 auto_prepared 上报。
            如果 (reqBody != "" || 体来自文件)
            {
                变量 原标识 <类型 = 整数>
                原标识 = 请求.取标识 ()
                请求.设置标识 (位或 (原标识, 请求标识.上载进度报告))
                MCP_响应构建.记录自动处理 ("UR_FLAG_REPORT_UPLOAD_PROGRESS(请求体非空时自动置位; 上传进度事件 urlreq_upload 需要它)")
            }
            // ── 零前置②: urlreq_* 事件族有独立的监控开关(默认关), 不开则**进度事件一条都不入库**。
            //   该开关只影响"本项目自建请求"的日志记录(不改变请求行为), 故此处自动打开并如实上报,
            //   免得调用方为了看到进度先去查该翻哪个开关(此前这正是"要试很多次"的来源之一)。
            如果 (MCP命令服务器.是否监控自建URL请求 == 假)
            {
                MCP命令服务器.是否监控自建URL请求 = 真
                MCP_响应构建.记录自动处理 ("自建URL请求监控(否则 urlreq_start/urlreq_upload/urlreq_download 不入库; 等价于 browser_collect action=event_urlreq_enable)")
            }
            变量 异步URL请求ID <类型 = 文本型>
            异步URL请求ID = MCP命令服务器.生成异步任务ID ()
            变量 URL请求回调 <类型 = 类_FBrowser_事件智能指针>
            URL请求回调.创建 (类_MCP_URL请求回调)
            URL请求回调.取执行类 (类_MCP_URL请求回调).任务ID = 异步URL请求ID
            FBrowser_创建URL请求 (请求, , URL请求回调, MCP_常量.URL请求默认超时)
            返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步URL请求ID, "URL请求已提交, 通过mcp_result查询结果"))
        }
        否则 (方法名 == "browser_find_by_hwnd")
        {
            变量 hwnd <类型 = 变整数>
            hwnd = (变整数)MCP命令服务器.yyjson取长整数 (参数JSON, "hwnd")
            如果 (hwnd == 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "hwnd " + MCP_常量.错误_缺少参数))
            }
            变量 found <类型 = 类_FBrowser_浏览器>
            found = FBrowser_浏览器_通过窗口句柄取浏览器 (hwnd)
            如果 (found.是否为空 () == 假 && found.是否已关闭 () == 假)
            {
                变量 info <类型 = YYJSON对象类>
                info.创建自文本 ("{}")
                info.加入整数成员 ("id", found.取ID ())
                变量 hwndFrame <类型 = 类_FBrowser_框架>
                hwndFrame = MCP命令服务器.取安全主框架 (found)
                如果 (hwndFrame.是否为空 () == 假)
                {
                    info.加入文本成员 ("url", hwndFrame.取地址 ())
                }
                否则
                {
                    info.加入文本成员 ("url", "")
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, info.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "未找到窗口句柄为 " + 到文本 (hwnd) + " 的浏览器 | 如何取得有效句柄: 调 browser_get_window_handle(返回当前浏览器窗口句柄) 或 browser_window_info 看 hwnd 字段; 句柄是**运行时值**(每次启动不同), 无法预先写死 | 也可改用 browser_list(列 id) 或 browser_find_by_tag(按标识) 定位"))
        }
        否则 (方法名 == "browser_user_tags")
        {
            变量 tag清单 <类型 = 类_FBrowser_列表值>
            tag清单 = FBrowser_浏览器_取用户标识清单 ()
            如果 (tag清单.是否为空 () == 假)
            {
                变量 JSON数组 <类型 = YYJSON数组类>
                JSON数组.创建自文本数据 (MCP命令服务器.取空文本数组 ())
                计次循环 (tag清单.取大小 ())
                {
                    JSON数组.加入文本成员 (tag清单.取文本值 (取循环索引 ()))
                }
                变量 结果对象 <类型 = YYJSON对象类>
                结果对象.创建自文本 ("{}")
                结果对象.加入数组成员 ("tags", JSON数组)
                // 仅返回tags片段, 外层由命令成功_原始JSON统一包 id/success (避免双层包裹)
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "无法获取用户标识清单"))
        }
        // === 缓存/清理 ===
        否则 (方法名 == "browser_clear_cache_browser")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // 修(能力缺口): 原实现是 `清理缓存 (, , , 回调)` —— 三个过滤参数全缺省,
                // 即只能"清当前 origin 的全部对象/全部类型", 类库文档里那套**按位或挑对象**的粒度
                // (例如"只清 localStorage/IndexedDB, 保留 Cookies")完全无法表达, 用户只能去手写 CDP。
                // 现补上 origin / targets / storage_types 三个可选参数; **缺省值与原行为完全一致**,
                // 故老调用不受影响。
                变量 ccOrigin <类型 = 文本型>
                ccOrigin = MCP命令服务器.yyjson取文本 (参数JSON, "origin")
                // 零前置(实测依据): 不带 origin 时, **按源存储的那几类清不掉且不报错** ——
                // 实测同一页面: targets=localstorage 无 origin -> 清前后 localStorage 都是 "1"(连 targets=all 也一样);
                // 带 origin=https://example.com 时立刻变成 NONE(带不带结尾斜杠都可)。
                // 这正是"用户什么都没做错却毫无效果"的典型, 故缺省时自动用**当前页面的 origin** 补上并如实回报。
                变量 ccOrigin自动 <类型 = 逻辑型 值 = 假>
                如果 (ccOrigin == "")
                {
                    变量 ccFrame <类型 = 类_FBrowser_框架>
                    ccFrame = MCP命令服务器.取安全主框架 (browser)
                    如果 (ccFrame.是否为空 () == 假 && ccFrame.是否有效 ())
                    {
                        变量 ccCurUrl <类型 = 文本型>
                        ccCurUrl = ccFrame.取地址 ()
                        变量 ccSchemeAt <类型 = 整数>
                        ccSchemeAt = 寻找文本 (ccCurUrl, "://", 0, 假)
                        如果 (ccSchemeAt >= 0)
                        {
                            // origin = scheme://host[:port], 不含路径(类库明确要求"根域名不能包含网址后的路径")
                            变量 ccAfterScheme <类型 = 文本型>
                            ccAfterScheme = 取文本右边 (ccCurUrl, 取文本长度 (ccCurUrl) - (ccSchemeAt + 3))
                            变量 ccSlashAt <类型 = 整数>
                            ccSlashAt = 寻找文本 (ccAfterScheme, "/", 0, 假)
                            如果 (ccSlashAt >= 0)
                            {
                                ccOrigin = 取文本左边 (ccCurUrl, ccSchemeAt + 3 + ccSlashAt)
                            }
                            否则
                            {
                                ccOrigin = ccCurUrl
                            }
                            ccOrigin自动 = 真
                        }
                    }
                }
                变量 ccTargets <类型 = 文本型>
                ccTargets = MCP命令服务器.yyjson取文本 (参数JSON, "targets")
                变量 ccTypes <类型 = 文本型>
                ccTypes = MCP命令服务器.yyjson取文本 (参数JSON, "storage_types")
                变量 ccMask <类型 = 长整数>
                ccMask = 清理缓存.全部
                变量 ccTypeMask <类型 = 长整数>
                ccTypeMask = 缓存类型.全部
                如果 (ccTargets != "")
                {
                    // 解析复用 解析清理掩码列表(同一逻辑只留一份): 任一名字不认识就**整体失败并指名**,
                    // 不静默忽略(静默忽略会让"只清了一半"看起来像成功)。
                    变量 cc目标解析 <类型 = YYJSON只读对象类>
                    cc目标解析.创建自文本 (解析清理掩码列表 (ccTargets, "targets"))
                    如果 (MCP命令服务器.yyjson取文本 (cc目标解析, "error") != "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "targets 里有无法识别的清理对象: " + MCP命令服务器.yyjson取文本 (cc目标解析, "error") + " | 可用值(逗号分隔): appcache,cookies,filesystem,indexeddb,localstorage,shadercache,websql,serviceworkers,cachestorage,pluginprivatedata,backgroundfetch,conversions,all"))
                    }
                    ccMask = MCP命令服务器.yyjson取长整数 (cc目标解析, "mask")
                }
                如果 (ccTypes != "")
                {
                    变量 cc类型解析 <类型 = YYJSON只读对象类>
                    cc类型解析.创建自文本 (解析清理掩码列表 (ccTypes, "storage_types"))
                    如果 (MCP命令服务器.yyjson取文本 (cc类型解析, "error") != "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "storage_types 里有无法识别的类型: " + MCP命令服务器.yyjson取文本 (cc类型解析, "error") + " | 可用值(逗号分隔): temporary,persistent,syncable,all"))
                    }
                    ccTypeMask = MCP命令服务器.yyjson取长整数 (cc类型解析, "mask")
                }
                变量 异步清理ID2 <类型 = 文本型>
                异步清理ID2 = MCP命令服务器.生成异步任务ID ()
                变量 清理回调2 <类型 = 类_FBrowser_事件智能指针>
                清理回调2.创建 (类_MCP_清理缓存回调)
                清理回调2.取执行类 (类_MCP_清理缓存回调).任务ID = 异步清理ID2
                browser.清理缓存 (ccOrigin, ccMask, ccTypeMask, 清理回调2)
                变量 cc范围说明 <类型 = 文本型>
                cc范围说明 = "(未取到当前页 origin, 按源存储类可能不生效)"
                如果 (ccOrigin != "")
                {
                    cc范围说明 = ccOrigin
                }
                如果 (ccOrigin自动)
                {
                    MCP_响应构建.记录自动处理 ("origin=" + ccOrigin + "(未传 origin, 已自动取当前页 origin; 不带它按源存储类会静默不生效)")
                }
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步清理ID2, "浏览器缓存清理已提交 | origin=" + cc范围说明 + " | 清理对象掩码=" + 到文本 (ccMask) + " | 存储类型掩码=" + 到文本 (ccTypeMask) + " | 通过 mcp_result 查询结果"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_cache_dir")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 reqCtx <类型 = 类_FBrowser_请求环境>
                reqCtx = browser.取请求环境 ()
                如果 (reqCtx.是否为空 () == 假)
                {
                    返回 (MCP_响应构建.构建简单JSON ("cache_dir", reqCtx.取缓存路径 ()))
                }
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === JS逆向: 函数Hook (CDP/V8级无侵入拦截) ===
        否则 (方法名 == "browser_reverse_hook")
        {
            变量 hookTarget <类型 = 文本型>
            hookTarget = MCP命令服务器.yyjson取文本 (参数JSON, "target")
            变量 hookType <类型 = 文本型>
            hookType = MCP命令服务器.yyjson取文本 (参数JSON, "type")
            如果 (hookType == "")
            {
                hookType = "function_call"
            }
            如果 (hookTarget == "" && hookType != "xhr_fetch" && hookType != "websocket" && hookType != "eval_dynamic" && hookType != "cookie_set")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "target 不能为空 | 指定函数名/URL正则/选择器"))
            }
            变量 captureArgs <类型 = 逻辑型>
            captureArgs = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "capture_args", 真)
            变量 captureReturn <类型 = 逻辑型>
            captureReturn = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "capture_return", 真)
            变量 captureStack <类型 = 逻辑型>
            captureStack = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "capture_stack", 假)
            变量 hookCode <类型 = 文本型>
            变量 hookLabel <类型 = 文本型>
            hookLabel = "mcp_hook_" + 到文本 (取启动时间 ()) + "_" + 到文本 (取随机数 (1000, 999999))
            如果 (hookType == "function_call")
            {
                // 防注入: 转义目标名中的引号和反斜杠 (见 reverse_search 同款用法)
                变量 hookEsc <类型 = 文本型>
                hookEsc = MCP命令服务器.简单转义JS (hookTarget)
                // 动态注入: 支持 obj.fn 点路径, 包装目标函数, 记录参数/返回值/调用栈 (抛错也记录)
                // 捕获数据同时写入 window.__MCP_HOOK_LOG__ (hook_logs可直接查询) 与 console.log
                // 防护: 重复hook检测(__mcp_hooked标记) + 冻结对象安装失败检测(引用相等校验)
                hookCode = "(function(){var __parts='" + hookEsc + "'.split('.');var __obj=window;var __ok=true;for(var __pi=0;__pi<__parts.length-1;__pi++){__obj=__obj[__parts[__pi]];if(!__obj){__ok=false;break}}var __last=__parts[__parts.length-1];var __t=__ok&&typeof __obj[__last]==='function'?__obj[__last]:null;if(!__t){return JSON.stringify({found:false,target:'" + hookEsc + "'})}if(__t.__mcp_hooked){return JSON.stringify({found:true,target:'" + hookEsc + "',already:true,hook:'" + hookLabel + "'})}var __orig=__t;var __rawLog=(typeof console!=='undefined'&&console&&console.log)?console.log:null;var __lg=window.__MCP_HOOK_LOG__=window.__MCP_HOOK_LOG__||[];var __put=function(x){__lg[__lg.length]=x;};function __cap(){if(__lg.length>2000){var __k=1000,__i2;for(__i2=0;__i2<__k;__i2++){__lg[__i2]=__lg[__lg.length-__k+__i2];}__lg.length=__k;}}var __wrapper=function(){try{var __an=arguments.length,__args=[],__ai;for(__ai=0;__ai<__an;__ai++){__args[__ai]=arguments[__ai];}var __result=Reflect.apply(__orig,this,__args);var __entry={target:'" + hookEsc + "',hook:'" + hookLabel + "',ts:Date.now()};"
                如果 (captureArgs)
                {
                    hookCode = hookCode + "try{__entry.args=JSON.stringify(__args).substring(0,4096)}catch(e){__entry.args='[unserializable]'};"
                }
                如果 (captureReturn)
                {
                    hookCode = hookCode + "try{__entry.ret=JSON.stringify(__result).substring(0,4096)}catch(e){__entry.ret='[unserializable]'};"
                }
                如果 (captureStack)
                {
                    hookCode = hookCode + "try{var __e=new Error();__entry.stack=__e.stack.substring(0,2048)}catch(e){};"
                }
                hookCode = hookCode + "__cap();__lg[__lg.length]=__entry;if(__rawLog){try{__rawLog('[" + hookLabel + "]',JSON.stringify(__entry));}catch(__le){}}return __result;}catch(__x){var __te={target:'" + hookEsc + "',hook:'" + hookLabel + "',ts:Date.now(),threw:__x.message};__cap();__lg[__lg.length]=__te;throw __x;}};__obj[__last]=__wrapper;if(__obj[__last]!==__wrapper){return JSON.stringify({found:false,target:'" + hookEsc + "',error:'not_writable(对象可能被冻结, 无法安装Hook)'})}__wrapper.toString=function(){return __orig.toString()};__wrapper.__mcp_hooked=true;return JSON.stringify({found:true,target:'" + hookEsc + "',hook:'" + hookLabel + "',log_key:'__MCP_HOOK_LOG__'})})()"
            }
            否则 (hookType == "xhr_fetch")
            {
                变量 hookUrlPattern <类型 = 文本型>
                hookUrlPattern = MCP命令服务器.yyjson取文本 (参数JSON, "url_pattern")
                如果 (hookUrlPattern == "" && hookTarget == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "xhr_fetch 需要 target 或 url_pattern"))
                }
                变量 hookPattern <类型 = 文本型>
                hookPattern = hookTarget
                如果 (hookPattern == "")
                {
                    hookPattern = hookUrlPattern
                }
                // 防注入: 转义模式中的引号/反斜杠/换行 (与 function_call 分支同款防护)
                hookPattern = MCP命令服务器.简单转义JS (hookPattern)
                hookCode = "(function(){var __p='" + hookPattern + "';var __origOpen=XMLHttpRequest.prototype.open;XMLHttpRequest.prototype.open=function(m,u){this.__url=u;this.__method=m;if(u.indexOf(__p)!==-1){var __entry={type:'xhr',method:m,url:u,hook:'" + hookLabel + "',ts:Date.now()};console.log('[" + hookLabel + "]',JSON.stringify(__entry))}return __origOpen.apply(this,arguments)};return JSON.stringify({found:true,pattern:__p,hook:'" + hookLabel + "'})})()"
            }
            否则 (hookType == "websocket")
            {
                // WebSocket消息Hook: 记录send数据头(200字符), 数据存 window.__MCP_WS_LOG__ 供 browser_reverse_hook_logs 查询
                变量 wsPattern <类型 = 文本型>
                wsPattern = MCP命令服务器.简单转义JS (hookTarget)
                如果 (wsPattern == "")
                {
                    wsPattern = "*"
                }
                hookCode = "(function(){var __p='" + wsPattern + "';var __lg=window.__MCP_WS_LOG__=window.__MCP_WS_LOG__||[];var __put=function(x){__lg[__lg.length]=x;};function __cap(){if(__lg.length>2000){var __k=1000,__i9;for(__i9=0;__i9<__k;__i9++){__lg[__i9]=__lg[__lg.length-__k+__i9];}__lg.length=__k;}}var __os=WebSocket.prototype.send;WebSocket.prototype.send=function(d){var u=this.url||'';if(__p==='*'||u.indexOf(__p)!==-1){__cap();__put({t:'send',ts:Date.now(),url:u.substring(0,300),len:(d&&d.length)||0,head:String(d).substring(0,200)});}return __os.apply(this,arguments);};return JSON.stringify({found:true,type:'websocket',pattern:__p,log_key:'__MCP_WS_LOG__'});})()"
            }
            否则 (hookType == "eval_dynamic")
            {
                // 动态代码Hook: 拦截eval与Function构造器, 定位动态生成/解密的JS代码, 数据存 __MCP_EVAL_LOG__
                hookCode = "(function(){var __lg=window.__MCP_EVAL_LOG__=window.__MCP_EVAL_LOG__||[];var __put=function(x){__lg[__lg.length]=x;};function __cap(){if(__lg.length>2000){var __k=1000,__i9;for(__i9=0;__i9<__k;__i9++){__lg[__i9]=__lg[__lg.length-__k+__i9];}__lg.length=__k;}}var __oe=window.eval;window.eval=function(c){__cap();__put({t:'eval',ts:Date.now(),head:String(c).substring(0,300)});return __oe.apply(this,arguments);};var __oF=window.Function;window.Function=function(){var __fn=arguments.length,a=[],__fi;for(__fi=0;__fi<__fn;__fi++){a[__fi]=arguments[__fi];}var body=a.length>1?a[a.length-1]:a[0];__cap();__put({t:'Function',ts:Date.now(),head:String(body).substring(0,300)});return __oF.apply(this,a);};return JSON.stringify({found:true,type:'eval_dynamic',log_key:'__MCP_EVAL_LOG__'});})()"
            }
            否则 (hookType == "cookie_set")
            {
                // Cookie赋值Hook: 拦截document.cookie setter, 追踪Cookie生成/注入点, 数据存 __MCP_COOKIE_LOG__
                hookCode = "(function(){var __lg=window.__MCP_COOKIE_LOG__=window.__MCP_COOKIE_LOG__||[];var __put=function(x){__lg[__lg.length]=x;};function __cap(){if(__lg.length>2000){var __k=1000,__i9;for(__i9=0;__i9<__k;__i9++){__lg[__i9]=__lg[__lg.length-__k+__i9];}__lg.length=__k;}}var __d=Object.getOwnPropertyDescriptor(Document.prototype,'cookie');var __s=__d&&__d.set;if(__s){Object.defineProperty(Document.prototype,'cookie',{get:__d.get,set:function(v){__cap();__put({t:'set',ts:Date.now(),head:String(v).substring(0,300)});__s.call(this,v);}});}return JSON.stringify({found:!!__s,type:'cookie_set',log_key:'__MCP_COOKIE_LOG__'});})()"
            }
            否则
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + hookType + " | 支持: function_call/xhr_fetch/websocket/eval_dynamic/cookie_set"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                变量 hookFrame <类型 = 类_FBrowser_框架>
                hookFrame = MCP命令服务器.取安全主框架 (browser)
                如果 (hookFrame.是否为空 () == 假 && hookFrame.是否有效 ())
                {
                    变量 异步HookID <类型 = 文本型>
                    异步HookID = MCP命令服务器.生成异步任务ID ()
                    变量 Hook回调 <类型 = 类_FBrowser_事件智能指针>
                    Hook回调.创建 (类_MCP_JS异步回调)
                    Hook回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步HookID
                    hookFrame.执行JS代码_带返回值 (hookCode, "", 0, Hook回调)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步HookID, "Hook已提交: " + hookType + " → " + hookTarget + " | 通过mcp_result查询注入状态"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === JS逆向: 可疑字符串提取 ===
        否则 (方法名 == "browser_reverse_strings")
        {
            变量 rsMode <类型 = 文本型>
            rsMode = MCP命令服务器.yyjson取文本 (参数JSON, "mode")
            如果 (rsMode == "")
            {
                rsMode = "suspicious"
            }
            变量 rsMinLen <类型 = 整数>
            rsMinLen = MCP命令服务器.yyjson取整数 (参数JSON, "min_length")
            如果 (rsMinLen <= 0)
            {
                rsMinLen = 20
            }
            变量 rsMaxResults <类型 = 整数>
            rsMaxResults = MCP命令服务器.yyjson取整数 (参数JSON, "max_results")
            如果 (rsMaxResults <= 0)
            {
                rsMaxResults = 200
            }
            如果 (rsMaxResults > 2000)
            {
                rsMaxResults = 2000  // 上限防JS无界收集超大数组
            }
            变量 rsCode <类型 = 文本型>
            如果 (rsMode == "suspicious")
            {
                rsCode = "(function(){var R=[];var seen={};var re=/[A-Za-z0-9_\\-]{20,}|[A-Za-z0-9+/=]{24,}|[0-9a-fA-F]{32,}/g;var ss=document.querySelectorAll('script');for(var i=0;i<ss.length;i++){var t=ss[i].textContent||'';var m;while((m=re.exec(t))!==null){var s=m[0];if(!seen[s]&&s.length>=" + 到文本 (rsMinLen) + "){seen[s]=1;R.push({v:s.substring(0,200),l:s.length,si:i})}}}return JSON.stringify({count:R.length,results:R.slice(0," + 到文本 (rsMaxResults) + ")})})()"
            }
            否则 (rsMode == "decrypt_array")
