            如果 (ctText == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "text " + MCP_常量.错误_缺少参数))
            }
            变量 ctBrowser <类型 = 类_FBrowser_浏览器>
            ctBrowser = MCP命令服务器.取主浏览器 ()
            如果 (ctBrowser.是否为空 () == 假 && ctBrowser.是否已关闭 () == 假)
            {
                变量 ctEsc <类型 = 文本型>
                ctEsc = MCP命令服务器.简单转义JS (ctText)
                变量 ctSel <类型 = 文本型>
                ctSel = MCP命令服务器.简单转义JS (MCP命令服务器.yyjson取文本 (参数JSON, "selector"))
                变量 ctIdx <类型 = 整数>
                ctIdx = MCP命令服务器.yyjson取整数 (参数JSON, "index")
                变量 ctExact <类型 = 逻辑型>
                ctExact = MCP命令服务器.yyjson取逻辑 (参数JSON, "exact")
                变量 ctCode <类型 = 文本型>
                ctCode = "(function(){var txt='" + ctEsc + "';var idx=" + 到文本 (ctIdx) + ";var EXACT=" + 选择 (ctExact, "true", "false") + ";"
                ctCode = ctCode + "var scope=document;var sel='" + ctSel + "';if(sel){scope=document.querySelector(sel)||document;}"
                ctCode = ctCode + "var cands=[];var all=scope.querySelectorAll('button,a,span,div,li,label,td,input[type=submit],input[type=button],[role=button]');"
                ctCode = ctCode + "for(var i=0;i<all.length;i++){var e=all[i];var t=(e.innerText||e.textContent||'').replace(/\\s+/g,' ').trim();if(t==='')continue;var hit=EXACT?(t===txt):(t.indexOf(txt)!==-1);if(hit)cands.push(e);}"
                ctCode = ctCode + "if(!cands.length){var sugg=[];var seen={};var all2=scope.querySelectorAll('button,a,span,div,li,label,input[type=submit],[role=button]');for(var j2=0;j2<all2.length&&sugg.length<60;j2++){var t2=(all2[j2].innerText||all2[j2].textContent||'').replace(/\\s+/g,' ').trim();if(t2&&!seen[t2]){seen[t2]=1;var sc=0;for(var ci=0;ci<txt.length;ci++){if(t2.indexOf(txt[ci])!==-1)sc++;}if(sc>0)sugg.push({text:t2.length>40?t2.substring(0,40)+'...':t2,score:sc});}}sugg.sort(function(a,b){return b.score-a.score;});return JSON.stringify({found:false,error:'not_found_text',searched:txt,suggestions:sugg.slice(0,5)});}"
                ctCode = ctCode + "if(idx<0||idx>=cands.length)idx=0;var el=cands[idx];"
                ctCode = ctCode + "var r=el.getBoundingClientRect();var cx=r.left+r.width/2,cy=r.top+r.height/2;"
                ctCode = ctCode + "function fire(type){el.dispatchEvent(new MouseEvent(type,{bubbles:true,cancelable:true,view:window,clientX:cx,clientY:cy}));}"
                ctCode = ctCode + "fire('mouseover');fire('mousedown');fire('mouseup');fire('click');"
                ctCode = ctCode + "return JSON.stringify({found:true,clicked:{tag:el.tagName.toLowerCase(),text:(el.innerText||'').replace(/\\s+/g,' ').trim().substring(0,80)},total_matches:cands.length});})()"
                变量 ctWanted <类型 = 整数>
                ctWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 ctTaskID <类型 = 文本型>
                ctTaskID = MCP命令服务器.生成异步任务ID ()
                变量 ctSubmit <类型 = 文本型>
                ctSubmit = MCP命令服务器.提交异步JS任务 (ctBrowser, ctCode, ctTaskID)
                如果 (是否以 (ctSubmit, "{\"error\""))
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效 + " | " + ctSubmit))
                }
                变量 ctStore <类型 = 文本型>
                ctStore = MCP命令服务器.同步等待异步任务 (ctTaskID, ctWanted)
                如果 (ctStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "点击执行超时 | 页面可能正在导航"))
                }
                变量 ctWrap <类型 = YYJSON只读对象类>
                如果 (ctWrap.创建自文本 (ctStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (ctWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "点击执行错误: " + MCP命令服务器.yyjson取文本 (ctWrap, "error")))
                    }
                    变量 ctMsg <类型 = 文本型>
                    ctMsg = MCP命令服务器.yyjson取文本 (ctWrap, "message")
                    如果 (ctMsg != "")
                    {
                        变量 ctData <类型 = YYJSON对象类>
                        ctData.创建自文本 ("{}")
                        ctData.加入逻辑值成员 ("success", 真)
                        ctData.加入文本成员 ("result_json", ctMsg)
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, ctData.到可读文本 (YYJSON格式化选项.压缩)))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "点击结果解析失败 | 请重试或改用 browser_dom_click"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
