                rsWantedMS = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 rsRaw <类型 = 文本型>
                rsRaw = MCP命令服务器.CDP执行JS并等待 (rsCode, rsWantedMS, 真)
                如果 (rsRaw == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "CDP Runtime.evaluate 超时(" + 到文本 (rsWantedMS) + "ms) | 可重试或使用 async_only:true"))
                }
                变量 rs解析 <类型 = YYJSON只读对象类>
                如果 (rs解析.创建自文本 (rsRaw))
                {
                    变量 rsErr <类型 = 文本型>
                    rsErr = MCP命令服务器.yyjson取文本 (rs解析, "error")
                    如果 (rsErr != "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "字符串扫描错误: " + rsErr))
                    }
                }
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, rsRaw))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === JS逆向: 验证重实现 ===
        否则 (方法名 == "browser_reverse_verify")
        {
            变量 rvOriginal <类型 = 文本型>
            rvOriginal = MCP命令服务器.yyjson取文本 (参数JSON, "original")
            变量 rvReimpl <类型 = 文本型>
            rvReimpl = MCP命令服务器.yyjson取文本 (参数JSON, "reimplementation")
            如果 (rvOriginal == "" || rvReimpl == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "需要 original(原始函数路径) 和 reimplementation(重写JS函数)"))
            }
            变量 rvInputs <类型 = 文本型>
            rvInputs = MCP命令服务器.yyjson取JSON文本 (参数JSON, "test_inputs")
            如果 (rvInputs == "")
            {
