        否则 (方法名 == "browser_get_forms")
        {
            变量 gfBrowser <类型 = 类_FBrowser_浏览器>
            gfBrowser = MCP命令服务器.取主浏览器 ()
            如果 (gfBrowser.是否为空 () == 假 && gfBrowser.是否已关闭 () == 假)
            {
                变量 gfIdx <类型 = 整数>
                gfIdx = MCP命令服务器.yyjson取整数 (参数JSON, "form_index")
                如果 (gfIdx < 0)
                {
                    gfIdx = -1
                }
                变量 gfCode <类型 = 文本型>
                gfCode = "(function(){var FIDX=" + 到文本 (gfIdx) + ";var out=[];var forms=document.querySelectorAll('form');if(!forms.length)return JSON.stringify({count:0,forms:[]});"
                gfCode = gfCode + "var lo=FIDX>=0?FIDX:0;var hi=FIDX>=0?(FIDX+1):forms.length;if(lo>=forms.length)return JSON.stringify({count:0,forms:[],error:'form_index_out_of_range'});"
                gfCode = gfCode + "for(var f=lo;f<hi;f++){var form=forms[f];var fo={index:f,action:form.action||'',method:(form.method||'get').toLowerCase(),fields:[]};"
                gfCode = gfCode + "var fs=form.querySelectorAll('input,select,textarea');"
                gfCode = gfCode + "for(var i=0;i<fs.length;i++){var e=fs[i];var type=(e.tagName==='INPUT')?(e.type||'text'):e.tagName.toLowerCase();"
                gfCode = gfCode + "var fd={tag:e.tagName.toLowerCase(),type:type,name:e.name||'',id:e.id||'',placeholder:e.placeholder||'',required:e.required===true};"
                gfCode = gfCode + "if(e.tagName==='SELECT'){fd.options=e.options?e.options.length:0;fd.value=e.value||'';}else{fd.value=(e.value||'').substring(0,200);}"
                gfCode = gfCode + "if(e.id)fd.selector='#'+e.id;else if(e.name)fd.selector=type+'[name=\"'+e.name+'\"]';else fd.selector=type;"
                gfCode = gfCode + "fo.fields.push(fd);}out.push(fo);}return JSON.stringify({count:out.length,forms:out});})()"
                变量 gfWanted <类型 = 整数>
