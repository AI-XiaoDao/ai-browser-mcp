        // === JS逆向: JSVMP解释器透明插桩 (prototype getter替换,不破坏签名) ===
        否则 (方法名 == "browser_reverse_instrument")
        {
            变量 insTarget <类型 = 文本型>
            insTarget = MCP命令服务器.yyjson取文本 (参数JSON, "target")
            变量 insMode <类型 = 文本型>
            insMode = MCP命令服务器.yyjson取文本 (参数JSON, "mode")
            如果 (insMode == "")
            {
                insMode = "transparent"
            }
            变量 insBrowser <类型 = 类_FBrowser_浏览器>
            insBrowser = MCP命令服务器.取主浏览器 ()
            如果 (insBrowser.是否为空 () == 假 && insBrowser.是否已关闭 () == 假)
            {
                变量 insEsc <类型 = 文本型>
                insEsc = MCP命令服务器.简单转义JS (insTarget)
                变量 insCode <类型 = 文本型>
                如果 (insMode == "transparent")
                {
                    // 透明模式: 仅替换prototype getter,不破坏fn.toString()和签名计算
                    // 结果存入 window.__mcp_instrument_results 供后续 browser_evaluate 读取
                    // ★ 根因(实测崩栈): 日志路径上不能使用会被自己包装的内建方法 ——
                    //   __results.push(...)(默认目标表含 Array.prototype.push)、
                    //   Array.prototype.slice.call(...)(含 Function.prototype.call)、
                    //   __orig.apply(...)(含 Function.prototype.apply) —— 于是记录一次调用就再进包装器、
                    //   包装器又要记录… 无限自递归; 且 __count++ 在 push 之后, 永远到不了 __max 上限。
                    //   实测症状: 用过后同页 JS 崩 RangeError: Maximum call stack size exceeded,
                    //   栈帧反复 at __obj.<computed>。
                    //   约束: 安装前捕获原生 apply/call/toString/split/substring, 日志路径只用这些捕获量,
                    //   数组用**索引赋值**代替 push, 结构用普通 for 循环 —— 不再触碰任何可被包装的原型方法。
                    //   同时把原函数挂到 __wrapper.__mcp_orig: 这是后续"卸载/还原"入口的必要前提
                    //   若不留这个入口, 原函数只存在于不可达的闭包里, 只能靠刷新页面恢复。
                    // ★ 陷阱: 把 forEach 回调换成普通 for 循环会引入经典 var 捕获 bug ——
                    //   __t/__obj/__orig/__method 都是函数作用域, 所有包装器闭包共享同一份, 循环结束后
                    //   它们指向**最后一个目标**的原函数(实测全部变成了调 charAt):
                    //     a.push(1,2,3)  -> charAt -> len:0;  slice.call(a,1) -> "f";  f.apply -> "f"。
                    //   用 forEach 回调时天然每轮独立作用域(回调本身就是一次函数调用), 没有此问题。
                    //   现改用**显式 IIFE 传参**保证逐轮独立, 且不依赖 forEach(用户可能把 forEach 列为目标)。
                    // ★ 修(第一轮): 日志路径原先用 __results.push / Array.prototype.slice.call /
                    //   __orig.apply —— 这三者都在默认目标表里, 于是记录一次调用就再进包装器、无限自递归
                    //   (实测 RangeError: Maximum call stack size exceeded, 栈帧反复 at __obj.<computed>)。
                    //   约束: 安装前捕获 split/substring/toString, 一律用 Reflect.apply 调用,
                    //   数组用索引赋值, 结构用普通 for 循环 —— 不再触碰任何可被包装的原型方法。
                    //   另: 原 `calls:__count` 是安装瞬间的快照(恒 0), 已改为 getter 实时读。
                    //   __wrapper.__mcp_orig 保留原函数, 是后续"卸载/还原"入口的前提。
                    insCode = "(function(){var __targets=" + 选择 (insTarget == "", "['Function.prototype.apply','Function.prototype.call','Array.prototype.push','Array.prototype.pop','String.prototype.indexOf','String.prototype.charAt']", "['" + insEsc + "']") + ";var __ts=Function.prototype.toString,__split=String.prototype.split,__sub=String.prototype.substring;var __count=0;var __max=500;var __results=[];var __log=function(__t,__args){if(__count>=__max)return;var __s='',__n=__args.length,__li;for(__li=0;__li<__n;__li++){var __v=__args[__li];__s+=(__li?',':'')+((typeof __v==='string')?Reflect.apply(__sub,__v,[0,200]):typeof __v)}__results[__results.length]={target:__t,args:__s,ts:Date.now()};__count++};for(var __ti=0;__ti<__targets.length;__ti++){(function(__t){var __parts=Reflect.apply(__split,__t,['.']);var __obj=window;var __ok=1;for(var __pi=0;__pi<__parts.length-1;__pi++){__obj=__obj[__parts[__pi]];if(!__obj){__ok=0;break}}if(!__ok)return;var __method=__parts[__parts.length-1];var __orig=__obj[__method];if(typeof __orig!=='function')return;var __wrapper=function(){__log(__t,arguments);return Reflect.apply(__orig,this,arguments)};__wrapper.__mcp_orig=__orig;__wrapper.toString=function(){return Reflect.apply(__ts,__orig,[])};__obj[__method]=__wrapper})(__targets[__ti]);}var __pub={instrumented:__targets.length,results:__results};Object.defineProperty(__pub,'calls',{get:function(){return __count},enumerable:true});window.__mcp_instrument_results=__pub;return JSON.stringify({installed:true,targets:__targets.length,hint:'Transparent instrumentation installed. toString preserved. Use browser_evaluate \"JSON.stringify(window.__mcp_instrument_results)\" to read collected data. Trigger target action first.'})})()"
                }
                否则 (insMode == "interpreter")
                {
                    // 解释器模式: Hook switch-case / while-if VM分发器
                    // 日志存入 window.__mcp_interpreter_logs 供 browser_evaluate 读取
                    insCode = "(function(){var __orig=window['" + insEsc + "'];if(typeof __orig!=='function'){return JSON.stringify({error:'target_not_found',target:'" + insEsc + "'})};var __logs=window.__mcp_interpreter_logs=window.__mcp_interpreter_logs||[];var __maxCalls=100;window['" + insEsc + "']=function(){var __an=arguments.length,__args=[],__ai;for(__ai=0;__ai<__an;__ai++){__args[__ai]=arguments[__ai];}var __result=Reflect.apply(__orig,this,__args);if(__logs.length<__maxCalls){__logs[__logs.length]={target:'" + insEsc + "',args_preview:__args.map(function(a){return typeof a==='string'?a.substring(0,100):typeof a}).join('|'),ts:Date.now()}}return __result};window['" + insEsc + "'].toString=function(){return __orig.toString()};return JSON.stringify({installed:true,target:'" + insEsc + "',mode:'interpreter',hint:'VM interpreter hooked. toString preserved. Use browser_evaluate \"JSON.stringify(window.__mcp_interpreter_logs)\" to read collected data.'})})()"
                }
                否则
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知mode: " + insMode + " | 支持: transparent/interpreter"))
                }
                变量 insFrame <类型 = 类_FBrowser_框架>
                insFrame = MCP命令服务器.取安全主框架 (insBrowser)
                如果 (insFrame.是否为空 () == 假 && insFrame.是否有效 ())
                {
                    变量 异步InsID <类型 = 文本型>
                    异步InsID = MCP命令服务器.生成异步任务ID ()
                    变量 Ins回调 <类型 = 类_FBrowser_事件智能指针>
                    Ins回调.创建 (类_MCP_JS异步回调)
                    Ins回调.取执行类 (类_MCP_JS异步回调).任务ID = 异步InsID
                    insFrame.执行JS代码_带返回值 (insCode, "", 0, Ins回调)
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步InsID, "插桩已提交: mode=" + insMode + " | 通过mcp_result查询安装状态"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === JS逆向: 全局脚本搜索 (在所有已加载script中搜索关键词) ===
        否则 (方法名 == "browser_reverse_search")
        {
            变量 srQuery <类型 = 文本型>
            srQuery = MCP命令服务器.yyjson取文本 (参数JSON, "query")
            变量 srUrl <类型 = 文本型>
            srUrl = MCP命令服务器.yyjson取文本 (参数JSON, "script_url")
            如果 (srQuery == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "query 不能为空 | 搜索关键词: sign/encrypt/token/md5/aes"))
            }
            变量 srBrowser <类型 = 类_FBrowser_浏览器>
            srBrowser = MCP命令服务器.取主浏览器 ()
            如果 (srBrowser.是否为空 () == 假 && srBrowser.是否已关闭 () == 假)
            {
                变量 srCode <类型 = 文本型>
                srCode = "(function(){var q='" + MCP命令服务器.简单转义JS (srQuery) + "';var uf=" + 选择 (srUrl == "", "''", "'" + MCP命令服务器.简单转义JS (srUrl) + "'") + ";var ss=document.querySelectorAll('script');var R=[];ss.forEach(function(s,i){var src=s.src||'(inline)';if(uf&&src.indexOf(uf)===-1)return;var t=s.textContent||'';var lines=t.split('\\n');lines.forEach(function(l,li){if(l.indexOf(q)!==-1){R.push({script_index:i,src:src.substring(0,200),line:li+1,snippet:l.trim().substring(0,300)})}})});return JSON.stringify({query:q,found:R.length,results:R.slice(0,50)})})()"
                // 用 CDP Runtime.evaluate (sync-wait) 取值, 绕过不稳定的 CEF JS 回调
                变量 srWantedMS <类型 = 整数>
                srWantedMS = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)
                变量 srRaw <类型 = 文本型>
                srRaw = MCP命令服务器.CDP执行JS并等待 (srCode, srWantedMS, 真)
                如果 (srRaw == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "CDP Runtime.evaluate 超时(" + 到文本 (srWantedMS) + "ms) | 可重试或使用 async_only:true"))
                }
                变量 sr解析 <类型 = YYJSON只读对象类>
