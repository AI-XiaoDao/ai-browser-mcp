                srCode = srCode + "for(var i=0;i<ss.length&&out.length<MAX;i++){var t=ss[i].textContent||'';var pos=0;while((pos=t.indexOf(v,pos))!==-1&&out.length<MAX){var before=t.substring(Math.max(0,pos-100),pos);var after=t.substring(pos+v.length,pos+v.length+100);var line=1;for(var j=0;j<pos;j++){if(t.charAt(j)==='\\n')line++;}out.push({script:i,src:(ss[i].src||'inline').substring(0,200),line:line,index:pos,before:before,after:after});pos+=v.length;}}"
                srCode = srCode + "return JSON.stringify({count:out.length,refs:out});})()"
