                }
                变量 hmStore <类型 = 文本型>
                hmStore = MCP命令服务器.同步等待异步任务 (hmTaskID, hmWanted)
                如果 (hmStore == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "批量Hook超时"))
                }
                变量 hmWrap <类型 = YYJSON只读对象类>
                如果 (hmWrap.创建自文本 (hmStore))
                {
                    如果 (MCP命令服务器.yyjson取逻辑 (hmWrap, "success") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "Hook错误: " + MCP命令服务器.yyjson取文本 (hmWrap, "error")))
                    }
                    变量 hmMsg <类型 = 文本型>
                    hmMsg = MCP命令服务器.yyjson取文本 (hmWrap, "message")
