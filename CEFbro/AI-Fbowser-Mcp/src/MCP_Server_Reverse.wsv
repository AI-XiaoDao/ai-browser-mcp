            如果 (hmFuncs == "")
            {
                hmFuncs = MCP命令服务器.yyjson取JSON文本 (参数JSON, "functions")
            }
            变量 hmArr <类型 = YYJSON只读数组类>
            hmArr = MCP命令服务器.取JSON数组自文本 (hmFuncs, "functions")
            如果 (hmArr.是否为空对象 () || hmArr.取成员数 () == 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "functions 需要JSON数组: [\"fn1\",\"obj.fn2\"]"))
            }
            变量 hmBrowser <类型 = 类_FBrowser_浏览器>
