<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# MCP_逆向分派 — JS逆向+CDP Hook (v2.6.2)

类 MCP_逆向分派 <公开 @全局类 = 真 @输出名 = "MCPReverseDispatch">

{

    方法 分类分派_逆向操作 <公开 静态 类型 = 文本型 @输出名 = "DispatchClassReverseOp" @强制输出 = 真>

    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">

    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">

    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">

    {

        子文本替换 (方法名, "browser.", "browser_", , , 假)

        如果 (方法名 == "browser_reverse_profile")

        {

            变量 prAction <类型 = 文本型>

            prAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")

            如果 (prAction == "")

            {

                prAction = "start"

            }

            // 内核实测(本机, 全新进程):

            //   Profiler.stop (未 start)         -> No recording profiles found

            //   Profiler.enable 后 Profiler.stop -> 同样 No recording profiles found

            //   Profiler.start 后 Profiler.stop  -> {"profile":{"nodes":[...]}} 真实数据

            // 即 **enable 不等于 start**; 旧代码只调 enable, 采样从未开始, 而 stop 的错误又被

            // _async 回执吞成 success —— 整个工具族"看似成功、拿不到数据"。故此处全部改同步。

            如果 (prAction == "start")

            {

                变量 prEnRaw <类型 = 文本型>

                prEnRaw = MCP命令服务器.执行CDP并同步等待 (命令ID + "_en", "Profiler.enable", "{}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prEnRaw) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Profiler.enable 失败: " + MCP命令服务器.取CDP同步结果错误 (prEnRaw)))

                }

                变量 prStRaw <类型 = 文本型>

                prStRaw = MCP命令服务器.执行CDP并同步等待 (命令ID + "_st", "Profiler.start", "{}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prStRaw) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Profiler.start 失败: " + MCP命令服务器.取CDP同步结果错误 (prStRaw)))

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"start\",\"note\":\"采样已真正开始(enable+start): 执行目标操作后用 action=stop 取回 profile\"}"))

            }

            否则 (prAction == "start_precise")

            {

                // 注意顺序: setSamplingInterval 必须**先于** start 才生效

                // 约束: 本命令只认 interval; maxDepth 属另一命令的字段, 传了会被内核忽略, 故不传

                变量 prIntRaw <类型 = 文本型>

                prIntRaw = MCP命令服务器.执行CDP并同步等待 (命令ID + "_int", "Profiler.setSamplingInterval", "{\"interval\":100}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prIntRaw) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "setSamplingInterval 失败: " + MCP命令服务器.取CDP同步结果错误 (prIntRaw)))

                }

                变量 prEnRaw2 <类型 = 文本型>

                prEnRaw2 = MCP命令服务器.执行CDP并同步等待 (命令ID + "_en", "Profiler.enable", "{}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prEnRaw2) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Profiler.enable 失败: " + MCP命令服务器.取CDP同步结果错误 (prEnRaw2)))

                }

                变量 prStRaw2 <类型 = 文本型>

                prStRaw2 = MCP命令服务器.执行CDP并同步等待 (命令ID + "_st", "Profiler.start", "{}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prStRaw2) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Profiler.start 失败: " + MCP命令服务器.取CDP同步结果错误 (prStRaw2)))

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"start_precise\",\"interval_us\":100,\"note\":\"已按 100 微秒间隔开始剖析\"}"))

            }

            否则 (prAction == "stop")

            {

                变量 prStopRaw <类型 = 文本型>

                prStopRaw = MCP命令服务器.执行CDP并同步等待 (命令ID, "Profiler.stop", "{}", 30000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prStopRaw) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Profiler.stop 失败: " + MCP命令服务器.取CDP同步结果错误 (prStopRaw) + " | 若为 No recording profiles found, 说明本次没有先成功执行 action=start"))

                }

                // profile 是剖析主体(采样久了可达 MB 级): 截断但**明确标注**, 不静默丢数据

                变量 prProfile <类型 = 文本型>

                prProfile = ""

                变量 prWrap <类型 = YYJSON只读对象类>

                如果 (prWrap.创建自文本 (prStopRaw) == 真)

                {

                    prProfile = MCP命令服务器.yyjson取文本 (prWrap, "result")

                }

                变量 prLen <类型 = 整数>

                prLen = 取文本长度 (prProfile)

                变量 prCap <类型 = 整数>

                prCap = 200000

                如果 (prLen > prCap)

                {

                    prProfile = 取文本左边 (prProfile, prCap)

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"stop\",\"profile_total_chars\":" + 到文本 (prLen) + ",\"profile_truncated\":" + 选择 (prLen > prCap, "true", "false") + ",\"profile_result\":" + 选择 (prProfile == "", "null", prProfile) + "}"))

            }

            否则 (prAction == "query")

            {

                变量 prQryRaw <类型 = 文本型>

                prQryRaw = MCP命令服务器.执行CDP并同步等待 (命令ID, "Profiler.getBestEffortCoverage", "{}", 20000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (prQryRaw) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "getBestEffortCoverage 失败: " + MCP命令服务器.取CDP同步结果错误 (prQryRaw)))

                }

                变量 prCovText <类型 = 文本型>

                prCovText = ""

                变量 prCovWrap <类型 = YYJSON只读对象类>

                如果 (prCovWrap.创建自文本 (prQryRaw) == 真)

                {

                    prCovText = MCP命令服务器.yyjson取文本 (prCovWrap, "result")

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"query\",\"coverage_result\":" + 选择 (prCovText == "", "null", prCovText) + "}"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + prAction + " | 支持: start/start_precise/stop/query"))

        }

        否则 (方法名 == "browser_reverse_dom_breakpoint")

        {

            变量 dbType <类型 = 文本型>

            dbType = MCP命令服务器.yyjson取文本 (参数JSON, "type")

            如果 (dbType == "")

            {

                返回 (MCP_响应构建.命令失败 (命令ID, "需要 type 参数 | 支持: xhr/fetch/dom_event/timer(target:setTimeout/setInterval/默认requestAnimationFrame)"))

            }

            变量 dbTarget <类型 = 文本型>

            dbTarget = MCP命令服务器.yyjson取文本 (参数JSON, "target")

            如果 (dbType == "xhr" || dbType == "fetch")

            {

                变量 dbXhrParams <类型 = YYJSON对象类>

                dbXhrParams.创建自文本 ("{}")

                变量 dbUrl <类型 = 文本型>

                dbUrl = "*"

                如果 (dbTarget != "")

                {

                    dbUrl = dbTarget

                }

                dbXhrParams.加入文本成员 ("url", dbUrl)

                // 改同步: 内核无返回值, 但参数错误/域未启用会显式暴露(原先只回一句"CDP已提交")

                返回 (执行V8CDP命令 (命令ID, "DOMDebugger.setXHRBreakpoint", dbXhrParams.到可读文本 (YYJSON格式化选项.压缩), "XHR 断点已装上: 命中时页面暂停在该请求发起处; 用 browser_debugger_stack / browser_debugger_evaluate 看现场, 分析完务必 browser_debugger_resume"))

            }

            否则 (dbType == "dom_event")

            {

                如果 (dbTarget == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "dom_event需要target参数 | 事件名: click/submit/load/error/change"))

                }

                变量 dbDomParams <类型 = YYJSON对象类>

                dbDomParams.创建自文本 ("{}")

                dbDomParams.加入文本成员 ("eventName", dbTarget)

                返回 (执行V8CDP命令 (命令ID, "DOMDebugger.setEventListenerBreakpoint", dbDomParams.到可读文本 (YYJSON格式化选项.压缩), "事件监听断点已装上: 该类型事件被派发时页面暂停; 分析完务必 browser_debugger_resume"))

            }

            否则 (dbType == "timer")

            {

                变量 dbTimerEvent <类型 = 文本型>

                dbTimerEvent = "requestAnimationFrame"

                如果 (dbTarget == "setTimeout" || dbTarget == "setInterval")

                {

                    dbTimerEvent = dbTarget

                }

                变量 dbTimerParams <类型 = YYJSON对象类>

                dbTimerParams.创建自文本 ("{}")

                dbTimerParams.加入文本成员 ("eventName", dbTimerEvent)

                // 同步执行。附注: 本机实测 DOMDebugger 侧要的就是 eventName(Debugger 侧才用 instrumentation)。
                返回 (执行V8CDP命令 (命令ID, "DOMDebugger.setInstrumentationBreakpoint", dbTimerParams.到可读文本 (YYJSON格式化选项.压缩), "定时器插装断点已装上: setTimeout/setInterval/requestAnimationFrame 被调用时暂停; 分析完务必 browser_debugger_resume"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知type: " + dbType))

        }

        否则 (方法名 == "browser_reverse_cdp_hook")

        {

            变量 chFuncName <类型 = 文本型>

            chFuncName = MCP命令服务器.yyjson取文本 (参数JSON, "function_name")

            变量 chObjectId <类型 = 文本型>

            chObjectId = MCP命令服务器.yyjson取文本 (参数JSON, "object_id")

            如果 (chObjectId == "" && chFuncName == "")

            {

                返回 (MCP_响应构建.命令失败 (命令ID, "需要 object_id 或 function_name"))

            }

            如果 (chObjectId == "" && chFuncName != "")

            {

                // 通过函数名自动获取objectId: Runtime.evaluate → result.objectId (完整链路)

                变量 chEvalParams <类型 = YYJSON对象类>

                chEvalParams.创建自文本 ("{}")

                chEvalParams.加入文本成员 ("expression", chFuncName)

                chEvalParams.加入文本成员 ("objectGroup", "reverse_cdp_hook")

                chEvalParams.加入逻辑值成员 ("returnByValue", 假)

                chEvalParams.加入逻辑值成员 ("generatePreview", 假)

                变量 chEvalID <类型 = 文本型>

                // 必须用带自增计数器的 生成异步任务ID: 自拼 毫秒+4位随机数 在同毫秒并发时会碰撞并串读CDP结果

                chEvalID = "cdp_hook_eval_" + MCP命令服务器.生成异步任务ID ()

                变量 chEvalRes <类型 = 文本型>

                chEvalRes = MCP命令服务器.执行CDP并同步等待 (chEvalID, "Runtime.evaluate", chEvalParams.到可读文本 (YYJSON格式化选项.压缩), 8000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (chEvalRes))

                {

                    变量 chEvalParse <类型 = YYJSON只读对象类>

                    如果 (chEvalParse.创建自文本 (chEvalRes))

                    {

                        变量 chResultTxt <类型 = 文本型>

                        chResultTxt = MCP命令服务器.yyjson取文本 (chEvalParse, "result")

                        如果 (chResultTxt != "")

                        {

                            变量 chCdpParse <类型 = YYJSON只读对象类>

                            如果 (chCdpParse.创建自文本 (chResultTxt))

                            {

                                变量 chRemote <类型 = YYJSON只读对象类>

                                chRemote = chCdpParse.取对象 ("result")

                                如果 (chRemote.是否为空 () == 假)

                                {

                                    chObjectId = MCP命令服务器.yyjson取文本 (chRemote, "objectId")

                                }

                            }

                        }

                    }

                }

                如果 (chObjectId == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "无法获取函数 objectId | function_name: " + chFuncName + " | 确认该函数在全局作用域可直接访问, 或改用 browser_evaluate 取得 objectId 后传 object_id 参数"))

                }

            }

            变量 chCondition <类型 = 文本型>

            chCondition = MCP命令服务器.yyjson取文本 (参数JSON, "condition")

            变量 chParams <类型 = YYJSON对象类>

            chParams.创建自文本 ("{}")

            如果 (chObjectId != "")

            {

                // 内核实测(本机 A/B, 只换字段名, 句柄相同):

                //   {"objectId": ...}         -> {"breakpointId":"7:1"}                    接受

                //   {"functionObjectId": ...} -> Failed to deserialize params.objectId

                //                                 - mandatory field missing at position 51

                // 即该命令要的就是 **objectId**(原注释"要求 functionObjectId, 非 objectId"恰好写反,

                // 而这个参数名错误此前完全不可见 —— 因为工具走异步入口, 内核报错也被回成 success)

                chParams.加入文本成员 ("objectId", chObjectId)

            }

            如果 (chCondition != "")

            {

                chParams.加入文本成员 ("condition", chCondition)

            }

            // 改同步: 内核会回 breakpointId, 调用方需要它才能后续撤销该断点

            变量 chRes <类型 = 文本型>

            chRes = 执行V8CDP命令 (命令ID, "Debugger.setBreakpointOnFunctionCall", chParams.到可读文本 (YYJSON格式化选项.压缩), "函数调用断点已装上(cdp_result.breakpointId 可用 browser_cdp_call method=Debugger.removeBreakpoint 撤销); 该函数被调用时页面暂停, 分析完务必 browser_debugger_resume")

            // 幂等: 内核原话 "Breakpoint at specified location already exists" 说明该函数上**本来就有**

            // 函数调用断点 —— 目标状态已达成, 不是错误。报失败会诱导调用方改用别的注入方式反复尝试

            // (与 browser_debugger_resume 对"本来就没暂停"返回幂等成功是同一处理)。

            如果 (寻找文本 (chRes, "already exists", 0, 假) != -1)

            {

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"already_armed\":true,\"cdp_method\":\"Debugger.setBreakpointOnFunctionCall\",\"note\":\"幂等成功: 该函数上本来就有函数调用断点(内核原话 Breakpoint at specified location already exists), 目标状态已达成, 未重复安装。要撤销请用首次安装时返回的 breakpointId 调 Debugger.removeBreakpoint; 或 browser_debugger_enable action=disable 整体停用调试器域(会一并清掉全部断点)\"}"))

            }

            返回 (chRes)

        }

        否则 (方法名 == "browser_reverse_call_fn")

        {

            // 无浏览器预检: 避免CDP同步等待白等8秒后报误导性错误

            变量 cfBrowser预检 <类型 = 类_FBrowser_浏览器>

            cfBrowser预检 = MCP命令服务器.取主浏览器 ()

            如果 (cfBrowser预检.是否为空 () || cfBrowser预检.是否已关闭 ())

            {

                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))

            }

            变量 cfObjectId <类型 = 文本型>

            cfObjectId = MCP命令服务器.yyjson取文本 (参数JSON, "object_id")

            变量 cfFuncName <类型 = 文本型>

            cfFuncName = MCP命令服务器.yyjson取文本 (参数JSON, "function_name")

            // 宿主模式: 调用方同时传 object_id(宿主对象) + function_name(方法名) → this绑定宿主

            变量 cfHostMode <类型 = 逻辑型 值 = 假>

            如果 (cfObjectId != "" && cfFuncName != "")

            {

                cfHostMode = 真

            }

            // 纯算法直调: 支持 function_name, 自动 Runtime.evaluate 解析 objectId (免手动取 objectId)
            如果 (cfObjectId == "" && cfFuncName != "")

            {

                变量 cfEvalParams <类型 = YYJSON对象类>

                cfEvalParams.创建自文本 ("{}")

                cfEvalParams.加入文本成员 ("expression", cfFuncName)

                cfEvalParams.加入文本成员 ("objectGroup", "reverse_call_fn")

                cfEvalParams.加入逻辑值成员 ("returnByValue", 假)

                cfEvalParams.加入逻辑值成员 ("generatePreview", 假)

                变量 cfEvalID <类型 = 文本型>

                // 必须用带自增计数器的 生成异步任务ID: 自拼 毫秒+4位随机数 在同毫秒并发时会碰撞并串读CDP结果

                cfEvalID = "call_fn_eval_" + MCP命令服务器.生成异步任务ID ()

                变量 cfEvalRes <类型 = 文本型>

                cfEvalRes = MCP命令服务器.执行CDP并同步等待 (cfEvalID, "Runtime.evaluate", cfEvalParams.到可读文本 (YYJSON格式化选项.压缩), 8000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (cfEvalRes))

                {

                    变量 cfEvalParse <类型 = YYJSON只读对象类>

                    如果 (cfEvalParse.创建自文本 (cfEvalRes))

                    {

                        变量 cfResultTxt <类型 = 文本型>

                        cfResultTxt = MCP命令服务器.yyjson取文本 (cfEvalParse, "result")

                        如果 (cfResultTxt != "")

                        {

                            变量 cfCdpParse <类型 = YYJSON只读对象类>

                            如果 (cfCdpParse.创建自文本 (cfResultTxt))

                            {

                                变量 cfRemote <类型 = YYJSON只读对象类>

                                cfRemote = cfCdpParse.取对象 ("result")

                                如果 (cfRemote.是否为空 () == 假)

                                {

                                    cfObjectId = MCP命令服务器.yyjson取文本 (cfRemote, "objectId")

                                }

                            }

                        }

                    }

                }

                如果 (cfObjectId == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "无法获取函数 objectId | function_name: " + cfFuncName + " | 确认该函数在全局作用域可直接访问, 或改用 browser_cdp_call {method:'Runtime.evaluate', params:'{\"expression\":\"函数名\",\"returnByValue\":false}'} 取 objectId 后传 object_id"))

                }

            }

            如果 (cfObjectId == "")

            {

                返回 (MCP_响应构建.命令失败 (命令ID, "需要 object_id 或 function_name"))

            }

            // arguments: JSON数组内联进 functionDeclaration (规避CDP通道CBOR对arguments数组反序列化失败)

            // JSON字面量即合法JS字面量, 类型天然保留 (数字/逻辑值/null/嵌套结构原样)

            变量 cfArgsRaw <类型 = 文本型>

            cfArgsRaw = MCP命令服务器.yyjson取JSON文本 (参数JSON, "arguments")

            变量 cfArgsText <类型 = 文本型>

            cfArgsText = MCP命令服务器.yyjson取文本 (参数JSON, "args")

            如果 (cfArgsRaw == "" && cfArgsText != "")

            {

                cfArgsRaw = "[\"" + MCP_响应构建.JSON转义文本 (cfArgsText) + "\"]"

            }

            如果 (cfArgsRaw == "")

            {

                cfArgsRaw = "[]"

            }

            否则

            {

                // 前导/尾部空白修剪后再判断数组形态 (防" [1,2]"被误包装成数组套数组)

                cfArgsRaw = 删首尾空 (cfArgsRaw)

                如果 (是否以 (cfArgsRaw, "[") == 假)

                {

                    // 非数组JSON文本(裸字符串/数字/对象): 包装为单元素数组

                    // 防裸字符串被apply当类数组拆成单字符参数

                    cfArgsRaw = "[" + cfArgsRaw + "]"

                }

            }

            // functionDeclaration: 宿主模式this绑定宿主对象(方法内this依赖可用); 纯算法模式this=函数自身

            变量 cfDecl <类型 = 文本型>

            如果 (cfHostMode)

            {

                cfDecl = "function(){var __f=this['" + MCP命令服务器.简单转义JS (cfFuncName) + "'];return __f.apply(this," + cfArgsRaw + ")}"

            }

            否则

            {

                cfDecl = "function(){return this.apply(this," + cfArgsRaw + ")}"

            }

            变量 cfParamsText <类型 = 文本型>

            cfParamsText = "{\"objectId\":\"" + MCP_响应构建.JSON转义文本 (cfObjectId) + "\",\"functionDeclaration\":\"" + MCP_响应构建.JSON转义文本 (cfDecl) + "\",\"returnByValue\":true}"

            // 改用同步出口: 本工具**要返回函数返回值**, 走异步入口只会回「CDP已提交」而丢掉结果

            返回 (执行V8CDP命令 (命令ID, "Runtime.callFunctionOn", cfParamsText, "cdp_result 的 result.value 即该函数的返回值(本工具以 returnByValue=true 调用) | 若报 objectId 相关错误, 说明目标函数需要先由 browser_reverse_runtime 取到 objectId"))

        }

        否则 (方法名 == "browser_reverse_preload")

        {

            变量 plCode <类型 = 文本型>

            plCode = MCP命令服务器.yyjson取文本 (参数JSON, "code")

            如果 (plCode == "")

            {

                // 从 file 参数加载JS文件内容 (非直接用文件路径当源码)

                变量 plFile <类型 = 文本型>

                plFile = MCP命令服务器.yyjson取文本 (参数JSON, "file")

                如果 (plFile != "")

                {

                    如果 (MCP命令服务器.验证安全路径 (plFile, 真) == 假)

                    {

                        返回 (MCP_响应构建.命令失败 (命令ID, "文件路径不合法: " + plFile + " | 允许范围: 进程运行目录内的路径(且不得含 ..); 请把文件放到运行目录下再试"))

                    }

                    // 读入前先取文件大小预检: 超大文件不整读进内存后再拒绝

                    变量 pl预检大小 <类型 = 长整数>

                    @ {

                    @     WIN32_FILE_ATTRIBUTE_DATA fd;

                    @     @<pl预检大小> = (GetFileAttributesExW(@<plFile>.GetText(), GetFileExInfoStandard, &fd) && !(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))

                    @         ? ((LONGLONG)fd.nFileSizeHigh << 32) | (LONGLONG)(DWORD)fd.nFileSizeLow : -1;

                    @ }

                    如果 (pl预检大小 > 2097152)

                    {

                        返回 (MCP_响应构建.命令失败 (命令ID, "JS文件过大(" + 到文本 (pl预检大小) + "字节), 上限2MB"))

                    }

                    变量 plFileBytes <类型 = 字节集类>

                    plFileBytes = 读入文件 (plFile)

                    如果 (取字节集长度 (plFileBytes) > 2097152)

                    {

                        // 预检失败(-1)时的兜底校验

                        返回 (MCP_响应构建.命令失败 (命令ID, "JS文件过大(" + 到文本 (取字节集长度 (plFileBytes)) + "字节), 上限2MB"))

                    }

                    如果 (取字节集长度 (plFileBytes) > 0)

                    {

                        plCode = UTF8到文本 (plFileBytes)

                    }

                    否则

                    {

                        // 区分"文件读取失败/为空"与"参数缺失", 避免误导排查方向

                        返回 (MCP_响应构建.命令失败 (命令ID, "文件读取失败或文件为空: " + plFile))

                    }

                }

            }

            如果 (plCode == "")

            {

                返回 (MCP_响应构建.命令失败 (命令ID, "需要 code(JS代码) 或 file(JS文件路径)"))

            }

            变量 plParams <类型 = YYJSON对象类>

            plParams.创建自文本 ("{}")

            plParams.加入文本成员 ("source", plCode)

            plParams.加入逻辑值成员 ("runImmediately", 真)

            // ★ 零前置(实测强制): **必须先启用 Page 域**, 否则 `Page.addScriptToEvaluateOnNewDocument`
            //   在本机会返回 success + identifier, 但注册进去的脚本**永不执行** —— 三臂对照实测:
            //   只注册 → 导航后哨兵 undefined; 先 Page.enable 再注册 → 哨兵 C1。(注册本身不拖慢 JS 通道。)
            变量 pl域结果 <类型 = 文本型>
            pl域结果 = 执行V8CDP命令 (命令ID + "_pe", "Page.enable", "{}", "Page 域已启用")
            如果 (MCP命令服务器.CDP同步结果是否成功 (pl域结果) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "Page.enable 失败, 预注入无法生效: " + MCP命令服务器.取CDP同步结果错误 (pl域结果) + " | 实测: 不先启用 Page 域时注册会回 success 但脚本永不执行, 故此处直接失败而不是给你一个假成功"))
            }
            MCP_响应构建.记录自动补域 ("Page")
            // 改同步: 内核会回 identifier(脚本句柄), 调用方需要它才能后续移除该预注入脚本

            返回 (执行V8CDP命令 (命令ID, "Page.addScriptToEvaluateOnNewDocument", plParams.到可读文本 (YYJSON格式化选项.压缩), "预注入脚本已注册(每次新文档创建前执行); cdp_result.identifier 即脚本句柄, 可用 browser_cdp_call method=Page.removeScriptToEvaluateOnNewDocument 撤销; 要立刻看到效果请 browser_reload"))

        }

        否则 (方法名 == "browser_reverse_websocket")

        {

            变量 wsAction <类型 = 文本型>

            wsAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")

            如果 (wsAction == "")

            {

                wsAction = "enable"

            }

            如果 (wsAction == "enable")

            {

                // Network.enable 仅需调用一次 (附带 maxPostDataSize)

                // 改同步: 让域启用失败显式暴露(原先一律"CDP已提交")

                返回 (执行V8CDP命令 (命令ID, "Network.enable", "{\"maxPostDataSize\":65536}", "Network 域已启用: 可配合 browser_kernel_cdp_monitor / browser_cdp_event 观察 Network.* 事件"))

            }

            否则 (wsAction == "query")

            {

                // Network.getResponseBody 必须提供 requestId 参数

                变量 wsReqId <类型 = 文本型>

                wsReqId = MCP命令服务器.yyjson取文本 (参数JSON, "request_id")

                如果 (wsReqId == "")

                {

                    wsReqId = MCP命令服务器.yyjson取文本 (参数JSON, "requestId")

                }

                如果 (wsReqId == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "query 需要 request_id (从Network.requestWillBeSent事件获取)"))

                }

                变量 wsQueryParams <类型 = YYJSON对象类>

                wsQueryParams.创建自文本 ("{}")

                wsQueryParams.加入文本成员 ("requestId", wsReqId)

                // 改用同步出口: query 的**全部价值就是拿回响应体**, 异步入口会把 body 丢掉

                返回 (执行V8CDP命令 (命令ID, "Network.getResponseBody", wsQueryParams.到可读文本 (YYJSON格式化选项.压缩), "cdp_result 含 body(响应体文本) 与 base64Encoded(是否base64); 报 No resource with given identifier 说明该请求已不在缓存中(需在请求发生后尽快取)"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + wsAction + " | 支持: enable/query"))

        }

        否则 (方法名 == "browser_reverse_heap")

        {

            变量 hpAction <类型 = 文本型>

            hpAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")

            如果 (hpAction == "")

            {

                hpAction = "snapshot"

            }

            如果 (hpAction == "snapshot")

            {

                // 改同步: 原先快照失败也报"CDP已提交"; 数据经 addHeapSnapshotChunk 事件送达

                返回 (执行V8CDP命令 (命令ID, "HeapProfiler.takeHeapSnapshot", "{\"reportProgress\":false}", "堆快照已开始采集(数据经 HeapProfiler.addHeapSnapshotChunk 事件分片送达, 本命令无返回值)"))

            }

            否则 (hpAction == "start_sampling")

            {

                // 改同步: 采样参数错误应显式暴露

                返回 (执行V8CDP命令 (命令ID, "HeapProfiler.startSampling", "{\"samplingInterval\":32768}", "内存采样已开始: 操作目标一段时间后调 action=stop_sampling 取回 profile"))

            }

            否则 (hpAction == "stop_sampling")

            {

                // 改用同步出口: stopSampling **返回剖析结果**, 异步入口会丢掉它

                返回 (执行V8CDP命令 (命令ID, "HeapProfiler.stopSampling", "{}", "cdp_result 的 profile 即本次内存采样剖析结果 | 若报 No sampling profile 说明没有先执行 action=start_sampling"))

            }

            否则 (hpAction == "get_object")

            {

                变量 hpObjId <类型 = 文本型>

                hpObjId = MCP命令服务器.yyjson取文本 (参数JSON, "object_id")

                如果 (hpObjId == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "get_object 需要 object_id"))

                }

                变量 hpObjParams <类型 = YYJSON对象类>

                hpObjParams.创建自文本 ("{}")

                hpObjParams.加入文本成员 ("objectId", hpObjId)

                hpObjParams.加入文本成员 ("objectGroup", "reverse_heap")

                // 改用同步出口: get_object **返回对象描述**, 异步入口会丢掉它

                返回 (执行V8CDP命令 (命令ID, "HeapProfiler.getObjectByHeapObjectId", hpObjParams.到可读文本 (YYJSON格式化选项.压缩), "cdp_result 的 object 为该堆对象的描述(含 className/description) | object_id 从 action=snapshot 的堆快照或 browser_reverse_runtime 的 objectId 获得"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + hpAction + " | 支持: snapshot/start_sampling/stop_sampling/get_object"))

        }

        否则 (方法名 == "browser_reverse_runtime")

        {

            变量 rtAction <类型 = 文本型>

            rtAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")

            如果 (rtAction == "")

            {

                // ★ 修(零前置/一次成功): 文档写"默认properties", 但 properties **必填 object_id** ——

                //   于是空参调用永远失败(实测 browser_reverse_runtime {} -> "properties 需要 object_id")。

                //   对 AI 调用方这就是"第一次调用必失败、再换个方法试", 正是用户抱怨的来源。

                //   契约: 按调用方已给的关键参数**自动选一个可用的动作**, 并如实经 auto_prepared 上报。
                如果 (MCP命令服务器.参数键存在 (参数JSON, "object_id"))

                {

                    rtAction = "properties"

                }

                否则 (MCP命令服务器.参数键存在 (参数JSON, "expression"))

                {

                    rtAction = "evaluate"

                    MCP_响应构建.记录自动处理 ("browser_reverse_runtime 未传 action 但给了 expression: 已自动选 evaluate(默认的 properties 需要 object_id 会直接失败)")

                }

                否则

                {

                    rtAction = "global"

                    MCP_响应构建.记录自动处理 ("browser_reverse_runtime 未传 action 且未给 object_id/expression: 已自动改走 global(无需任何参数); 要按对象取属性请传 object_id, 要执行表达式请传 expression")

                }

            }

            如果 (rtAction == "properties")

            {

                变量 rtObjId <类型 = 文本型>

                rtObjId = MCP命令服务器.yyjson取文本 (参数JSON, "object_id")

                如果 (rtObjId == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "properties 需要 object_id"))

                }

                变量 rtParams <类型 = YYJSON对象类>

                rtParams.创建自文本 ("{}")

                rtParams.加入文本成员 ("objectId", rtObjId)

                rtParams.加入逻辑值成员 ("ownProperties", 真)

                rtParams.加入逻辑值成员 ("generatePreview", 真)

                // 改用同步出口: properties 的**全部价值就是拿回属性列表**, 异步入口会丢掉它

                返回 (执行V8CDP命令 (命令ID, "Runtime.getProperties", rtParams.到可读文本 (YYJSON格式化选项.压缩), "cdp_result 的 result 数组即该对象的自有属性(每项含 name/value/objectId); 带 objectId 的属性可继续用本工具下钻或以 browser_reverse_call_fn 调用"))

            }

            否则 (rtAction == "evaluate")

            {

                变量 rtExpr <类型 = 文本型>

                rtExpr = MCP命令服务器.yyjson取文本 (参数JSON, "expression")

                如果 (rtExpr == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "evaluate 需要 expression"))

                }

                // return_by_value 可选 (默认true); 传false返回objectId, 供 browser_reverse_call_fn 直接调用

                // 兼容真布尔(schema声明boolean)与文本"false"/"0"两种传参

                变量 rbvVal <类型 = 逻辑型>

                rbvVal = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "return_by_value", 真)

                变量 rtEvalParams <类型 = YYJSON对象类>

                rtEvalParams.创建自文本 ("{}")

                rtEvalParams.加入文本成员 ("expression", rtExpr)

                rtEvalParams.加入逻辑值成员 ("returnByValue", rbvVal)

                rtEvalParams.加入逻辑值成员 ("generatePreview", 真)

                // 改用同步出口: evaluate **必须把求值结果带回来** —— 否则调用方只会看到

                // 「CDP已提交:Runtime.evaluate」而拿不到值, 只能反复换工具重试(实证: 台账里本工具

                // 以 action=evaluate 记录成 pass, 但回包里根本没有 1+1 的结果)。

                返回 (执行V8CDP命令 (命令ID, "Runtime.evaluate", rtEvalParams.到可读文本 (YYJSON格式化选项.压缩), "cdp_result 的 result 即求值结果: 默认 returnByValue=true 时给 type/value, 传 return_by_value=false 时给 objectId(可直接喂给 browser_reverse_call_fn / properties)"))

            }

            否则 (rtAction == "global")

            {

                // 改用同步出口: 本 action **返回全局名字列表**, 异步入口会丢掉它

                返回 (执行V8CDP命令 (命令ID, "Runtime.globalLexicalScopeNames", "{}", "cdp_result 的 names 即全局词法作用域中的变量/函数名(混淆脚本里可据此快速发现可疑入口函数)"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + rtAction + " | 支持: properties/evaluate/global"))

        }

        否则 (方法名 == "browser_reverse_network_intercept")

        {

            变量 niAction <类型 = 文本型>

            niAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")

            如果 (niAction == "")

            {

                niAction = "enable"

            }

            如果 (niAction == "enable")

            {

                // 内核实测(本机 browser_cdp_call 原始返回, 勿凭协议文档想当然):

                //   {"patterns":["*"]} -> Failed to deserialize params.patterns - CBOR: map start expected

                //   {}                 -> Failed to deserialize params.patterns - mandatory field missing

                //   {"patterns":[{"urlPattern":"*"}]} -> {} 接受

                // 结论: patterns 必须是"对象数组"(元素为 RequestPattern), 裸字符串会被拒。

                // 又因 touchPoints 同款约束(数组套对象用 yyjson 加入数组成员 会 0xC0000005),
                // 这里按项目既定做法**纯文本拼接**参数, 不建 yyjson 嵌套结构。

                变量 niPattern <类型 = 文本型>

                niPattern = MCP命令服务器.yyjson取文本 (参数JSON, "url_pattern")

                如果 (niPattern == "")

                {

                    // 刻意不默认"拦截全部": 本项目没有放行通道, 拦下的请求无人放行会把页面整体卡死,

                    // 比直接报错更难恢复。要求显式给模式, 把选择权交回调用方。

                    返回 (MCP_响应构建.命令失败 (命令ID, "enable 需要 url_pattern: 请显式给出要拦截的 URL 模式(如 */api/* 或 *sign*)。提示: 放行被拦请求用 browser_cdp_call method=Network.continueInterceptedRequest; 整体解除用 action=disable"))

                }

                变量 niParamsText <类型 = 文本型>

                niParamsText = "{\"patterns\":[{\"urlPattern\":\"" + MCP_响应构建.JSON转义文本 (niPattern) + "\",\"requestStage\":\"Request\"}]}"

                // 用同步等待拿内核真实结果: 旧代码走 执行逆向CDP命令 只回 _async 回执,

                // 参数形状错也报 success=true, 这正是本缺陷长期不可见的根因。

                变量 niRes <类型 = 文本型>

                niRes = MCP命令服务器.执行CDP并同步等待 (命令ID, "Network.setRequestInterception", niParamsText, 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (niRes) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "Network.setRequestInterception 失败: " + MCP命令服务器.取CDP同步结果错误 (niRes)))

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"enable\",\"url_pattern\":\"" + MCP_响应构建.JSON转义文本 (niPattern) + "\",\"note\":\"拦截已启用: 匹配该模式的请求会被挂起, 必须放行(Network.continueInterceptedRequest)否则页面卡住; action=disable 可整体解除\"}"))

            }

            否则 (niAction == "disable")

            {

                // {"patterns":[]} 实测被接受(空列表=整体解除拦截)

                变量 niOffRes <类型 = 文本型>

                niOffRes = MCP命令服务器.执行CDP并同步等待 (命令ID, "Network.setRequestInterception", "{\"patterns\":[]}", 10000)

                如果 (MCP命令服务器.CDP同步结果是否成功 (niOffRes) == 假)

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "解除拦截失败: " + MCP命令服务器.取CDP同步结果错误 (niOffRes)))

                }

                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"disable\",\"note\":\"拦截已解除, 被挂起的请求会恢复\"}"))

            }

            返回 (MCP_响应构建.命令失败 (命令ID, "未知action: " + niAction + " | 支持: enable/disable"))

        }

        // === 逆向定位/解密能力 (内核JS通道同步返回) ===

        否则 (方法名 == "browser_reverse_scan_crypto")

        {

            // 加密算法特征扫描: MD5/AES/SHA/XOR/自定义base64表/RSA 特征定位

            变量 scBrowser <类型 = 类_FBrowser_浏览器>

            scBrowser = MCP命令服务器.取主浏览器 ()

            如果 (scBrowser.是否为空 () == 假 && scBrowser.是否已关闭 () == 假)

            {

                变量 scCode <类型 = 文本型>

                scCode = "(function(){var FE={md5:['67452301','0123456789abcdef'],aes:['637c777bf26b6fc5','63,0x7c,0x77,0x7b'],sha:['6a09e667','bb67ae85'],cryptojs:['CryptoJS'],custom_b64:['ABCDEFGHIJKLMNOPQRSTUVWXYZ'],rsa:['modulus','BigInt'],xor:[]};var out=[];var ss=document.querySelectorAll('script');"

                scCode = scCode + "for(var i=0;i<ss.length;i++){var t=ss[i].textContent||'';if(t.length<50)continue;var found={};"

                scCode = scCode + "if(t.indexOf('67452301')!==-1||(t.indexOf('0123456789abcdef')!==-1&&t.indexOf('0123456789abcdefghijklmnopqrstuvwxyz')===-1))found.md5=1;"

                scCode = scCode + "if(t.indexOf('637c777b')!==-1||t.indexOf('63,0x7c,0x77')!==-1)found.aes=1;"

                scCode = scCode + "if(t.indexOf('6a09e667')!==-1||t.indexOf('bb67ae85')!==-1)found.sha=1;"

                scCode = scCode + "if(t.indexOf('CryptoJS')!==-1)found.cryptojs=1;"

                scCode = scCode + "var b64t=t.match(/[A-Za-z0-9+/]{64,}={0,2}/);if(b64t&&b64t[0].indexOf('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/')===-1)found.custom_b64=b64t[0].substring(0,64);"

                scCode = scCode + "if(t.indexOf('modulus')!==-1&&t.indexOf('BigInt')!==-1)found.rsa=1;"

                scCode = scCode + "var keys=Object.keys(found);if(keys.length){out.push({script:i,src:(ss[i].src||'inline').substring(0,200),len:t.length,found:found});}}"

                scCode = scCode + "return JSON.stringify({count:out.length,scripts:out});})()"

                变量 scWanted <类型 = 整数>

                scWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)

                变量 scTaskID <类型 = 文本型>

                scTaskID = MCP命令服务器.生成异步任务ID ()

                变量 scSubmit <类型 = 文本型>

                scSubmit = MCP命令服务器.提交异步JS任务 (scBrowser, scCode, scTaskID)

                如果 (是否以 (scSubmit, "{\"error\""))

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_主框架无效))

                }

                变量 scStore <类型 = 文本型>

                scStore = MCP命令服务器.同步等待异步任务 (scTaskID, scWanted)

                如果 (scStore == "")

                {

                    返回 (MCP_响应构建.命令失败 (命令ID, "加密特征扫描超时 | 页面脚本过多, 可先browser_wait等加载完成"))

                }

                变量 scWrap <类型 = YYJSON只读对象类>

                如果 (scWrap.创建自文本 (scStore))

