                否则
                {
                    // 兼容数组型日志(__MCP_*_LOG__)与对象型结果(__mcp_instrument_results 等 {results:[...]})
                    // 逐项安全序列化: 循环引用/函数条目不导致整个查询失败
                    hlCode = "(function(){var k='" + hlEsc + "';var v=window[k];var items=[];var total=0;if(Array.isArray(v)){total=v.length;items=v.slice(Math.max(0,v.length-200));}else if(v&&typeof v==='object'&&Array.isArray(v.results)){total=v.results.length;items=v.results.slice(Math.max(0,v.results.length-200));}else if(v!==undefined){total=1;items=[v];}var safe=[];for(var i=0;i<items.length;i++){try{safe.push(JSON.parse(JSON.stringify(items[i])))}catch(e){try{safe.push(String(items[i]).substring(0,300))}catch(e2){safe.push('[unserializable]')}}}try{return JSON.stringify({count:total,returned:safe.length,items:safe})}catch(e){return JSON.stringify({count:total,returned:0,items:[],error:'serialize_failed'})}})()"
                }
