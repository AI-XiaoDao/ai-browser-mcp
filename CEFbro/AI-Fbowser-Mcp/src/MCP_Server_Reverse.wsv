        否则 (方法名 == "browser_reverse_detect_obfuscator")
        {
            // 混淆器识别: obfuscator.io/JSVMP/JsJiami/sojson/自定义编码 特征检测
            变量 doBrowser <类型 = 类_FBrowser_浏览器>
            doBrowser = MCP命令服务器.取主浏览器 ()
            如果 (doBrowser.是否为空 () == 假 && doBrowser.是否已关闭 () == 假)
            {
                变量 doCode <类型 = 文本型>
                doCode = "(function(){var det=[];var total='';var ss=document.querySelectorAll('script');for(var i=0;i<ss.length;i++){total+=(ss[i].textContent||'')+'\\n';}"
                doCode = doCode + "if(total.indexOf('jsjiami.com')!==-1)det.push({type:'jsjiami',confidence:0.95});"
                doCode = doCode + "if(total.indexOf('sojson')!==-1)det.push({type:'sojson',confidence:0.9});"
                doCode = doCode + "if(total.indexOf('_0x')!==-1&&/_0x[0-9a-f]{4,5}/.test(total)&&/function\\s+_0x[0-9a-f]/.test(total))det.push({type:'obfuscator.io',confidence:0.85});"
                doCode = doCode + "var sw=total.match(/switch\\s*\\([^)]*\\)\\s*\\{[\\s\\S]{0,200}?case\\s+0x[0-9a-f]+:/);if(sw)det.push({type:'jsvmp_like(大switch状态机)',confidence:0.7});"
                doCode = doCode + "var b64t=total.match(/[A-Za-z0-9+/]{64,}={0,2}/);if(b64t&&b64t[0].indexOf('ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/')===-1)det.push({type:'custom_encoding(自定义编码表)',confidence:0.8,table:b64t[0].substring(0,64)});"
                doCode = doCode + "var hexarr=total.match(/\\[[\\s]*('|\")[0-9a-f]{2,}(\\1)[\\s]*,/);if(hexarr&&total.indexOf('charCodeAt')!==-1)det.push({type:'hex_string_array(十六进制字符串数组)',confidence:0.6});"
                doCode = doCode + "return JSON.stringify({detected:det.length,items:det,total_len:total.length});})()"
