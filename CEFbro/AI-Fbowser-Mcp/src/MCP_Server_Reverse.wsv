        否则 (方法名 == "browser_reverse_string_refs")

        {

            // 字符串引用定位: 指定字符串在哪些脚本的哪个位置出现 (定位密钥/常量使用点)

            变量 srValue <类型 = 文本型>

            srValue = MCP命令服务器.yyjson取文本 (参数JSON, "value")

            如果 (srValue == "")

            {

                返回 (MCP_响应构建.命令失败 (命令ID, "value " + MCP_常量.错误_缺少参数))

            }

            变量 srBrowser <类型 = 类_FBrowser_浏览器>

            srBrowser = MCP命令服务器.取主浏览器 ()

            如果 (srBrowser.是否为空 () == 假 && srBrowser.是否已关闭 () == 假)

            {

                变量 srMax <类型 = 整数>

                srMax = MCP命令服务器.yyjson取整数 (参数JSON, "max_results")

                如果 (srMax <= 0 || srMax > 50)

                {

                    srMax = 20

                }

                变量 srEsc <类型 = 文本型>

                srEsc = MCP命令服务器.简单转义JS (srValue)

                变量 srCode <类型 = 文本型>

                srCode = "(function(){var v='" + srEsc + "';var MAX=" + 到文本 (srMax) + ";var out=[];var ss=document.querySelectorAll('script');"

                srCode = srCode + "for(var i=0;i<ss.length&&out.length<MAX;i++){var t=ss[i].textContent||'';var pos=0;while((pos=t.indexOf(v,pos))!==-1&&out.length<MAX){var before=t.substring(Math.max(0,pos-100),pos);var after=t.substring(pos+v.length,pos+v.length+100);var line=1;for(var j=0;j<pos;j++){if(t.charAt(j)==='\\n')line++;}out.push({script:i,src:(ss[i].src||'inline').substring(0,200),line:line,index:pos,before:before,after:after});pos+=v.length;}}"

                srCode = srCode + "return JSON.stringify({count:out.length,refs:out});})()"

                变量 srWanted <类型 = 整数>

                srWanted = MCP命令服务器.取同步等待毫秒 (方法名, 参数JSON)

                变量 srTaskID <类型 = 文本型>

