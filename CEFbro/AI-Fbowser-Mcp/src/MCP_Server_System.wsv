<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# MCP_系统分派 — 从 MCP_Server.wsv 拆分 (L5)

类 MCP_系统分派 <公开 @全局类 = 真 @输出名 = "MCPSystemDispatch">
{
    方法 分类分派_系统操作 <公开 静态 类型 = 文本型 @输出名 = "DispatchClassSystem" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        子文本替换 (方法名, "browser.", "browser_", , , 假)
        // VIP 标签页入口: 本项目**不开放**远程建标签页(见 browser_create_tab 的守卫与替代方案)
        如果 (方法名 == "browser_create_tab")
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "⛔ 远程创建标签页已禁用 | 原因: 本工具**刻意不实现**(项目未开放远程建标签页入口) —— 旧文案称「GUI窗口自动管理浏览器实例」, 而本项目是控制台程序、并无 GUI 管理窗口(该前提已按代码事实推翻), 故不再拿不存在的东西当理由 | 替代方案: 使用 browser_navigate 在当前浏览器导航, 或 browser_create 创建新的独立浏览器窗口"))
        }
        否则 (方法名 == "browser_task_runner_post")
        {
            返回 (MCP_响应构建.命令失败 (命令ID, "⛔ 远程 task_runner 创建浏览器已禁用 | 原因: 本工具**刻意不实现**(项目未开放该入口; 旧文案称「GUI窗口自动管理浏览器实例」与代码事实不符, 已更正) | 替代方案: 使用现有 browser_id 操作已有浏览器, 或使用 browser_create"))
        }
        // === 其他工具 ===
        否则 (方法名 == "browser_send_message")
        {
            变量 msgName <类型 = 文本型>
            msgName = MCP命令服务器.yyjson取文本 (参数JSON, "name")
            如果 (msgName == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "name " + MCP_常量.错误_缺少参数))
            }
            变量 msgData <类型 = 文本型>
            msgData = MCP命令服务器.yyjson取文本 (参数JSON, "data")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // 发送数据_到主进程 为渲染进程专用API(主进程调用恒失败);
                // 主进程应经 发送数据_到全部渲染进程 下发, 渲染侧由 进程间消息_收到主进程消息 事件接收
                browser.进程间消息_发送数据_到全部渲染进程 (msgName, 文本到UTF8 (msgData, 假))
                返回 (MCP_响应构建.命令成功 (命令ID, "已向全部渲染进程发送消息"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 系统全局 (VIP 已拆分至 MCP_Server_VIP.wsv) ===
        如果 (方法名 == "browser_startup_args")
        {
            变量 启动回执action <类型 = 文本型>
            启动回执action = "get"
            如果 (参数JSON.是否为空 () == 假)
            {
                启动回执action = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            }
            如果 (启动回执action == "list")
            {
                返回 (MCP_响应构建.构建简单JSON ("applied_switches", MCP命令服务器.命令行开关已应用))
            }
            变量 启动回执 <类型 = YYJSON对象类>
            启动回执.创建自文本 ("{}")
            启动回执.加入逻辑值成员 ("success", 真)
            启动回执.加入文本成员 ("applied_switches", MCP命令服务器.命令行开关已应用)
            启动回执.加入文本成员 ("command_line_raw", MCP命令服务器.命令行开关原文)
            启动回执.加入逻辑值成员 ("cmdline_available", MCP命令服务器.命令行对象可用)
            启动回执.加入文本成员 ("name_value_switches", MCP命令服务器.启动开关_名值表)
            启动回执.加入文本成员 ("rejected_switches", MCP命令服务器.启动开关_被拒表)
            启动回执.加入逻辑值成员 ("enable_cross_frame", MCP命令服务器.启动开关_启用跨框架操作模式)
            启动回执.加入逻辑值成员 ("disable_proxy", MCP命令服务器.启动开关_禁用代理)
            启动回执.加入逻辑值成员 ("dpi_aware", MCP命令服务器.启动DPI感知模式)
            启动回执.加入整数成员 ("v8_max_stack_mb", MCP命令服务器.V8堆栈上限MB)
            启动回执.加入文本成员 ("note", "启动开关只在启动期由 启动类.即将处理命令行 施加, 运行期无法补做; 改了 mcp_config.json 必须重启进程才生效; applied_switches 为空时看 cmdline_available 判断是没配开关还是命令行对象拿不到")
            返回 (启动回执.到可读文本 (YYJSON格式化选项.压缩))
        }
        如果 (方法名 == "browser_get_global_cache_dir")
        {
            // G8: 缓存目录真值取自类库(无参读取器), 不硬编码 —— stdio 分支用 GlobalData_Stdio, 硬编码会静默返回错值
            // 依据: main.wsv 启动时按 是否为Stdio模式 分流, 写入 设置.缓存目录
            // 约束: 取路径只能按 main.wsv 启动分支的**同一个开关**推导, 不能硬编码 ——
            // stdio/headless 实例用的是 CacheData 下的 GlobalData_Stdio, 硬编码 GlobalData 会给出一个"真实存在
            // 但属于另一个实例"的路径(最难发现的一类错值: 连存在性校验都通不出问题)。
            // 注: 类库 FBrowser_取初始化缓存目录() 本机**编译不过**(FBroLib.v:155 error C3861 IsEmpty),
            // 故此处不做类库读取, 而是如实标注取值来源 cache_dir_source, 让调用方知道这是推导值而非内核回报值。
            变量 是否Stdio <类型 = 逻辑型>
            是否Stdio = MCPStdio桥.是否为Stdio模式 ()
            变量 全局缓存目录 <类型 = 文本型>
            如果 (是否Stdio)
            {
            全局缓存目录 = 取运行目录 () + "\\CacheData\\GlobalData_Stdio"
            }
            否则
            {
            全局缓存目录 = 取运行目录 () + "\\CacheData\\GlobalData"
            }
            变量 缓存目录来源 <类型 = 文本型>
            缓存目录来源 = "derived: 与 main.wsv 同一开关(是否为Stdio模式), 非内核回报值"
            // 规整双分隔符: 取运行目录() 结尾自带路径分隔符, 再拼 "\CacheData\GlobalData" 会得到 "\\"
            // 而内核回报的活体路径是单分隔符 —— 字面不等会让调用方无法直接比较(Windows 虽容忍, 但对照会失败)。
            变量 规整缓存目录 <类型 = 文本型>
            规整缓存目录 = 全局缓存目录
            子文本替换 (规整缓存目录, "\\\\", "\\", , , 假)
            全局缓存目录 = 规整缓存目录
            变量 缓存目录JSON <类型 = YYJSON对象类>
            缓存目录JSON.创建自文本 ("{}")
            缓存目录JSON.加入逻辑值成员 ("success", 真)
            缓存目录JSON.加入文本成员 ("global_cache_dir", 全局缓存目录)
            缓存目录JSON.加入文本成员 ("cache_dir_source", 缓存目录来源)
            返回 (缓存目录JSON.到可读文本 (YYJSON格式化选项.压缩))
        }
        // === 查询进程类型 ===
        否则 (方法名 == "browser_get_process_type")
        {
            变量 进程类型值 <类型 = 整数>
            进程类型值 = FBrowser_进程_取当前进程类型 ()
            返回 (MCP_响应构建.构建简单JSON ("process_type", 到文本 (进程类型值)))
        }
        // === 窗口风格 ===
        否则 (方法名 == "browser_get_window_style")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                返回 (MCP_响应构建.构建简单JSON ("style", 到文本 (browser.取窗口属性 (MCP_常量.窗口样式_GWL_STYLE))))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_set_window_style")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                // type(GWL索引)白名单校验, 任意值透传SetWindowLongPtr静默失败无反馈
                变量 窗口类型 <类型 = 整数>
                窗口类型 = MCP命令服务器.yyjson取整数 (参数JSON, "type")
                如果 (窗口类型 != MCP_常量.窗口样式_GWL_STYLE && 窗口类型 != MCP_常量.窗口样式_GWL_EXSTYLE && 窗口类型 != MCP_常量.窗口样式_GWL_ID)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "非法窗口属性类型(" + 到文本 (窗口类型) + ") | 支持: " + 到文本 (MCP_常量.窗口样式_GWL_STYLE) + "(GWL_STYLE) / " + 到文本 (MCP_常量.窗口样式_GWL_EXSTYLE) + "(GWL_EXSTYLE) / " + 到文本 (MCP_常量.窗口样式_GWL_ID) + "(GWL_ID)"))
                }
                // 后果严重且难以恢复, 故缺参必须拒绝。
                如果 (MCP命令服务器.参数键存在 (参数JSON, "style") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "style 不能省略 | 省略会被当作 0 而清掉窗口样式的全部位(含 WS_VISIBLE, 可能使窗口不可见/不可用) | 建议先用 browser_get_window_style 读取当前值, 按位修改后再传回"))
                }
                browser.置窗口属性 (窗口类型, MCP命令服务器.yyjson取整数 (参数JSON, "style"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "窗口风格已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 获取窗口运行风格 ===
        否则 (方法名 == "browser_get_run_style")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 风格对象 <类型 = YYJSON对象类>
                风格对象.创建自文本 ("{}")
                风格对象.加入逻辑值成员 ("success", 真)
                风格对象.加入整数成员 ("window_style", browser.取窗口属性 (MCP_常量.窗口样式_GWL_STYLE))
                风格对象.加入逻辑值成员 ("is_popup", browser.是否为弹窗 ())
                风格对象.加入整数成员 ("browser_id", browser.取ID ())
                // 约束(口径订正): 本工具原先只回 Win32 的 GWL_STYLE, 与工具名/描述里的"窗口运行风格"并不对应。
                // CEF 的运行风格是另一件事(默认0/谷歌1/经典2)。此处补上真值, 并**保留**原字段(已有调用方可能依赖)。
                // 类库 取窗口运行风格 () 返回的是**枚举** 窗口运行风格(FBrowser.常量), 不是整数 —— 必须先接枚举再显式转整数
                // (实测编译错误原文: 无法将数据类型"FBrowser.常量.窗口运行风格"转换到"整数")
                变量 运行风格枚举 <类型 = 窗口运行风格>
                运行风格枚举 = browser.取窗口运行风格 ()
                变量 运行风格值 <类型 = 整数>
                运行风格值 = (整数)运行风格枚举
                风格对象.加入整数成员 ("runtime_style", 运行风格值)
                变量 运行风格名 <类型 = 文本型>
                运行风格名 = "默认"
                如果 (运行风格值 == 1)
                {
                运行风格名 = "谷歌"
                }
                否则 (运行风格值 == 2)
                {
                运行风格名 = "经典"
                }
                风格对象.加入文本成员 ("runtime_style_name", 运行风格名)
                风格对象.加入文本成员 ("runtime_style_note", "runtime_style 来自 CEF CefRuntimeStyle(0默认/1谷歌/2经典); 本机实测为 1(谷歌) —— 该值由类库默认给出, 本项目未显式设置 窗口信息.运行风格; 它不是 Win32 的 GWL_STYLE(那个在 window_style 字段)")
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 风格对象.到可读文本 (YYJSON格式化选项.压缩)))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "ping")
        {
            变量 ping结果 <类型 = YYJSON对象类>
            ping结果.创建自文本 ("{}")
            ping结果.加入文本成员 ("pong", 到文本 (取启动时间 ()))
            ping结果.加入整数成员 ("browsers", FBrowser_浏览器_取数量 ())
            ping结果.加入文本成员 ("version", MCP_常量.MCP_版本号)
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, ping结果.到可读文本 (YYJSON格式化选项.压缩)))
        }
        否则 (方法名 == "browser_shutdown")
        {
            // 安全关闭: 先返回响应, 再通过UI时钟延迟执行关闭序列
            变量 确认 <类型 = 逻辑型>
            确认 = MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm")
            如果 (确认 == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "此操作将关闭AI-Fbowser-Mcp.exe进程! 请设置 confirm: true 确认"))
            }
            变量 延迟秒 <类型 = 整数>
            延迟秒 = MCP命令服务器.yyjson取整数 (参数JSON, "delay_seconds")
            如果 (延迟秒 <= 0)
            {
                延迟秒 = 1
            }
            // 钳制上限: 产品保留最长3秒关闭延迟 (当前为非阻塞截止时刻实现, 不阻塞消息泵)
            如果 (延迟秒 > 3)
            {
                延迟秒 = 3
            }
            // 注意: 不在响应前置 MCP正在关闭 (会导致本响应与在途sync-wait被跳过);
            // 由主循环消费 __SHUTDOWN__ 后经 执行关闭序列 统一置位
            // 待创建锁保护握手字段; browser_create 用比较-清除, 不误抹本关闭标记
            MCP命令服务器.待创建锁.加锁 ()
            MCP命令服务器.待创建URL = "__SHUTDOWN__" + 到文本 (延迟秒)
            MCP命令服务器.待创建锁.解锁 ()
            返回 (MCP_响应构建.命令成功 (命令ID, "AI浏览器将在" + 到文本 (延迟秒) + "秒后安全关闭, 感谢使用"))
        }
        返回 ("")
    }

    #
}
