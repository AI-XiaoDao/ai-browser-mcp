<火山程序 类型 = "通常" 版本 = 1 />
包 火山.程序
# MCP_服务器工具 — TLS 版本映射 (被 Core/VIP fingerprint ssl 调用)
类 MCP_服务器工具 <公开 @全局类 = 真>
{
    # 控制台日志输出: 标准错误流(stderr) — 控制台显示 + 不污染stdio模式的stdout协议帧
    # GBK编码输出(中文Windows控制台默认代码页936, 与IDE输出面板一致, 防UTF-8乱码)
    方法 控制台输出 <公开 静态>
    参数 文本 <类型 = 文本型>
    {
        @ {
        @     std::wstring ws = @<文本>.GetText();
        @     int n = WideCharToMultiByte(936, 0, ws.c_str(), (int)ws.size(), NULL, 0, NULL, NULL);
        @     if (n > 0) {
        @         std::string out(n, '\0');
        @         WideCharToMultiByte(936, 0, ws.c_str(), (int)ws.size(), &out[0], n, NULL, NULL);
        @         fwrite(out.c_str(), 1, out.size(), stderr);
        @     }
        @     fwrite("\n", 1, 1, stderr);
        @     fflush(stderr);
        @ }
    }

    # 目录存在性检查 (内联Win32实现, 规避不同火山版本 目录是否存在 内置API的SDK声明缺失问题)
    方法 检查目录是否存在 <公开 静态 类型 = 逻辑型>
    参数 目录路径 <类型 = 文本型>
    {
        变量 结果 <类型 = 逻辑型 值 = 假>
        @ {
        @     DWORD dwAttr = GetFileAttributesW(@<目录路径>.GetText());
        @     @<结果> = (dwAttr != INVALID_FILE_ATTRIBUTES && (dwAttr & FILE_ATTRIBUTE_DIRECTORY) != 0);
        @ }
        返回 (结果)
    }

    方法 整数到TLS版本 <公开 静态 类型 = TLS版本>
    参数 整数值 <类型 = 整数>
    {
        // 0=空, 表示不设置/不限制TLS版本, 让系统决定
        如果 (整数值 == 0)
        {
            返回 (TLS版本.空)
        }
        如果 (整数值 == MCP_常量.TLS指纹_1_0)
        {
            返回 (TLS版本.Version_1)
        }
        否则 (整数值 == MCP_常量.TLS指纹_1_1)
        {
            返回 (TLS版本.Version_1_1)
        }
        否则 (整数值 == MCP_常量.TLS指纹_1_2)
        {
            返回 (TLS版本.Version_1_2)
        }
        否则 (整数值 == MCP_常量.TLS指纹_1_3)
        {
            返回 (TLS版本.Version_1_3)
        }
        // 未知值: 返回空(不设置), 避免静默降级到1.2掩盖错误
        控制台输出 ("[MCP] 警告: 未知TLS版本值 " + 到文本 (整数值) + ", 回退为TLS版本.空")
        返回 (TLS版本.空)
    }
}
