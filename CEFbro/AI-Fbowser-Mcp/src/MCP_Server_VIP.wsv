                    {
                        mr按钮 = 0
                    }
                    vip_ctrl.高级鼠标_放开 (MCP命令服务器.yyjson取整数 (参数JSON, "x"), MCP命令服务器.yyjson取整数 (参数JSON, "y"), mr按钮)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP鼠标放开 button=" + 到文本 (mr按钮)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
