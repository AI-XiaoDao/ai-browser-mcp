        }
        否则 (方法名 == "browser_vip_fingerprint_geolocation")
        {
            变量 vipGeo <类型 = 类_FBrowserVIP_控制器>
            vipGeo = MCP命令服务器.取VIP控制器 ()
            如果 (vipGeo.是否为空 () == 假)
            {
                // 注: API参数顺序为 (经度, 纬度), 即 (lng, lat)
                变量 geoLat <类型 = 小数>
                geoLat = MCP命令服务器.yyjson取小数 (参数JSON, "lat")
                变量 geoLng <类型 = 小数>
                geoLng = MCP命令服务器.yyjson取小数 (参数JSON, "lng")
                变量 geoAcc <类型 = 小数>
                geoAcc = MCP命令服务器.yyjson取小数 (参数JSON, "accuracy")
                如果 (geoLat < -90 || geoLat > 90)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "纬度越界: " + 到文本 (geoLat) + " | 有效范围 -90 ~ 90"))
                }
                如果 (geoLng < -180 || geoLng > 180)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "经度越界: " + 到文本 (geoLng) + " | 有效范围 -180 ~ 180"))
                }
                如果 (geoAcc < 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "精度不能为负数: " + 到文本 (geoAcc)))
                }
                vipGeo.指纹_虚拟定位 (geoLng, geoLat, geoAcc, -10000, -1, -1, -1)
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "定位指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_ssl")
        {
            变量 vipSSL <类型 = 类_FBrowserVIP_控制器>
            vipSSL = MCP命令服务器.取VIP控制器 ()
            如果 (vipSSL.是否为空 () == 假)
            {
                变量 tls_min_int <类型 = 整数>
                变量 tls_max_int <类型 = 整数>
                变量 tls_min_enum <类型 = TLS版本>
                变量 tls_max_enum <类型 = TLS版本>
                tls_min_int = MCP命令服务器.yyjson取整数 (参数JSON, "tls_min")
                tls_max_int = MCP命令服务器.yyjson取整数 (参数JSON, "tls_max")
                // ★ 实测缺陷修正: 未知 tls 值原本被 MCP_服务器工具.整数到TLS版本 静默回退成"不限制(TLS版本.空)",
                //   而本工具照样回 success ⇒ 调用方以为"已按指定版本限制", 实际根本没限制(**静默假成功**)。
                //   故这里先做显式校验: 只接受 0(不限制) 与 769/790/791/792, 其它值**明确拒绝**并列出支持值。
                如果 (tls_min_int != 0 && tls_min_int != MCP_常量.TLS指纹_1_0 && tls_min_int != MCP_常量.TLS指纹_1_1 && tls_min_int != MCP_常量.TLS指纹_1_2 && tls_min_int != MCP_常量.TLS指纹_1_3)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "非法 tls_min: " + 到文本 (tls_min_int) + " | 支持: 0(不限制) / 769(TLS1.0) / 790(TLS1.1) / 791(TLS1.2) / 792(TLS1.3); 未知值不会被静默忽略 —— 否则会出现「回 success 但其实没限制」的假成功"))
                }
                如果 (tls_max_int != 0 && tls_max_int != MCP_常量.TLS指纹_1_0 && tls_max_int != MCP_常量.TLS指纹_1_1 && tls_max_int != MCP_常量.TLS指纹_1_2 && tls_max_int != MCP_常量.TLS指纹_1_3)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "非法 tls_max: " + 到文本 (tls_max_int) + " | 支持: 0(不限制) / 769(TLS1.0) / 790(TLS1.1) / 791(TLS1.2) / 792(TLS1.3); 未知值不会被静默忽略"))
                }
                // 整数→TLS版本枚举映射 (使用 MCP_服务器工具 统一方法)
                tls_min_enum = MCP_服务器工具.整数到TLS版本 (tls_min_int)
                tls_max_enum = MCP_服务器工具.整数到TLS版本 (tls_max_int)
                vipSSL.指纹_设置SSL加密套件 (tls_min_enum, tls_max_enum, MCP命令服务器.yyjson取文本 (参数JSON, "ciphers"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "SSL加密套件已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_canvas")
