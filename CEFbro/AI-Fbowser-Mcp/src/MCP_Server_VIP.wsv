                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "屏幕分辨率指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_hardware")
        {
            变量 vipHW <类型 = 类_FBrowserVIP_控制器>
            vipHW = MCP命令服务器.取VIP控制器 ()
            如果 (vipHW.是否为空 () == 假)
            {
                vipHW.指纹_虚拟HardwareConcurrency (MCP命令服务器.yyjson取整数 (参数JSON, "concurrency"))
                vipHW.指纹_虚拟DeviceMemory (MCP命令服务器.yyjson取整数 (参数JSON, "memory"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "硬件指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_product")
        {
            变量 vipProd <类型 = 类_FBrowserVIP_控制器>
            vipProd = MCP命令服务器.取VIP控制器 ()
            如果 (vipProd.是否为空 () == 假)
            {
                vipProd.指纹_虚拟Product (MCP命令服务器.yyjson取文本 (参数JSON, "product"))
                vipProd.指纹_虚拟ProductSub (MCP命令服务器.yyjson取文本 (参数JSON, "product_sub"))
                vipProd.指纹_虚拟Vendor (MCP命令服务器.yyjson取文本 (参数JSON, "vendor"))
                vipProd.指纹_虚拟VendorSub (MCP命令服务器.yyjson取文本 (参数JSON, "vendor_sub"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "产品标识指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_battery")
        {
            变量 vipBat <类型 = 类_FBrowserVIP_控制器>
            vipBat = MCP命令服务器.取VIP控制器 ()
            如果 (vipBat.是否为空 () == 假)
            {
                vipBat.指纹_虚拟BatteryManagerCharging (MCP命令服务器.yyjson取逻辑 (参数JSON, "charging"))
                vipBat.指纹_虚拟BatteryManagerLevel (MCP命令服务器.yyjson取小数 (参数JSON, "level"))
                vipBat.指纹_虚拟BatteryManagerChargingTime (MCP命令服务器.yyjson取小数 (参数JSON, "charging_time"))
                vipBat.指纹_虚拟BatteryManagerDischargingTime (MCP命令服务器.yyjson取小数 (参数JSON, "discharging_time"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "电池指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_fingerprint_media_devices")
        {
            变量 vipMD <类型 = 类_FBrowserVIP_控制器>
            vipMD = MCP命令服务器.取VIP控制器 ()
            如果 (vipMD.是否为空 () == 假)
            {
                如果 (MCP命令服务器.参数键存在 (参数JSON, "type") == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "缺少参数 type | 0=清空(不需要 devices), 1=添加设备(需 devices), 2=覆盖设备(需 devices) | type 无默认值: 省略即报错, 以免静默清空已设设备"))
                }
                变量 medType <类型 = 整数>
                medType = MCP命令服务器.yyjson取整数 (参数JSON, "type")
                如果 (medType < 0 || medType > 2)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "参数 type 无效(" + 到文本 (medType) + ") | 只支持 0清空/1添加/2覆盖"))
                }
                变量 medTarget <类型 = 文本型>
                medTarget = MCP命令服务器.yyjson取文本 (参数JSON, "target")
                如果 (medTarget != "audio_input" && medTarget != "audio_output" && medTarget != "video_input")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "未知target: " + medTarget + " | 支持 audio_input/audio_output/video_input"))
                }
                变量 medDevices <类型 = FBrowser_媒体硬件数组>
                变量 medCount <类型 = 整数>
                medCount = 0
                如果 (medType != 0)
                {
                    变量 medDevicesText <类型 = 文本型>
                    medDevicesText = MCP命令服务器.yyjson取JSON文本 (参数JSON, "devices")
                    变量 medArr <类型 = YYJSON只读数组类>
                    medArr = MCP命令服务器.取JSON数组自文本 (medDevicesText, "devices")
                    如果 (medArr.是否为空对象 () || medArr.取成员数 () == 0)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "type=" + 到文本 (medType) + " 必须同时给 devices 设备清单(非空JSON数组) | 只传 type 时内核收到的清单为空, 设置不会产生任何效果(旧版在这里返回假成功) | 每项字段: device_id(驱动ID, 驱动属性里查到的硬件ID; 特殊值 default/communications), label(硬件名, 可选), group_id(分组ID, 可选)"))
                    }
                    计次循环 ((整数)medArr.取成员数 ())
                    {
                        变量 medItem <类型 = YYJSON只读对象类>
                        medItem = medArr.取成员 (取循环索引 ())
                        变量 medDeviceID <类型 = 文本型>
                        medDeviceID = MCP命令服务器.yyjson取文本 (medItem, "device_id")
                        如果 (medDeviceID == "")
                        {
                            medDeviceID = MCP命令服务器.yyjson取文本 (medItem, "driver_id")
                        }
                        如果 (medDeviceID == "")
                        {
                            medDeviceID = MCP命令服务器.yyjson取文本 (medItem, "id")
                        }
                        如果 (medDeviceID == "")
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "devices[" + 到文本 (取循环索引 ()) + "] 缺少 device_id(驱动ID) | 类库按 驱动ID/硬件名/分组ID 三元组描述设备, 驱动ID 不能为空(别名 driver_id / id 亦可)"))
                        }
                        变量 medDeviceLabel <类型 = 文本型>
                        medDeviceLabel = MCP命令服务器.yyjson取文本 (medItem, "label")
                        如果 (medDeviceLabel == "")
                        {
                            medDeviceLabel = MCP命令服务器.yyjson取文本 (medItem, "name")
                        }
                        变量 medDeviceGroup <类型 = 文本型>
                        medDeviceGroup = MCP命令服务器.yyjson取文本 (medItem, "group_id")
                        如果 (medDeviceGroup == "")
                        {
                            medDeviceGroup = MCP命令服务器.yyjson取文本 (medItem, "group")
                        }
                        medDevices.加入数据 (medDeviceID, medDeviceLabel, medDeviceGroup)
                        medCount = medCount + 1
                    }
                }
                如果 (medTarget == "audio_input")
                {
                    vipMD.指纹_虚拟AudioInput设备 (medType, medDevices)
                }
                否则 (medTarget == "audio_output")
                {
                    vipMD.指纹_虚拟AudioOutput设备 (medType, medDevices)
                }
                否则
                {
                    vipMD.指纹_虚拟VideoInput设备 (medType, medDevices)
                }
                如果 (medType == 0)
                {
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "媒体设备指纹已清空: target=" + medTarget + " | 类库原文警告: 虚拟媒体设备可能造成浏览器声音或麦克风异常, 无法获取真实设备"))
                }
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "媒体设备指纹已设置: target=" + medTarget + ", type=" + 到文本 (medType) + ", 设备数=" + 到文本 (medCount) + " | 类库原文警告: 虚拟媒体设备可能造成浏览器声音或麦克风异常, 无法获取真实设备"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        // === VIP CDP键盘补充 ===
        否则 (方法名 == "browser_vip_key_click")
        {
            变量 clickKeyCode <类型 = 整数>
            clickKeyCode = MCP命令服务器.yyjson取整数 (参数JSON, "key_code")
            如果 (clickKeyCode <= 0 || clickKeyCode > 255)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 key_code 无效(" + 到文本 (clickKeyCode) + ") | 虚拟键码范围 1~255"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级键盘_单击 (clickKeyCode)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP键盘单击: key_code=" + 到文本 (clickKeyCode)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_key_input")
        {
            变量 charInput <类型 = 文本型>
            charInput = MCP命令服务器.yyjson取文本 (参数JSON, "char_code")
            如果 (charInput == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 char_code 不能为空 | 提供要输入的字符"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (取文本长度 (charInput) > 1)
                    {
                        // 官方API注释: 只能输入一个字, 否则会出错 — 截断为首字符
                        charInput = 取文本左边 (charInput, 1)
                    }
                    vip_ctrl.高级键盘_输入字符 (charInput)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP输入字符"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_key_type")
        {
            变量 typeText <类型 = 文本型>
            typeText = MCP命令服务器.yyjson取文本 (参数JSON, "text")
            如果 (typeText == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 text 不能为空 | 请提供要输入的文本内容"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级键盘_输入文本 (typeText)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP输入文本"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 内核开关扩展 ===
        否则 (方法名 == "browser_vip_set_css_version")
        {
            变量 cssVerText <类型 = 文本型>
            cssVerText = MCP命令服务器.yyjson取文本 (参数JSON, "version")
            如果 (cssVerText == "" || 文本到整数 (cssVerText) <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_版本必须为正整数))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 cssVer <类型 = 整数>
                    cssVer = 文本到整数 (cssVerText)
                    如果 (cssVer < MCP_常量.内核版本最小 || cssVer > MCP_常量.内核版本最大 || 到文本 (cssVer) != cssVerText)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "内核版本须为116-135范围内的纯数字(官方API支持值)"))
                    }
                    vip_ctrl.内核开关_设置CSS内核 (cssVer)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "CSS内核已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_set_web_version")
        {
            变量 webVerText <类型 = 文本型>
            webVerText = MCP命令服务器.yyjson取文本 (参数JSON, "version")
            如果 (webVerText == "" || 文本到整数 (webVerText) <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_版本必须为正整数))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 webVer <类型 = 整数>
                    webVer = 文本到整数 (webVerText)
                    如果 (webVer < MCP_常量.内核版本最小 || webVer > MCP_常量.内核版本最大 || 到文本 (webVer) != webVerText)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "内核版本须为116-135范围内的纯数字(官方API支持值)"))
                    }
                    vip_ctrl.内核开关_设置Web内核 (webVer)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Web内核已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_set_v8_version")
        {
            变量 v8VerText <类型 = 文本型>
            v8VerText = MCP命令服务器.yyjson取文本 (参数JSON, "version")
            如果 (v8VerText == "" || 文本到整数 (v8VerText) <= 0)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_版本必须为正整数))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 v8Ver <类型 = 整数>
                    v8Ver = 文本到整数 (v8VerText)
                    如果 (v8Ver < MCP_常量.内核版本最小 || v8Ver > MCP_常量.内核版本最大 || 到文本 (v8Ver) != v8VerText)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "内核版本须为116-135范围内的纯数字(官方API支持值)"))
                    }
                    vip_ctrl.内核开关_设置V8内核 (v8Ver)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "V8内核已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_send_devtools_msg")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假 && browser.是否已关闭 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 devJson <类型 = 文本型>
                    devJson = MCP命令服务器.yyjson取JSON文本 (参数JSON, "json")
                    如果 (devJson == "")
                    {
                        devJson = MCP命令服务器.yyjson取文本 (参数JSON, "json")
                    }
                    如果 (devJson == "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "json 参数不能为空"))
                    }
                    vip_ctrl.开发者消息_发送消息 (devJson)
                    返回 (MCP_响应构建.命令成功 (命令ID, "DevTools消息已发送"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === Cookie 补充 ===
        否则 (方法名 == "browser_refresh_cookies")
        {
            FBrowser_Cookie管理器_取全局 ().刷新Cookie ()
            返回 (MCP_响应构建.命令成功 (命令ID, "Cookie已刷新到磁盘"))
        }
        否则 (方法名 == "browser_get_all_cookies")
        {
            变量 异步CookieID <类型 = 文本型>
            异步CookieID = MCP命令服务器.生成异步任务ID ()
            变量 Cookie回调 <类型 = 类_FBrowser_事件智能指针>
            Cookie回调.创建 (类_MCP_Cookie收集回调)
            Cookie回调.取执行类 (类_MCP_Cookie收集回调).异步任务ID = 异步CookieID
            FBrowser_Cookie管理器_取全局 ().取全部Cookie (Cookie回调)
            返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步CookieID, "全部Cookie获取已提交, 通过mcp_result查询"))
        }
        // === 请求环境补充 ===
        否则 (方法名 == "browser_set_preference")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 reqCtx <类型 = 类_FBrowser_请求环境>
                reqCtx = browser.取请求环境 ()
                如果 (reqCtx.是否为空 () == 假)
                {
                    变量 名称 <类型 = 文本型>
                    变量 值文本 <类型 = 文本型>
                    名称 = MCP命令服务器.yyjson取文本 (参数JSON, "name")
                    值文本 = MCP命令服务器.yyjson取文本 (参数JSON, "value")
                    如果 (名称 == "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "缺少参数: name(首选项名)"))
                    }
                    如果 (值文本 == "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "缺少参数: value(首选项值)"))
                    }
                    变量 设置值 <类型 = 类_FBrowser_值>
                    设置值.创建 ()
                    // 按优先级匹配类型: 逻辑 > 整数环回验证 > 文本兜底
                    如果 (值文本 == "true" || 值文本 == "false")
                    {
                        设置值.置逻辑值 (值文本 == "true")
                    }
                    否则
                    {
                        变量 整数结果 <类型 = 整数>
                        整数结果 = 文本到整数 (值文本)
                        // 环回验证: 文本形式的整数应该严格匹配 (防止 "123abc" 被当作整数 123)
                        如果 (值文本 == 到文本 (整数结果) && 值文本 != "")
                        {
                            设置值.置整数值 (整数结果)
                        }
                        否则
                        {
                            设置值.置文本值 (值文本)
                        }
                    }
                    变量 错误文本 <类型 = 文本型>
                    reqCtx.置首选项 (设置值, 名称, 错误文本)
                    如果 (错误文本 != "")
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "首选项设置失败: " + 错误文本))
                    }
                    // 诚实边界(本机对照实测): ① 类库无读取接口, 无法回读核对; ② 字体类首选项
                    // (default_font_size / minimum_font_size)对既有与新建浏览器均无页面侧效果(新导航/异源/新建
                    // 浏览器三臂全 16px); ③ 未知首选项名(如 no.such.pref.xyz)会被存储但不生效且**不报错**
                    // (CEF SetPreference 语义)。故如实声明"已写入存储", 不做行为保证 —— 需要行为级效果
                    // 请改用对应专有工具(如代理用 browser_set_proxy, 缓存用 browser_clear_cache 等)。
                    返回 (MCP_响应构建.命令成功 (命令ID, "首选项 " + 名称 + " 已写入请求环境首选项存储 | 诚实边界(本机实测): 无读取接口无法回读; 字体类首选项对既有/新建浏览器均无页面侧效果; 未知首选项名不报错但也不生效 | 效果因首选项与本机内核而异, 请勿当作行为保证"))
                }
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 插件管理 ===
        否则 (方法名 == "browser_vip_load_extension")
        {
            变量 extCRX <类型 = 文本型>
            extCRX = MCP命令服务器.yyjson取文本 (参数JSON, "crx_path")
            变量 ext目录 <类型 = 文本型>
            ext目录 = MCP命令服务器.yyjson取文本 (参数JSON, "path")
            如果 (extCRX == "" && ext目录 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "需要 path(已解压插件目录) 或 crx_path(.crx 插件包) 之一 | 类库原文: 载入解压目录效率高于 CRX 安装, 且 CRX 会概率性出现「页面已打开但插件未装完」(装完刷新即生效)"))
            }
            // 插件高级功能: 类库要求"必须在加载插件前启用", 否则插件 content_scripts.js 不执行且**无任何报错**。
            // 进程启动时(main.wsv)已开启一次; 这里再幂等确保, 并如实回报开关状态。
            如果 (MCP命令服务器.VIP_插件高级功能已启用 == 假)
            {
                FBrowser_VIP功能_启用插件高级功能 ()
                MCP命令服务器.VIP_插件高级功能已启用 = 真
            }
            如果 (ext目录 != "")
            {
                如果 (MCP命令服务器.验证安全路径 (ext目录) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "路径不允许: " + ext目录 + " | 仅允许运行目录内及无 .. 的路径"))
                }
                变量 reqEnvU <类型 = 类_FBrowser_请求环境>
                reqEnvU = MCP命令服务器.取请求环境_安全 ()
                如果 (reqEnvU.是否为空 () == 真)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_请求环境不可用))
                }
                reqEnvU.VIP_高级_载入插件路径 (ext目录)
                返回 (MCP_响应构建.命令成功 (命令ID, "已提交载入插件目录: " + ext目录 + " | mode=unpacked | advanced_enabled=" + 选择 (MCP命令服务器.VIP_插件高级功能已启用, "true", "false") + " | 类库为异步载入, 若页面已打开请 browser_reload 后再验证 content_scripts 是否生效"))
            }
            如果 (MCP命令服务器.验证安全路径 (extCRX) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "路径不允许: " + extCRX + " | 仅允许运行目录内及无 .. 的路径"))
            }
            变量 reqEnv <类型 = 类_FBrowser_请求环境>
            reqEnv = MCP命令服务器.取请求环境_安全 ()
            如果 (reqEnv.是否为空 () == 真)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_请求环境不可用))
            }
            reqEnv.VIP_高级_安装CRX插件包 (extCRX)
            返回 (MCP_响应构建.命令成功 (命令ID, "CRX插件包已提交安装: " + extCRX + " | mode=crx | advanced_enabled=" + 选择 (MCP命令服务器.VIP_插件高级功能已启用, "true", "false") + " | 类库原文: CRX 安装较慢, 可能页面已打开而插件未装完, 装完 browser_reload 即生效"))
        }
        否则 (方法名 == "browser_vip_unload_extension")
        {
            变量 extID <类型 = 文本型>
            extID = MCP命令服务器.yyjson取文本 (参数JSON, "extension_id")
            如果 (extID != "")
            {
                变量 reqEnv2 <类型 = 类_FBrowser_请求环境>
                reqEnv2 = MCP命令服务器.取请求环境_安全 ()
                如果 (reqEnv2.是否为空 () == 假)
                {
                    reqEnv2.VIP_高级_卸载插件 (extID)
                    返回 (MCP_响应构建.命令成功 (命令ID, "插件已卸载: " + extID))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_请求环境不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "需要extension_id参数"))
        }
        否则 (方法名 == "browser_vip_extension_info")
        {
            变量 extInfoID <类型 = 文本型>
            extInfoID = MCP命令服务器.yyjson取文本 (参数JSON, "extension_id")
            如果 (extInfoID != "")
            {
                变量 reqEnv3 <类型 = 类_FBrowser_请求环境>
                reqEnv3 = MCP命令服务器.取请求环境_安全 ()
                如果 (reqEnv3.是否为空 () == 假)
                {
                    变量 extPath <类型 = 文本型>
                    变量 extURL <类型 = 文本型>
                    extPath = reqEnv3.VIP_高级_取插件路径 (extInfoID)
                    extURL = reqEnv3.VIP_高级_取插件地址 (extInfoID)
                    变量 结果对象 <类型 = YYJSON对象类>
                    结果对象.创建自文本 ("{}")
                    结果对象.加入文本成员 ("id", extInfoID)
                    结果对象.加入文本成员 ("path", extPath)
                    结果对象.加入文本成员 ("url", extURL)
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, 结果对象.到可读文本 (YYJSON格式化选项.压缩)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_请求环境不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "需要extension_id参数"))
        }
        // === VIP 指定环境执行JS ===
        否则 (方法名 == "browser_vip_execute_js_context")
        {
            变量 jsCode <类型 = 文本型>
            jsCode = MCP命令服务器.yyjson取文本 (参数JSON, "code")
            如果 (jsCode != "")
            {
                变量 vipCtrl <类型 = 类_FBrowserVIP_控制器>
                vipCtrl = MCP命令服务器.取VIP控制器 ()
                如果 (vipCtrl.是否为空 () == 假)
                {
                    变量 vipTarget <类型 = 文本型>
                    vipTarget = MCP命令服务器.yyjson取文本 (参数JSON, "target")
                    变量 ctxID <类型 = 整数>
                    ctxID = MCP命令服务器.yyjson取整数 (参数JSON, "context_id")
                    变量 frmID <类型 = 文本型>
                    frmID = MCP命令服务器.yyjson取文本 (参数JSON, "frame_id")
                    变量 frmIndex <类型 = 整数>
                    frmIndex = MCP命令服务器.yyjson取整数 (参数JSON, "frame_index")
                    // 六个执行参数(分诊确认原实现全部写死): 超时/静默/用户手势/禁用断点/repl模式/命令行API。
                    // 语义: repl=true 才允许顶层 await 与重复 let; user_gesture 影响需用户手势的 API(clipboard/全屏等);
                    // silent=true 异常不回报; disable_breaks 决定执行会不会被自己的插装断点拦停;
                    // 超时默认 60000ms(与既有一致)。
                    变量 vip超时 <类型 = 整数>
                    vip超时 = MCP命令服务器.yyjson取整数 (参数JSON, "timeout_ms")
                    如果 (vip超时 <= 0)
                    {
                        vip超时 = 60000
                    }
                    变量 vip静默 <类型 = 逻辑型>
                    vip静默 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "silent", 假)
                    变量 vip手势 <类型 = 逻辑型>
                    vip手势 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "user_gesture", 真)
                    变量 vip断点 <类型 = 逻辑型>
                    vip断点 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "disable_breaks", 假)
                    变量 vipRepl <类型 = 逻辑型>
                    vipRepl = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "repl_mode", 假)
                    变量 vip命令行API <类型 = 逻辑型>
                    vip命令行API = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "include_command_line_api", 真)
                    // 前置判断: 这些 VIP 方法需先"启用执行环境"才生效; 未启用时回调可能永不触发,
                    // 调用方只会白等到超时且看不出原因 —— 故此处**明确失败并给指引**(可行动, 不静默)。
                    如果 (vipTarget == "main" || vipTarget == "all_frames" || vipTarget == "frame_index")
                    {
                        如果 (MCP命令服务器.VIP_JS环境已启用 == 假)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "target=" + vipTarget + " 需要先启用 VIP JS 执行环境: 请先调 browser_vip_enable_js_env {enable:true, confirm:true} | ⚠ 实测启用后会破坏本会话 CDP 通道(CDP 优先工具会退化), 且需重启进程才能恢复 —— 建议只在确实需要时使用 | 另: browser_execute_js 走 CDP, 不需要该环境"))
                        }
                    }
                    变量 异步VIPJSID <类型 = 文本型>
                    异步VIPJSID = MCP命令服务器.生成异步任务ID ()
                    如果 (vipTarget == "all_frames")
                    {
                        // 多帧: 用**累计式**回调(每帧一次, 覆盖式回调只会留最后一帧)
                        变量 多帧回调 <类型 = 类_FBrowser_事件智能指针>
                        多帧回调.创建 (类_MCP_VIP多帧回调)
                        多帧回调.取执行类 (类_MCP_VIP多帧回调).任务ID = 异步VIPJSID
                        多帧回调.取执行类 (类_MCP_VIP多帧回调).帧计数 = 0
                        多帧回调.取执行类 (类_MCP_VIP多帧回调).累计文本 = ""
                        vipCtrl.高级_执行JS_全部框架 (jsCode, vip命令行API, vip静默, vip手势, vip超时, vip断点, vipRepl, 多帧回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步VIPJSID, "JS已提交到**全部框架** | 每个框架回调一次, 结果为累计(frame_count/frames_text) | 是否跑完请对比 browser_get_frames 的帧数"))
                    }
                    变量 VIPJS回调 <类型 = 类_FBrowser_事件智能指针>
                    VIPJS回调.创建 (类_MCP_VIP通用回调)
                    VIPJS回调.取执行类 (类_MCP_VIP通用回调).任务ID = 异步VIPJSID
                    如果 (vipTarget == "main")
                    {
                        vipCtrl.高级_执行JS_主框架 (jsCode, vip命令行API, vip静默, vip手势, vip超时, vip断点, vipRepl, VIPJS回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步VIPJSID, "JS已提交到**主框架**(顶级框架)"))
                    }
                    如果 (vipTarget == "frame_index")
                    {
                        如果 (frmIndex < 0)
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "target=frame_index 需要 frame_index(从0开始, 0 一般为主框架)"))
                        }
                        vipCtrl.高级_执行JS_框架序号 (jsCode, frmIndex, vip命令行API, vip静默, vip手势, vip超时, vip断点, vipRepl, VIPJS回调)
                        返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步VIPJSID, "JS已提交到框架序号 " + 到文本 (frmIndex)))
                    }
                    如果 (frmID != "")
                    {
                        vipCtrl.高级_执行JS_框架ID (jsCode, frmID, vip命令行API, vip静默, vip手势, vip超时, vip断点, vipRepl, VIPJS回调)
                    }
                    否则
                    {
                        变量 执行环境ID <类型 = 整数>
                        执行环境ID = ctxID
                        如果 (执行环境ID <= 0)
                        {
                            // 零前置: 缺省 context_id 时自动取环境清单第一个上下文 id(实测清单是上下文对象JSON文本,
                            // id 在 context.id; 不带 id 时类库报「VIP操作失败或返回空数据」这类不可行动错误)。
                            变量 环境清单 <类型 = 类_FBrowser_列表值>
                            环境清单 = vipCtrl.高级_取当前环境ID清单 ()
                            如果 (环境清单.是否为空 () == 假 && 环境清单.取大小 () > 0)
                            {
                                变量 首环境文本 <类型 = 文本型>
                                首环境文本 = 环境清单.取文本值 (0)
                                变量 首环境对象 <类型 = YYJSON只读对象类>
                                如果 (首环境对象.创建自文本 (首环境文本))
                                {
                                    变量 首上下文 <类型 = YYJSON只读对象类>
                                    首上下文 = MCP命令服务器.yyjson取对象成员 (首环境对象, "context")
                                    执行环境ID = MCP命令服务器.yyjson取整数 (首上下文, "id")
                                }
                            }
                            如果 (执行环境ID <= 0)
                            {
                                返回 (MCP_响应构建.命令失败 (命令ID, "未给 context_id 且自动解析环境清单失败(清单为空或解析不到 id) | 请先 browser_vip_enable_js_env 启用执行环境, 再用 browser_vip_get_js_env_ids 取 ids_int 传入 context_id | 或改用 target=main"))
                            }
                        }
                        vipCtrl.高级_执行JS (jsCode, 执行环境ID, vip命令行API, vip静默, vip手势, vip超时, vip断点, vipRepl, VIPJS回调)
                    }
                    返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步VIPJSID, "JS已提交到指定环境"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, "需要code参数"))
        }
        // === VIP CDP DOM文档获取 ===
        否则 (方法名 == "browser_vip_dom_get_document")
        {
            变量 dDepth0 <类型 = 整数>
            dDepth0 = MCP命令服务器.yyjson取整数 (参数JSON, "depth")
            如果 (dDepth0 == 0)
            {
                dDepth0 = 3
            }
            如果 (dDepth0 > 10)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "depth 最大为10, 超过会导致性能问题 | 当前值: " + 到文本 (dDepth0)))
            }
            变量 dPierce0 <类型 = 逻辑型>
            dPierce0 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "pierce", 假)
            如果 (dPierce0)
            {
                // ★ 安全闸门(三次独立运行实测): pierce=true 在**含 author shadow root 的页面**上会
                //   "先正常返回、再让下一条 CDP 命令挂住" —— 也就是**延迟打死本会话的 CDP 命令通道**
                //   (之后所有 CDP 类工具 30s 才靠原生回退返回, 需重启进程恢复)。
                //   故先用**页面侧廉价探测**(不走 DOM 域, 因此安全)判断有没有影子树: 有就拒绝并给替代。
                变量 d影子探测 <类型 = 文本型>
                d影子探测 = MCP命令服务器.CDP执行JS并等待 ("(function(){try{var all=document.querySelectorAll('*');var n=Math.min(all.length,3000);for(var i=0;i<n;i++){if(all[i].shadowRoot)return 'YES'}return 'NO'}catch(e){return 'ERR'}})()", 8000, 真)
                如果 (d影子探测 == "YES")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "pierce=true 在本页**被拒绝**: 页面含 author shadow root | 实测(三次一致): 本机对这种页面枚举影子树会**先正常返回、再让下一条 CDP 命令挂住**, 即**延迟打死本会话的 CDP 命令通道**(之后所有 CDP 类工具 30s 才返回, 需重启进程恢复) | 替代(安全): 用页面侧 JS 直接读影子树 —— browser_execute_js code=\"document.getElementById('宿主id').shadowRoot.querySelectorAll('*')\" 或对具体元素取 shadowRoot.innerHTML | 只读普通 DOM 仍可用: 本工具不带 pierce 的枚举实测安全(可重复 3 次)"))
                }
                如果 (d影子探测 == "ERR")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "pierce=true 的影子树探测失败(页面可能未就绪): 无法确认安全性故拒绝 | 先 browser_navigate / browser_wait what=load_end 让页面就绪, 或改用 browser_execute_js 读影子树"))
                }
            }
            变量 dVia <类型 = 文本型>
            dVia = MCP命令服务器.yyjson取文本 (参数JSON, "via")
            如果 (dVia == "")
            {
                dVia = "cdp"
            }
            // ★ 默认走 CDP 的 DOM 域: 实测类库路线(`开发者DOM.启用("all")` + 枚举)会把**本会话的 CDP 命令通道打死**
            //   (之后每条 CDP 命令 30s 才靠原生回退返回), 而 CDP 自身的 `DOM.getDocument` 完全无害,
            //   回包形态与类库一致(`{"root":{...}}`), 故对调用方透明。
            如果 (dVia == "cdp")
            {
                变量 dParams <类型 = 文本型>
                dParams = "{\"depth\":" + 到文本 (dDepth0) + ",\"pierce\":" + 选择 (dPierce0, "true", "false") + "}"
                变量 dCdp结果 <类型 = 文本型>
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_gd", "DOM.getDocument", dParams)
                dCdp结果 = MCP命令服务器.同步等待异步任务 (命令ID + "_gd", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (dCdp结果))
                {
                    变量 d载荷 <类型 = 文本型>
                    d载荷 = MCP命令服务器.取CDP载荷文本 (dCdp结果)
                    如果 (d载荷 != "")
                    {
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, d载荷))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "CDP DOM.getDocument 失败: " + MCP命令服务器.取CDP同步结果错误 (dCdp结果) + " | 可显式改用 via:library(类库开发者DOM 路线; **实测会让本会话 CDP 命令通道失效**)"))
            }
            变量 vipDom <类型 = 类_FBrowserVIP_开发者DOM>
            vipDom = MCP命令服务器.取开发者DOM_安全 ()
            如果 (vipDom.是否为空 () == 假)
            {
                vipDom.启用 ("all")
                变量 dDepth <类型 = 整数>
                dDepth = MCP命令服务器.yyjson取整数 (参数JSON, "depth")
                如果 (dDepth == 0)
                {
                    dDepth = 3
                }
                如果 (dDepth > 10)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "depth 最大为10, 超过会导致性能问题 | 当前值: " + 到文本 (dDepth)))
                }
                变量 异步DOMID <类型 = 文本型>
                异步DOMID = MCP命令服务器.生成异步任务ID ()
                变量 DOM回调 <类型 = 类_FBrowser_事件智能指针>
                DOM回调.创建 (类_MCP_VIP通用回调)
                DOM回调.取执行类 (类_MCP_VIP通用回调).任务ID = 异步DOMID
                // 穿透(pierce): 类库第 2 参; 原先**恒传假** ⇒ shadow DOM 内容枚举不到。改为可显式开启。
                变量 dPierce <类型 = 逻辑型>
                dPierce = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "pierce", 假)
                vipDom.枚举DOM (dDepth, dPierce, DOM回调)
                返回 (MCP命令服务器.命令成功_异步 (命令ID, 异步DOMID, "DOM文档已提交枚举(经类库开发者DOM 路线), 通过mcp_result查询 | ⚠ 实测: 该路线会让本会话的 CDP 命令通道失效(之后 CDP 类工具退化为原生回退, 每次 10~35 秒且可能超时), 需重启进程恢复; 下次请用默认的 via:cdp"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        否则 (方法名 == "browser_vip_dom_search")
        {
            变量 searchQuery <类型 = 文本型>
            searchQuery = MCP命令服务器.yyjson取文本 (参数JSON, "query")
            变量 sSearchID <类型 = 文本型>
            sSearchID = MCP命令服务器.yyjson取文本 (参数JSON, "search_id")
            如果 (searchQuery == "" && sSearchID == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "需要 query 或 search_id | query: 预查找并**立即取回**结果(单次调用完成, 推荐); search_id: 翻页取已预查找的结果(必须紧接着预查找使用, 中间不得再枚举 DOM)"))
            }
            // ★ 全走我方 CDP 通道(DOM 域), 不再碰类库开发者DOM —— 实测: 类库的 预查找文本 即使调用失败也会
            //   **毒化本会话 CDP 通道**(之后每条 CDP 命令 30s 才返回, 需重启恢复), 且未先 启用 时报
            //   「VIP操作失败或返回空数据」; 而经我方通道 DOM.enable → performSearch → getSearchResults 全程 0.03s 且通道健康。
            //   本机 CEF 约束(实测): ① performSearch 前必须 DOM.enable; ② 搜索结果要拿到**真实 nodeId**,
            //   必须先做一次 getDocument 填充节点映射(否则 nodeIds 全 0); ③ 每次 getDocument 都会重建映射并作废旧搜索会话。
            如果 (MCP命令服务器.确保DOM域已启用 (命令ID) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "DOM 域启用失败(CDP DOM.enable 未成功) | 若本机浏览器不支持 DOM 域, 请改用 browser_dom_query / browser_execute_js 页面侧查找"))
            }
            如果 (sSearchID != "")
            {
                变量 sFrom <类型 = 整数>
                sFrom = MCP命令服务器.yyjson取整数 (参数JSON, "from_index")
                变量 sTo <类型 = 整数>
                sTo = MCP命令服务器.yyjson取整数 (参数JSON, "to_index")
                如果 (sFrom < 0)
                {
                    sFrom = 0
                }
                如果 (sTo <= 0)
                {
                    sTo = 100
                }
                如果 (sSearchID == MCP命令服务器.DOM上次搜索ID)
                {
                    如果 (MCP命令服务器.DOM上次搜索数量 == 0)
                    {
                        变量 空翻页说明 <类型 = 文本型>
                        空翻页说明 = "该次预查找命中数为 0, 无结果可取(nodeIds 为空) | 换个 query 重新预查找"
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"searchId\":\"" + MCP_响应构建.JSON转义文本 (sSearchID) + "\",\"nodeIds\":[],\"note\":\"" + MCP_响应构建.JSON转义文本 (空翻页说明) + "\"}"))
                    }
                    如果 (sTo > MCP命令服务器.DOM上次搜索数量)
                    {
                        sTo = MCP命令服务器.DOM上次搜索数量
                    }
                }
                变量 取结果参数 <类型 = 文本型>
                取结果参数 = "{\"searchId\":\"" + MCP_响应构建.JSON转义文本 (sSearchID) + "\",\"fromIndex\":" + 到文本 (sFrom) + ",\"toIndex\":" + 到文本 (sTo) + "}"
                变量 取结果返回 <类型 = 文本型>
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_gsr", "DOM.getSearchResults", 取结果参数)
                取结果返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_gsr", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (取结果返回))
                {
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, MCP命令服务器.取CDP载荷文本 (取结果返回)))
                }
                变量 取结果错误 <类型 = 文本型>
                取结果错误 = MCP命令服务器.取CDP同步结果错误 (取结果返回)
                如果 (寻找文本 (取结果错误, "No search session", 0, 假) != -1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "search_id 会话已不存在 | 实测: 任何一次 browser_vip_dom_get_document 枚举都会重建节点映射并作废旧搜索会话 | 请重新用 query 预查找(本工具已把取回结果并入同一次调用)"))
                }
                如果 (寻找文本 (取结果错误, "Invalid search result range", 0, 假) != -1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "from_index..to_index 超出该次预查找的命中范围(resultCount) | 用 query 重新预查找可拿到最新 resultCount 与前 100 条结果"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "取查找结果失败: " + 取结果错误))
            }
            // —— query 模式: ① 有界枚举填充节点映射 → ② performSearch → ③ getSearchResults 立即取回 ——
            变量 sUaShadow <类型 = 逻辑型>
            sUaShadow = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "ua_shadow", 假)
            变量 映射返回 <类型 = 文本型>
            MCP命令服务器.执行CDP命令_带参数 (命令ID + "_sdoc", "DOM.getDocument", "{\"depth\":10,\"pierce\":false}")
            映射返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_sdoc", 15000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (映射返回) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "预查找前填充节点映射失败: " + MCP命令服务器.取CDP同步结果错误 (映射返回)))
            }
            变量 预查参数 <类型 = 文本型>
            预查参数 = "{\"query\":\"" + MCP_响应构建.JSON转义文本 (searchQuery) + "\",\"includeUserAgentShadowDOM\":" + 选择 (sUaShadow, "true", "false") + "}"
            变量 预查返回 <类型 = 文本型>
            MCP命令服务器.执行CDP命令_带参数 (命令ID + "_ps", "DOM.performSearch", 预查参数)
            预查返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_ps", 15000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (预查返回) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "预查找失败: " + MCP命令服务器.取CDP同步结果错误 (预查返回) + " | 无匹配时 resultCount=0 属正常(不会报错)"))
            }
            变量 预查对象 <类型 = YYJSON只读对象类>
            预查对象 = MCP命令服务器.取CDP结果对象 (预查返回)
            变量 新搜索ID <类型 = 文本型>
            新搜索ID = MCP命令服务器.yyjson取文本 (预查对象, "searchId")
            变量 新搜索数量 <类型 = 整数>
            新搜索数量 = MCP命令服务器.yyjson取整数 (预查对象, "resultCount")
            MCP命令服务器.DOM上次搜索ID = 新搜索ID
            MCP命令服务器.DOM上次搜索数量 = 新搜索数量
            变量 取回数量 <类型 = 整数>
            取回数量 = 新搜索数量
            如果 (取回数量 > 100)
            {
                取回数量 = 100
            }
            变量 nodeIds文本 <类型 = 文本型>
            nodeIds文本 = "[]"
            如果 (新搜索数量 > 0)
            {
                变量 取回参数 <类型 = 文本型>
                取回参数 = "{\"searchId\":\"" + MCP_响应构建.JSON转义文本 (新搜索ID) + "\",\"fromIndex\":0,\"toIndex\":" + 到文本 (取回数量) + "}"
                变量 取回返回 <类型 = 文本型>
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_gsr2", "DOM.getSearchResults", 取回参数)
                取回返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_gsr2", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (取回返回) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "取回搜索结果失败: " + MCP命令服务器.取CDP同步结果错误 (取回返回) + " | 本次失败不影响页面与 CDP 通道"))
                }
                变量 取回载荷 <类型 = 文本型>
                取回载荷 = MCP命令服务器.取CDP载荷文本 (取回返回)
                变量 数起 <类型 = 整数>
                数起 = 寻找文本 (取回载荷, "[", 0, 假)
                如果 (数起 != -1)
                {
                    变量 数止 <类型 = 整数>
                    数止 = 寻找文本 (取回载荷, "]", 数起, 假)
                    如果 (数止 != -1 && 数止 > 数起)
                    {
                        nodeIds文本 = "[" + 取文本中间 (取回载荷, 数起 + 1, 数止 - 数起 - 1) + "]"
                    }
                }
            }
            变量 搜索说明 <类型 = 文本型>
            搜索说明 = "nodeIds 可直接用作 browser_vip_dom_node_edit 的 node_id | 注意: 每次 DOM 枚举(含本工具内部这次)都会重建节点映射, 返回的 nodeIds 只在**下一次枚举之前**有效; 本工具内部的枚举会作废**之前**所有 node_id"
            返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"searchId\":\"" + MCP_响应构建.JSON转义文本 (新搜索ID) + "\",\"resultCount\":" + 到文本 (新搜索数量) + ",\"returned\":" + 到文本 (取回数量) + ",\"nodeIds\":" + nodeIds文本 + ",\"note\":\"" + MCP_响应构建.JSON转义文本 (搜索说明) + "\"}"))
        }
        // === VIP 开发者 DOM: 节点编辑(CDP DOM 域, 同步执行 + 回读验证) ===
        // 覆盖类库 7 个真缺口: 移除节点 / 移除节点属性 / 清除查找 + 置节点属性值 / 置节点属性文本 / 置节点值 / 置节点源码。
        // 硬守卫(照抄类库约束 + 项目惯例):
        //   · 节点类动作必须显式 confirm:true —— 它们**真实改写用户页面**(不可撤销, 只能刷新恢复);
        //   · node_id 必须 >0 且不能是根节点(类库原文: 移除节点"不能是根节点");
        //   · 每次 DOM 枚举都会**重建节点映射**(实测: 同一元素三次枚举 nodeId 依次 18/36/54), 故 node_id
        //     只在最近一次枚举后、再次枚举前有效; 失效提交会得到 CDP 「Could not find node」干净报错(实测 0.03s, 不挂不毒化),
        //     本工具把它转成可行动失败(重新枚举 / 改用 selector 由本工具内部定位)。
        //   · 提交成功**不等于页面已变** —— 本工具对每类动作做 CDP 回读验证(getAttributes/getOuterHTML,
        //     移除节点以 CDP 「Could not find node」为移除确认), 验证失败如实报错(不静默假成功)。
        // 通道纪律(对照实测): 一律走我方 CDP 通道(DOM 域, 全程 0.03s); 类库 开发者DOM.启用/预查找文本 会**毒化
        // 本会话 CDP 通道**(之后每条 CDP 命令 30s 才返回, 需重启恢复), 故本分支不再触碰类库开发者DOM。
        否则 (方法名 == "browser_vip_dom_node_edit")
        {
            变量 neAction <类型 = 文本型>
            neAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (neAction == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "需要 action | 可用: remove_node(移除节点, 连子节点一并删) / remove_attr(移除属性) / set_attr(置属性值) / set_attr_text(置属性文本) / set_node_value(置节点值, 仅文本节点) / set_outer_html(置节点源码) / discard_search(清除搜索会话)"))
            }
            // —— discard_search: 本机 CEF 无 DOM.discardSearch(实测 -32601 「wasn't found」) ——
            // 用 DOM.disable + DOM.enable 重建 DOM 代理(实测等效清除**全部**搜索会话且通道保持健康);
            // 节点映射本就每次枚举重建, 重建代理无额外副作用。
            如果 (neAction == "discard_search")
            {
                变量 dsID <类型 = 文本型>
                dsID = MCP命令服务器.yyjson取文本 (参数JSON, "search_id")
                如果 (MCP命令服务器.DOM域已启用)
                {
                    变量 关返回 <类型 = 文本型>
                    MCP命令服务器.执行CDP命令_带参数 (命令ID + "_domoff", "DOM.disable", "{}")
                    关返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_domoff", 15000)
                    变量 开返回 <类型 = 文本型>
                    MCP命令服务器.执行CDP命令_带参数 (命令ID + "_domon", "DOM.enable", "{\"includeWhitespace\":\"none\"}")
                    开返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_domon", 15000)
                    如果 (MCP命令服务器.CDP同步结果是否成功 (关返回) && MCP命令服务器.CDP同步结果是否成功 (开返回))
                    {
                        MCP命令服务器.DOM域已启用 = 真
                        变量 清理说明 <类型 = 文本型>
                        清理说明 = "本机 CEF 无 DOM.discardSearch 方法(实测 -32601) | 已用 DOM.disable+DOM.enable 重建 DOM 代理, 等效清除**全部**搜索会话(含 search_id 指定的那次) | 节点映射本就每次枚举重建, 无额外副作用"
                        返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"discard_search\",\"search_id\":\"" + MCP_响应构建.JSON转义文本 (dsID) + "\",\"note\":\"" + MCP_响应构建.JSON转义文本 (清理说明) + "\"}"))
                    }
                    返回 (MCP_响应构建.命令失败 (命令ID, "重建 DOM 代理失败(disable/enable 未成功): " + MCP命令服务器.取CDP同步结果错误 (关返回) + " / " + MCP命令服务器.取CDP同步结果错误 (开返回)))
                }
                变量 无会话说明 <类型 = 文本型>
                无会话说明 = "DOM 域尚未启用, 无活动搜索会话可清除 | 本机 CEF 无 DOM.discardSearch(实测 -32601); 搜索会话在每次 DOM 枚举时也会被自动作废"
                返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"success\":true,\"action\":\"discard_search\",\"search_id\":\"" + MCP_响应构建.JSON转义文本 (dsID) + "\",\"note\":\"" + MCP_响应构建.JSON转义文本 (无会话说明) + "\"}"))
            }
            变量 neNodeID <类型 = 整数>
            neNodeID = MCP命令服务器.yyjson取整数 (参数JSON, "node_id")
            变量 neSelector <类型 = 文本型>
            neSelector = MCP命令服务器.yyjson取文本 (参数JSON, "selector")
            如果 (neNodeID <= 0 && neSelector == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "需要 node_id(>0) 或 selector | node_id 来自 browser_vip_dom_get_document 枚举的 nodeId, 且**只在最近一次枚举后有效**(每次枚举都会重建节点映射); selector(如 \"#id\")由本工具内部定位, 抗映射重建, **推荐**"))
            }
            如果 (neSelector == "" && neNodeID == 1)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "node_id=1 是根文档节点 | 类库原文: 移除节点**不能是根节点**; 属性/值类动作对根节点也无意义, 故一律拒绝"))
            }
            如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "confirm") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "该动作会**真实改写用户页面**(不可撤销, 只能刷新恢复), 故需显式 confirm:true | 动作: " + neAction + " | 想只读查看请用 browser_vip_dom_get_document / browser_dom_query"))
            }
            变量 neAttr <类型 = 文本型>
            neAttr = MCP命令服务器.yyjson取文本 (参数JSON, "attr_name")
            变量 neValue <类型 = 文本型>
            neValue = MCP命令服务器.yyjson取文本 (参数JSON, "value")
            如果 (neAction == "remove_attr" || neAction == "set_attr" || neAction == "set_attr_text")
            {
                如果 (neAttr == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, neAction + " 需要 attr_name | set_attr_text 还需要 value(文本)"))
                }
            }
            如果 (neAction == "set_outer_html" && neValue == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "set_outer_html 需要 value(新的 outerHTML 源码)"))
            }
            变量 neCdp方法 <类型 = 文本型>
            neCdp方法 = ""
            如果 (neAction == "remove_attr")
            {
                neCdp方法 = "DOM.removeAttribute"
            }
            否则 (neAction == "set_attr")
            {
                neCdp方法 = "DOM.setAttributeValue"
            }
            否则 (neAction == "set_attr_text")
            {
                neCdp方法 = "DOM.setAttributesAsText"
            }
            否则 (neAction == "set_node_value")
            {
                neCdp方法 = "DOM.setNodeValue"
            }
            否则 (neAction == "set_outer_html")
            {
                neCdp方法 = "DOM.setOuterHTML"
            }
            否则 (neAction == "remove_node")
            {
                neCdp方法 = "DOM.removeNode"
            }
            否则
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + neAction + " | 可用: remove_node / remove_attr / set_attr / set_attr_text / set_node_value / set_outer_html / discard_search"))
            }
            // —— 定位实际节点: selector 优先(内部 getDocument+querySelector, 抗映射重建), 否则用调用方给的 node_id ——
            变量 实际节点ID <类型 = 整数>
            实际节点ID = neNodeID
            如果 (neSelector != "")
            {
                如果 (MCP命令服务器.确保DOM域已启用 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "DOM 域启用失败(CDP DOM.enable 未成功) | selector 定位需要 DOM 域"))
                }
                // 取根节点: getDocument(depth=1) → root.nodeId → querySelector(selector)
                变量 根映射返回 <类型 = 文本型>
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_rt", "DOM.getDocument", "{\"depth\":1,\"pierce\":false}")
                根映射返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_rt", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (根映射返回) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "selector 定位前取根节点失败: " + MCP命令服务器.取CDP同步结果错误 (根映射返回)))
                }
                变量 根对象 <类型 = YYJSON只读对象类>
                根对象 = MCP命令服务器.取CDP结果对象 (根映射返回)
                变量 根成员 <类型 = YYJSON只读对象类>
                根成员 = MCP命令服务器.yyjson取对象成员 (根对象, "root")
                变量 根节点ID <类型 = 整数>
                根节点ID = MCP命令服务器.yyjson取整数 (根成员, "nodeId")
                如果 (根节点ID <= 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "取根节点 ID 失败(枚举回包缺少 root.nodeId)"))
                }
                变量 查询参数 <类型 = 文本型>
                查询参数 = "{\"nodeId\":" + 到文本 (根节点ID) + ",\"selector\":\"" + MCP_响应构建.JSON转义文本 (neSelector) + "\"}"
                变量 查询返回 <类型 = 文本型>
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_qs", "DOM.querySelector", 查询参数)
                查询返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_qs", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (查询返回) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "querySelector 执行失败: " + MCP命令服务器.取CDP同步结果错误 (查询返回) + " | 选择器语法同 CSS(document.querySelector)"))
                }
                变量 查询对象 <类型 = YYJSON只读对象类>
                查询对象 = MCP命令服务器.取CDP结果对象 (查询返回)
                实际节点ID = MCP命令服务器.yyjson取整数 (查询对象, "nodeId")
                如果 (实际节点ID <= 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "selector 未命中任何节点(CDP 返回 nodeId=0): " + neSelector + " | 检查选择器是否与页面当前 DOM 匹配(动态页面先 browser_wait 就绪)"))
                }
                如果 (实际节点ID == 1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "selector 命中的是根文档节点(html) | 类库原文: 移除节点**不能是根节点**; 属性/值类动作对根节点也无意义, 故一律拒绝 | 请收窄选择器到具体元素"))
                }
            }
            否则
            {
                如果 (MCP命令服务器.确保DOM域已启用 (命令ID) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "DOM 域启用失败(CDP DOM.enable 未成功)"))
                }
            }
            // —— 构造参数并提交 ——
            变量 neParams <类型 = 文本型>
            neParams = ""
            如果 (neAction == "remove_attr")
            {
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + ",\"name\":\"" + MCP_响应构建.JSON转义文本 (neAttr) + "\"}"
            }
            否则 (neAction == "set_attr")
            {
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + ",\"name\":\"" + MCP_响应构建.JSON转义文本 (neAttr) + "\",\"value\":\"" + MCP_响应构建.JSON转义文本 (neValue) + "\"}"
            }
            否则 (neAction == "set_attr_text")
            {
                // 类库语义: 置节点属性文本 (节点ID, 属性名, 文本) → CDP text=「属性名="值"」, name=属性名
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + ",\"text\":\"" + MCP_响应构建.JSON转义文本 (neAttr + "=\"" + neValue + "\"") + "\",\"name\":\"" + MCP_响应构建.JSON转义文本 (neAttr) + "\"}"
            }
            否则 (neAction == "set_node_value")
            {
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + ",\"value\":\"" + MCP_响应构建.JSON转义文本 (neValue) + "\"}"
            }
            否则 (neAction == "set_outer_html")
            {
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + ",\"outerHTML\":\"" + MCP_响应构建.JSON转义文本 (neValue) + "\"}"
            }
            否则 (neAction == "remove_node")
            {
                neParams = "{\"nodeId\":" + 到文本 (实际节点ID) + "}"
            }
            变量 提交返回 <类型 = 文本型>
            MCP命令服务器.执行CDP命令_带参数 (命令ID + "_ne", neCdp方法, neParams)
            提交返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_ne", 15000)
            如果 (MCP命令服务器.CDP同步结果是否成功 (提交返回) == 假)
            {
                变量 提交错误 <类型 = 文本型>
                提交错误 = MCP命令服务器.取CDP同步结果错误 (提交返回)
                如果 (寻找文本 (提交错误, "Could not find node", 0, 假) != -1)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "node_id 已失效: 每次 browser_vip_dom_get_document 枚举都会**重建节点映射**(实测同一元素每次枚举 nodeId 都变, 如 18→36→54), 故 node_id 只在最近一次枚举后、再次枚举前有效 | 修复: 重新 browser_vip_dom_get_document 取最新 node_id, 或改用 selector 参数由本工具自行定位(推荐) | CDP错误: " + 提交错误))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "CDP " + neCdp方法 + " 提交失败: " + 提交错误 + " | 该失败不影响页面与 CDP 通道; 若是节点类型不符(如对非文本节点 set_node_value), 请重新枚举确认节点"))
            }
            // —— 回读验证(不静默假成功) ——
            变量 读回返回 <类型 = 文本型>
            变量 读回参数 <类型 = 文本型>
            读回参数 = "{\"nodeId\":" + 到文本 (实际节点ID) + "}"
            如果 (neAction == "remove_node")
            {
                // 删除成功的确认信号 = 再取属性得到 「Could not find node with given id」(实测)
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_rb", "DOM.getAttributes", 读回参数)
                读回返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_rb", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (读回返回) == 假 && 寻找文本 (MCP命令服务器.取CDP同步结果错误 (读回返回), "Could not find node", 0, 假) != -1)
                {
                    变量 删除说明 <类型 = 文本型>
                    删除说明 = "节点已从 DOM 移除(CDP 回读确认: getAttributes 返回 Could not find node) | 该 node_id 已失效; 页面真实效果可再枚举核对"
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"action\":\"" + MCP_响应构建.JSON转义文本 (neAction) + "\",\"method\":\"" + neCdp方法 + "\",\"node_id\":" + 到文本 (实际节点ID) + ",\"submitted\":true,\"verified\":true,\"readback\":\"node-gone\",\"note\":\"" + MCP_响应构建.JSON转义文本 (删除说明) + "\"}"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, "remove_node 已提交但回读未确认(节点仍可被取到或回读失败) | 请 browser_vip_dom_get_document 重新枚举核对节点是否还在 | 回读: " + MCP命令服务器.取CDP载荷文本 (读回返回) + " / " + MCP命令服务器.取CDP同步结果错误 (读回返回)))
            }
            否则 (neAction == "set_node_value" || neAction == "set_outer_html")
            {
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_rb", "DOM.getOuterHTML", 读回参数)
                读回返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_rb", 15000)
                变量 源码载荷 <类型 = 文本型>
                源码载荷 = MCP命令服务器.取CDP载荷文本 (读回返回)
                变量 源码命中 <类型 = 逻辑型>
                源码命中 = 寻找文本 (源码载荷, MCP_响应构建.JSON转义文本 (neValue), 0, 假) != -1
                如果 (源码命中 == 假)
                {
                    // CEF 序列化会把属性引号统一成双引号(实测: 提交 <b id='bold'> 回读为 <b id="bold">),
                    // 故把单引号换成双引号再对一次, 避免"实际已生效但回读误判未确认"。
                    变量 引号归一值 <类型 = 文本型>
                    引号归一值 = neValue
                    子文本替换 (引号归一值, "'", "\"", , , 假)
                    源码命中 = 寻找文本 (源码载荷, MCP_响应构建.JSON转义文本 (引号归一值), 0, 假) != -1
                }
                如果 (MCP命令服务器.CDP同步结果是否成功 (读回返回) && 源码命中)
                {
                    变量 源码说明 <类型 = 文本型>
                    源码说明 = "CDP 回读确认: getOuterHTML 已包含新内容 | 页面真实效果可再枚举核对"
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"action\":\"" + MCP_响应构建.JSON转义文本 (neAction) + "\",\"method\":\"" + neCdp方法 + "\",\"node_id\":" + 到文本 (实际节点ID) + ",\"submitted\":true,\"verified\":true,\"readback\":\"" + MCP_响应构建.JSON转义文本 (取文本左边 (源码载荷, 200)) + "\",\"note\":\"" + MCP_响应构建.JSON转义文本 (源码说明) + "\"}"))
                }
                如果 (neAction == "set_outer_html" && MCP命令服务器.CDP同步结果是否成功 (读回返回) == 假 && 寻找文本 (MCP命令服务器.取CDP同步结果错误 (读回返回), "Could not find node", 0, 假) != -1)
                {
                    // CEF 的 setOuterHTML 是**替换**语义: 提交成功后旧 nodeId 可能被作废(实测 selector 路径
                    // 提交成功、页面侧已见新节点, 而旧 id 回读报 Could not find node) —— 提交成功 + 旧 id 消失 = 已替换。
                    变量 替换说明 <类型 = 文本型>
                    替换说明 = "节点已被替换确认: 提交成功后旧 nodeId 已作废(CDP 回读 Could not find node; CEF setOuterHTML 为替换语义, 旧 id 失效属预期) | 页面真实效果可再枚举核对"
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"action\":\"" + MCP_响应构建.JSON转义文本 (neAction) + "\",\"method\":\"" + neCdp方法 + "\",\"node_id\":" + 到文本 (实际节点ID) + ",\"submitted\":true,\"verified\":true,\"readback\":\"node-replaced\",\"note\":\"" + MCP_响应构建.JSON转义文本 (替换说明) + "\"}"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, neAction + " 已提交但回读未确认(getOuterHTML 不含预期内容或回读失败) | 请 browser_vip_dom_get_document 重新枚举核对 | 回读: " + 源码载荷 + " / " + MCP命令服务器.取CDP同步结果错误 (读回返回)))
            }
            否则
            {
                // remove_attr / set_attr / set_attr_text: getAttributes 回读属性数组
                MCP命令服务器.执行CDP命令_带参数 (命令ID + "_rb", "DOM.getAttributes", 读回参数)
                读回返回 = MCP命令服务器.同步等待异步任务 (命令ID + "_rb", 15000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (读回返回) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, neAction + " 已提交但回读失败(getAttributes): " + MCP命令服务器.取CDP同步结果错误 (读回返回) + " | 请 browser_vip_dom_get_document 重新枚举核对"))
                }
                变量 属性载荷 <类型 = 文本型>
                属性载荷 = MCP命令服务器.取CDP载荷文本 (读回返回)
                变量 回读通过 <类型 = 逻辑型>
                回读通过 = 假
                如果 (neAction == "remove_attr")
                {
                    回读通过 = 寻找文本 (属性载荷, "\"" + MCP_响应构建.JSON转义文本 (neAttr) + "\"", 0, 假) == -1
                }
                否则
                {
                    回读通过 = 寻找文本 (属性载荷, "\"" + MCP_响应构建.JSON转义文本 (neAttr) + "\",\"" + MCP_响应构建.JSON转义文本 (neValue) + "\"", 0, 假) != -1
                }
                如果 (回读通过)
                {
                    变量 属性说明 <类型 = 文本型>
                    属性说明 = "CDP 回读确认: getAttributes 与预期一致 | 页面真实效果可再枚举核对"
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, "{\"action\":\"" + MCP_响应构建.JSON转义文本 (neAction) + "\",\"method\":\"" + neCdp方法 + "\",\"node_id\":" + 到文本 (实际节点ID) + ",\"submitted\":true,\"verified\":true,\"readback\":\"" + MCP_响应构建.JSON转义文本 (取文本左边 (属性载荷, 200)) + "\",\"note\":\"" + MCP_响应构建.JSON转义文本 (属性说明) + "\"}"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, neAction + " 已提交但回读未确认(属性与预期不符) | 请 browser_vip_dom_get_document 重新枚举核对 | 回读: " + 属性载荷))
            }
        }
        否则 (方法名 == "browser_vip_enable_devtools_observer")
        {
            // enable 缺失即拒绝(不接受缺省): 缺省会被当成关闭, 而关闭 CDP 观察者会让全部
            // CDP 类工具(debugger_*/cdp_*/reverse CDP类)永久失效且需重启进程才能恢复。
            变量 enableObs <类型 = 逻辑型>
            // 取值判据: 只有显式字符串 "false"/"0"/"off" 才算关闭意图;
            // 缺省(与布尔 false 在协议层无法区分)一律拒绝 —— 任何歧义都不执行破坏性动作。
            变量 开关文本 <类型 = 文本型>
            开关文本 = MCP命令服务器.yyjson取文本 (参数JSON, "enable")
            变量 开关布尔 <类型 = 逻辑型>
            开关布尔 = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
            变量 目标状态 <类型 = 逻辑型>
            目标状态 = 开关布尔
            // ★ 安全性(实测): 只挡"空文本"不够 —— **无法识别的取值会掉进破坏性分支**:
            //   实测传 enable:"mcp_probe" 时: 开关文本非空 -> 该守卫不触发 -> 目标状态沿用 开关布尔(非布尔节点取逻辑=假)
            //   -> 结果把 CDP 观察者**关掉**了(台账那一批之后紧跟一次冷重启, 正是被这个动作搞坏的)。
            //   即"最危险的分支成了兜底"。契约: 只认显式白名单取值, 其余一律拒绝并说明。
            变量 取值已识别 <类型 = 逻辑型 值 = 假>
            如果 (开关文本 == "false" || 开关文本 == "0" || 开关文本 == "off")
            {
                目标状态 = 假
                取值已识别 = 真
            }
            否则 (开关文本 == "true" || 开关文本 == "1" || 开关文本 == "on")
            {
                目标状态 = 真
                取值已识别 = 真
            }
            否则 (开关文本 == "" && 开关布尔)
            {
                // 空文本但布尔为真: 协议层能明确区分, 视为启用
                目标状态 = 真
                取值已识别 = 真
            }
            如果 (取值已识别 == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "enable 取值无法识别: " + 开关文本 + " | 只接受: 字符串 true/false/1/0/on/off, 或布尔 true | **不接受缺省**(缺省会被当成关闭) | 无法识别的取值一律拒绝, 不落进'关闭观察者'这个破坏性分支(实测: 传 enable 值为 mcp_probe 时旧实现会静默关闭观察者)"))
            }
            enableObs = 目标状态
            变量 vipObs <类型 = 类_FBrowserVIP_控制器>
            vipObs = MCP命令服务器.取VIP控制器 ()
            如果 (vipObs.是否为空 () == 假)
            {
                如果 (enableObs)
                {
                    MCP命令服务器.确保CDP观察者已注册 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "DevTools消息监听已启用(MCP观察者)"))
                }
                否则
                {
                    MCP命令服务器.注销CDP观察者 ()
                    返回 (MCP_响应构建.命令成功 (命令ID, "DevTools消息监听已关闭 | 已注销 CDP 观察者(cdp_ready=false) | 实测纠正: 关闭**不是**永久的 —— 下一次 CDP 调用会自动重新注册观察者(cdp_ready 回到 true), 通道自愈, 通常无需重启进程(旧文案声称'需重启进程才能恢复', 与实测不符) | 仅当重注册失败(控制器侧仍持有旧观察者)时 CDP 类工具才持续不可用, 那时按报错提示重启"))
                }
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        // === VIP 触摸模拟 ===
        否则 (方法名 == "browser_vip_touch_emulation")
        {
            // mode=mouse: 鼠标事件转触摸事件(**CDP 路线**)。
            // 实测结论: 内核级注入会让本会话 CDP 通道失效, 而 CDP 的 Emulation.setEmitTouchEventsForMouse
            // 不需要启用 JS 执行环境、不需要刷新页面, 也不会破坏 CDP 通道 —— 故优先提供这条。
            变量 触摸模式 <类型 = 文本型>
            触摸模式 = MCP命令服务器.yyjson取文本 (参数JSON, "mode")
            如果 (触摸模式 == "mouse")
            {
                变量 转触摸配置 <类型 = 文本型>
                转触摸配置 = MCP命令服务器.yyjson取文本 (参数JSON, "configuration")
                如果 (转触摸配置 == "")
                {
                    转触摸配置 = "mobile"
                }
                如果 (转触摸配置 != "mobile" && 转触摸配置 != "desktop")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "configuration 只支持 mobile / desktop | mobile=视口按移动端触摸布局, desktop=按桌面端"))
                }
                变量 转触摸启用 <类型 = 逻辑型>
                转触摸启用 = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
                变量 转触摸参数 <类型 = 文本型>
                如果 (转触摸启用)
                {
                    转触摸参数 = "{\"enabled\":true,\"configuration\":\"" + 转触摸配置 + "\"}"
                }
                否则
                {
                    转触摸参数 = "{\"enabled\":false}"
                }
                变量 转触摸结果 <类型 = 文本型>
                转触摸结果 = MCP命令服务器.执行CDP并同步等待 ("mcp_emittouch_" + 到文本 (取启动时间 ()), "Emulation.setEmitTouchEventsForMouse", 转触摸参数, 8000)
                如果 (MCP命令服务器.CDP同步结果是否成功 (转触摸结果) == 假)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "CDP Emulation.setEmitTouchEventsForMouse 失败: " + MCP命令服务器.取CDP同步结果错误 (转触摸结果) + " | 可用替代: browser_vip_touch_emulation {enable:true, max_points:N}(内核级触摸仿真, 需刷新页面)"))
                }
                如果 (转触摸启用)
                {
                    返回 (MCP_响应构建.命令成功 (命令ID, "鼠标事件已转为触摸事件(CDP Emulation.setEmitTouchEventsForMouse): configuration=" + 转触摸配置 + " | 撤销: 同参数传 enable=false"))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "已关闭鼠标转触摸(CDP)"))
            }
            变量 vipTouch <类型 = 类_FBrowserVIP_控制器>
            vipTouch = MCP命令服务器.取VIP控制器 ()
            如果 (vipTouch.是否为空 () == 假)
            {
                vipTouch.指纹_启用触摸事件 (MCP命令服务器.yyjson取逻辑 (参数JSON, "enable"), MCP命令服务器.yyjson取整数 (参数JSON, "max_points"))
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "触摸模拟已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        // === VIP UA完整指纹 ===
        否则 (方法名 == "browser_fingerprint_ua")
        {
            变量 vipUA <类型 = 类_FBrowserVIP_控制器>
            vipUA = MCP命令服务器.取VIP控制器 ()
            如果 (vipUA.是否为空 () == 假)
            {
                变量 ua_data <类型 = 类_FBrowserVIP_UA数据>
                ua_data.创建 ()
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "ua") != "")
                {
                    ua_data.置UserAgent (MCP命令服务器.yyjson取文本 (参数JSON, "ua"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "platform") != "")
                {
                    ua_data.置Platform (MCP命令服务器.yyjson取文本 (参数JSON, "platform"))
                    ua_data.置HighPlatform (MCP命令服务器.yyjson取文本 (参数JSON, "platform"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "accept_lang") != "")
                {
                    ua_data.置AcceptLanguage (MCP命令服务器.yyjson取文本 (参数JSON, "accept_lang"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "architecture") != "")
                {
                    ua_data.置Architecture (MCP命令服务器.yyjson取文本 (参数JSON, "architecture"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "bitness") != "")
                {
                    ua_data.置Bitness (MCP命令服务器.yyjson取文本 (参数JSON, "bitness"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "model") != "")
                {
                    ua_data.置Model (MCP命令服务器.yyjson取文本 (参数JSON, "model"))
                }
                ua_data.置Mobile (MCP命令服务器.yyjson取逻辑 (参数JSON, "mobile"))
                ua_data.置Wow64 (MCP命令服务器.yyjson取逻辑 (参数JSON, "wow64"))
                // ★ 契约: UA 字符串与 UA-CH 必须一起设 —— 只设基础字段会
                //   漏掉 UA-CH(navigator.userAgentData) 的 brands/fullVersionList/platformVersion/fullVersion。
                //   只改 UA 字符串而不改 UA-CH, 两者不一致反而**更容易被识别**, 故必须能一起设。
                //   类库签名(实读): 置PlatformVersion(文本) / 置FullVersion(文本) /
                //   置Brands(FBrowser_双文本数组) / 置FullVersionList(FBrowser_双文本数组)。
                //   品牌表用紧凑文本 "Chromium:120,Google Chrome:120"(见 解析双文本表)。
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "platform_version") != "")
                {
                    ua_data.置PlatformVersion (MCP命令服务器.yyjson取文本 (参数JSON, "platform_version"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "full_version") != "")
                {
                    ua_data.置FullVersion (MCP命令服务器.yyjson取文本 (参数JSON, "full_version"))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "brands") != "")
                {
                    ua_data.置Brands (MCP命令服务器.解析双文本表 (MCP命令服务器.yyjson取文本 (参数JSON, "brands")))
                }
                如果 (MCP命令服务器.yyjson取文本 (参数JSON, "full_version_list") != "")
                {
                    ua_data.置FullVersionList (MCP命令服务器.解析双文本表 (MCP命令服务器.yyjson取文本 (参数JSON, "full_version_list")))
                }
                vipUA.指纹_虚拟UserAgent (ua_data)
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "UA完整指纹已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        // === VIP 屏幕方向 ===
        否则 (方法名 == "browser_vip_orientation")
        {
            变量 vipOrient <类型 = 类_FBrowserVIP_控制器>
            vipOrient = MCP命令服务器.取VIP控制器 ()
            如果 (vipOrient.是否为空 () == 假)
            {
                // 整数→屏幕方向类型枚举映射 (规避火山 @常量类 模板限制)
                变量 orient_int <类型 = 整数>
                变量 angle_int <类型 = 整数>
                orient_int = MCP命令服务器.yyjson取整数 (参数JSON, "type")
                angle_int = MCP命令服务器.yyjson取整数 (参数JSON, "angle")
                变量 orient_enum <类型 = 屏幕方向类型>
                如果 (orient_int == 1)
                {
                    orient_enum = 屏幕方向类型.竖屏16_9
                }
                否则 (orient_int == 2)
                {
                    orient_enum = 屏幕方向类型.竖屏4_3
                }
                否则 (orient_int == 3)
                {
                    orient_enum = 屏幕方向类型.横屏16_9
                }
                否则 (orient_int == 4)
                {
                    orient_enum = 屏幕方向类型.横屏4_3
                }
                否则
                {
                    orient_enum = 屏幕方向类型.默认
                }
                vipOrient.指纹_虚拟屏幕方向 (orient_enum, angle_int)
                返回 (MCP_响应构建.响应_需要刷新 (命令ID, "屏幕方向已设置"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
        }
        // === 获取额外数据 ===
        否则 (方法名 == "browser_get_extra_data")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 extraData <类型 = 类_FBrowser_字典值>
                extraData = browser.取额外数据 ()
                如果 (extraData.是否为空 () == 假)
                {
                    变量 extraKeys <类型 = FBrowser_文本数组>
                    extraKeys = extraData.取关键字 ()
                    变量 extraObj <类型 = YYJSON对象类>
                    extraObj.创建自文本 ("{}")
                    变量 keyCount <类型 = 整数>
                    keyCount = extraKeys.取个数 ()
                    计次循环 (keyCount)
                    {
                        变量 keyName <类型 = 文本型>
                        keyName = extraKeys.取数据 (取循环索引 ())
                        extraObj.加入文本成员 (keyName, extraData.取文本值 (keyName))
                    }
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, extraObj.到可读文本 (YYJSON格式化选项.压缩)))
                }
                返回 (MCP_响应构建.命令成功 (命令ID, "额外数据为空"))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 控制台禁用(完整) ===
        否则 (方法名 == "browser_vip_disable_console")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip <类型 = 类_FBrowserVIP_控制器>
                vip = browser.取VIP控制器 ()
                如果 (vip.是否为空 () == 假)
                {
                    vip.内核开关_禁用ConsoleLog (MCP命令服务器.yyjson取逻辑 (参数JSON, "log"))
                    vip.内核开关_禁用ConsoleWarn (MCP命令服务器.yyjson取逻辑 (参数JSON, "warn"))
                    vip.内核开关_禁用ConsoleError (MCP命令服务器.yyjson取逻辑 (参数JSON, "error"))
                    vip.内核开关_禁用ConsoleDebug (MCP命令服务器.yyjson取逻辑 (参数JSON, "debug"))
                    vip.内核开关_禁用ConsoleInfo (MCP命令服务器.yyjson取逻辑 (参数JSON, "info"))
                    vip.内核开关_禁用ConsoleTrace (MCP命令服务器.yyjson取逻辑 (参数JSON, "trace"))
                    vip.内核开关_禁用ConsoleClear (MCP命令服务器.yyjson取逻辑 (参数JSON, "clear"))
                    vip.内核开关_禁用ConsoleAssert (MCP命令服务器.yyjson取逻辑 (参数JSON, "assert"))
                    vip.内核开关_禁用ConsoleDir (MCP命令服务器.yyjson取逻辑 (参数JSON, "dir"))
                    vip.内核开关_禁用ConsoleTable (MCP命令服务器.yyjson取逻辑 (参数JSON, "table"))
                    vip.内核开关_禁用ConsoleTime (MCP命令服务器.yyjson取逻辑 (参数JSON, "time"))
                    vip.内核开关_禁用ConsoleCount (MCP命令服务器.yyjson取逻辑 (参数JSON, "count"))
                    vip.内核开关_禁用ConsoleGroup (MCP命令服务器.yyjson取逻辑 (参数JSON, "group"))
                    vip.内核开关_禁用ConsoleProfile (MCP命令服务器.yyjson取逻辑 (参数JSON, "profile"))
                    // 约束: 类库把 最小值/最大值 声明为 @默认值 = 0, 而它自己的注释写的是"默认值0.3/默认值1"。
                    // 只传布尔会让内核收到 0~0 —— 于是 performance.now/mark/measure 退化成**固定 0**,
                    // 比不伪装更容易被反调试识别(常量 0 是最明显的特征)。故这里显式给区间, 并允许调用方覆盖。
                    变量 性能最小毫秒 <类型 = 小数>
                    性能最小毫秒 = MCP命令服务器.yyjson取小数 (参数JSON, "performance_min_ms")
                    如果 (性能最小毫秒 <= 0)
                    {
                        性能最小毫秒 = 0.3
                    }
                    变量 性能最大毫秒 <类型 = 小数>
                    性能最大毫秒 = MCP命令服务器.yyjson取小数 (参数JSON, "performance_max_ms")
                    如果 (性能最大毫秒 <= 0)
                    {
                        性能最大毫秒 = 1
                    }
                    如果 (性能最大毫秒 < 性能最小毫秒)
                    {
                        性能最大毫秒 = 性能最小毫秒
                    }
                    vip.内核开关_禁用Performance检测 (MCP命令服务器.yyjson取逻辑 (参数JSON, "performance"), 性能最小毫秒, 性能最大毫秒)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Console/Performance禁用已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP Event.isTrusted ===
        否则 (方法名 == "browser_vip_set_is_trusted")
        {
            变量 br <类型 = 类_FBrowser_浏览器>
            br = MCP命令服务器.取主浏览器 ()
            如果 (br.是否为空 () == 假)
            {
                变量 vp <类型 = 类_FBrowserVIP_控制器>
                vp = br.取VIP控制器 ()
                如果 (vp.是否为空 () == 假)
                {
                    // 参数名为 enable(见 MCP_Server.wsv schema); 键缺失时取逻辑值为假
                    vp.内核开关_设置EventIsTrusted (MCP命令服务器.yyjson取逻辑 (参数JSON, "enable"))
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "isTrusted已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        返回 ("")
    }
    #
}
