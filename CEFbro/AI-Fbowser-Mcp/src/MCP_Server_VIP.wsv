        }
        否则 (方法名 == "browser_vip_mouse_wheel")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    // x/y 必填(省略会退化为在 (0,0) 滚动); delta_x/delta_y 至少提供一个(否则滚动 0 像素)
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会退化成在 (0,0) 滚动"))
                    }
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "delta_y") == 假 && MCP命令服务器.参数键存在 (参数JSON, "delta_x") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "必须提供 delta_y 或 delta_x (滚动量, 正值向下/向右) | 省略会造成滚动 0 像素却报成功"))
                    }
                    // 零前置(实测): 内核注入的滚动效果受**窗口前台状态**影响 —— 默认流程下实测出现过
                    // "回包成功但页面侧 scrollY 不动"; 先强制显示窗口(显示隐藏窗口(真), 实测 visible_before
                    // 已为真时该调用仍能修正前台状态)再注入, 之后页面侧 scrollY 与 delta 一致。
                    browser.显示隐藏窗口 (真)
                    vip_ctrl.高级鼠标_滚轮滚动 (MCP命令服务器.yyjson取整数 (参数JSON, "x"), MCP命令服务器.yyjson取整数 (参数JSON, "y"), MCP命令服务器.yyjson取整数 (参数JSON, "delta_x"), MCP命令服务器.yyjson取整数 (参数JSON, "delta_y"))
                    // 诚实边界(实测): 本工具每次调用都会毒化本会话 CDP 通道(警告见工具描述), 故**无法在本工具内
                    // 做页面侧回读确认**; 需要可验证的滚动请用 CDP 版 browser_mouse_wheel(实测 0.03s 且不毒化)。
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP鼠标滚轮(内核注入) | 诚实边界: 本工具每次调用都会破坏本会话 CDP 通道(需重启恢复), 且无法在本工具内回读确认滚动效果 | 需要可验证、不毒化的滚动请用 CDP 版 browser_mouse_wheel(实测 0.03s, 页面侧 scrollY 可回读一致)"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
