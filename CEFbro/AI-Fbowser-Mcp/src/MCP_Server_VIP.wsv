<火山程序 类型 = "通常" 版本 = 1 />
包 火山.程序
# VIP 命令分派 — 从 MCP_Server.wsv 拆分 (L5/M10)
类 MCP_VIP分派 <公开 @全局类 = 真 @输出名 = "MCPVIPDispatch">
{
    方法 分类分派_VIP操作 <公开 静态 类型 = 文本型 @输出名 = "DispatchClassVIPOp" @强制输出 = 真>
    参数 命令ID <类型 = 文本型 @输出名 = "CommandID">
    参数 方法名 <类型 = 文本型 @输出名 = "MethodName">
    参数 参数JSON <类型 = YYJSON只读对象类 @输出名 = "ParamJSON">
    {
        子文本替换 (方法名, "browser.", "browser_", , , 假)
        如果 (方法名 == "browser_vip_websocket_intercept")
        {
            变量 enableFlag <类型 = 逻辑型>
            enableFlag = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "enable") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "enable 不能省略 | 请显式传 enable:true 开启 WebSocket 拦截 | 说明: 本工具只支持开启, 关闭请用 browser_intercept action=clear"))
                    }
                    如果 (enableFlag)
                    {
                        vip_ctrl.WebSocket_启用拦截 ()
                        返回 (MCP_响应构建.命令成功 (命令ID, "WebSocket拦截已启用"))
                    }
                    否则
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "WebSocket拦截不支持单独禁用, 请使用 browser_intercept action=clear 清除所有拦截"))
                    }
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 快速连通性检查 ===
        // === VIP S5代理 ===
        否则 (方法名 == "browser_set_s5_proxy")
        {
            变量 address <类型 = 文本型>
            address = MCP命令服务器.yyjson取文本 (参数JSON, "address")
            如果 (address == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "address " + MCP_常量.错误_缺少参数))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级_设置代理 (address, MCP命令服务器.yyjson取文本 (参数JSON, "username"), MCP命令服务器.yyjson取文本 (参数JSON, "password"))
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "S5代理已设置: " + address))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 高级鼠标键盘 (CDP) ===
        否则 (方法名 == "browser_vip_mouse_click")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 vx <类型 = 整数>
                    vx = MCP命令服务器.yyjson取整数 (参数JSON, "x")
                    变量 vy <类型 = 整数>
                    vy = MCP命令服务器.yyjson取整数 (参数JSON, "y")
                    // x/y 为必填整数坐标: 缺省会退化为在页面左上角 (0,0) 单击, 故拒绝执行
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当作 (0,0) 而在页面左上角误点, 故拒绝执行; 如需点左上角请显式传 x=0 y=0"))
                    }
                    如果 (vx < 0 || vy < 0 || vx > 32767 || vy > 32767)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "坐标越界 | x,y 须在 0~32767 范围内"))
                    }
                    // 单击延时(类库第4参, 默认50ms): 反爬场景常需要更长的按压时长, 原先被截断只能吃默认值
                    变量 vclick延迟 <类型 = 整数>
                    vclick延迟 = MCP命令服务器.yyjson取整数 (参数JSON, "delay_ms")
                    如果 (vclick延迟 <= 0)
                    {
                        vclick延迟 = 50
                    }
                    如果 (vclick延迟 > 5000)
                    {
                        vclick延迟 = 5000
                    }
                    vip_ctrl.高级鼠标_单击 (vx, vy, MCP命令服务器.yyjson取整数 (参数JSON, "button"), vclick延迟)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP鼠标点击 button=" + 到文本 (MCP命令服务器.yyjson取整数 (参数JSON, "button")) + " delay_ms=" + 到文本 (vclick延迟)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_mouse_move")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    // x/y 为必填整数坐标: 缺参会把鼠标移到页面左上角 (0,0), 故拒绝执行
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "x") == 假 || MCP命令服务器.参数键存在 (参数JSON, "y") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "必须同时提供 x 与 y (整数坐标) | 缺省会被当成 (0,0) 而把鼠标移到页面左上角, 故拒绝执行"))
                    }
                    vip_ctrl.高级鼠标_移动 (MCP命令服务器.yyjson取整数 (参数JSON, "x"), MCP命令服务器.yyjson取整数 (参数JSON, "y"))
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP鼠标移动"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_key_press")
        {
            变量 pressKeyCode <类型 = 整数>
            pressKeyCode = MCP命令服务器.yyjson取整数 (参数JSON, "key_code")
            如果 (pressKeyCode <= 0 || pressKeyCode > 255)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 key_code 无效(" + 到文本 (pressKeyCode) + ") | 虚拟键码范围 1~255, 如回车=13, 空格=32, A=65"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级键盘_按下 (pressKeyCode)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP键盘按下: key_code=" + 到文本 (pressKeyCode)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_key_release")
        {
            变量 releaseKeyCode <类型 = 整数>
            releaseKeyCode = MCP命令服务器.yyjson取整数 (参数JSON, "key_code")
            如果 (releaseKeyCode <= 0 || releaseKeyCode > 255)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "参数 key_code 无效(" + 到文本 (releaseKeyCode) + ") | 虚拟键码范围 1~255"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级键盘_放开 (releaseKeyCode)
                    返回 (MCP_响应构建.命令成功 (命令ID, "VIP键盘放开: key_code=" + 到文本 (releaseKeyCode)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 补充 ===
        否则 (方法名 == "browser_vip_clear_s5_proxy")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级_清空代理 ()
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "S5代理已清除"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_enable_inspector")
        {
            // enable 缺失一律拒绝(不接受缺省): 缺省会被当成关闭, 会注销 CDP 观察者。
            // 缺失键用 参数键存在 判定; 取值归一化: 文本 false/0/off 视为关闭, true/1/on 视为启用;
            // **非空但无法识别的取值同样拒绝**(见下 取值已识别 白名单)。
            变量 开关文本 <类型 = 文本型>
            开关文本 = MCP命令服务器.yyjson取文本 (参数JSON, "enable")
            变量 开关布尔 <类型 = 逻辑型>
            开关布尔 = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
            如果 (MCP命令服务器.参数键存在 (参数JSON, "enable") == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "必须显式指定 enable | 启用: enable:true | 关闭: enable:false | 不接受缺省, 因为缺省会被当成关闭并注销 CDP 观察者"))
            }
            变量 目标状态 <类型 = 逻辑型>
            目标状态 = 开关布尔
            // ★ 安全性(与 browser_vip_enable_devtools_observer 同一缺陷类): 只挡"键缺失"不够 ——
            //   于是**无法识别的非空取值**会一路走到 目标状态=开关布尔(=非布尔节点取逻辑=假),
            //   再落进 注销CDP观察者() 这个破坏性分支。即"最危险的取值成了兜底"。
            //   台账实测: enable:"mcp_probe" 落到过 "监管者事件已关闭"。
            变量 取值已识别 <类型 = 逻辑型 值 = 假>
            如果 (开关文本 == "false" || 开关文本 == "0" || 开关文本 == "off")
            {
                目标状态 = 假
                取值已识别 = 真
            }
            否则 (开关文本 == "true" || 开关文本 == "1" || 开关文本 == "on")
            {
                目标状态 = 真
                取值已识别 = 真
            }
            否则 (开关文本 == "")
            {
                // 键已确认存在, 且本工具明确接受 布尔 false 作为关闭(见上面缺失键的提示文案),
                // 故非文本(布尔)取值沿用 目标状态=开关布尔 的既有语义。
                // 注: 这里对 "裸数字 1" 之类非布尔节点仍无法与 布尔 false 区分(类库取逻辑对非布尔一律给假),
                //     属本工具既有歧义(行为未改变); 文档形式请用字符串 "true"/"1"。
                取值已识别 = 真
            }
            如果 (取值已识别 == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "enable 取值无法识别: " + 开关文本 + " | 只接受: 字符串 true/false/1/0/on/off, 或布尔 true/false | 无法识别的取值一律拒绝, 不落进'关闭观察者'这个破坏性分支"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (目标状态)
                    {
                        MCP命令服务器.确保CDP观察者已注册 (browser)
                    }
                    否则
                    {
                        // 同 browser_vip_enable_devtools_observer: 关闭会注销 CDP 观察者
                        MCP命令服务器.注销CDP观察者 (browser)
                        返回 (MCP_响应构建.命令成功 (命令ID, "监管者事件已关闭 | 已注销 CDP 观察者(cdp_ready=false) | 实测纠正: 下一次 CDP 调用会自动重新注册观察者并自愈, 通常无需重启(旧文案'需重启进程才能恢复'与实测不符)"))
                    }
                    返回 (MCP_响应构建.命令成功 (命令ID, "监管者事件已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_enable_js_env")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    // enable 不能省略: 省略等同于关闭 JS 执行环境, 会让页面脚本整体失效
                    如果 (MCP命令服务器.参数键存在 (参数JSON, "enable") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "enable 不能省略 | 省略等同于**关闭** JS 执行环境(会让页面脚本失效); 请显式传 true=启用 / false=关闭"))
                    }
                    // 启用 JS 执行环境为破坏性操作: 需显式传 confirm:true;
                    // 启用会破坏本会话 JS 通道, 只有重启进程才能恢复。
                    如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "enable") && MCP命令服务器.参数键存在 (参数JSON, "confirm") == 假)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "启用 JS 执行环境需显式确认 | ⚠ 实测启用后会破坏本会话的 JS 通道: CDP 优先工具(browser_dom_query / browser_dom_rect / browser_get_text 等)会退化为 null, browser_execute_js 也会超时, 且注销/重注册监管者与重新导航均无法恢复, 只有重启进程才能恢复。确认要继续请传 confirm:true"))
                    }
                    vip_ctrl.高级_启用执行环境 (MCP命令服务器.yyjson取逻辑 (参数JSON, "enable"))
                    // 维护自有状态: 供 browser_vip_execute_js_context 做**前置判断**,
                    // 避免"未启用执行环境 -> 回调永不触发 -> 调用方白等到超时"。
                    MCP命令服务器.VIP_JS环境已启用 = MCP命令服务器.yyjson取逻辑 (参数JSON, "enable")
                    如果 (MCP命令服务器.yyjson取逻辑 (参数JSON, "enable"))
                    {
                        返回 (MCP_响应构建.命令成功 (命令ID, "JS执行环境已设置 | ⚠ 已启用: 实测启用后会破坏 CDP 通道, 使 CDP 优先的工具(browser_dom_query / browser_dom_rect / browser_get_text 等)退回原生路径并可能返回 null, 且需重启进程才能恢复; 若非确有必要, 建议只在会话末尾使用"))
                    }
                    // 诚实性(本机实测): 关闭路径同样会破坏本会话 CDP 通道(execute_js 0.02s → 30s)且不恢复 ——
                    // 原实现只在启用路径加警告, 关闭路径静默毒化; 现在两侧一致声明"需重启进程恢复"。
                    返回 (MCP_响应构建.命令成功 (命令ID, "JS执行环境已关闭 | ⚠ 实测: 关闭操作同样会破坏本会话 CDP 通道(execute_js 退化到 30s)且不会恢复, 需重启进程; 若非确有必要, 建议只在会话末尾使用"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 新标签页(高级_创建标签浏览器): 分诊 B5 真缺口 ===
        // 类库前置(原文): 谷歌模式下才可以使用; 空地址=当前浏览器地址; 序号 -1=末尾; 激活真=跳转该标签。
        否则 (方法名 == "browser_vip_new_tab")
        {
            变量 ntBrowser <类型 = 类_FBrowser_浏览器>
            ntBrowser = MCP命令服务器.取主浏览器 ()
            如果 (ntBrowser.是否为空 () == 假)
            {
                // 与 browser_create/弹窗同款实例上限(2025-09-13 补): 此前本路径无判定, 可越过 64 上限
                如果 (FBrowser_浏览器_取数量 () >= MCP_常量.浏览器实例最大数量)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "浏览器实例已达上限(" + 到文本 (MCP_常量.浏览器实例最大数量) + ")"))
                }
                变量 ntVIP <类型 = 类_FBrowserVIP_控制器>
                ntVIP = ntBrowser.取VIP控制器 ()
                如果 (ntVIP.是否为空 () == 假)
                {
                    // 前置校验(类库原文: 谷歌模式下才可以使用) —— 非谷歌模式明确失败, 不静默。
                    变量 nt风格 <类型 = 窗口运行风格>
                    nt风格 = ntBrowser.取窗口运行风格 ()
                    如果 ((整数)nt风格 != 1)
                    {
                        返回 (MCP_响应构建.命令失败 (命令ID, "本工具需**谷歌模式**(类库原文) | 当前 runtime_style=" + 到文本 ((整数)nt风格) + "(0默认/1谷歌/2经典; 用 browser_get_run_style 查) | 替代: 跨窗口用 browser_create, 同窗口多页用 browser_navigate"))
                    }
                    变量 ntURL <类型 = 文本型>
                    ntURL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
                    变量 nt序号 <类型 = 整数>
                    nt序号 = MCP命令服务器.yyjson取整数 (参数JSON, "index")
                    变量 nt激活 <类型 = 逻辑型>
                    nt激活 = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "activate", 假)
                    变量 nt标识 <类型 = 文本型>
                    nt标识 = MCP命令服务器.yyjson取文本 (参数JSON, "tag")
                    如果 (ntURL != "")
                    {
                        如果 (MCP命令服务器.验证URL安全 (ntURL) == 假 || (是否以 (ntURL, "http://") == 假 && 是否以 (ntURL, "https://") == 假))
                        {
                            返回 (MCP_响应构建.命令失败 (命令ID, "不支持的URL协议, 仅允许 http/https"))
                        }
                    }
                    变量 nt字典 <类型 = 类_FBrowser_字典值>
                    nt字典.创建 ()
                    变量 nt禁用 <类型 = FBrowser_禁用事件>
                    ntVIP.高级_创建标签浏览器 (ntURL, nt序号, nt激活, nt字典, 空对象, nt禁用, nt标识)
                    返回 (MCP_响应构建.命令成功 (命令ID, "标签浏览器创建已提交 | url=" + 选择 (ntURL == "", "(当前浏览器地址)", ntURL) + " index=" + 到文本 (nt序号) + " activate=" + 选择 (nt激活, "true", "false") + " tag=" + nt标识 + " | 新标签会出现在 browser_list(新 browser_id), 之后任何工具传 browser_id 即可操作 | 诚实边界: 类库为异步创建, 立即 browser_list 可能尚未出现, 稍候重查"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 响应过滤器: 文本改写(过滤器_修改内容 / 取消修改内容) ===
        // 类库原文: 对目标地址通过匹配目标文本修改内容, 在资源加载前设置(浏览器创建后设置也有效);
        // 若 浏览器_获取资源过滤器 事件返回真自定义拦截, 此设置不生效; 同一目标多次调用需保持匹配模式一致。
        // 诚实边界: 类库无读取接口, 本工具无法回读; 对**设置之后加载**的目标资源生效, 用刷新/重新导航后
        // 页面侧回读验证。VIP 高级功能(需赞助; 本机可用)。
        否则 (方法名 == "browser_vip_filter_patch_text")
        {
            变量 fpAction <类型 = 文本型>
            fpAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (fpAction == "")
            {
                fpAction = "set"
            }
            变量 fpURL <类型 = 文本型>
            fpURL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            变量 fpFind <类型 = 文本型>
            fpFind = MCP命令服务器.yyjson取文本 (参数JSON, "find")
            变量 fpReplace <类型 = 文本型>
            fpReplace = MCP命令服务器.yyjson取文本 (参数JSON, "replace")
            变量 fpVIP <类型 = 类_FBrowserVIP_控制器>
            fpVIP = MCP命令服务器.取VIP控制器 ()
            如果 (fpVIP.是否为空 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            如果 (fpAction == "clear")
            {
                如果 (fpURL == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "clear 需要 url(与之前设置的目标地址一一对应)"))
                }
                fpVIP.过滤器_取消修改内容 (fpURL)
                返回 (MCP_响应构建.命令成功 (命令ID, "已取消该地址的文本改写: " + fpURL))
            }
            如果 (fpAction != "set")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + fpAction + " | 支持 set/clear"))
            }
            如果 (fpURL == "" || fpFind == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "set 需要 url 与 find | replace 可留空(把目标文本删除); 对之后加载的资源生效, 刷新/重新导航后验证"))
            }
            变量 fpMatch <类型 = 整数>
            fpMatch = MCP命令服务器.yyjson取整数 (参数JSON, "match")
            如果 (fpMatch < 0 || fpMatch > 4)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "match 需在 0..4 | 0=完全匹配(默认) 1=模糊 2=头部模糊(尾同) 3=尾部模糊(头同) 4=正则"))
            }
            变量 fpMode <类型 = 整数>
            fpMode = MCP命令服务器.yyjson取整数 (参数JSON, "mode")
            如果 (fpMode < 0 || fpMode > 3)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "mode 需在 0..3 | 0=修改第一个匹配(默认) 1=修改全部匹配 2=在第一个匹配后插入 3=全部匹配后插入"))
            }
            fpVIP.过滤器_修改内容 (fpMatch, fpURL, fpMode, fpFind, fpReplace)
            返回 (MCP_响应构建.命令成功 (命令ID, "文本改写已设置: " + fpURL + " | 诚实边界: 类库无读取接口, 无法回读; 对**设置之后加载**的目标资源生效(刷新/重新导航后页面侧回读验证); 若 浏览器_获取资源过滤器 事件返回真自定义拦截则不生效 | 取消: action=clear {url}"))
        }
        // === VIP 响应过滤器: 整体资源替换(过滤器_替换资源_数据 / 取消替换资源) ===
        否则 (方法名 == "browser_vip_filter_replace_data")
        {
            变量 frAction <类型 = 文本型>
            frAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (frAction == "")
            {
                frAction = "set"
            }
            变量 frURL <类型 = 文本型>
            frURL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            变量 frVIP <类型 = 类_FBrowserVIP_控制器>
            frVIP = MCP命令服务器.取VIP控制器 ()
            如果 (frVIP.是否为空 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            如果 (frAction == "clear")
            {
                如果 (frURL == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "clear 需要 url(与之前设置的目标地址一一对应)"))
                }
                frVIP.过滤器_取消替换资源 (frURL)
                返回 (MCP_响应构建.命令成功 (命令ID, "已取消该地址的整体资源替换: " + frURL))
            }
            如果 (frAction != "set")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + frAction + " | 支持 set/clear"))
            }
            变量 frBody <类型 = 文本型>
            frBody = MCP命令服务器.yyjson取文本 (参数JSON, "body")
            变量 frBase64 <类型 = 文本型>
            frBase64 = MCP命令服务器.yyjson取文本 (参数JSON, "body_base64")
            如果 (frURL == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "set 需要 url(目标资源完整地址)"))
            }
            如果 (frBody == "" && frBase64 == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "set 需要 body(替换内容文本, UTF-8) 或 body_base64(二进制内容)"))
            }
            变量 fr字节 <类型 = 字节集类>
            如果 (frBase64 != "")
            {
                变量 fr解码 <类型 = 类_FBrowser_字节集>
                fr解码 = FBrowser_Parser_Base64解码 (frBase64)
                如果 (fr解码.是否为空 () || fr解码.取大小 () == 0)
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "body_base64 解码失败或为空"))
                }
                fr字节 = fr解码.取字节集 ()
            }
            否则
            {
                fr字节 = 文本到UTF8 (frBody, 假)
            }
            变量 frMatch <类型 = 整数>
            frMatch = MCP命令服务器.yyjson取整数 (参数JSON, "match")
            如果 (frMatch < 0 || frMatch > 4)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "match 需在 0..4 | 0=完全匹配(默认) 1=模糊 2=头部模糊(尾同) 3=尾部模糊(头同) 4=正则"))
            }
            变量 frMime <类型 = 文本型>
            frMime = MCP命令服务器.yyjson取文本 (参数JSON, "mime_type")
            变量 fr头 <类型 = FBrowser_双文本数组>
            frVIP.过滤器_替换资源_数据 (frMatch, frURL, frMime, fr头, fr字节)
            返回 (MCP_响应构建.命令成功 (命令ID, "整体资源替换已设置: " + frURL + " (" + 到文本 (取字节集长度 (fr字节)) + " 字节) | 诚实边界: 类库无读取接口, 无法回读; 对**设置之后加载**的目标资源生效(刷新/重新导航后页面侧回读验证); 若 浏览器_获取资源处理器 事件返回真自定义资源则不生效 | 取消: action=clear {url}"))
        }
        // === VIP 响应过滤器: 整体资源替换·本地文件版(过滤器_替换资源_文件 / 取消替换资源) ===
        // 与 替换资源_数据 同族, 替换内容来自本地文件; 路径经 验证安全路径 拦截遍历(../)攻击。
        否则 (方法名 == "browser_vip_filter_replace_file")
        {
            变量 ffAction <类型 = 文本型>
            ffAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (ffAction == "")
            {
                ffAction = "set"
            }
            变量 ffURL <类型 = 文本型>
            ffURL = MCP命令服务器.yyjson取文本 (参数JSON, "url")
            变量 ffFile <类型 = 文本型>
            ffFile = MCP命令服务器.yyjson取文本 (参数JSON, "file")
            变量 ffVIP <类型 = 类_FBrowserVIP_控制器>
            ffVIP = MCP命令服务器.取VIP控制器 ()
            如果 (ffVIP.是否为空 ())
            {
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            如果 (ffAction == "clear")
            {
                如果 (ffURL == "")
                {
                    返回 (MCP_响应构建.命令失败 (命令ID, "clear 需要 url(与之前设置的目标地址一一对应)"))
                }
                ffVIP.过滤器_取消替换资源 (ffURL)
                返回 (MCP_响应构建.命令成功 (命令ID, "已取消该地址的整体资源替换: " + ffURL))
            }
            如果 (ffAction != "set")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "未知 action: " + ffAction + " | 支持 set/clear"))
            }
            如果 (ffURL == "" || ffFile == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "set 需要 url 与 file(本地替换文件的完整路径)"))
            }
            如果 (MCP命令服务器.验证安全路径 (ffFile, 假) == 假)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "路径不允许(含路径遍历): " + ffFile))
            }
            变量 ffMatch <类型 = 整数>
            ffMatch = MCP命令服务器.yyjson取整数 (参数JSON, "match")
            如果 (ffMatch < 0 || ffMatch > 4)
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "match 需在 0..4 | 0=完全匹配(默认) 1=模糊 2=头部模糊(尾同) 3=尾部模糊(头同) 4=正则"))
            }
            变量 ffMime <类型 = 文本型>
            ffMime = MCP命令服务器.yyjson取文本 (参数JSON, "mime_type")
            变量 ff头2 <类型 = FBrowser_双文本数组>
            ffVIP.过滤器_替换资源_文件 (ffMatch, ffURL, ffMime, ff头2, ffFile)
            返回 (MCP_响应构建.命令成功 (命令ID, "整体资源替换已设置(文件): " + ffURL + " ← " + ffFile + " | 诚实边界: 类库无读取接口, 无法回读; 对**设置之后加载**的目标资源生效(刷新/重新导航后页面侧回读验证); 文件在请求时由内核读取, 请在替换期间保持文件存在 | 取消: action=clear {url}"))
        }
        否则 (方法名 == "browser_vip_get_js_env_ids")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    变量 ids <类型 = 类_FBrowser_列表值>
                    ids = vip_ctrl.高级_取当前环境ID清单 ()
                    // 类库注释原文: 返回**文本列表值**, 值为环境ID文本数据; 官方例子(main14.wsv)逐项取文本值、
                    // 需要整数时再 文本到整数 转换。原实现逐项取整数值 —— CEF 列表值分类型, 文本元素走取整数
                    // 通道拿不到数值(实测回包 ids 全 0 的静默错误)。故: ids_text 逐项取文本值(原文照发, 权威),
                    // ids_int 尽力转整数(供 context_id 直用), 并如实说明两者关系。
                    变量 idsTextArr <类型 = YYJSON数组类>
                    idsTextArr.创建自文本数据 (MCP命令服务器.取空文本数组 ())
                    变量 idsIntArr <类型 = YYJSON数组类>
                    idsIntArr.创建自文本数据 (MCP命令服务器.取空文本数组 ())
                    变量 idsCount <类型 = 整数 值 = 0>
                    如果 (ids.是否为空 () == 假)
                    {
                        idsCount = ids.取大小 ()
                        计次循环 (idsCount)
                        {
                            变量 一项文本 <类型 = 文本型>
                            一项文本 = ids.取文本值 (取循环索引 ())
                            idsTextArr.加入文本成员 (一项文本)
                            变量 一项整数 <类型 = 整数>
                            一项整数 = 文本到整数 (一项文本)
                            如果 (一项整数 == 0)
                            {
                                // 实测: 清单元素是**上下文对象 JSON 文本**, 整数环境ID在 context.id 成员里
                                // (顶层只有 context 键); 纯文本转整数拿不到, 需解析 JSON 两级取 id。
                                变量 一项对象 <类型 = YYJSON只读对象类>
                                如果 (一项对象.创建自文本 (一项文本))
                                {
                                    变量 上下文成员 <类型 = YYJSON只读对象类>
                                    上下文成员 = MCP命令服务器.yyjson取对象成员 (一项对象, "context")
                                    一项整数 = MCP命令服务器.yyjson取整数 (上下文成员, "id")
                                }
                            }
                            idsIntArr.加入整数成员 (一项整数)
                        }
                    }
                    // 输出完整ID清单(供 browser_vip_execute_js_context 使用), 空清单是合法状态
                    变量 idsOut <类型 = YYJSON对象类>
                    idsOut.创建自文本 ("{}")
                    idsOut.加入逻辑值成员 ("success", 真)
                    idsOut.加入整数成员 ("count", idsCount)
                    idsOut.加入数组成员 ("ids_text", idsTextArr)
                    idsOut.加入数组成员 ("ids_int", idsIntArr)
                    idsOut.加入文本成员 ("note", "类库返回文本列表值: ids_text 为权威原文(实测每项是上下文对象JSON文本, 含 id/frameId/uniqueId, context_id 与 frame_id 都取自它); ids_int 为尽力转整数(纯数字直转, 对象JSON取 id 成员, 其余为 0) | 清单需先 browser_vip_enable_js_env 启用执行环境才有效, 未启用时空清单是合法状态")
                    返回 (MCP_响应构建.命令成功_原始JSON (命令ID, idsOut.到可读文本 (YYJSON格式化选项.压缩)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_vip_touch_cancel")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.高级触摸_取消 (MCP命令服务器.yyjson取整数 (参数JSON, "x"), MCP命令服务器.yyjson取整数 (参数JSON, "y"))
                    返回 (MCP_响应构建.命令成功 (命令ID, "触摸取消"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 内核开关 ===
        否则 (方法名 == "browser_vip_disable_debugger")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.内核开关_禁用Debugger (MCP命令服务器.yyjson取逻辑 (参数JSON, "disable"))
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Debugger开关已设置 | 内核开关修改, 需要刷新页面生效"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === VIP 指纹扩展 ===
        否则 (方法名 == "browser_fingerprint_plugins")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.指纹_虚拟Plugins (MCP命令服务器.yyjson取整数 (参数JSON, "type"), MCP命令服务器.yyjson取JSON文本 (参数JSON, "json"))
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "Plugins指纹已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_fingerprint_appname")
        {
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    vip_ctrl.指纹_虚拟AppName (MCP命令服务器.yyjson取文本 (参数JSON, "value"))
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "AppName指纹已设置"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_fingerprint_languages")
        {
            变量 langReset <类型 = 逻辑型>
            langReset = MCP命令服务器.yyjson取逻辑_默认 (参数JSON, "reset", 假)
            变量 langText <类型 = 文本型>
            langText = MCP命令服务器.yyjson取文本 (参数JSON, "languages")
            如果 (langReset == 假 && langText == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "languages 不能为空, 例: zh-CN,zh,en | 恢复默认请传 reset:true"))
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (langReset)
                    {
                        // 类库无单项复位API(仅 清理数据 为全量清除): 传空文本交回库内部默认
                        vip_ctrl.指纹_虚拟Languages ("")
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "语言指纹已恢复默认(传空文本) | 类库无单项复位API, 空文本由库内部按默认处理; 彻底复位请用 browser_fingerprint action=clear"))
                    }
                    vip_ctrl.指纹_虚拟Languages (langText)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "已设置语言: " + langText))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_fingerprint_webgl_vendor")
        {
            变量 glVendor <类型 = 文本型>
            glVendor = MCP命令服务器.yyjson取文本 (参数JSON, "vendor")
            如果 (glVendor == "")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "vendor 不能为空, 例: Google Inc. (NVIDIA)"))
            }
            变量 glRenderer <类型 = 文本型>
            glRenderer = MCP命令服务器.yyjson取文本 (参数JSON, "renderer")
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    // 类库将 vendor 与 renderer 拆为两个独立API (见 Core 的 set_batch 既有调用)
                    vip_ctrl.指纹_虚拟Webglvendor (glVendor)
                    如果 (glRenderer != "")
                    {
                        vip_ctrl.指纹_虚拟Webglrenderer (glRenderer)
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "WebGL vendor已设置: " + glVendor + " | renderer已设置: " + glRenderer))
                    }
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "WebGL vendor已设置: " + glVendor + " | renderer 未提供, 由库内部决定"))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        否则 (方法名 == "browser_font_randomize")
        {
            变量 frAction <类型 = 文本型>
            frAction = MCP命令服务器.yyjson取文本 (参数JSON, "action")
            如果 (frAction == "")
            {
                frAction = "random"
            }
            如果 (frAction != "random" && frAction != "reset")
            {
                返回 (MCP_响应构建.命令失败 (命令ID, "action 只支持 random/reset"))
            }
            变量 frCount <类型 = 整数>
            frCount = MCP命令服务器.yyjson取整数 (参数JSON, "count")
            变量 frSeed <类型 = 整数>
            frSeed = MCP命令服务器.yyjson取整数 (参数JSON, "seed")
            如果 (frCount < 0)
            {
                frCount = 0
            }
            变量 browser <类型 = 类_FBrowser_浏览器>
            browser = MCP命令服务器.取主浏览器 ()
            如果 (browser.是否为空 () == 假)
            {
                变量 vip_ctrl <类型 = 类_FBrowserVIP_控制器>
                vip_ctrl = browser.取VIP控制器 ()
                如果 (vip_ctrl.是否为空 () == 假)
                {
                    如果 (frAction == "reset")
                    {
                        // 类库无字体单项复位API: 字体清单置空 + 偏移归零 = 交回库默认枚举
                        vip_ctrl.指纹_虚拟CSS字体指纹 ("", 0, 0)
                        vip_ctrl.指纹_虚拟Canvas字体指纹 (0)
                        返回 (MCP_响应构建.响应_需要刷新 (命令ID, "字体随机化已复位: 字体清单置空 + 宽高偏移归零 + Canvas字体度量归零 | 类库无字体单项复位API, 空清单由库内部按默认处理; 彻底复位请用 browser_fingerprint action=clear"))
                    }
                    // seed 非0 时固定随机序列, 便于复现同一套字体指纹
                    如果 (frSeed != 0)
                    {
                        置随机数种子 (frSeed)
                    }
                    变量 frFonts <类型 = 文本型>
                    frFonts = ""
                    如果 (frCount > 0)
                    {
                        // 候选字体池: 逗号分隔文本, 与 browser_vip_fingerprint_font 的字体清单同形
                        变量 frPool <类型 = 文本数组类>
                        分割文本 ("Arial,Helvetica,Times New Roman,Courier New,Georgia,Verdana,Tahoma,Trebuchet MS,Calibri,Cambria,Consolas,Segoe UI,Microsoft YaHei,SimSun,SimHei,KaiTi,FangSong,MS Gothic,Meiryo,Malgun Gothic", ",", frPool, 真, 真)
                        变量 fr剩余 <类型 = 文本数组类>
                        计次循环 (frPool.取成员数 ())
                        {
                            fr剩余.加入成员 (frPool.取成员 (取循环索引 ()))
                        }
                        如果 (frCount > fr剩余.取成员数 ())
                        {
                            frCount = fr剩余.取成员数 ()
                        }
                        计次循环 (frCount)
                        {
                            变量 frPick <类型 = 整数>
                            frPick = 取随机数 (0, fr剩余.取成员数 () - 1)
                            如果 (frFonts != "")
                            {
                                frFonts = frFonts + ","
                            }
                            frFonts = frFonts + fr剩余.取成员 (frPick)
                            // 文本数组类无置成员方法, 按既有做法剔除后重建 (保证不重复抽取同一字体)
                            变量 fr新池 <类型 = 文本数组类>
                            计次循环 (fr剩余.取成员数 ())
                            {
                                如果 (取循环索引 () != frPick)
                                {
                                    fr新池.加入成员 (fr剩余.取成员 (取循环索引 ()))
                                }
                            }
                            fr剩余 = fr新池
                        }
                    }
                    // 宽/高偏移量小幅随机 (单位同 browser_vip_fingerprint_font 的 w_offset/h_offset)
                    变量 frW <类型 = 整数>
                    frW = 取随机数 (-2, 2)
                    变量 frH <类型 = 整数>
                    frH = 取随机数 (-2, 2)
                    // Canvas字体度量噪点: 复用 browser_vip_fingerprint_canvas_font 的调用形态
                    变量 frCanvas <类型 = 小数>
                    frCanvas = 取随机小数 (-0.5, 0.5)
                    vip_ctrl.指纹_虚拟CSS字体指纹 (frFonts, frW, frH)
                    vip_ctrl.指纹_虚拟Canvas字体指纹 (frCanvas)
                    返回 (MCP_响应构建.响应_需要刷新 (命令ID, "字体枚举已随机化: count=" + 到文本 (frCount) + " | 宽偏移=" + 到文本 (frW) + " | 高偏移=" + 到文本 (frH) + " | Canvas字体度量噪点=" + 到文本 (frCanvas) + " | seed=" + 到文本 (frSeed) + " | 字体清单: " + 选择 (frFonts == "", "(空: 用库默认)", frFonts)))
                }
                返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_VIP不可用))
            }
            返回 (MCP_响应构建.命令失败 (命令ID, MCP_常量.错误_无浏览器))
        }
        // === 指纹补充: Cookie/Java/Online ===
        否则 (方法名 == "browser_fingerprint_cookie_enabled")
