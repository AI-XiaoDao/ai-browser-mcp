<火山程序 类型 = "通常" 版本 = 1 />
包 火山.程序
# ================================================================
# MCP Stdio 传输层 — 纯火山实现
# stdin/stdout 读写 + MCP 主循环
# 复用 MCP命令服务器.处理MCP请求() 作为MCP引擎
# ================================================================
类 MCPStdio桥 <公开 @全局类 = 真>
{
    变量 Stdio线程实例 <公开 静态 类型 = 类_MCP_Stdio服务线程>
    变量 Stdio应退出 <公开 静态 类型 = 逻辑型 值 = 假>
    变量 上次读取为断开 <公开 静态 类型 = 逻辑型 值 = 假 注释 = "读取一行 返回空串时区分真断开(句柄关闭/读失败=真)与瞬态(超时/畸形帧=假), 主循环仅真断开计入空读次数">
    # ======== stdin 读取 (MCP Content-Length 帧解析 + 裸单行兼容, 可响应线程停止) ========
    方法 读取一行 <公开 静态 类型 = 文本型>
    参数 线程句柄 <类型 = 变整数 @默认值 = 0 注释 = "非0时在等待stdin期间检查是否需要退出">
    {
        变量 行字节集 <类型 = 字节集类>
        @ // 可中断读取: PeekNamedPipe 轮询 + 线程退出检查, 避免退出时 ReadFile 永久阻塞
        @ // 协议: 优先解析 "Content-Length: N\r\n\r\n{json}" 帧; 无头时按裸单行处理
        @ *(volatile BOOL*)&@<上次读取为断开> = FALSE;
        @ HANDLE hStdin = GetStdHandle(STD_INPUT_HANDLE);
        @ if (hStdin == INVALID_HANDLE_VALUE || hStdin == NULL) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; return CVolString(); }
        @ // 修复: 文件/控制台重定向的stdin不是管道, PeekNamedPipe对其返回FALSE会被误判为断开; 非管道改直读模式
        @ const bool isPipe = (GetFileType(hStdin) == FILE_TYPE_PIPE);
        @ DWORD emptyPolls = 0;
        @ std::string headLine;
        @ for (;;) {
        @     if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @     if (@<线程句柄> != 0 && g_objVolApp.GetThreadPool().IsThreadNeedBreak((HVOLTHREAD)@<线程句柄>, 0))
        @         return CVolString();
        @     DWORD avail = 0;
        @     if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &avail, NULL)) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; break; } }
        @     else { avail = 1; }  // 非管道: 数据总是可读, EOF由ReadFile返回0检出
        @     if (isPipe && avail == 0) { Sleep(50); continue; }  // 管道仍打开: 空闲等待, 不把空闲误判为断开
        @     emptyPolls = 0;
        @     // 读头部行(或裸JSON行): Peek轮询+退出检查, 避免ReadFile阻塞导致停止死等
        @     DWORD headLen = 0;
        @     bool gotNewline = false;
        @     bool headFailed = false;
        @     DWORD headEmptyPolls = 0;
        @     while (headLen < 1048576) {
        @         if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @         if (@<线程句柄> != 0 && g_objVolApp.GetThreadPool().IsThreadNeedBreak((HVOLTHREAD)@<线程句柄>, 0))
        @             return CVolString();
        @         DWORD availH = 0;
        @         if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &availH, NULL)) { headFailed = true; *(volatile BOOL*)&@<上次读取为断开> = TRUE; break; } }
        @         else { availH = 1; }
        @         if (isPipe && availH == 0) { if (++headEmptyPolls > 1200) { headFailed = true; break; } Sleep(50); continue; }
        @         headEmptyPolls = 0;
        @         char c; DWORD n = 0;
        @         if (!ReadFile(hStdin, &c, 1, &n, NULL) || n == 0) { headFailed = true; *(volatile BOOL*)&@<上次读取为断开> = TRUE; break; }
        @         if (c == '\n') { gotNewline = true; break; }
        @         if (c != '\r') headLine += c;
        @         headLen++;
        @     }
        @     if (headFailed) break;  // 句柄关闭或头部超时(60秒): 丢弃本次读取并返回空
        @     if (headLine.empty()) { Sleep(50); continue; }
        @     long contentLen = -1;
        @     if (strncmp(headLine.c_str(), "Content-Length:", 15) == 0)
        @         contentLen = atol(headLine.c_str() + 15);
        @     if (contentLen > 67108864) {  // 64MB上限: 防恶意/畸形头部导致内存耗尽
        @         fprintf(stderr, "[MCP-Stdio] Content-Length %ld 超过64MB上限, 拒绝并排空该帧\n", contentLen);
        @         long toDiscard = contentLen;
        @         if (toDiscard > 67108864) toDiscard = 67108864;  // 最多排空64MB, 防恶意无限排空
        @         while (toDiscard > 0) {
        @             if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @             DWORD avail5 = 0;
        @             if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &avail5, NULL)) break; }
        @             else { avail5 = 1; }
        @             if (isPipe && avail5 == 0) { if (++emptyPolls > 600) break; Sleep(20); continue; }
        @             emptyPolls = 0;
        @             char tmpD[4096];
        @             DWORD n5 = 0;
        @             DWORD toRead = (DWORD)(toDiscard > 4096 ? 4096 : toDiscard);
        @             if (!ReadFile(hStdin, tmpD, toRead, &n5, NULL) || n5 == 0) break;
        @             toDiscard -= n5;
        @         }
        @         break;
        @     }
        @     if (contentLen < 0) {
        @         // 裸单行模式: 头部行即请求体
        @         @<行字节集>.CopyFrom(headLine.data(), (INT_P)headLine.size());
        @         break;
        @     }
        @     // 帧模式: 跳过头部与body间的空行(\r\n), 再按 contentLen 读body
        @     std::string body;
        @     body.reserve((size_t)contentLen);
        @     if (gotNewline) {
        @         // 修复: 无条件等待并消费空行分隔符(轮询+退出检查), 防客户端分块写时漏消费导致帧体错位
        @         bool sepDone = false;
        @         while (!sepDone) {
        @             if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @             if (@<线程句柄> != 0 && g_objVolApp.GetThreadPool().IsThreadNeedBreak((HVOLTHREAD)@<线程句柄>, 0))
        @                 return CVolString();
        @             DWORD avail2 = 0;
        @             if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &avail2, NULL)) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; sepDone = true; break; } }
        @             else { avail2 = 1; }
        @             if (isPipe && avail2 == 0) { if (++headEmptyPolls > 1200) { sepDone = true; break; } Sleep(50); continue; }
        @             headEmptyPolls = 0;
        @             char c0; DWORD n0 = 0;
        @             if (!ReadFile(hStdin, &c0, 1, &n0, NULL) || n0 == 0) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; sepDone = true; break; }
        @             if (c0 == '\r') {
        @                 // 等待下一字节区分 \r\n 空行分隔 与 \r 为body首字节 (轮询+退出检查)
        @                 bool c1Done = false;
        @                 while (!c1Done) {
        @                     if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @                     if (@<线程句柄> != 0 && g_objVolApp.GetThreadPool().IsThreadNeedBreak((HVOLTHREAD)@<线程句柄>, 0))
        @                         return CVolString();
        @                     DWORD avail2b = 0;
        @                     if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &avail2b, NULL)) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; body += c0; c1Done = true; break; } }
        @                     else { avail2b = 1; }
        @                     if (isPipe && avail2b == 0) { if (++headEmptyPolls > 1200) { body += c0; c1Done = true; break; } Sleep(50); continue; }
        @                     headEmptyPolls = 0;
        @                     char c1; DWORD n1 = 0;
        @                     if (!ReadFile(hStdin, &c1, 1, &n1, NULL) || n1 == 0) { *(volatile BOOL*)&@<上次读取为断开> = TRUE; body += c0; c1Done = true; break; }
        @                     if (c1 == '\n') { sepDone = true; c1Done = true; }
        @                     else { body += c0; body += c1; sepDone = true; c1Done = true; }  // \r与c1均为body首部字节
        @                 }
        @             } else if (c0 == '\n') {
        @                 sepDone = true;  // 空行已消费
        @             } else {
        @                 body += c0; sepDone = true;  // c0是body首字节
        @             }
        @         }
        @     }
        @     while ((long)body.size() < contentLen) {
        @         if (*(volatile BOOL*)&@<Stdio应退出>) return CVolString();
        @         if (@<线程句柄> != 0 && g_objVolApp.GetThreadPool().IsThreadNeedBreak((HVOLTHREAD)@<线程句柄>, 0))
        @             return CVolString();
        @         DWORD avail3 = 0;
        @         if (isPipe) { if (!PeekNamedPipe(hStdin, NULL, 0, NULL, &avail3, NULL)) break; }
        @         else { avail3 = 1; }
        @         if (isPipe && avail3 == 0) { if (++emptyPolls > 600) break; Sleep(20); continue; }
        @         emptyPolls = 0;
        @         char tmpB[4096];
        @         DWORD n3 = 0;
        @         DWORD toRead = (DWORD)min((size_t)(contentLen - (long)body.size()), (size_t)4096);
        @         if (!ReadFile(hStdin, tmpB, toRead, &n3, NULL) || n3 == 0) break;
        @         body.append(tmpB, n3);
        @     }
        @     if ((long)body.size() < contentLen) {  // 帧体不完整(超时/断开): 丢弃本帧, 防帧错位
        @         fprintf(stderr, "[MCP-Stdio] 帧体不完整(已读%ld/%ld字节), 丢弃本帧\n", (long)body.size(), contentLen);
        @         break;
        @     }
        @     @<行字节集>.CopyFrom(body.data(), (INT_P)body.size());
        @     break;
        @ }
        如果 (取字节集长度 (行字节集) == 0)
        {
            返回 ("")
        }
        返回 (UTF8到文本 (行字节集))
    }
    # ======== stdout 写入 (MCP Content-Length 帧格式) ========
    方法 写入一行 <公开 静态>
    参数 文本 <类型 = 文本型>
    {
        @ // MCP传输规范: Content-Length: N\r\n\r\n{json} (帧后不加多余换行, 严格对齐规范)
        @ // WriteFile stdout, 自动处理UTF8, 检查失败
        @ std::string utf8 = CU8String(@<文本>.GetText()).GetText();
        @ DWORD contentLen = (DWORD)utf8.size();
        @ char header[128];
        @ int headerLen = snprintf(header, sizeof(header), "Content-Length: %lu\r\n\r\n", (unsigned long)contentLen);
        @ std::string frame(header, headerLen);
        @ frame += utf8;
        @ HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
        @ if (hOut == INVALID_HANDLE_VALUE || hOut == NULL) return;
        @ // 循环写满: 超大帧部分写入时继续写剩余 (防帧损坏)
        @ const char* wp = frame.c_str();
        @ DWORD wleft = (DWORD)frame.size();
        @ while (wleft > 0) {
        @     DWORD written = 0;
        @     if (!WriteFile(hOut, wp, wleft, &written, NULL)) {
        @         // 写失败: stdout已断开, 设置退出标志让主循环终止
        @         *(volatile BOOL*)&@<Stdio应退出> = TRUE;
        @         HANDLE hErr = GetStdHandle(STD_ERROR_HANDLE);
        @         if (hErr != INVALID_HANDLE_VALUE && hErr != NULL)
        @         {
        @             const char* err = "[MCP-Stdio] stdout写入失败, 服务即将退出\n";
        @             DWORD ew = 0;
        @             WriteFile(hErr, err, (DWORD)strlen(err), &ew, NULL);
        @         }
        @         break;
        @     }
        @     if (written == 0) break;
        @     wp += written;
        @     wleft -= written;
        @ }
    }
    # ======== stderr 日志 (不影响stdout的MCP协议) ========
    方法 写日志 <公开 静态>
    参数 文本 <类型 = 文本型>
    {
        @ std::string msg = "[MCP-Stdio] ";
        @ msg += CU8String(@<文本>.GetText()).GetText();
        @ msg += "\n";
        @ HANDLE hErr = GetStdHandle(STD_ERROR_HANDLE);
        @ if (hErr == INVALID_HANDLE_VALUE || hErr == NULL) return;
        @ DWORD written = 0;
        @ WriteFile(hErr, msg.c_str(), (DWORD)msg.size(), &written, NULL);
    }
    # ======== 检测命令行 --mcp-stdio 参数 ========
    方法 是否为Stdio模式 <公开 静态 类型 = 逻辑型>
    {
        变量 命令行数组 <类型 = 文本数组类>
        环境存取类.取命令行 (命令行数组)
        变量 count <类型 = 整数>
        count = 命令行数组.取成员数 ()
        计次循环 (count)
        {
            变量 arg <类型 = 文本型>
            arg = 命令行数组.取成员 (取循环索引 ())
            如果 (arg == "--mcp-stdio" || arg == "--stdio" || arg == "--headless")
            {
                返回 (真)
            }
        }
        返回 (假)
    }
    # ======== MCP stdio 主循环 (阻塞, 可响应停止) ========
    方法 运行Stdio主循环 <公开 静态>
    参数 线程句柄 <类型 = 变整数 @默认值 = 0>
    {
        写日志 ("============================================")
        写日志 ("AI浏览器 MCP Stdio Server 启动")
        写日志 ("协议: JSON-RPC 2.0 over stdin/stdout (Content-Length 帧格式)")
        写日志 ("直连: Claude Desktop / Cursor / Trace 等任意AI工具")
        写日志 ("============================================")
        // 循环读取 stdin → 处理 → stdout
        变量 空读次数 <类型 = 整数 值 = 0>
        循环判断首 ()
        {
            如果 (Stdio应退出)
            {
                跳出循环
            }
            如果 (线程句柄 != 0 && 缓存线程类.是否需要退出 (线程句柄))
            {
                跳出循环
            }
            变量 请求JSON <类型 = 文本型>
            请求JSON = 读取一行 (线程句柄)
            如果 (请求JSON == "")
            {
                如果 (Stdio应退出 || (线程句柄 != 0 && 缓存线程类.是否需要退出 (线程句柄)))
                {
                    跳出循环
                }
                // 修复: 仅句柄关闭(真断开)计入空读; 头部/帧体超时与畸形帧属瞬态, 不误判断开
                如果 (上次读取为断开)
                {
                    空读次数 = 空读次数 + 1
                }
                如果 (空读次数 >= 3)
                {
                    写日志 ("stdin已断开(父进程退出), stdio服务自动停止")
                    Stdio应退出 = 真
                    跳出循环
                }
                到循环尾
            }
            空读次数 = 0
            // === 核心: 复用已有MCP引擎处理 ===
            如果 (取文本长度 (请求JSON) > 200)
            {
                写日志 ("收到命令: " + 取文本左边 (请求JSON, 200) + "...(" + 到文本 (取文本长度 (请求JSON)) + "字符)")
            }
            否则
            {
                写日志 ("收到命令: " + 请求JSON)
            }
            变量 响应JSON <类型 = 文本型>
            响应JSON = MCP命令服务器.处理MCP请求 (请求JSON, "stdio")
            // === 输出响应 ===
            如果 (响应JSON != "")
            {
                写入一行 (响应JSON)
            }
        }
        循环判断尾 (真)
        写日志 ("MCP Stdio Server 停止")
    }
    方法 启动并行Stdio服务 <公开 静态>
    {
        如果 (Stdio线程实例.是否正在运行 () || MCP命令服务器.MCP正在关闭)
        {
            返回
        }
        Stdio应退出 = 假
        Stdio线程实例.启动 ()
    }
    方法 停止Stdio服务 <公开 静态>
    {
        Stdio应退出 = 真
        如果 (Stdio线程实例.是否正在运行 ())
        {
            // 修复(稳定性): 不无条件 停止() 死等——线程若卡在CEF长调用(执行JS/截图等)会阻塞主线程退出;
            // 改为轮询线程结束, 3秒超时后放弃等待(进程结束()时由运行时强制终止线程)
            变量 停止轮询次数 <类型 = 整数 值 = 0>
            判断循环 (Stdio线程实例.是否正在运行 () && 停止轮询次数 < 30)
            {
                停止轮询次数 = 停止轮询次数 + 1
                @ Sleep(100);
            }
            如果 (Stdio线程实例.是否正在运行 ())
            {
                写日志 ("停止超时(线程可能卡在长调用), 放弃等待, 由进程退出强制终止")
            }
        }
    }
    #
}
类 类_MCP_Stdio服务线程 <公开 基础类 = 缓存线程类>
{
    #
    方法 缓存线程类_线程运行 <接收事件 类型 = 整数 注释 = "用户需要接收并处理本事件以执行所需要的功能,该事件处理方法将在一个单独的线程中运行." 注释 = "注意:"
            注释 = "  1. 在本事件的接收处理方法中,必须尽可能快地频繁调用本对象的\"是否需要退出\"方法," 注释 = "一旦发现该方法返回真,则需要尽快结束执行并返回,否则将导致另一线程中的\"停止\"方法调用" 注释 = "进入死等状态;"
            注释 = "  2. 在本事件的接收处理方法中不允许对窗口界面直接进行操作,否则可能导致死锁.">
    参数 来源对象 <类型 = 缓存线程类 注释 = "提供事件产生的具体来源对象">
    参数 标记值 <类型 = 整数 注释 = "用户调用\"挂接事件\"命令时所提供的\"标记值\"参数值,非此方式挂接事件则本参数值固定为0.">
    参数 线程句柄 <类型 = 变整数 注释 = "提供所启动线程在线程池中的句柄值,必定不为0.">
    参数 用户参数 <类型 = 变整数 注释 = "提供启动时传递到线程函数的用户参数值">
    参数 退出事件 <类型 = 变整数 注释 = "本参数普通用户无需使用">
    {
        MCPStdio桥.运行Stdio主循环 (线程句柄)
        返回 (0)
    }
}
