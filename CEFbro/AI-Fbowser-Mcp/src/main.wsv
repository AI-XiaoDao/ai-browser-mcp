<火山程序 类型 = "通常" 版本 = 1 />

包 火山.程序

# ================================================================
# AI浏览器 MCP Server — 控制台启动入口 (无MFC窗口依赖)
# 主循环: 消息泵 + 待创建URL消费 + 定期维护
# 关闭: browser_shutdown 命令 / Ctrl+C 结束进程
# ================================================================

类 启动类 <公开 基础类 = 程序类>
{
    变量 应退出 <公开 静态 类型 = 逻辑型 值 = 假>
    变量 正在退出 <公开 静态 类型 = 逻辑型 值 = 假>
    变量 单实例互斥体 <公开 静态 类型 = 变整数 值 = 0>
    # @ static volatile LONG g_mcpCtrlFlag = 0;
    # @ static BOOL WINAPI MCPCtrlHandlerProc(DWORD dwType) { if (dwType == CTRL_C_EVENT || dwType == CTRL_CLOSE_EVENT || dwType == CTRL_SHUTDOWN_EVENT) { g_mcpCtrlFlag = 1; return TRUE; } return FALSE; }

    方法 启动方法 <公开 类型 = 整数>
    {
        // 禁止多开: 命名互斥体 (控制台无窗口, 不能用FindWindow)
        变量 MCP_Stdio模式 <类型 = 逻辑型>
        MCP_Stdio模式 = MCPStdio桥.是否为Stdio模式 ()
        如果 (MCP_Stdio模式 == 假)
        {
        @ {
        @     HANDLE hMutex = CreateMutexW(NULL, TRUE, L"Global\\AI-Fbowser-Mcp-Singleton");
        @     if (hMutex && GetLastError() == ERROR_ALREADY_EXISTS) {
        @         CloseHandle(hMutex);
        @         return 0;  // 已有实例运行, 静默退出
        @     }
        @     @<单实例互斥体> = (INT_P)hMutex;  // 进程存活期间保持句柄
        @ }
        }
        // 拦截Ctrl+C/关闭控制台窗口: 置标志走优雅退出, 防信号传播误杀CEF渲染子进程
        @ SetConsoleCtrlHandler(MCPCtrlHandlerProc, TRUE);
        控制台输出 ("[AI浏览器] ========== AI浏览器 MCP Server v" + MCP_常量.MCP_版本号 + " (控制台版) 启动 ==========")
        // 加载MCP配置 (端口/认证/置顶/事件监控默认值)
        MCP命令服务器.加载MCP配置 ()
        // 零手动接入: auto_install_agents=true 时启动即注册到各Agent配置 (Cursor/Claude/Codex/Cline/Windsurf)
        如果 (MCP_Stdio模式 == 假 && MCP命令服务器.自动安装代理)
        {
            MCP命令服务器.检查并自动安装代理 ()
        }
        // 提前读取配置中的类库授权码 (授权注册必须在FBrowser_初始化前完成)
        如果 (MCP命令服务器.VIP授权码 == "")
        {
            MCP命令服务器.VIP授权码 = "xsmzas1"
            控制台输出 ("[AI浏览器] 使用内置授权")
        }
        FBrowserVIP注册.VIP注册_置授权码 (MCP命令服务器.VIP授权码)
        // 类库授权状态: 发布版对所有用户开放全部功能 (FBrowser初始化控制.是否为VIP 为类库公开静态变量, 此处统一置真)
        FBrowser初始化控制.是否为VIP = 真
        // 插件高级功能: 类库原文要求"必须在加载插件前启用", 否则插件的 content_scripts.js **不执行**
        // (默认 CEF 不支持), 且不会有任何报错 —— 属"已交付功能静默不工作"。此处是进程内最早的可调用点
        // (早于 FBrowser_初始化, 因此也早于任何请求环境/插件加载)。
        FBrowser_VIP功能_启用插件高级功能 ()
        MCP命令服务器.VIP_插件高级功能已启用 = 真
        // 崩溃恢复: 上次运行渲染进程崩溃过(标记文件存在) → 初始化前清空CEF全局缓存, 防止重建后连环崩溃
        变量 恢复标记路径 <类型 = 文本型>
        恢复标记路径 = 取运行目录 () + "\\CacheData\\.crash_recovery"
        如果 (文件是否存在 (恢复标记路径))
        {
            变量 缓存清理成功 <类型 = 逻辑型 值 = 真>
            如果 (删除目录 (取运行目录 () + "\\CacheData\\GlobalData", 目录删除模式.全部删除, 假) == 假)
            {
                缓存清理成功 = 假
            }
            如果 (缓存清理成功)
            {
                删除文件 (恢复标记路径)
                控制台输出 ("[AI浏览器] 检测到上次渲染进程崩溃, 已自动清理全局缓存防止崩溃循环")
            }
            否则
            {
                // 清理失败(文件可能被残留子进程占用): 保留标记, 下次启动自动重试
                控制台输出 ("[AI浏览器] 缓存清理失败(可能被占用), 保留恢复标记待下次启动重试")
            }
        }
        变量 设置 <类型 = FBrowser_初始化配置>
        设置.无沙箱 = 真
        // stdio 子进程模式使用独立CEF缓存目录: 与常驻HTTP实例共存时避免CacheData\GlobalData文件锁互斥
        变量 缓存目录 <类型 = 文本型>
        如果 (MCP_Stdio模式)
        {
            缓存目录 = 取运行目录 () + "\\CacheData\\GlobalData_Stdio"
        }
        否则
        {
            缓存目录 = 取运行目录 () + "\\CacheData\\GlobalData"
        }
        设置.缓存目录 = 缓存目录
        设置.本地化语言 = "zh-CN"
        设置.接收语言清单 = "zh-CN,zh,en"
        设置.启用系统消息循环 = 真
        设置.保留Session = 真
        设置.日志目录 = 取运行目录 () + "\\log.txt"
        设置.日志模式 = 日志级别.致命
        控制台输出 (取执行文件名 ())
        设置.启用自动多例模式 = 真
        // ======== 启动期 DPI 感知 (配置键 dpi_aware, 默认 假 = 不改变现有行为) ========
        // 接线依据: FBroLib.wsv:260 方法 FBrowser_设置程序DPI模式 <公开 静态 类型 = 逻辑型>
        //   (签名) 参数 DPI模式 <类型 = DPI模式>; 类库注释原文「设置当前程序的DPI感知模式,在程序入口初始化之前调用」。
        // 常量依据: FBroConst.wsv:759 类 DPI模式 <公开 @常量类 = 整数>, :767 常量 按显示器感知V2 <公开 值 = -4>
        //   (对应 DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2)。本文件已有同类「常量类.成员」限定写法先例:
        //   :65 目录删除模式.全部删除、:98 日志级别.致命 (日志级别 定义在类库 FBroConst.wsv 包 FBrowser.常量)。
        // 副作用(必须知情): DPI 感知是**进程级**的 —— 开启后 HiDPI(缩放 != 100%) 下窗口按物理像素解释,
        //   CSS 视口(innerWidth/innerHeight)会随之变小, 鼠标注入坐标/点击落点/元素取矩形类工具的观测值一并改变。
        //   默认 假 时不进入本分支, 现有行为一字不变。
        如果 (MCP命令服务器.启动DPI感知模式)
        {
            FBrowser_设置程序DPI模式 (DPI模式.按显示器感知V2)
        }
        // ======== 启动期 V8 渲染进程堆栈上限 (配置键 v8_max_stack_mb, 默认 0 = 不改变现有行为) ========
        // 接线依据: FBroLib.wsv:184 方法 FBrowser_初始化_设置V8环境默认堆栈大小 <公开 静态>
        //   (签名) 参数 初始尺寸 <类型 = 整数 注释=「单位:MB; 不设置或者设置为0及为内核的默认值」>
        //   (签名) 参数 最大尺寸 <类型 = 整数 注释=「单位:MB; ...32位程序允许最大值不能超过4000MB」>;
        //   类库注释原文「必须在初始化之前设置, 只针对渲染进程」——故必须在 FBrowser_初始化 之前调用。
        // 语义: 首参固定 0 = 内核默认初始尺寸(不动), **只放宽上限, 不改语义**;
        //   32 位构建上限 4000MB(类库原文), 配置超过该值不会被内核采纳。
        //   默认 0 时不进入本分支, 现有行为一字不变。
        如果 (MCP命令服务器.V8堆栈上限MB > 0)
        {
            FBrowser_初始化_设置V8环境默认堆栈大小 (0, MCP命令服务器.V8堆栈上限MB)
        }
        变量 初始化事件 <类型 = 类_FBrowser_事件智能指针>
        初始化事件.创建 (类_MCP_初始化事件)
        如果真 (FBrowser_初始化 (设置, 初始化事件) == 假)
        {
            控制台输出 ("[AI浏览器] FBrowser 初始化失败")
            返回 (0)
        }
        控制台输出 ("[AI浏览器] FBrowser 初始化完成, 进入主循环 (Ctrl+C 或 browser_shutdown 退出)")
        // ======== 主循环: 消息泵 + 节拍处理 ========
        变量 上次节拍 <类型 = 长整数 值 = 0>
        变量 节拍计数 <类型 = 整数 值 = 0>
        判断循环 (应退出 == 假)
        {
            // Ctrl+C/关闭窗口信号 → 跳出主循环走优雅关闭
            @ if (g_mcpCtrlFlag) break;
            // 泵消息: FBrowser 事件回调依赖消息循环
            @ {
            @     MSG msg;
            @     while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) {
            @         TranslateMessage(&msg);
            @         DispatchMessageW(&msg);
            @     }
            @ }
            变量 当前毫秒 <类型 = 长整数>
            当前毫秒 = 取启动时间 ()
            // 500ms 节拍: 待创建URL消费 + 定期维护
            如果 (当前毫秒 - 上次节拍 >= 500)
            {
                上次节拍 = 当前毫秒
                主循环节拍 ()
                节拍计数 = 节拍计数 + 1
                如果 (节拍计数 >= 120)
                {
                    // 每60秒: 定期维护 (与请求入口惰性路径共享时间戳)
                    节拍计数 = 0
                    MCP命令服务器.上次维护毫秒 = 取启动时间 ()
                    MCP命令服务器.执行定期维护 ()
                }
            }
            否则
            {
                @ Sleep(10);
            }
        }
        // 循环退出后执行完整关闭序列
        执行关闭序列 ()
        返回 (1)
    }

    # 每500ms节拍: 消费待创建URL (browser_create/shutdown 经此机制在主线程创建浏览器)
    方法 主循环节拍 <公开 静态>
    {
        // 延迟关闭到点检查
        如果 (MCP命令服务器.待关闭截至毫秒 > 0 && 取启动时间 () >= MCP命令服务器.待关闭截至毫秒)
        {
            MCP命令服务器.待关闭截至毫秒 = 0
            控制台输出 ("[AI浏览器] 收到关闭命令, 正在安全退出...")
            应退出 = 真
            返回
        }
        // 保护: Debugger.pause 自动恢复检查 (10秒无暂停事件即resume)
        MCP命令服务器.检查暂停自动恢复 ()
        // 定时监视钩子: 按 browser_kernel_watch 登记的间隔周期性求值页面表达式并记录变化。
        // 该钩子此前从未被调用 —— 工具能 start 却永不采样(结果永远为空), 现按设计意图接上主循环节拍。
        MCP_内核分派.检查定时监视 ()
        // 重建/恢复标记消费: 全部浏览器崩溃或关闭后自动重建欢迎页 (与错误提示"自动创建"承诺一致)
        如果 (浏览器容器.需要重建浏览器)
        {
            浏览器容器.需要重建浏览器 = 假
            如果 (FBrowser_浏览器_取数量 () == 0 && MCP命令服务器.MCP正在关闭 == 假)
            {
                控制台输出 ("[AI浏览器] 检测到需要重建浏览器, 自动创建欢迎页...")
                MCP命令服务器.待创建锁.加锁 ()
                MCP命令服务器.待创建URL = 浏览器容器.取欢迎页地址 ()
                MCP命令服务器.待创建锁.解锁 ()
            }
        }
        如果 (浏览器容器.需要恢复布局)
        {
            浏览器容器.需要恢复布局 = 假
            浏览器容器.恢复欢迎页 ()
        }
        MCP命令服务器.待创建锁.加锁 ()
        变量 url <类型 = 文本型>
        url = MCP命令服务器.待创建URL
        如果 (url != "")
        {
            MCP命令服务器.待创建URL = ""
        }
        MCP命令服务器.待创建锁.解锁 ()
        如果 (url == "")
        {
            返回
        }
        如果 (是否以 (url, "__SHUTDOWN__"))
        {
            变量 shutSec <类型 = 整数>
            shutSec = 文本到整数 (取文本右边 (url, 取文本长度 (url) - 取文本长度 ("__SHUTDOWN__")))
            如果 (shutSec < 1)
            {
                shutSec = 1
            }
            // 非阻塞延迟关闭: 记录截止时刻, 主循环继续泵消息, 到点后退出
            MCP命令服务器.待关闭截至毫秒 = 取启动时间 () + (长整数)shutSec * 1000
            返回
        }
        // 主线程创建浏览器 (与窗口版UI时钟同机制)
        变量 窗口信息 <类型 = FBrowser_窗口信息>
        变量 浏览器配置 <类型 = FBrowser_浏览器配置>
        窗口信息.父窗口句柄 = 0
        窗口信息.横坐标 = 0
        窗口信息.纵坐标 = 0
        窗口信息.宽度 = 1000
        窗口信息.高度 = 800
        变量 浏览器事件 <类型 = 类_FBrowser_事件智能指针>
        浏览器事件.创建 (类_MCP_浏览器事件)
        // 后台浏览器(完全无窗口): 复用同一条"待创建"握手通道, 用 `__BG__` 前缀区分
        // (与上面 `__SHUTDOWN__` 同一惯例, 因此不需要额外的握手字段)。
        // 类库注释: 后台浏览器没有窗口、也没有窗口句柄, 只能后台运行不能显示出来,
        // 与"先创建再隐藏窗口"不同、也不是无头模式(其优于无头模式), 适合纯后台刷新取数, 占用更低。
        // 注意其参数表与普通创建不同: **没有窗口信息**, 第 2 参是浏览器配置。
        如果 (是否以 (url, "__BG__"))
        {
            变量 bgUrl <类型 = 文本型>
            bgUrl = 取文本右边 (url, 取文本长度 (url) - 取文本长度 ("__BG__"))
            FBrowser_创建后台浏览器 (bgUrl, 浏览器配置, , , 浏览器事件, , MCP命令服务器.待创建标识)
            MCP命令服务器.待创建锁.加锁 ()
            MCP命令服务器.待创建完成 = 真
            MCP命令服务器.待创建锁.解锁 ()
            控制台输出 ("[AI浏览器] 后台浏览器已创建 → " + bgUrl)
            返回
        }
        FBrowser_创建浏览器 (url, 窗口信息, 浏览器配置, , , 浏览器事件, , MCP命令服务器.待创建标识)
        MCP命令服务器.待创建锁.加锁 ()
        MCP命令服务器.待创建完成 = 真
        MCP命令服务器.待创建锁.解锁 ()
        控制台输出 ("[AI浏览器] 浏览器已创建 → " + url)
    }

    方法 执行关闭序列 <公开 静态>
    {
        如果 (正在退出)
        {
            返回
        }
        正在退出 = 真
        // 先置关闭标记, 使在途请求的等待循环(轮询browser_create/同步等待)立即退出
        MCP命令服务器.MCP正在关闭 = 真
        MCP命令服务器.是否启用 = 假
        MCPStdio桥.停止Stdio服务 ()
        MCP命令服务器.注销CDP观察者 ()
        MCP命令服务器.关闭全部事件监控 ()
        MCP命令服务器.关闭MCP服务器 ()
        FBrowser_关闭 (真)
        // 清理残留子进程: 仅终止当前进程树的 FBroSubprocess.exe
        @ // 获取当前进程ID, 仅终止父进程为当前PID的FBroSubprocess.exe子进程
        @ DWORD curPid = GetCurrentProcessId();
        @ HANDLE hSnap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        @ if (hSnap != INVALID_HANDLE_VALUE) {
        @     PROCESSENTRY32W pe = { sizeof(pe) };
        @     if (Process32FirstW(hSnap, &pe)) {
        @         do {
        @             if (pe.th32ParentProcessID == curPid && _wcsicmp(pe.szExeFile, L"FBroSubprocess.exe") == 0) {
        @                 HANDLE hChild = OpenProcess(PROCESS_TERMINATE, FALSE, pe.th32ProcessID);
        @                 if (hChild) { TerminateProcess(hChild, 0); CloseHandle(hChild); }
        @             }
        @         } while (Process32NextW(hSnap, &pe));
        @     }
        @     CloseHandle(hSnap);
        @ }
        结束 ()
    }
}

# ── FBrowser 应用级初始化事件 ──

类 类_MCP_初始化事件 <公开 基础类 = 类_FBrowser_应用事件>
{
    方法 记录应用监控事件 <类型 = 逻辑型>
    参数 事件类型 <类型 = 文本型>
    参数 数据JSON <类型 = 文本型 @默认值 = "">
    {
        如果 (MCP命令服务器.是否监控应用事件)
        {
            MCP命令服务器.记录应用事件 (事件类型, 数据JSON)
        }
        返回 (MCP命令服务器.是否监控应用事件)
    }

    方法 浏览器_初始化完毕 <公开 @虚拟方法 = 可覆盖>
    {
        MCP命令服务器.启动MCP服务器 ()
        变量 端口文本 <类型 = 文本型>
        端口文本 = 到文本 (MCP命令服务器.服务器端口)
        变量 绑定地址 <类型 = 文本型>
        绑定地址 = MCP命令服务器.服务器绑定地址
        写环境变量 ("AI_BROWSER_MCP_URL", "ws://" + 绑定地址 + ":" + 端口文本)
        写环境变量 ("AI_BROWSER_MCP_WS", "ws://" + 绑定地址 + ":" + 端口文本 + "/mcp")
        写环境变量 ("AI_BROWSER_MCP_PORT", 端口文本)
        写环境变量 ("AI_BROWSER_MCP_HOST", 绑定地址)
        写环境变量 ("AI_BROWSER_MCP_HEALTH", "http://" + 绑定地址 + ":" + 端口文本 + "/health")
        写环境变量 ("AI_BROWSER_MCP_HTTP_POST", "http://" + 绑定地址 + ":" + 端口文本 + "/mcp")
        写环境变量 ("AI_BROWSER_MCP_VERSION", MCP_常量.MCP_版本号)
        控制台输出 ("[AI浏览器] MCP 服务已就绪 — " + MCP命令服务器.取MCP_WS地址 ())
        浏览器容器.MCP服务已就绪 = 真
        // 触发首个浏览器创建: 主循环节拍消费 (控制台版无UI时钟)
        MCP命令服务器.待创建锁.加锁 ()
        MCP命令服务器.待创建URL = 浏览器容器.取欢迎页地址 ()
        MCP命令服务器.待创建锁.解锁 ()
        如果 (MCPStdio桥.是否为Stdio模式 ())
        {
            MCPStdio桥.启动并行Stdio服务 ()
        }
    }

    方法 执行关闭完毕 <公开 @虚拟方法 = 可覆盖>
    参数 是否结束程序 <类型 = 逻辑型类>
    {
        控制台输出 ("[AI浏览器] FBrowser 资源已释放, 结束进程")
        是否结束程序.值 = 真
    }

    方法 渲染_即将捕获异常 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 V8环境 <类型 = 类_FBrowser_V8环境>
    参数 V8异常 <类型 = 类_FBrowser_V8异常>
    参数 V8堆栈踪迹 <类型 = 类_FBrowser_V8堆栈踪迹>
    {
        变量 数据 <类型 = YYJSON对象类>
        数据.创建自文本 ("{}")
        数据.加入整数成员 ("browser_id", 浏览器.取ID ())
        数据.加入文本成员 ("url", 框架.取地址 ())
        如果 (V8异常.是否为空 () == 假)
        {
            数据.加入文本成员 ("message", V8异常.取消息 ())
        }
        记录应用监控事件 ("app_v8_exception", 数据.到可读文本 (YYJSON格式化选项.压缩))
    }

    # 内核层: 初始化期注册自定义方案 "mcp" (CEF 要求初始化前声明, 运行期由 browser_kernel_scheme 挂载资源处理器)
    方法 注册自定义方案 <公开 @虚拟方法 = 可覆盖>
    参数 方案 <类型 = 类_FBrowser_方案注册>
    {
        如果 (方案.是否为空 () == 假)
        {
            // CEF 官方 cef_scheme_options_t: CEF_SCHEME_OPTION_STANDARD = 0x1 (标准URL解析, 含host)
            方案.添加自定义方案 ("mcp", 1)
        }
    }

    方法 渲染_焦点节点改变 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 DOM节点 <类型 = 类_FBrowser_DOM节点>
    {
        如果 (MCP命令服务器.是否监控应用事件 == 假)
        {
            返回
        }
        变量 当前毫秒 <类型 = 长整数>
        当前毫秒 = 取启动时间 ()
        变量 prevKey <类型 = 文本型>
        prevKey = "focus_ts_" + 到文本 (浏览器.取ID ())
        // 节流字典为CEF字典(非线程安全), 与 执行定期维护 的遍历/移除并发会破坏结构, 必须持锁
        MCP命令服务器.事件节流锁.加锁 ()
        如果 (MCP命令服务器.应用事件节流字典.是否为空对象 () || MCP命令服务器.应用事件节流字典.是否为空 ())
        {
            MCP命令服务器.应用事件节流字典.创建 ()
        }
        变量 上次毫秒32 <类型 = 整数>
        上次毫秒32 = MCP命令服务器.应用事件节流字典.取整数值 (prevKey)
        变量 diff <类型 = 整数>
        diff = (整数)当前毫秒 - 上次毫秒32
        如果 (diff >= 0 && diff < 300)
        {
            MCP命令服务器.事件节流锁.解锁 ()
            返回
        }
        MCP命令服务器.应用事件节流字典.置整数值 (prevKey, (整数)当前毫秒)
        MCP命令服务器.事件节流锁.解锁 ()
        变量 数据 <类型 = YYJSON对象类>
        数据.创建自文本 ("{}")
        数据.加入整数成员 ("browser_id", 浏览器.取ID ())
        数据.加入文本成员 ("url", 框架.取地址 ())
        如果 (DOM节点.是否为空 () == 假)
        {
            数据.加入文本成员 ("tag", DOM节点.取标签名 ())
        }
        记录应用监控事件 ("app_dom_focus_changed", 数据.到可读文本 (YYJSON格式化选项.压缩))
    }

