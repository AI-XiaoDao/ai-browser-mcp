<火山程序 类型 = "通常" 版本 = 1 />
包 火山.程序
# ================================================================
# MCP浏览器事件 — 网络监控 + 应用事件 + V8注入 + Console收集
# 被 MCP_Server.wsv 引用
# ================================================================
类 类_MCP_浏览器事件 <公开 基础类 = 类_FBrowser_浏览器事件>
{
    # 统一写入 browser_event 日志 (供 browser_event 工具查询)
    方法 记录监控事件 <类型 = 逻辑型>
    参数 开关 <类型 = 逻辑型>
    参数 事件类型 <类型 = 文本型>
    参数 浏览器ID <类型 = 整数>
    参数 数据JSON <类型 = 文本型 @默认值 = "">
    {
        如果 (开关)
        {
            MCP命令服务器.记录浏览器事件 (事件类型, 浏览器ID, 数据JSON)
        }
        返回 (开关)
    }
    方法 是否为里程碑进度 <公开 静态 类型 = 逻辑型 注释 = "进度事件仅记录 0/25/50/75/100 里程碑, 减少高频写入">
    参数 进度 <类型 = 整数>
    {
        返回 (进度 == 0 || 进度 == 25 || 进度 == 50 || 进度 == 75 || 进度 == 100)
    }
    方法 浏览器_创建完毕 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 额外信息 <类型 = 类_FBrowser_字典值>
    {
        MCP命令服务器.浏览器数组锁.加锁 ()
        浏览器容器.浏览器数组.加入成员 (浏览器)
        MCP命令服务器.浏览器数组锁.解锁 ()
        控制台输出 (到文本 ("[MCP] 浏览器创建完毕 [ID:") + ", " + 到文本 (浏览器.取ID ()) + ", " + 到文本 ("]"))
        // 应用全局持久配置 (代理/缩放/静音)
        MCP命令服务器.应用持久配置到浏览器 (浏览器)
        // 自愈: 反检测Debugger禁用与CDP观察者根本冲突(内核开关禁用后断点触发illegal instruction崩溃), 创建新浏览器时统一恢复Debugger
        MCP命令服务器.确保Debugger可用 (浏览器)
        // 自动注册CDP DevTools观察者(确保browser_cdp_call可用)
        MCP命令服务器.确保CDP观察者已注册 ()
        // ======== 预加载Hook注入 (浏览器加载前生效) ========
        // 所有Hook通过事件方法预注册, 开关在浏览器_创建完毕时检查一次,
        // 后续每个事件触发时再检查开关 (支持运行时动态切换)
        如果 (MCP命令服务器.是否Hook导航 && MCP命令服务器.导航拦截规则 != "")
        {
            控制台输出 (到文本 ("[MCP] 导航拦截Hook已预加载, 规则:") + ", " + 到文本 (MCP命令服务器.导航拦截规则))
        }
        如果 (MCP命令服务器.是否Hook资源 && MCP命令服务器.资源替换规则 != "")
        {
            控制台输出 (到文本 ("[MCP] 资源拦截Hook已预加载, 规则:") + ", " + 到文本 (MCP命令服务器.资源替换规则))
        }
        如果 (MCP命令服务器.是否Hook音频 && MCP命令服务器.音频指纹配置 != "")
        {
            控制台输出 (到文本 ("[MCP] 音频指纹Hook已预加载:") + ", " + 到文本 (MCP命令服务器.音频指纹配置))
        }
        如果 (MCP命令服务器.是否记录网络)
        {
            控制台输出 ("[MCP] 网络日志Hook已预加载")
        }
        如果 (MCP命令服务器.是否记录控制台)
        {
            控制台输出 ("[MCP] 控制台日志Hook已预加载")
        }
        如果 (MCP命令服务器.是否缓存响应)
        {
            控制台输出 ("[MCP] 响应缓存Hook已预加载 → SQLite:response_cache表")
        }
        // 如果有V8扩展待注入, 在渲染进程创建V8环境时注入 (最关键的预加载Hook)
        变量 待注入V8列表 <类型 = 文本数组类>
        待注入V8列表 = MCP命令服务器.持久V8扩展列表
        如果 (待注入V8列表.取成员数 () > 0)
        {
            控制台输出 (到文本 ("[MCP] V8预注入Hook:") + ", " + 到文本 (待注入V8列表.取成员数 ()) + ", " + 到文本 ("个"))
        }
        变量 创建数据 <类型 = YYJSON对象类>
        创建数据.创建自文本 ("{}")
        创建数据.加入整数成员 ("browser_id", 浏览器.取ID ())
        记录监控事件 (MCP命令服务器.是否监控生命周期, "browser_created", 浏览器.取ID (), 创建数据.到可读文本 (YYJSON格式化选项.压缩))
        // 不再自动导航欢迎页: 浏览器由 browser_create/navigate 显式控制
    }
    # V8 持久扩展已移至 类_MCP_初始化事件 (应用事件/渲染进程)
    # Console消息收集 — browser_collect console_enable 的核心实现
    方法 浏览器_控制台消息 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 日志级别 <类型 = 整数>
    参数 消息 <类型 = 文本型>
    参数 内容 <类型 = 文本型>
    参数 行 <类型 = 整数>
    {
        如果 (MCP命令服务器.是否记录控制台)
        {
            MCP命令服务器.记录控制台消息 (日志级别, 消息, 内容, 行)
        }
        返回 (假)
    }
    方法 浏览器_即将关闭 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    {
        控制台输出 (到文本 ("[MCP] 浏览器即将关闭 [ID:") + ", " + 到文本 (浏览器.取ID ()) + ", " + 到文本 ("]"))
        变量 关闭数据 <类型 = YYJSON对象类>
        关闭数据.创建自文本 ("{}")
        记录监控事件 (MCP命令服务器.是否监控生命周期, "browser_closing", 浏览器.取ID (), 关闭数据.到可读文本 (YYJSON格式化选项.压缩))
        MCP命令服务器.浏览器数组锁.加锁 ()
        变量 count <类型 = 整数>
        count = 浏览器容器.浏览器数组.取成员数 ()
        变量 在数组中 <类型 = 逻辑型 值 = 假>
        计次循环 (count)
        {
            变量 idx <类型 = 整数>
            idx = 取循环索引 ()
            变量 temp <类型 = 类_FBrowser_浏览器>
            temp = 对象数组类.取指定类型成员 (浏览器容器.浏览器数组, idx, 类_FBrowser_浏览器)
            如果 (temp.取ID () == 浏览器.取ID ())
            {
                浏览器容器.浏览器数组.删除成员 (idx)
                在数组中 = 真
                跳出循环
            }
        }
        变量 剩余数量 <类型 = 整数>
        剩余数量 = 浏览器容器.浏览器数组.取成员数 ()
        MCP命令服务器.浏览器数组锁.解锁 ()
        // CDP 观察者附着于 browser_id=CDP附着浏览器ID; 仅关闭该浏览器时注销, 避免弹窗关闭误伤主窗口
        如果 (MCP命令服务器.CDP观察者已注册 && 浏览器.取ID () == MCP命令服务器.CDP附着浏览器ID)
        {
            变量 closeVip <类型 = 类_FBrowserVIP_控制器>
            closeVip = 浏览器.取VIP控制器 ()
            如果 (closeVip.是否为空 () == 假)
            {
                closeVip.开发者消息_关闭监管者事件 ()
            }
            MCP命令服务器.CDP观察者已注册 = 假
            MCP命令服务器.CDP附着浏览器ID = 0
            控制台输出 (到文本 ("[MCP] CDP DevTools观察者因浏览器关闭而注销 [ID:") + ", " + 到文本 (浏览器.取ID ()) + ", " + 到文本 ("]"))
        }
        // 关闭来源判别:
        // 在数组中=真 → 用户手动关窗(或browser_close): 最后一个窗口关闭时优雅退出MCP, 不再重建
        //                (修复"关闭窗口→自动重建→再关闭→再重建"无限重启循环)
        // 在数组中=假 → 崩溃清理路径(渲染意外终止已先从数组移除): 重建与否由崩溃处理器决定, 此处不动作
        //                 (启动期清理残留浏览器同样不触发退出)
        如果 (在数组中 && 剩余数量 == 0 && MCP命令服务器.MCP正在关闭 == 假)
        {
            控制台输出 ("[AI浏览器] 用户关闭最后一个浏览器窗口, 正在退出MCP服务...")
            启动类.应退出 = 真
        }
    }
    方法 浏览器_获取资源处理器 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 设置资源处理器 <类型 = 类_FBrowser_设置资源处理器>
    {
        如果 (MCP命令服务器.是否记录网络)
        {
            如果 (MCP命令服务器.是否详细记录网络)
            {
                MCP命令服务器.记录网络请求_详细 (请求)
            }
            否则
            {
                MCP命令服务器.记录网络请求 (请求.取类型 (), 请求.取地址 ())
            }
        }
        // 资源拦截Hook: 规则匹配日志 (实际拦截由VIP控制器处理)
        如果 (MCP命令服务器.是否Hook资源 && MCP命令服务器.资源替换规则 != "")
        {
            控制台输出 (到文本 ("[MCP] 资源Hook已激活, 规则:") + ", " + 到文本 (MCP命令服务器.资源替换规则))
        }
    }
    方法 浏览器_获取资源过滤器 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 响应 <类型 = 类_FBrowser_响应>
    参数 设置资源过滤器 <类型 = 类_FBrowser_设置资源过滤器>
    {
        // 网络详细日志: 此事件对全部请求无条件触发, 可捕获POST body
        如果 (MCP命令服务器.是否记录网络 && MCP命令服务器.是否详细记录网络)
        {
            MCP命令服务器.记录网络请求_详细 (请求)
        }
        // 手写资源篡改: URL规则匹配后挂载篡改过滤器 (不依赖VIP官方过滤器, 优先于响应缓存)
        如果 (MCP命令服务器.是否Hook资源 && MCP命令服务器.资源替换规则 != "")
        {
            变量 篡改请求地址 <类型 = 文本型>
            篡改请求地址 = 请求.取地址 ()
            变量 篡改响应MIME <类型 = 文本型>
            篡改响应MIME = 响应.取MIME类型 ()
            变量 篡改JSON <类型 = 文本型>
            篡改JSON = MCP命令服务器.匹配资源篡改规则 (篡改请求地址)
            变量 篡改信息 <类型 = YYJSON只读对象类>
            如果 (篡改JSON != "" && 篡改信息.创建自文本 (篡改JSON))
            {
                变量 篡改动作 <类型 = 文本型>
                篡改动作 = MCP命令服务器.yyjson取文本 (篡改信息, "action")
                // 防御: 仅5种已知动作挂载过滤器 (未知动作会输出空响应)
                // modify/replace_data/replace_file/line_replace 仅对文本类MIME生效 (二进制资源UTF8转换会损坏数据); block 不限
                如果 (篡改动作 == "block" || ((篡改动作 == "modify" || 篡改动作 == "replace_data" || 篡改动作 == "replace_file" || 篡改动作 == "line_replace") && MCP命令服务器.是否文本类MIME (篡改响应MIME)))
                {
                    变量 篡改过滤器 <类型 = 类_FBrowser_事件智能指针>
                    篡改过滤器.创建 (类_MCP_篡改过滤器)
                    篡改过滤器.取执行类 (类_MCP_篡改过滤器).动作 = 篡改动作
                    篡改过滤器.取执行类 (类_MCP_篡改过滤器).搜索文本 = MCP命令服务器.yyjson取文本 (篡改信息, "search")
                    篡改过滤器.取执行类 (类_MCP_篡改过滤器).替换文本 = MCP命令服务器.yyjson取文本 (篡改信息, "replace")
                    如果 (篡改动作 == "block")
                    {
                        篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = "<html><head><meta charset=\"UTF-8\"></head><body>资源已屏蔽 (MCP intercept block)</body></html>"
                    }
                    否则 (篡改动作 == "replace_data")
                    {
                        篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = MCP命令服务器.yyjson取文本 (篡改信息, "replace")
                    }
                    否则 (篡改动作 == "replace_file")
                    {
                        变量 篡改文件路径 <类型 = 文本型>
                        篡改文件路径 = MCP命令服务器.yyjson取文本 (篡改信息, "file")
                        // 修复: 路径白名单校验(仅允许运行目录内), 防任意本地文件被web资源读取
                        如果 (篡改文件路径 != "" && MCP命令服务器.验证安全路径 (篡改文件路径, 真) == 假)
                        {
                            篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = "资源已屏蔽 (replace_file: 文件路径越界)"
                        }
                        否则 (篡改文件路径 == "")
                        {
                            // 修复: 缺file字段原会静默输出空内容, 改为明确提示
                            篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = "资源已屏蔽 (replace_file: 缺少file字段)"
                        }
                        否则
                        {
                            // 优先用规则设置时的预读缓存 (UI线程免磁盘IO); 未命中回退直读
                            变量 缓存文件内容 <类型 = 文本型>
                            缓存文件内容 = MCP命令服务器.取篡改文件缓存 (篡改文件路径)
                            如果 (缓存文件内容 != "")
                            {
                                篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = 缓存文件内容
                            }
                            否则 (文件是否存在 (篡改文件路径))
                            {
                                篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = UTF8到文本 (读入文件 (篡改文件路径))
                            }
                            否则
                            {
                                篡改过滤器.取执行类 (类_MCP_篡改过滤器).待输出文本 = "资源已屏蔽 (replace_file: 文件不存在)"
                            }
                        }
                    }
                    否则 (篡改动作 == "line_replace")
                    {
                        // 搜索文本格式 "start:end"
                        变量 行区间文本 <类型 = 文本型>
                        行区间文本 = MCP命令服务器.yyjson取文本 (篡改信息, "search")
                        变量 行区间段 <类型 = 文本数组类>
                        分割文本 (行区间文本, ":", 行区间段, 真, 假)
                        如果 (行区间段.取成员数 () >= 2)
                        {
                            篡改过滤器.取执行类 (类_MCP_篡改过滤器).行替换开始 = 文本到整数 (行区间段.取成员 (0))
                            篡改过滤器.取执行类 (类_MCP_篡改过滤器).行替换结束 = 文本到整数 (行区间段.取成员 (1))
                            篡改过滤器.取执行类 (类_MCP_篡改过滤器).替换文本 = MCP命令服务器.yyjson取文本 (篡改信息, "replace")
                        }
                    }
                    设置资源过滤器.设置 (篡改过滤器)
                    控制台输出 ("[MCP] 手写篡改已挂载: " + 篡改动作 + " → " + 篡改请求地址)
                    返回
                }
            }
        }
        如果 (MCP命令服务器.是否缓存响应)
        {
            变量 地址 <类型 = 文本型>
            地址 = 请求.取地址 ()
            如果 (地址 != "")
            {
                变量 缓存过滤器 <类型 = 类_FBrowser_事件智能指针>
                缓存过滤器.创建 (类_MCP_缓存过滤器)
                缓存过滤器.取执行类 (类_MCP_缓存过滤器).资源地址 = 地址
                缓存过滤器.取执行类 (类_MCP_缓存过滤器).资源MIME = 响应.取MIME类型 ()
                设置资源过滤器.设置 (缓存过滤器)
            }
        }
    }
    方法 浏览器_资源加载完毕 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 响应 <类型 = 类_FBrowser_响应>
    参数 加载状态 <类型 = 整数>
    参数 内容长度 <类型 = 长整数>
    {
        如果 (MCP命令服务器.是否记录网络)
        {
            如果 (MCP命令服务器.是否详细记录网络)
            {
                MCP命令服务器.记录网络响应_详细 (请求, 响应, 内容长度)
            }
            否则
            {
                MCP命令服务器.记录网络响应 (请求.取地址 (), 响应.取状态 (), 响应.取MIME类型 (), 假)
            }
        }
    }
    # - 下载 (使用官方事件, 与主浏览器一致) ---
    方法 浏览器_即将下载 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 下载 <类型 = 类_FBrowser_下载>
    参数 推荐名 <类型 = 文本型>
    参数 下载回调 <类型 = 类_FBrowser_即将下载回调>
    {
        如果 (下载.是否为空 () == 假 && 下载回调.是否为空 () == 假)
        {
            控制台输出 (到文本 ("[MCP] 即将下载:") + ", " + 到文本 (下载.取推荐文件名 ()) + ", " + 到文本 (" 大小:") + ", " + 到文本 (下载.取总长度 ()))
            变量 下载数据 <类型 = YYJSON对象类>
            下载数据.创建自文本 ("{}")
            下载数据.加入文本成员 ("filename", 下载.取推荐文件名 ())
            下载数据.加入长整数成员 ("total_bytes", 下载.取总长度 ())
            如果 (MCP命令服务器.是否自动保存下载)
            {
                变量 下载目录 <类型 = 文本型>
                下载目录 = 取运行目录 () + "\\Downloads"
                如果 (MCP_服务器工具.检查目录是否存在 (下载目录) == 假)
                {
                    如果 (创建目录 (下载目录) == 假)
                    {
                        控制台输出 (到文本 ("[MCP] 下载目录创建失败:") + ", " + 到文本 (下载目录) + ", " + 到文本 ("—回退到浏览器默认下载"))
                        记录监控事件 (MCP命令服务器.是否监控下载事件, "download_start_error", 浏览器.取ID (), "{\"error\":\"download_dir_create_failed\"}")
                        // 空路径+弹窗: 交浏览器默认下载流程
                        下载回调.继续 ("", 真)
                        返回 (假)
                    }
                }
                变量 保存路径 <类型 = 文本型>
                保存路径 = 下载目录 + "\\" + 下载.取推荐文件名 ()
                下载数据.加入文本成员 ("save_path", 保存路径)
                下载数据.加入逻辑值成员 ("auto_save", 真)
                记录监控事件 (MCP命令服务器.是否监控下载事件, "download_start", 浏览器.取ID (), 下载数据.到可读文本 (YYJSON格式化选项.压缩))
                下载回调.继续 (保存路径, 假)
            }
            否则
            {
                下载数据.加入逻辑值成员 ("auto_save", 假)
                记录监控事件 (MCP命令服务器.是否监控下载事件, "download_start", 浏览器.取ID (), 下载数据.到可读文本 (YYJSON格式化选项.压缩))
                // 官方demo模式: 空路径+弹窗=浏览器默认下载; 不调用继续/取消则下载保持暂停
                下载回调.继续 ("", 真)
            }
        }
        返回 (假)  // CEF OnBeforeDownload: 返回假继续下载, 返回真取消下载 (官方demo同款)
    }
    方法 浏览器_正在下载 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 下载 <类型 = 类_FBrowser_下载>
    参数 下载回调 <类型 = 类_FBrowser_正在下载回调>
    {
        // 修复: 下载对象判空, 与 浏览器_即将下载 保持一致 (防御CEF异常回调)
        如果 (下载.是否为空 () == 假)
        {
            变量 进度 <类型 = 整数>
            进度 = 下载.取下载百分比 ()
            控制台输出 (到文本 ("[MCP] 下载中:") + ", " + 到文本 (下载.取推荐文件名 ()) + ", " + 到文本 (" 进度:") + ", " + 到文本 (进度) + ", " + 到文本 ("%"))
            如果 (MCP命令服务器.是否监控下载事件 && 是否为里程碑进度 (进度))
            {
                变量 进度数据 <类型 = YYJSON对象类>
                进度数据.创建自文本 ("{}")
                进度数据.加入文本成员 ("filename", 下载.取推荐文件名 ())
                进度数据.加入整数成员 ("percent", 进度)
                进度数据.加入长整数成员 ("received_bytes", 下载.取已下载长度 ())
                进度数据.加入长整数成员 ("total_bytes", 下载.取总长度 ())
                记录监控事件 (真, "download_progress", 浏览器.取ID (), 进度数据.到可读文本 (YYJSON格式化选项.压缩))
            }
        }
    }
    # 页面加载完成 — 记录事件 + 通知主窗口更新地址栏
    方法 浏览器_载入结束 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 状态码 <类型 = 整数>
    {
        如果 (框架.是否为主框架 ())
        {
            浏览器容器.置加载状态 (假)
            浏览器容器.置最后载入结束毫秒 (取启动时间 ())
            如果 (MCP命令服务器.是否监控载入事件)
            {
                MCP命令服务器.记录加载事件 ("load_end", 浏览器.取ID (), 状态码)
            }
            浏览器容器.置最新地址 (框架.取地址 ())
            变量 当前URL <类型 = 文本型>
            当前URL = 框架.取地址 ()
            如果 (当前URL == 浏览器容器.取欢迎页地址 ())
            {
                浏览器容器.欢迎页已导航 = 真
                浏览器容器.欢迎页导航已发起 = 假
                浏览器容器.欢迎页导航发起毫秒 = 0
            }
            // 事件驱动等待解析: navigate/reload wait_for_load 的任务在此完成 (与发布版一致)
            MCP命令服务器.解析等待任务 ("load_end", 浏览器.取ID (), 当前URL)
        }
    }
    # URL变化 — 地址栏实时同步
    方法 浏览器_地址被改变 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 新地址 <类型 = 文本型>
    {
        如果 (框架.是否为主框架 () && 新地址 != "" && 新地址 != "about:blank" && 是否以 (新地址, "data:") == 假)
        {
            // 同值去重: hash导航/重定向链会连续触发同地址事件, 避免事件日志噪声
            变量 旧地址 <类型 = 文本型>
            旧地址 = 浏览器容器.取最新地址 ()
            如果 (新地址 == 旧地址)
            {
                返回
            }
            浏览器容器.置最新地址 (新地址)
            变量 地址数据 <类型 = YYJSON对象类>
            地址数据.创建自文本 ("{}")
            地址数据.加入文本成员 ("url", 新地址)
            记录监控事件 (MCP命令服务器.是否监控生命周期, "url_changed", 浏览器.取ID (), 地址数据.到可读文本 (YYJSON格式化选项.压缩))
            // 事件驱动等待解析: url_contains 等待任务在此完成 (与发布版一致)
            MCP命令服务器.解析等待任务 ("navigate", 浏览器.取ID (), 新地址)
        }
    }
    # 渲染进程崩溃 — 通知客户端
    方法 浏览器_渲染意外终止 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 状态 <类型 = 整数>
    参数 错误码 <类型 = 整数>
    参数 错误文本 <类型 = 文本型>
    {
        // CEF cef_termination_status_t: 0=异常终止, 1=被杀死, 2=崩溃, 3=内存耗尽(OOM)
        变量 状态语义 <类型 = 文本型>
        状态语义 = "未知"
        如果 (状态 == 0)
        {
            状态语义 = "异常终止"
        }
        否则 (状态 == 1)
        {
            状态语义 = "被杀死"
        }
        否则 (状态 == 2)
        {
            状态语义 = "崩溃"
        }
        否则 (状态 == 3)
        {
            状态语义 = "内存耗尽(OOM)"
        }
        控制台输出 (到文本 ("[MCP] 渲染进程崩溃! 浏览器ID:") + ", " + 到文本 (浏览器.取ID ()) + ", " + 到文本 (" 状态:") + ", " + 到文本 (状态) + "(" + 状态语义 + ")" + ", " + 到文本 (" 错误:") + ", " + 到文本 (错误文本))
        MCP命令服务器.记录加载事件 ("crash", 浏览器.取ID (), 错误码)
        // 快速失败: 该浏览器上所有_waiting等待任务(如wait_for_load同步等待)立即置失败,
        // 否则等待方只能干等max_ms超时后收到误导性的"页面可能较慢"错误
        MCP命令服务器.存储等待任务错误 (浏览器.取ID (), "渲染进程" + 状态语义 + " | 浏览器ID:" + 到文本 (浏览器.取ID ()) + " | 请重新导航或等待浏览器自动重建")
        MCP命令服务器.浏览器数组锁.加锁 ()
        变量 count <类型 = 整数>
        count = 浏览器容器.浏览器数组.取成员数 ()
        计次循环 (count)
        {
            变量 idx <类型 = 整数>
            idx = 取循环索引 ()
            变量 temp <类型 = 类_FBrowser_浏览器>
            temp = 对象数组类.取指定类型成员 (浏览器容器.浏览器数组, idx, 类_FBrowser_浏览器)
            如果 (temp.取ID () == 浏览器.取ID ())
            {
                浏览器容器.浏览器数组.删除成员 (idx)
                跳出循环
            }
        }
        // 修复: 剩余数量在锁内快照, 原解锁后无锁读成员数与跨线程删除竞态
        变量 剩余数量 <类型 = 整数>
        剩余数量 = 浏览器容器.浏览器数组.取成员数 ()
        MCP命令服务器.浏览器数组锁.解锁 ()
        // 关闭崩溃的浏览器CEF对象, 释放渲染器/GPU等子进程资源
        如果 (浏览器.是否已关闭 () == 假)
        {
            浏览器.关闭浏览器 ()
        }
        // 所有浏览器崩溃后触发重建, 防止UI空白
        如果 (剩余数量 == 0)
        {
            控制台输出 ("[MCP] 所有浏览器已崩溃, 触发重建")
            // 崩溃恢复: 渲染进程崩溃可能损坏CEF磁盘缓存导致重建后连环崩溃, 写标记文件, 下次启动时自动清理缓存
            变量 恢复标记路径 <类型 = 文本型>
            恢复标记路径 = 取运行目录 () + "\\CacheData\\.crash_recovery"
            // 防御: 标记目录不存在时先创建 (不再依赖CEF初始化隐式创建)
            如果 (MCP_服务器工具.检查目录是否存在 (取运行目录 () + "\\CacheData") == 假)
            {
                创建目录 (取运行目录 () + "\\CacheData")
            }
            写到文件 (恢复标记路径, 文本到UTF8 ("renderer_crash", 假))
            // 崩溃循环防护: 120秒内连续3次全崩溃 → 停止进程内重建 (避免无限崩溃循环)
            // 重启程序后启动时自动清理缓存, 循环即断
            变量 崩溃现在 <类型 = 长整数>
            崩溃现在 = 取启动时间 ()
            // 修复: 与 执行定期维护 的复位跨线程竞争, 改原子读写
            变量 旧崩溃时间 <类型 = 长整数>
            旧崩溃时间 = MCP命令服务器.原子置首次崩溃时间 (崩溃现在)
            如果 (旧崩溃时间 == 0 || 崩溃现在 - 旧崩溃时间 > 120000)
            {
                MCP命令服务器.原子清零崩溃计数 ()
            }
            变量 崩溃次数 <类型 = 整数>
            崩溃次数 = MCP命令服务器.原子递增崩溃计数 ()
            如果 (崩溃次数 >= 3)
            {
                MCP命令服务器.禁止重建 = 真
                控制台输出 ("[MCP] 120秒内连续崩溃 " + 到文本 (崩溃次数) + " 次, 停止自动重建 | 请重启程序(启动时将自动清理缓存)")
                返回
            }
            如果 (MCP命令服务器.禁止重建 == 假)
            {
                浏览器容器.重置欢迎页导航状态 ()
                浏览器容器.标记需要重建浏览器 ()
            }
        }
    }
    # URL导航拦截 — 可用于安全过滤, 通过 browser_intercept/action=navigate_block 动态启用
    # 参照 browser_event21.wsv: 浏览器_即将导航 中可调用 请求环境.置首选项
    方法 浏览器_即将导航 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 请求 <类型 = 类_FBrowser_请求>
    参数 用户动作 <类型 = 逻辑型>
    参数 是否重定向 <类型 = 逻辑型>
    {
        变量 目标地址 <类型 = 文本型>
        目标地址 = 请求.取地址 ()
        如果 (MCP命令服务器.是否监控载入事件 && 目标地址 != "")
        {
            变量 导航数据 <类型 = YYJSON对象类>
            导航数据.创建自文本 ("{}")
            导航数据.加入文本成员 ("url", 目标地址)
            导航数据.加入逻辑值成员 ("user_gesture", 用户动作)
            导航数据.加入逻辑值成员 ("is_redirect", 是否重定向)
            记录监控事件 (真, "navigate", 浏览器.取ID (), 导航数据.到可读文本 (YYJSON格式化选项.压缩))
        }
        // 防止重定向链: 已经是重定向的导航不再拦截, 避免 A→B→C→A 死循环
        // ⚠️ 安全提示: 重定向会绕过拦截规则, 恶意服务器可能利用302跳转规避URL过滤
        // 如需拦截重定向链, 请在 mcp_config.json 设置 hook_redirects:true 并注意循环风险
        如果 (是否重定向 == 假 && MCP命令服务器.是否Hook导航 && MCP命令服务器.导航拦截规则 != "")
        {
            如果 (目标地址 != "")
            {
                // 规则格式: action|url[|target] 每行一条
                变量 规则文本 <类型 = 文本数组类>
                分割文本 (MCP命令服务器.导航拦截规则, "\n", 规则文本, 真, 假)
                计次循环 (规则文本.取成员数 ())
                {
                    变量 行文本 <类型 = 文本型>
                    行文本 = 规则文本.取成员 (取循环索引 ())
                    如果 (行文本 == "")
                    {
                        到循环尾
                    }
                    变量 parts <类型 = 文本数组类>
                    分割文本 (行文本, "|", parts, 真, 假)
                    如果 (parts.取成员数 () >= 2)
                    {
                        变量 规则动作 <类型 = 文本型>
                        规则动作 = parts.取成员 (0)
                        变量 规则URL <类型 = 文本型>
                        规则URL = parts.取成员 (1)
                        变量 匹配位置 <类型 = 整数>
                        匹配位置 = 寻找文本 (目标地址, 规则URL, 0, 假)
                        如果 (匹配位置 != -1)
                        {
                            如果 (规则动作 == "block")
                            {
                                控制台输出 (到文本 ("[MCP] 导航拦截:") + ", " + 到文本 (目标地址))
                                返回 (真)
                            }
                            否则 (规则动作 == "redirect" && parts.取成员数 () >= 3)
                            {
                                变量 重定向目标 <类型 = 文本型>
                                重定向目标 = parts.取成员 (2)
                                // 防死循环: 目标地址即重定向目标(规则自身重定向)时放行, 不再触发重定向
                                如果 (目标地址 == 重定向目标)
                                {
                                    返回 (假)
                                }
                                // 修复: 互指规则(A→B, B→A)会无限循环, 加链式重定向保护(2秒窗口内>10次即放行)
                                MCP命令服务器.重定向链计数 = MCP命令服务器.重定向链计数 + 1
                                如果 (MCP命令服务器.重定向链起始毫秒 == 0 || 取启动时间 () - MCP命令服务器.重定向链起始毫秒 > 2000)
                                {
                                    MCP命令服务器.重定向链起始毫秒 = 取启动时间 ()
                                    MCP命令服务器.重定向链计数 = 1
                                }
                                如果 (MCP命令服务器.重定向链计数 > 10)
                                {
                                    控制台输出 (到文本 ("[MCP] 检测到重定向循环, 放行当前导航:") + ", " + 到文本 (目标地址))
                                    MCP命令服务器.重定向链计数 = 0
                                    MCP命令服务器.重定向链起始毫秒 = 0
                                    返回 (假)
                                }
                                控制台输出 (到文本 ("[MCP] 导航重定向:") + ", " + 到文本 (目标地址) + ", " + 到文本 ("→") + ", " + 到文本 (重定向目标))
                                框架.载入地址 (重定向目标)
                                返回 (真)
                            }
                        }
                    }
                }
            }
        }
        返回 (假)  // 默认不拦截
    }
    # 弹窗自定义 — 参照 browser_event21.wsv: 浏览器_即将打开新窗口
    方法 浏览器_即将打开新窗口 <公开 类型 = 逻辑型 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 框架 <类型 = 类_FBrowser_框架>
    参数 弹窗ID <类型 = 整数>
    参数 地址 <类型 = 文本型>
    参数 目标框架名称 <类型 = 文本型>
    参数 目标类型 <类型 = 整数>
    参数 用户手势 <类型 = 逻辑型>
    参数 弹出功能 <类型 = FBrowser_弹出功能>
    参数 窗口信息 <类型 = FBrowser_窗口信息>
    参数 浏览器设置 <类型 = FBrowser_浏览器配置>
    参数 无JS访问 <类型 = 逻辑型类>
    参数 用户额外配置 <类型 = 类_FBrowser_用户额外配置>
    {
        变量 当前浏览器数 <类型 = 整数>
        当前浏览器数 = FBrowser_浏览器_取数量 ()
        如果 (当前浏览器数 >= MCP_常量.浏览器实例最大数量)
        {
            控制台输出 (到文本 ("[MCP] 弹窗已拒绝: 浏览器实例数=") + ", " + 到文本 (当前浏览器数) + ", " + 到文本 (" 上限=") + ", " + 到文本 (MCP_常量.浏览器实例最大数量) + ", " + 到文本 (" url=") + ", " + 到文本 (地址))
            返回 (真)
        }
        如果 (MCP命令服务器.是否Hook弹窗 && MCP命令服务器.弹窗配置 != "")
        {
            变量 弹窗JSON <类型 = YYJSON只读对象类>
            如果 (弹窗JSON.创建自文本 (MCP命令服务器.弹窗配置))
            {
                变量 弹窗宽度 <类型 = 整数>
                弹窗宽度 = 弹窗JSON.取整数 ("width")
                变量 弹窗高度 <类型 = 整数>
                弹窗高度 = 弹窗JSON.取整数 ("height")
                如果 (弹窗宽度 > 0)
                {
                    窗口信息.宽度 = 弹窗宽度
                }
                如果 (弹窗高度 > 0)
                {
                    窗口信息.高度 = 弹窗高度
                }
                变量 弹窗X <类型 = 整数>
                弹窗X = 弹窗JSON.取整数 ("x")
                变量 弹窗Y <类型 = 整数>
                弹窗Y = 弹窗JSON.取整数 ("y")
                如果 (弹窗X != 0 || 弹窗Y != 0)
                {
                    窗口信息.横坐标 = 弹窗X
                    窗口信息.纵坐标 = 弹窗Y
                }
                控制台输出 (到文本 ("[MCP] 弹窗自定义:") + ", " + 到文本 (弹窗宽度) + ", " + 到文本 ("x") + ", " + 到文本 (弹窗高度))
            }
        }
        如果 (MCP命令服务器.是否监控载入事件)
        {
            变量 弹窗数据 <类型 = YYJSON对象类>
            弹窗数据.创建自文本 ("{}")
            弹窗数据.加入文本成员 ("url", 地址)
            弹窗数据.加入整数成员 ("popup_id", 弹窗ID)
            弹窗数据.加入整数成员 ("width", 窗口信息.宽度)
            弹窗数据.加入整数成员 ("height", 窗口信息.高度)
            记录监控事件 (真, "popup", 浏览器.取ID (), 弹窗数据.到可读文本 (YYJSON格式化选项.压缩))
        }
        返回 (假)  // 不阻止弹窗
    }
    方法 浏览器_打开新窗口失败 <公开 @虚拟方法 = 可覆盖>
    参数 浏览器 <类型 = 类_FBrowser_浏览器>
    参数 弹窗ID <类型 = 整数>
    {
